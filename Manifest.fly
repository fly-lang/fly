namespace fly.project

import fly.meta.*

// ─────────────────────────────────────────────────────────────────────────────
// Manifest.fly — the package manifest of Fly itself: compiler, runtime, standard
// library and tools. Since 0.15.2 it is the SINGLE source of truth for the
// version: the build scripts read `version` from here and generate the module
// that answers `fly --version` (ci/*/gen_package), and release.yml tags the
// release with it. Bump the version here and ONLY here; keep the line's shape
// (`string version = "x.y.z"`) stable, the scripts read it with a pattern.
//
// `flyVersion` is the toolchain that builds this tree: the pinned stage-0 seed
// (ci/*/stage0 FLY_VERSION).
// ─────────────────────────────────────────────────────────────────────────────

class Manifest : fly.meta.Manifest {
    string name = "fly"
    string version = "0.15.2"
    string description = "The Fly programming language: compiler, runtime, standard library and tools"
    string license = "Apache-2.0"
    string flyVersion = "0.15.2"
    string homepage = "https://flylang.org"
    string repository = "https://github.com/fly-lang/fly"

    // `fly build --profile dist` builds the whole toolchain, laid out as a
    // release: bin/ (fly, fly-lsp, fly-registry, the linker, the debugger and, on
    // Windows, the mingw sysroot) and lib/ (runtime, TLS and std archives with
    // their headers, the LLVM shared libraries). In order: runtime (one per OS)
    // and the TLS archives, the standard library, the compiler, the tools, then
    // the LLVM pieces stage 0 fetched into build/ (copy targets). A library lands
    // in lib/ with its headers, where the targets after it find it (`@out/lib`).
    // The executables find lib/ at run time through `$ORIGIN/../lib` (Linux and
    // macOS; Windows looks next to the executable).
    //
    // Stage 2 (ci/*/stage2) is `fly build --profile dist --out-dir build/stage2`
    // run by the stage-1 fly (`dist-debug` when CI embeds DWARF), and stage 3 the
    // compiler again, by the stage-2 fly: the prefix map writes the package root,
    // the compiling fly's lib/ and the output directory the same way whichever fly
    // builds where, so the two objects can be compared byte for byte - and a
    // release carries no path of the machine that built it.
    //
    // Stage 1 (ci/*/stage1) builds the same targets with the seed, one at a
    // time, through the `stage1` profile (`stage1-debug` when CI embeds DWARF):
    // no --warnings-as-errors, since the seed's warnings are not the tree's
    // contract, and its own output directory. The seed (0.15.2) knows neither
    // `dir` nor `rpaths` and writes everything flat: stage 1 lays it out.
    Profile[] profiles = {
        { name = "dist", optLevel = 0, debugInfo = false, warningsAsErrors = true,
          debugPrefixMap = "@root=.;@fly/lib=lib;@out=out" },
        { name = "dist-debug", optLevel = 0, debugInfo = true, warningsAsErrors = true,
          debugPrefixMap = "@root=.;@fly/lib=lib;@out=out" },
        { name = "stage1", optLevel = 0, debugInfo = false, warningsAsErrors = false },
        { name = "stage1-debug", optLevel = 0, debugInfo = true, warningsAsErrors = false }
    }

    Target[] targets = {
        // The LLVM C API declarations, first: lib/ holds every header before the
        // compiler is compiled (stage 3 rebuilds it over a complete lib/).
        { name = "llvm-header", dir = "lib", copy = { "build/stage0/lib/llvm.fly.h" } },
        { name = "runtime-linux", os = "linux", lib = "static", artifact = "fly_runtime_lib", dir = "lib",
          files = { "runtime/lib/RuntimeLinux.fly" } },
        { name = "runtime-macos", os = "macos", lib = "static", artifact = "fly_runtime_lib", dir = "lib",
          files = { "runtime/lib/RuntimeMacos.fly" } },
        { name = "runtime-windows", os = "windows", lib = "static", artifact = "fly_runtime_lib", dir = "lib",
          files = { "runtime/lib/RuntimeWindows.fly" } },
        { name = "tls-stub", lib = "static", artifact = "fly_tls_stub", dir = "lib",
          files = { "runtime/lib/TlsStub.fly" }, libDirs = { "@out/lib" } },
        { name = "tls-openssl-linux", os = "linux", lib = "static", artifact = "fly_tls_lib", dir = "lib",
          files = { "runtime/lib/TlsOpenSSL.fly" }, libDirs = { "@out/lib" } },
        { name = "tls-openssl-macos", os = "macos", lib = "static", artifact = "fly_tls_lib", dir = "lib",
          files = { "runtime/lib/TlsOpenSSL.fly" }, libDirs = { "@out/lib" } },
        { name = "tls-schannel", os = "windows", lib = "static", artifact = "fly_tls_lib", dir = "lib",
          files = { "runtime/lib/TlsSchannel.fly" }, libDirs = { "@out/lib" } },
        { name = "std", lib = "static", artifact = "fly_std_lib", dir = "lib",
          srcDirs = { "std/lib" }, libDirs = { "@out/lib" } },
        { name = "fly", dir = "bin", srcDirs = { "compiler" }, libDirs = { "@out/lib" }, rpaths = { "$ORIGIN/../lib" },
          flags = { "--runtime-lib-dir", "@out/lib", "--llvm-lib-dir", "build/llvm/lib" } },
        { name = "fly-lsp", dir = "bin", srcDirs = { "tools/lsp", "compiler/lib" }, entry = "tools/lsp/lib/FlyLsp.fly",
          libDirs = { "@out/lib" }, rpaths = { "$ORIGIN/../lib" },
          flags = { "--runtime-lib-dir", "@out/lib", "--llvm-lib-dir", "build/llvm/lib" } },
        { name = "fly-registry", dir = "bin", srcDirs = { "tools/registry" },
          entry = "tools/registry/lib/FlyRegistry.fly", libDirs = { "@out/lib" }, rpaths = { "$ORIGIN/../lib" },
          flags = { "--runtime-lib-dir", "@out/lib" } },

        // The LLVM pieces a release ships, from build/ (stage 0). A `*` pattern
        // may match nothing (an optional file); a plain path must exist.
        { name = "llvm-windows", os = "windows", dir = "bin",
          copy = { "build/llvm/bin/LLVM-C.dll", "build/llvm/bin/ld.lld.exe", "build/llvm/bin/lldb.exe",
                   "build/llvm/bin/liblldb.dll", "build/llvm/bin/lldb-dap.exe", "build/llvm/bin/lldb-argdumper.exe",
                   "build/mingw" } },
        { name = "llvm-linux-bin", os = "linux", dir = "bin",
          copy = { "build/llvm/bin/ld.lld", "build/llvm/bin/lldb", "build/llvm/bin/lldb-server",
                   "build/llvm/bin/lldb-dap", "build/llvm/bin/lldb-argdumper" } },
        { name = "llvm-linux-lib", os = "linux", dir = "lib",
          copy = { "build/llvm/lib/libLLVM.so.20.1", "build/llvm/lib/liblldb.so.20.1" } },
        { name = "llvm-linux-builtins", os = "linux", dir = "lib/clang/20/lib/x86_64-unknown-linux-gnu",
          copy = { "build/llvm/lib/clang/20/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a" } },
        { name = "llvm-macos-bin", os = "macos", dir = "bin",
          copy = { "build/llvm/bin/ld64.lld", "build/llvm/bin/lldb", "build/llvm/bin/lldb-dap",
                   "build/llvm/bin/lldb-argdumper", "build/llvm/bin/debugserver*", "build/llvm/bin/dsymutil*" } },
        { name = "llvm-macos-lib", os = "macos", dir = "lib",
          copy = { "build/llvm/lib/libLLVM.dylib", "build/llvm/lib/liblldb*.dylib" } }
    }
}
