namespace fly.driver.test

import fly.driver.*

import fly.driver.test.util.*
import fly.assert
import fly.str

// Port of fly/tools/flyp/test/ManifestTest.cpp. The C++ writes fly.toml files and
// calls Manifest::parse(path); here we build the TOML in-memory (mkToml turns `|`
// into `"`) and call parseManifest(src, err). Validation failures surface as a
// non-zero err instead of a thrown exception.

suite ManifestSuite {

    void packageTest() {
        case "minimal package": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 0, 1)
            assert.assertStr(m.getName(), "myapp", 2)
            assert.assertStr(m.getVersion(), "1.0.0", 3)
        }
        case "invalid name rejected": {
            string src = mkToml("
[package]
name = |My_App!|
version = |1.0.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 201, 4)
        }
        case "invalid version rejected": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 202, 5)
        }
        case "missing name rejected": {
            string src = mkToml("
[package]
version = |1.0.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 203, 6)
        }
    }

    void dependenciesTest() {
        case "git tag dependency": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[dependencies]
mylib = { git = |https://github.com/example/mylib.git|, tag = |v1.2.0| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 0, 10)
            assert.assertEqI(m.depCount(), 1, 11)
            assert.assertTrue(m.hasDep("mylib"), 12)
            GitDep d = m.getDep("mylib")
            assert.assertStr(d.getGitUrl(), "https://github.com/example/mylib.git", 13)
            assert.assertEqI(d.getRefKind(), 0, 14)
            assert.assertStr(d.getRefValue(), "v1.2.0", 15)
            assert.assertTrue(d.isGitDep(), 16)
        }
        case "branch dependency": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[dependencies]
alpha = { git = |https://x/a.git|, branch = |main| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            GitDep d = m.getDep("alpha")
            assert.assertEqI(d.getRefKind(), 1, 17)
            assert.assertStr(d.getRefValue(), "main", 18)
        }
        case "rev dependency": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[dependencies]
beta = { git = |https://x/b.git|, rev = |abc123def456| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            GitDep d = m.getDep("beta")
            assert.assertEqI(d.getRefKind(), 2, 19)
            assert.assertStr(d.getRefValue(), "abc123def456", 20)
        }
        case "registry dependency + name override": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[dependencies]
fly-std = { registry = |local|, version = |0.14.0| }
io-helpers = { registry = |local|, name = |fly-io|, version = |1.0.0| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 0, 21)
            GitDep s = m.getDep("fly-std")
            assert.assertTrue(s.isRegistryDep(), 22)
            assert.assertStr(s.getRegistryName(), "local", 23)
            assert.assertStr(s.getPkgName(), "fly-std", 24)
            assert.assertStr(s.getVersionReq(), "0.14.0", 25)
            GitDep io = m.getDep("io-helpers")
            assert.assertStr(io.getPkgName(), "fly-io", 26)
        }
    }

    void targetsTest() {
        case "bin target + name override": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[targets]
app = { path = |src/main.fly| }
cli = { name = |MyCLI|, path = |src/cli.fly| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 0, 30)
            assert.assertEqI(m.targetCount(), 2, 31)
            Target a = m.targetAt(0)
            assert.assertStr(a.getKey(), "app", 32)
            assert.assertStr(a.getName(), "app", 33)
            assert.assertStr(a.getPath(), "src/main.fly", 34)
            assert.assertTrue(a.isBin(), 35)
            assert.assertFalse(a.isLib(), 36)
            Target c = m.targetAt(1)
            assert.assertStr(c.getName(), "MyCLI", 37)
        }
        case "lib target static/dynamic": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[targets]
mylib = { path = |src/lib.fly|, lib = |static| }
dyn = { name = |MyLib|, path = |src/dyn.fly|, lib = |dynamic| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            Target s = m.targetAt(0)
            assert.assertStr(s.getLib(), "static", 38)
            assert.assertTrue(s.isLib(), 39)
            assert.assertFalse(s.isBin(), 40)
            Target d = m.targetAt(1)
            assert.assertStr(d.getName(), "MyLib", 41)
            assert.assertStr(d.getLib(), "dynamic", 42)
        }
    }

    void repoAndProfilesTest() {
        case "repo aliases + default registry": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
registry = |local|
[repo]
local = |http://localhost:5000|
remote = |https://registry.flylang.org|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 0, 50)
            assert.assertEqI(m.repoCount(), 2, 51)
            assert.assertStr(m.getRepo("local"), "http://localhost:5000", 52)
            assert.assertStr(m.getRepo("remote"), "https://registry.flylang.org", 53)
            assert.assertStr(m.getDefaultRegistry(), "local", 54)
        }
        case "default debug/release profiles synthesized": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertTrue(m.hasProfile("debug"), 55)
            assert.assertTrue(m.hasProfile("release"), 56)
            BuildProfile rel = m.getProfile("release")
            assert.assertEqI(rel.getOptLevel(), 3, 57)
            assert.assertFalse(rel.getDebugInfo(), 58)
            BuildProfile dbg = m.getProfile("debug")
            assert.assertEqI(dbg.getOptLevel(), 0, 59)
            assert.assertTrue(dbg.getDebugInfo(), 60)
        }
        case "explicit profile overrides": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[profiles]
ci = { opt-level = 2, debug-info = true, lto = false }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertTrue(m.hasProfile("ci"), 61)
            BuildProfile ci = m.getProfile("ci")
            assert.assertEqI(ci.getOptLevel(), 2, 62)
            assert.assertTrue(ci.getDebugInfo(), 63)
        }
    }

    void linkAndWorkspaceTest() {
        case "link libs": {
            string src = mkToml("
[package]
name = |myapp|
version = |1.0.0|
[link]
libs = [ |LLVM-20|, |curl| ]
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(m.linkLibCount(), 2, 70)
            assert.assertStr(m.linkLibAt(0), "LLVM-20", 71)
            assert.assertStr(m.linkLibAt(1), "curl", 72)
        }
        case "workspace root skips package validation": {
            string src = mkToml("
[workspace]
members = [ |app|, |libs/core| ]
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(err, 0, 73)
            assert.assertTrue(m.isWorkspaceRoot(), 74)
            assert.assertEqI(m.memberCount(), 2, 75)
            assert.assertStr(m.memberAt(1), "libs/core", 76)
        }
        case "non-workspace has no workspace config": {
            string src = mkToml("
[package]
name = |myapp|
version = |0.1.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertFalse(m.isWorkspaceRoot(), 77)
        }
    }

    void hooksTest() {
        case "both hooks": {
            string src = mkToml("
[package]
name = |myapp|
version = |0.1.0|
[hooks]
pre-build = |python scripts/codegen.py|
post-build = |strip target/release/myapp|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertStr(m.getPreBuild(), "python scripts/codegen.py", 80)
            assert.assertStr(m.getPostBuild(), "strip target/release/myapp", 81)
        }
        case "partial hooks": {
            string src = mkToml("
[package]
name = |myapp|
version = |0.1.0|
[hooks]
pre-build = |make codegen|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertStr(m.getPreBuild(), "make codegen", 82)
            assert.assertTrue(fly.str.isEmpty(m.getPostBuild()), 83)
        }
        case "no hooks → empty": {
            string src = mkToml("
[package]
name = |myapp|
version = |0.1.0|
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertTrue(fly.str.isEmpty(m.getPreBuild()), 84)
            assert.assertTrue(fly.str.isEmpty(m.getPostBuild()), 85)
        }
    }

    void pathDepAndMixedTest() {
        case "path dependency vs git": {
            string src = mkToml("
[package]
name = |app|
version = |0.1.0|
[dependencies]
core = { path = |../libs/core| }
fly-std = { git = |https://github.com/flylang/fly-std.git|, tag = |v1.0.0| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(m.depCount(), 2, 90)
            GitDep core = m.getDep("core")
            assert.assertTrue(core.isPathDep(), 91)
            assert.assertStr(core.getPath(), "../libs/core", 92)
            GitDep std = m.getDep("fly-std")
            assert.assertFalse(std.isPathDep(), 93)
            assert.assertTrue(std.isGitDep(), 94)
        }
        case "mixed targets (2 bin + 1 lib)": {
            string src = mkToml("
[package]
name = |myapp|
version = |0.1.0|
[targets]
app = { path = |src/main.fly| }
cli = { path = |src/cli.fly| }
mylib = { path = |src/lib.fly|, lib = |static| }
")
            int err = 0
            Manifest m = parseManifest(src, err)
            assert.assertEqI(m.targetCount(), 3, 95)
            assert.assertTrue(m.targetAt(0).isBin(), 96)
            assert.assertTrue(m.targetAt(1).isBin(), 97)
            assert.assertTrue(m.targetAt(2).isLib(), 98)
        }
    }
}
