namespace fly.driver

import fly.data.List
import fly.str
import fly.os.fs

// ─────────────────────────────────────────────────────────────────────────────
// Lockfile — fly.lock reader/writer. Port of fly/tools/flyp/manifest/Lockfile.
// Reading reuses the TOML reader (tomlParse; [[package]] array-of-tables); writing
// builds the file text by hand (real newlines via fly.driver.nl(), quotes via dq()).
// ─────────────────────────────────────────────────────────────────────────────

public class LockedPackage {
    string name
    string version
    string source        // "git+<url>" | "registry+<name>"
    string rev
    string tag
    string checksum
    List<string> deps    // "name version" strings

    public LockedPackage() {
        this.name = ""
        this.version = ""
        this.source = ""
        this.rev = ""
        this.tag = ""
        this.checksum = ""
        this.deps = new List<string>()
    }
    public string getName()     { out = this.name }
    public string getVersion()  { out = this.version }
    public string getSource()   { out = this.source }
    public string getRev()      { out = this.rev }
    public string getTag()      { out = this.tag }
    public string getChecksum() { out = this.checksum }
    public void setName(const string v)     { this.name = v }
    public void setVersion(const string v)  { this.version = v }
    public void setSource(const string v)   { this.source = v }
    public void setRev(const string v)      { this.rev = v }
    public void setTag(const string v)      { this.tag = v }
    public void setChecksum(const string v) { this.checksum = v }
    public void addDep(const string d)      { this.deps.add(d) }
    public int depCount()                   { out = (int)this.deps.size() }
    public string depAt(const int i)        { out = this.deps.get(i) }
}

public class Lockfile {
    int formatVersion
    string flyVersion
    string tomlChecksum
    List<LockedPackage> packages

    public Lockfile() {
        this.formatVersion = 1
        this.flyVersion = ""
        this.tomlChecksum = ""
        this.packages = new List<LockedPackage>()
    }

    public int getFormatVersion()    { out = this.formatVersion }
    public string getTomlChecksum()  { out = this.tomlChecksum }
    public void setTomlChecksum(const string v) { this.tomlChecksum = v }
    public void setFlyVersion(const string v)  { this.flyVersion = v }

    public void addPackage(const LockedPackage p) { this.packages.add(p) }
    public int packageCount()                     { out = (int)this.packages.size() }
    public LockedPackage packageAt(const int i)   { out = this.packages.get(i) }

    public LockedPackage find(const string name) {
        int i = 0
        while i < this.packages.size() {
            LockedPackage p = this.packages.get(i)
            if fly.str.equals(p.getName(), name) { out = p  return }
            i = i + 1
        }
        out = null
    }

    // isStale — the on-disk fly.toml no longer matches the recorded checksum.
    public bool isStale(const string tomlPath) {
        if fly.str.isEmpty(this.tomlChecksum) { out = true  return }
        out = fly.str.equals(fly.driver.sha256File(tomlPath), this.tomlChecksum) == false
    }

    // serialize — the fly.lock file text.
    public string serialize() {
        string q = fly.driver.dq()
        string nl = fly.driver.nl()
        string s = "# fly.lock — generated automatically by fly."
        s = fly.str.concat(s, nl)
        s = fly.str.concat(s, fly.str.concat("# Do not edit manually.", nl))
        s = fly.str.concat(s, nl)
        s = fly.str.concat(s, fly.str.concat("version  = ", fly.str.concat(fly.str.convert(this.formatVersion), nl)))
        s = fly.str.concat(s, this.kv("fly      = ", this.flyVersion, q, nl))
        s = fly.str.concat(s, this.kv("checksum = ", this.tomlChecksum, q, nl))
        int i = 0
        while i < this.packages.size() {
            LockedPackage p = this.packages.get(i)
            s = fly.str.concat(s, nl)
            s = fly.str.concat(s, fly.str.concat("[[package]]", nl))
            s = fly.str.concat(s, this.kv("name         = ", p.getName(), q, nl))
            s = fly.str.concat(s, this.kv("version      = ", p.getVersion(), q, nl))
            s = fly.str.concat(s, this.kv("source       = ", p.getSource(), q, nl))
            s = fly.str.concat(s, this.kv("rev          = ", p.getRev(), q, nl))
            if fly.str.isEmpty(p.getTag()) == false {
                s = fly.str.concat(s, this.kv("tag          = ", p.getTag(), q, nl))
            }
            s = fly.str.concat(s, this.kv("checksum     = ", p.getChecksum(), q, nl))
            // dependencies = [ "a 1.0.0", ... ]
            string arr = "dependencies = ["
            int d = 0
            while d < p.depCount() {
                if d > 0 { arr = fly.str.concat(arr, ", ") }
                arr = fly.str.concat(arr, fly.str.concat(q, fly.str.concat(p.depAt(d), q)))
                d = d + 1
            }
            arr = fly.str.concat(arr, "]")
            s = fly.str.concat(s, fly.str.concat(arr, nl))
            i = i + 1
        }
        out = s
    }

    // kv — `<prefix>"<value>"<nl>`
    public string kv(const string prefix, const string value, const string q, const string nl) {
        string body = fly.str.concat(q, fly.str.concat(value, q))
        out = fly.str.concat(prefix, fly.str.concat(body, nl))
    }

    // write — serialize to `path`.
    public void write(const string path) {
        fly.os.fs.writeStr(path, this.serialize(), 420)
    }
}

// readLock — parse fly.lock at `path` (empty Lockfile if missing). errOut: 0 ok,
// 2 missing (empty is fine), else the toml parser code.
public Lockfile readLock(const string path, int errOut) {
    Lockfile lf = new Lockfile()
    if fly.os.fs.exists(path) == false { errOut = 0  out = lf  return }
    string src = fly.os.fs.readStr(path)
    int e = 0
    fly.driver.TomlValue root = fly.driver.tomlParse(src, e)
    if e != 0 { errOut = e  out = lf  return }

    lf.setTomlChecksum(root.getStr("checksum", ""))
    lf.setFlyVersion(root.getStr("fly", ""))

    if root.has("package") {
        fly.driver.TomlValue pkgs = root.get("package")
        if pkgs.isArray() {
            int i = 0
            while i < pkgs.size() {
                fly.driver.TomlValue t = pkgs.at(i)
                if t.isTable() {
                    LockedPackage p = new LockedPackage()
                    p.setName(t.getStr("name", ""))
                    p.setVersion(t.getStr("version", ""))
                    p.setSource(t.getStr("source", ""))
                    p.setRev(t.getStr("rev", ""))
                    p.setTag(t.getStr("tag", ""))
                    p.setChecksum(t.getStr("checksum", ""))
                    if t.has("dependencies") {
                        fly.driver.TomlValue ds = t.get("dependencies")
                        if ds.isArray() {
                            int j = 0
                            while j < ds.size() {
                                fly.driver.TomlValue de = ds.at(j)
                                if de.isStr() { p.addDep(de.asStr()) }
                                j = j + 1
                            }
                        }
                    }
                    lf.addPackage(p)
                }
                i = i + 1
            }
        }
    }
    errOut = 0
    out = lf
}
