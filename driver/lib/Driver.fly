namespace fly.driver

import fly.driver.*
import fly.compiler.frontend.*
import fly.compiler.basic.*
import fly.compiler.target.*
import fly.os.env
import fly.os.fs
import fly.os.io
import fly.os.path
import fly.mem
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// main — the self-host `fly` entry point. The binary IS the driver: it reads the
// command line and hands off to Driver.run (which dispatches compile vs package
// mode). Lives here (with the driver) so `compiler/` stays a pure library with no
// entry. NOTE: an `int main()` entry and a `fail` inside main both miscompile in
// the reference toolchain ("Broken function"), so this is a `void main()` that sets
// the process exit status explicitly via fly.os.env.exit(code) (→ proc_exit).
// ─────────────────────────────────────────────────────────────────────────────
void main() {
    fly.os.env.StringArray args = fly.os.env.argsGet()
    Driver d = new Driver()
    int code = d.run(args)
    fly.os.env.exit(code)
}

// ─────────────────────────────────────────────────────────────────────────────
// Driver — CLI front of the self-host compiler, a 1:1 port of the core of
// fly/compiler/Driver/Driver.cpp (option parsing + Execute orchestration). Reads
// the command line, loads the input `.fly`, and runs the Frontend, returning a
// process exit code. The DEFAULT action links an executable (Frontend emits a
// temp object → ToolChain drives ld.lld); --emit-ll/-c/-S select emit-only modes.
//
//   fly <file.fly> [-o out] [--emit-ll|-c|-S] [--no-output] [options]
// ─────────────────────────────────────────────────────────────────────────────

public class Driver {

    public Driver() { }

    public int run(const fly.os.env.StringArray args) {
        string input = ""
        string outPath = ""
        string outDir = ""
        string targetTriple = ""
        string targetCpu = ""
        string runtimeLibDir = ""       // --runtime-lib-dir: holds fly_std_lib.a / fly_runtime_lib.a
        string stdLibDir = ""           // auto-discovered <install>/lib: stdlib .fly source
        string toolchainLibDir = ""     // -L: extra linker search dir
        string mingwSysrootDir = ""     // --mingw-sysroot: mingw/UCRT sysroot (Windows link)
        string llvmLibDir = ""          // --llvm-lib-dir: dir holding LLVM-20.lib (Windows LLVM-C link)
        string linkLibs = ";"           // ";-lfoo;" native [link] deps
        string libInputs = ";"          // ";lib1.a;lib2.a;" — .a/.lib positional inputs to link
        string srcInputs = ";"          // ";a.fly;b.fly;" — .fly source inputs (multi-file for --lib)
        int emitMode = 3                // 0=.ll 1=.o 2=.s 3=link(executable, default)
        bool isStatic = false
        bool isShared = false
        bool isPie = false
        bool noOutput = false
        bool verbose = false
        bool testMode = false
        // new option state mirroring fly/compiler/Driver/Driver.cpp::BuildOptions
        string codeModel = ""           // --mcmodel
        string threadModel = ""         // --mthread-model
        string statsFile = ""           // --stats-file
        string srcDirs = ";"            // --src-dir (single override of the cwd default)
        // sdNew/llNew are FUNCTION-scope on purpose: a string declared inside a
        // loop-repeated block leaves a STALE pointer in its slot after the block's
        // scope-exit free; a later return unwinding that same block then frees it
        // AGAIN (double free — reference codegen bug, probed 2026-07-05).
        string sdNew = ""
        string llNew = ""
        int jobs = 0                    // --jobs / -j
        int optLevel = 0                // -O<n>
        bool debugSymbols = false       // --debug-symbols / --debug
        bool createLibrary = false      // --lib
        bool createHeader = false       // --header / --lib
        bool showStats = false          // --print-stats
        bool showTimers = false         // --ftime-report
        bool emitBc = false             // --emit-bc (no bitcode emitter → IR fallback)

        int n = (int)args.count
        int i = 1                       // skip argv[0] (program name)
        while i < n {
            string a = this.argAt(args, i)
            if fly.str.equals(a, "-o") {
                i = i + 1
                if i < n { outPath = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--out-dir") {
                i = i + 1
                if i < n { outDir = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--target") {
                i = i + 1
                if i < n { targetTriple = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--target-cpu") {
                i = i + 1
                if i < n { targetCpu = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "-c") {
                emitMode = 1
            } elsif fly.str.equals(a, "-S") {
                emitMode = 2
            } elsif fly.str.equals(a, "--emit-ll") {
                emitMode = 0
            } elsif fly.str.equals(a, "--emit-bc") {
                // No bitcode emitter in the self-host CodeGenModule → emit IR + a note.
                emitMode = 0
                emitBc = true
            } elsif fly.str.equals(a, "--mcmodel") {
                i = i + 1
                if i < n { codeModel = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--mthread-model") {
                i = i + 1
                if i < n { threadModel = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--jobs") || fly.str.equals(a, "-j") {
                i = i + 1
                if i < n { jobs = this.parseUInt(this.argAt(args, i), 0) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--stats-file") {
                i = i + 1
                if i < n { statsFile = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--src-dir") {
                i = i + 1
                if i >= n { out = this.missingValue(a)  return }
                // The project source root defaults to the current directory;
                // --src-dir overrides it, so it is meaningful at most ONCE.
                if fly.str.equals(srcDirs, ";") == false {
                    fly.os.io.printErrLn("error: --src-dir may be specified only once")
                    out = 1
                    return
                }
                // distinct temp: `x = concat(x, …)` self-aliases (documented
                // string gotcha)
                sdNew = fly.str.concat(srcDirs, fly.str.concat(this.argAt(args, i), ";"))
                srcDirs = sdNew
            } elsif fly.str.equals(a, "--working-dir") {
                i = i + 1                 // value consumed; FileSystemOptions not ported
                if i >= n { out = this.missingValue(a)  return }
                fly.os.io.printErrLn("warning: --working-dir is accepted but not implemented; paths resolve against the current directory")
            } elsif fly.str.equals(a, "--debug") {
                verbose = true
                debugSymbols = true
            } elsif fly.str.equals(a, "--debug-symbols") {
                debugSymbols = true
            } elsif fly.str.equals(a, "--header") {
                createHeader = true
            } elsif fly.str.equals(a, "--lib") {
                createLibrary = true
                createHeader = true
                emitMode = 1              // a library is built from an object, not linked
            } elsif fly.str.equals(a, "--print-stats") {
                showStats = true
            } elsif fly.str.equals(a, "--ftime-report") {
                showTimers = true
            } elsif fly.str.startsWith(a, "-O") {
                // -O<n> (attached) or "-O <n>" (separate).
                string lvl = fly.str.substring(a, 2, fly.str.len(a))
                if fly.str.isEmpty(lvl) {
                    i = i + 1
                    if i < n { lvl = this.argAt(args, i) }
                }
                optLevel = this.parseUInt(lvl, 0)
            } elsif fly.str.equals(a, "--runtime-lib-dir") {
                i = i + 1
                if i < n { runtimeLibDir = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--mingw-sysroot") {
                i = i + 1
                if i < n { mingwSysrootDir = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--llvm-lib-dir") {
                i = i + 1
                if i < n { llvmLibDir = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "-L") {
                i = i + 1
                if i < n { toolchainLibDir = this.argAt(args, i) } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--link-lib") {
                i = i + 1
                if i < n {
                    // distinct temp — same self-alias gotcha as --src-dir above
                    llNew = fly.str.concat(linkLibs, fly.str.concat(fly.str.concat("-l", this.argAt(args, i)), ";"))
                    linkLibs = llNew
                } else { out = this.missingValue(a)  return }
            } elsif fly.str.equals(a, "--shared") {
                isShared = true
            } elsif fly.str.equals(a, "-static") {
                isStatic = true
            } elsif fly.str.equals(a, "-pie") {
                isPie = true
            } elsif fly.str.equals(a, "--no-output") {
                noOutput = true
            } elsif fly.str.equals(a, "--test") {
                testMode = true
            } elsif fly.str.equals(a, "-v") || fly.str.equals(a, "--verbose") {
                verbose = true
            } elsif fly.str.equals(a, "-w") || fly.str.equals(a, "--no-warning") {
                // accepted (no-op): the self-host compiler emits no DiagnosticsEngine
                // warnings, and the driver's own `warning:` lines are unconditional
                // printErrLn — there is nothing to suppress today.
            } elsif fly.str.equals(a, "--help") || fly.str.equals(a, "-help") {
                this.printUsage()
                out = 0
                return
            } elsif fly.str.equals(a, "--version") || fly.str.equals(a, "-version") {
                this.printVersion()
                out = 0
                return
            } elsif fly.str.startsWith(a, "-") {
                fly.os.io.printErrLn(fly.str.concat("warning: ignoring unknown option ", a))
            } else {
                if fly.str.isEmpty(input) {
                    input = a
                    srcInputs = segAppend(srcInputs, a)
                    // Package mode: if the first positional is a fly.toml subcommand,
                    // hand the FULL argv to runPackage (fly.toml mode) and stop compile
                    // parsing. Detecting it here (on the loop's `a`, which already reads
                    // argv correctly) avoids the 0.13.8 miscompiles that reading argv[1]
                    // before the loop triggered.
                    bool firstIsPkg = fly.str.equals(a, "init")
                    if fly.str.equals(a, "build")  { firstIsPkg = true }
                    if fly.str.equals(a, "run")    { firstIsPkg = true }
                    if fly.str.equals(a, "test")   { firstIsPkg = true }
                    if fly.str.equals(a, "clean")  { firstIsPkg = true }
                    if fly.str.equals(a, "lock")   { firstIsPkg = true }
                    if fly.str.equals(a, "add")    { firstIsPkg = true }
                    if fly.str.equals(a, "remove") { firstIsPkg = true }
                    if fly.str.equals(a, "why")    { firstIsPkg = true }
                    if firstIsPkg {
                        out = this.runPackage(args)
                        return
                    }
                }
                elsif fly.str.endsWith(a, ".a") || fly.str.endsWith(a, ".lib") {
                    // A .a/.lib positional is a LIBRARY to LINK (e.g. the compiler archive
                    // when building the driver), not a source to compile — collect it and
                    // hand it to the linker alongside the emitted object.
                    libInputs = segAppend(libInputs, a)
                }
                else {
                    // A second+ SOURCE positional: collected for a multi-file build. Only
                    // --lib (library) mode consumes >1 source (they merge into one object);
                    // validated after the parse loop for the non-lib single-file case.
                    srcInputs = segAppend(srcInputs, a)
                }
            }
            i = i + 1
        }

        if fly.str.isEmpty(input) {
            this.printUsage()
            out = 1
            return
        }

        // Multiple .fly sources are only allowed in library mode (--lib/--header), where
        // they merge into one object + one set of headers. A plain compile takes one file.
        int srcCount = segCount(srcInputs)
        if srcCount > 1 {
            if createLibrary == false {
                if createHeader == false {
                    fly.os.io.printErrLn(fly.str.concat("error: multiple input files require --lib (extra input: ", fly.str.concat(segAt(srcInputs, 1), ")")))
                    out = 1
                    return
                }
            }
        }

        // Auto-discover the stdlib/runtime dir relative to the running compiler
        // binary (<install>/bin/fly → <install>/lib), mirroring
        // fly/compiler/Driver/Driver.cpp (StdLibDir + RuntimeLibDir). Resolves the
        // real executable path (not argv[0]) via fly.os.env.exePath(), so a
        // bare-name PATH invocation still works. An explicit --runtime-lib-dir
        // takes precedence for the archives.
        if fly.str.isEmpty(runtimeLibDir) || fly.str.isEmpty(stdLibDir) {
            string exe = fly.os.env.exePath()
            if fly.str.isEmpty(exe) == false {
                string binDir = fly.os.path.dirname(exe)
                string instDir = fly.os.path.dirname(binDir)
                string cand = fly.os.path.join(instDir, "lib")
                if fly.os.path.isDir(cand) {
                    if fly.str.isEmpty(runtimeLibDir) { runtimeLibDir = cand }
                    if fly.str.isEmpty(stdLibDir) { stdLibDir = cand }
                }
            }
        }

        string src = fly.os.fs.readStr(input)
        if fly.str.isEmpty(src) {
            fly.os.io.printErrLn(fly.str.concat("error: cannot read input file: ", input))
            out = 1
            return
        }

        string basePath = outPath
        if fly.str.isEmpty(basePath) { basePath = this.defaultOut(input, this.emitExt(emitMode)) }
        string finalPath = this.applyOutDir(outDir, basePath)
        string name = this.moduleName(input)

        // Default target = the HOST (compile for where fly runs). Windows targets
        // the gnu/UCRT env (the self-contained mingw toolchain fly ships), NOT the
        // host's -msvc triple; every other host defaults to Linux. Cross-compile
        // with an explicit --target.
        string effTriple = targetTriple
        if fly.str.isEmpty(effTriple) {
            if fly.str.equals(fly.os.env.osname(), "windows") {
                effTriple = "x86_64-w64-windows-gnu"
            } else {
                effTriple = "x86_64-unknown-linux-gnu"
            }
        }

        // note only when IR emission is still the effective mode (a later -c/-S
        // overrides emitMode and the note would then be misleading)
        if emitBc {
            if emitMode == 0 {
                fly.os.io.printErrLn("note: --emit-bc: bitcode emission unsupported, emitting LLVM IR")
            }
        }

        // Build the CompilerInstance (the C++ Driver::Execute model): bundle the
        // Frontend/CodeGen/Target options + the source buffer, then run the Frontend.
        // Mirrors fly/compiler/Driver/Driver.cpp::BuildOptions option plumbing.
        CodeGenOptions cgo = new CodeGenOptions()
        cgo.setRuntimeLibDir(runtimeLibDir)
        cgo.setToolchainLibDir(toolchainLibDir)
        cgo.setMingwSysrootDir(mingwSysrootDir)
        cgo.setLlvmLibDir(llvmLibDir)
        cgo.setTestMode(testMode)
        cgo.setStatic(isStatic)
        cgo.setShared(isShared)
        cgo.setPie(isPie)
        cgo.setDebugSymbols(debugSymbols)
        cgo.setOptLevel(optLevel)
        cgo.setJobs(jobs)
        if fly.str.isEmpty(codeModel) == false { cgo.setCodeModel(codeModel) }
        // Thread model: default posix; an invalid value warns AND falls back to
        // posix (it used to be applied anyway, with an unprefixed message). NOTE: the
        // value is validated and stored on CodeGenOptions but the LLVM-C backend never
        // reads it — --mthread-model is inert beyond this validation today.
        string effThread = threadModel
        if fly.str.isEmpty(effThread) { effThread = "posix" }
        if fly.str.equals(effThread, "posix") == false && fly.str.equals(effThread, "single") == false {
            fly.os.io.printErrLn(fly.str.concat(fly.str.concat("warning: invalid thread model '", effThread), "', falling back to posix"))
            effThread = "posix"
        }
        cgo.setThreadModel(effThread)
        if isShared { cgo.setRelocationModel("pic") }
        int nl = segCount(linkLibs)
        int li = 0
        while li < nl { cgo.addLinkerOption(segAt(linkLibs, li))  li = li + 1 }

        TargetOptions topts = new TargetOptions(effTriple)
        if fly.str.isEmpty(targetCpu) == false { topts.setCPU(targetCpu) }
        if fly.str.isEmpty(codeModel) == false { topts.setCodeModel(codeModel) }

        FrontendOptions fo = new FrontendOptions(finalPath)
        fo.setVerbose(verbose)
        fo.setTestMode(testMode)
        fo.setCreateShared(isShared)
        fo.setCreateLibrary(createLibrary)
        fo.setCreateHeader(createHeader)
        fo.setShowStats(showStats)
        fo.setShowTimers(showTimers)
        fo.setStatsFile(statsFile)
        fo.setOutDir(outDir)
        fo.setBackendAction(emitMode)
        // Register every .fly source input; the Frontend parses each into its own module
        // and merges them (multi-file --lib) — the single-file path uses inputAt(0).
        int ni = segCount(srcInputs)
        int nii = 0
        while nii < ni { fo.addInputFile(segAt(srcInputs, nii))  nii = nii + 1 }
        if fly.str.isEmpty(toolchainLibDir) == false { fo.addLibDir(toolchainLibDir) }
        if fly.str.isEmpty(stdLibDir) == false { fo.setStdLibDir(stdLibDir) }
        int sd = segCount(srcDirs)
        int sdi = 0
        while sdi < sd { fo.addSrcDir(segAt(srcDirs, sdi))  sdi = sdi + 1 }

        CompilerInstance ci = new CompilerInstance(null, fo, cgo, topts)
        ci.createFileManager()
        ci.createSourceManager(name, src)
        Frontend fe = new Frontend(ci)

        // Library mode (--lib): compile every input into ONE merged object (written to
        // the -o path) AND emit a `.fly.h` per public module. The archive itself
        // (fly_*.a) is built by the ci script's `ar` over that object — the compiler
        // produces object + headers, mirroring `fly/`'s Frontend GenerateHeader +
        // Archiver split. Frontend.execute merges fo.inputFiles and, when
        // fo.getCreateHeader() is set, generates the headers after resolution.
        if createLibrary {
            fo.setBackendAction(1)                      // a library is built from an object, not linked
            out = fe.execute("", false)
            return
        }
        // Header-only mode (--header, without --lib): the `.fly.h` headers are the sole
        // artifact — no object. HeaderGen runs before codegen in Frontend.execute, so
        // `noOutput = true` lets the headers be written while the object emission is
        // skipped. (--lib sets both flags; this branch is reached only for a bare --header.)
        if createHeader {
            out = fe.execute("", true)
            return
        }

        // Link mode (default): the Frontend emits a temp object, then the ToolChain
        // links it into an executable — mirrors Driver.cpp::Execute (Frontend emits
        // objects → ToolChain.BuildOutput).
        if emitMode == 3 && noOutput == false {
            string tempObj = fly.str.concat(finalPath, ".o")
            int rc = fe.execute(tempObj, false)
            if rc != 0 {
                // don't leave a partially-written temp object behind on failure
                if fly.os.fs.exists(tempObj) { fly.os.fs.delete(tempObj) }
                out = rc
                return
            }
            out = this.linkExecutable(ci, fe.getOutputFile(), libInputs)
            return
        }

        // Emit-only modes (.ll / .o / .s, or --no-output).
        out = fe.execute("", noOutput)
    }

    // linkExecutable — construct a ToolChain from the CompilerInstance and link
    // `objFile` into the FrontendOptions output (the C++ Driver::Execute
    // ToolChain.BuildOutput path). Cleans up the intermediate object.
    public int linkExecutable(const CompilerInstance ci, const string objFile, const string libInputs) {
        TargetOptions topts = ci.getTargetOptions()
        Triple tr = tripleParse(topts.getTriple())
        ToolChain tc = new ToolChain(null, tr, ci.getCodeGenOptions())
        // Link inputs = the emitted object, followed by any .a/.lib positionals the user
        // passed (e.g. the compiler archive when building the driver). BuildOutput links
        // every .a/.lib input it finds in this ";"-delimited list.
        string inFiles = fly.str.concat(";", fly.str.concat(objFile, ";"))
        int lc = segCount(libInputs)
        int li = 0
        while li < lc {
            inFiles = segAppend(inFiles, segAt(libInputs, li))
            li = li + 1
        }
        bool ok = tc.BuildOutput(inFiles, ci.getFrontendOptions())
        if fly.os.fs.exists(objFile) { fly.os.fs.delete(objFile) }
        if ok { out = 0 } else { out = 1 }
    }

    // emitExt — output extension for an emit mode (0=.ll, 1=.o, 2=.s, 3=link/exe).
    public string emitExt(const int emitMode) {
        if emitMode == 1 { out = ".o"  return }
        if emitMode == 2 { out = ".s"  return }
        if emitMode == 3 { out = ""    return }   // executable: no extension
        out = ".ll"
    }

    // missingValue — report a value-taking option used without its value.
    public int missingValue(const string opt) {
        fly.os.io.printErrLn(fly.str.concat(fly.str.concat("error: option '", opt), "' requires a value"))
        out = 1
    }

    // parseUInt — parse a non-negative decimal string; non-digits/empty → dflt.
    public int parseUInt(const string s, const int dflt) {
        int len = fly.str.len(s)
        if len == 0 { out = dflt  return }
        int acc = 0
        int i = 0
        while i < len {
            byte b = 0
            fly.str.byteAt(s, i, b)
            int c = b
            if c < 48 || c > 57 { out = dflt  return }
            acc = acc * 10 + (c - 48)
            i = i + 1
        }
        out = acc
    }

    // printUsage — the --help / no-input usage text.
    public void printUsage() {
        fly.os.io.printErrLn("usage: fly <file.fly> [options]")
        fly.os.io.printErrLn("options:")
        fly.os.io.printErrLn("  -o <file>       write output to <file>")
        fly.os.io.printErrLn("  --out-dir <dir> directory for generated outputs")
        fly.os.io.printErrLn("  (default)       link an executable via ToolChain")
        fly.os.io.printErrLn("  --emit-ll       produce LLVM IR (.ll)")
        fly.os.io.printErrLn("  --emit-bc       produce bitcode (falls back to LLVM IR)")
        fly.os.io.printErrLn("  -c              produce an object file (.o)")
        fly.os.io.printErrLn("  -S              produce target assembly (.s)")
        fly.os.io.printErrLn("  --lib           compile inputs into one merged object + a .fly.h per public module")
        fly.os.io.printErrLn("  --header        generate a .fly.h header file (no object)")
        fly.os.io.printErrLn("  --runtime-lib-dir <dir>  dir holding fly_std_lib.a / fly_runtime_lib.a")
        fly.os.io.printErrLn("  --mingw-sysroot <dir>  mingw/UCRT sysroot for Windows linking (default: <exe>/mingw)")
        fly.os.io.printErrLn("  --llvm-lib-dir <dir>   dir holding LLVM-20.lib for LLVM-C programs (default: <exe>/llvm/lib)")
        fly.os.io.printErrLn("  -L <dir>             extra linker search directory")
        fly.os.io.printErrLn("  --src-dir <dir>      project source root for import resolution (default: current dir)")
        fly.os.io.printErrLn("  --link-lib <name>    link native library (-lname)")
        fly.os.io.printErrLn("  -static / --shared / -pie   link mode flags (ELF/Linux targets; ignored by the Windows linker)")
        fly.os.io.printErrLn("  -O<n>                optimisation level 0..3")
        fly.os.io.printErrLn("  -j, --jobs <n>       LLVM parallelism (0 = auto)")
        fly.os.io.printErrLn("  --mcmodel <m>        memory code model")
        fly.os.io.printErrLn("  --mthread-model <m>  thread model posix|single (validated only; not applied by the backend)")
        fly.os.io.printErrLn("  --target <triple>    target triple (default: the host; Windows → x86_64-w64-windows-gnu)")
        fly.os.io.printErrLn("  --target-cpu <cpu>   target CPU (default: generic)")
        fly.os.io.printErrLn("  --no-output     type-check only, produce no output")
        fly.os.io.printErrLn("  --test          compile in test mode (test {} blocks)")
        fly.os.io.printErrLn("  --debug         verbose logging (+ request DWARF; self-host codegen emits none yet)")
        fly.os.io.printErrLn("  --debug-symbols request DWARF debug symbols (self-host codegen does not emit them yet)")
        fly.os.io.printErrLn("  --print-stats   accepted; not yet implemented (no output)")
        fly.os.io.printErrLn("  --ftime-report  accepted; not yet implemented (no output)")
        fly.os.io.printErrLn("  --stats-file <f>  accepted; not yet implemented (no file written)")
        fly.os.io.printErrLn("  -v, --verbose   log each compilation phase")
        fly.os.io.printErrLn("  -w, --no-warning  accepted; the compiler emits no warnings to suppress")
        fly.os.io.printErrLn("  --version       print version")
        fly.os.io.printErrLn("  --help          display this help")
    }

    // printVersion — the --version text. The version number lives in ONE place:
    // compiler/basic/Version.fly (release.yml greps it from there too).
    public void printVersion() {
        fly.os.io.printLn(fly.str.concat(fly.str.concat("fly version ", flyVersion()), " (https://flylang.org)"))
    }

    // applyOutDir — prefix a RELATIVE output path with outDir (absolute paths and
    // an empty outDir are returned unchanged). The dir must already exist (the
    // self-host has no mkdir yet).
    //
    // "Absolute" must cover Windows too: the self-host runs on Windows, where a
    // leading-'/'-only test wrongly treats "C:\out\x" as relative and mangles it into
    // "<outDir>/C:\out\x" — an invalid path the object emitter then crashes writing.
    // So recognize POSIX ("/…"), drive-absolute ("X:…") and root/UNC ("\…") forms.
    public string applyOutDir(const string outDir, const string outPath) {
        if fly.str.isEmpty(outDir) { out = outPath  return }
        int L = fly.str.len(outPath)
        if L >= 1 {
            byte b0 = 0
            fly.str.byteAt(outPath, 0, b0)
            if b0 == 47 { out = outPath  return }        // '/'  POSIX absolute
            if b0 == 92 { out = outPath  return }        // '\'  Windows root / UNC
            if L >= 2 {
                byte b1 = 0
                fly.str.byteAt(outPath, 1, b1)
                if b1 == 58 { out = outPath  return }     // 'X:' Windows drive-absolute
            }
        }
        string slash = fly.str.concat(outDir, "/")
        out = fly.str.concat(slash, outPath)
    }

    // argAt — read argv[i] from the StringArray's 16-byte {ptr,len} slots.
    public string argAt(const fly.os.env.StringArray args, const int i) {
        pointer base = args.items
        pointer ptr = fly.mem.readPtr(base, i * 16)
        int len = fly.mem.readInt(base, i * 16 + 8)
        // Copy the bytes into an OWNED buffer. `fromBytes`/`strMake` would only ALIAS
        // the argv buffer (owned by the StringArray, not by this string), and the
        // string model frees that alias at scope exit → use-after-free of the argv
        // slot. A later read of the SAME index then returns garbage — classically a
        // ";..."-list alloc (srcInputs/libInputs start ";") reuses the freed slot, so
        // `clean` read after the arg loop comes back ";clea" (";"+"clea", last byte
        // dropped) and `why` → ";wh". Owning our own copy makes every read safe.
        pointer buf = 0
        fly.runtime.mem_alloc(len, buf)
        int j = 0
        while j < len {
            byte b = 0
            fly.llvm.ptrByteAt(ptr, j, b)
            fly.llvm.ptrPokeByte(buf, j, b)
            j = j + 1
        }
        string s = ""
        fly.llvm.strMake(buf, len, s)
        out = s
    }

    // ── Package mode (fly.toml) ───────────────────────────────────────────────
    // Formerly class Flyp (fly/tools/flyp/Flyp.cpp). runPackage is invoked from run()
    // when argv[1] is a fly.toml subcommand; it dispatches the network-free core
    // commands (dependency/registry ones report "not yet ported").

    // flagValue — value following `--name` in argv, or "" if absent.
    public string flagValue(const fly.os.env.StringArray args, const int n, const string flag) {
        int i = 2
        while i < n {
            if fly.str.equals(this.argAt(args, i), flag) {
                if i + 1 < n { out = this.argAt(args, i + 1)  return }
            }
            i = i + 1
        }
        out = ""
    }

    // hasFlag — true if `flag` appears anywhere in argv.
    public bool hasFlag(const fly.os.env.StringArray args, const int n, const string flag) {
        int i = 2
        while i < n {
            if fly.str.equals(this.argAt(args, i), flag) { out = true  return }
            i = i + 1
        }
        out = false
    }

    // profileOf — --release → "release", else --profile VALUE, else "".
    public string profileOf(const fly.os.env.StringArray args, const int n) {
        if this.hasFlag(args, n, "--release") { out = "release"  return }
        out = this.flagValue(args, n, "--profile")
    }

    // runPackage — dispatch a fly.toml subcommand to fly.driver.
    public int runPackage(const fly.os.env.StringArray args) {
        int n = (int)args.count
        if n < 2 {
            fly.os.io.printLn("usage: fly <version|init|build|run|test|clean|cache|add|remove|lock|why|...>")
            out = 1
            return
        }
        string cmd = this.argAt(args, 1)

        if fly.str.equals(cmd, "version") {
            out = fly.driver.cmdVersion()
        } elsif fly.str.equals(cmd, "init") {
            out = fly.driver.cmdInit(this.flagValue(args, n, "--name"), this.flagValue(args, n, "--version"))
        } elsif fly.str.equals(cmd, "build") {
            out = fly.driver.cmdBuild(this.profileOf(args, n), this.flagValue(args, n, "--target"))
        } elsif fly.str.equals(cmd, "run") {
            out = fly.driver.cmdRun(this.profileOf(args, n), this.flagValue(args, n, "--bin"))
        } elsif fly.str.equals(cmd, "test") {
            out = fly.driver.cmdTest(this.profileOf(args, n))
        } elsif fly.str.equals(cmd, "clean") {
            out = fly.driver.cmdClean(this.profileOf(args, n))
        } elsif fly.str.equals(cmd, "lock") {
            out = fly.driver.cmdLock()
        } elsif fly.str.equals(cmd, "add") {
            string depName = ""
            if n >= 3 { depName = this.argAt(args, 2) }
            out = fly.driver.cmdAdd(depName, this.flagValue(args, n, "--git"),
                    this.flagValue(args, n, "--tag"), this.flagValue(args, n, "--branch"),
                    this.flagValue(args, n, "--rev"), this.hasFlag(args, n, "--dev"))
        } elsif fly.str.equals(cmd, "remove") {
            string depName = ""
            if n >= 3 { depName = this.argAt(args, 2) }
            out = fly.driver.cmdRemove(depName)
        } elsif fly.str.equals(cmd, "why") {
            string depName = ""
            if n >= 3 { depName = this.argAt(args, 2) }
            out = fly.driver.cmdWhy(depName)
        } else {
            out = fly.driver.cmdNotPorted(cmd)
        }
    }

    // defaultOut — `<input>.fly` → `<input>.ll` (default IR extension). Kept as a
    // 1-arg overload for callers/tests that only want the IR path.
    public string defaultOut(const string input) {
        out = this.defaultOut(input, ".ll")
    }

    // defaultOut — `<input>.fly` → `<input><ext>`, else append `<ext>`.
    public string defaultOut(const string input, const string ext) {
        if fly.str.endsWith(input, ".fly") {
            int L = fly.str.len(input)
            string base = fly.str.substring(input, 0, L - 4)
            out = fly.str.concat(base, ext)
        } else {
            out = fly.str.concat(input, ext)
        }
    }

    // moduleName — the input path minus a trailing `.fly` extension.
    public string moduleName(const string input) {
        if fly.str.endsWith(input, ".fly") {
            int L = fly.str.len(input)
            out = fly.str.substring(input, 0, L - 4)
        } else {
            out = input
        }
    }
}
