namespace fly.driver

import fly.str
import fly.os.fs
import fly.os.env

// ─────────────────────────────────────────────────────────────────────────────
// GitFetcher — clone/fetch a git dependency into the cache and resolve its ref to a
// commit. Port of fly/tools/flyp/fetcher/GitFetcher.{h,cpp}. All git work goes
// through the shell (fly.driver.runShell/capture), mirroring the C++ popen/system use.
// Everything is a method (this module pulls the manifest reader → the toml reader; a free
// function returning a class with an out-param crashes the reference there).
// ─────────────────────────────────────────────────────────────────────────────

// Result of a successful fetch.
public class FetchResult {
    string rev          // full 40-char commit hash
    string version      // semver from tag, else "0.0.0"
    string localPath    // cache entry directory
    string checksum     // sha256: of the fly.toml inside
    bool ok             // false on failure (Fly has no exceptions here)
    string errMsg

    public FetchResult() {
        this.rev = ""
        this.version = "0.0.0"
        this.localPath = ""
        this.checksum = "sha256:"
        this.ok = false
        this.errMsg = ""
    }
    public string getRev()      { out = this.rev }
    public string getVersion()  { out = this.version }
    public string getLocalPath() { out = this.localPath }
    public string getChecksum() { out = this.checksum }
    public bool getOk()         { out = this.ok }
    public string getErrMsg()   { out = this.errMsg }

    public void setRev(const string v)       { this.rev = v }
    public void setVersion(const string v)   { this.version = v }
    public void setLocalPath(const string v) { this.localPath = v }
    public void setChecksum(const string v)  { this.checksum = v }
    public void setOk(const bool v)          { this.ok = v }
    public void setError(const string v)     { this.errMsg = v }
}

public class GitFetcher {
    Cache cache

    public GitFetcher(const Cache c) { this.cache = c }

    // fetch — resolve dep.ref to a commit, store the tree in the cache. On any
    // git/network failure returns a FetchResult with ok=false + an error message.
    public FetchResult fetch(const string name, const GitDep dep) {
        FetchResult r = new FetchResult()
        string url = dep.getGitUrl()
        int refKind = dep.getRefKind()       // 0=Tag 1=Branch 2=Rev
        string refVal = dep.getRefValue()

        string tmpdir = fly.os.env.get("TMPDIR")
        if fly.str.isEmpty(tmpdir) { tmpdir = "/tmp" }
        string bare = fly.str.concat(tmpdir, fly.str.concat("/fly-bare-", name))
        fly.driver.runShell(fly.str.concat("rm -rf ", fly.driver.shellQuote(bare)))

        // 1) clone --bare (shallow for tag/branch, full for rev)
        string cloneCmd = ""
        if refKind == 2 {
            cloneCmd = fly.str.concat("git clone --quiet --bare ",
                       fly.str.concat(fly.driver.shellQuote(url),
                       fly.str.concat(" ", fly.driver.shellQuote(bare))))
        } else {
            string pre = fly.str.concat("git clone --quiet --bare --depth=1 --branch ",
                         fly.driver.shellQuote(refVal))
            cloneCmd = fly.str.concat(pre, fly.str.concat(" ",
                       fly.str.concat(fly.driver.shellQuote(url),
                       fly.str.concat(" ", fly.driver.shellQuote(bare)))))
        }
        int rc = fly.driver.runShell(fly.str.concat(cloneCmd, " 2>/dev/null"))
        if rc != 0 {
            fly.driver.runShell(fly.str.concat("rm -rf ", fly.driver.shellQuote(bare)))
            r.errMsg = fly.str.concat("failed to clone ", fly.str.concat(url, fly.str.concat(" ref=", refVal)))
            out = r
            return
        }

        // 2) resolve the commit hash
        string rev = ""
        if refKind == 2 {
            string vc = fly.str.concat("git -C ", fly.str.concat(fly.driver.shellQuote(bare),
                        fly.str.concat(" rev-parse --verify ", fly.driver.shellQuote(refVal))))
            rev = fly.driver.trimTrailingNewline(fly.driver.capture(vc))
        } else {
            string hc = fly.str.concat("git -C ", fly.str.concat(fly.driver.shellQuote(bare), " rev-parse HEAD"))
            rev = fly.driver.trimTrailingNewline(fly.driver.capture(hc))
        }
        if fly.str.len(rev) != 40 {
            fly.driver.runShell(fly.str.concat("rm -rf ", fly.driver.shellQuote(bare)))
            r.errMsg = fly.str.concat("could not resolve commit hash for ", name)
            out = r
            return
        }

        // version from a tag ref
        string version = "0.0.0"
        if refKind == 0 {
            SemVer sv = semverParse(refVal)
            version = sv.str()
        }

        // 3) cache hit?
        if this.cache.has(url, rev) {
            fly.driver.runShell(fly.str.concat("rm -rf ", fly.driver.shellQuote(bare)))
            string entry = this.cache.entryPath(url, rev)
            r.rev = rev
            r.version = version
            r.localPath = entry
            r.checksum = this.tomlChecksum(entry)
            r.ok = true
            out = r
            return
        }

        // 4) extract the tree into the cache entry via `git archive | tar`
        this.cache.prepare(url, rev)
        string entry = this.cache.entryPath(url, rev)
        string arch = fly.str.concat("git -C ", fly.str.concat(fly.driver.shellQuote(bare),
                      fly.str.concat(" archive ", fly.str.concat(fly.driver.shellQuote(rev),
                      fly.str.concat(" | tar -x -C ", fly.driver.shellQuote(entry))))))
        int arc = fly.driver.runShell(arch)
        fly.driver.runShell(fly.str.concat("rm -rf ", fly.driver.shellQuote(bare)))

        string tomlPath = fly.str.concat(entry, "/fly.toml")
        if arc != 0 || fly.os.fs.exists(tomlPath) == false {
            // fallback: full clone into the entry
            fly.driver.runShell(fly.str.concat("rm -rf ", fly.driver.shellQuote(entry)))
            string fc = fly.str.concat("git clone --quiet ",
                        fly.str.concat(fly.driver.shellQuote(url), fly.str.concat(" ", fly.driver.shellQuote(entry))))
            fly.driver.runShell(fc)
            if refKind == 2 {
                string co = fly.str.concat("git -C ", fly.str.concat(fly.driver.shellQuote(entry),
                            fly.str.concat(" checkout --quiet ", fly.driver.shellQuote(refVal))))
                fly.driver.runShell(co)
            }
        }

        r.rev = rev
        r.version = version
        r.localPath = entry
        r.checksum = this.tomlChecksum(entry)
        r.ok = true
        out = r
    }

    // tomlChecksum — sha256 of <entry>/fly.toml (or "sha256:" if absent).
    public string tomlChecksum(const string entry) {
        string tomlPath = fly.str.concat(entry, "/fly.toml")
        if fly.os.fs.exists(tomlPath) {
            out = fly.driver.sha256File(tomlPath)
        } else {
            out = "sha256:"
        }
    }

    // readManifest — parse <entry>/fly.toml. `errOut`: 1 = no fly.toml, else the
    // manifest parser code.
    public Manifest readManifest(const string name, const string entry, int errOut) {
        string tomlPath = fly.str.concat(entry, "/fly.toml")
        if fly.os.fs.exists(tomlPath) == false {
            errOut = 1
            out = new Manifest()
            return
        }
        string src = fly.os.fs.readStr(tomlPath)
        int e = 0
        Manifest m = parseManifest(src, e)
        errOut = e
        out = m
    }

    // listTags — remote tags (for error hints).
    public string listTags(const string url) {
        string cmd = fly.str.concat("git ls-remote --tags ",
                     fly.str.concat(fly.driver.shellQuote(url),
                     " | awk '{print $2}' | sed 's|refs/tags/||' | grep -v '\\^{}'"))
        out = fly.driver.capture(cmd)
    }
}
