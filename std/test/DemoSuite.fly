import fly.assert

// End-to-end fixture for the suite runner: every case passes, so the binary
// must print the full report and exit 0. ctest matches the summary line.

int add(const int a, const int b) {
    out = a + b
}

suite DemoSuite {
    void setup() { }
    void teardown() { }

    void addTest() {
        case "small": {
            int r = add(1, 2)
            assert.assertEqI(r, 3, 1)
        }
        case "negative": {
            int r = add(0 - 2, 1)
            assert.assertEqI(r, 0 - 1, 2)
        }
    }

    void boolTest() {
        case "true": {
            assert.assertTrue(1 < 2, 3)
        }
    }
}
