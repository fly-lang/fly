import fly.os.time
import fly.os.time.Time
import fly.os.time.Duration
import fly.str
import fly.assert

// ─────────────────────────────────────────────────────────────────────────────
// OsTimeSuite — fly.os.time (std/lib/os/time.fly): the Time and Duration value
// types, the clocks, the arithmetic and comparison helpers, and the Go-style
// layout formatter/parser ("2006-01-02T15:04:05").
//
// Wall-clock values cannot be pinned, so the clock cases assert INVARIANTS —
// monotonic never goes backwards, since() is non-negative, now() is past the
// epoch — while every formatting and parsing case uses a FIXED epoch second so
// it is exact and host-independent.
//
// The formatter is exercised across the field boundaries that historically break
// civil-date code: the epoch itself, a leap day, an end-of-year rollover,
// midnight vs noon, and zero-padding of single-digit fields. format/parse are
// then checked as inverses over a spread of timestamps.
//
//
// Assert codes: 1xx clocks, 2xx conversion, 3xx arithmetic and compare,
// 4xx formatSec, 5xx parseToSec, 6xx duration accessors, 7xx duration formatting.
// ─────────────────────────────────────────────────────────────────────────────

suite OsTimeSuite {

    // ── the clocks ───────────────────────────────────────────────────────────
    void clockTest() {
        case "nowSec is well past the epoch": {
            long ts = time.nowSec()
            assert.assertTrue(ts > 0, 101)
            assert.assertTrue(ts > 1600000000, 102)      // after Sep 2020
        }
        case "nowSec does not go backwards": {
            long a = time.nowSec()
            long b = time.nowSec()
            assert.assertTrue(b >= a, 103)
        }
        case "now() carries a plausible sec and a normalised nsec": {
            Time t = time.now()
            assert.assertTrue(t.sec > 1600000000, 104)
            assert.assertTrue(t.nsec >= 0, 105)
            assert.assertTrue(t.nsec < 1000000000, 106)
        }
        case "monotonic never goes backwards": {
            Time a = time.monotonic()
            long a_ns = time.unixNano(a)
            bool ok = true
            int i = 0
            while i < 50 {
                Time b = time.monotonic()
                if time.unixNano(b) < a_ns { ok = false }
                i = i + 1
            }
            assert.assertTrue(ok, 107)
        }
        case "since() on a monotonic reading is non-negative": {
            Time start = time.monotonic()
            long spin = 0
            int i = 0
            while i < 10000 {
                spin = spin + i
                i = i + 1
            }
            Duration d = time.since(start)
            assert.assertTrue(d.nsec >= 0, 108)
            assert.assertTrue(spin > 0, 109)             // keep the loop alive
        }
        case "sleep of a zero duration returns": {
            Duration z = new Duration()
            z.nsec = 0
            time.sleep(z)
            assert.assertEqL(z.nsec, 0, 110)
        }
    }

    // ── unix / unixNano / fromUnix / fromUnixNano ────────────────────────────
    void conversionTest() {
        case "fromUnix then unix round-trips": {
            Time t = time.fromUnix(1000000000)
            assert.assertEqL(t.sec, 1000000000, 201)
            assert.assertEqL(t.nsec, 0, 202)
            assert.assertEqL(time.unix(t), 1000000000, 203)
        }
        case "the epoch itself": {
            Time t = time.fromUnix(0)
            assert.assertEqL(t.sec, 0, 204)
            assert.assertEqL(time.unix(t), 0, 205)
            assert.assertEqL(time.unixNano(t), 0, 206)
        }
        case "unixNano scales seconds by 1e9": {
            Time t = time.fromUnix(2)
            assert.assertEqL(time.unixNano(t), 2000000000, 207)
        }
        case "fromUnixNano splits seconds and nanoseconds": {
            Time t = time.fromUnixNano(1500000000)       // 1.5 s
            assert.assertEqL(t.sec, 1, 208)
            assert.assertEqL(t.nsec, 500000000, 209)
            assert.assertEqL(time.unixNano(t), 1500000000, 210)
        }
        case "fromUnixNano with no sub-second part": {
            Time t = time.fromUnixNano(3000000000)
            assert.assertEqL(t.sec, 3, 211)
            assert.assertEqL(t.nsec, 0, 212)
        }
        case "a pre-epoch timestamp": {
            Time t = time.fromUnix(0 - 86400)            // one day before the epoch
            assert.assertEqL(t.sec, 0 - 86400, 213)
            assert.assertEqL(time.unix(t), 0 - 86400, 214)
        }
    }

    // ── add / diff / compare ─────────────────────────────────────────────────
    //
    // Every Time here is built field-by-field with `new Time()` rather than via
    // fromUnix(), so the operands of add/diff/compare are literal and the
    // expected results do not depend on the conversion helpers — those are
    // covered separately in conversionTest.
    void arithmeticTest() {
        case "add advances a Time by a Duration": {
            Time base = new Time()
            base.sec = 1000
            base.nsec = 0
            Duration d = new Duration()
            d.nsec = 5000000000                          // 5 s
            Time later = time.add(base, d)
            assert.assertEqL(later.sec, 1005, 301)
        }
        case "add of a zero duration is the identity": {
            Time base = new Time()
            base.sec = 1000
            base.nsec = 0
            Duration z = new Duration()
            z.nsec = 0
            Time same = time.add(base, z)
            assert.assertEqL(same.sec, 1000, 302)
            assert.assertEqL(same.nsec, 0, 303)
        }
        case "add of a negative duration goes backwards": {
            Time base = new Time()
            base.sec = 1000
            base.nsec = 0
            Duration back = new Duration()
            back.nsec = 0 - 3000000000                   // -3 s
            Time earlier = time.add(base, back)
            assert.assertEqL(earlier.sec, 997, 304)
        }
        case "diff measures the gap between two Times": {
            // diff(a, b) is b - a: the EARLIER time goes first.
            Time a = new Time()
            a.sec = 1000
            a.nsec = 0
            Time b = new Time()
            b.sec = 1010
            b.nsec = 0
            Duration d = time.diff(a, b)
            assert.assertEqL(time.durationSecs(d), 10, 305)
        }
        case "diff is antisymmetric": {
            Time a = new Time()
            a.sec = 1000
            a.nsec = 0
            Time b = new Time()
            b.sec = 1010
            b.nsec = 0
            Duration back = time.diff(b, a)
            assert.assertEqL(time.durationSecs(back), 0 - 10, 306)
        }
        case "diff accounts for the nanosecond field": {
            Time a = new Time()
            a.sec = 1000
            a.nsec = 250000000
            Time b = new Time()
            b.sec = 1000
            b.nsec = 750000000
            Duration d = time.diff(a, b)
            assert.assertEqL(d.nsec, 500000000, 312)
            assert.assertEqL(time.durationMillis(d), 500, 313)
        }
        case "compare orders two Times": {
            Time early = new Time()
            early.sec = 1000
            early.nsec = 0
            Time late = new Time()
            late.sec = 2000
            late.nsec = 0
            assert.assertTrue(time.compare(early, late) < 0, 307)
            assert.assertTrue(time.compare(late, early) > 0, 308)
        }
        case "compare of equal Times is 0": {
            Time a = new Time()
            a.sec = 1000
            a.nsec = 0
            Time b = new Time()
            b.sec = 1000
            b.nsec = 0
            assert.assertEqI(time.compare(a, b), 0, 309)
        }
        case "compare breaks ties on nanoseconds": {
            Time a = new Time()
            a.sec = 1
            a.nsec = 0
            Time b = new Time()
            b.sec = 1
            b.nsec = 1
            assert.assertTrue(time.compare(a, b) < 0, 310)
            assert.assertTrue(time.compare(b, a) > 0, 311)
        }
    }

    // ── formatSec: the Go-style layout formatter ─────────────────────────────
    void formatTest() {
        case "date, time, and combined layouts": {
            assert.assertStr(time.formatSec(1000000000, "2006-01-02"), "2001-09-09", 401)
            assert.assertStr(time.formatSec(1000000000, "15:04:05"), "01:46:40", 402)
            assert.assertStr(time.formatSec(1000000000, "2006-01-02T15:04:05"),
                             "2001-09-09T01:46:40", 403)
        }
        case "the epoch": {
            assert.assertStr(time.formatSec(0, "2006-01-02"), "1970-01-01", 404)
            assert.assertStr(time.formatSec(0, "15:04:05"), "00:00:00", 405)
        }
        case "single-digit fields are zero-padded": {
            // 1970-01-02 03:04:05 UTC
            long ts = 86400 + 3 * 3600 + 4 * 60 + 5
            assert.assertStr(time.formatSec(ts, "2006-01-02"), "1970-01-02", 406)
            assert.assertStr(time.formatSec(ts, "15:04:05"), "03:04:05", 407)
        }
        case "end-of-day and end-of-year boundaries": {
            assert.assertStr(time.formatSec(86399, "2006-01-02T15:04:05"),
                             "1970-01-01T23:59:59", 408)
            assert.assertStr(time.formatSec(86400, "2006-01-02T15:04:05"),
                             "1970-01-02T00:00:00", 409)
            // 1999-12-31T23:59:59 UTC → the next second rolls the year
            assert.assertStr(time.formatSec(946684799, "2006-01-02T15:04:05"),
                             "1999-12-31T23:59:59", 410)
            assert.assertStr(time.formatSec(946684800, "2006-01-02T15:04:05"),
                             "2000-01-01T00:00:00", 411)
        }
        case "a leap day": {
            // 2000-02-29T00:00:00 UTC (2000 is a leap year: divisible by 400)
            assert.assertStr(time.formatSec(951782400, "2006-01-02"), "2000-02-29", 412)
            assert.assertStr(time.formatSec(951868800, "2006-01-02"), "2000-03-01", 413)
        }
        case "a layout with no fields is copied through": {
            assert.assertStr(time.formatSec(0, "no fields here"), "no fields here", 414)
            assert.assertEmpty(time.formatSec(0, ""), 415)
        }
        case "format(Time) agrees with formatSec": {
            Time t = time.fromUnix(1000000000)
            assert.assertStr(time.format(t, "2006-01-02"), "2001-09-09", 416)
            assert.assertStr(time.format(t, "2006-01-02T15:04:05"),
                             time.formatSec(1000000000, "2006-01-02T15:04:05"), 417)
        }
    }

    // ── parseToSec: the inverse of formatSec ─────────────────────────────────
    void parseTest() {
        case "a full timestamp": {
            assert.assertEqL(time.parseToSec("2001-09-09T01:46:40", "2006-01-02T15:04:05"),
                             1000000000, 501)
        }
        case "a date-only layout lands at midnight": {
            assert.assertEqL(time.parseToSec("1970-01-01", "2006-01-02"), 0, 502)
            assert.assertEqL(time.parseToSec("1970-01-02", "2006-01-02"), 86400, 503)
        }
        case "the year-2000 boundary": {
            assert.assertEqL(time.parseToSec("2000-01-01T00:00:00", "2006-01-02T15:04:05"),
                             946684800, 504)
        }
        case "a leap day": {
            assert.assertEqL(time.parseToSec("2000-02-29", "2006-01-02"), 951782400, 505)
        }
        case "parse and format are inverses": {
            long bad = 0 - 1
            long stamps = 0
            // A spread across decades, leap years and mid-year points.
            long i = 0
            while i < 40 {
                long ts = i * 31536000                    // one year apart-ish
                string s = time.formatSec(ts, "2006-01-02T15:04:05")
                if time.parseToSec(s, "2006-01-02T15:04:05") != ts { bad = ts }
                stamps = stamps + 1
                i = i + 1
            }
            assert.assertEqL(bad, 0 - 1, 506)
            assert.assertEqL(stamps, 40, 507)
        }
        case "parse(Time) agrees with parseToSec": {
            Time t = time.parse("2001-09-09T01:46:40", "2006-01-02T15:04:05")
            assert.assertEqL(t.sec, 1000000000, 508)
        }
    }

    // ── Duration accessors ───────────────────────────────────────────────────
    void durationTest() {
        case "secs / millis / micros of one second": {
            Duration d = new Duration()
            d.nsec = 1000000000
            assert.assertEqL(time.durationSecs(d), 1, 601)
            assert.assertEqL(time.durationMillis(d), 1000, 602)
            assert.assertEqL(time.durationMicros(d), 1000000, 603)
        }
        case "sub-second durations truncate toward zero": {
            Duration d = new Duration()
            d.nsec = 1500000
            assert.assertEqL(time.durationSecs(d), 0, 604)
            assert.assertEqL(time.durationMillis(d), 1, 605)
            assert.assertEqL(time.durationMicros(d), 1500, 606)
        }
        case "a zero duration": {
            Duration d = new Duration()
            d.nsec = 0
            assert.assertEqL(time.durationSecs(d), 0, 607)
            assert.assertEqL(time.durationMillis(d), 0, 608)
            assert.assertEqL(time.durationMicros(d), 0, 609)
        }
        case "a negative duration": {
            Duration d = new Duration()
            d.nsec = 0 - 2000000000
            assert.assertEqL(time.durationSecs(d), 0 - 2, 610)
            assert.assertEqL(time.durationMillis(d), 0 - 2000, 611)
        }
        case "a long duration": {
            Duration d = new Duration()
            d.nsec = 5405000000000                        // 1h30m05s
            assert.assertEqL(time.durationSecs(d), 5405, 612)
        }
    }

    // ── durationFormat / durationFormatNsec ──────────────────────────────────
    void durationFormatTest() {
        case "hours, minutes and seconds": {
            assert.assertStr(time.durationFormatNsec(5405000000000), "1h30m05s", 701)
        }
        case "sub-second units pick the right suffix": {
            assert.assertStr(time.durationFormatNsec(500000000), "500ms", 702)
            assert.assertStr(time.durationFormatNsec(200000), "200us", 703)
            assert.assertStr(time.durationFormatNsec(5), "5ns", 704)
        }
        case "zero": {
            assert.assertStr(time.durationFormatNsec(0), "0s", 705)
        }
        case "exact unit boundaries": {
            assert.assertStr(time.durationFormatNsec(1000), "1us", 706)
            assert.assertStr(time.durationFormatNsec(1000000), "1ms", 707)
            assert.assertStr(time.durationFormatNsec(999), "999ns", 708)
        }
        case "durationFormat agrees with durationFormatNsec": {
            Duration d = new Duration()
            d.nsec = 5405000000000
            assert.assertStr(time.durationFormat(d),
                             time.durationFormatNsec(5405000000000), 709)
        }
    }
}
