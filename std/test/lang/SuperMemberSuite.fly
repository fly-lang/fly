import fly.assert

// ─────────────────────────────────────────────────────────────────────────────
// SuperMemberSuite — `super.method()` and `super.attribute`.
//
// `super.method()` is a NON-VIRTUAL call to the base implementation, which is
// what lets an override extend the base behaviour instead of recursing into
// itself. `super.attribute` reads and writes an inherited field.
//
// The cases pin, in order:
//   * an override calling super.method() does not recurse (B.label);
//   * a non-overridden base method reached through super;
//   * reading an inherited protected field through super;
//   * WRITING an inherited field through super, then reading it back;
//   * a two-level chain, where the middle class's super.method() resolves to the
//     grandparent while the leaf's resolves to the middle;
//   * reaching a grandparent field through the immediate base's super;
//   * that super dispatch is static — a base-typed reference to a leaf still
//     runs the leaf's override, which still calls exactly one level up.
//
// Assert codes: 1xx one level, 2xx inherited fields, 3xx two levels,
// 4xx dispatch interaction.
// ─────────────────────────────────────────────────────────────────────────────

class A {
    int a
    protected int p
    public A(const int x) { this.a = x  this.p = x * 10 }
    public int label() { out = this.a }               // overridden below
    public int onlyA() { out = this.a + 1 }           // never overridden
    public int readOwnP() { out = this.p }
}

class B : A {
    int b
    public B(const int x, const int y) { super(x)  this.b = y }
    // Extends the base via super.label() — must NOT recurse into B.label().
    public int label() { out = super.label() + this.b }
    public int readP() { out = super.p }
    public void bumpP() { super.p = super.p + 5 }
    public void setP(const int v) { super.p = v }
    public int viaSuperOnlyA() { out = super.onlyA() }
    public int readSuperA() { out = super.a }
    public void bumpSuperA() { super.a = super.a + 1 }
}

class C : B {
    int c
    public C(const int x, const int y, const int z) { super(x, y)  this.c = z }
    // super here is B, whose label() itself calls A.label().
    public int label() { out = super.label() + this.c }
    public int readGrandP() { out = super.p }         // A.p through B
    public int viaSuperReadP() { out = super.readP() }// B.readP(), which uses super
}

suite SuperMemberSuite {

    // ── one level: super.method() ────────────────────────────────────────────
    void oneLevelTest() {
        case "an override extends the base without recursing": {
            B o = new B(3, 4)
            assert.assertEqI(o.label(), 7, 101)        // A.label()=3 + b=4
        }
        case "a non-overridden base method through super": {
            B o = new B(3, 4)
            assert.assertEqI(o.viaSuperOnlyA(), 4, 102) // A.onlyA() = a+1 = 4
        }
        case "the base implementation is unchanged for base instances": {
            A base = new A(3)
            assert.assertEqI(base.label(), 3, 103)
            assert.assertEqI(base.onlyA(), 4, 104)
        }
        case "several instances keep their own values": {
            B x = new B(1, 1)
            B y = new B(10, 20)
            assert.assertEqI(x.label(), 2, 105)
            assert.assertEqI(y.label(), 30, 106)
        }
    }

    // ── inherited fields through super ───────────────────────────────────────
    void inheritedFieldTest() {
        case "reading an inherited protected field": {
            B o = new B(3, 4)
            assert.assertEqI(o.readP(), 30, 201)       // p = 3 * 10
            assert.assertEqI(o.readSuperA(), 3, 202)
        }
        case "writing an inherited field through super": {
            B o = new B(3, 4)
            o.bumpP()
            assert.assertEqI(o.readP(), 35, 203)
            o.bumpP()
            assert.assertEqI(o.readP(), 40, 204)
        }
        case "a write through super is visible to the base's own accessor": {
            B o = new B(3, 4)
            o.setP(77)
            assert.assertEqI(o.readP(), 77, 205)
            assert.assertEqI(o.readOwnP(), 77, 206)    // A.readOwnP() sees it too
        }
        case "writing an inherited field changes what the base method returns": {
            B o = new B(3, 4)
            o.bumpSuperA()                             // a: 3 -> 4
            assert.assertEqI(o.readSuperA(), 4, 207)
            assert.assertEqI(o.label(), 8, 208)        // A.label()=4 + b=4
        }
        case "field writes are per-instance": {
            B x = new B(3, 4)
            B y = new B(3, 4)
            x.setP(1)
            assert.assertEqI(x.readP(), 1, 209)
            assert.assertEqI(y.readP(), 30, 210)       // untouched
        }
    }

    // ── two levels ───────────────────────────────────────────────────────────
    void twoLevelTest() {
        case "each level's super resolves one step up": {
            C d = new C(1, 2, 5)
            // C.label() = B.label() + c ; B.label() = A.label() + b = 1 + 2 = 3
            assert.assertEqI(d.label(), 8, 301)        // 3 + 5
        }
        case "a grandparent field through the immediate base": {
            C d = new C(1, 2, 5)
            assert.assertEqI(d.readGrandP(), 10, 302)  // A.p = 1 * 10
        }
        case "a base method that itself uses super": {
            C d = new C(1, 2, 5)
            assert.assertEqI(d.viaSuperReadP(), 10, 303)
        }
        case "a write two levels up propagates back down": {
            C d = new C(1, 2, 5)
            d.bumpP()                                  // B.bumpP writes A.p
            assert.assertEqI(d.readGrandP(), 15, 304)
            assert.assertEqI(d.readOwnP(), 15, 305)
        }
        case "the middle class is unaffected by the leaf's override": {
            B mid = new B(1, 2)
            assert.assertEqI(mid.label(), 3, 306)
            C leaf = new C(1, 2, 5)
            assert.assertEqI(leaf.label(), 8, 307)
        }
    }

    // ── interaction with virtual dispatch ────────────────────────────────────
    void dispatchTest() {
        case "a base reference to a leaf runs the leaf's override": {
            C d = new C(1, 2, 5)
            A asA = d
            assert.assertEqI(asA.label(), 8, 401)      // C.label(), not A.label()
            B asB = d
            assert.assertEqI(asB.label(), 8, 402)
        }
        case "super stays non-virtual under a derived reference": {
            // B.label() calls super.label(); even for a C instance that must be
            // A.label(), never C.label() — otherwise this would not terminate.
            C d = new C(2, 3, 4)
            assert.assertEqI(d.label(), 9, 403)        // (2 + 3) + 4
        }
        case "repeated calls are stable": {
            C d = new C(1, 2, 5)
            int bad = 0 - 1
            int i = 0
            while i < 50 {
                if d.label() != 8 { bad = i }
                i = i + 1
            }
            assert.assertEqI(bad, 0 - 1, 404)
        }
    }
}
