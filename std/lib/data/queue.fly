namespace fly.data

import fly.llvm
import fly.runtime

// Queue<T> — FIFO over a power-of-two circular buffer, the Fly analog of
// C++ std::queue<T>. Ownership: enqueue deep-clones owned values (string);
// dequeue transfers ownership to the caller; free releases live elements.
// Sizes, cursors and indices are `pointer` (the Fly usize). head/tail wrap with
// `& (cap - 1)` over power-of-two capacities: unsigned wraparound stays correct.
public class Queue<T> {
    pointer items
    pointer head
    pointer tail
    pointer len
    pointer cap
    pointer stride

    public Queue() {
        this.items = 0
        this.head = 0
        this.tail = 0
        this.len = 0
        this.cap = 0
        this.stride = 0
    }

    public void enqueue(const T val) {
        if this.stride == 0 {
            int s = 0
            fly.llvm.slotSizeT(val, s)
            this.stride = s
        }
        if this.items == 0 {
            pointer ni = 0
            fly.runtime.mem_alloc(8 * this.stride, ni)
            this.items = ni
            this.cap = 8
        }
        if this.len >= this.cap {
            pointer newcap = this.cap * 2
            pointer ni = 0
            fly.runtime.mem_alloc(newcap * this.stride, ni)
            pointer gi = 0
            while gi < this.len {
                pointer idx = (this.head + gi) & (this.cap - 1)
                pointer srcoff = idx * this.stride
                pointer dstoff = gi * this.stride
                pointer src = this.items + srcoff
                pointer dst = ni + dstoff
                pointer nb = this.stride
                fly.llvm.memcpy(dst, src, nb)
                gi = gi + 1
            }
            fly.runtime.mem_free(this.items, this.cap * this.stride)
            this.items = ni
            this.head = 0
            this.tail = this.len
            this.cap = newcap
        }
        fly.llvm.slotPokeT(this.items, this.tail * this.stride, val)
        this.tail = (this.tail + 1) & (this.cap - 1)
        this.len = this.len + 1
    }

    public T dequeue() {
        T res
        if this.len == 0 {
            T def
            return def
        }
        fly.llvm.slotReadT(this.items, this.head * this.stride, res)
        T probe
        fly.llvm.slotFreeT(this.items, this.head * this.stride, probe)
        this.head = (this.head + 1) & (this.cap - 1)
        this.len = this.len - 1
        return res
    }

    public T peek() {
        T res
        if this.len == 0 {
            T def
            return def
        }
        fly.llvm.slotReadT(this.items, this.head * this.stride, res)
        return res
    }

    public bool isEmpty() {
        return this.len == 0
    }

    public pointer size() {
        return this.len
    }

    public void free() {
        T probe
        pointer i = 0
        while i < this.len {
            pointer idx = (this.head + i) & (this.cap - 1)
            fly.llvm.slotFreeT(this.items, idx * this.stride, probe)
            i = i + 1
        }
        this.len = 0
        if this.items != 0 {
            fly.runtime.mem_free(this.items, this.cap * this.stride)
        }
        // Back to the empty state: the freed buffers must not stay reachable. A
        // second free() released them again, and an add() after free() wrote
        // into freed memory; now both work (every add re-allocates lazily).
        this.items = 0
        this.head = 0
        this.tail = 0
        this.len = 0
        this.cap = 0
    }
}
