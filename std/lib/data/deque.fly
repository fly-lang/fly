namespace fly.data

import fly.llvm
import fly.runtime

// Deque<T> — double-ended queue over a power-of-two circular buffer, the Fly analog
// of C++ std::deque<T>. Ownership: pushes deep-clone owned values (string); pops
// transfer ownership to the caller; free releases live elements.
// Sizes, cursors and indices are `pointer` (the Fly usize). head/tail wrap with
// `& (cap - 1)` over power-of-two capacities, so `(head - 1) & (cap - 1)` stays
// correct under unsigned wraparound (0-1 ≡ 2^64-1, masked back to cap-1).
public class Deque<T> {
    pointer items
    pointer head
    pointer tail
    pointer len
    pointer cap
    pointer stride

    public Deque() {
        this.items = 0
        this.head = 0
        this.tail = 0
        this.len = 0
        this.cap = 0
        this.stride = 0
    }

    public void pushBack(const T val) {
        if this.stride == 0 {
            int s = 0
            fly.llvm.slotSizeT(val, s)
            this.stride = s
        }
        if this.items == 0 {
            pointer a0 = 0
            fly.runtime.mem_alloc(8 * this.stride, a0)
            this.items = a0
            this.cap = 8
        }
        if this.len >= this.cap {
            pointer newcap = this.cap * 2
            pointer ni = 0
            fly.runtime.mem_alloc(newcap * this.stride, ni)
            pointer gi = 0
            while gi < this.len {
                pointer idx = (this.head + gi) & (this.cap - 1)
                pointer soff = idx * this.stride
                pointer doff = gi * this.stride
                pointer src = this.items + soff
                pointer dst = ni + doff
                pointer nb = this.stride
                fly.llvm.memcpy(dst, src, nb)
                gi = gi + 1
            }
            fly.runtime.mem_free(this.items, this.cap * this.stride)
            this.items = ni
            this.head = 0
            this.tail = this.len
            this.cap = newcap
        }
        fly.llvm.slotPokeT(this.items, this.tail * this.stride, val)
        this.tail = (this.tail + 1) & (this.cap - 1)
        this.len = this.len + 1
    }

    public void pushFront(const T val) {
        if this.stride == 0 {
            int s = 0
            fly.llvm.slotSizeT(val, s)
            this.stride = s
        }
        if this.items == 0 {
            pointer a0 = 0
            fly.runtime.mem_alloc(8 * this.stride, a0)
            this.items = a0
            this.cap = 8
        }
        if this.len >= this.cap {
            pointer newcap = this.cap * 2
            pointer ni = 0
            fly.runtime.mem_alloc(newcap * this.stride, ni)
            pointer gi = 0
            while gi < this.len {
                pointer idx = (this.head + gi) & (this.cap - 1)
                pointer soff = idx * this.stride
                pointer doff = gi * this.stride
                pointer src = this.items + soff
                pointer dst = ni + doff
                pointer nb = this.stride
                fly.llvm.memcpy(dst, src, nb)
                gi = gi + 1
            }
            fly.runtime.mem_free(this.items, this.cap * this.stride)
            this.items = ni
            this.head = 0
            this.tail = this.len
            this.cap = newcap
        }
        pointer newhead = (this.head - 1) & (this.cap - 1)
        fly.llvm.slotPokeT(this.items, newhead * this.stride, val)
        this.head = newhead
        this.len = this.len + 1
    }

    public T popFront() {
        if this.len == 0 {
            T def
            out = def
            return
        }
        fly.llvm.slotReadT(this.items, this.head * this.stride, out)
        T probe
        fly.llvm.slotFreeT(this.items, this.head * this.stride, probe)
        this.head = (this.head + 1) & (this.cap - 1)
        this.len = this.len - 1
    }

    public T popBack() {
        if this.len == 0 {
            T def
            out = def
            return
        }
        pointer newtail = (this.tail - 1) & (this.cap - 1)
        fly.llvm.slotReadT(this.items, newtail * this.stride, out)
        T probe
        fly.llvm.slotFreeT(this.items, newtail * this.stride, probe)
        this.tail = newtail
        this.len = this.len - 1
    }

    public T peekFront() {
        if this.len == 0 {
            T def
            out = def
            return
        }
        fly.llvm.slotReadT(this.items, this.head * this.stride, out)
    }

    public T peekBack() {
        if this.len == 0 {
            T def
            out = def
            return
        }
        pointer last = (this.tail - 1) & (this.cap - 1)
        fly.llvm.slotReadT(this.items, last * this.stride, out)
    }

    public bool isEmpty() {
        out = this.len == 0
    }

    public pointer size() {
        out = this.len
    }

    public void free() {
        T probe
        pointer i = 0
        while i < this.len {
            pointer idx = (this.head + i) & (this.cap - 1)
            fly.llvm.slotFreeT(this.items, idx * this.stride, probe)
            i = i + 1
        }
        this.len = 0
        if this.items != 0 {
            fly.runtime.mem_free(this.items, this.cap * this.stride)
        }
    }
}
