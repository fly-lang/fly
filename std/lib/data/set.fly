namespace fly.data

import fly.llvm
import fly.runtime

// Set<T> — hash set with open addressing + tombstones, the Fly analog of
// C++ std::unordered_set<T>. Keys are hashed with slotHashT and compared with
// slotCmpT (lexicographic for string). Ownership: add deep-clones owned keys
// (string); remove/free release them. flags: 0=empty, 1=occupied, 2=tombstone.
// Sizes, capacities, strides and bucket cursors are `pointer` (the Fly usize);
// hashes stay `int` (i32); the tombstone slot uses an explicit bool (no -1).
public class Set<T> {
    pointer keys
    pointer flags
    pointer count
    pointer cap
    pointer stride

    public Set() {
        this.keys = 0
        this.flags = 0
        this.count = 0
        this.cap = 0
        this.stride = 0
    }

    public void add(const T key) {
        if this.stride == 0 {
            int s = 0
            fly.llvm.slotSizeT(key, s)
            this.stride = s
        }
        if this.keys == 0 {
            pointer nk = 0
            fly.runtime.mem_alloc(8 * this.stride, nk)
            pointer nf = 0
            fly.runtime.mem_alloc(8, nf)
            fly.llvm.memset(nf, 0, 8)
            this.keys = nk
            this.flags = nf
            this.cap = 8
        }
        if this.count * 4 >= this.cap * 3 {
            pointer newcap = this.cap * 2
            pointer nkeys = 0
            fly.runtime.mem_alloc(newcap * this.stride, nkeys)
            pointer nflags = 0
            fly.runtime.mem_alloc(newcap, nflags)
            fly.llvm.memset(nflags, 0, newcap)
            T probe
            pointer ri = 0
            while ri < this.cap {
                byte rfl = 0
                fly.llvm.ptrByteAt(this.flags, ri, rfl)
                if rfl == 1 {
                    int rh = 0
                    fly.llvm.slotHashAtT(this.keys, ri * this.stride, probe, rh)
                    if rh < 0 { rh = 0 - rh }
                    pointer rb = rh & (newcap - 1)
                    byte rnfl = 0
                    fly.llvm.ptrByteAt(nflags, rb, rnfl)
                    while rnfl != 0 {
                        rb = (rb + 1) & (newcap - 1)
                        fly.llvm.ptrByteAt(nflags, rb, rnfl)
                    }
                    pointer soff = ri * this.stride
                    pointer doff = rb * this.stride
                    pointer src = this.keys + soff
                    pointer dst = nkeys + doff
                    pointer nb = this.stride
                    fly.llvm.memcpy(dst, src, nb)
                    fly.llvm.ptrPokeByte(nflags, rb, 1)
                }
                ri = ri + 1
            }
            fly.runtime.mem_free(this.keys, this.cap * this.stride)
            fly.runtime.mem_free(this.flags, this.cap)
            this.keys = nkeys
            this.flags = nflags
            this.cap = newcap
        }
        int ph = 0
        fly.llvm.slotHashT(key, ph)
        if ph < 0 { ph = 0 - ph }
        pointer b = ph & (this.cap - 1)
        bool hasTs = false
        pointer ts = 0
        pointer probed = 0
        bool done = false
        while probed < this.cap {
            byte fl = 0
            fly.llvm.ptrByteAt(this.flags, b, fl)
            if fl == 1 {
                int c = 0
                fly.llvm.slotCmpT(this.keys, b * this.stride, key, c)
                if c == 0 {
                    done = true
                    probed = this.cap
                }
            }
            if done == false {
                if fl == 2 {
                    if hasTs == false {
                        ts = b
                        hasTs = true
                    }
                }
                if fl == 0 {
                    if hasTs { b = ts }
                    fly.llvm.slotPokeT(this.keys, b * this.stride, key)
                    fly.llvm.ptrPokeByte(this.flags, b, 1)
                    this.count = this.count + 1
                    done = true
                    probed = this.cap
                }
            }
            if done == false {
                b = (b + 1) & (this.cap - 1)
                probed = probed + 1
            }
        }
        if done == false {
            if hasTs {
                fly.llvm.slotPokeT(this.keys, ts * this.stride, key)
                fly.llvm.ptrPokeByte(this.flags, ts, 1)
                this.count = this.count + 1
            }
        }
    }

    public bool has(const T key) {
        if this.keys == 0 {
            out = false
            return
        }
        int hh = 0
        fly.llvm.slotHashT(key, hh)
        if hh < 0 { hh = 0 - hh }
        pointer b = hh & (this.cap - 1)
        pointer probed = 0
        bool found = false
        while probed < this.cap {
            byte fl = 0
            fly.llvm.ptrByteAt(this.flags, b, fl)
            if fl == 0 {
                probed = this.cap
            } elsif fl == 1 {
                int c = 0
                fly.llvm.slotCmpT(this.keys, b * this.stride, key, c)
                if c == 0 {
                    found = true
                    probed = this.cap
                } else {
                    b = (b + 1) & (this.cap - 1)
                    probed = probed + 1
                }
            } else {
                b = (b + 1) & (this.cap - 1)
                probed = probed + 1
            }
        }
        out = found
    }

    public void remove(const T key) {
        if this.keys == 0 { return }
        int rh = 0
        fly.llvm.slotHashT(key, rh)
        if rh < 0 { rh = 0 - rh }
        pointer b = rh & (this.cap - 1)
        pointer probed = 0
        while probed < this.cap {
            byte fl = 0
            fly.llvm.ptrByteAt(this.flags, b, fl)
            if fl == 0 {
                probed = this.cap
            } elsif fl == 1 {
                int c = 0
                fly.llvm.slotCmpT(this.keys, b * this.stride, key, c)
                if c == 0 {
                    T probe
                    fly.llvm.slotFreeT(this.keys, b * this.stride, probe)
                    fly.llvm.ptrPokeByte(this.flags, b, 2)
                    this.count = this.count - 1
                    probed = this.cap
                } else {
                    b = (b + 1) & (this.cap - 1)
                    probed = probed + 1
                }
            } else {
                b = (b + 1) & (this.cap - 1)
                probed = probed + 1
            }
        }
    }

    public pointer size() {
        out = this.count
    }

    public void free() {
        if this.keys != 0 {
            T probe
            pointer i = 0
            while i < this.cap {
                byte fl = 0
                fly.llvm.ptrByteAt(this.flags, i, fl)
                if fl == 1 {
                    fly.llvm.slotFreeT(this.keys, i * this.stride, probe)
                }
                i = i + 1
            }
            fly.runtime.mem_free(this.keys, this.cap * this.stride)
            fly.runtime.mem_free(this.flags, this.cap)
        }
    }
}
