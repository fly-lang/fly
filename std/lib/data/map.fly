namespace fly.data

import fly.llvm
import fly.runtime

// Map<K,V> — hash map with open addressing + tombstones, the Fly analog of
// C++ std::unordered_map<K,V>. Keys hashed with slotHashT, compared with slotCmpT.
// Ownership: keys and values each follow the C++/Rust model independently — owned
// values (string) are cloned on insert and freed on update/remove/free; trivial
// values are copied; handles are borrowed. flags: 0=empty, 1=occupied, 2=tombstone.
//
// Sizes, capacities, strides and bucket cursors are `pointer` (the Fly usize).
// Hashes stay `int` (slotHashT/slotHashAtT emit i32); a bucket index is the
// non-negative hash masked with the power-of-two capacity, so mixing is safe.
// The tombstone slot is tracked with an explicit bool (unsigned has no -1).
public class Map<K, V> {
    pointer keys
    pointer vals
    pointer flags
    pointer count
    pointer cap
    pointer kstride
    pointer vstride

    public Map() {
        this.keys = 0
        this.vals = 0
        this.flags = 0
        this.count = 0
        this.cap = 0
        this.kstride = 0
        this.vstride = 0
    }

    public void put(const K key, const V val) {
        if this.kstride == 0 {
            int ks = 0
            fly.llvm.slotSizeT(key, ks)
            this.kstride = ks
            int vs = 0
            fly.llvm.slotSizeT(val, vs)
            this.vstride = vs
        }
        if this.keys == 0 {
            pointer nk = 0
            fly.runtime.mem_alloc(8 * this.kstride, nk)
            pointer nv = 0
            fly.runtime.mem_alloc(8 * this.vstride, nv)
            pointer nf = 0
            fly.runtime.mem_alloc(8, nf)
            fly.llvm.memset(nf, 0, 8)
            this.keys = nk
            this.vals = nv
            this.flags = nf
            this.cap = 8
        }
        if this.count * 4 >= this.cap * 3 {
            pointer newcap = this.cap * 2
            pointer nkeys = 0
            fly.runtime.mem_alloc(newcap * this.kstride, nkeys)
            pointer nvals = 0
            fly.runtime.mem_alloc(newcap * this.vstride, nvals)
            pointer nflags = 0
            fly.runtime.mem_alloc(newcap, nflags)
            fly.llvm.memset(nflags, 0, newcap)
            K kprobe
            pointer ri = 0
            while ri < this.cap {
                byte rfl = 0
                fly.llvm.ptrByteAt(this.flags, ri, rfl)
                if rfl == 1 {
                    int rh = 0
                    fly.llvm.slotHashAtT(this.keys, ri * this.kstride, kprobe, rh)
                    if rh < 0 { rh = 0 - rh }
                    pointer rb = rh & (newcap - 1)
                    byte rnfl = 0
                    fly.llvm.ptrByteAt(nflags, rb, rnfl)
                    while rnfl != 0 {
                        rb = (rb + 1) & (newcap - 1)
                        fly.llvm.ptrByteAt(nflags, rb, rnfl)
                    }
                    pointer ksoff = ri * this.kstride
                    pointer kdoff = rb * this.kstride
                    pointer ksrc = this.keys + ksoff
                    pointer kdst = nkeys + kdoff
                    pointer knb = this.kstride
                    fly.llvm.memcpy(kdst, ksrc, knb)
                    pointer vsoff = ri * this.vstride
                    pointer vdoff = rb * this.vstride
                    pointer vsrc = this.vals + vsoff
                    pointer vdst = nvals + vdoff
                    pointer vnb = this.vstride
                    fly.llvm.memcpy(vdst, vsrc, vnb)
                    fly.llvm.ptrPokeByte(nflags, rb, 1)
                }
                ri = ri + 1
            }
            fly.runtime.mem_free(this.keys, this.cap * this.kstride)
            fly.runtime.mem_free(this.vals, this.cap * this.vstride)
            fly.runtime.mem_free(this.flags, this.cap)
            this.keys = nkeys
            this.vals = nvals
            this.flags = nflags
            this.cap = newcap
        }
        int ph = 0
        fly.llvm.slotHashT(key, ph)
        if ph < 0 { ph = 0 - ph }
        pointer b = ph & (this.cap - 1)
        bool hasTs = false
        pointer ts = 0
        pointer probed = 0
        bool done = false
        while probed < this.cap {
            byte fl = 0
            fly.llvm.ptrByteAt(this.flags, b, fl)
            if fl == 1 {
                int c = 0
                fly.llvm.slotCmpT(this.keys, b * this.kstride, key, c)
                if c == 0 {
                    V vprobe
                    fly.llvm.slotFreeT(this.vals, b * this.vstride, vprobe)
                    fly.llvm.slotPokeT(this.vals, b * this.vstride, val)
                    done = true
                    probed = this.cap
                }
            }
            if done == false {
                if fl == 2 {
                    if hasTs == false {
                        ts = b
                        hasTs = true
                    }
                }
                if fl == 0 {
                    if hasTs { b = ts }
                    fly.llvm.slotPokeT(this.keys, b * this.kstride, key)
                    fly.llvm.slotPokeT(this.vals, b * this.vstride, val)
                    fly.llvm.ptrPokeByte(this.flags, b, 1)
                    this.count = this.count + 1
                    done = true
                    probed = this.cap
                }
            }
            if done == false {
                b = (b + 1) & (this.cap - 1)
                probed = probed + 1
            }
        }
        if done == false {
            if hasTs {
                fly.llvm.slotPokeT(this.keys, ts * this.kstride, key)
                fly.llvm.slotPokeT(this.vals, ts * this.vstride, val)
                fly.llvm.ptrPokeByte(this.flags, ts, 1)
                this.count = this.count + 1
            }
        }
    }

    public V get(const K key) {
        if this.keys != 0 {
            int gh = 0
            fly.llvm.slotHashT(key, gh)
            if gh < 0 { gh = 0 - gh }
            pointer b = gh & (this.cap - 1)
            pointer probed = 0
            while probed < this.cap {
                byte fl = 0
                fly.llvm.ptrByteAt(this.flags, b, fl)
                if fl == 0 {
                    probed = this.cap
                } elsif fl == 1 {
                    int c = 0
                    fly.llvm.slotCmpT(this.keys, b * this.kstride, key, c)
                    if c == 0 {
                        fly.llvm.slotReadT(this.vals, b * this.vstride, out)
                        return
                    }
                    b = (b + 1) & (this.cap - 1)
                    probed = probed + 1
                } else {
                    b = (b + 1) & (this.cap - 1)
                    probed = probed + 1
                }
            }
        }
        V def
        out = def
    }

    public bool has(const K key) {
        if this.keys == 0 {
            out = false
            return
        }
        int hh = 0
        fly.llvm.slotHashT(key, hh)
        if hh < 0 { hh = 0 - hh }
        pointer b = hh & (this.cap - 1)
        pointer probed = 0
        bool found = false
        while probed < this.cap {
            byte fl = 0
            fly.llvm.ptrByteAt(this.flags, b, fl)
            if fl == 0 {
                probed = this.cap
            } elsif fl == 1 {
                int c = 0
                fly.llvm.slotCmpT(this.keys, b * this.kstride, key, c)
                if c == 0 {
                    found = true
                    probed = this.cap
                } else {
                    b = (b + 1) & (this.cap - 1)
                    probed = probed + 1
                }
            } else {
                b = (b + 1) & (this.cap - 1)
                probed = probed + 1
            }
        }
        out = found
    }

    public void remove(const K key) {
        if this.keys == 0 { return }
        int rh = 0
        fly.llvm.slotHashT(key, rh)
        if rh < 0 { rh = 0 - rh }
        pointer b = rh & (this.cap - 1)
        pointer probed = 0
        while probed < this.cap {
            byte fl = 0
            fly.llvm.ptrByteAt(this.flags, b, fl)
            if fl == 0 {
                probed = this.cap
            } elsif fl == 1 {
                int c = 0
                fly.llvm.slotCmpT(this.keys, b * this.kstride, key, c)
                if c == 0 {
                    K kprobe
                    V vprobe
                    fly.llvm.slotFreeT(this.keys, b * this.kstride, kprobe)
                    fly.llvm.slotFreeT(this.vals, b * this.vstride, vprobe)
                    fly.llvm.ptrPokeByte(this.flags, b, 2)
                    this.count = this.count - 1
                    probed = this.cap
                } else {
                    b = (b + 1) & (this.cap - 1)
                    probed = probed + 1
                }
            } else {
                b = (b + 1) & (this.cap - 1)
                probed = probed + 1
            }
        }
    }

    public pointer size() {
        out = this.count
    }

    public void free() {
        if this.keys != 0 {
            K kprobe
            V vprobe
            pointer i = 0
            while i < this.cap {
                byte fl = 0
                fly.llvm.ptrByteAt(this.flags, i, fl)
                if fl == 1 {
                    fly.llvm.slotFreeT(this.keys, i * this.kstride, kprobe)
                    fly.llvm.slotFreeT(this.vals, i * this.vstride, vprobe)
                }
                i = i + 1
            }
            fly.runtime.mem_free(this.keys, this.cap * this.kstride)
            fly.runtime.mem_free(this.vals, this.cap * this.vstride)
            fly.runtime.mem_free(this.flags, this.cap)
        }
    }
}
