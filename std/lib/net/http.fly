namespace fly.net.http

import fly.llvm
import fly.runtime
import fly.mem
import fly.str
import fly.codec
import fly.net
import fly.net.tls
import fly.os.fs
import fly.os.env

// ─────────────────────────────────────────────────────────────────────────────
// fly.net.http — HTTP/1.1 over fly.net: parse a request, build a response, and a
// small blocking client.
//
// HTTPS IS SERVED, by whichever backend the build has — see the HTTPS section
// below for the dispatch. When none is available an https:// URL fails rather
// than silently downgrading to plaintext; nothing falls back to an external tool.
//
// There are no Request/Response objects: every accessor takes the RAW message
// and re-scans it. That keeps the whole parse/serialize surface pure string-in /
// string-out — testable without a socket, and free of the two boundary hazards
// that a class or a Map<string,string> would bring across the .fly.h boundary.
// A registry request is under a kilobyte and is read once, so the per-accessor
// rescan costs nothing that matters.
//
// CRLF TRAP: Fly string literals keep escapes RAW, so "\r\n" is the FOUR
// characters \, r, \, n — not a line terminator. Every terminator in this file
// therefore comes from the byte-built crlf()/crlf2() helpers below. Bypassing
// them produces a message that looks right in the source and is malformed on the
// wire, which only shows up against a real HTTP client.
// ─────────────────────────────────────────────────────────────────────────────

// ── byte-built constants ─────────────────────────────────────────────────────

// crlf — the two bytes 13, 10.
private string crlf() {
    pointer b = mem.alloc(2)
    mem.writeByte(b, 0, 13)
    mem.writeByte(b, 1, 10)
    str.fromBytes(b, 2, out)
}

// dq — a one-byte string holding a double quote (34). Needed by the multipart
// builder, whose Content-Disposition values are quoted; a literal cannot produce
// a bare `"` because escapes stay raw.
private string dq() {
    pointer b = mem.alloc(1)
    mem.writeByte(b, 0, 34)
    str.fromBytes(b, 1, out)
}

// crlf2 — the header-block terminator, 13 10 13 10.
private string crlf2() {
    pointer b = mem.alloc(4)
    mem.writeByte(b, 0, 13)
    mem.writeByte(b, 1, 10)
    mem.writeByte(b, 2, 13)
    mem.writeByte(b, 3, 10)
    str.fromBytes(b, 4, out)
}

// ── scanning helpers ─────────────────────────────────────────────────────────

// findFrom — index of `sub` in `s` at or after `from`; -1 when absent. Written
// byte-wise rather than with str.indexOf so a search can start mid-string
// without slicing.
private int findFrom(const string s, const string sub, const int from) {
    int n = str.len(s)
    int m = str.len(sub)
    if m == 0 { out = 0 - 1  return }
    if m > n { out = 0 - 1  return }
    int i = from
    if i < 0 { i = 0 }
    int last = n - m
    while i <= last {
        int j = 0
        bool same = true
        while same && j < m {
            byte a = 0
            byte b = 0
            str.byteAt(s, i + j, a)
            str.byteAt(sub, j, b)
            if a != b { same = false } else { j = j + 1 }
        }
        if same { out = i  return }
        i = i + 1
    }
    out = 0 - 1
}

// findByte — index of byte `c` in `s` at or after `from`, bounded by `stop`;
// -1 when absent.
private int findByte(const string s, const int c, const int from, const int stop) {
    int n = str.len(s)
    int end = stop
    if end > n { end = n }
    int i = from
    if i < 0 { i = 0 }
    while i < end {
        byte b = 0
        str.byteAt(s, i, b)
        int v = b & 255
        if v == c { out = i  return }
        i = i + 1
    }
    out = 0 - 1
}

// lineEnd — index of the CRLF that ends the line starting at `from`; -1 when the
// line is not terminated.
private int lineEnd(const string raw, const int from) {
    out = findFrom(raw, crlf(), from)
}

// ── Request parsing ──────────────────────────────────────────────────────────

// headerEnd — index of the first byte AFTER the CRLFCRLF terminator, i.e. where
// the body starts. -1 while the header block has not fully arrived.
public int headerEnd(const string raw) {
    int i = findFrom(raw, crlf2(), 0)
    if i < 0 { out = 0 - 1  return }
    out = i + 4
}

// requestLine — the first line, or "" when it is not terminated.
private string requestLine(const string raw) {
    int e = lineEnd(raw, 0)
    if e < 0 { out = ""  return }
    out = str.substring(raw, 0, e)
}

// field — the i-th space-separated field (0,1,2) of the request/status line.
private string field(const string line, const int which) {
    int n = str.len(line)
    if n == 0 { out = ""  return }
    int start = 0
    int idx = 0
    while idx < which {
        int sp = findByte(line, 32, start, n)
        if sp < 0 { out = ""  return }
        start = sp + 1
        idx = idx + 1
    }
    // The loop above already returned "" if field `which` does not exist, so
    // reaching here with no further space means this field runs to end of line.
    int sp2 = findByte(line, 32, start, n)
    if sp2 < 0 { out = str.substring(line, start, n)  return }
    out = str.substring(line, start, sp2)
}

// method — "GET", "POST", …; "" when the request line is unparseable.
public string method(const string raw) {
    out = field(requestLine(raw), 0)
}

// target — the full request target including the query ("/v1/pkg?x=1"); "" on
// a malformed request line.
public string target(const string raw) {
    out = field(requestLine(raw), 1)
}

// version — "HTTP/1.1"; "" on a malformed request line.
public string version(const string raw) {
    out = field(requestLine(raw), 2)
}

// path — the target up to '?'. "" on a malformed request line.
public string path(const string raw) {
    string t = target(raw)
    int n = str.len(t)
    if n == 0 { out = ""  return }
    int q = findByte(t, 63, 0, n)
    if q < 0 { out = t  return }
    out = str.substring(t, 0, q)
}

// query — the target after '?'; "" when there is none.
public string query(const string raw) {
    string t = target(raw)
    int n = str.len(t)
    if n == 0 { out = ""  return }
    int q = findByte(t, 63, 0, n)
    if q < 0 { out = ""  return }
    out = str.substring(t, q + 1, n)
}

// header — case-insensitive header lookup, value trimmed of surrounding spaces.
// "" when absent, so an absent header and an empty one are indistinguishable.
// Works for a response too (the status line is skipped exactly like a request
// line), which is what respHeader delegates to.
public string header(const string raw, const string name) {
    int he = findFrom(raw, crlf2(), 0)
    int limit = str.len(raw)
    if he >= 0 { limit = he }
    int pos = lineEnd(raw, 0)
    if pos < 0 { out = ""  return }
    pos = pos + 2
    bool go = true
    while go && pos < limit {
        int e = lineEnd(raw, pos)
        if e < 0 { go = false } else {
            if e <= pos { go = false } else {
                int colon = findByte(raw, 58, pos, e)
                if colon > 0 {
                    string key = str.substring(raw, pos, colon)
                    if str.equalsIgnoreCase(str.trim(key), name) {
                        out = str.trim(str.substring(raw, colon + 1, e))
                        return
                    }
                }
                pos = e + 2
            }
        }
    }
    out = ""
}

// contentLength — the Content-Length value; -1 when absent or not a number.
public int contentLength(const string raw) {
    string v = header(raw, "Content-Length")
    int n = str.len(v)
    if n == 0 { out = 0 - 1  return }
    int acc = 0
    int i = 0
    while i < n {
        byte b = 0
        str.byteAt(v, i, b)
        int c = b & 255
        bool isDigit = c >= 48 && c <= 57
        if isDigit == false { out = 0 - 1  return }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    out = acc
}

// body — everything after the CRLFCRLF; "" while the header block is incomplete.
public string body(const string raw) {
    int he = headerEnd(raw)
    if he < 0 { out = ""  return }
    out = str.substring(raw, he, str.len(raw))
}

// ── Chunked transfer-encoding ─────────────────────────────────────────────────
//
// A chunked body is a sequence of
//     <hex length>[;extension]CRLF <that many bytes> CRLF
// terminated by a zero-length chunk, optionally followed by trailer headers and
// a final CRLF. It exists so a sender can start transmitting before it knows the
// total size, which is exactly what a registry streaming a tarball does — so a
// client that ignores it reads chunk-size lines as if they were payload.

// hexIntOf — the value of a hex run at the start of s, stopping at the first
// non-hex character (which is how the ";extension" suffix is skipped). -1 when
// there is no leading hex digit at all.
private int hexIntOf(const string s) {
    int n = str.len(s)
    int acc = 0
    int seen = 0
    int i = 0
    bool go = true
    while go && i < n {
        byte b = 0
        str.byteAt(s, i, b)
        int cv = b
        int c = cv & 255
        int v = 0 - 1
        if c >= 48 && c <= 57 { v = c - 48 }
        elsif c >= 97 && c <= 102 { v = c - 87 }
        elsif c >= 65 && c <= 70 { v = c - 55 }
        if v < 0 { go = false } else {
            acc = (acc << 4) | v
            seen = seen + 1
            i = i + 1
        }
    }
    if seen == 0 { out = 0 - 1  return }
    out = acc
}

// isChunked — true when the message declares `Transfer-Encoding: chunked`. The
// header may list several codings, so this is a substring test, not equality.
public bool isChunked(const string raw) {
    string te = header(raw, "Transfer-Encoding")
    if str.isEmpty(te) { out = false  return }
    out = str.contains(str.toLower(te), "chunked")
}

// chunkedSize — the DECODED length of a chunked body, or -1 when the body is
// malformed or has not yet reached its terminating zero chunk. Used both to size
// the output buffer for dechunk and to answer "has it all arrived" for
// isComplete, so the two can never disagree.
private int chunkedSize(const string body) {
    int n = str.len(body)
    int total = 0
    int i = 0
    while i < n {
        int e = lineEnd(body, i)
        if e < 0 { out = 0 - 1  return }             // size line not terminated yet
        int sz = hexIntOf(str.substring(body, i, e))
        if sz < 0 { out = 0 - 1  return }            // not a chunk header
        if sz == 0 { out = total  return }           // terminating chunk
        int dataStart = e + 2
        if dataStart + sz + 2 > n { out = 0 - 1  return }   // chunk still arriving
        total = total + sz
        i = dataStart + sz + 2
    }
    out = 0 - 1
}

// dechunk — a chunked body decoded into its payload. "" when the body is
// malformed or incomplete, so pair it with isComplete().
//
// The size is computed first and the buffer allocated ONCE: growing it per chunk
// would reallocate for every chunk of a large transfer.
public string dechunk(const string body) {
    int want = chunkedSize(body)
    if want < 0 { out = ""  return }
    if want == 0 { out = ""  return }
    pointer buf = 0
    fly.runtime.mem_alloc(want, buf)
    int n = str.len(body)
    int o = 0
    int i = 0
    bool go = true
    while go && i < n {
        int e = lineEnd(body, i)
        if e < 0 { go = false } else {
            int sz = hexIntOf(str.substring(body, i, e))
            if sz <= 0 { go = false } else {
                int dataStart = e + 2
                int k = 0
                while k < sz {
                    byte b = 0
                    str.byteAt(body, dataStart + k, b)
                    fly.llvm.strPoke(buf, o + k, b)
                    k = k + 1
                }
                o = o + sz
                i = dataStart + sz + 2
            }
        }
    }
    fly.llvm.strMake(buf, o, out)
}

// bodyDecoded — the message body with the transfer coding removed: dechunked
// when chunked, the raw body otherwise. This is what a caller almost always
// wants instead of body().
public string bodyDecoded(const string raw) {
    string b = body(raw)
    if isChunked(raw) { out = dechunk(b)  return }
    out = b
}

// isComplete — true once the whole message has arrived. This is the receive
// loop's stop condition, and it understands all three framings:
//   • chunked        → the terminating zero chunk has been seen;
//   • Content-Length → that many body bytes are present;
//   • neither        → the headers ARE the message (a bodyless request), so it
//                      is complete as soon as the header block terminates.
//
// The chunked branch is not optional: without it a chunked response that is
// still arriving looks complete the moment its headers land, because it carries
// no Content-Length.
public bool isComplete(const string raw) {
    int he = headerEnd(raw)
    if he < 0 { out = false  return }
    if isChunked(raw) {
        out = chunkedSize(str.substring(raw, he, str.len(raw))) >= 0
        return
    }
    int cl = contentLength(raw)
    if cl < 0 { out = true  return }
    out = str.len(raw) - he >= cl
}

// queryParam — the value of `key` in the query string; "" when absent. Values
// are returned as-is: there is no percent-decoding.
public string queryParam(const string raw, const string key) {
    string q = query(raw)
    int n = str.len(q)
    if n == 0 { out = ""  return }
    int pos = 0
    bool go = true
    while go && pos < n {
        int amp = findByte(q, 38, pos, n)
        int stop = n
        if amp >= 0 { stop = amp }
        int eq = findByte(q, 61, pos, stop)
        if eq > 0 {
            string k = str.substring(q, pos, eq)
            if str.equals(k, key) {
                out = str.substring(q, eq + 1, stop)
                return
            }
        }
        if amp < 0 { go = false } else { pos = amp + 1 }
    }
    out = ""
}

// ── Response building ────────────────────────────────────────────────────────

// statusText — the reason phrase for a status code; "Unknown" for anything not
// listed. The set is the one the registry protocol actually uses.
public string statusText(const int status) {
    if status == 200 { out = "OK"  return }
    if status == 201 { out = "Created"  return }
    if status == 204 { out = "No Content"  return }
    if status == 301 { out = "Moved Permanently"  return }
    if status == 302 { out = "Found"  return }
    if status == 304 { out = "Not Modified"  return }
    if status == 400 { out = "Bad Request"  return }
    if status == 401 { out = "Unauthorized"  return }
    if status == 403 { out = "Forbidden"  return }
    if status == 404 { out = "Not Found"  return }
    if status == 405 { out = "Method Not Allowed"  return }
    if status == 409 { out = "Conflict"  return }
    if status == 413 { out = "Payload Too Large"  return }
    if status == 500 { out = "Internal Server Error"  return }
    if status == 501 { out = "Not Implemented"  return }
    if status == 503 { out = "Service Unavailable"  return }
    out = "Unknown"
}

// appendSegs — append each LINE-FEED-separated item of `extra` as its own header
// line.
//
// The separator is a bare LF, and it MUST NOT be a semicolon: a header value may
// legitimately contain one — `Content-Type: multipart/form-data; boundary=…` is
// the obvious case, and splitting there silently produced a truncated
// Content-Type plus a bogus "boundary=…" header. An LF cannot occur inside a
// header value at all (that would be header injection), so it is the one
// separator that is always safe.
//
// A Fly literal cannot contain an LF either, so a caller joins several headers
// with joinHeaders(); a SINGLE header needs nothing special, which is the common
// case.
private string appendSegs(const string acc, const string extra) {
    string s = acc
    int n = str.len(extra)
    if n == 0 { out = s  return }
    string nl = crlf()
    int pos = 0
    bool go = true
    while go && pos <= n {
        int semi = findByte(extra, 10, pos, n)
        int stop = n
        if semi >= 0 { stop = semi }
        string seg = str.trim(str.substring(extra, pos, stop))
        if str.isEmpty(seg) == false {
            s = str.concat(s, seg)
            s = str.concat(s, nl)
        }
        if semi < 0 { go = false } else { pos = semi + 1 }
    }
    out = s
}

// joinHeaders — combine two header lines into one `extraHeaders` argument. A Fly
// literal cannot hold the LF that separates them, so this is how a caller sends
// more than one extra header. Chain it for three or more.
public string joinHeaders(const string a, const string b) {
    if str.isEmpty(a) { out = b  return }
    if str.isEmpty(b) { out = a  return }
    pointer p = mem.alloc(1)
    mem.writeByte(p, 0, 10)
    string lf = ""
    str.fromBytes(p, 1, lf)
    out = str.concat(a, str.concat(lf, b))
}

// responseWith — a complete HTTP/1.1 response with `Connection: close`: status
// line, Content-Type, Content-Length (computed from the body), any extra headers,
// the blank line, then the body. `extraHeaders` is an LF-separated list of
// "Name: Value" items (see joinHeaders); "" for none.
public string responseWith(const int status, const string contentType, const string extraHeaders, const string bodyStr) {
    out = responseConn(status, contentType, extraHeaders, false, bodyStr)
}

// responseConn — responseWith with the connection disposition chosen. A server
// that wants to serve several requests over one socket answers with
// keepAlive = true; otherwise the client must reconnect for each one.
public string responseConn(const int status, const string contentType, const string extraHeaders, const bool keepAlive, const string bodyStr) {
    string ct = contentType
    if str.isEmpty(ct) { ct = "application/octet-stream" }
    string nl = crlf()
    string s = "HTTP/1.1 "
    s = str.concat(s, str.convert(status))
    s = str.concat(s, " ")
    s = str.concat(s, statusText(status))
    s = str.concat(s, nl)
    s = str.concat(s, "Content-Type: ")
    s = str.concat(s, ct)
    s = str.concat(s, nl)
    s = str.concat(s, "Content-Length: ")
    s = str.concat(s, str.convert(str.len(bodyStr)))
    s = str.concat(s, nl)
    s = appendSegs(s, extraHeaders)
    if keepAlive {
        s = str.concat(s, "Connection: keep-alive")
    } else {
        s = str.concat(s, "Connection: close")
    }
    s = str.concat(s, nl)
    s = str.concat(s, nl)
    s = str.concat(s, bodyStr)
    out = s
}

// response — responseWith without extra headers.
public string response(const int status, const string contentType, const string bodyStr) {
    out = responseWith(status, contentType, "", bodyStr)
}

// buildRequest — a complete request with `Connection: close`, i.e. one exchange
// per connection. `extraHeaders` uses the same ';' convention as responseWith;
// Content-Length is added automatically when the body is non-empty.
public string buildRequest(const string method, const string targetPath, const string host, const string extraHeaders, const string bodyStr) {
    out = buildRequestConn(method, targetPath, host, extraHeaders, bodyStr, false)
}

// buildRequestConn — buildRequest with the connection disposition chosen:
// keepAlive sends `Connection: keep-alive` so the socket may carry further
// exchanges (see connOpen/connExchange), rather than being closed by the server
// after the response.
public string buildRequestConn(const string method, const string targetPath, const string host, const string extraHeaders, const string bodyStr, const bool keepAlive) {
    string nl = crlf()
    string s = method
    s = str.concat(s, " ")
    s = str.concat(s, targetPath)
    s = str.concat(s, " HTTP/1.1")
    s = str.concat(s, nl)
    s = str.concat(s, "Host: ")
    s = str.concat(s, host)
    s = str.concat(s, nl)
    int bn = str.len(bodyStr)
    if bn > 0 {
        s = str.concat(s, "Content-Length: ")
        s = str.concat(s, str.convert(bn))
        s = str.concat(s, nl)
    }
    s = appendSegs(s, extraHeaders)
    if keepAlive {
        s = str.concat(s, "Connection: keep-alive")
    } else {
        s = str.concat(s, "Connection: close")
    }
    s = str.concat(s, nl)
    s = str.concat(s, nl)
    s = str.concat(s, bodyStr)
    out = s
}

// basicAuth — the value for an `Authorization` header: "Basic " followed by the
// base64 of "user:password" (RFC 7617). Pass it through extraHeaders as
// "Authorization: <this>", joining with joinHeaders() if there are others.
//
// This is transport-level obfuscation, NOT encryption: over plaintext http the
// credentials are trivially recoverable. Use it only over TLS.
public string basicAuth(const string user, const string password) {
    string pair = str.concat(user, str.concat(":", password))
    out = str.concat("Basic ", codec.base64Encode(pair))
}

// ── Response parsing ─────────────────────────────────────────────────────────

// respStatus — the status code of a raw response; -1 when unparseable.
public int respStatus(const string raw) {
    string code = field(requestLine(raw), 1)
    int n = str.len(code)
    if n == 0 { out = 0 - 1  return }
    int acc = 0
    int i = 0
    while i < n {
        byte b = 0
        str.byteAt(code, i, b)
        int c = b & 255
        bool isDigit = c >= 48 && c <= 57
        if isDigit == false { out = 0 - 1  return }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    out = acc
}

// respHeader — case-insensitive header lookup in a response; "" when absent.
public string respHeader(const string raw, const string name) {
    out = header(raw, name)
}

// respBody — the response body; "" while the header block is incomplete.
public string respBody(const string raw) {
    out = body(raw)
}

// ── URL splitting ────────────────────────────────────────────────────────────

// authorityOf — the host[:port] component, and where the path starts.
private string authorityOf(const string url) {
    int n = str.len(url)
    if n == 0 { out = ""  return }
    int start = 0
    int sep = findFrom(url, "://", 0)
    if sep >= 0 { start = sep + 3 }
    int slash = findByte(url, 47, start, n)
    if slash < 0 { out = str.substring(url, start, n)  return }
    out = str.substring(url, start, slash)
}

// urlScheme — "http" / "https"; "" when the URL carries no scheme.
public string urlScheme(const string url) {
    int sep = findFrom(url, "://", 0)
    if sep < 0 { out = ""  return }
    out = str.toLower(str.substring(url, 0, sep))
}

// urlHost — the host, port stripped; "" on a malformed URL.
public string urlHost(const string url) {
    string a = authorityOf(url)
    int n = str.len(a)
    if n == 0 { out = ""  return }
    int colon = findByte(a, 58, 0, n)
    if colon < 0 { out = a  return }
    out = str.substring(a, 0, colon)
}

// urlPort — the explicit port, else 80 for http and 443 for https (and 80 when
// there is no scheme). -1 when the port is present but not a number.
public int urlPort(const string url) {
    string a = authorityOf(url)
    int n = str.len(a)
    int colon = 0 - 1
    if n > 0 { colon = findByte(a, 58, 0, n) }
    if colon < 0 {
        if str.equals(urlScheme(url), "https") { out = 443 } else { out = 80 }
        return
    }
    int acc = 0
    int i = colon + 1
    if i >= n { out = 0 - 1  return }
    while i < n {
        byte b = 0
        str.byteAt(a, i, b)
        int c = b & 255
        bool isDigit = c >= 48 && c <= 57
        if isDigit == false { out = 0 - 1  return }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    out = acc
}

// urlPath — the path plus query; "/" when the URL has none.
public string urlPath(const string url) {
    int n = str.len(url)
    if n == 0 { out = "/"  return }
    int start = 0
    int sep = findFrom(url, "://", 0)
    if sep >= 0 { start = sep + 3 }
    int slash = findByte(url, 47, start, n)
    if slash < 0 { out = "/"  return }
    out = str.substring(url, slash, n)
}

// ── Redirects ─────────────────────────────────────────────────────────────────

// isRedirect — a 3xx status that carries a Location worth following. 304 Not
// Modified is deliberately EXCLUDED: it is a cache answer, not a redirect, and
// following it would turn a conditional request into a loop.
public bool isRedirect(const int status) {
    if status == 301 || status == 302 { out = true  return }
    if status == 303 || status == 307 || status == 308 { out = true  return }
    out = false
}

// dirOf — everything up to and including the last '/' of a path, "/" when there
// is none. The base for resolving a relative Location.
private string dirOf(const string path) {
    int n = str.len(path)
    if n == 0 { out = "/"  return }
    int last = 0 - 1
    int i = 0
    while i < n {
        if findByte(path, 47, i, i + 1) == i { last = i }
        i = i + 1
    }
    if last < 0 { out = "/"  return }
    out = str.substring(path, 0, last + 1)
}

// resolveUrl — an absolute URL from a Location value and the URL it came from.
// Handles the three forms a server may send:
//   absolute ("http://other/x")  → used as-is
//   root-relative ("/x")         → scheme://host[:port] + it
//   path-relative ("x" or "../x") → resolved against the base path's directory
//                                   ("../" is NOT collapsed; servers rarely send it)
// "" when `location` is empty or the base URL has no host.
public string resolveUrl(const string baseUrl, const string location) {
    if str.isEmpty(location) { out = ""  return }
    if findFrom(location, "://", 0) >= 0 { out = location  return }
    string host = urlHost(baseUrl)
    if str.isEmpty(host) { out = ""  return }
    string scheme = urlScheme(baseUrl)
    if str.isEmpty(scheme) { scheme = "http" }
    int port = urlPort(baseUrl)
    string origin = str.concat(scheme, str.concat("://", host))
    bool defaultPort = false
    if str.equals(scheme, "https") && port == 443 { defaultPort = true }
    if str.equals(scheme, "http") && port == 80 { defaultPort = true }
    if port > 0 && defaultPort == false {
        origin = str.concat(origin, str.concat(":", str.convert(port)))
    }
    if findByte(location, 47, 0, 1) == 0 {
        out = str.concat(origin, location)
        return
    }
    out = str.concat(origin, str.concat(dirOf(urlPath(baseUrl)), location))
}

// redirectTarget — the absolute URL a 3xx response points at, or "" when the
// response is not a redirect or carries no usable Location.
public string redirectTarget(const string resp, const string baseUrl) {
    if isRedirect(respStatus(resp)) == false { out = ""  return }
    out = resolveUrl(baseUrl, respHeader(resp, "Location"))
}

// ── Multipart/form-data bodies ────────────────────────────────────────────────
//
// A builder behind an opaque `pointer` handle, the std convention for stateful
// things that must cross the archive boundary (see fly.os.proc's ArgList).
//
//   MpBuilder header (32 bytes):
//     [0..7]   pointer data      the body being accumulated
//     [8..11]  int len
//     [12..15] int cap
//     [16..23] pointer bnd       the boundary's bytes
//     [24..27] int bndLen
//     [28..31] (padding)
//
// The body grows by doubling and is handed to strMake once, at mpFinish.

private void mpRoom(const pointer h, const int need) {
    int len = mem.readInt(h, 8)
    int cap = mem.readInt(h, 12)
    if len + need <= cap { return }
    int want = cap * 2
    while want < len + need { want = want * 2 }
    pointer data = mem.readPtr(h, 0)
    pointer bigger = 0
    fly.runtime.mem_realloc(data, want, bigger)
    mem.writePtr(h, 0, bigger)
    mem.writeInt(h, 12, want)
}

private void mpPut(const pointer h, const string s) {
    int n = str.len(s)
    if n <= 0 { return }
    mpRoom(h, n)
    pointer data = mem.readPtr(h, 0)
    int len = mem.readInt(h, 8)
    int i = 0
    while i < n {
        byte b = 0
        str.byteAt(s, i, b)
        fly.llvm.strPoke(data, len + i, b)
        i = i + 1
    }
    mem.writeInt(h, 8, len + n)
}

private string mpBoundary(const pointer h) {
    pointer bnd = mem.readPtr(h, 16)
    int bl = mem.readInt(h, 24)
    if bnd == 0 || bl <= 0 { out = ""  return }
    pointer copy = 0
    fly.runtime.mem_alloc(bl, copy)
    mem.copy(copy, bnd, bl)
    fly.llvm.strMake(copy, bl, out)
}

// mpNew — a multipart builder. `boundary` must not occur in any part's content;
// a caller with arbitrary data should derive one, e.g. from a hash of it. "" asks
// for the default, which is fine for content known not to contain it.
public pointer mpNew(const string boundary) {
    string b = boundary
    if str.isEmpty(b) { b = "FlyBoundary7MA4YWxkTrZu0gW" }
    pointer h = 0
    fly.runtime.mem_alloc(32, h)
    mem.zero(h, 32)
    int cap = 256
    pointer data = 0
    fly.runtime.mem_alloc(cap, data)
    mem.writePtr(h, 0, data)
    mem.writeInt(h, 8, 0)
    mem.writeInt(h, 12, cap)
    int bl = str.len(b)
    pointer bnd = 0
    fly.runtime.mem_alloc(bl, bnd)
    int i = 0
    while i < bl {
        byte c = 0
        str.byteAt(b, i, c)
        fly.llvm.strPoke(bnd, i, c)
        i = i + 1
    }
    mem.writePtr(h, 16, bnd)
    mem.writeInt(h, 24, bl)
    out = h
}

// mpContentType — the value for the request's Content-Type header. It carries the
// boundary, so it MUST come from the same builder that produced the body.
public string mpContentType(const pointer h) {
    if h == 0 { out = ""  return }
    out = str.concat("multipart/form-data; boundary=", mpBoundary(h))
}

// mpAddField — a plain form field. The name is emitted verbatim: a name
// containing a quote or a CRLF would corrupt the message, and callers control
// their own field names.
public void mpAddField(const pointer h, const string name, const string value) {
    if h == 0 { return }
    string q = dq()
    mpPut(h, "--")
    mpPut(h, mpBoundary(h))
    mpPut(h, crlf())
    mpPut(h, "Content-Disposition: form-data; name=")
    mpPut(h, q)
    mpPut(h, name)
    mpPut(h, q)
    mpPut(h, crlf2())
    mpPut(h, value)
    mpPut(h, crlf())
}

// mpAddFile — a file part. `contentType` defaults to application/octet-stream
// when empty. `content` is sent as-is, so it may hold arbitrary bytes.
public void mpAddFile(const pointer h, const string name, const string filename, const string contentType, const string content) {
    if h == 0 { return }
    string ct = contentType
    if str.isEmpty(ct) { ct = "application/octet-stream" }
    string q = dq()
    mpPut(h, "--")
    mpPut(h, mpBoundary(h))
    mpPut(h, crlf())
    mpPut(h, "Content-Disposition: form-data; name=")
    mpPut(h, q)
    mpPut(h, name)
    mpPut(h, q)
    mpPut(h, "; filename=")
    mpPut(h, q)
    mpPut(h, filename)
    mpPut(h, q)
    mpPut(h, crlf())
    mpPut(h, "Content-Type: ")
    mpPut(h, ct)
    mpPut(h, crlf2())
    mpPut(h, content)
    mpPut(h, crlf())
}

// mpFinish — append the closing delimiter and return the body. The builder is
// still valid afterwards but must NOT be added to again: a second finish would
// append a second terminator.
public string mpFinish(const pointer h) {
    if h == 0 { out = ""  return }
    mpPut(h, "--")
    mpPut(h, mpBoundary(h))
    mpPut(h, "--")
    mpPut(h, crlf())
    pointer data = mem.readPtr(h, 0)
    int len = mem.readInt(h, 8)
    if len <= 0 { out = ""  return }
    pointer copy = 0
    fly.runtime.mem_alloc(len, copy)
    mem.copy(copy, data, len)
    fly.llvm.strMake(copy, len, out)
}

// mpFree — release the builder. Safe on a null handle.
public void mpFree(const pointer h) {
    if h == 0 { return }
    pointer data = mem.readPtr(h, 0)
    if data != 0 { fly.runtime.mem_free(data, 0) }
    pointer bnd = mem.readPtr(h, 16)
    if bnd != 0 { fly.runtime.mem_free(bnd, 0) }
    fly.runtime.mem_free(h, 32)
}

// ── Client (these touch the network) ─────────────────────────────────────────

// exchange — connect to host:port, send `rawRequest`, read the whole response.
// "" on any failure (resolve, connect, send, or an empty reply). The sending
// side is half-closed after the request so the server sees EOF and answers even
// when it reads to end-of-stream.
public string exchange(const string host, const int port, const string rawRequest) {
    long s = net.connectTo(host, port)
    if s < 0 { out = ""  return }
    if net.sendStr(s, rawRequest) == false {
        net.close(s)
        out = ""
        return
    }
    net.shutdownWrite(s)
    string resp = net.recvAll(s)
    net.close(s)
    out = resp
}

// ── Keep-alive: several exchanges on one connection ──────────────────────────
//
// exchange() above half-closes and reads to EOF, which is simple and correct for
// one request. Reusing a connection makes the framing MANDATORY instead of
// optional: the server does not close, so "read until EOF" would block forever.
// connExchange therefore reads until isComplete() says the message has ended —
// which is why the chunked branch of isComplete had to exist first.

// connOpen — a connection intended for several exchanges. Returns the socket, or
// < 0 on failure. `timeoutMs` bounds every subsequent read, so a server that
// stops responding fails the exchange instead of hanging it; <= 0 leaves the
// socket blocking indefinitely.
public long connOpen(const string host, const int port, const int timeoutMs) {
    long s = net.connectTo(host, port)
    if s < 0 { out = 0 - 1  return }
    if timeoutMs > 0 { net.setRecvTimeout(s, timeoutMs) }
    // Small request/response exchanges gain nothing from coalescing and lose a
    // round trip's worth of latency to it.
    net.setNoDelay(s, true)
    out = s
}

// connExchange — send one request on an open connection and read exactly one
// response back, stopping at the end of the message rather than at EOF. "" on a
// send failure, a receive timeout, or a peer that closed mid-message.
//
// Build the request with buildRequestConn(..., true) so the server is told to
// keep the connection open; a server that answers `Connection: close` anyway is
// within its rights, and connIsClosing() reports that.
public string connExchange(const long s, const string rawRequest) {
    if s < 0 { out = ""  return }
    if net.sendStr(s, rawRequest) == false { out = ""  return }
    string acc = ""
    bool go = true
    while go {
        if isComplete(acc) { go = false } else {
            string chunk = net.recvStr(s, 8192)
            if str.isEmpty(chunk) {
                // EOF or timeout. Whatever arrived is only usable if it happens
                // to be a whole message.
                go = false
            } else {
                string grown = str.concat(acc, chunk)
                acc = grown
            }
        }
    }
    if isComplete(acc) == false { out = ""  return }
    out = acc
}

// connIsClosing — true when the response says the server will not accept another
// exchange on this connection, so the caller must reconnect. HTTP/1.1 defaults to
// keep-alive, so only an explicit `Connection: close` counts.
public bool connIsClosing(const string resp) {
    string c = header(resp, "Connection")
    if str.isEmpty(c) { out = false  return }
    out = str.contains(str.toLower(c), "close")
}

// connClose — release a connection opened with connOpen.
public void connClose(const long s) {
    net.close(s)
}

// ── HTTPS ─────────────────────────────────────────────────────────────────────
//
// TWO very different backends sit behind these, and the dispatch order matters:
//
//   1. fly.net.tls (OpenSSL) when tlsAvailable() — a real TRANSPORT, so the
//      request is built and framed by this module exactly as for plaintext;
//   2. the runtime's WinHTTP path when httpsAvailable() — a whole HTTP CLIENT,
//      not a transport. It performs the exchange itself and hands back a status
//      code plus the body in a file. That is why it cannot back tlsSend/tlsRecv,
//      and why it is reached through these functions rather than fly.net.tls.
//   3. neither → failure. Nothing silently downgrades to plaintext.
//
// So on Linux built with --tls, path 1; on Windows, path 2; otherwise https fails
// honestly. httpsSupported() reports whether either exists.

// httpsAvailable — the runtime has a whole-client HTTPS backend (WinHTTP).
public bool httpsAvailable() {
    int v = 0
    fly.runtime.net_https_available(v)
    out = v != 0
}

// httpsSupported — true when an https URL can be served AT ALL, by either route.
public bool httpsSupported() {
    if tls.tlsAvailable() { out = true  return }
    out = httpsAvailable()
}

// tmpOutPath — a scratch file for the WinHTTP body handoff, in the platform temp
// dir (Windows has no /tmp).
private string tmpOutPath() {
    string d = env.get("TEMP")
    if str.isEmpty(d) { d = env.get("TMPDIR") }
    if str.isEmpty(d) { d = "." }
    out = str.concat(fs.tempDir(d, "flyhttps"), "/body")
}

// cstr — a Fly string as a fresh null-terminated C buffer, or 0 for "". Duplicated
// per the std convention rather than shared across modules.
private pointer cstr(const string s) {
    int n = str.len(s)
    if n == 0 { out = 0  return }
    pointer buf = 0
    fly.runtime.mem_alloc(n + 1, buf)
    int i = 0
    while i < n {
        byte b = 0
        str.byteAt(s, i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strPoke(buf, n, 0)
    out = buf
}

// httpsRequest — the C-string marshalling for the runtime's whole-client HTTPS
// primitive. Returns the HTTP status, or -1 when the exchange never happened.
private int httpsRequest(const string verb, const string host, const int port,
                        const string path, const string headers,
                        const string bodyIn, const string outPath) {
    pointer cVerb = cstr(verb)
    pointer cHost = cstr(host)
    pointer cPath = cstr(path)
    pointer cHdrs = cstr(headers)
    pointer cBody = cstr(bodyIn)
    pointer cOut = cstr(outPath)
    int blen = str.len(bodyIn)
    int st = 0
    fly.runtime.net_https_request(cVerb, cHost, port, cPath, cHdrs, cBody, blen, cOut, st)
    if cVerb != 0 { fly.runtime.mem_free(cVerb, 0) }
    if cHost != 0 { fly.runtime.mem_free(cHost, 0) }
    if cPath != 0 { fly.runtime.mem_free(cPath, 0) }
    if cHdrs != 0 { fly.runtime.mem_free(cHdrs, 0) }
    if cBody != 0 { fly.runtime.mem_free(cBody, 0) }
    if cOut != 0 { fly.runtime.mem_free(cOut, 0) }
    out = st
}

// secureViaTls — the transport route: one exchange over a real TLS connection,
// framed by isComplete() exactly as the plaintext path is.
private string secureViaTls(const string rawRequest, const string host, const int port, int statusOut) {
    statusOut = 0 - 1
    pointer c = tls.tlsConnectOpts(host, port, true, 30000)
    if c == 0 { out = ""  return }
    if tls.tlsSendStr(c, rawRequest) == false {
        tls.tlsClose(c)
        out = ""
        return
    }
    string acc = ""
    bool go = true
    while go {
        if isComplete(acc) { go = false } else {
            string chunk = tls.tlsRecvStr(c, 8192)
            if str.isEmpty(chunk) { go = false } else {
                string grown = str.concat(acc, chunk)
                acc = grown
            }
        }
    }
    tls.tlsClose(c)
    if isComplete(acc) == false { out = ""  return }
    statusOut = respStatus(acc)
    out = bodyDecoded(acc)
}

// secureViaClient — the WinHTTP route: the backend does the whole exchange and
// leaves the body in a file, so there is no raw response to parse.
private string secureViaClient(const string verb, const string url, const string extraHeaders, const string bodyIn, int statusOut) {
    statusOut = 0 - 1
    string host = urlHost(url)
    if str.isEmpty(host) { out = ""  return }
    int port = urlPort(url)
    if port < 0 { out = ""  return }
    string tmp = tmpOutPath()
    // WinHTTP wants the header block CRLF-separated; extraHeaders is LF-separated
    // (see appendSegs), so translate before handing it over.
    string hdrs = ""
    if str.isEmpty(extraHeaders) == false {
        pointer p = mem.alloc(1)
        mem.writeByte(p, 0, 10)
        string lf = ""
        str.fromBytes(p, 1, lf)
        hdrs = str.replace(extraHeaders, lf, crlf())
    }
    int st = httpsRequest(verb, host, port, urlPath(url), hdrs, bodyIn, tmp)
    statusOut = st
    if st < 0 {
        if fs.exists(tmp) { fs.delete(tmp) }
        out = ""
        return
    }
    string body = ""
    if fs.exists(tmp) {
        // readBytes, NOT readStr: this spool file holds a response body, which may
        // be a tarball. The backend wrote it byte-exact (WriteFile bypasses the
        // CRT), so a text-mode read here would be the single point that corrupts
        // every binary download on Windows.
        body = fs.readBytes(tmp)
        fs.delete(tmp)
    }
    out = body
}

// secureExchange — dispatch to whichever backend exists. `statusOut` is the HTTP
// status, or -1 when the exchange never happened.
private string secureExchange(const string verb, const string url, const string extraHeaders, const string bodyIn, int statusOut) {
    if tls.tlsAvailable() {
        string host = urlHost(url)
        int port = urlPort(url)
        if str.isEmpty(host) || port < 0 { statusOut = 0 - 1  out = ""  return }
        string req = buildRequest(verb, urlPath(url), host, extraHeaders, bodyIn)
        int st = 0
        string b = secureViaTls(req, host, port, st)
        statusOut = st
        out = b
        return
    }
    if httpsAvailable() {
        int st2 = 0
        string b2 = secureViaClient(verb, url, extraHeaders, bodyIn, st2)
        statusOut = st2
        out = b2
        return
    }
    statusOut = 0 - 1
    out = ""
}

// getSecure — GET an https URL and return the BODY. "" on any failure, on a
// non-2xx status, or when no HTTPS backend is available at all.
public string getSecure(const string url) {
    int st = 0
    string body = secureExchange("GET", url, "", "", st)
    if st < 0 { out = ""  return }
    if isOk(st) == false { out = ""  return }
    out = body
}

// getSecureStatus — GET an https URL and return only the status code; -1 when the
// exchange did not happen.
public int getSecureStatus(const string url) {
    int st = 0
    secureExchange("GET", url, "", "", st)
    out = st
}

// downloadSecure — GET an https URL and write the body to destPath. false on any
// failure or a non-2xx status.
public bool downloadSecure(const string url, const string destPath) {
    int st = 0
    string body = secureExchange("GET", url, "", "", st)
    if st < 0 { out = false  return }
    if isOk(st) == false { out = false  return }
    fs.writeBytes(destPath, body, 420)
    out = fs.exists(destPath)
}

// postFileSecure — POST a file's contents to an https URL as
// application/octet-stream, with an optional Bearer token. false on any failure
// or a non-2xx status.
public bool postFileSecure(const string url, const string filePath, const string token) {
    if fs.exists(filePath) == false { out = false  return }
    string payload = fs.readBytes(filePath)
    string extra = "Content-Type: application/octet-stream"
    if str.isEmpty(token) == false {
        extra = joinHeaders(extra, str.concat("Authorization: Bearer ", token))
    }
    int st = 0
    secureExchange("POST", url, extra, payload, st)
    if st < 0 { out = false  return }
    out = isOk(st)
}

// fetch — the shared plaintext GET path. An https URL is NOT handled here; the
// public entry points route it to getSecure/downloadSecure instead.
private string fetch(const string url) {
    if str.equals(urlScheme(url), "https") { out = ""  return }
    string host = urlHost(url)
    if str.isEmpty(host) { out = ""  return }
    int port = urlPort(url)
    if port < 0 { out = ""  return }
    string req = buildRequest("GET", urlPath(url), host, "", "")
    out = exchange(host, port, req)
}

// isOk — a 2xx status.
private bool isOk(const int status) {
    bool lo = status >= 200
    out = lo && status < 300
}

// get — GET a URL and return the response BODY, transfer coding removed. "" on
// any failure or a non-2xx status. A 3xx is NOT followed; use getFollow for that.
//
// An https URL is served by whichever backend exists (see getSecure) rather than
// refused, so a caller no longer has to branch on the scheme itself. When no
// HTTPS backend is available it still fails rather than downgrading.
public string get(const string url) {
    if str.equals(urlScheme(url), "https") { out = getSecure(url)  return }
    string resp = fetch(url)
    if str.isEmpty(resp) { out = ""  return }
    if isOk(respStatus(resp)) == false { out = ""  return }
    out = bodyDecoded(resp)
}

// getFollow — GET a URL, following up to `maxHops` redirects, and return the
// final response BODY. "" on any failure, on a non-2xx final status, or when the
// hop limit is reached — which is what stops a redirect LOOP, since nothing here
// remembers the URLs already visited.
//
// A redirect to an https:// target fails like any other https request: there is
// no TLS, and silently falling back to plaintext would be worse than failing.
public string getFollow(const string url, const int maxHops) {
    string current = url
    int hops = 0
    int limit = maxHops
    if limit < 0 { limit = 0 }
    while hops <= limit {
        string resp = fetch(current)
        if str.isEmpty(resp) { out = ""  return }
        int st = respStatus(resp)
        if isRedirect(st) == false {
            if isOk(st) == false { out = ""  return }
            out = bodyDecoded(resp)
            return
        }
        string next = redirectTarget(resp, current)
        if str.isEmpty(next) { out = ""  return }
        current = next
        hops = hops + 1
    }
    out = ""
}

// getStatus — GET a URL and return only the status code; -1 on failure.
public int getStatus(const string url) {
    if str.equals(urlScheme(url), "https") { out = getSecureStatus(url)  return }
    string resp = fetch(url)
    if str.isEmpty(resp) { out = 0 - 1  return }
    out = respStatus(resp)
}

// download — GET a URL and write the body to destPath. false on any failure,
// including a non-2xx status; destPath is left untouched on failure.
public bool download(const string url, const string destPath) {
    if str.equals(urlScheme(url), "https") { out = downloadSecure(url, destPath)  return }
    string resp = fetch(url)
    if str.isEmpty(resp) { out = false  return }
    if isOk(respStatus(resp)) == false { out = false  return }
    fs.writeBytes(destPath, respBody(resp), 420)
    out = fs.exists(destPath)
}

// postFile — POST the contents of filePath as application/octet-stream. A
// non-empty `token` adds an "Authorization: Bearer <token>" header. false on any
// failure or a non-2xx status.
public bool postFile(const string url, const string filePath, const string token) {
    if str.equals(urlScheme(url), "https") { out = postFileSecure(url, filePath, token)  return }
    if fs.exists(filePath) == false { out = false  return }
    string host = urlHost(url)
    if str.isEmpty(host) { out = false  return }
    int port = urlPort(url)
    if port < 0 { out = false  return }
    string payload = fs.readBytes(filePath)
    string extra = "Content-Type: application/octet-stream"
    if str.isEmpty(token) == false {
        extra = joinHeaders(extra, str.concat("Authorization: Bearer ", token))
    }
    string req = buildRequest("POST", urlPath(url), host, extra, payload)
    string resp = exchange(host, port, req)
    if str.isEmpty(resp) { out = false  return }
    out = isOk(respStatus(resp))
}
