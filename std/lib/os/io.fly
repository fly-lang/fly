namespace fly.os.io

import fly.llvm
import fly.runtime
import fly.os.env

// ── Types ─────────────────────────────────────────────────────────────────────

// Buf is a heap-allocated byte buffer used as the raw data carrier for IO
// operations.  ptr points to the first byte; size is the number of valid bytes;
// cap is the total allocated capacity.
public struct Buf {
    // Raw pointer to the allocated memory region.
    pointer ptr
    // Number of valid (written) bytes currently in the buffer.
    ulong size
    // Total allocated capacity in bytes.
    ulong cap
}

// Reader is the interface for sequential byte-stream sources.
// Implementations must be classes (e.g. FileReader, BufReader).
public interface Reader {
    // read fills buf with up to n bytes and returns the byte count.
    // Returns 0 at EOF.
    long read(Buf buf, const ulong n)
    // close releases any underlying resources (file descriptors, buffers).
    void close()
}

// Writer is the interface for sequential byte-stream sinks.
// Implementations must be classes (e.g. FileWriter, BufWriter).
public interface Writer {
    // write sends up to n bytes from buf and returns the byte count.
    long write(Buf buf, const ulong n)
    // flush ensures any buffered writes are committed to the underlying sink.
    void flush()
    // close flushes any remaining buffered data and releases resources.
    void close()
}

// FileReader wraps a raw OS file descriptor and implements Reader.
// Delegates read/close directly to fly.runtime syscall wrappers.
public class FileReader : Reader {
    // OS file descriptor for the open file.
    int fd

    // read calls the fs_read syscall and fills buf with up to n bytes.
    // Sets buf.size to the number of bytes actually read.
    public long read(Buf buf, const ulong n) {
        long nread = 0
        fly.runtime.fs_read(fd, buf.ptr, n, nread)
        if nread > 0 {
            out = nread
            buf.size = nread
        } else {
            out = 0
        }
    }

    // close closes the file descriptor.
    public void close() {
        fly.runtime.fs_close(fd)
    }
}

// FileWriter wraps a raw OS file descriptor and implements Writer.
// Delegates write/flush/close directly to fly.runtime syscall wrappers.
public class FileWriter : Writer {
    // OS file descriptor for the open file.
    int fd

    // write calls the fs_write syscall and sends up to n bytes from buf.
    public long write(Buf buf, const ulong n) {
        long nwritten = 0
        fly.runtime.fs_write(fd, buf.ptr, n, nwritten)
        if nwritten > 0 { out = nwritten } else { out = 0 }
    }

    // flush calls fsync to force all writes to the underlying storage.
    public void flush() {
        int ret = 0
        fly.runtime.fs_fsync(fd, ret)
    }

    // close closes the file descriptor.
    public void close() {
        fly.runtime.fs_close(fd)
    }
}

// BufReader wraps an inner Reader with a fixed-size read-ahead buffer, so a
// caller doing many small reads hits the OS once per bufferful.
//
// Constructed through readerNew() below rather than a constructor, matching
// fileReader()/fileWriter(): callers in other namespaces then need no qualified
// `new`.
//
// ABI CONSTRAINT — call the FREE FUNCTIONS (readerNew, fill, peek, bufRead,
// bufAvailable, bufReadLine, bufClose), NOT these methods, from outside
// fly.os.io. Invoking a NON-INTERFACE method of a header-declared class across
// the .fly.h boundary reads the wrong state: `io.readerNew(...)` then
// `br.available()` yields garbage, while the identical call made through
// `io.bufAvailable(br)` — which runs inside the archive — is correct. Handles and
// field reads survive the boundary intact, and so does INTERFACE dispatch (the
// Reader.read/close pair, the same path FileReader relies on); it is specifically
// the direct non-virtual method call that breaks. This is the "classes with
// interface bases across the header boundary" fragility that ci/*/build_std
// already warns about, and it is why the shipped std must stay the stage-1
// (reference-ABI) build. The wrappers below keep every such call inside the
// archive, so the API is usable today.
public class BufReader : Reader {
    // Raw pointer to the internal read-ahead buffer.
    pointer buf_ptr
    // Number of bytes currently buffered.
    pointer buf_fill
    // Total capacity of the internal buffer.
    pointer buf_cap
    // Current read position within the buffer.
    pointer pos
    // The wrapped stream every refill pulls from.
    Reader inner

    // refill — pull one bufferful from the inner Reader, replacing whatever is
    // left (only called once the cursor reached buf_fill). Returns the byte count
    // now buffered; 0 means EOF.
    public long refill() {
        if this.buf_ptr == 0 { out = 0  return }
        Buf tmp = new Buf()
        ulong capu = this.buf_cap
        tmp.ptr = this.buf_ptr
        tmp.size = 0
        tmp.cap = capu
        long got = 0
        got = this.inner.read(tmp, capu)
        if got <= 0 {
            this.buf_fill = 0
            this.pos = 0
            out = 0
            return
        }
        this.buf_fill = got
        this.pos = 0
        out = got
    }

    // available — buffered bytes not yet handed to the caller.
    public pointer available() {
        out = this.buf_fill - this.pos
    }

    // bufAt — address of the next unread byte. Lets peek() hand back a Buf that
    // BORROWS the internal storage instead of copying it.
    public pointer bufAt() {
        out = this.buf_ptr + this.pos
    }

    // takeByte — consume exactly one buffered byte. The caller must have checked
    // available() (or refilled) first; on an empty buffer it yields 0.
    public void takeByte(byte b) {
        if this.pos >= this.buf_fill { b = 0  return }
        fly.llvm.ptrByteAt(this.buf_ptr, this.pos, b)
        this.pos = this.pos + 1
    }

    // read — serve up to n bytes from the internal buffer, refilling once if it is
    // exhausted. A short read is normal: callers loop until 0 (EOF).
    public long read(Buf buf, const ulong n) {
        if this.buf_ptr == 0 { out = 0  return }
        if this.pos >= this.buf_fill {
            Buf tmp = new Buf()
            ulong capu = this.buf_cap
            tmp.ptr = this.buf_ptr
            tmp.size = 0
            tmp.cap = capu
            long got = 0
            got = this.inner.read(tmp, capu)
            if got <= 0 {
                buf.size = 0
                out = 0
                return
            }
            this.buf_fill = got
            this.pos = 0
        }
        pointer take = n
        pointer avail = this.buf_fill - this.pos
        if avail < take { take = avail }
        if take == 0 {
            buf.size = 0
            out = 0
            return
        }
        pointer src = this.buf_ptr + this.pos
        fly.llvm.memcpy(buf.ptr, src, take)
        this.pos = this.pos + take
        ulong taken = take
        buf.size = taken
        long r = (long)take
        out = r
    }

    // close — release the internal buffer, then close the inner Reader.
    public void close() {
        if this.buf_ptr != 0 {
            fly.runtime.mem_free(this.buf_ptr, this.buf_cap)
            this.buf_ptr = 0
            this.buf_fill = 0
            this.buf_cap = 0
            this.pos = 0
        }
        this.inner.close()
    }
}

// BufWriter wraps an inner Writer with a fixed-size write buffer. Built by
// writerNew() below; see the note on BufReader.
public class BufWriter : Writer {
    // Raw pointer to the internal write buffer.
    pointer buf_ptr
    // Number of bytes currently buffered.
    pointer buf_fill
    // Total capacity of the internal buffer.
    pointer buf_cap
    // The wrapped stream every flush drains into.
    Writer inner

    // write — append n bytes, draining to the inner Writer whenever the buffer
    // fills. A payload larger than the buffer is chunked rather than truncated, so
    // the caller never has to know the buffer size.
    public long write(Buf buf, const ulong n) {
        if this.buf_ptr == 0 { out = 0  return }
        pointer left = n
        pointer off = 0
        while left > 0 {
            pointer room = this.buf_cap - this.buf_fill
            if room == 0 {
                // Inlined drain: a this.flush() call from another method of the
                // same class is avoided here, as the containers do with helpers.
                Buf outb = new Buf()
                ulong fill = this.buf_fill
                outb.ptr = this.buf_ptr
                outb.size = fill
                outb.cap = fill
                this.inner.write(outb, fill)
                this.buf_fill = 0
                room = this.buf_cap
            }
            pointer take = left
            if room < take { take = room }
            pointer dst = this.buf_ptr + this.buf_fill
            pointer src = buf.ptr + off
            fly.llvm.memcpy(dst, src, take)
            this.buf_fill = this.buf_fill + take
            off = off + take
            left = left - take
        }
        long r = (long)n
        out = r
    }

    // flush — drain the buffer into the inner Writer, then flush that too.
    public void flush() {
        if this.buf_ptr == 0 { return }
        if this.buf_fill > 0 {
            Buf outb = new Buf()
            ulong fill = this.buf_fill
            outb.ptr = this.buf_ptr
            outb.size = fill
            outb.cap = fill
            this.inner.write(outb, fill)
            this.buf_fill = 0
        }
        this.inner.flush()
    }

    // close — flush whatever is pending, release the buffer, close the inner
    // Writer. Dropping buffered bytes on close would be the classic footgun.
    public void close() {
        if this.buf_ptr != 0 {
            if this.buf_fill > 0 {
                Buf outb = new Buf()
                ulong fill = this.buf_fill
                outb.ptr = this.buf_ptr
                outb.size = fill
                outb.cap = fill
                this.inner.write(outb, fill)
                this.buf_fill = 0
            }
            fly.runtime.mem_free(this.buf_ptr, this.buf_cap)
            this.buf_ptr = 0
            this.buf_cap = 0
        }
        this.inner.close()
    }
}

// ── Constructor helpers ───────────────────────────────────────────────────────

// fileReader wraps a raw OS file descriptor as a Reader.
// Called by fly.os.fs.reader() to avoid qualified 'new' from an external namespace.
public Reader fileReader(const int fd) {
    FileReader fr = new FileReader()
    fr.fd = fd
    out = fr
}

// fileWriter wraps a raw OS file descriptor as a Writer.
// Called by fly.os.fs.writer() to avoid qualified 'new' from an external namespace.
public Writer fileWriter(const int fd) {
    FileWriter fw = new FileWriter()
    fw.fd = fd
    out = fw
}

// ── IO primitive functions ────────────────────────────────────────────────────

// readAll reads from r until EOF and returns all data in a freshly allocated Buf.
// Grows the buffer exponentially to amortise allocations.
public Buf readAll(Reader r) {
    // byte counts are ulong end to end (Buf.size/cap and read()'s n are ulong)
    ulong cap = 4096
    pointer buf = 0
    fly.runtime.mem_alloc(cap, buf)
    ulong total = 0
    bool done = false
    while done == false {
        ulong avail = cap - total
        pointer tmp = 0
        fly.runtime.mem_alloc(avail, tmp)
        Buf chunk = new Buf()
        chunk.ptr = tmp
        chunk.size = 0
        chunk.cap = avail
        long nread = 0
        nread = r.read(chunk, avail)
        if nread == 0 {
            done = true
        } else {
            ulong got = nread
            ulong i = 0
            while i < got {
                byte b = 0
                fly.llvm.ptrByteAt(tmp, i, b)
                fly.llvm.strPoke(buf, total + i, b)
                i = i + 1
            }
            total = total + got
            if total >= cap {
                ulong newcap = cap * 2
                pointer newbuf = 0
                fly.runtime.mem_alloc(newcap, newbuf)
                ulong j = 0
                while j < total {
                    byte bb = 0
                    fly.llvm.ptrByteAt(buf, j, bb)
                    fly.llvm.strPoke(newbuf, j, bb)
                    j = j + 1
                }
                buf = newbuf
                cap = newcap
            }
        }
    }
    out.ptr = buf
    out.size = total
    out.cap = cap
}

// readLine reads bytes from r one at a time until '\n' or EOF and returns the
// line content (without the trailing newline) as a Fly string.
public string readLine(Reader r) {
    int cap = 256
    pointer buf = 0
    fly.runtime.mem_alloc(cap, buf)
    int pos = 0
    bool done = false
    while done == false {
        pointer tmp = 0
        fly.runtime.mem_alloc(1, tmp)
        Buf chunk = new Buf()
        chunk.ptr = tmp
        chunk.size = 0
        chunk.cap = 1
        long nread = 0
        nread = r.read(chunk, 1)
        if nread == 0 {
            done = true
        } else {
            byte b = 0
            fly.llvm.ptrByteAt(tmp, 0, b)
            if b == 10 {
                done = true
            } else {
                if pos >= cap {
                    int newcap = cap * 2
                    pointer newbuf = 0
                    fly.runtime.mem_alloc(newcap, newbuf)
                    int j = 0
                    while j < pos {
                        byte bb = 0
                        fly.llvm.ptrByteAt(buf, j, bb)
                        fly.llvm.strPoke(newbuf, j, bb)
                        j = j + 1
                    }
                    buf = newbuf
                    cap = newcap
                }
                fly.llvm.strPoke(buf, pos, b)
                pos = pos + 1
            }
        }
    }
    fly.llvm.strMake(buf, pos, out)
}

// readLines reads all lines from r until EOF and returns them as a StringArray.
// Each entry does not include the trailing newline.  An empty trailing line is
// not appended if the stream ends exactly on a '\n'.
public fly.os.env.StringArray readLines(Reader r) {
    int arr_cap = 16
    pointer arr = 0
    fly.runtime.mem_alloc(arr_cap * 16, arr)
    int count = 0
    bool at_eof = false
    while at_eof == false {
        int line_cap = 256
        pointer line_buf = 0
        fly.runtime.mem_alloc(line_cap, line_buf)
        int pos = 0
        bool line_done = false
        while line_done == false {
            pointer tmp = 0
            fly.runtime.mem_alloc(1, tmp)
            Buf chunk = new Buf()
            chunk.ptr = tmp
            chunk.size = 0
            chunk.cap = 1
            long nread = 0
            nread = r.read(chunk, 1)
            if nread == 0 {
                line_done = true
                at_eof = true
            } else {
                byte b = 0
                fly.llvm.ptrByteAt(tmp, 0, b)
                if b == 10 {
                    line_done = true
                } else {
                    if pos >= line_cap {
                        int newcap = line_cap * 2
                        pointer newbuf = 0
                        fly.runtime.mem_alloc(newcap, newbuf)
                        int j = 0
                        while j < pos {
                            byte bb = 0
                            fly.llvm.ptrByteAt(line_buf, j, bb)
                            fly.llvm.strPoke(newbuf, j, bb)
                            j = j + 1
                        }
                        line_buf = newbuf
                        line_cap = newcap
                    }
                    fly.llvm.strPoke(line_buf, pos, b)
                    pos = pos + 1
                }
            }
        }
        bool add_line = false
        if at_eof == false { add_line = true }
        if pos > 0 { add_line = true }
        if add_line {
            if count >= arr_cap {
                int newcap = arr_cap * 2
                pointer newarr = 0
                fly.runtime.mem_alloc(newcap * 16, newarr)
                int bytes = arr_cap * 16
                int j = 0
                while j < bytes {
                    byte bb = 0
                    fly.llvm.ptrByteAt(arr, j, bb)
                    fly.llvm.strPoke(newarr, j, bb)
                    j = j + 1
                }
                arr = newarr
                arr_cap = newcap
            }
            fly.runtime.str_slot_set(arr, count, line_buf, pos)
            count = count + 1
        }
    }
    out.items = arr
    out.count = count
}

// writeAll writes all bytes of buf to w in a single call.
// Returns true on success, false if the write returned an error.
public bool writeAll(Writer w, Buf buf) {
    long written = 0
    written = w.write(buf, buf.size)
    out = written >= 0
}

// writeString writes the bytes of Fly string s to Writer w.
// Returns true on success, false if the write returned an error.
public bool writeString(Writer w, const string s) {
    pointer ptr = 0
    int size = 0
    fly.llvm.strGetPtr(s, ptr)
    fly.llvm.strSize(s, size)
    ulong size_u = size
    Buf buf = new Buf()
    buf.ptr = ptr
    buf.size = size_u
    buf.cap = size_u
    long written = 0
    written = w.write(buf, size_u)
    out = written >= 0
}

// readerNew wraps inner in a BufReader with an internal buffer of cap bytes
// (cap 0 → a 4 KiB default).
public BufReader readerNew(Reader inner, const ulong cap) {
    pointer want = cap
    if want == 0 { want = 4096 }
    pointer p = 0
    fly.runtime.mem_alloc(want, p)
    BufReader r = new BufReader()
    r.buf_ptr = p
    r.buf_fill = 0
    r.buf_cap = want
    r.pos = 0
    r.inner = inner
    out = r
}

// peek returns up to n bytes from the BufReader WITHOUT consuming them. The
// returned Buf BORROWS the reader's internal storage: it is valid only until the
// next read/fill/close and must not be freed by the caller. A short result (or
// size 0 at EOF) is normal — peek never spans more than one bufferful.
public Buf peek(BufReader r, const ulong n) {
    if r.available() == 0 { r.refill() }
    pointer take = n
    pointer avail = r.available()
    if avail < take { take = avail }
    ulong taken = take
    out.ptr = r.bufAt()
    out.size = taken
    out.cap = taken
}

// fill refills the BufReader's internal buffer from its inner Reader once the
// buffered bytes have all been consumed. A no-op while data is still pending.
public void fill(BufReader r) {
    if r.available() == 0 { r.refill() }
}

// bufReadLine reads one newline-terminated line from a BufReader, returning it
// WITHOUT the trailing LF (a trailing CR is dropped too, so CRLF input works).
// Returns "" at EOF. Spans refills, so a line may exceed the buffer size.
public string bufReadLine(BufReader r) {
    pointer cap = 128
    pointer acc = 0
    fly.runtime.mem_alloc(cap, acc)
    pointer len = 0
    bool done = false
    while done == false {
        if r.available() == 0 {
            if r.refill() == 0 { done = true }
        }
        if done == false {
            byte b = 0
            r.takeByte(b)
            if b == 10 {
                done = true
            } else {
                if len == cap {
                    pointer bigger = 0
                    fly.runtime.mem_realloc(acc, cap * 2, bigger)
                    acc = bigger
                    cap = cap * 2
                }
                fly.llvm.ptrPokeByte(acc, len, b)
                len = len + 1
            }
        }
    }
    // Drop a CR left by CRLF line endings.
    if len > 0 {
        byte last = 0
        fly.llvm.ptrByteAt(acc, len - 1, last)
        if last == 13 { len = len - 1 }
    }
    int n = (int)len
    fly.llvm.strMake(acc, n, out)
}

// writerNew wraps inner in a BufWriter with an internal buffer of cap bytes
// (cap 0 → a 4 KiB default).
public BufWriter writerNew(Writer inner, const ulong cap) {
    pointer want = cap
    if want == 0 { want = 4096 }
    pointer p = 0
    fly.runtime.mem_alloc(want, p)
    BufWriter w = new BufWriter()
    w.buf_ptr = p
    w.buf_fill = 0
    w.buf_cap = want
    w.inner = inner
    out = w
}

// bufWrite writes the valid bytes of buf into the BufWriter, flushing to the
// inner Writer as the internal buffer fills.
public void bufWrite(BufWriter w, Buf buf) {
    w.write(buf, buf.size)
}

// bufFlush drains the BufWriter's internal buffer into its inner Writer.
public void bufFlush(BufWriter w) {
    w.flush()
}

// bufRead — read up to n bytes from a BufReader into buf. Free-function form of
// BufReader.read; see the ABI note on BufReader for why callers outside this
// namespace must use these wrappers rather than the methods.
public long bufRead(BufReader r, Buf buf, const ulong n) {
    out = r.read(buf, n)
}

// bufAvailable — bytes currently buffered and not yet consumed.
public ulong bufAvailable(BufReader r) {
    out = (ulong)r.available()
}

// bufClose — release the read-ahead buffer and close the inner Reader.
public void bufClose(BufReader r) {
    r.close()
}

// bufWriterClose — flush anything pending, release the buffer, close the inner
// Writer. Always prefer this over dropping the writer: buffered bytes would be lost.
public void bufWriterClose(BufWriter w) {
    w.close()
}

// copy copies all bytes from Reader src to Writer dst using an 8 KiB chunk buffer.
// Writes the total byte count into out_copied.
public long copy(Reader src, Writer dst) {
    int chunk_sz = 8192
    pointer tmp = 0
    fly.runtime.mem_alloc(chunk_sz, tmp)
    long total = 0
    bool done = false
    while done == false {
        Buf chunk = new Buf()
        chunk.ptr = tmp
        chunk.size = 0
        ulong chunk_sz_u = chunk_sz
        chunk.cap = chunk_sz_u
        long nread = 0
        nread = src.read(chunk, chunk_sz_u)
        if nread == 0 {
            done = true
        } else {
            chunk.size = nread
            // Write exactly what was read. Passing the chunk CAPACITY here would
            // emit the whole 8 KiB buffer, padding the destination with whatever
            // uninitialized bytes follow the payload.
            ulong nread_u = nread
            long nwritten = 0
            nwritten = dst.write(chunk, nread_u)
            if nwritten < 0 { done = true }
            total = total + nread
        }
    }
    out = total
}

// copyN copies at most n bytes from src to dst using an 8 KiB chunk buffer.
// Stops at n bytes or EOF, whichever comes first.  Writes actual count to out_copied.
public long copyN(Reader src, Writer dst, const ulong n) {
    int chunk_sz = 8192
    pointer tmp = 0
    fly.runtime.mem_alloc(chunk_sz, tmp)
    long total = 0
    ulong remaining = n
    bool done = false
    while done == false {
        if remaining == 0 {
            done = true
        } else {
            ulong chunk_sz_u = chunk_sz
            ulong to_read = chunk_sz_u
            if remaining < to_read { to_read = remaining }
            Buf chunk = new Buf()
            chunk.ptr = tmp
            chunk.size = 0
            chunk.cap = to_read
            long nread = 0
            nread = src.read(chunk, to_read)
            if nread == 0 {
                done = true
            } else {
                chunk.size = nread
                // Write what was read, not what was requested: a short read must
                // not emit the untouched tail of the chunk buffer.
                ulong nread_u = nread
                long nwritten = 0
                nwritten = dst.write(chunk, nread_u)
                if nwritten < 0 { done = true }
                total = total + nread
                remaining = remaining - nread_u
            }
        }
    }
    out = total
}

// pipe copies all bytes from pipe_r to pipe_w until EOF.
// Returns the total number of bytes copied (same as copy).
public long pipe(Reader pipe_r, Writer pipe_w) {
    out = copy(pipe_r, pipe_w)
}

// writeNL writes a single newline byte (0x0A) to w. Fly string literals keep
// escapes RAW (`"\n"` is the two chars backslash+n, NOT a newline), so the
// terminator must be emitted as a real byte rather than a literal string.
public void writeNL(Writer w) {
    pointer buf = 0
    fly.runtime.mem_alloc(1, buf)
    fly.llvm.strPoke(buf, 0, 10)
    Buf b = new Buf()
    b.ptr = buf
    b.size = 1
    b.cap = 1
    w.write(b, 1)
    fly.runtime.mem_free(buf, 1)
}

// printErr writes s to stderr (fd=2) without a trailing newline.
public void printErr(const string s) {
    Writer w = fileWriter(2)
    writeString(w, s)
}

// printErrLn writes s to stderr (fd=2) followed by a newline.
public void printErrLn(const string s) {
    Writer w = fileWriter(2)
    writeString(w, s)
    writeNL(w)
}

// print writes s to stdout (fd=1) without a trailing newline.
public void print(const string s) {
    Writer w = fileWriter(1)
    writeString(w, s)
}

// printLn writes s to stdout (fd=1) followed by a newline.
public void printLn(const string s) {
    Writer w = fileWriter(1)
    writeString(w, s)
    writeNL(w)
}
