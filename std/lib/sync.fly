namespace fly.sync

import fly.runtime
import fly.llvm

// ── internal helpers ──────────────────────────────────────────────────────────

private int atomicLoad(const pointer p) {
    int v = 0
    fly.runtime.atomic_load_i32(p, v)
    return v
}

private void atomicStore(const pointer p, const int v) {
    fly.runtime.atomic_store_i32(p, v)
}

private int atomicCas(const pointer p, const int expected, const int desired) {
    int prev = 0
    fly.runtime.atomic_cas_i32(p, expected, desired, prev)
    return prev
}

private int atomicAdd(const pointer p, const int delta) {
    int prev = 0
    fly.runtime.atomic_fetch_add_i32(p, delta, prev)
    return prev
}

// Allocate a zero-initialised 4-byte heap slot; return its address.
private pointer newI32() {
    ulong four = 4
    pointer p = 0
    fly.runtime.mem_alloc(four, p)
    fly.llvm.memset(p, 0, four)
    return p
}

// ── Thread ────────────────────────────────────────────────────────────────────

public struct Thread {
    int id
}

// spawn starts fn(arg) in a new thread. stack=0 uses the default (1 MB).
public Thread spawnThread(const pointer fn, const pointer arg, const ulong stack) {
    Thread res = new Thread()
    ulong sz = stack
    if sz == 0 { sz = 1048576 }
    int t = 0
    fly.runtime.thread_spawn(fn, arg, sz, t)
    res.id = t
    return res
}

// ── Mutex ─────────────────────────────────────────────────────────────────────
// Heap i32 state: 0=unlocked  1=locked

public struct Mutex {
    pointer ptr
}

public Mutex newMutex() {
    Mutex res = new Mutex()
    res.ptr = fly.sync.newI32()
    return res
}

public void mutexLock(Mutex m) {
    bool done = false
    while done == false {
        int old = fly.sync.atomicCas(m.ptr, 0, 1)
        if old == 0 {
            done = true
        } else {
            fly.runtime.futex_wait(m.ptr, old)
        }
    }
}

public void mutexUnlock(Mutex m) {
    fly.sync.atomicStore(m.ptr, 0)
    int one = 1
    int ignored = 0
    fly.runtime.futex_wake(m.ptr, one, ignored)
}

public bool mutexTryLock(Mutex m) {
    int old = fly.sync.atomicCas(m.ptr, 0, 1)
    return old == 0
}

// ── RWMutex ───────────────────────────────────────────────────────────────────
// state: 0=idle  >0=N readers  -1=writer
// waiters: queued writer count

public struct RWMutex {
    pointer state_ptr
    pointer waiters_ptr
}

public RWMutex newRWMutex() {
    RWMutex res = new RWMutex()
    res.state_ptr   = fly.sync.newI32()
    res.waiters_ptr = fly.sync.newI32()
    return res
}

public void rwmutexRlock(RWMutex rw) {
    bool done = false
    while done == false {
        int s = fly.sync.atomicLoad(rw.state_ptr)
        if s >= 0 {
            int ns = s + 1
            int old = fly.sync.atomicCas(rw.state_ptr, s, ns)
            if old == s { done = true }
        } else {
            fly.runtime.futex_wait(rw.state_ptr, s)
        }
    }
}

public void rwmutexRunlock(RWMutex rw) {
    int old = fly.sync.atomicAdd(rw.state_ptr, 0 - 1)
    if old == 1 {
        int w = fly.sync.atomicLoad(rw.waiters_ptr)
        if w > 0 {
            int all = 2147483647
            int ignored = 0
            fly.runtime.futex_wake(rw.state_ptr, all, ignored)
        }
    }
}

public void rwmutexWlock(RWMutex rw) {
    int ignored = fly.sync.atomicAdd(rw.waiters_ptr, 1)
    bool done = false
    while done == false {
        int neg1 = 0 - 1
        int old = fly.sync.atomicCas(rw.state_ptr, 0, neg1)
        if old == 0 {
            ignored = fly.sync.atomicAdd(rw.waiters_ptr, 0 - 1)
            done = true
        } else {
            fly.runtime.futex_wait(rw.state_ptr, old)
        }
    }
}

public void rwmutexWunlock(RWMutex rw) {
    fly.sync.atomicStore(rw.state_ptr, 0)
    int all = 2147483647
    int ignored = 0
    fly.runtime.futex_wake(rw.state_ptr, all, ignored)
}

// ── WaitGroup ─────────────────────────────────────────────────────────────────

public struct WaitGroup {
    pointer ptr
}

public WaitGroup newWaitGroup() {
    WaitGroup res = new WaitGroup()
    res.ptr = fly.sync.newI32()
    return res
}

public void wgAdd(WaitGroup wg, const int n) {
    int ignored = fly.sync.atomicAdd(wg.ptr, n)
}

public void wgDone(WaitGroup wg) {
    // fetch_add returns old value; old==1 means counter just reached 0
    int old = fly.sync.atomicAdd(wg.ptr, 0 - 1)
    if old == 1 {
        int all = 2147483647
        int ignored = 0
        fly.runtime.futex_wake(wg.ptr, all, ignored)
    }
}

public void wgWait(WaitGroup wg) {
    bool done = false
    while done == false {
        int v = fly.sync.atomicLoad(wg.ptr)
        if v == 0 {
            done = true
        } else {
            fly.runtime.futex_wait(wg.ptr, v)
        }
    }
}

// ── Once ──────────────────────────────────────────────────────────────────────
// State: 0=pending  1=in-progress  2=done
//
// Usage: if fly.sync.onceAcquire(o) { doInit(); fly.sync.onceRelease(o) }

public struct Once {
    pointer ptr
}

public Once newOnce() {
    Once res = new Once()
    res.ptr = fly.sync.newI32()
    return res
}

// onceAcquire returns true to exactly the first caller.
// All other callers block until onceRelease() is called.
public bool onceAcquire(Once o) {
    bool res
    bool done = false
    while done == false {
        int s = fly.sync.atomicLoad(o.ptr)
        if s == 2 {
            res = false
            done = true
        } elsif s == 0 {
            int old = fly.sync.atomicCas(o.ptr, 0, 1)
            if old == 0 {
                res = true
                done = true
            } else {
                fly.runtime.futex_wait(o.ptr, 1)
            }
        } else {
            fly.runtime.futex_wait(o.ptr, 1)
        }
    }
    return res
}

// onceRelease marks initialisation done and unblocks all waiters.
public void onceRelease(Once o) {
    fly.sync.atomicStore(o.ptr, 2)
    int all = 2147483647
    int ignored = 0
    fly.runtime.futex_wake(o.ptr, all, ignored)
}

// ── Semaphore ─────────────────────────────────────────────────────────────────

public struct Semaphore {
    pointer ptr
}

public Semaphore newSemaphore(const int initial) {
    Semaphore res = new Semaphore()
    pointer p = fly.sync.newI32()
    fly.sync.atomicStore(p, initial)
    res.ptr = p
    return res
}

public void semaphoreAcquire(Semaphore s) {
    bool done = false
    while done == false {
        int v = fly.sync.atomicLoad(s.ptr)
        if v > 0 {
            int old = fly.sync.atomicCas(s.ptr, v, v - 1)
            if old == v { done = true }
        } else {
            fly.runtime.futex_wait(s.ptr, 0)
        }
    }
}

public void semaphoreRelease(Semaphore s) {
    int ignored = fly.sync.atomicAdd(s.ptr, 1)
    int one = 1
    fly.runtime.futex_wake(s.ptr, one, ignored)
}

public bool semaphoreTryAcquire(Semaphore s) {
    int v = fly.sync.atomicLoad(s.ptr)
    if v > 0 {
        int old = fly.sync.atomicCas(s.ptr, v, v - 1)
        return old == v
    } else {
        return false
    }
}

// ── Release ───────────────────────────────────────────────────────────────────
// Every primitive above keeps its state in a small heap slot. These give it
// back: call one only when no thread can touch the primitive any more (a mutex
// unlocked, a wait group drained). Each clears the handle, so freeing twice is a
// no-op rather than a double free.

public void mutexFree(Mutex m) {
    if m.ptr != 0 { fly.runtime.mem_free(m.ptr, 4) }
    m.ptr = 0
}

public void rwMutexFree(RWMutex rw) {
    if rw.state_ptr != 0 { fly.runtime.mem_free(rw.state_ptr, 4) }
    if rw.waiters_ptr != 0 { fly.runtime.mem_free(rw.waiters_ptr, 4) }
    rw.state_ptr = 0
    rw.waiters_ptr = 0
}

public void waitGroupFree(WaitGroup wg) {
    if wg.ptr != 0 { fly.runtime.mem_free(wg.ptr, 4) }
    wg.ptr = 0
}

public void onceFree(Once o) {
    if o.ptr != 0 { fly.runtime.mem_free(o.ptr, 4) }
    o.ptr = 0
}

public void semaphoreFree(Semaphore s) {
    if s.ptr != 0 { fly.runtime.mem_free(s.ptr, 4) }
    s.ptr = 0
}
