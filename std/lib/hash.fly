namespace fly.hash

import fly.llvm
import fly.runtime
import fly.mem
import fly.str
import fly.os.fs

// ─────────────────────────────────────────────────────────────────────────────
// fly.hash — content hashes, pure Fly with no FFI and no subprocess.
//
// Moved here from compiler/lib/driver/shellutil.fly, which is ABOVE std in the
// layering: std could not reach it, even though registry checksums, HTTP digest
// auth, build fingerprints and any user program all want it. fly.driver now
// forwards to this module in one line each, so every existing caller is
// untouched.
//
// Errors follow the std sentinel convention: a digest is "" only when the input
// could not be read.
// ─────────────────────────────────────────────────────────────────────────────
// ── SHA-256 ───────────────────────────────────────────────────────────────────
// A self-contained SHA-256, NO subprocess. It began life in the package driver,
// where an earlier version shelled out to the system `sha256sum` via `/bin/sh -c`
// — broken on Windows (no /bin/sh) and a needless dependency on Linux. It lived
// in `fly.driver` only because of same-namespace source discovery, which put it
// ABOVE std and therefore out of reach of std itself; here it is available to
// every consumer. `fly.driver` keeps one-line forwarders so no call site moved.
//
// Verified against the canonical vectors (see HashSuite): "abc", "" and the
// 56-byte two-block vector.
//
// Fly gotcha, and it is load-bearing here: `byte`→`uint` widening is
// PLATFORM-DEPENDENT (sign-extends on Linux, zero-extends on Windows), so every
// byte read is masked `& 255` before it enters a 32-bit word.

uint sha256Rotr(const uint x, const uint n) { out = (x >> n) | (x << (32 - n)) }

uint sha256LoadU(const pointer p, const int off) {
    int v = 0
    fly.llvm.ptrReadInt(p, off, v)
    out = (uint)v
}
void sha256StoreU(const pointer p, const int off, const uint v) {
    fly.llvm.ptrPokeInt(p, off, (int)v)
}

// sha256FillK — the 64 round constants (frac parts of cube roots of the first 64
// primes), decimal because Fly has no hex literals.
void sha256FillK(const pointer K) {
    sha256StoreU(K, 0, 1116352408)   sha256StoreU(K, 4, 1899447441)   sha256StoreU(K, 8, 3049323471)   sha256StoreU(K, 12, 3921009573)
    sha256StoreU(K, 16, 961987163)   sha256StoreU(K, 20, 1508970993)  sha256StoreU(K, 24, 2453635748)  sha256StoreU(K, 28, 2870763221)
    sha256StoreU(K, 32, 3624381080)  sha256StoreU(K, 36, 310598401)   sha256StoreU(K, 40, 607225278)   sha256StoreU(K, 44, 1426881987)
    sha256StoreU(K, 48, 1925078388)  sha256StoreU(K, 52, 2162078206)  sha256StoreU(K, 56, 2614888103)  sha256StoreU(K, 60, 3248222580)
    sha256StoreU(K, 64, 3835390401)  sha256StoreU(K, 68, 4022224774)  sha256StoreU(K, 72, 264347078)   sha256StoreU(K, 76, 604807628)
    sha256StoreU(K, 80, 770255983)   sha256StoreU(K, 84, 1249150122)  sha256StoreU(K, 88, 1555081692)  sha256StoreU(K, 92, 1996064986)
    sha256StoreU(K, 96, 2554220882)  sha256StoreU(K, 100, 2821834349) sha256StoreU(K, 104, 2952996808) sha256StoreU(K, 108, 3210313671)
    sha256StoreU(K, 112, 3336571891) sha256StoreU(K, 116, 3584528711) sha256StoreU(K, 120, 113926993)  sha256StoreU(K, 124, 338241895)
    sha256StoreU(K, 128, 666307205)  sha256StoreU(K, 132, 773529912)  sha256StoreU(K, 136, 1294757372) sha256StoreU(K, 140, 1396182291)
    sha256StoreU(K, 144, 1695183700) sha256StoreU(K, 148, 1986661051) sha256StoreU(K, 152, 2177026350) sha256StoreU(K, 156, 2456956037)
    sha256StoreU(K, 160, 2730485921) sha256StoreU(K, 164, 2820302411) sha256StoreU(K, 168, 3259730800) sha256StoreU(K, 172, 3345764771)
    sha256StoreU(K, 176, 3516065817) sha256StoreU(K, 180, 3600352804) sha256StoreU(K, 184, 4094571909) sha256StoreU(K, 188, 275423344)
    sha256StoreU(K, 192, 430227734)  sha256StoreU(K, 196, 506948616)  sha256StoreU(K, 200, 659060556)  sha256StoreU(K, 204, 883997877)
    sha256StoreU(K, 208, 958139571)  sha256StoreU(K, 212, 1322822218) sha256StoreU(K, 216, 1537002063) sha256StoreU(K, 220, 1747873779)
    sha256StoreU(K, 224, 1955562222) sha256StoreU(K, 228, 2024104815) sha256StoreU(K, 232, 2227730452) sha256StoreU(K, 236, 2361852424)
    sha256StoreU(K, 240, 2428436474) sha256StoreU(K, 244, 2756734187) sha256StoreU(K, 248, 3204031479) sha256StoreU(K, 252, 3329325298)
}

// sha256HexU — a uint as 8 lowercase hex digits, big-endian.
string sha256HexU(const uint v) {
    pointer buf = mem.alloc(8)
    int i = 0
    while i < 8 {
        uint shift = (uint)((7 - i) * 4)
        uint nib = (v >> shift) & 15
        byte c = 0
        if nib < 10 { c = (byte)(48 + nib) }
        else { c = (byte)(87 + nib) }
        fly.llvm.strPoke(buf, i, c)
        i = i + 1
    }
    string s = ""
    fly.llvm.strMake(buf, 8, s)
    out = s
}

// sha256Digest — the 64-char lowercase hex digest of `data` (no "sha256:" prefix).
string sha256Digest(const string data) {
    int msgLen = str.len(data)
    int padLen = msgLen + 1
    while padLen % 64 != 56 { padLen = padLen + 1 }
    int totalLen = padLen + 8

    pointer m = mem.alloc(totalLen)
    int i = 0
    while i < msgLen {
        byte b = 0
        str.byteAt(data, i, b)
        fly.llvm.ptrPokeByte(m, i, b)
        i = i + 1
    }
    fly.llvm.ptrPokeByte(m, msgLen, 128)
    i = msgLen + 1
    while i < padLen {
        fly.llvm.ptrPokeByte(m, i, 0)
        i = i + 1
    }
    long bitLen = (long)msgLen * 8
    i = 0
    while i < 8 {
        long sh = (long)((7 - i) * 8)
        long bv = (bitLen >> sh) & 255
        fly.llvm.ptrPokeByte(m, padLen + i, (byte)bv)
        i = i + 1
    }

    pointer K = mem.alloc(256)
    sha256FillK(K)
    pointer W = mem.alloc(256)

    // Fly gotcha #2: a decimal literal > 2^31 is typed `long` by the reference
    // compiler, which then refuses `uint = long`; cast every 32-bit constant.
    uint h0 = (uint)1779033703
    uint h1 = (uint)3144134277
    uint h2 = (uint)1013904242
    uint h3 = (uint)2773480762
    uint h4 = (uint)1359893119
    uint h5 = (uint)2600822924
    uint h6 = (uint)528734635
    uint h7 = (uint)1541459225

    int nblk = totalLen / 64
    int blk = 0
    while blk < nblk {
        int base = blk * 64
        int t = 0
        while t < 16 {
            int o = base + t * 4
            byte b0 = 0
            byte b1 = 0
            byte b2 = 0
            byte b3 = 0
            fly.llvm.ptrReadByte(m, o, b0)
            fly.llvm.ptrReadByte(m, o + 1, b1)
            fly.llvm.ptrReadByte(m, o + 2, b2)
            fly.llvm.ptrReadByte(m, o + 3, b3)
            uint w = (((uint)b0 & 255) << 24) | (((uint)b1 & 255) << 16) | (((uint)b2 & 255) << 8) | ((uint)b3 & 255)
            sha256StoreU(W, t * 4, w)
            t = t + 1
        }
        t = 16
        while t < 64 {
            uint w15 = sha256LoadU(W, (t - 15) * 4)
            uint w2 = sha256LoadU(W, (t - 2) * 4)
            uint w16 = sha256LoadU(W, (t - 16) * 4)
            uint w7 = sha256LoadU(W, (t - 7) * 4)
            uint s0 = sha256Rotr(w15, 7) ^ sha256Rotr(w15, 18) ^ (w15 >> 3)
            uint s1 = sha256Rotr(w2, 17) ^ sha256Rotr(w2, 19) ^ (w2 >> 10)
            uint wt = w16 + s0 + w7 + s1
            sha256StoreU(W, t * 4, wt)
            t = t + 1
        }

        uint a = h0
        uint b = h1
        uint c = h2
        uint d = h3
        uint e = h4
        uint f = h5
        uint g = h6
        uint hh = h7

        t = 0
        while t < 64 {
            uint bigS1 = sha256Rotr(e, 6) ^ sha256Rotr(e, 11) ^ sha256Rotr(e, 25)
            uint ch = (e & f) ^ ((e ^ (uint)4294967295) & g)
            uint kt = sha256LoadU(K, t * 4)
            uint wv = sha256LoadU(W, t * 4)
            uint temp1 = hh + bigS1 + ch + kt + wv
            uint bigS0 = sha256Rotr(a, 2) ^ sha256Rotr(a, 13) ^ sha256Rotr(a, 22)
            uint maj = (a & b) ^ (a & c) ^ (b & c)
            uint temp2 = bigS0 + maj
            hh = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            t = t + 1
        }

        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + hh
        blk = blk + 1
    }

    string r = sha256HexU(h0)
    r = str.concat(r, sha256HexU(h1))
    r = str.concat(r, sha256HexU(h2))
    r = str.concat(r, sha256HexU(h3))
    r = str.concat(r, sha256HexU(h4))
    r = str.concat(r, sha256HexU(h5))
    r = str.concat(r, sha256HexU(h6))
    r = str.concat(r, sha256HexU(h7))
    out = r
}


// ── Public entry points ───────────────────────────────────────────────────────

// sha256Hex — the bare 64-character lowercase hex digest of a string's bytes.
public string sha256Hex(const string data) {
    out = sha256Digest(data)
}

// sha256String — "sha256:<hex>", the prefixed form the lockfile and the registry
// protocol use.
public string sha256String(const string data) {
    out = str.concat("sha256:", sha256Digest(data))
}

// sha256File — "sha256:<hex>" of a file's contents; "" when the file is missing.
//
// readBytes, NOT readStr: a digest is only meaningful over the file's actual bytes.
// Text-mode reading collapses \r\n and stops at 0x1A, so on Windows a text-mode
// read would hash a DIFFERENT byte string than every other machine computed —
// which is precisely the case that matters, since the callers hash downloaded
// package tarballs to decide whether to trust them.
public string sha256File(const string path) {
    if fs.exists(path) == false { out = ""  return }
    string data = fs.readBytes(path)
    out = str.concat("sha256:", sha256Digest(data))
}

// sha256Verify — true when the file hashes to `expected` ("sha256:<hex>"). A
// missing file hashes to "" and therefore never matches.
public bool sha256Verify(const string path, const string expected) {
    out = str.equals(sha256File(path), expected)
}

// ── CRC-32 ────────────────────────────────────────────────────────────────────
//
// The IEEE 802.3 / zlib CRC-32: reflected, polynomial 0xEDB88320 (written
// 3988292384 — Fly has no hex literals), initial and final xor 0xFFFFFFFF.
// Needed by gzip, which stores it in the member trailer, and cheap enough that a
// table is not worth the static storage Fly does not have anyway: the bitwise
// form is 8 shifts per byte.

// crc32 — the CRC-32 of a string's bytes, as a uint. An empty input is 0.
//
// Every constant above 2^31 carries an explicit (uint): a decimal literal that
// large is typed `long` by the reference compiler, so `uint ^ <literal>` would
// yield a long and fail to assign back. Fly has no hex literals, so there is no
// way to write these that avoids the cast.
public uint crc32(const string data) {
    int n = str.len(data)
    uint c = (uint)4294967295
    int i = 0
    while i < n {
        byte b = 0
        str.byteAt(data, i, b)
        int bi = b
        uint bu = (uint)(bi & 255)          // mask: byte widening differs per platform
        c = c ^ bu
        int k = 0
        while k < 8 {
            uint lsb = c & 1
            uint shifted = c >> 1
            if lsb != 0 {
                c = shifted ^ (uint)3988292384   // 0xEDB88320, reflected polynomial
            } else {
                c = shifted
            }
            k = k + 1
        }
        i = i + 1
    }
    out = c ^ (uint)4294967295
}

// crc32Hex — the CRC-32 as 8 lowercase hex characters.
public string crc32Hex(const string data) {
    out = sha256HexU(crc32(data))
}