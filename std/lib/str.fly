namespace fly.str

import fly.llvm
import fly.runtime

// ── Query functions ────────────────────────────────────────────────────────

public int len(const string src) {
    int res
    fly.llvm.strSize(src, res)
    return res
}

// byteAt — the i-th byte of a string. Public wrapper over the LLVM intrinsic so
// non-std code reads string bytes without calling fly.llvm directly.
public byte byteAt(const string s, const int i) {
    byte b = 0
    fly.llvm.strByteAt(s, i, b)
    return b
}

// fromBytes — build a string value from a raw buffer pointer + byte length.
// strMake takes OWNERSHIP of the buffer; the result is built straight in the
// caller's slot (NRVO), so handing it back costs nothing.
public string fromBytes(const pointer ptr, const int size) {
    string s = ""
    fly.llvm.strMake(ptr, size, s)
    return s
}

public bool isEmpty(const string src) {
    int s = 0
    fly.llvm.strSize(src, s)
    return s == 0
}

public bool equals(const string a, const string b) {
    return a == b
}

public bool equalsIgnoreCase(const string a, const string b) {
    int sa = 0
    int sb = 0
    fly.llvm.strSize(a, sa)
    fly.llvm.strSize(b, sb)
    if sa != sb {
        return false
    }
    bool eq = true
    int i = 0
    while i < sa {
        byte ba = 0
        byte bb = 0
        fly.llvm.strByteAt(a, i, ba)
        fly.llvm.strByteAt(b, i, bb)
        int ica = ba
        int icb = bb
        if ica >= 65 && ica <= 90 { ica = ica + 32 }
        if icb >= 65 && icb <= 90 { icb = icb + 32 }
        if ica != icb {
            eq = false
            i = sa
        }
        i = i + 1
    }
    return eq
}

public bool startsWith(const string src, const string prefix) {
    int ss = 0
    int ps = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(prefix, ps)
    if ps > ss {
        return false
    }
    bool eq = true
    int i = 0
    while i < ps {
        byte bs = 0
        byte bp = 0
        fly.llvm.strByteAt(src, i, bs)
        fly.llvm.strByteAt(prefix, i, bp)
        if bs != bp {
            eq = false
            i = ps
        }
        i = i + 1
    }
    return eq
}

public bool endsWith(const string src, const string suffix) {
    int ss = 0
    int sfs = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(suffix, sfs)
    if sfs > ss {
        return false
    }
    int offset = ss - sfs
    bool eq = true
    int i = 0
    while i < sfs {
        byte bs = 0
        byte bsf = 0
        fly.llvm.strByteAt(src, offset + i, bs)
        fly.llvm.strByteAt(suffix, i, bsf)
        if bs != bsf {
            eq = false
            i = sfs
        }
        i = i + 1
    }
    return eq
}

public int indexOf(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 {
        return 0
    }
    if ns > ss {
        return 0 - 1
    }
    int limit = ss - ns
    int found = 0 - 1
    int i = 0
    while i <= limit {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            found = i
            i = limit + 1
        }
        i = i + 1
    }
    return found
}

public int lastIndexOf(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 || ns > ss {
        return 0 - 1
    }
    int limit = ss - ns
    int found = 0 - 1
    int i = 0
    while i <= limit {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match { found = i }
        i = i + 1
    }
    return found
}

public bool contains(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 {
        return true
    }
    if ns > ss {
        return false
    }
    int limit = ss - ns
    bool found = false
    int i = 0
    while i <= limit {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            found = true
            i = limit + 1
        }
        i = i + 1
    }
    return found
}

public int count(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 || ns > ss {
        return 0
    }
    int n = 0
    int i = 0
    while i <= ss - ns {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            n = n + 1
            i = i + ns
        } else {
            i = i + 1
        }
    }
    return n
}

// ── Transform functions (allocate via fly.runtime.mem_alloc) ─────────────

public string toUpper(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    pointer buf = 0
    fly.runtime.mem_alloc(size, buf)
    int i = 0
    while i < size {
        byte b = 0
        fly.llvm.strByteAt(src, i, b)
        int ib = b
        if ib >= 97 && ib <= 122 { ib = ib - 32 }
        fly.llvm.strPoke(buf, i, ib)
        i = i + 1
    }
    fly.llvm.strMake(buf, size, res)
    return res
}

public string toLower(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    pointer buf = 0
    fly.runtime.mem_alloc(size, buf)
    int i = 0
    while i < size {
        byte b = 0
        fly.llvm.strByteAt(src, i, b)
        int ib = b
        if ib >= 65 && ib <= 90 { ib = ib + 32 }
        fly.llvm.strPoke(buf, i, ib)
        i = i + 1
    }
    fly.llvm.strMake(buf, size, res)
    return res
}

public string trim(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int lo = 0
    int hi = size
    byte b = 0
    // guard the first read like trimLeft/trimRight: an EMPTY heap string may
    // have no readable byte 0, and an unguarded strByteAt segfaults on it
    if lo < hi { fly.llvm.strByteAt(src, lo, b) }
    while lo < hi && (b == 32 || b == 9 || b == 10 || b == 13) {
        lo = lo + 1
        if lo < hi { fly.llvm.strByteAt(src, lo, b) }
    }
    if hi > lo {
        fly.llvm.strByteAt(src, hi - 1, b)
        while hi > lo && (b == 32 || b == 9 || b == 10 || b == 13) {
            hi = hi - 1
            if hi > lo { fly.llvm.strByteAt(src, hi - 1, b) }
        }
    }
    int len = hi - lo
    pointer buf = 0
    fly.runtime.mem_alloc(len, buf)
    int i = 0
    while i < len {
        fly.llvm.strByteAt(src, lo + i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

public string trimLeft(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int lo = 0
    byte b = 0
    if lo < size { fly.llvm.strByteAt(src, lo, b) }
    while lo < size && (b == 32 || b == 9 || b == 10 || b == 13) {
        lo = lo + 1
        if lo < size { fly.llvm.strByteAt(src, lo, b) }
    }
    int len = size - lo
    pointer buf = 0
    fly.runtime.mem_alloc(len, buf)
    int i = 0
    while i < len {
        fly.llvm.strByteAt(src, lo + i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

public string trimRight(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int hi = size
    byte b = 0
    if hi > 0 {
        fly.llvm.strByteAt(src, hi - 1, b)
        while hi > 0 && (b == 32 || b == 9 || b == 10 || b == 13) {
            hi = hi - 1
            if hi > 0 { fly.llvm.strByteAt(src, hi - 1, b) }
        }
    }
    pointer buf = 0
    fly.runtime.mem_alloc(hi, buf)
    int i = 0
    while i < hi {
        fly.llvm.strByteAt(src, i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, hi, res)
    return res
}

public string substring(const string src, const int start, const int end) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int s = start
    int e = end
    if s < 0 { s = 0 }
    if e > size { e = size }
    if s > e { s = e }
    int len = e - s
    pointer buf = 0
    fly.runtime.mem_alloc(len, buf)
    byte b = 0
    int i = 0
    while i < len {
        fly.llvm.strByteAt(src, s + i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

public string concat(const string a, const string b) {
    return a + b
}

public string repeat(const string src, const int count) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    if count <= 0 || size == 0 {
        pointer empty = 0
        fly.runtime.mem_alloc(1, empty)
        fly.llvm.strMake(empty, 0, res)
        return res
    }
    // A string's size is an int: a product past that is not representable, and
    // computed in int it wrapped to a small or negative size — a short buffer
    // the copy loop below then overran. Empty is the answer, not a crash.
    long total = (long)size * (long)count
    if total > 2147483647 { return res }
    int newSize = (int)total
    pointer buf = 0
    fly.runtime.mem_alloc(newSize, buf)
    byte b = 0
    int ci = 0
    while ci < count {
        int si = 0
        while si < size {
            fly.llvm.strByteAt(src, si, b)
            fly.llvm.strPoke(buf, ci * size + si, b)
            si = si + 1
        }
        ci = ci + 1
    }
    fly.llvm.strMake(buf, newSize, res)
    return res
}

public string replace(const string src, const string from, const string to) {
    string res = ""
    int ss = 0
    int fs = 0
    int ts = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(from, fs)
    fly.llvm.strSize(to, ts)
    if fs == 0 {
        res = src
        return res
    }
    // Count occurrences (inlined)
    int occ = 0
    if fs <= ss {
        int ci = 0
        while ci <= ss - fs {
            bool cm = true
            int cj = 0
            while cj < fs {
                byte cbh = 0
                byte cbn = 0
                fly.llvm.strByteAt(src, ci + cj, cbh)
                fly.llvm.strByteAt(from, cj, cbn)
                if cbh != cbn {
                    cm = false
                    cj = fs
                }
                cj = cj + 1
            }
            // Advance by |from| on a hit and by 1 otherwise — never both, or
            // ADJACENT matches get skipped and `occ` undercounts. The write loop
            // below replaces every match, so an undercount makes newSize too
            // large and strMake trails uninitialized bytes. Mirrors count().
            if cm {
                occ = occ + 1
                ci = ci + fs
            } else {
                ci = ci + 1
            }
        }
    }
    int newSize = ss + occ * (ts - fs)
    pointer buf = 0
    fly.runtime.mem_alloc(newSize, buf)
    int ri = 0
    int wi = 0
    byte b = 0
    while ri < ss {
        bool match = true
        if ri + fs > ss { match = false }
        if match {
            int j = 0
            while j < fs {
                byte bh = 0
                byte bn = 0
                fly.llvm.strByteAt(src, ri + j, bh)
                fly.llvm.strByteAt(from, j, bn)
                if bh != bn {
                    match = false
                    j = fs
                }
                j = j + 1
            }
        }
        if match {
            int k = 0
            while k < ts {
                fly.llvm.strByteAt(to, k, b)
                fly.llvm.strPoke(buf, wi, b)
                wi = wi + 1
                k = k + 1
            }
            ri = ri + fs
        }
        if match == false {
            fly.llvm.strByteAt(src, ri, b)
            fly.llvm.strPoke(buf, wi, b)
            wi = wi + 1
            ri = ri + 1
        }
    }
    fly.llvm.strMake(buf, newSize, res)
    return res
}

// ── Conversion ─────────────────────────────────────────────────────────────

public string convert(const int src) {
    string res = ""
    // Digits come from a NEGATIVE accumulator. The magnitude of INT_MIN does not
    // fit an int, so negating a negative input first left INT_MIN unchanged, the
    // digit loop never ran and the result was a bare "-".
    int n = src
    if n > 0 { n = 0 - n }
    // One buffer, filled back to front and handed to the string as it is: the old
    // scratch-then-copy version leaked the scratch on every call.
    pointer buf = 0
    fly.runtime.mem_alloc(12, buf)                    // "-2147483648" is 11 bytes
    int len = 0
    if n == 0 {
        fly.llvm.strPoke(buf, 0, 48)
        len = 1
    }
    while n < 0 {
        int q = n / 10
        int digit = q * 10 - n
        fly.llvm.strPoke(buf, len, 48 + digit)
        len = len + 1
        n = q
    }
    if src < 0 {
        fly.llvm.strPoke(buf, len, 45)
        len = len + 1
    }
    int lo = 0
    int hi = len - 1
    while lo < hi {
        byte bl = 0
        byte bh = 0
        fly.llvm.ptrByteAt(buf, lo, bl)
        fly.llvm.ptrByteAt(buf, hi, bh)
        fly.llvm.strPoke(buf, lo, bh)
        fly.llvm.strPoke(buf, hi, bl)
        lo = lo + 1
        hi = hi - 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

// convertL — decimal string of a 64-bit long (convert() is int-only; the assert
// helpers need this for assertEqL). Same digits-then-reverse shape as convert.
public string convertL(const long src) {
    string res = ""
    // Same scheme as convert: a negative accumulator (LONG_MIN has no positive
    // counterpart) and a single buffer that becomes the string.
    long n = src
    if n > 0 { n = 0 - n }
    pointer buf = 0
    fly.runtime.mem_alloc(21, buf)                    // "-9223372036854775808" is 20 bytes
    int len = 0
    if n == 0 {
        fly.llvm.strPoke(buf, 0, 48)
        len = 1
    }
    while n < 0 {
        long q = n / 10
        int digit = (int)(q * 10 - n)
        fly.llvm.strPoke(buf, len, 48 + digit)
        len = len + 1
        n = q
    }
    if src < 0 {
        fly.llvm.strPoke(buf, len, 45)
        len = len + 1
    }
    int lo = 0
    int hi = len - 1
    while lo < hi {
        byte bl = 0
        byte bh = 0
        fly.llvm.ptrByteAt(buf, lo, bl)
        fly.llvm.ptrByteAt(buf, hi, bh)
        fly.llvm.strPoke(buf, lo, bh)
        fly.llvm.strPoke(buf, hi, bl)
        lo = lo + 1
        hi = hi - 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}
