namespace fly.str

import fly.llvm
import fly.runtime
import fly.data.List

// ── Query functions ────────────────────────────────────────────────────────

public int len(const string src) {
    int res
    fly.llvm.strSize(src, res)
    return res
}

// byteAt — the i-th byte of a string. Public wrapper over the LLVM intrinsic so
// non-std code reads string bytes without calling fly.llvm directly.
public byte byteAt(const string s, const int i) {
    byte b = 0
    fly.llvm.strByteAt(s, i, b)
    return b
}

// fromBytes — build a string value from a raw buffer pointer + byte length.
// strMake takes OWNERSHIP of the buffer; the result is built straight in the
// caller's slot (NRVO), so handing it back costs nothing.
public string fromBytes(const pointer ptr, const int size) {
    string s = ""
    fly.llvm.strMake(ptr, size, s)
    return s
}

public bool isEmpty(const string src) {
    int s = 0
    fly.llvm.strSize(src, s)
    return s == 0
}

public bool equals(const string a, const string b) {
    return a == b
}

public bool equalsIgnoreCase(const string a, const string b) {
    int sa = 0
    int sb = 0
    fly.llvm.strSize(a, sa)
    fly.llvm.strSize(b, sb)
    if sa != sb {
        return false
    }
    bool eq = true
    int i = 0
    while i < sa {
        byte ba = 0
        byte bb = 0
        fly.llvm.strByteAt(a, i, ba)
        fly.llvm.strByteAt(b, i, bb)
        int ica = ba
        int icb = bb
        if ica >= 65 && ica <= 90 {
            ica = ica + 32
        }
        if icb >= 65 && icb <= 90 {
            icb = icb + 32
        }
        if ica != icb {
            eq = false
            i = sa
        }
        i = i + 1
    }
    return eq
}

public bool startsWith(const string src, const string prefix) {
    int ss = 0
    int ps = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(prefix, ps)
    if ps > ss {
        return false
    }
    bool eq = true
    int i = 0
    while i < ps {
        byte bs = 0
        byte bp = 0
        fly.llvm.strByteAt(src, i, bs)
        fly.llvm.strByteAt(prefix, i, bp)
        if bs != bp {
            eq = false
            i = ps
        }
        i = i + 1
    }
    return eq
}

public bool endsWith(const string src, const string suffix) {
    int ss = 0
    int sfs = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(suffix, sfs)
    if sfs > ss {
        return false
    }
    int offset = ss - sfs
    bool eq = true
    int i = 0
    while i < sfs {
        byte bs = 0
        byte bsf = 0
        fly.llvm.strByteAt(src, offset + i, bs)
        fly.llvm.strByteAt(suffix, i, bsf)
        if bs != bsf {
            eq = false
            i = sfs
        }
        i = i + 1
    }
    return eq
}

public int indexOf(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 {
        return 0
    }
    if ns > ss {
        return 0 - 1
    }
    int limit = ss - ns
    int found = 0 - 1
    int i = 0
    while i <= limit {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            found = i
            i = limit + 1
        }
        i = i + 1
    }
    return found
}

public int lastIndexOf(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 || ns > ss {
        return 0 - 1
    }
    int limit = ss - ns
    int found = 0 - 1
    int i = 0
    while i <= limit {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            found = i
        }
        i = i + 1
    }
    return found
}

public bool contains(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 {
        return true
    }
    if ns > ss {
        return false
    }
    int limit = ss - ns
    bool found = false
    int i = 0
    while i <= limit {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            found = true
            i = limit + 1
        }
        i = i + 1
    }
    return found
}

public int count(const string src, const string sub) {
    int ss = 0
    int ns = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(sub, ns)
    if ns == 0 || ns > ss {
        return 0
    }
    int n = 0
    int i = 0
    while i <= ss - ns {
        bool match = true
        int j = 0
        while j < ns {
            byte bh = 0
            byte bn = 0
            fly.llvm.strByteAt(src, i + j, bh)
            fly.llvm.strByteAt(sub, j, bn)
            if bh != bn {
                match = false
                j = ns
            }
            j = j + 1
        }
        if match {
            n = n + 1
            i = i + ns
        } else {
            i = i + 1
        }
    }
    return n
}

// ── Transform functions (allocate via fly.runtime.mem_alloc) ─────────────

public string toUpper(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)size, buf)
    int i = 0
    while i < size {
        byte b = 0
        fly.llvm.strByteAt(src, i, b)
        int ib = b
        if ib >= 97 && ib <= 122 {
            ib = ib - 32
        }
        fly.llvm.strPoke(buf, i, (byte)ib)
        i = i + 1
    }
    fly.llvm.strMake(buf, size, res)
    return res
}

public string toLower(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)size, buf)
    int i = 0
    while i < size {
        byte b = 0
        fly.llvm.strByteAt(src, i, b)
        int ib = b
        if ib >= 65 && ib <= 90 {
            ib = ib + 32
        }
        fly.llvm.strPoke(buf, i, (byte)ib)
        i = i + 1
    }
    fly.llvm.strMake(buf, size, res)
    return res
}

public string trim(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int lo = 0
    int hi = size
    byte b = 0
    // guard the first read like trimLeft/trimRight: an EMPTY heap string may
    // have no readable byte 0, and an unguarded strByteAt segfaults on it
    if lo < hi {
        fly.llvm.strByteAt(src, lo, b)
    }
    while lo < hi && (b == 32 || b == 9 || b == 10 || b == 13) {
        lo = lo + 1
        if lo < hi {
            fly.llvm.strByteAt(src, lo, b)
        }
    }
    if hi > lo {
        fly.llvm.strByteAt(src, hi - 1, b)
        while hi > lo && (b == 32 || b == 9 || b == 10 || b == 13) {
            hi = hi - 1
            if hi > lo {
                fly.llvm.strByteAt(src, hi - 1, b)
            }
        }
    }
    int len = hi - lo
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)len, buf)
    int i = 0
    while i < len {
        fly.llvm.strByteAt(src, lo + i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

public string trimLeft(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int lo = 0
    byte b = 0
    if lo < size {
        fly.llvm.strByteAt(src, lo, b)
    }
    while lo < size && (b == 32 || b == 9 || b == 10 || b == 13) {
        lo = lo + 1
        if lo < size {
            fly.llvm.strByteAt(src, lo, b)
        }
    }
    int len = size - lo
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)len, buf)
    int i = 0
    while i < len {
        fly.llvm.strByteAt(src, lo + i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

public string trimRight(const string src) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int hi = size
    byte b = 0
    if hi > 0 {
        fly.llvm.strByteAt(src, hi - 1, b)
        while hi > 0 && (b == 32 || b == 9 || b == 10 || b == 13) {
            hi = hi - 1
            if hi > 0 {
                fly.llvm.strByteAt(src, hi - 1, b)
            }
        }
    }
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)hi, buf)
    int i = 0
    while i < hi {
        fly.llvm.strByteAt(src, i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, hi, res)
    return res
}

public string substring(const string src, const int start, const int end) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    int s = start
    int e = end
    if s < 0 {
        s = 0
    }
    if e > size {
        e = size
    }
    if s > e {
        s = e
    }
    int len = e - s
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)len, buf)
    byte b = 0
    int i = 0
    while i < len {
        fly.llvm.strByteAt(src, s + i, b)
        fly.llvm.strPoke(buf, i, b)
        i = i + 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

public string concat(const string a, const string b) {
    return a + b
}

public string repeat(const string src, const int count) {
    string res = ""
    int size = 0
    fly.llvm.strSize(src, size)
    if count <= 0 || size == 0 {
        pointer empty = 0
        fly.runtime.mem_alloc(1, empty)
        fly.llvm.strMake(empty, 0, res)
        return res
    }
    // A string's size is an int: a product past that is not representable, and
    // computed in int it wrapped to a small or negative size — a short buffer
    // the copy loop below then overran. Empty is the answer, not a crash.
    long total = (long)size * (long)count
    if total > 2147483647 {
        return res
    }
    int newSize = (int)total
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)newSize, buf)
    byte b = 0
    int ci = 0
    while ci < count {
        int si = 0
        while si < size {
            fly.llvm.strByteAt(src, si, b)
            fly.llvm.strPoke(buf, ci * size + si, b)
            si = si + 1
        }
        ci = ci + 1
    }
    fly.llvm.strMake(buf, newSize, res)
    return res
}

public string replace(const string src, const string from, const string to) {
    string res = ""
    int ss = 0
    int fs = 0
    int ts = 0
    fly.llvm.strSize(src, ss)
    fly.llvm.strSize(from, fs)
    fly.llvm.strSize(to, ts)
    if fs == 0 {
        res = src
        return res
    }
    // Count occurrences (inlined)
    int occ = 0
    if fs <= ss {
        int ci = 0
        while ci <= ss - fs {
            bool cm = true
            int cj = 0
            while cj < fs {
                byte cbh = 0
                byte cbn = 0
                fly.llvm.strByteAt(src, ci + cj, cbh)
                fly.llvm.strByteAt(from, cj, cbn)
                if cbh != cbn {
                    cm = false
                    cj = fs
                }
                cj = cj + 1
            }
            // Advance by |from| on a hit and by 1 otherwise — never both, or
            // ADJACENT matches get skipped and `occ` undercounts. The write loop
            // below replaces every match, so an undercount makes newSize too
            // large and strMake trails uninitialized bytes. Mirrors count().
            if cm {
                occ = occ + 1
                ci = ci + fs
            } else {
                ci = ci + 1
            }
        }
    }
    int newSize = ss + occ * (ts - fs)
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)newSize, buf)
    int ri = 0
    int wi = 0
    byte b = 0
    while ri < ss {
        bool match = true
        if ri + fs > ss {
            match = false
        }
        if match {
            int j = 0
            while j < fs {
                byte bh = 0
                byte bn = 0
                fly.llvm.strByteAt(src, ri + j, bh)
                fly.llvm.strByteAt(from, j, bn)
                if bh != bn {
                    match = false
                    j = fs
                }
                j = j + 1
            }
        }
        if match {
            int k = 0
            while k < ts {
                fly.llvm.strByteAt(to, k, b)
                fly.llvm.strPoke(buf, wi, b)
                wi = wi + 1
                k = k + 1
            }
            ri = ri + fs
        }
        if match == false {
            fly.llvm.strByteAt(src, ri, b)
            fly.llvm.strPoke(buf, wi, b)
            wi = wi + 1
            ri = ri + 1
        }
    }
    fly.llvm.strMake(buf, newSize, res)
    return res
}

// ── Conversion ─────────────────────────────────────────────────────────────

public string convert(const int src) {
    string res = ""
    // Digits come from a NEGATIVE accumulator. The magnitude of INT_MIN does not
    // fit an int, so negating a negative input first left INT_MIN unchanged, the
    // digit loop never ran and the result was a bare "-".
    int n = src
    if n > 0 {
        n = 0 - n
    }
    // One buffer, filled back to front and handed to the string as it is: the old
    // scratch-then-copy version leaked the scratch on every call.
    pointer buf = 0
    fly.runtime.mem_alloc(12, buf)                    // "-2147483648" is 11 bytes
    int len = 0
    if n == 0 {
        fly.llvm.strPoke(buf, 0, 48)
        len = 1
    }
    while n < 0 {
        int q = n / 10
        int digit = q * 10 - n
        fly.llvm.strPoke(buf, len, (byte)(48 + digit))
        len = len + 1
        n = q
    }
    if src < 0 {
        fly.llvm.strPoke(buf, len, 45)
        len = len + 1
    }
    int lo = 0
    int hi = len - 1
    while lo < hi {
        byte bl = 0
        byte bh = 0
        fly.llvm.ptrByteAt(buf, lo, bl)
        fly.llvm.ptrByteAt(buf, hi, bh)
        fly.llvm.strPoke(buf, lo, bh)
        fly.llvm.strPoke(buf, hi, bl)
        lo = lo + 1
        hi = hi - 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

// convertL — decimal string of a 64-bit long (convert() is int-only; the assert
// helpers need this for assertEqL). Same digits-then-reverse shape as convert.
public string convertL(const long src) {
    string res = ""
    // Same scheme as convert: a negative accumulator (LONG_MIN has no positive
    // counterpart) and a single buffer that becomes the string.
    long n = src
    if n > 0 {
        n = 0 - n
    }
    pointer buf = 0
    fly.runtime.mem_alloc(21, buf)                    // "-9223372036854775808" is 20 bytes
    int len = 0
    if n == 0 {
        fly.llvm.strPoke(buf, 0, 48)
        len = 1
    }
    while n < 0 {
        long q = n / 10
        int digit = (int)(q * 10 - n)
        fly.llvm.strPoke(buf, len, (byte)(48 + digit))
        len = len + 1
        n = q
    }
    if src < 0 {
        fly.llvm.strPoke(buf, len, 45)
        len = len + 1
    }
    int lo = 0
    int hi = len - 1
    while lo < hi {
        byte bl = 0
        byte bh = 0
        fly.llvm.ptrByteAt(buf, lo, bl)
        fly.llvm.ptrByteAt(buf, hi, bh)
        fly.llvm.strPoke(buf, lo, bh)
        fly.llvm.strPoke(buf, hi, bl)
        lo = lo + 1
        hi = hi - 1
    }
    fly.llvm.strMake(buf, len, res)
    return res
}

// ── Characters (UTF-8) ─────────────────────────────────────────────────────
//
// Fly has no character type: a character is a string of one character. A string
// is a sequence of BYTES (len, byteAt, substring, indexOf count bytes); its text
// is UTF-8, and the functions below count CHARACTERS — Unicode code points, 1 to
// 4 bytes each. A byte that does not start a valid sequence (a stray
// continuation byte, an overlong form, a surrogate, a value past 10FFFF, a
// truncated sequence) is one character of one byte, read as U+FFFD.

// utf8LenAt — the length in bytes (1 to 4) of the character that starts at
// byte `at`; 0 when `at` is outside the string.
private int utf8LenAt(const string s, const int at) {
    int n = fly.str.len(s)
    if at < 0 || at >= n {
        return 0
    }
    int b0 = fly.str.byteAt(s, at) & 255
    if b0 < 128 {
        return 1
    }
    int need = 0
    int min = 0
    int cp = 0
    if b0 >= 194 && b0 <= 223 {
        need = 1
        min = 128
        cp = b0 & 31
    } elsif b0 >= 224 && b0 <= 239 {
        need = 2
        min = 2048
        cp = b0 & 15
    } elsif b0 >= 240 && b0 <= 244 {
        need = 3
        min = 65536
        cp = b0 & 7
    } else {
        return 1
    }
    if at + need >= n {
        return 1
    }
    int k = 1
    while k <= need {
        int b = fly.str.byteAt(s, at + k) & 255
        if (b & 192) != 128 {
            return 1
        }
        cp = (cp << 6) | (b & 63)
        k = k + 1
    }
    if cp < min || cp > 1114111 || (cp >= 55296 && cp <= 57343) {
        return 1
    }
    return need + 1
}

// utf8CodeAt — the code point of the character that starts at byte `at`
// (U+FFFD for an invalid byte), given its length `cl` from utf8LenAt.
private int utf8CodeAt(const string s, const int at, const int cl) {
    int b0 = fly.str.byteAt(s, at) & 255
    if cl == 1 {
        if b0 < 128 {
            return b0
        }
        return 65533
    }
    int cp = b0 & 31
    if cl == 3 {
        cp = b0 & 15
    } elsif cl == 4 {
        cp = b0 & 7
    }
    int k = 1
    while k < cl {
        cp = (cp << 6) | (fly.str.byteAt(s, at + k) & 63)
        k = k + 1
    }
    return cp
}

// charOffset — the byte offset where character `i` starts; -1 when the string
// has no character `i`.
private int charOffset(const string s, const int i) {
    if i < 0 {
        return -1
    }
    int n = fly.str.len(s)
    int at = 0
    int c = 0
    while at < n && c < i {
        at = at + fly.str.utf8LenAt(s, at)
        c = c + 1
    }
    if at >= n {
        return -1
    }
    return at
}

// charCount — the number of characters (code points) of `s`.
public int charCount(const string s) {
    int n = fly.str.len(s)
    int count = 0
    int at = 0
    while at < n {
        at = at + fly.str.utf8LenAt(s, at)
        count = count + 1
    }
    return count
}

// charAt — character `i` of `s` (counted in characters, from 0) as a string of
// one character; "" when there is no such character. It scans the string from
// the start: to visit every character, use chars().
public string charAt(const string s, const int i) {
    int at = fly.str.charOffset(s, i)
    if at < 0 {
        return ""
    }
    return fly.str.substring(s, at, at + fly.str.utf8LenAt(s, at))
}

// chars — every character of `s`, in order, each as a string of one character.
public List<string> chars(const string s) {
    List<string> res = new List<string>()
    int n = fly.str.len(s)
    int at = 0
    while at < n {
        int cl = fly.str.utf8LenAt(s, at)
        res.add(fly.str.substring(s, at, at + cl))
        at = at + cl
    }
    return res
}

// charCode — the code point of character `i` (U+FFFD for an invalid byte); -1
// when there is no such character.
public int charCode(const string s, const int i) {
    int at = fly.str.charOffset(s, i)
    if at < 0 {
        return -1
    }
    return fly.str.utf8CodeAt(s, at, fly.str.utf8LenAt(s, at))
}

// fromCharCode — the character with code point `cp`, UTF-8 encoded (1 to 4
// bytes); U+FFFD for a value that is not a code point (negative, a surrogate,
// past 10FFFF).
public string fromCharCode(const int cp) {
    int v = cp
    if v < 0 || v > 1114111 || (v >= 55296 && v <= 57343) {
        v = 65533
    }
    int n = 4
    if v < 128 {
        n = 1
    } elsif v < 2048 {
        n = 2
    } elsif v < 65536 {
        n = 3
    }
    pointer buf = 0
    fly.runtime.mem_alloc((ulong)n, buf)
    if n == 1 {
        fly.llvm.strPoke(buf, 0, (byte)v)
    } elsif n == 2 {
        fly.llvm.strPoke(buf, 0, (byte)(192 | (v >> 6)))
        fly.llvm.strPoke(buf, 1, (byte)(128 | (v & 63)))
    } elsif n == 3 {
        fly.llvm.strPoke(buf, 0, (byte)(224 | (v >> 12)))
        fly.llvm.strPoke(buf, 1, (byte)(128 | ((v >> 6) & 63)))
        fly.llvm.strPoke(buf, 2, (byte)(128 | (v & 63)))
    } else {
        fly.llvm.strPoke(buf, 0, (byte)(240 | (v >> 18)))
        fly.llvm.strPoke(buf, 1, (byte)(128 | ((v >> 12) & 63)))
        fly.llvm.strPoke(buf, 2, (byte)(128 | ((v >> 6) & 63)))
        fly.llvm.strPoke(buf, 3, (byte)(128 | (v & 63)))
    }
    return fly.str.fromBytes(buf, n)
}

// isUtf8 — is every byte of `s` part of a valid UTF-8 sequence?
public bool isUtf8(const string s) {
    int n = fly.str.len(s)
    int at = 0
    while at < n {
        int cl = fly.str.utf8LenAt(s, at)
        if cl == 1 && (fly.str.byteAt(s, at) & 255) >= 128 {
            return false
        }
        at = at + cl
    }
    return true
}

// reverse — the characters of `s` in reverse order (characters, not bytes, so
// UTF-8 text stays valid).
public string reverse(const string s) {
    List<string> cs = fly.str.chars(s)
    string res = ""
    int i = (int)cs.size() - 1
    while i >= 0 {
        res = fly.str.concat(res, cs.get(i))
        i = i - 1
    }
    return res
}

// padLeft — `s` preceded by copies of `fill` until it is `width` characters
// long; `s` unchanged when it already is, or when `fill` is empty. A fill of
// several characters is repeated and cut to the width.
public string padLeft(const string s, const int width, const string fill) {
    string pad = fly.str.padding(fly.str.charCount(s), width, fill)
    return fly.str.concat(pad, s)
}

// padRight — `s` followed by copies of `fill` until it is `width` characters
// long (see padLeft).
public string padRight(const string s, const int width, const string fill) {
    string pad = fly.str.padding(fly.str.charCount(s), width, fill)
    return fly.str.concat(s, pad)
}

// padding — the characters of `fill`, repeated, that take a string of `have`
// characters to `width`.
private string padding(const int have, const int width, const string fill) {
    string res = ""
    if have >= width || fly.str.isEmpty(fill) {
        return res
    }
    List<string> fc = fly.str.chars(fill)
    int nf = (int)fc.size()
    int k = 0
    while have + k < width {
        res = fly.str.concat(res, fc.get(k % nf))
        k = k + 1
    }
    return res
}

// ── Split, join, compare, search ───────────────────────────────────────────

// split — the parts of `s` between occurrences of `sep`, in order. Empty parts
// are kept: "a,,b" gives "a", "", "b", and "" gives one empty part. An empty
// `sep` splits into characters (as chars()).
public List<string> split(const string s, const string sep) {
    if fly.str.isEmpty(sep) {
        return fly.str.chars(s)
    }
    List<string> res = new List<string>()
    int n = fly.str.len(s)
    int sl = fly.str.len(sep)
    int start = 0
    int at = fly.str.indexOfFrom(s, sep, 0)
    while at >= 0 {
        res.add(fly.str.substring(s, start, at))
        start = at + sl
        at = fly.str.indexOfFrom(s, sep, start)
    }
    res.add(fly.str.substring(s, start, n))
    return res
}

// join — the strings of `parts`, in order, with `sep` between each two.
public string join(const List<string> parts, const string sep) {
    string res = ""
    int n = (int)parts.size()
    int i = 0
    while i < n {
        if i > 0 {
            res = fly.str.concat(res, sep)
        }
        res = fly.str.concat(res, parts.get(i))
        i = i + 1
    }
    return res
}

// compare — -1, 0 or 1 as `a` sorts before, equal to or after `b`, byte by
// byte (for UTF-8 text, the order of the code points); a prefix sorts first.
public int compare(const string a, const string b) {
    int na = fly.str.len(a)
    int nb = fly.str.len(b)
    int i = 0
    while i < na && i < nb {
        int x = fly.str.byteAt(a, i) & 255
        int y = fly.str.byteAt(b, i) & 255
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    if na < nb {
        return -1
    }
    if na > nb {
        return 1
    }
    return 0
}

// indexOfFrom — the byte index of the first occurrence of `sub` at or after
// byte `from`, or -1. An empty `sub` is found at `from` (when it is inside the
// string or at its end).
public int indexOfFrom(const string src, const string sub, const int from) {
    int n = fly.str.len(src)
    int m = fly.str.len(sub)
    int start = from
    if start < 0 {
        start = 0
    }
    if start > n {
        return -1
    }
    if m == 0 {
        return start
    }
    int i = start
    while i + m <= n {
        int j = 0
        while j < m && (fly.str.byteAt(src, i + j) & 255) == (fly.str.byteAt(sub, j) & 255) {
            j = j + 1
        }
        if j == m {
            return i
        }
        i = i + 1
    }
    return -1
}

// replaceFirst — `src` with its first occurrence of `from` replaced by `to`;
// `src` unchanged when `from` is empty or absent.
public string replaceFirst(const string src, const string from, const string to) {
    if fly.str.isEmpty(from) {
        return fly.str.concat(src, "")
    }
    int at = fly.str.indexOf(src, from)
    if at < 0 {
        return fly.str.concat(src, "")
    }
    string head = fly.str.substring(src, 0, at)
    string tail = fly.str.substring(src, at + fly.str.len(from), fly.str.len(src))
    return fly.str.concat(head, fly.str.concat(to, tail))
}

// ── Parsing ────────────────────────────────────────────────────────────────

// toLong — the decimal integer `s` spells: an optional sign, then digits, and
// nothing else (no blanks). errOut: 0 ok, 1 not a number, 2 out of the range of
// a long; the result is then 0.
public long toLong(const string s, int errOut) {
    errOut = 0
    int n = fly.str.len(s)
    int i = 0
    bool neg = false
    if n > 0 {
        int c0 = fly.str.byteAt(s, 0) & 255
        if c0 == 45 {
            neg = true
            i = 1
        } elsif c0 == 43 {
            i = 1
        }
    }
    if i >= n {
        errOut = 1
        return 0
    }
    long minL = 0 - 9223372036854775807 - 1
    long v = 0
    while i < n {
        int c = fly.str.byteAt(s, i) & 255
        if c < 48 || c > 57 {
            errOut = 1
            return 0
        }
        long d = c - 48
        // accumulate NEGATIVE (the range reaches one further below zero), and
        // check before each step: an overflow would trap
        if v < (minL + d) / 10 {
            errOut = 2
            return 0
        }
        v = v * 10 - d
        i = i + 1
    }
    if neg {
        return v
    }
    if v == minL {
        errOut = 2
        return 0
    }
    return 0 - v
}

// toInt — as toLong, for the range of an int (errOut 2 beyond it).
public int toInt(const string s, int errOut) {
    long v = fly.str.toLong(s, errOut)
    if errOut != 0 {
        return 0
    }
    if v > 2147483647 || v < 0 - 2147483647 - 1 {
        errOut = 2
        return 0
    }
    return (int)v
}
