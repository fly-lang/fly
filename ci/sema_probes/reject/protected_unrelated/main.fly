class Base {
    protected int v

    public Base() {
        this.v = 1
    }

    protected int get() {
        return this.v
    }

    protected static int make() {
        return 7
    }
}

class Other {

    public Other() {
    }

    public int peek(const Base b) {
        return b.v
    }
}

