// A sized array of more than one dimension is built whole (fly-lang/fly#271):
// `int[2][3] g` is 2 rows of 3, read in the order of the subscripts, so
// `g[i][j]` takes i < 2 and j < 3. Every row is built as a sized array of one
// dimension is: numbers at zero, struct elements with their field
// initializers, class elements with their constructor. Up to 0.15.x the rows
// were left empty and every subscript failed with `index out of range`.
struct Cell {
    public int tag = 1
}

class Unit {
    public int id = 7
}

int two() {
    return 2
}

void main() {
    int[2][3] g
    for int i = 0; i < 2; i++ {
        for int j = 0; j < 3; j++ {
            g[i][j] = i * 10 + j
        }
    }
    if g[0][0] != 0 || g[0][2] != 2 || g[1][0] != 10 || g[1][2] != 12 {
        fail 1
    }
    handle {
        g[2][0] = 1
    }
    if error == false {
        fail 2
    }
    handle {
        g[0][3] = 1
    }
    if error == false {
        fail 3
    }

    Cell[2][2] grid
    grid[1][0].tag = 5
    if grid[0][0].tag != 1 || grid[0][1].tag != 1 || grid[1][0].tag != 5 || grid[1][1].tag != 1 {
        fail 4
    }

    Unit[2][2] units
    units[0][1].id = 9
    if units[0][0].id != 7 || units[0][1].id != 9 || units[1][1].id != 7 {
        fail 5
    }
    for int i = 0; i < 2; i++ {
        for int j = 0; j < 2; j++ {
            Unit u = units[i][j]
            delete u
        }
    }

    int[2][3][4] cube
    cube[1][2][3] = 9
    if cube[1][2][3] != 9 || cube[0][0][0] != 0 {
        fail 6
    }
    handle {
        cube[1][3][0] = 1
    }
    if error == false {
        fail 7
    }

    int[two()][two() + 1] sized
    sized[1][2] = 4
    if sized[1][2] != 4 {
        fail 8
    }

    int[2][] open
    handle {
        open[0][0] = 1
    }
    if error == false {
        fail 9
    }
    int[] row = {4, 5}
    open[1] = row
    if open[1][1] != 5 {
        fail 10
    }
}
