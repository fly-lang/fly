// A sized array whose element fails to build stops the declaration and leaves
// nothing behind (fly-lang/fly#257): the failing element is released as a
// failed `new` is (its fields, its memory, not free()), the elements built
// before it are deleted last first (their free() runs), then the buffer goes.
// That holds for a failing constructor and a failing field initializer, for
// a failure that leaves by a handle and by a return, and for struct elements
// (fly-lang/fly#255: they run the struct's initializers). free() prints, so the output shows what ran and in
// which order; nothing is left for the end-of-main report.
import fly.os.io
import fly.str

public class Count {
    public static int made = 0
    public static int failAt = 0
}

int nextIndex() {
    int k = Count.made
    Count.made = Count.made + 1
    if k == Count.failAt {
        fail 41, "element"
    }
    return k
}

public class Part {

    string name

    public Part(const string name) {
        this.name = name
    }

    public void free() {
        io.printLn(this.name)
    }
}

// Flaky — the constructor of the element `Count.failAt` fails, after it set
// its owned part
public class Flaky {

    public int idx
    Part part

    public Flaky() {
        this.idx = Count.made
        this.part = new unique Part(str.concat("part ", str.convert(this.idx)))
        this.idx = nextIndex()
    }

    public void free() {
        io.printLn(str.concat("flaky free ", str.convert(this.idx)))
    }
}

// Unready — the field initializer of the element `Count.failAt` fails
public class Unready {

    public int idx = nextIndex()

    public Unready() {
    }

    public void free() {
        io.printLn(str.concat("unready free ", str.convert(this.idx)))
    }
}

// Cell — a struct element: the initializer of element `Count.failAt` fails
struct Cell {
    int seven = 7
    int idx = nextIndex()
}

void start(const int failAt) {
    Count.made = 0
    Count.failAt = failAt
}

void buildFlaky() {
    Flaky[3] fs
    io.printLn(str.concat("not reached ", str.convert(fs[0].idx)))
}

void main() {
    start(2)
    handle {
        Flaky[4] fs
        io.printLn(str.concat("not reached ", str.convert(fs[0].idx)))
    }
    start(1)
    handle {
        Unready[3] us
        io.printLn(str.concat("not reached ", str.convert(us[0].idx)))
    }
    start(1)
    handle {
        buildFlaky()
    }
    start(2)
    handle {
        Cell[3] cs
        io.printLn(str.concat("not reached ", str.convert(cs[0].idx)))
    }
    start(0)
    handle {
        Flaky[2] none
        io.printLn(str.concat("not reached ", str.convert(none[0].idx)))
    }
    start(99)
    Flaky[2] ok
    Flaky f0 = ok[0]
    Flaky f1 = ok[1]
    delete f0
    delete f1
}
