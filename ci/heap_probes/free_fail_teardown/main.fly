// main ends cleanly, but the release of an object it never deleted fails in its
// free() (fly-lang/fly#260): that failure is reported like an unhandled one and
// sets the exit code; the release of the other objects goes on.
import fly.os.io

// Flaky — its free() prints its tag, then fails with its code (0: it does not).
public class Flaky {

    string tag
    int code

    public Flaky(const string tag, const int code) {
        this.tag = tag
        this.code = code
    }

    public void free() {
        io.printLn(this.tag)
        if this.code != 0 {
            fail this.code, "free"
        }
    }
}

void main() {
    Flaky a = new Flaky("first leaked", 0)
    Flaky b = new Flaky("second leaked", 47)
    io.printLn("main done")
}
