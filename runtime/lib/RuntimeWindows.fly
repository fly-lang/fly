// ── Memory ────────────────────────────────────────────────────────────────────
public void mem_alloc(const ulong size, pointer out) {
    ulong s = size
    if s == 0 { s = 1 }
    fly.runtime.malloc(s, out)
}
public void mem_free(const pointer ptr, const ulong size) {
    fly.runtime.free(ptr)
}
public void mem_realloc(const pointer ptr, const ulong newSize, pointer out) {
    ulong s = newSize
    if s == 0 { s = 1 }
    fly.runtime.realloc(ptr, s, out)
}

// ── I/O — GetStdHandle + WriteFile (fd 1=stdout, 2=stderr) ────────────────────
public void io_write(const int fd, const pointer buf, const ulong count, long out) {
    int stdh = 0
    if fd == 1 { stdh = 0 - 11 } elsif fd == 2 { stdh = 0 - 12 } else { out = 0 - 1  return }
    pointer h = 0
    fly.runtime.GetStdHandle(stdh, h)
    if h == 0 { out = 0 - 1  return }
    int n = 0
    fly.llvm.longToInt((long)count, n)
    pointer written = 0
    fly.runtime.malloc(4, written)
    int ok = 0
    fly.runtime.WriteFile(h, buf, n, written, 0, ok)
    if ok == 0 { out = 0 - 1 } else {
        int w = 0
        fly.llvm.ptrReadInt(written, 0, w)
        out = w
    }
    fly.runtime.free(written)
}

