    fly.runtime.ExitProcess(code)
}

// ── Filesystem ────────────────────────────────────────────────────────────────
// POSIX O_* → UCRT _open flags. O_RDONLY=0/WRONLY=1/RDWR=2; CREAT 64→0x100,
// TRUNC 512→0x200, APPEND 1024→0x8.
private void winOpenFlags(const int flags, int out) {
    int wf = 0
    int rw = flags & 3
    if rw == 1 { wf = 1 } elsif rw == 2 { wf = 2 } else { wf = 0 }
    int cCreat = flags & 64
    if cCreat != 0 { wf = wf | 256 }
    int cTrunc = flags & 512
    if cTrunc != 0 { wf = wf | 512 }
    int cApp = flags & 1024
    if cApp != 0 { wf = wf | 8 }
    out = wf
}
// fs_open — regular files only (via _open). Directories: not supported here (no
// static dir-fd table), so _open returns -1 for them → directory listing fails.
public void fs_open(const pointer path, const int flags, const int mode, int out) {
    int wf = 0
    winOpenFlags(flags, wf)
    fly.runtime._open(path, wf, mode, out)
}
public void fs_close(const int fd) {
    int r = 0
    fly.runtime._close(fd, r)
}
public void fs_read(const int fd, const pointer buf, const ulong count, long out) {
    int c = 0
    fly.llvm.longToInt((long)count, c)
    int r = 0
    fly.runtime._read(fd, buf, c, r)
    out = r
}
public void fs_write(const int fd, const pointer buf, const ulong count, long out) {
    int c = 0
    fly.llvm.longToInt((long)count, c)
    int r = 0
    fly.runtime._write(fd, buf, c, r)
    out = r
}
public void fs_seek(const int fd, const long offset, const int whence, long out) {
    fly.runtime._lseeki64(fd, offset, whence, out)
}

// io_set_binary — take an fd out of the UCRT's TEXT mode, where reads collapse
// \r\n into \n and stop at a 0x1A byte, and writes expand every \n into \r\n.
// _O_BINARY is 0x8000 = 32768. Returns 0 on success, -1 on error.
//
// This is opt-in per fd rather than a global _fmode change: the compiler's own
// stdout is happy in text mode, while a byte-exact protocol (the LSP's
// Content-Length framing) is destroyed by it. The POSIX backends translate
// nothing, so there the primitive is a no-op that reports success.
public void io_set_binary(const int fd, int out) {
    int r = 0
    fly.runtime._setmode(fd, 32768, r)
    if r < 0 { out = 0 - 1 } else { out = 0 }
}
// stat via GetFileAttributesExA. WIN32_FILE_ATTRIBUTE_DATA: dwFileAttributes@0,
// nFileSizeHigh@28, nFileSizeLow@32. mode fabricated: dir=0040755 else 0100644.
private void winSizeFromInfo(const pointer info, long out) {
    int hi = 0
    int lo = 0
    fly.llvm.ptrReadInt(info, 28, hi)
    fly.llvm.ptrReadInt(info, 32, lo)
    long hiL = hi & 4294967295
    long loL = lo & 4294967295
    out = (hiL << 32) | loL
}
public void fs_size(const pointer path, long out) {
    pointer info = 0
    fly.runtime.malloc(40, info)
    int ok = 0
    fly.runtime.GetFileAttributesExA(path, 0, info, ok)
    if ok == 0 { out = 0 - 1 } else { winSizeFromInfo(info, out) }
    fly.runtime.free(info)
}
public void fs_mode(const pointer path, int out) {
    pointer info = 0
    fly.runtime.malloc(40, info)
    int ok = 0
    fly.runtime.GetFileAttributesExA(path, 0, info, ok)
    if ok == 0 { out = 0 - 1 } else {
        int attr = 0
        fly.llvm.ptrReadInt(info, 0, attr)
        int isdir = attr & 16
        if isdir != 0 { out = 16877 } else { out = 33188 }         // 0040755 / 0100644
    }
    fly.runtime.free(info)
}
// l* variants use FindFirstFileA (does not follow symlinks). WIN32_FIND_DATAA:
// dwFileAttributes@0, nFileSizeHigh@28, nFileSizeLow@32; struct is 320 bytes.
public void fs_lsize(const pointer path, long out) {
    pointer ffd = 0
    fly.runtime.malloc(320, ffd)
    pointer h = 0
    fly.runtime.FindFirstFileA(path, ffd, h)
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1 } else {
        int rc = 0
        fly.runtime.FindClose(h, rc)
        winSizeFromInfo(ffd, out)
    }
    fly.runtime.free(ffd)
}
public void fs_lmode(const pointer path, int out) {
    pointer ffd = 0
    fly.runtime.malloc(320, ffd)
    pointer h = 0
    fly.runtime.FindFirstFileA(path, ffd, h)
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1 } else {
        int rc = 0
        fly.runtime.FindClose(h, rc)
        int attr = 0
        fly.llvm.ptrReadInt(ffd, 0, attr)
        int isrep = attr & 1024
        int isdir = attr & 16
        if isrep != 0 { out = 41453 } else {                  // reparse → S_IFLNK 0120755
            if isdir != 0 { out = 16877 } else { out = 33188 }
        }
    }
    fly.runtime.free(ffd)
}
// mtime helpers — last-modification time as TOTAL NANOSECONDS since the Unix
// epoch in one i64 (sec = out/1e9, nsec = out%1e9; splitting is the caller's
// job so the primitive keeps a single out). Both info structs place
// ftLastWriteTime at offset 20 (dwLowDateTime@20, dwHighDateTime@24): FILETIME
// counts 100ns units since 1601-01-01; the 1601→1970 delta is 11644473600 s =
// 116444736000000000 units. -1 on a failed lookup.
private void winMtimeFromInfo(const pointer info, long out) {
    int lo = 0
    int hi = 0
    fly.llvm.ptrReadInt(info, 20, lo)
    fly.llvm.ptrReadInt(info, 24, hi)
    long hiL = hi & 4294967295
    long loL = lo & 4294967295
    long ft = (hiL << 32) | loL
    out = (ft - 116444736000000000) * 100
}
public void fs_mtime(const pointer path, long out) {
    pointer info = 0
    fly.runtime.malloc(40, info)
    int ok = 0
    fly.runtime.GetFileAttributesExA(path, 0, info, ok)
    if ok == 0 { out = 0 - 1 } else { winMtimeFromInfo(info, out) }
    fly.runtime.free(info)
}
public void fs_lmtime(const pointer path, long out) {
    pointer ffd = 0
    fly.runtime.malloc(320, ffd)
    pointer h = 0
    fly.runtime.FindFirstFileA(path, ffd, h)
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1 } else {
        int rc = 0
        fly.runtime.FindClose(h, rc)
        winMtimeFromInfo(ffd, out)
    }
    fly.runtime.free(ffd)
}
public void fs_mkdir(const pointer path, const int mode, int out) {
    int ok = 0
    fly.runtime.CreateDirectoryA(path, 0, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void fs_rmdir(const pointer path, int out) {
    int ok = 0
    fly.runtime.RemoveDirectoryA(path, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void fs_unlink(const pointer path, int out) {
    int ok = 0
    fly.runtime.DeleteFileA(path, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void fs_rename(const pointer src, const pointer dst, int out) {
    int ok = 0
    fly.runtime.MoveFileExA(src, dst, 1, ok)          // MOVEFILE_REPLACE_EXISTING
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void fs_fsync(const int fd, int out) {
    out = 0                                            // no-op (matches C)
}
public void fs_truncate(const pointer path, const long size, int out) {
    pointer h = 0
    fly.runtime.CreateFileA(path, 1073741824, 0, 0, 3, 128, 0, h)   // GENERIC_WRITE, OPEN_EXISTING, NORMAL
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1  return }
    int ok = 0
    fly.runtime.SetFilePointerEx(h, size, 0, 0, ok)   // FILE_BEGIN
    if ok != 0 {
        int ok2 = 0
        fly.runtime.SetEndOfFile(h, ok2)
        if ok2 != 0 { out = 0 } else { out = 0 - 1 }
    } else {
        out = 0 - 1
    }
    int rc = 0
    fly.runtime.CloseHandle(h, rc)
}
public void fs_chmod(const pointer path, const int mode, int out) {
    int attr = 128                                     // FILE_ATTRIBUTE_NORMAL
    int wbit = mode & 128
    if wbit == 0 { attr = 1 }                          // no write bit → READONLY
    int ok = 0
    fly.runtime.SetFileAttributesA(path, attr, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void fs_symlink(const pointer target, const pointer link, int out) {
    int ok = 0
    fly.runtime.CreateSymbolicLinkA(link, target, 2, ok)   // ALLOW_UNPRIVILEGED
    if ok != 0 { out = 0  return }
    fly.runtime.CreateSymbolicLinkA(link, target, 0, ok)
    if ok != 0 { out = 0 } else { out = 0 - 1 }
}
public void fs_readlink(const pointer path, const pointer buf, const ulong size, int out) {
    out = 0 - 1                                        // not implemented on Windows (matches C)
}
// Directory enumeration is UNSUPPORTED without static dir-fd state (see header).
public void fs_getdents(const int fd, const pointer buf, const ulong size, int out) {
    out = 0 - 1
}

// ── Directory enumeration (dir_open/dir_read/dir_close) ───────────────────────
// The int-fd + getdents protocol is POSIX-only; Windows enumerates via FindFirst/
// FindNextFile which need a 64-bit HANDLE + iteration state. Since Fly has no
// working static storage, the state lives in a malloc'd CONTEXT the handle points
// at (mirrors the pointer-handle API in RuntimeLinux.fly). Context layout:
//   @0  HANDLE h (8B, from FindFirstFileA)   @8  int hasPending (1 = @16 holds an
//   un-emitted entry)                        @16 WIN32_FIND_DATAA (320B; the entry)
// dir_read converts each pending WIN32_FIND_DATAA into a linux_dirent64 record the
// std `dirRead` already parses: d_reclen@16 (u16), d_type@18, d_name@19 (NUL-term).
// "." / ".." are emitted like any entry — the std layer skips them.
public void dir_open(const pointer path, pointer out) {
    ulong plen = 0
    fly.runtime.strlen(path, plen)
    int pl = 0
    fly.llvm.longToInt((long)plen, pl)
    pointer pat = 0                                     // pattern = path + "\*" + NUL
    fly.runtime.mem_alloc(pl + 3, pat)
    int k = 0
    while k < pl {
        byte b = 0
        fly.llvm.ptrByteAt(path, k, b)
        fly.llvm.ptrPokeByte(pat, k, b)
        k = k + 1
    }
    fly.llvm.ptrPokeByte(pat, pl, 92)                  // '\'
    fly.llvm.ptrPokeByte(pat, pl + 1, 42)              // '*'
    fly.llvm.ptrPokeByte(pat, pl + 2, 0)
    pointer ctx = 0
    fly.runtime.mem_alloc(340, ctx)
    pointer data = ctx + 16
    pointer h = 0
    fly.runtime.FindFirstFileA(pat, data, h)
    fly.runtime.free(pat)
    pointer inv = 0
    inv = inv - 1
    if h == inv { fly.runtime.mem_free(ctx, 340)  out = 0  return }
    fly.llvm.ptrPokeLong(ctx, 0, h)                    // store the HANDLE (pointer, no cast)
    fly.llvm.ptrPokeInt(ctx, 8, 1)                     // hasPending
    out = ctx
}
public void dir_read(const pointer ctx, const pointer buf, const ulong size, int out) {
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    int written = 0
    bool go = true
    while go {
        int hasPending = 0
        fly.llvm.ptrReadInt(ctx, 8, hasPending)
        if hasPending == 0 { go = false } else {
            pointer namePtr = ctx + 60                 // cFileName @ WIN32_FIND_DATAA+44
            ulong nlen = 0
            fly.runtime.strlen(namePtr, nlen)
            int name_len = 0
            fly.llvm.longToInt((long)nlen, name_len)
            int reclen = 19 + name_len + 1
            if written + reclen > szi { go = false } else {
                pointer rec = buf + written
                fly.llvm.ptrPokeLong(rec, 0, 0)        // d_ino
                fly.llvm.ptrPokeLong(rec, 8, 0)        // d_off
                int rlo = reclen & 255
                int rhi = reclen / 256
                fly.llvm.ptrPokeByte(rec, 16, (byte)rlo)   // d_reclen lo/hi (u16)
                fly.llvm.ptrPokeByte(rec, 17, (byte)rhi)
                int attr = 0
                fly.llvm.ptrReadInt(ctx, 16, attr)     // dwFileAttributes
                byte dt = 8                            // DT_REG
                int isdir = attr & 16
                if isdir != 0 { dt = 4 }               // DT_DIR
                fly.llvm.ptrPokeByte(rec, 18, dt)      // d_type
                int j = 0
                while j < name_len {
                    byte nb = 0
                    fly.llvm.ptrByteAt(namePtr, j, nb)
                    fly.llvm.ptrPokeByte(rec, 19 + j, nb)
                    j = j + 1
                }
                fly.llvm.ptrPokeByte(rec, 19 + name_len, 0)
                written = written + reclen
                long hl = 0                            // advance into the pending slot
                fly.llvm.ptrReadLong(ctx, 0, hl)
                pointer h = 0
                h = hl
                int nok = 0
                fly.runtime.FindNextFileA(h, namePtr - 44, nok)
                if nok == 0 { fly.llvm.ptrPokeInt(ctx, 8, 0) } else { fly.llvm.ptrPokeInt(ctx, 8, 1) }
            }
        }
    }
    out = written
}
public void dir_close(const pointer ctx) {
    long hl = 0
    fly.llvm.ptrReadLong(ctx, 0, hl)
    pointer h = 0
    h = hl
    int rc = 0
    fly.runtime.FindClose(h, rc)
    fly.runtime.mem_free(ctx, 340)
}

// ── Time — FILETIME / QueryPerformanceCounter ────────────────────────────────
// Windows FILETIME = 100-ns ticks since 1601; Unix epoch offset 116444736000000000.
public void time_now_ns(long out) {
    pointer ft = 0
    fly.runtime.malloc(8, ft)
    fly.runtime.GetSystemTimeAsFileTime(ft)
    long ticks = 0
    fly.llvm.ptrReadLong(ft, 0, ticks)
    long unixTicks = ticks - 116444736000000000
    out = unixTicks * 100
    fly.runtime.free(ft)
}
public void time_mono_ns(long out) {
    pointer cnt = 0
    pointer freq = 0
    fly.runtime.malloc(8, cnt)
    fly.runtime.malloc(8, freq)
    int a = 0
    int b = 0
    fly.runtime.QueryPerformanceCounter(cnt, a)
    fly.runtime.QueryPerformanceFrequency(freq, b)
    long c = 0
    long f = 0
    fly.llvm.ptrReadLong(cnt, 0, c)
    fly.llvm.ptrReadLong(freq, 0, f)
    // Split into whole seconds + remainder before scaling: `c * 1000000000 / f`
    // OVERFLOWS int64 once the QPC counter passes ~9.2e9 — about 15 minutes of
    // uptime at the usual 10 MHz frequency — and the wrapped result flips sign
    // roughly every 15 minutes after that. Here `q` is the uptime in seconds
    // (q * 1e9 stays well inside int64 for any plausible uptime) and `r` is below
    // f, so `r * 1e9` is bounded by f * 1e9.
    if f == 0 {
        out = 0 - 1
    } else {
        long q = c / f
        long r = c - q * f
        out = q * 1000000000 + r * 1000000000 / f
    }
    fly.runtime.free(cnt)
    fly.runtime.free(freq)
}
public void time_sleep(const long sec, const long nsec) {
    long ms = sec * 1000 + nsec / 1000000
    if ms < 0 { ms = 0 }
    int msi = 0
    fly.llvm.longToInt(ms, msi)
    fly.runtime.Sleep(msi)
}

// ── Environment ──────────────────────────────────────────────────────────────
private void toCStr(const string s, pointer out) {
    int n = 0
    fly.llvm.strSize(s, n)
    pointer src = 0
    fly.llvm.strGetPtr(s, src)
    pointer buf = 0
    fly.runtime.malloc(n + 1, buf)
    int i = 0
    while i < n {
        byte b = 0
        fly.llvm.ptrByteAt(src, i, b)
        fly.llvm.ptrPokeByte(buf, i, b)
        i = i + 1
    }
    byte z = 0
    fly.llvm.ptrPokeByte(buf, n, z)
    out = buf
}
private void copyCStr(const pointer src, const pointer dst, const ulong cap, int out) {
    long capL = 0
    fly.llvm.ulongToLong(cap, capL)
    int limit = 0
    long capm1 = capL - 1
    fly.llvm.longToInt(capm1, limit)
    int i = 0
    bool go = true
    while go {
        if i >= limit { go = false } else {
            byte b = 0
            fly.llvm.ptrByteAt(src, i, b)
            if b == 0 { go = false } else {
                fly.llvm.ptrPokeByte(dst, i, b)
                i = i + 1
            }
        }
    }
    fly.llvm.ptrPokeByte(dst, i, 0)
    out = i
}
public void env_chdir(const pointer path, int out) {
    int ok = 0
    fly.runtime.SetCurrentDirectoryA(path, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void env_set(const pointer key, const pointer val, int out) {
    int ok = 0
    fly.runtime.SetEnvironmentVariableA(key, val, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void env_delete(const pointer key, int out) {
    int ok = 0
    fly.runtime.SetEnvironmentVariableA(key, 0, ok)
    if ok == 0 { out = 0 - 1 } else { out = 0 }
}
public void env_getcwd(const pointer buf, const ulong cap, int out) {
    int capi = 0
    fly.llvm.longToInt((long)cap, capi)
    int r = 0
    fly.runtime.GetCurrentDirectoryA(capi, buf, r)
    if r > 0 { if r < capi { out = r } else { out = 0 - 1 } } else { out = 0 - 1 }
}
public void env_get(const pointer key, const pointer buf, const ulong size, int out) {
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    int r = 0
    fly.runtime.GetEnvironmentVariableA(key, buf, szi, r)
    if r > 0 { if r < szi { out = r } else { out = 0 - 1 } } else { out = 0 - 1 }
}
public void env_hostname(const pointer buf, const ulong size, int out) {
    pointer szp = 0
    fly.runtime.malloc(4, szp)
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    fly.llvm.ptrPokeInt(szp, 0, szi)
    int ok = 0
    fly.runtime.GetComputerNameA(buf, szp, ok)
    if ok == 0 { out = 0 - 1 } else { fly.llvm.ptrReadInt(szp, 0, out) }
    fly.runtime.free(szp)
}
public void env_arch(const pointer buf, const ulong size, int out) {
    pointer src = 0
    toCStr("x86_64", src)
    copyCStr(src, buf, size, out)
    fly.runtime.free(src)
}
// kernel = "major.minor", kernelversion = build number — from ntdll's
// RtlGetVersion (GetVersion is compat-shimmed to 6.2/9200 on modern Windows).
//
// The decimal formatting is INLINE in both functions on purpose: under this
// module's flat C-ABI emission, an INTERNAL fly-to-fly call that follows a
// ptrPokeByte store is miscompiled away (probed 2026-07-23: `appendUint; poke
// '.'; appendUint` ran only the first call, while `appendUint; appendUint` ran
// both — pokeInt-then-call is fine, extern calls are fine). Keeping every store
// and digit loop in ONE frame sidesteps the whole class.
public void env_kernel(const pointer buf, const ulong size, int out) {
    pointer v3 = 0
    fly.runtime.malloc(12, v3)
    versionInfo(v3)
    int major = 0
    fly.llvm.ptrReadInt(v3, 0, major)
    int minor = 0
    fly.llvm.ptrReadInt(v3, 4, minor)
    fly.runtime.free(v3)
    pointer tmp = 0
    fly.runtime.malloc(16, tmp)
    int p = 0
    // major digits (reversed into tmp, copied back; always at least "0")
    int n = 0
    int x = major
    bool more = true
    while more {
        int q = x / 10
        int d = x - q * 10
        byte db = (byte)(48 + d)
        fly.llvm.ptrPokeByte(tmp, n, db)
        n = n + 1
        x = q
        if x <= 0 { more = false }
    }
    int i = n - 1
    while i >= 0 {
        byte b = 0
        fly.llvm.ptrReadByte(tmp, i, b)
        fly.llvm.ptrPokeByte(buf, p, b)
        p = p + 1
        i = i - 1
    }
    fly.llvm.ptrPokeByte(buf, p, (byte)46)             // '.'
    p = p + 1
    // minor digits
    n = 0
    x = minor
    more = true
    while more {
        int q2 = x / 10
        int d2 = x - q2 * 10
        byte db2 = (byte)(48 + d2)
        fly.llvm.ptrPokeByte(tmp, n, db2)
        n = n + 1
        x = q2
        if x <= 0 { more = false }
    }
    i = n - 1
    while i >= 0 {
        byte b2 = 0
        fly.llvm.ptrReadByte(tmp, i, b2)
        fly.llvm.ptrPokeByte(buf, p, b2)
        p = p + 1
        i = i - 1
    }
    fly.llvm.ptrPokeByte(buf, p, (byte)0)
    out = p
    fly.runtime.free(tmp)
}
public void env_kernelversion(const pointer buf, const ulong size, int out) {
    pointer v3 = 0
    fly.runtime.malloc(12, v3)
    versionInfo(v3)
    int build = 0
    fly.llvm.ptrReadInt(v3, 8, build)
    fly.runtime.free(v3)
    pointer tmp = 0
    fly.runtime.malloc(16, tmp)
    int p = 0
    int n = 0
    int x = build
    bool more = true
    while more {
        int q = x / 10
        int d = x - q * 10
        byte db = (byte)(48 + d)
        fly.llvm.ptrPokeByte(tmp, n, db)
        n = n + 1
        x = q
        if x <= 0 { more = false }
    }
    int i = n - 1
    while i >= 0 {
        byte b = 0
        fly.llvm.ptrReadByte(tmp, i, b)
        fly.llvm.ptrPokeByte(buf, p, b)
        p = p + 1
        i = i - 1
    }
    fly.llvm.ptrPokeByte(buf, p, (byte)0)
    out = p
    fly.runtime.free(tmp)
}
// versionInfo — the host version as [major@0, minor@4, build@8], written through
// `v3` (12 bytes). Queries ntdll's RtlGetVersion (RTL_OSVERSIONINFOW: size@0,
// major@4, minor@8, build@12, platform@16, WCHAR csd[128] — 276 bytes total);
// falls back to GetVersion's compat values when it fails. Write-through pointer
// on purpose: a non-const out param is not expressible in the fly.runtime
// calling convention (see scanToken).
private void versionInfo(const pointer v3) {
    pointer info = 0
    fly.runtime.malloc(276, info)
    zeroMem(info, 276)
    fly.llvm.ptrPokeInt(info, 0, 276)
    int st = 0
    fly.runtime.RtlGetVersion(info, st)
    if st == 0 {
        int ma = 0
        fly.llvm.ptrReadInt(info, 4, ma)
        int mi = 0
        fly.llvm.ptrReadInt(info, 8, mi)
        int bu = 0
        fly.llvm.ptrReadInt(info, 12, bu)
        fly.llvm.ptrPokeInt(v3, 0, ma)
        fly.llvm.ptrPokeInt(v3, 4, mi)
        fly.llvm.ptrPokeInt(v3, 8, bu)
    } else {
        int v = 0
        fly.runtime.GetVersion(v)
        int major = v & 255
        int sh = v >> 8
        int minor = sh & 255
        int sh2 = v >> 16
        int build = sh2 & 65535
        fly.llvm.ptrPokeInt(v3, 0, major)
        fly.llvm.ptrPokeInt(v3, 4, minor)
        fly.llvm.ptrPokeInt(v3, 8, build)
    }
    fly.runtime.free(info)
}
public void env_osname(const pointer buf, const ulong size, int out) {
    pointer src = 0
    toCStr("windows", src)
    copyCStr(src, buf, size, out)
    fly.runtime.free(src)
}
public void env_exe_path(const pointer buf, const ulong size, int out) {
    if size == 0 { out = 0 - 1  return }
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    int n = 0
    fly.runtime.GetModuleFileNameA(0, buf, szi, n)
    if n == 0 { out = 0 - 1  return }
    if n >= szi { out = 0 - 1  return }
    fly.llvm.ptrPokeByte(buf, n, 0)
    out = n
}
// env_all — from GetEnvironmentStringsA (KEY=VAL\0KEY=VAL\0\0). No globals.
public void env_all_count(int out) {
    pointer env = 0
    fly.runtime.GetEnvironmentStringsA(env)
    if env == 0 { out = 0  return }
    int n = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(env, i, b)
        if b == 0 {
            byte b2 = 0
            fly.llvm.ptrByteAt(env, i + 1, b2)
            if b2 == 0 { go = false } else { n = n + 1  i = i + 1 }
        } else {
            i = i + 1
        }
    }
    int rc = 0
    fly.runtime.FreeEnvironmentStringsA(env, rc)
    out = n
}
public void env_all_fill(const pointer arr_base, const int count) {
    pointer env = 0
    fly.runtime.GetEnvironmentStringsA(env)
    if env == 0 { return }
    int idx = 0
    int start = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(env, i, b)
        if b == 0 {
            if i == start {
                go = false                              // double NUL → end
            } else {
                if idx < count {
                    pointer entry = env + start
                    fillSlotFromCStr(arr_base, idx, entry)
                }
                idx = idx + 1
                start = i + 1
            }
        }
        i = i + 1
    }
    int rc = 0
    fly.runtime.FreeEnvironmentStringsA(env, rc)
}
// env_args — recovered from GetCommandLineA() (a function, no globals). Simple
// quote-aware split: "quoted spans" group spaces; otherwise whitespace-delimited.
public void env_args_count(int out) {
    pointer cl = 0
    fly.runtime.GetCommandLineA(cl)
    countArgs(cl, out)
}
public void env_args_fill(const pointer arr_base, const int count) {
    pointer cl = 0
    fly.runtime.GetCommandLineA(cl)
    // scanToken writes its 3 outputs [tokstart@0, toklen@4, nextpos@8] through this
    // scratch buffer — a fly.runtime function may return only ONE value (the C-ABI
    // convention: const params by value, first non-const → return), so a 3-out
    // signature would silently drop toklen/nextpos and loop forever.
    pointer tok = 0
    fly.runtime.malloc(12, tok)
    int idx = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(cl, i, b)
        if b == 0 { go = false } else {
            if b == 32 { i = i + 1 } else {
                scanToken(cl, i, tok)
                int tokstart = 0
                fly.llvm.ptrReadInt(tok, 0, tokstart)
                int toklen = 0
                fly.llvm.ptrReadInt(tok, 4, toklen)
                fly.llvm.ptrReadInt(tok, 8, i)          // nextpos
                if idx < count {
                    pointer tp = cl + tokstart
                    fillSlotLen(arr_base, idx, tp, toklen)
                }
                idx = idx + 1
            }
        }
    }
    fly.runtime.free(tok)
}
// countArgs / scanToken share the same simple tokenizer.
private void countArgs(const pointer cl, int out) {
    pointer tok = 0
    fly.runtime.malloc(12, tok)
    int n = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(cl, i, b)
        if b == 0 { go = false } else {
            if b == 32 { i = i + 1 } else {
                scanToken(cl, i, tok)
                fly.llvm.ptrReadInt(tok, 8, i)          // nextpos — MUST advance i
                n = n + 1
            }
        }
    }
    fly.runtime.free(tok)
    out = n
}
// scanToken — starting at `pos` (non-space), write the token bounds through `out3`:
// [tokstart@0, toklen@4, nextpos@8]. A leading '"' starts a quoted span. All params
// are const (out3 is written-through) so this stays a ZERO-return C-ABI function —
// a multi-out signature is not expressible in the fly.runtime calling convention.
private void scanToken(const pointer cl, const int pos, const pointer out3) {
    int tokstart = 0
    int toklen = 0
    int i = pos
    byte first = 0
    fly.llvm.ptrByteAt(cl, i, first)
    if first == 34 {                                    // '"'
        i = i + 1
        tokstart = i
        bool go = true
        while go {
            byte b = 0
            fly.llvm.ptrByteAt(cl, i, b)
            if b == 0 { go = false } elsif b == 34 { go = false } else { i = i + 1 }
        }
        toklen = i - tokstart
        byte c = 0
        fly.llvm.ptrByteAt(cl, i, c)
        if c == 34 { i = i + 1 }
    } else {
        tokstart = i
        bool go = true
        while go {
            byte b = 0
            fly.llvm.ptrByteAt(cl, i, b)
            if b == 0 { go = false } elsif b == 32 { go = false } else { i = i + 1 }
        }
        toklen = i - tokstart
    }
    fly.llvm.ptrPokeInt(out3, 0, tokstart)
    fly.llvm.ptrPokeInt(out3, 4, toklen)
    fly.llvm.ptrPokeInt(out3, 8, i)                     // nextpos
}
// env_init — accessors are stateless; kept as a defined no-op.
public void env_init(const int argc, const pointer argv) {
    int unused = argc
}

// fillSlotFromCStr — copy the NUL-terminated string at cstr into a slot.
private void fillSlotFromCStr(const pointer arr_base, const int idx, const pointer cstr) {
    ulong len = 0
    fly.runtime.strlen(cstr, len)
    int ilen = 0
    fly.llvm.longToInt((long)len, ilen)
    fillSlotLen(arr_base, idx, cstr, ilen)
}
// fillSlotLen — copy `len` bytes from src into a fresh buffer; write it as slot idx.
private void fillSlotLen(const pointer arr_base, const int idx, const pointer src, const int len) {
    pointer dst = 0
    fly.runtime.malloc(len + 1, dst)
    int j = 0
    while j < len {
        byte b = 0
        fly.llvm.ptrByteAt(src, j, b)
        fly.llvm.ptrPokeByte(dst, j, b)
        j = j + 1
    }
    fly.llvm.ptrPokeByte(dst, len, 0)
    fly.runtime.str_slot_set(arr_base, idx, dst, len)
}

// ── Process / concurrency ─────────────────────────────────────────────────────
public void proc_exec(const pointer path, const pointer argv, int out) {
    // Build:  "path" arg1 arg2 …   (arg0 quoted; rest space-separated, as in C)
    pointer cmd = 0
    fly.runtime.malloc(8192, cmd)
    int p = 0
    fly.llvm.ptrPokeByte(cmd, p, 34)  p = p + 1        // '"'
    // arg0 (exe): '/'→'\' normalised. Use a DISTINCT out var `aend` then `p = aend`
    // — reusing `p` as both the pos arg and the out arg (appendCStrPath(cmd,p,path,p))
    // makes the compiler cache `p` for the next statement BEFORE the out-param
    // update, so the closing quote lands at the stale offset and clobbers arg0.
    int aend = p
    appendCStrPath(cmd, p, path, aend)
    p = aend
    fly.llvm.ptrPokeByte(cmd, p, 34)  p = p + 1        // '"'
    int i = 1
    bool go = true
    while go {
        long a = 0
        fly.llvm.ptrReadLong(argv, i * 8, a)
        if a == 0 { go = false } else {
            fly.llvm.ptrPokeByte(cmd, p, 32)  p = p + 1
            int cend = p
            appendCStr(cmd, p, a, cend)
            p = cend
            i = i + 1
        }
    }
    fly.llvm.ptrPokeByte(cmd, p, 0)
    // STARTUPINFOA (~104 B) zeroed, cb set; PROCESS_INFORMATION (24 B) zeroed.
    pointer si = 0
    fly.runtime.malloc(104, si)
    zeroMem(si, 104)
    fly.llvm.ptrPokeInt(si, 0, 104)                    // si.cb
    pointer pi = 0
    fly.runtime.malloc(24, pi)
    zeroMem(pi, 24)
    int ok = 0
    fly.runtime.CreateProcessA(0, cmd, 0, 0, 1, 0, 0, 0, si, pi, ok)
    if ok == 0 { out = 0 - 1  fly.runtime.free(cmd)  fly.runtime.free(si)  fly.runtime.free(pi)  return }
    pointer hProc = 0
    long hpL = 0
    fly.llvm.ptrReadLong(pi, 0, hpL)                   // pi.hProcess @ 0
    hProc = hpL
    int w = 0
    fly.runtime.WaitForSingleObject(hProc, 0 - 1, w)
    pointer codep = 0
    fly.runtime.malloc(4, codep)
    int gc = 0
    fly.runtime.GetExitCodeProcess(hProc, codep, gc)
    fly.llvm.ptrReadInt(codep, 0, out)
    long htL = 0
    fly.llvm.ptrReadLong(pi, 8, htL)                   // pi.hThread @ 8
    int rc1 = 0
    int rc2 = 0
    fly.runtime.CloseHandle(htL, rc1)
    fly.runtime.CloseHandle(hProc, rc2)
    fly.runtime.free(cmd)
    fly.runtime.free(si)
    fly.runtime.free(pi)
    fly.runtime.free(codep)
}
// proc_exec_redirect — proc_exec with the child's STDOUT redirected to outPath
// (created/truncated), so a caller can capture a command's output with NO SHELL
// involved. Returns the child exit code, or -1 on failure.
//
// This primitive is the reason command capture works on Windows at all: the
// previous approach ran `sh -c "cmd > file"`, and there is no /bin/sh here — the
// path normalisation below turns arg0 '/'→'\', so it became a nonexistent
// `\bin\sh`. Every capture call site was therefore dead code on Windows.
//
// STDERR AND STDIN ARE INHERITED from this process, deliberately: a failing
// command's diagnostics should reach the user. STARTF_USESTDHANDLES makes all
// THREE handles mandatory, so the other two come from GetStdHandle.
//
// Two byte-laid structs, both easy to get wrong:
//   SECURITY_ATTRIBUTES (24 B): nLength u32@0, lpSecurityDescriptor ptr@8,
//                               bInheritHandle i32@16
//     — bInheritHandle MUST be TRUE, or CreateProcessA's bInheritHandles has
//       nothing inheritable to pass on and the child writes nowhere.
//   STARTUPINFOA (104 B): cb u32@0, dwFlags u32@60, hStdInput ptr@80,
//                         hStdOutput ptr@88, hStdError ptr@96
public void proc_exec_redirect(const pointer path, const pointer argv, const pointer outPath, int out) {
    // Same command-line assembly as proc_exec: arg0 quoted with '/'→'\', the
    // rest space-separated. `aend`/`cend` are DISTINCT out vars because reusing
    // the position variable as both in-arg and out-arg makes the compiler cache
    // the stale value (see the note in proc_exec).
    pointer cmd = 0
    fly.runtime.malloc(8192, cmd)
    int p = 0
    fly.llvm.ptrPokeByte(cmd, p, 34)  p = p + 1
    int aend = p
    appendCStrPath(cmd, p, path, aend)
    p = aend
    fly.llvm.ptrPokeByte(cmd, p, 34)  p = p + 1
    int i = 1
    bool go = true
    while go {
        long a = 0
        fly.llvm.ptrReadLong(argv, i * 8, a)
        if a == 0 { go = false } else {
            fly.llvm.ptrPokeByte(cmd, p, 32)  p = p + 1
            int cend = p
            appendCStr(cmd, p, a, cend)
            p = cend
            i = i + 1
        }
    }
    fly.llvm.ptrPokeByte(cmd, p, 0)

    // An INHERITABLE handle on the output file.
    pointer sa = 0
    fly.runtime.malloc(24, sa)
    zeroMem(sa, 24)
    fly.llvm.ptrPokeInt(sa, 0, 24)                     // nLength
    fly.llvm.ptrPokeInt(sa, 16, 1)                     // bInheritHandle = TRUE
    pointer hOut = 0
    // GENERIC_WRITE = 1073741824, CREATE_ALWAYS = 2, FILE_ATTRIBUTE_NORMAL = 128
    fly.runtime.CreateFileA(outPath, 1073741824, 0, sa, 2, 128, 0, hOut)
    if hOut == 0 - 1 {
        fly.runtime.free(cmd)
        fly.runtime.free(sa)
        out = 0 - 1
        return
    }

    pointer hIn = 0
    fly.runtime.GetStdHandle(0 - 10, hIn)              // STD_INPUT_HANDLE
    pointer hErr = 0
    fly.runtime.GetStdHandle(0 - 12, hErr)             // STD_ERROR_HANDLE

    pointer si = 0
    fly.runtime.malloc(104, si)
    zeroMem(si, 104)
    fly.llvm.ptrPokeInt(si, 0, 104)                    // si.cb
    fly.llvm.ptrPokeInt(si, 60, 256)                   // dwFlags = STARTF_USESTDHANDLES
    fly.llvm.ptrPokeLong(si, 80, hIn)
    fly.llvm.ptrPokeLong(si, 88, hOut)
    fly.llvm.ptrPokeLong(si, 96, hErr)
    pointer pi = 0
    fly.runtime.malloc(24, pi)
    zeroMem(pi, 24)
    int ok = 0
    fly.runtime.CreateProcessA(0, cmd, 0, 0, 1, 0, 0, 0, si, pi, ok)
    int chc = 0
    fly.runtime.CloseHandle(hOut, chc)                 // the child owns its copy
    if ok == 0 {
        fly.runtime.free(cmd)
        fly.runtime.free(sa)
        fly.runtime.free(si)
        fly.runtime.free(pi)
        out = 0 - 1
        return
    }
    long hpL = 0
    fly.llvm.ptrReadLong(pi, 0, hpL)
    pointer hProc = 0
    hProc = hpL
    int w = 0
    fly.runtime.WaitForSingleObject(hProc, 0 - 1, w)
    pointer codep = 0
    fly.runtime.malloc(4, codep)
    int gc = 0
    fly.runtime.GetExitCodeProcess(hProc, codep, gc)
    fly.llvm.ptrReadInt(codep, 0, out)
    long htL = 0
    fly.llvm.ptrReadLong(pi, 8, htL)
    int rc1 = 0
    int rc2 = 0
    fly.runtime.CloseHandle(htL, rc1)
    fly.runtime.CloseHandle(hProc, rc2)
    fly.runtime.free(cmd)
    fly.runtime.free(sa)
    fly.runtime.free(si)
    fly.runtime.free(pi)
    fly.runtime.free(codep)
}

private void zeroMem(const pointer p, const int n) {
    int i = 0
    while i < n { fly.llvm.ptrPokeByte(p, i, 0)  i = i + 1 }
}
private void appendCStr(const pointer buf, const int pos, const pointer src, int nextpos) {
    int p = pos
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(src, i, b)
        if b == 0 { go = false } else {
            fly.llvm.ptrPokeByte(buf, p, b)
            p = p + 1
            i = i + 1
        }
    }
    nextpos = p
}
// appendCStrPath — like appendCStr but normalises '/' → '\' while copying. Used for
// the executable path (arg0): CreateProcessA fails to resolve an app path that
// mixes separators (fly.os.path.join emits '/', exePath yields '\'), so the exe
// must be pure-backslash. Args keep '/' (the linker accepts either).
private void appendCStrPath(const pointer buf, const int pos, const pointer src, int nextpos) {
    int p = pos
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(src, i, b)
        if b == 0 { go = false } else {
            if b == 47 { b = 92 }                       // '/' → '\'
            fly.llvm.ptrPokeByte(buf, p, b)
            p = p + 1
            i = i + 1
        }
    }
    nextpos = p
}
public void thread_spawn(const pointer fn, const pointer arg, const ulong stackSize, int out) {
    pointer tidp = 0
    fly.runtime.malloc(4, tidp)
    pointer h = 0
    fly.runtime.CreateThread(0, stackSize, fn, arg, 0, tidp, h)
    if h == 0 {
        out = 0 - 1
    } else {
        int rc = 0
        fly.runtime.CloseHandle(h, rc)
        fly.llvm.ptrReadInt(tidp, 0, out)
    }
    fly.runtime.free(tidp)
}
// futex via WaitOnAddress / WakeByAddress.
public void futex_wait(const pointer addr, const int expected) {
    pointer cmp = 0
    fly.runtime.malloc(4, cmp)
    fly.llvm.ptrPokeInt(cmp, 0, expected)
    int r = 0
    fly.runtime.WaitOnAddress(addr, cmp, 4, 0 - 1, r)   // INFINITE
    fly.runtime.free(cmp)
}
public void futex_wake(const pointer addr, const int count, int out) {
    if count == 1 {
        fly.runtime.WakeByAddressSingle(addr)
        out = 1
    } else {
        fly.runtime.WakeByAddressAll(addr)
        out = count
    }
}
public void atomic_load_i32(const pointer addr, int out) {
    fly.runtime.__atomic_load_4(addr, 2, out)
}
public void atomic_store_i32(const pointer addr, const int val) {
    fly.runtime.__atomic_store_4(addr, val, 3)
}
public void atomic_cas_i32(const pointer addr, const int expected, const int desired, int out) {
    pointer exp = 0
    fly.runtime.malloc(4, exp)
    fly.llvm.ptrPokeInt(exp, 0, expected)
    bool ok = false
    fly.runtime.__atomic_compare_exchange_4(addr, exp, desired, 0, 4, 2, ok)
    fly.llvm.ptrReadInt(exp, 0, out)
    fly.runtime.free(exp)
}
public void atomic_fetch_add_i32(const pointer addr, const int delta, int out) {
    fly.runtime.__atomic_fetch_add_4(addr, delta, 4, out)
}

// ── Networking — IPv4 TCP over Winsock ────────────────────────────────────────
//
// Same contract as the POSIX backends (see RuntimeLinux.fly): a socket handle is
// a `long` and NEGATIVE means invalid, an address is a packed host-order int, and
// the sockaddr_in is poked byte-wise so no htons/inet_addr is needed. Here the
// sentinel is free: INVALID_SOCKET is (SOCKET)~0, which read as a signed 64-bit
// value IS -1.
//
// WSAStartup has to run before any other Winsock call, and Fly has no working
// global storage (see the file header), so there is nowhere to keep an
// "already initialised" flag. It is therefore INLINED at the top of the only two
// primitives that can be first — net_socket and net_resolve4. Winsock's init is
// reference-counted and idempotent, so the repeat calls are cheap increments;
// WSACleanup is deliberately never called (process teardown reclaims).
// The block is inlined rather than factored into a helper for the same reason the
// sockaddr builders are: an internal fly→fly call following a store is
// miscompiled away under flat C-ABI emission.
//
// SO_REUSEADDR is NOT set here. On Windows it permits port hijacking rather than
// TIME_WAIT relief — a different security model — and nothing in scope needs it,
// so net_reuseaddr is a documented no-op that reports success.

// net_init — run WSAStartup so a caller can fail early. 0 ok, -1 error.
public void net_init(int out) {
    pointer wsa = 0
    fly.runtime.malloc(512, wsa)                    // WSADATA is ~408 bytes; never read
    int rc = 0
    fly.runtime.WSAStartup(514, wsa, rc)            // MAKEWORD(2,2)
    fly.runtime.free(wsa)
    if rc != 0 { out = 0 - 1 } else { out = 0 }
}

// net_socket — a blocking IPv4 TCP socket; <0 on failure.
public void net_socket(long out) {
    pointer wsa = 0
    fly.runtime.malloc(512, wsa)
    int wrc = 0
    fly.runtime.WSAStartup(514, wsa, wrc)
    fly.runtime.free(wsa)
    long s = 0
    fly.runtime.socket(2, 1, 6, s)                  // AF_INET, SOCK_STREAM, IPPROTO_TCP
    if s < 0 { out = 0 - 1  return }
    out = s
}

public void net_close(const long s) {
    if s < 0 { return }
    int rc = 0
    fly.runtime.closesocket(s, rc)
}

public void net_shutdown(const long s, const int how, int out) {
    if s < 0 { out = 0 - 1  return }
    int rc = 0
    fly.runtime.shutdown(s, how, rc)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_reuseaddr — NO-OP on Windows, reporting success. See the note above.
public void net_reuseaddr(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    out = 0
}

// ── Socket options ────────────────────────────────────────────────────────────
//
// Winsock uses the BSD numbering (shared with macOS, NOT with Linux):
//   SOL_SOCKET=65535  SO_KEEPALIVE=8  SO_BROADCAST=32  SO_LINGER=128
//   SO_SNDBUF=4097    SO_RCVBUF=4098  SO_SNDTIMEO=4101 SO_RCVTIMEO=4102
//   SO_ERROR=4103.    IPPROTO_TCP=6 / TCP_NODELAY=1 agree everywhere.
//
// Two payloads genuinely differ from POSIX here:
//   • the timeouts take a bare DWORD of MILLISECONDS, not a `struct timeval`;
//   • LINGER is two u_shorts (4 bytes), where POSIX uses two ints (8 bytes).
// Getting either wrong is silently accepted by the kernel and then misbehaves.

private void setIntOpt(const long s, const int level, const int opt, const int val, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer p = 0
    fly.runtime.malloc(4, p)
    fly.llvm.ptrPokeInt(p, 0, val)
    int rc = 0
    fly.runtime.setsockopt(s, level, opt, p, 4, rc)
    fly.runtime.free(p)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

public void net_set_nodelay(const long s, const int on, int out) {
    setIntOpt(s, 6, 1, on, out)
}
public void net_set_keepalive(const long s, const int on, int out) {
    setIntOpt(s, 65535, 8, on, out)
}
public void net_set_broadcast(const long s, const int on, int out) {
    setIntOpt(s, 65535, 32, on, out)
}
public void net_set_recvbuf(const long s, const int bytes, int out) {
    setIntOpt(s, 65535, 4098, bytes, out)
}
public void net_set_sendbuf(const long s, const int bytes, int out) {
    setIntOpt(s, 65535, 4097, bytes, out)
}

// The timeouts are a plain DWORD of milliseconds — the same int the Fly API
// already speaks, so no struct at all.
public void net_set_recv_timeout(const long s, const int ms, int out) {
    int msec = ms
    if msec < 0 { msec = 0 }
    setIntOpt(s, 65535, 4102, msec, out)            // SO_RCVTIMEO
}
public void net_set_send_timeout(const long s, const int ms, int out) {
    int msec = ms
    if msec < 0 { msec = 0 }
    setIntOpt(s, 65535, 4101, msec, out)            // SO_SNDTIMEO
}

// net_set_linger — Winsock's LINGER is { u_short l_onoff; u_short l_linger },
// four bytes, NOT the eight-byte two-int POSIX struct.
public void net_set_linger(const long s, const int on, const int sec, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer lg = 0
    fly.runtime.malloc(4, lg)
    fly.llvm.ptrPokeShort(lg, 0, (short)(on & 65535))
    fly.llvm.ptrPokeShort(lg, 2, (short)(sec & 65535))
    int rc = 0
    fly.runtime.setsockopt(s, 65535, 128, lg, 4, rc)     // SOL_SOCKET, SO_LINGER
    fly.runtime.free(lg)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_set_nonblocking — ioctlsocket(FIONBIO). FIONBIO is 0x8004667E, which
// exceeds 2^31; Fly has no hex literals and a decimal above 2^31 is typed long,
// so it is written as the equivalent NEGATIVE signed int.
public void net_set_nonblocking(const long s, const int on, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer mode = 0
    fly.runtime.malloc(4, mode)
    fly.llvm.ptrPokeInt(mode, 0, on)
    int rc = 0
    fly.runtime.ioctlsocket(s, 0 - 2147195266, mode, rc)     // FIONBIO
    fly.runtime.free(mode)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

public void net_sock_error(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer v = 0
    fly.runtime.malloc(4, v)
    pointer vlen = 0
    fly.runtime.malloc(4, vlen)
    fly.llvm.ptrPokeInt(vlen, 0, 4)
    fly.llvm.ptrPokeInt(v, 0, 0)
    int rc = 0
    fly.runtime.getsockopt(s, 65535, 4103, v, vlen, rc)      // SOL_SOCKET, SO_ERROR
    int val = 0
    fly.llvm.ptrReadInt(v, 0, val)
    fly.runtime.free(v)
    fly.runtime.free(vlen)
    if rc < 0 { out = 0 - 1 } else { out = val }
}

public void net_bind(const long s, const int addr, const int port, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    int z = 0
    while z < 16 {
        fly.llvm.ptrPokeByte(sa, z, 0)
        z = z + 1
    }
    fly.llvm.ptrPokeByte(sa, 0, 2)                  // AF_INET, low byte
    fly.llvm.ptrPokeByte(sa, 2, (byte)((port >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 3, (byte)(port & 255))
    fly.llvm.ptrPokeByte(sa, 4, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(sa, 5, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(sa, 6, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 7, (byte)(addr & 255))
    int rc = 0
    fly.runtime.bind(s, sa, 16, rc)
    fly.runtime.free(sa)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

public void net_listen(const long s, const int backlog, int out) {
    if s < 0 { out = 0 - 1  return }
    int rc = 0
    fly.runtime.listen(s, backlog, rc)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

public void net_accept(const long s, long out) {
    if s < 0 { out = 0 - 1  return }
    long c = 0
    fly.runtime.accept(s, 0, 0, c)
    if c < 0 { out = 0 - 1  return }
    out = c
}

public void net_connect(const long s, const int addr, const int port, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    int z = 0
    while z < 16 {
        fly.llvm.ptrPokeByte(sa, z, 0)
        z = z + 1
    }
    fly.llvm.ptrPokeByte(sa, 0, 2)                  // AF_INET, low byte
    fly.llvm.ptrPokeByte(sa, 2, (byte)((port >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 3, (byte)(port & 255))
    fly.llvm.ptrPokeByte(sa, 4, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(sa, 5, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(sa, 6, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 7, (byte)(addr & 255))
    int rc = 0
    fly.runtime.connect(s, sa, 16, rc)
    fly.runtime.free(sa)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_send — ONE send attempt; may write LESS than n. <0 on error. Winsock takes
// and returns an int length, so the count is widened here.
public void net_send(const long s, const pointer buf, const int n, long out) {
    if s < 0 { out = 0 - 1  return }
    int sent = 0
    fly.runtime.send(s, buf, n, 0, sent)
    out = sent
}

// net_recv — ONE blocking receive of up to n bytes. >0 = bytes, 0 = orderly peer
// shutdown (EOF), <0 = error.
public void net_recv(const long s, const pointer buf, const int n, long out) {
    if s < 0 { out = 0 - 1  return }
    int got = 0
    fly.runtime.recv(s, buf, n, 0, got)
    out = got
}

public void net_local_port(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int rc = 0
    fly.runtime.getsockname(s, sa, alen, rc)
    if rc < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = 0 - 1
        return
    }
    byte hi = 0
    byte lo = 0
    fly.llvm.ptrByteAt(sa, 2, hi)
    fly.llvm.ptrByteAt(sa, 3, lo)
    int h = hi & 255
    int l = lo & 255
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = (h << 8) | l
}

// ── UDP datagrams ─────────────────────────────────────────────────────────────
//
// SOCK_DGRAM=2 and IPPROTO_UDP=17, same as POSIX. Winsock takes and returns int
// lengths, so the counts are widened here; the sender is reported through the
// caller's 8-byte scratch ([0..3] packed address, [4..7] port).

// net_socket_udp — a blocking IPv4 UDP socket; <0 on failure. Performs the
// (idempotent) Winsock startup, like net_socket.
public void net_socket_udp(long out) {
    pointer wsa = 0
    fly.runtime.malloc(512, wsa)
    int wrc = 0
    fly.runtime.WSAStartup(514, wsa, wrc)
    fly.runtime.free(wsa)
    long s = 0
    fly.runtime.socket(2, 2, 17, s)                 // AF_INET, SOCK_DGRAM, IPPROTO_UDP
    if s < 0 { out = 0 - 1  return }
    out = s
}

// net_send_to — one datagram to addr:port; bytes accepted, <0 on error. A
// datagram is sent whole or not at all, so there is no short write to loop over.
public void net_send_to(const long s, const pointer buf, const int n, const int addr, const int port, long out) {
    if s < 0 { out = 0 - 1  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    int z = 0
    while z < 16 {
        fly.llvm.ptrPokeByte(sa, z, 0)
        z = z + 1
    }
    fly.llvm.ptrPokeByte(sa, 0, 2)                  // AF_INET, low byte
    fly.llvm.ptrPokeByte(sa, 2, (byte)((port >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 3, (byte)(port & 255))
    fly.llvm.ptrPokeByte(sa, 4, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(sa, 5, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(sa, 6, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 7, (byte)(addr & 255))
    int sent = 0
    fly.runtime.sendto(s, buf, n, 0, sa, 16, sent)
    fly.runtime.free(sa)
    out = sent
}

// net_recv_from — one datagram of up to n bytes, sender written into the 8-byte
// `from` scratch. 0 is a legal EMPTY datagram, not end-of-stream; <0 is an error
// or a receive timeout. A longer datagram is TRUNCATED — UDP semantics.
public void net_recv_from(const long s, const pointer buf, const int n, const pointer from, long out) {
    if s < 0 { out = 0 - 1  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int got = 0
    fly.runtime.recvfrom(s, buf, n, 0, sa, alen, got)
    if got < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = got
        return
    }
    byte b0 = 0
    byte b1 = 0
    byte b2 = 0
    byte b3 = 0
    byte ph = 0
    byte pl = 0
    fly.llvm.ptrByteAt(sa, 4, b0)
    fly.llvm.ptrByteAt(sa, 5, b1)
    fly.llvm.ptrByteAt(sa, 6, b2)
    fly.llvm.ptrByteAt(sa, 7, b3)
    fly.llvm.ptrByteAt(sa, 2, ph)
    fly.llvm.ptrByteAt(sa, 3, pl)
    int i0 = b0 & 255
    int i1 = b1 & 255
    int i2 = b2 & 255
    int i3 = b3 & 255
    int hp = ph & 255
    int lp = pl & 255
    fly.llvm.ptrPokeInt(from, 0, (i0 << 24) | (i1 << 16) | (i2 << 8) | i3)
    fly.llvm.ptrPokeInt(from, 4, (hp << 8) | lp)
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = got
}

// ── HTTPS via WinHTTP ─────────────────────────────────────────────────────────
//
// Windows has no generic TLS socket backend (fly.net.tls reports unavailable
// here), so https is served by WinHTTP instead: a complete HTTP client rather
// than a transport. That is a real limitation and the API says so — WinHTTP
// cannot back tlsSend/tlsRecv, only whole request/response exchanges. What it
// buys is https on Windows for ~200 lines and no new dependency, since
// libwinhttp is already in the bundled mingw sysroot.
//
// The response BODY goes to a FILE rather than a returned buffer: a primitive has
// exactly one `out` (used by the status code), and handing a heap buffer back
// across the boundary would need an ownership contract. The same file-handoff
// pattern proc_exec_redirect already uses.
//
// WinHTTP is W-only (there is no WinHttpOpenA), so every string is widened to
// UTF-16LE first. ASCII-only is fine for hosts, paths and header names —
// internationalised domains are the caller's problem (punycode).

// wideOf — ASCII C string → a freshly allocated UTF-16LE C string. Returns 0 for
// a null input. Two bytes per character plus a two-byte terminator.
private void wideOf(const pointer s, pointer out) {
    if s == 0 { out = 0  return }
    ulong lenU = 0
    fly.runtime.strlen(s, lenU)
    int n = 0
    fly.llvm.longToInt((long)lenU, n)
    pointer w = 0
    fly.runtime.malloc(n * 2 + 2, w)
    int i = 0
    while i < n {
        byte b = 0
        fly.llvm.ptrByteAt(s, i, b)
        fly.llvm.ptrPokeByte(w, i * 2, b)
        fly.llvm.ptrPokeByte(w, i * 2 + 1, 0)
        i = i + 1
    }
    fly.llvm.ptrPokeByte(w, n * 2, 0)
    fly.llvm.ptrPokeByte(w, n * 2 + 1, 0)
    out = w
}

// net_https_available — 1 here: WinHTTP is always present on Windows.
public void net_https_available(int out) {
    out = 1
}

// net_https_request — one complete HTTPS exchange. `headers` is an ASCII string of
// CRLF-separated "Name: Value" lines ("" for none); `bodyIn`/`bodyInLen` is the
// request body (0/0 for none); the response body is written to `outPath`.
// Returns the HTTP status code, or -1 when the exchange could not be completed.
public void net_https_request(const pointer verb, const pointer host, const int port,
                             const pointer path, const pointer headers,
                             const pointer bodyIn, const int bodyInLen,
                             const pointer outPath, int out) {
    // Every widening happens FIRST, so that no store in this frame precedes an
    // internal call — the poke-then-fly-call miscompile only bites in that order.
    pointer wVerb = 0
    wideOf(verb, wVerb)
    pointer wHost = 0
    wideOf(host, wHost)
    pointer wPath = 0
    wideOf(path, wPath)
    pointer wHdrs = 0
    wideOf(headers, wHdrs)
    pointer wAgent = 0
    wideOf(0, wAgent)                                  // NULL agent → WinHTTP default

    pointer session = 0
    fly.runtime.WinHttpOpen(0, 0, 0, 0, 0, session)     // ACCESS_TYPE_DEFAULT_PROXY
    if session == 0 { out = 0 - 1  return }
    pointer conn = 0
    fly.runtime.WinHttpConnect(session, wHost, port, 0, conn)
    if conn == 0 {
        int c1 = 0
        fly.runtime.WinHttpCloseHandle(session, c1)
        out = 0 - 1
        return
    }
    // WINHTTP_FLAG_SECURE = 0x00800000 = 8388608 — this is what makes it TLS.
    pointer req = 0
    fly.runtime.WinHttpOpenRequest(conn, wVerb, wPath, 0, 0, 0, 8388608, req)
    if req == 0 {
        int c1 = 0
        int c2 = 0
        fly.runtime.WinHttpCloseHandle(conn, c1)
        fly.runtime.WinHttpCloseHandle(session, c2)
        out = 0 - 1
        return
    }
    // headersLen -1 means "the wide string is NUL-terminated".
    int hlen = 0
    if wHdrs == 0 { hlen = 0 } else { hlen = 0 - 1 }
    int sent = 0
    fly.runtime.WinHttpSendRequest(req, wHdrs, hlen, bodyIn, bodyInLen, bodyInLen, 0, sent)
    if sent == 0 {
        int c1 = 0
        int c2 = 0
        int c3 = 0
        fly.runtime.WinHttpCloseHandle(req, c1)
        fly.runtime.WinHttpCloseHandle(conn, c2)
        fly.runtime.WinHttpCloseHandle(session, c3)
        out = 0 - 1
        return
    }
    int recvd = 0
    fly.runtime.WinHttpReceiveResponse(req, 0, recvd)
    if recvd == 0 {
        int c1 = 0
        int c2 = 0
        int c3 = 0
        fly.runtime.WinHttpCloseHandle(req, c1)
        fly.runtime.WinHttpCloseHandle(conn, c2)
        fly.runtime.WinHttpCloseHandle(session, c3)
        out = 0 - 1
        return
    }
    // Status code as a NUMBER: WINHTTP_QUERY_STATUS_CODE (19) OR'd with
    // WINHTTP_QUERY_FLAG_NUMBER (0x20000000) → 536870931. Without the flag the
    // status comes back as text.
    pointer stBuf = 0
    fly.runtime.malloc(4, stBuf)
    fly.llvm.ptrPokeInt(stBuf, 0, 0)
    pointer stLen = 0
    fly.runtime.malloc(4, stLen)
    fly.llvm.ptrPokeInt(stLen, 0, 4)
    int qok = 0
    fly.runtime.WinHttpQueryHeaders(req, 536870931, 0, stBuf, stLen, 0, qok)
    int status = 0 - 1
    if qok != 0 { fly.llvm.ptrReadInt(stBuf, 0, status) }

    // Drain the body into outPath.
    pointer hFile = 0
    fly.runtime.CreateFileA(outPath, 1073741824, 0, 0, 2, 128, 0, hFile)
    if hFile != 0 - 1 {
        pointer buf = 0
        fly.runtime.malloc(8192, buf)
        pointer nRead = 0
        fly.runtime.malloc(4, nRead)
        pointer nWrote = 0
        fly.runtime.malloc(4, nWrote)
        bool go = true
        while go {
            fly.llvm.ptrPokeInt(nRead, 0, 0)
            int rok = 0
            fly.runtime.WinHttpReadData(req, buf, 8192, nRead, rok)
            int got = 0
            fly.llvm.ptrReadInt(nRead, 0, got)
            if rok == 0 || got <= 0 { go = false } else {
                int wok = 0
                fly.runtime.WriteFile(hFile, buf, got, nWrote, 0, wok)
            }
        }
        int ch = 0
        fly.runtime.CloseHandle(hFile, ch)
        fly.runtime.free(buf)
        fly.runtime.free(nRead)
        fly.runtime.free(nWrote)
    }

    int c1 = 0
    int c2 = 0
    int c3 = 0
    fly.runtime.WinHttpCloseHandle(req, c1)
    fly.runtime.WinHttpCloseHandle(conn, c2)
    fly.runtime.WinHttpCloseHandle(session, c3)
    fly.runtime.free(stBuf)
    fly.runtime.free(stLen)
    out = status
}

// ── Multiplexing, peer address and full DNS ──────────────────────────────────
//
// net_poll takes OUR OWN entry array — 16 bytes per entry, identical on every
// platform — and translates it into the native one. Windows is where that
// indirection earns its keep, because BOTH the layout and the bits differ from
// POSIX:
//
//   Fly entry   (16 B): [0..7] long socket  [8..11] int events  [12..15] int revents
//   WSAPOLLFD   (16 B): SOCKET fd@0 (EIGHT bytes), SHORT events@8, SHORT revents@10
//   POSIX pollfd (8 B): int fd@0, short events@4, short revents@6
//
//   Windows bits: POLLERR=1 POLLHUP=2 POLLNVAL=4 POLLWRNORM=16
//                 POLLRDNORM=256 POLLRDBAND=512
//   POSIX bits:   POLLIN=1 POLLOUT=4 POLLERR=8 POLLHUP=16 POLLNVAL=32
//
// WSAPoll also only accepts POLLRDNORM/POLLRDBAND/POLLWRNORM as INPUT events —
// passing POLLERR/POLLHUP there is an error — so the Fly-level err/hup bits are
// deliberately dropped on the way in and only read on the way out.
//
// Known Winsock defect, worth stating: WSAPoll does not report a FAILED
// non-blocking connect (it never sets POLLERR for that case), so a caller
// waiting for connect completion must check net_sock_error itself.
public void net_poll(const pointer entries, const int count, const int timeoutMs, int out) {
    if count <= 0 { out = 0  return }
    pointer fds = 0
    fly.runtime.malloc(count * 16, fds)
    int i = 0
    while i < count {
        long sv = 0
        fly.llvm.ptrReadLong(entries, i * 16, sv)
        int ev = 0
        fly.llvm.ptrReadInt(entries, i * 16 + 8, ev)
        int nev = 0
        int rd = ev & 1
        int wr = ev & 2
        if rd != 0 { nev = nev | 256 }               // POLLRDNORM
        if wr != 0 { nev = nev | 16 }                // POLLWRNORM
        fly.llvm.ptrPokeLong(fds, i * 16, sv)
        fly.llvm.ptrPokeShort(fds, i * 16 + 8, (short)nev)
        fly.llvm.ptrPokeShort(fds, i * 16 + 10, 0)
        fly.llvm.ptrPokeInt(fds, i * 16 + 12, 0)
        i = i + 1
    }
    int rc = 0
    fly.runtime.WSAPoll(fds, count, timeoutMs, rc)
    int j = 0
    while j < count {
        short rv = 0
        fly.llvm.ptrReadShort(fds, j * 16 + 10, rv)
        int rvi = rv
        int nrv = rvi & 65535
        int frv = 0
        int m1 = nrv & 256
        int m1b = nrv & 512
        int m2 = nrv & 16
        int m3 = nrv & 1
        int m4 = nrv & 2
        int m5 = nrv & 4
        if m1 != 0 { frv = frv | 1 }
        if m1b != 0 { frv = frv | 1 }
        if m2 != 0 { frv = frv | 2 }
        if m3 != 0 { frv = frv | 4 }
        if m4 != 0 { frv = frv | 8 }
        if m5 != 0 { frv = frv | 4 }                 // POLLNVAL folded into "error"
        fly.llvm.ptrPokeInt(entries, j * 16 + 12, frv)
        j = j + 1
    }
    fly.runtime.free(fds)
    out = rc
}

// net_peer_addr / net_peer_port — who is on the other end of a connected
// socket, via getpeername. 0 / -1 when the socket is not connected.
public void net_peer_addr(const long s, int out) {
    if s < 0 { out = 0  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int rc = 0
    fly.runtime.getpeername(s, sa, alen, rc)
    if rc < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = 0
        return
    }
    byte b0 = 0
    byte b1 = 0
    byte b2 = 0
    byte b3 = 0
    fly.llvm.ptrByteAt(sa, 4, b0)
    fly.llvm.ptrByteAt(sa, 5, b1)
    fly.llvm.ptrByteAt(sa, 6, b2)
    fly.llvm.ptrByteAt(sa, 7, b3)
    int i0 = b0 & 255
    int i1 = b1 & 255
    int i2 = b2 & 255
    int i3 = b3 & 255
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = (i0 << 24) | (i1 << 16) | (i2 << 8) | i3
}

public void net_peer_port(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int rc = 0
    fly.runtime.getpeername(s, sa, alen, rc)
    if rc < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = 0 - 1
        return
    }
    byte hi = 0
    byte lo = 0
    fly.llvm.ptrByteAt(sa, 2, hi)
    fly.llvm.ptrByteAt(sa, 3, lo)
    int h = hi & 255
    int l = lo & 255
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = (h << 8) | l
}

// net_resolve_all — every A record for `host`, as packed host-order ints in a
// caller-provided buffer of `maxCount` slots. Returns the count, -1 on failure.
public void net_resolve_all(const pointer host, const pointer buf, const int maxCount, int out) {
    pointer wsa = 0
    fly.runtime.malloc(512, wsa)
    int wrc = 0
    fly.runtime.WSAStartup(514, wsa, wrc)
    fly.runtime.free(wsa)
    pointer he = 0
    fly.runtime.gethostbyname(host, he)
    if he == 0 { out = 0 - 1  return }
    long lstl = 0
    fly.llvm.ptrReadLong(he, 24, lstl)               // h_addr_list
    pointer lst = 0
    lst = lstl
    if lst == 0 { out = 0 - 1  return }
    int n = 0
    bool go = true
    while go {
        if n >= maxCount { go = false } else {
            long al = 0
            fly.llvm.ptrReadLong(lst, n * 8, al)
            pointer a = 0
            a = al
            if a == 0 { go = false } else {
                byte b0 = 0
                byte b1 = 0
                byte b2 = 0
                byte b3 = 0
                fly.llvm.ptrByteAt(a, 0, b0)
                fly.llvm.ptrByteAt(a, 1, b1)
                fly.llvm.ptrByteAt(a, 2, b2)
                fly.llvm.ptrByteAt(a, 3, b3)
                int i0 = b0 & 255
                int i1 = b1 & 255
                int i2 = b2 & 255
                int i3 = b3 & 255
                int packed = (i0 << 24) | (i1 << 16) | (i2 << 8) | i3
                fly.llvm.ptrPokeInt(buf, n * 4, packed)
                n = n + 1
            }
        }
    }
    out = n
}

// net_reverse_dns — the host name for a packed IPv4, written NUL-free into buf.
// Returns the byte length, or -1 when there is no PTR record.
public void net_reverse_dns(const int addr, const pointer buf, const int cap, int out) {
    pointer wsa = 0
    fly.runtime.malloc(512, wsa)
    int wrc = 0
    fly.runtime.WSAStartup(514, wsa, wrc)
    fly.runtime.free(wsa)
    pointer raw = 0
    fly.runtime.malloc(4, raw)
    fly.llvm.ptrPokeByte(raw, 0, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(raw, 1, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(raw, 2, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(raw, 3, (byte)(addr & 255))
    pointer he = 0
    fly.runtime.gethostbyaddr(raw, 4, 2, he)         // AF_INET = 2
    fly.runtime.free(raw)
    if he == 0 { out = 0 - 1  return }
    long nml = 0
    fly.llvm.ptrReadLong(he, 0, nml)                 // h_name
    pointer nm = 0
    nm = nml
    if nm == 0 { out = 0 - 1  return }
    ulong len = 0
    fly.runtime.strlen(nm, len)
    int n = 0
    fly.llvm.longToInt((long)len, n)
    if n >= cap { n = cap - 1 }
    if n < 0 { n = 0 }
    int i = 0
    while i < n {
        byte b = 0
        fly.llvm.ptrByteAt(nm, i, b)
        fly.llvm.ptrPokeByte(buf, i, b)
        i = i + 1
    }
    out = n
}

// net_resolve4 — host name → packed host-order IPv4; 0 on failure. Winsock2's
// hostent puts h_addr_list at offset 24, same as glibc and libSystem (two shorts
// plus padding fill 16..23 instead of two ints).
public void net_resolve4(const pointer host, int out) {
    pointer wsa = 0
    fly.runtime.malloc(512, wsa)
    int wrc = 0
    fly.runtime.WSAStartup(514, wsa, wrc)
    fly.runtime.free(wsa)
    pointer he = 0
    fly.runtime.gethostbyname(host, he)
    if he == 0 { out = 0  return }
    long lstl = 0
    fly.llvm.ptrReadLong(he, 24, lstl)              // h_addr_list
    pointer lst = 0
    lst = lstl
    if lst == 0 { out = 0  return }
    long a0l = 0
    fly.llvm.ptrReadLong(lst, 0, a0l)               // h_addr_list[0]
    pointer a0 = 0
    a0 = a0l
    if a0 == 0 { out = 0  return }
    byte b0 = 0
    byte b1 = 0
    byte b2 = 0
    byte b3 = 0
    fly.llvm.ptrByteAt(a0, 0, b0)
    fly.llvm.ptrByteAt(a0, 1, b1)
    fly.llvm.ptrByteAt(a0, 2, b2)
    fly.llvm.ptrByteAt(a0, 3, b3)
    int i0 = b0 & 255
    int i1 = b1 & 255
    int i2 = b2 & 255
    int i3 = b3 & 255
    out = (i0 << 24) | (i1 << 16) | (i2 << 8) | i3
}

// ── Fly string-array slot helpers ────────────────────────────────────────────
public void str_slot_set(const pointer arr_base, const int idx, const pointer ptr, const int size) {
    int off = idx * 16
    fly.llvm.ptrPokeLong(arr_base, off, ptr)
    fly.llvm.ptrPokeInt(arr_base, off + 8, size)
    fly.llvm.ptrPokeInt(arr_base, off + 12, 0)
}
public void str_slot_ptr(const pointer arr_base, const int idx, pointer out) {
    int off = idx * 16
    long v = 0
    fly.llvm.ptrReadLong(arr_base, off, v)
    out = v
}
public void str_slot_size(const pointer arr_base, const int idx, int out) {
    int off = idx * 16
    fly.llvm.ptrReadInt(arr_base, off + 8, out)
}

// ── Error / suite-runner reporting ───────────────────────────────────────────
// Mirrors the reference runtime/platform/{Err,Suite}.c. Called ONLY by
// compiler-generated code: err_print by main's epilogue for an unhandled
// error, suite_* by the implicit main() of a `suite` binary.

// Write the NUL-terminated C string at s to fd (no-op for null/empty).
private void wrCStr(const int fd, const pointer s) {
    if s == 0 { return }
    int n = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(s, n, b)
        if b == 0 { go = false } else { n = n + 1 }
    }
    if n == 0 { return }
    long w = 0
    fly.runtime.io_write(fd, s, (ulong)n, w)
}

// Write a string literal to fd.
private void wrLit(const int fd, const string s) {
    pointer p = 0
    toCStr(s, p)
    wrCStr(fd, p)
    fly.runtime.free(p)
}

// Write a single newline to fd (Fly string literals keep escapes raw).
private void wrNl(const int fd) {
    pointer p = 0
    fly.runtime.malloc(1, p)
    fly.llvm.ptrPokeByte(p, 0, 10)
    long w = 0
    fly.runtime.io_write(fd, p, 1, w)
    fly.runtime.free(p)
}

// Write v in decimal to fd.
private void wrDec(const int fd, const int v) {
    pointer buf = 0
    fly.runtime.malloc(12, buf)
    int mag = v
    bool neg = v < 0
    if neg { mag = 0 - mag }
    int len = 0
    int t = mag
    if t == 0 { len = 1 } else {
        while t > 0 {
            len = len + 1
            t = t / 10
        }
    }
    int pos = len
    if neg { pos = pos + 1 }
    int i = pos - 1
    t = mag
    if t == 0 {
        fly.llvm.ptrPokeByte(buf, i, 48)
    } else {
        while t > 0 {
            int d = t - (t / 10) * 10
            fly.llvm.ptrPokeByte(buf, i, 48 + d)
            i = i - 1
            t = t / 10
        }
    }
    if neg { fly.llvm.ptrPokeByte(buf, 0, 45) }
    long w = 0
    fly.runtime.io_write(fd, buf, (ulong)pos, w)
    fly.runtime.free(buf)
}

// " FAIL(<code>)[: <msg>]" + newline — shared tail of a failed case/step line.
private void wrFail(const int code, const pointer msg) {
    wrLit(1, " FAIL(")
    wrDec(1, code)
    wrLit(1, ")")
    if msg != 0 {
        byte b0 = 0
        fly.llvm.ptrByteAt(msg, 0, b0)
        if b0 != 0 {
            wrLit(1, ": ")
            wrCStr(1, msg)
        }
    }
    wrNl(1)
}

// Print "error <code>[: <msg>]" to stderr — unhandled error reaching main().
public void err_print(const int code, const pointer msg) {
    wrLit(2, "error ")
    wrDec(2, code)
    if msg != 0 {
        byte b0 = 0
        fly.llvm.ptrByteAt(msg, 0, b0)
        if b0 != 0 {
            wrLit(2, ": ")
            wrCStr(2, msg)
        }
    }
    wrNl(2)
}

public void suite_begin(const pointer name) {
    wrLit(1, "suite ")
    wrCStr(1, name)
    wrNl(1)
}

public void suite_method(const pointer name) {
    wrLit(1, "  ")
    wrCStr(1, name)
    wrNl(1)
}

// No newline: the case result (or a crash) completes the line.
public void suite_case_begin(const pointer label) {
    wrLit(1, "    ")
    wrCStr(1, label)
    wrLit(1, " ...")
}

public void suite_case_result(const int code, const pointer msg) {
    if code == 0 {
        wrLit(1, " ok")
        wrNl(1)
        return
    }
    wrFail(code, msg)
}

public void suite_step_fail(const pointer label, const int code, const pointer msg) {
    wrLit(1, "    ")
    wrCStr(1, label)
    wrLit(1, " ...")
    wrFail(code, msg)
}

public void suite_end(const pointer name, const int total, const int failed) {
    wrLit(1, "suite ")
    wrCStr(1, name)
    wrLit(1, ": ")
    wrDec(1, total)
    wrLit(1, " cases, ")
    wrDec(1, total - failed)
    wrLit(1, " passed, ")
    wrDec(1, failed)
    wrLit(1, " failed")
    wrNl(1)
}
