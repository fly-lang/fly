public void fs_rename(const pointer src, const pointer dst, int out) {
    int ok = 0
    fly.runtime.MoveFileExA(src, dst, 1, ok)          // MOVEFILE_REPLACE_EXISTING
    if ok == 0 { out = 0 - 1 } else { out = 0 }
