// ── Filesystem ────────────────────────────────────────────────────────────────
// POSIX O_* → UCRT _open flags. O_RDONLY=0/WRONLY=1/RDWR=2; CREAT 64→0x100,
// TRUNC 512→0x200, APPEND 1024→0x8.
private void winOpenFlags(const int flags, int out) {
    int wf = 0
    int rw = flags & 3
    if rw == 1 { wf = 1 } elsif rw == 2 { wf = 2 } else { wf = 0 }
    int cCreat = flags & 64
    if cCreat != 0 { wf = wf | 256 }
    int cTrunc = flags & 512
    if cTrunc != 0 { wf = wf | 512 }
    int cApp = flags & 1024
    if cApp != 0 { wf = wf | 8 }
    out = wf
}
// fs_open — regular files only (via _open). Directories: not supported here (no
// static dir-fd table), so _open returns -1 for them → directory listing fails.
public void fs_open(const pointer path, const int flags, const int mode, int out) {
    int wf = 0
    winOpenFlags(flags, wf)
    fly.runtime._open(path, wf, mode, out)
}
public void fs_close(const int fd) {
    int r = 0
    fly.runtime._close(fd, r)
}
public void fs_read(const int fd, const pointer buf, const ulong count, long out) {
    int c = 0
    fly.llvm.longToInt((long)count, c)
    int r = 0
    fly.runtime._read(fd, buf, c, r)
    out = r
}
public void fs_write(const int fd, const pointer buf, const ulong count, long out) {
    int c = 0
    fly.llvm.longToInt((long)count, c)
    int r = 0
    fly.runtime._write(fd, buf, c, r)
    out = r
}
public void fs_seek(const int fd, const long offset, const int whence, long out) {
    fly.runtime._lseeki64(fd, offset, whence, out)
}
// stat via GetFileAttributesExA. WIN32_FILE_ATTRIBUTE_DATA: dwFileAttributes@0,
// nFileSizeHigh@28, nFileSizeLow@32. mode fabricated: dir=0040755 else 0100644.
private void winSizeFromInfo(const pointer info, long out) {
    int hi = 0
    int lo = 0
    fly.llvm.ptrReadInt(info, 28, hi)
    fly.llvm.ptrReadInt(info, 32, lo)
    long hiL = hi & 4294967295
    long loL = lo & 4294967295
    out = (hiL << 32) | loL
}
public void fs_size(const pointer path, long out) {
    pointer info = 0
    fly.runtime.malloc(40, info)
    int ok = 0
    fly.runtime.GetFileAttributesExA(path, 0, info, ok)
    if ok == 0 { out = 0 - 1 } else { winSizeFromInfo(info, out) }
    fly.runtime.free(info)
}
public void fs_mode(const pointer path, int out) {
    pointer info = 0
    fly.runtime.malloc(40, info)
    int ok = 0
    fly.runtime.GetFileAttributesExA(path, 0, info, ok)
    if ok == 0 { out = 0 - 1 } else {
        int attr = 0
        fly.llvm.ptrReadInt(info, 0, attr)
        int isdir = attr & 16
        if isdir != 0 { out = 16877 } else { out = 33188 }         // 0040755 / 0100644
    }
    fly.runtime.free(info)
}
// l* variants use FindFirstFileA (does not follow symlinks). WIN32_FIND_DATAA:
// dwFileAttributes@0, nFileSizeHigh@28, nFileSizeLow@32; struct is 320 bytes.
public void fs_lsize(const pointer path, long out) {
    pointer ffd = 0
    fly.runtime.malloc(320, ffd)
    pointer h = 0
    fly.runtime.FindFirstFileA(path, ffd, h)
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1 } else {
        int rc = 0
        fly.runtime.FindClose(h, rc)
        winSizeFromInfo(ffd, out)
    }
    fly.runtime.free(ffd)
}
public void fs_lmode(const pointer path, int out) {
    pointer ffd = 0
    fly.runtime.malloc(320, ffd)
    pointer h = 0
    fly.runtime.FindFirstFileA(path, ffd, h)
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1 } else {
        int rc = 0
        fly.runtime.FindClose(h, rc)
        int attr = 0
        fly.llvm.ptrReadInt(ffd, 0, attr)
        int isrep = attr & 1024
        int isdir = attr & 16
        if isrep != 0 { out = 41453 } else {                  // reparse → S_IFLNK 0120755
            if isdir != 0 { out = 16877 } else { out = 33188 }
        }
    }
    fly.runtime.free(ffd)
}
// mtime helpers — last-modification time as TOTAL NANOSECONDS since the Unix
// epoch in one i64 (sec = out/1e9, nsec = out%1e9; splitting is the caller's
// job so the primitive keeps a single out). Both info structs place
// ftLastWriteTime at offset 20 (dwLowDateTime@20, dwHighDateTime@24): FILETIME
// counts 100ns units since 1601-01-01; the 1601→1970 delta is 11644473600 s =
// 116444736000000000 units. -1 on a failed lookup.
private void winMtimeFromInfo(const pointer info, long out) {
    int lo = 0
    int hi = 0
    fly.llvm.ptrReadInt(info, 20, lo)
    fly.llvm.ptrReadInt(info, 24, hi)
    long hiL = hi & 4294967295
    long loL = lo & 4294967295
    long ft = (hiL << 32) | loL
    out = (ft - 116444736000000000) * 100
}
public void fs_mtime(const pointer path, long out) {
    pointer info = 0
    fly.runtime.malloc(40, info)
    int ok = 0
    fly.runtime.GetFileAttributesExA(path, 0, info, ok)
    if ok == 0 { out = 0 - 1 } else { winMtimeFromInfo(info, out) }
    fly.runtime.free(info)
}
public void fs_lmtime(const pointer path, long out) {
    pointer ffd = 0
    fly.runtime.malloc(320, ffd)
    pointer h = 0
    fly.runtime.FindFirstFileA(path, ffd, h)
    pointer inv = 0
    inv = inv - 1
    if h == inv { out = 0 - 1 } else {
        int rc = 0
        fly.runtime.FindClose(h, rc)
        winMtimeFromInfo(ffd, out)
    }
    fly.runtime.free(ffd)
}
