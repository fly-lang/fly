public void env_get(const pointer key, const pointer buf, const ulong size, int out) {
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    int r = 0
    fly.runtime.GetEnvironmentVariableA(key, buf, szi, r)
    if r > 0 { if r < szi { out = r } else { out = 0 - 1 } } else { out = 0 - 1 }
}
public void env_hostname(const pointer buf, const ulong size, int out) {
    pointer szp = 0
    fly.runtime.malloc(4, szp)
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    fly.llvm.ptrPokeInt(szp, 0, szi)
    int ok = 0
    fly.runtime.GetComputerNameA(buf, szp, ok)
    if ok == 0 { out = 0 - 1 } else { fly.llvm.ptrReadInt(szp, 0, out) }
    fly.runtime.free(szp)
}
public void env_arch(const pointer buf, const ulong size, int out) {
    pointer src = 0
    toCStr("x86_64", src)
    copyCStr(src, buf, size, out)
    fly.runtime.free(src)
}
// kernel = "major.minor", kernelversion = build number — from ntdll's
// RtlGetVersion (GetVersion is compat-shimmed to 6.2/9200 on modern Windows).
//
// The decimal formatting is INLINE in both functions on purpose: under this
// module's flat C-ABI emission, an INTERNAL fly-to-fly call that follows a
// ptrPokeByte store is miscompiled away (probed 2026-07-23: `appendUint; poke
// '.'; appendUint` ran only the first call, while `appendUint; appendUint` ran
// both — pokeInt-then-call is fine, extern calls are fine). Keeping every store
// and digit loop in ONE frame sidesteps the whole class.
public void env_kernel(const pointer buf, const ulong size, int out) {
    pointer v3 = 0
    fly.runtime.malloc(12, v3)
    versionInfo(v3)
    int major = 0
    fly.llvm.ptrReadInt(v3, 0, major)
    int minor = 0
    fly.llvm.ptrReadInt(v3, 4, minor)
    fly.runtime.free(v3)
    pointer tmp = 0
    fly.runtime.malloc(16, tmp)
    int p = 0
    // major digits (reversed into tmp, copied back; always at least "0")
    int n = 0
    int x = major
    bool more = true
    while more {
        int q = x / 10
        int d = x - q * 10
        byte db = (byte)(48 + d)
        fly.llvm.ptrPokeByte(tmp, n, db)
        n = n + 1
        x = q
        if x <= 0 { more = false }
    }
    int i = n - 1
    while i >= 0 {
        byte b = 0
        fly.llvm.ptrReadByte(tmp, i, b)
        fly.llvm.ptrPokeByte(buf, p, b)
        p = p + 1
        i = i - 1
    }
    fly.llvm.ptrPokeByte(buf, p, (byte)46)             // '.'
    p = p + 1
    // minor digits
    n = 0
    x = minor
    more = true
    while more {
        int q2 = x / 10
        int d2 = x - q2 * 10
        byte db2 = (byte)(48 + d2)
        fly.llvm.ptrPokeByte(tmp, n, db2)
        n = n + 1
        x = q2
        if x <= 0 { more = false }
    }
    i = n - 1
    while i >= 0 {
        byte b2 = 0
        fly.llvm.ptrReadByte(tmp, i, b2)
        fly.llvm.ptrPokeByte(buf, p, b2)
        p = p + 1
        i = i - 1
    }
    fly.llvm.ptrPokeByte(buf, p, (byte)0)
    out = p
    fly.runtime.free(tmp)
}
public void env_kernelversion(const pointer buf, const ulong size, int out) {
    pointer v3 = 0
    fly.runtime.malloc(12, v3)
    versionInfo(v3)
    int build = 0
    fly.llvm.ptrReadInt(v3, 8, build)
    fly.runtime.free(v3)
    pointer tmp = 0
    fly.runtime.malloc(16, tmp)
    int p = 0
    int n = 0
    int x = build
    bool more = true
    while more {
        int q = x / 10
        int d = x - q * 10
        byte db = (byte)(48 + d)
        fly.llvm.ptrPokeByte(tmp, n, db)
        n = n + 1
        x = q
        if x <= 0 { more = false }
    }
    int i = n - 1
    while i >= 0 {
        byte b = 0
        fly.llvm.ptrReadByte(tmp, i, b)
        fly.llvm.ptrPokeByte(buf, p, b)
        p = p + 1
        i = i - 1
    }
    fly.llvm.ptrPokeByte(buf, p, (byte)0)
    out = p
    fly.runtime.free(tmp)
}
// versionInfo — the host version as [major@0, minor@4, build@8], written through
// `v3` (12 bytes). Queries ntdll's RtlGetVersion (RTL_OSVERSIONINFOW: size@0,
// major@4, minor@8, build@12, platform@16, WCHAR csd[128] — 276 bytes total);
// falls back to GetVersion's compat values when it fails. Write-through pointer
// on purpose: a non-const out param is not expressible in the fly.runtime
// calling convention (see scanToken).
private void versionInfo(const pointer v3) {
    pointer info = 0
    fly.runtime.malloc(276, info)
    zeroMem(info, 276)
    fly.llvm.ptrPokeInt(info, 0, 276)
    int st = 0
    fly.runtime.RtlGetVersion(info, st)
    if st == 0 {
        int ma = 0
        fly.llvm.ptrReadInt(info, 4, ma)
        int mi = 0
        fly.llvm.ptrReadInt(info, 8, mi)
        int bu = 0
        fly.llvm.ptrReadInt(info, 12, bu)
        fly.llvm.ptrPokeInt(v3, 0, ma)
        fly.llvm.ptrPokeInt(v3, 4, mi)
        fly.llvm.ptrPokeInt(v3, 8, bu)
    } else {
        int v = 0
        fly.runtime.GetVersion(v)
        int major = v & 255
        int sh = v >> 8
        int minor = sh & 255
        int sh2 = v >> 16
        int build = sh2 & 65535
        fly.llvm.ptrPokeInt(v3, 0, major)
        fly.llvm.ptrPokeInt(v3, 4, minor)
        fly.llvm.ptrPokeInt(v3, 8, build)
    }
    fly.runtime.free(info)
}
public void env_osname(const pointer buf, const ulong size, int out) {
    pointer src = 0
    toCStr("windows", src)
    copyCStr(src, buf, size, out)
    fly.runtime.free(src)
}
public void env_exe_path(const pointer buf, const ulong size, int out) {
    if size == 0 { out = 0 - 1  return }
    int szi = 0
    fly.llvm.longToInt((long)size, szi)
    int n = 0
    fly.runtime.GetModuleFileNameA(0, buf, szi, n)
    if n == 0 { out = 0 - 1  return }
    if n >= szi { out = 0 - 1  return }
    fly.llvm.ptrPokeByte(buf, n, 0)
    out = n
}
// env_all — from GetEnvironmentStringsA (KEY=VAL\0KEY=VAL\0\0). No globals.
public void env_all_count(int out) {
    pointer env = 0
    fly.runtime.GetEnvironmentStringsA(env)
    if env == 0 { out = 0  return }
    int n = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(env, i, b)
        if b == 0 {
            byte b2 = 0
            fly.llvm.ptrByteAt(env, i + 1, b2)
            if b2 == 0 { go = false } else { n = n + 1  i = i + 1 }
        } else {
            i = i + 1
        }
    }
    int rc = 0
    fly.runtime.FreeEnvironmentStringsA(env, rc)
    out = n
}
public void env_all_fill(const pointer arr_base, const int count) {
    pointer env = 0
    fly.runtime.GetEnvironmentStringsA(env)
    if env == 0 { return }
    int idx = 0
    int start = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(env, i, b)
        if b == 0 {
            if i == start {
                go = false                              // double NUL → end
            } else {
                if idx < count {
                    pointer entry = env + start
                    fillSlotFromCStr(arr_base, idx, entry)
                }
                idx = idx + 1
                start = i + 1
            }
        }
        i = i + 1
    }
    int rc = 0
    fly.runtime.FreeEnvironmentStringsA(env, rc)
}
// env_args — recovered from GetCommandLineA() (a function, no globals). Simple
// quote-aware split: "quoted spans" group spaces; otherwise whitespace-delimited.
public void env_args_count(int out) {
    pointer cl = 0
    fly.runtime.GetCommandLineA(cl)
    countArgs(cl, out)
}
public void env_args_fill(const pointer arr_base, const int count) {
    pointer cl = 0
    fly.runtime.GetCommandLineA(cl)
    // scanToken writes its 3 outputs [tokstart@0, toklen@4, nextpos@8] through this
    // scratch buffer — a fly.runtime function may return only ONE value (the C-ABI
    // convention: const params by value, first non-const → return), so a 3-out
    // signature would silently drop toklen/nextpos and loop forever.
    pointer tok = 0
    fly.runtime.malloc(12, tok)
    int idx = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(cl, i, b)
        if b == 0 { go = false } else {
            if b == 32 { i = i + 1 } else {
                scanToken(cl, i, tok)
                int tokstart = 0
                fly.llvm.ptrReadInt(tok, 0, tokstart)
                int toklen = 0
                fly.llvm.ptrReadInt(tok, 4, toklen)
                fly.llvm.ptrReadInt(tok, 8, i)          // nextpos
                if idx < count {
                    pointer tp = cl + tokstart
                    fillSlotLen(arr_base, idx, tp, toklen)
                }
                idx = idx + 1
            }
        }
    }
    fly.runtime.free(tok)
}
// countArgs / scanToken share the same simple tokenizer.
private void countArgs(const pointer cl, int out) {
    pointer tok = 0
    fly.runtime.malloc(12, tok)
    int n = 0
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(cl, i, b)
        if b == 0 { go = false } else {
            if b == 32 { i = i + 1 } else {
                scanToken(cl, i, tok)
                fly.llvm.ptrReadInt(tok, 8, i)          // nextpos — MUST advance i
                n = n + 1
            }
        }
    }
    fly.runtime.free(tok)
    out = n
}
// scanToken — starting at `pos` (non-space), write the token bounds through `out3`:
// [tokstart@0, toklen@4, nextpos@8]. A leading '"' starts a quoted span. All params
// are const (out3 is written-through) so this stays a ZERO-return C-ABI function —
// a multi-out signature is not expressible in the fly.runtime calling convention.
private void scanToken(const pointer cl, const int pos, const pointer out3) {
    int tokstart = 0
    int toklen = 0
    int i = pos
    byte first = 0
    fly.llvm.ptrByteAt(cl, i, first)
    if first == 34 {                                    // '"'
        i = i + 1
        tokstart = i
        bool go = true
        while go {
            byte b = 0
            fly.llvm.ptrByteAt(cl, i, b)
            if b == 0 { go = false } elsif b == 34 { go = false } else { i = i + 1 }
        }
        toklen = i - tokstart
        byte c = 0
        fly.llvm.ptrByteAt(cl, i, c)
        if c == 34 { i = i + 1 }
    } else {
        tokstart = i
        bool go = true
        while go {
            byte b = 0
            fly.llvm.ptrByteAt(cl, i, b)
            if b == 0 { go = false } elsif b == 32 { go = false } else { i = i + 1 }
        }
        toklen = i - tokstart
    }
    fly.llvm.ptrPokeInt(out3, 0, tokstart)
    fly.llvm.ptrPokeInt(out3, 4, toklen)
    fly.llvm.ptrPokeInt(out3, 8, i)                     // nextpos
}
// env_init — accessors are stateless; kept as a defined no-op.
public void env_init(const int argc, const pointer argv) {
    int unused = argc
}

// fillSlotFromCStr — copy the NUL-terminated string at cstr into a slot.
private void fillSlotFromCStr(const pointer arr_base, const int idx, const pointer cstr) {
    ulong len = 0
    fly.runtime.strlen(cstr, len)
    int ilen = 0
    fly.llvm.longToInt((long)len, ilen)
    fillSlotLen(arr_base, idx, cstr, ilen)
}
// fillSlotLen — copy `len` bytes from src into a fresh buffer; write it as slot idx.
private void fillSlotLen(const pointer arr_base, const int idx, const pointer src, const int len) {
    pointer dst = 0
    fly.runtime.malloc(len + 1, dst)
    int j = 0
    while j < len {
        byte b = 0
        fly.llvm.ptrByteAt(src, j, b)
        fly.llvm.ptrPokeByte(dst, j, b)
        j = j + 1
    }
    fly.llvm.ptrPokeByte(dst, len, 0)
    fly.runtime.str_slot_set(arr_base, idx, dst, len)
}

// ── Process / concurrency ─────────────────────────────────────────────────────
public void proc_exec(const pointer path, const pointer argv, int out) {
    // Build:  "path" arg1 arg2 …   (arg0 quoted; rest space-separated, as in C)
    pointer cmd = 0
    fly.runtime.malloc(8192, cmd)
    int p = 0
    fly.llvm.ptrPokeByte(cmd, p, 34)  p = p + 1        // '"'
    // arg0 (exe): '/'→'\' normalised. Use a DISTINCT out var `aend` then `p = aend`
    // — reusing `p` as both the pos arg and the out arg (appendCStrPath(cmd,p,path,p))
    // makes the compiler cache `p` for the next statement BEFORE the out-param
    // update, so the closing quote lands at the stale offset and clobbers arg0.
    int aend = p
    appendCStrPath(cmd, p, path, aend)
    p = aend
    fly.llvm.ptrPokeByte(cmd, p, 34)  p = p + 1        // '"'
    int i = 1
    bool go = true
    while go {
        long a = 0
        fly.llvm.ptrReadLong(argv, i * 8, a)
        if a == 0 { go = false } else {
            fly.llvm.ptrPokeByte(cmd, p, 32)  p = p + 1
            int cend = p
            appendCStr(cmd, p, a, cend)
            p = cend
            i = i + 1
        }
    }
    fly.llvm.ptrPokeByte(cmd, p, 0)
    // STARTUPINFOA (~104 B) zeroed, cb set; PROCESS_INFORMATION (24 B) zeroed.
    pointer si = 0
    fly.runtime.malloc(104, si)
    zeroMem(si, 104)
    fly.llvm.ptrPokeInt(si, 0, 104)                    // si.cb
    pointer pi = 0
    fly.runtime.malloc(24, pi)
    zeroMem(pi, 24)
    int ok = 0
    fly.runtime.CreateProcessA(0, cmd, 0, 0, 1, 0, 0, 0, si, pi, ok)
    if ok == 0 { out = 0 - 1  fly.runtime.free(cmd)  fly.runtime.free(si)  fly.runtime.free(pi)  return }
    pointer hProc = 0
    long hpL = 0
    fly.llvm.ptrReadLong(pi, 0, hpL)                   // pi.hProcess @ 0
    hProc = hpL
    int w = 0
    fly.runtime.WaitForSingleObject(hProc, 0 - 1, w)
    pointer codep = 0
    fly.runtime.malloc(4, codep)
    int gc = 0
    fly.runtime.GetExitCodeProcess(hProc, codep, gc)
    fly.llvm.ptrReadInt(codep, 0, out)
    long htL = 0
    fly.llvm.ptrReadLong(pi, 8, htL)                   // pi.hThread @ 8
    int rc1 = 0
    int rc2 = 0
    fly.runtime.CloseHandle(htL, rc1)
    fly.runtime.CloseHandle(hProc, rc2)
    fly.runtime.free(cmd)
    fly.runtime.free(si)
    fly.runtime.free(pi)
    fly.runtime.free(codep)
}
private void zeroMem(const pointer p, const int n) {
    int i = 0
    while i < n { fly.llvm.ptrPokeByte(p, i, 0)  i = i + 1 }
}
private void appendCStr(const pointer buf, const int pos, const pointer src, int nextpos) {
    int p = pos
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(src, i, b)
        if b == 0 { go = false } else {
            fly.llvm.ptrPokeByte(buf, p, b)
            p = p + 1
            i = i + 1
        }
    }
    nextpos = p
}
// appendCStrPath — like appendCStr but normalises '/' → '\' while copying. Used for
// the executable path (arg0): CreateProcessA fails to resolve an app path that
// mixes separators (fly.os.path.join emits '/', exePath yields '\'), so the exe
// must be pure-backslash. Args keep '/' (the linker accepts either).
private void appendCStrPath(const pointer buf, const int pos, const pointer src, int nextpos) {
    int p = pos
    int i = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(src, i, b)
        if b == 0 { go = false } else {
            if b == 47 { b = 92 }                       // '/' → '\'
            fly.llvm.ptrPokeByte(buf, p, b)
            p = p + 1
            i = i + 1
        }
    }
    nextpos = p
}
public void thread_spawn(const pointer fn, const pointer arg, const ulong stackSize, int out) {
    pointer tidp = 0
    fly.runtime.malloc(4, tidp)
    pointer h = 0
    fly.runtime.CreateThread(0, stackSize, fn, arg, 0, tidp, h)
    if h == 0 {
        out = 0 - 1
    } else {
        int rc = 0
        fly.runtime.CloseHandle(h, rc)
        fly.llvm.ptrReadInt(tidp, 0, out)
    }
    fly.runtime.free(tidp)
}
// futex via WaitOnAddress / WakeByAddress.
public void futex_wait(const pointer addr, const int expected) {
    pointer cmp = 0
    fly.runtime.malloc(4, cmp)
    fly.llvm.ptrPokeInt(cmp, 0, expected)
    int r = 0
    fly.runtime.WaitOnAddress(addr, cmp, 4, 0 - 1, r)   // INFINITE
    fly.runtime.free(cmp)
}
public void futex_wake(const pointer addr, const int count, int out) {
    if count == 1 {
        fly.runtime.WakeByAddressSingle(addr)
        out = 1
    } else {
        fly.runtime.WakeByAddressAll(addr)
        out = count
    }
}
public void atomic_load_i32(const pointer addr, int out) {
    fly.runtime.__atomic_load_4(addr, 2, out)
}
public void atomic_store_i32(const pointer addr, const int val) {
    fly.runtime.__atomic_store_4(addr, val, 3)
}
public void atomic_cas_i32(const pointer addr, const int expected, const int desired, int out) {
    pointer exp = 0
    fly.runtime.malloc(4, exp)
    fly.llvm.ptrPokeInt(exp, 0, expected)
    bool ok = false
    fly.runtime.__atomic_compare_exchange_4(addr, exp, desired, 0, 4, 2, ok)
    fly.llvm.ptrReadInt(exp, 0, out)
    fly.runtime.free(exp)
}
public void atomic_fetch_add_i32(const pointer addr, const int delta, int out) {
    fly.runtime.__atomic_fetch_add_4(addr, delta, 4, out)
}

// ── Fly string-array slot helpers ────────────────────────────────────────────
public void str_slot_set(const pointer arr_base, const int idx, const pointer ptr, const int size) {
    int off = idx * 16
    fly.llvm.ptrPokeLong(arr_base, off, ptr)
    fly.llvm.ptrPokeInt(arr_base, off + 8, size)
    fly.llvm.ptrPokeInt(arr_base, off + 12, 0)
}
public void str_slot_ptr(const pointer arr_base, const int idx, pointer out) {
    int off = idx * 16
    long v = 0
    fly.llvm.ptrReadLong(arr_base, off, v)
    out = v
}
public void str_slot_size(const pointer arr_base, const int idx, int out) {
    int off = idx * 16
    fly.llvm.ptrReadInt(arr_base, off + 8, out)
}

// ── Error / suite-runner reporting ───────────────────────────────────────────
// Mirrors the reference runtime/platform/{Err,Suite}.c. Called ONLY by
// compiler-generated code: err_print by main's epilogue for an unhandled
// error, suite_* by the implicit main() of a `suite` binary.

// Write the NUL-terminated C string at s to fd (no-op for null/empty).
private void wrCStr(const int fd, const pointer s) {
    if s == 0 { return }
    int n = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(s, n, b)
        if b == 0 { go = false } else { n = n + 1 }
    }
    if n == 0 { return }
    long w = 0
    fly.runtime.io_write(fd, s, (ulong)n, w)
}

// Write a string literal to fd.
private void wrLit(const int fd, const string s) {
    pointer p = 0
    toCStr(s, p)
    wrCStr(fd, p)
    fly.runtime.free(p)
}

// Write a single newline to fd (Fly string literals keep escapes raw).
private void wrNl(const int fd) {
    pointer p = 0
    fly.runtime.malloc(1, p)
    fly.llvm.ptrPokeByte(p, 0, 10)
    long w = 0
    fly.runtime.io_write(fd, p, 1, w)
    fly.runtime.free(p)
}

// Write v in decimal to fd.
private void wrDec(const int fd, const int v) {
    pointer buf = 0
    fly.runtime.malloc(12, buf)
    int mag = v
    bool neg = v < 0
    if neg { mag = 0 - mag }
    int len = 0
    int t = mag
    if t == 0 { len = 1 } else {
        while t > 0 {
            len = len + 1
            t = t / 10
        }
    }
    int pos = len
    if neg { pos = pos + 1 }
    int i = pos - 1
    t = mag
    if t == 0 {
        fly.llvm.ptrPokeByte(buf, i, 48)
    } else {
        while t > 0 {
            int d = t - (t / 10) * 10
            fly.llvm.ptrPokeByte(buf, i, 48 + d)
            i = i - 1
            t = t / 10
        }
    }
    if neg { fly.llvm.ptrPokeByte(buf, 0, 45) }
    long w = 0
    fly.runtime.io_write(fd, buf, (ulong)pos, w)
    fly.runtime.free(buf)
}

// " FAIL(<code>)[: <msg>]" + newline — shared tail of a failed case/step line.
private void wrFail(const int code, const pointer msg) {
    wrLit(1, " FAIL(")
    wrDec(1, code)
    wrLit(1, ")")
    if msg != 0 {
        byte b0 = 0
        fly.llvm.ptrByteAt(msg, 0, b0)
        if b0 != 0 {
            wrLit(1, ": ")
            wrCStr(1, msg)
        }
    }
    wrNl(1)
}

// Print "error <code>[: <msg>]" to stderr — unhandled error reaching main().
public void err_print(const int code, const pointer msg) {
    wrLit(2, "error ")
    wrDec(2, code)
    if msg != 0 {
        byte b0 = 0
        fly.llvm.ptrByteAt(msg, 0, b0)
        if b0 != 0 {
            wrLit(2, ": ")
            wrCStr(2, msg)
        }
    }
    wrNl(2)
}

public void suite_begin(const pointer name) {
    wrLit(1, "suite ")
    wrCStr(1, name)
    wrNl(1)
}

public void suite_method(const pointer name) {
    wrLit(1, "  ")
    wrCStr(1, name)
    wrNl(1)
}

// No newline: the case result (or a crash) completes the line.
public void suite_case_begin(const pointer label) {
    wrLit(1, "    ")
    wrCStr(1, label)
    wrLit(1, " ...")
}

public void suite_case_result(const int code, const pointer msg) {
    if code == 0 {
        wrLit(1, " ok")
        wrNl(1)
        return
    }
    wrFail(code, msg)
}

public void suite_step_fail(const pointer label, const int code, const pointer msg) {
    wrLit(1, "    ")
    wrCStr(1, label)
    wrLit(1, " ...")
    wrFail(code, msg)
}

public void suite_end(const pointer name, const int total, const int failed) {
    wrLit(1, "suite ")
    wrCStr(1, name)
    wrLit(1, ": ")
    wrDec(1, total)
    wrLit(1, " cases, ")
    wrDec(1, total - failed)
    wrLit(1, " passed, ")
    wrDec(1, failed)
    wrLit(1, " failed")
    wrNl(1)
}
