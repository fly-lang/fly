public void tanh(const double x, double out) {}
public void hypot(const double x, const double y, double out) {}
public void asinh(const double x, double out) {}
public void acosh(const double x, double out) {}
public void atanh(const double x, double out) {}

// ── Memory ────────────────────────────────────────────────────────────────────
public void mem_alloc(const ulong size, pointer out) {
    ulong s = size
    if s == 0 { s = 1 }
    fly.runtime.malloc(s, out)
}

public void mem_free(const pointer ptr, const ulong size) {
    fly.runtime.free(ptr)
}

public void mem_realloc(const pointer ptr, const ulong newSize, pointer out) {
    ulong s = newSize
    if s == 0 { s = 1 }
    fly.runtime.realloc(ptr, s, out)
}

// ── I/O ─────────────────────────────────────────────────────────────────────
public void io_write(const int fd, const pointer buf, const ulong count, long out) {
    fly.runtime.write(fd, buf, count, out)
}

// ── Process ───────────────────────────────────────────────────────────────────
public void proc_exit(const int code) {
    fly.runtime.exit(code)
}

// ── Filesystem — thin libc wrappers ──────────────────────────────────────────
public void fs_open(const pointer path, const int flags, const int mode, int out) {
    fly.runtime.open(path, flags, mode, out)
}

public void fs_close(const int fd) {
    int r = 0
    fly.runtime.close(fd, r)
}

public void fs_read(const int fd, const pointer buf, const ulong count, long out) {
    fly.runtime.read(fd, buf, count, out)
}

public void fs_write(const int fd, const pointer buf, const ulong count, long out) {
    fly.runtime.write(fd, buf, count, out)
}

public void fs_seek(const int fd, const long offset, const int whence, long out) {
    fly.runtime.lseek(fd, offset, whence, out)
}

// io_set_binary — a NO-OP on POSIX, reporting success. It exists so that code
// needing a byte-exact stream (the LSP's Content-Length framing) can call it
// unconditionally; on Windows the same primitive takes the fd out of the UCRT's
// TEXT mode, which otherwise rewrites \n <-> \r\n and treats 0x1A as EOF.
public void io_set_binary(const int fd, int out) {
    out = 0
}

public void fs_mkdir(const pointer path, const int mode, int out) {
    fly.runtime.mkdir(path, mode, out)
}

public void fs_rmdir(const pointer path, int out) {
    fly.runtime.rmdir(path, out)
}

public void fs_unlink(const pointer path, int out) {
    fly.runtime.unlink(path, out)
}

public void fs_rename(const pointer src, const pointer dst, int out) {
    fly.runtime.rename(src, dst, out)
}

public void fs_fsync(const int fd, int out) {
    fly.runtime.fsync(fd, out)
}

public void fs_truncate(const pointer path, const long size, int out) {
    fly.runtime.truncate(path, size, out)
}

public void fs_chmod(const pointer path, const int mode, int out) {
    fly.runtime.chmod(path, mode, out)
}

public void fs_symlink(const pointer target, const pointer link, int out) {
    fly.runtime.symlink(target, link, out)
}

public void fs_readlink(const pointer path, const pointer buf, const ulong size, int out) {
    long r = 0
    fly.runtime.readlink(path, buf, size, r)
    fly.llvm.longToInt(r, out)
}

public void fs_getdents(const int fd, const pointer buf, const ulong size, int out) {
    long r = 0
    fly.runtime.getdents64(fd, buf, size, r)
    fly.llvm.longToInt(r, out)
}

// ── Directory enumeration (dir_open/dir_read/dir_close) ────────────────────────
// A pointer-handle iterator abstraction so the std `dirRead` is platform-neutral:
// the handle is an opaque malloc'd context (0 = failure), NOT an int fd — Windows
// needs a 64-bit FindFirstFile HANDLE + state (see RuntimeWindows.fly). On POSIX
// the context just holds the dir fd; dir_read fills linux_dirent64 records.
public void dir_open(const pointer path, pointer out) {
    int fd = 0
    fly.runtime.open(path, 0, 0, fd)
    if fd < 0 { out = 0  return }
    pointer ctx = 0
    fly.runtime.mem_alloc(4, ctx)
    fly.llvm.ptrPokeInt(ctx, 0, fd)
    out = ctx
}
public void dir_read(const pointer ctx, const pointer buf, const ulong size, int out) {
    int fd = 0
    fly.llvm.ptrReadInt(ctx, 0, fd)
    long r = 0
    fly.runtime.getdents64(fd, buf, size, r)
    fly.llvm.longToInt(r, out)
}
public void dir_close(const pointer ctx) {
    int fd = 0
    fly.llvm.ptrReadInt(ctx, 0, fd)
    fly.runtime.fs_close(fd)
    fly.runtime.mem_free(ctx, 4)
}

// stat helpers — glibc `struct stat` (x86-64) matches the kernel layout used by the
// C runtime: st_mode @ offset 24 (i32), st_size @ offset 48 (i64). Buffer is 144 B.
public void fs_size(const pointer path, long out) {
    pointer st = 0
    fly.runtime.malloc(144, st)
    int rc = 0
    fly.runtime.stat(path, st, rc)
    if rc < 0 { out = 0 - 1 } else { fly.llvm.ptrReadLong(st, 48, out) }
    fly.runtime.free(st)
}

public void fs_mode(const pointer path, int out) {
    pointer st = 0
    fly.runtime.malloc(144, st)
    int rc = 0
    fly.runtime.stat(path, st, rc)
    if rc < 0 { out = 0 - 1 } else { fly.llvm.ptrReadInt(st, 24, out) }
    fly.runtime.free(st)
}

public void fs_lsize(const pointer path, long out) {
    pointer st = 0
    fly.runtime.malloc(144, st)
    int rc = 0
    fly.runtime.lstat(path, st, rc)
    if rc < 0 { out = 0 - 1 } else { fly.llvm.ptrReadLong(st, 48, out) }
    fly.runtime.free(st)
}

public void fs_lmode(const pointer path, int out) {
    pointer st = 0
    fly.runtime.malloc(144, st)
    int rc = 0
    fly.runtime.lstat(path, st, rc)
    if rc < 0 { out = 0 - 1 } else { fly.llvm.ptrReadInt(st, 24, out) }
    fly.runtime.free(st)
}

// mtime helpers — last-modification time as TOTAL NANOSECONDS since the Unix
// epoch in one i64 (sec = out/1e9, nsec = out%1e9; splitting is the caller's
// job so the primitive keeps a single out). st_mtim: tv_sec @ 88, tv_nsec @ 96.
// -1 on a failed stat.
public void fs_mtime(const pointer path, long out) {
    pointer st = 0
    fly.runtime.malloc(144, st)
    int rc = 0
    fly.runtime.stat(path, st, rc)
    if rc < 0 { out = 0 - 1 } else {
        long sec = 0
        long nsec = 0
        fly.llvm.ptrReadLong(st, 88, sec)
        fly.llvm.ptrReadLong(st, 96, nsec)
        out = sec * 1000000000 + nsec
    }
    fly.runtime.free(st)
}

public void fs_lmtime(const pointer path, long out) {
    pointer st = 0
    fly.runtime.malloc(144, st)
    int rc = 0
    fly.runtime.lstat(path, st, rc)
    if rc < 0 { out = 0 - 1 } else {
        long sec = 0
        long nsec = 0
        fly.llvm.ptrReadLong(st, 88, sec)
        fly.llvm.ptrReadLong(st, 96, nsec)
        out = sec * 1000000000 + nsec
    }
    fly.runtime.free(st)
}

// ── Time — clock_gettime / nanosleep (timespec { i64 sec@0, i64 nsec@8 }) ──────
public void time_now_ns(long out) {
    pointer ts = 0
    fly.runtime.malloc(16, ts)
    int rc = 0
    fly.runtime.clock_gettime(0, ts, rc)
    long sec = 0
    long nsec = 0
    fly.llvm.ptrReadLong(ts, 0, sec)
    fly.llvm.ptrReadLong(ts, 8, nsec)
    out = sec * 1000000000 + nsec
    fly.runtime.free(ts)
}

public void time_mono_ns(long out) {
    pointer ts = 0
    fly.runtime.malloc(16, ts)
    int rc = 0
    fly.runtime.clock_gettime(1, ts, rc)
    long sec = 0
    long nsec = 0
    fly.llvm.ptrReadLong(ts, 0, sec)
    fly.llvm.ptrReadLong(ts, 8, nsec)
    out = sec * 1000000000 + nsec
    fly.runtime.free(ts)
}

public void time_sleep(const long sec, const long nsec) {
    pointer ts = 0
    fly.runtime.malloc(16, ts)
    fly.llvm.ptrPokeLong(ts, 0, sec)
    fly.llvm.ptrPokeLong(ts, 8, nsec)
    int rc = 0
    fly.runtime.nanosleep(ts, 0, rc)
    fly.runtime.free(ts)
}

// ── Environment ──────────────────────────────────────────────────────────────
//
// Fly has no working global/static storage (static class fields miscompile to an
// undefined symbol, and there are no module globals), so the C runtime's
// g_argc/g_argv/environ-global pattern can't be mirrored. Instead:
//   • single lookups use libc directly (getenv/getcwd/uname) — no global needed;
//   • listing args/env reads /proc/self/{cmdline,environ} (NUL-separated records),
//     which needs no process-global state and no env_init.

// toCStr — copy a Fly string into a fresh NUL-terminated C buffer (malloc'd).
private void toCStr(const string s, pointer out) {
    int n = 0
    fly.llvm.strSize(s, n)
    pointer src = 0
    fly.llvm.strGetPtr(s, src)
    pointer buf = 0
    fly.runtime.malloc(n + 1, buf)
    int i = 0
    while i < n {
        byte b = 0
        fly.llvm.ptrByteAt(src, i, b)
        fly.llvm.ptrPokeByte(buf, i, b)
        i = i + 1
    }
    byte z = 0
    fly.llvm.ptrPokeByte(buf, n, z)
    out = buf
}

// procRead — read a whole /proc file into buf[0..cap); returns bytes read.
// /proc files report size 0, so read until EOF or the buffer fills.
private void procRead(const pointer cpath, const pointer buf, const long cap, long out) {
    int fd = 0
    fly.runtime.open(cpath, 0, 0, fd)
    if fd < 0 { out = 0  return }
    long total = 0
    long n = 1
    while n > 0 {
        long room = cap - total
        if room <= 0 { n = 0 } else {
            pointer at = buf + total
            fly.runtime.read(fd, at, room, n)
            if n > 0 { total = total + n }
        }
    }
    int rc = 0
    fly.runtime.close(fd, rc)
    out = total
}

// countNul — number of NUL-terminated records in buf[0..len).
private void countNul(const pointer buf, const long len, int out) {
    int c = 0
    long i = 0
    while i < len {
        byte b = 0
        fly.llvm.ptrReadByte(buf, i, b)
        if b == 0 { c = c + 1 }
        i = i + 1
    }
    out = c
}

// copyCStr — copy the NUL-terminated C string at src into dst[0..cap), truncated to
// cap-1 bytes; NUL-terminates dst; returns the number of bytes copied.
private void copyCStr(const pointer src, const pointer dst, const ulong cap, int out) {
    long capL = 0
    fly.llvm.ulongToLong(cap, capL)
    int limit = 0
    long capm1 = capL - 1
    fly.llvm.longToInt(capm1, limit)
    int i = 0
    bool go = true
    while go {
        if i >= limit { go = false } else {
            byte b = 0
            fly.llvm.ptrByteAt(src, i, b)
            if b == 0 { go = false } else {
                fly.llvm.ptrPokeByte(dst, i, b)
                i = i + 1
            }
        }
    }
    fly.llvm.ptrPokeByte(dst, i, 0)
    out = i
}

public void env_chdir(const pointer path, int out) {
    fly.runtime.chdir(path, out)
}

// env_get — copy the value of $key into buf; returns its length, or -1 if unset.
public void env_get(const pointer key, const pointer buf, const ulong size, int out) {
    pointer val = 0
    fly.runtime.getenv(key, val)
    if val == 0 {
        fly.llvm.ptrPokeByte(buf, 0, 0)
        out = 0 - 1
        return
    }
    copyCStr(val, buf, size, out)
}

// env_getcwd — current working directory into buf; returns its length, or -1.
public void env_getcwd(const pointer buf, const ulong cap, int out) {
    pointer r = 0
    fly.runtime.getcwd(buf, cap, r)
    if r == 0 {
        out = 0 - 1
        return
    }
    ulong len = 0
    fly.runtime.strlen(buf, len)
    long lenL = 0
    fly.llvm.ulongToLong(len, lenL)
    fly.llvm.longToInt(lenL, out)
}

// uname-backed host details. linux utsname = 6 × 65-byte NUL-terminated fields:
// sysname@0 nodename@65 release@130 version@195 machine@260 domainname@325.
private void unameField(const int offset, const pointer buf, const ulong size, int out) {
    pointer u = 0
    fly.runtime.malloc(390, u)
    int rc = 0
    fly.runtime.uname(u, rc)
    if rc < 0 {
        fly.llvm.ptrPokeByte(buf, 0, 0)
        out = 0 - 1
        fly.runtime.free(u)
        return
    }
    pointer field = u + offset
    copyCStr(field, buf, size, out)
    fly.runtime.free(u)
}

public void env_hostname(const pointer buf, const ulong size, int out) {
    unameField(65, buf, size, out)
}

public void env_arch(const pointer buf, const ulong size, int out) {
    unameField(260, buf, size, out)
}

public void env_kernel(const pointer buf, const ulong size, int out) {
    unameField(130, buf, size, out)
}

public void env_kernelversion(const pointer buf, const ulong size, int out) {
    unameField(195, buf, size, out)
}

public void env_osname(const pointer buf, const ulong size, int out) {
    pointer src = 0
    toCStr("linux", src)
    copyCStr(src, buf, size, out)
    fly.runtime.free(src)
}

// env_exe_path — absolute path of the running executable via readlink /proc/self/exe
// (readlink does not NUL-terminate, so reserve a byte and add it).
public void env_exe_path(const pointer buf, const ulong size, int out) {
    if size == 0 { out = 0 - 1  return }
    pointer cp = 0
    toCStr("/proc/self/exe", cp)
    long r = 0
    fly.runtime.readlink(cp, buf, size - 1, r)
    if r < 0 {
        fly.llvm.ptrPokeByte(buf, 0, 0)
        out = 0 - 1
    } else {
        int ri = 0
        fly.llvm.longToInt(r, ri)
        fly.llvm.ptrPokeByte(buf, ri, 0)
        out = ri
    }
    fly.runtime.free(cp)
}

// env_args_count / env_args_fill — from /proc/self/cmdline (arg0\0arg1\0…\0).
public void env_args_count(int out) {
    pointer cp = 0
    toCStr("/proc/self/cmdline", cp)
    pointer buf = 0
    fly.runtime.malloc(65536, buf)
    long len = 0
    procRead(cp, buf, 65536, len)
    countNul(buf, len, out)
    fly.runtime.free(buf)
    fly.runtime.free(cp)
}

public void env_args_fill(const pointer arr_base, const int count) {
    pointer cp = 0
    toCStr("/proc/self/cmdline", cp)
    pointer buf = 0
    fly.runtime.malloc(65536, buf)
    long len = 0
    procRead(cp, buf, 65536, len)
    // Walk NUL-separated records; for each, malloc a copy and set the slot.
    int idx = 0
    long start = 0
    long i = 0
    while i < len {
        byte b = 0
        fly.llvm.ptrReadByte(buf, i, b)
        if b == 0 {
            if idx < count {
                long slen = i - start
                int isl = 0
                fly.llvm.longToInt(slen, isl)
                pointer dst = 0
                fly.runtime.malloc(slen + 1, dst)
                long j = 0
                while j < slen {
                    byte cb = 0
                    pointer sp = buf + start
                    fly.llvm.ptrReadByte(sp, j, cb)
                    int ij = 0
                    fly.llvm.longToInt(j, ij)
                    fly.llvm.ptrPokeByte(dst, ij, cb)
                    j = j + 1
                }
                fly.llvm.ptrPokeByte(dst, isl, 0)
                fly.runtime.str_slot_set(arr_base, idx, dst, isl)
            }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    fly.runtime.free(buf)
    fly.runtime.free(cp)
}

// env_all_count / env_all_fill — from /proc/self/environ (KEY=VAL\0KEY=VAL\0…).
public void env_all_count(int out) {
    pointer cp = 0
    toCStr("/proc/self/environ", cp)
    pointer buf = 0
    fly.runtime.malloc(65536, buf)
    long len = 0
    procRead(cp, buf, 65536, len)
    countNul(buf, len, out)
    fly.runtime.free(buf)
    fly.runtime.free(cp)
}

public void env_all_fill(const pointer arr_base, const int count) {
    pointer cp = 0
    toCStr("/proc/self/environ", cp)
    pointer buf = 0
    fly.runtime.malloc(65536, buf)
    long len = 0
    procRead(cp, buf, 65536, len)
    int idx = 0
    long start = 0
    long i = 0
    while i < len {
        byte b = 0
        fly.llvm.ptrReadByte(buf, i, b)
        if b == 0 {
            if idx < count {
                long slen = i - start
                int isl = 0
                fly.llvm.longToInt(slen, isl)
                pointer dst = 0
                fly.runtime.malloc(slen + 1, dst)
                long j = 0
                while j < slen {
                    byte cb = 0
                    pointer sp = buf + start
                    fly.llvm.ptrReadByte(sp, j, cb)
                    int ij = 0
                    fly.llvm.longToInt(j, ij)
                    fly.llvm.ptrPokeByte(dst, ij, cb)
                    j = j + 1
                }
                fly.llvm.ptrPokeByte(dst, isl, 0)
                fly.runtime.str_slot_set(arr_base, idx, dst, isl)
            }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    fly.runtime.free(buf)
    fly.runtime.free(cp)
}

// env_init — the reference compiler's main wrapper calls this; the /proc-based
// arg/env access needs no stored state, so it is a no-op (kept non-empty so it
// emits as a defined C-ABI symbol rather than an unresolved extern).
public void env_init(const int argc, const pointer argv) {
    int unused = argc
}

public void env_set(const pointer key, const pointer val, int out) {
    fly.runtime.setenv(key, val, 1, out)
}

public void env_delete(const pointer key, int out) {
    fly.runtime.unsetenv(key, out)
}

// ── Process / concurrency ─────────────────────────────────────────────────────
//
// proc_exec: fork + execv (execv inherits the current environ, so no environ
// global is needed) + waitpid, decoding the wait status like the C runtime.
public void proc_exec(const pointer path, const pointer argv, int out) {
    int pid = 0
    fly.runtime.fork(pid)
    if pid < 0 { out = 0 - 1  return }
    if pid == 0 {
        int rc = 0
        fly.runtime.execv(path, argv, rc)   // returns only on failure
        fly.runtime.exit(127)
    }
    pointer status = 0
    fly.runtime.malloc(4, status)
    int r = 0
    fly.runtime.waitpid(pid, status, 0, r)
    if r < 0 { fly.runtime.free(status)  out = 0 - 1  return }
    int st = 0
    fly.llvm.ptrReadInt(status, 0, st)
    fly.runtime.free(status)
    int low = st & 127
    if low == 0 {                 // WIFEXITED
        int ex = st >> 8
        out = ex & 255            // WEXITSTATUS
    } else {
        out = 128 + low           // killed by signal: 128 + signo
    }
}

// proc_exec_redirect — proc_exec with the child's STDOUT redirected to outPath
// (created/truncated), so a caller can capture a command's output with NO SHELL
// involved. Returns the child exit code, 128+signo if signalled, -1 on failure.
//
// This is what makes command capture work at all on Windows, where the previous
// approach — `sh -c "cmd > file"` — cannot run: there is no /bin/sh, and the
// runtime's CreateProcessA normalises arg0 '/'→'\' into a nonexistent `\bin\sh`.
//
// STDERR IS INHERITED, deliberately, where the shell version sent it to
// /dev/null: a failing command's diagnostics should reach the user rather than
// vanish. The commands this serves (git rev-parse, git ls-remote) are quiet on
// success.
//
// O_WRONLY|O_CREAT|O_TRUNC is 1|64|512 = 577 on Linux; the BSD values differ, so
// this constant is per-backend (see RuntimeMacos.fly).
public void proc_exec_redirect(const pointer path, const pointer argv, const pointer outPath, int out) {
    int pid = 0
    fly.runtime.fork(pid)
    if pid < 0 { out = 0 - 1  return }
    if pid == 0 {
        int fd = 0
        fly.runtime.open(outPath, 577, 420, fd)
        if fd < 0 { fly.runtime.exit(127) }
        int d = 0
        fly.runtime.dup2(fd, 1, d)
        int cr = 0
        fly.runtime.close(fd, cr)
        int rc = 0
        fly.runtime.execv(path, argv, rc)   // returns only on failure
        fly.runtime.exit(127)
    }
    pointer status = 0
    fly.runtime.malloc(4, status)
    int r = 0
    fly.runtime.waitpid(pid, status, 0, r)
    if r < 0 { fly.runtime.free(status)  out = 0 - 1  return }
    int st = 0
    fly.llvm.ptrReadInt(status, 0, st)
    fly.runtime.free(status)
    int low = st & 127
    if low == 0 {
        int ex = st >> 8
        out = ex & 255
    } else {
        out = 128 + low
    }
}

// thread_spawn → pthread_create (inherits stack/env); returns the pthread_t handle
// (truncated to int) on success, -1 on failure. Detached-style spawn: not joined.
public void thread_spawn(const pointer fn, const pointer arg, const ulong stackSize, int out) {
    pointer th = 0
    fly.runtime.malloc(8, th)
    int rc = 0
    fly.runtime.pthread_create(th, 0, fn, arg, rc)
    if rc == 0 {
        long t = 0
        fly.llvm.ptrReadLong(th, 0, t)
        fly.llvm.longToInt(t, out)
    } else {
        out = 0 - 1
    }
    fly.runtime.free(th)
}

// futex via the libc syscall() wrapper (SYS_futex = 202; FUTEX_WAIT=0, FUTEX_WAKE=1).
public void futex_wait(const pointer addr, const int expected) {
    long e = expected
    long r = 0
    fly.runtime.syscall(202, addr, 0, e, 0, 0, r)      // a1 = uaddr (pointer, no cast)
}

public void futex_wake(const pointer addr, const int count, int out) {
    long c = count
    long r = 0
    fly.runtime.syscall(202, addr, 1, c, 0, 0, r)      // a1 = uaddr (pointer, no cast)
    fly.llvm.longToInt(r, out)
}

// atomics via libatomic; memorders RELAXED=0 ACQUIRE=2 RELEASE=3 ACQ_REL=4.
public void atomic_load_i32(const pointer addr, int out) {
    fly.runtime.__atomic_load_4(addr, 2, out)
}

public void atomic_store_i32(const pointer addr, const int val) {
    fly.runtime.__atomic_store_4(addr, val, 3)
}

// atomic_cas returns the witnessed value (matches the C __atomic_compare_exchange
// contract: expected is updated to the actual value on failure). The 4-byte temp
// holds `expected` by pointer as the library entry point requires.
public void atomic_cas_i32(const pointer addr, const int expected, const int desired, int out) {
    pointer exp = 0
    fly.runtime.malloc(4, exp)
    fly.llvm.ptrPokeInt(exp, 0, expected)
    bool ok = false
    fly.runtime.__atomic_compare_exchange_4(addr, exp, desired, 0, 4, 2, ok)
    fly.llvm.ptrReadInt(exp, 0, out)
    fly.runtime.free(exp)
}

public void atomic_fetch_add_i32(const pointer addr, const int delta, int out) {
    fly.runtime.__atomic_fetch_add_4(addr, delta, 4, out)
}

// ── Networking — IPv4 TCP over the BSD sockets API ────────────────────────────
//
// A socket handle is a `long`, and NEGATIVE means invalid. That one sentinel
// covers every platform: POSIX returns an int fd with -1 on error, Windows
// returns a 64-bit SOCKET whose INVALID_SOCKET is all-ones — i.e. -1 read as a
// signed 64. The externs above return `int`, so the value is widened here.
//
// An address is a packed HOST-order int (a<<24|b<<16|c<<8|d, so 127.0.0.1 is
// 2130706433) and a port is a host-order int. The sockaddr_in is filled byte by
// byte below, which writes network order directly: no htons, no inet_addr, and
// the code is endian-independent by construction.
//
//   sockaddr_in (16 bytes) — Linux: [0]=2 (AF_INET lo) [1]=0 [2..3]=port BE
//   [4..7]=addr BE [8..15]=zero.   (macOS instead puts sin_len=16 at [0].)
//   Linux constants: SOL_SOCKET=1, SO_REUSEADDR=2, MSG_NOSIGNAL=16384.
//
// The sockaddr construction is INLINED into net_bind and net_connect rather than
// factored into a helper: under flat C-ABI emission an internal fly→fly call that
// follows a ptrPokeByte store is miscompiled away (see the env_kernel note in
// RuntimeWindows.fly). Calling an EXTERN after the stores — which is what bind()
// and connect() are — is safe.
//
// MSG_NOSIGNAL on every send is not optional: without it a send() to a peer that
// already closed raises SIGPIPE and KILLS the process, which in a test suite
// looks like a silent disappearance rather than a failure.

// net_init — nothing to do on POSIX; always 0. Exists so a caller can fail early
// on Windows, where it drives WSAStartup.
public void net_init(int out) {
    out = 0
}

// net_socket — a blocking IPv4 TCP socket; <0 on failure.
public void net_socket(long out) {
    int fd = 0
    fly.runtime.socket(2, 1, 6, fd)                 // AF_INET, SOCK_STREAM, IPPROTO_TCP
    if fd < 0 { out = 0 - 1  return }
    out = fd
}

public void net_close(const long s) {
    if s < 0 { return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    int rc = 0
    fly.runtime.close(fd, rc)
}

// net_shutdown — how: 0=read 1=write 2=both. 0 ok, -1 error.
public void net_shutdown(const long s, const int how, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    int rc = 0
    fly.runtime.shutdown(fd, how, rc)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_reuseaddr — SO_REUSEADDR, so a port in TIME_WAIT can be rebound.
public void net_reuseaddr(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer one = 0
    fly.runtime.malloc(4, one)
    fly.llvm.ptrPokeInt(one, 0, 1)
    int rc = 0
    fly.runtime.setsockopt(fd, 1, 2, one, 4, rc)    // SOL_SOCKET, SO_REUSEADDR
    fly.runtime.free(one)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// ── Socket options ────────────────────────────────────────────────────────────
//
// EVERY constant below differs across the three platforms and is therefore
// hardcoded per backend, never passed down from std — std/lib/net/net.fly is ONE
// source compiled for all targets and cannot know them.
//
//   Linux:   SOL_SOCKET=1   SO_ERROR=4   SO_BROADCAST=6  SO_SNDBUF=7
//            SO_RCVBUF=8    SO_KEEPALIVE=9  SO_LINGER=13
//            SO_RCVTIMEO=20 SO_SNDTIMEO=21
//   BSD/macOS/Windows use an entirely different numbering (SO_RCVBUF=4098, …).
//   IPPROTO_TCP=6 and TCP_NODELAY=1 are the only ones that agree everywhere.
//
// setIntOpt is a private helper rather than six copies: the poke-then-internal-
// call miscompile only bites when the CALL FOLLOWS a store in the SAME body, and
// here every store happens inside the helper, after the call into it.

private void setIntOpt(const long s, const int level, const int opt, const int val, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer p = 0
    fly.runtime.malloc(4, p)
    fly.llvm.ptrPokeInt(p, 0, val)
    int rc = 0
    fly.runtime.setsockopt(fd, level, opt, p, 4, rc)
    fly.runtime.free(p)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_set_nodelay — TCP_NODELAY: send small writes immediately (Nagle off).
public void net_set_nodelay(const long s, const int on, int out) {
    setIntOpt(s, 6, 1, on, out)
}

public void net_set_keepalive(const long s, const int on, int out) {
    setIntOpt(s, 1, 9, on, out)
}

public void net_set_broadcast(const long s, const int on, int out) {
    setIntOpt(s, 1, 6, on, out)
}

public void net_set_recvbuf(const long s, const int bytes, int out) {
    setIntOpt(s, 1, 8, bytes, out)
}

public void net_set_sendbuf(const long s, const int bytes, int out) {
    setIntOpt(s, 1, 7, bytes, out)
}

// net_set_recv_timeout / net_set_send_timeout — a blocking recv/send gives up
// after `ms` milliseconds instead of waiting forever. ms <= 0 restores the
// infinite wait.
//
// POSIX takes a `struct timeval` (16 bytes: tv_sec i64@0, tv_usec i64@8 on
// Linux) where Windows takes a bare DWORD of milliseconds — same Fly signature,
// completely different payload.
private void setTimeout(const long s, const int ms, const int opt, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    int msec = ms
    if msec < 0 { msec = 0 }
    long secs = msec / 1000
    long usecs = (msec % 1000) * 1000
    pointer tv = 0
    fly.runtime.malloc(16, tv)
    fly.llvm.ptrPokeLong(tv, 0, secs)
    fly.llvm.ptrPokeLong(tv, 8, usecs)
    int rc = 0
    fly.runtime.setsockopt(fd, 1, opt, tv, 16, rc)
    fly.runtime.free(tv)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

public void net_set_recv_timeout(const long s, const int ms, int out) {
    setTimeout(s, ms, 20, out)                      // SO_RCVTIMEO
}

public void net_set_send_timeout(const long s, const int ms, int out) {
    setTimeout(s, ms, 21, out)                      // SO_SNDTIMEO
}

// net_set_linger — SO_LINGER. POSIX: struct linger { int l_onoff; int l_linger }
// (8 bytes). Windows uses two u_shorts (4 bytes) — see RuntimeWindows.fly.
public void net_set_linger(const long s, const int on, const int sec, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer lg = 0
    fly.runtime.malloc(8, lg)
    fly.llvm.ptrPokeInt(lg, 0, on)
    fly.llvm.ptrPokeInt(lg, 4, sec)
    int rc = 0
    fly.runtime.setsockopt(fd, 1, 13, lg, 8, rc)    // SOL_SOCKET, SO_LINGER
    fly.runtime.free(lg)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_set_nonblocking — POSIX toggles O_NONBLOCK (2048 on Linux, 4 on BSD) in
// the descriptor flags with fcntl; Windows uses ioctlsocket(FIONBIO).
public void net_set_nonblocking(const long s, const int on, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    int flags = 0
    fly.runtime.fcntl(fd, 3, 0, flags)              // F_GETFL
    if flags < 0 { out = 0 - 1  return }
    // Clearing the bit is a SUBTRACTION, not `flags & ~O_NONBLOCK`: Fly has no
    // hex literals and 0xFFFFF7FF exceeds 2^31, so the mask would be typed long.
    // The guard is a named bool because `flags & 2048 != 0` parses as
    // `flags & (2048 != 0)` — comparison binds TIGHTER than the bitwise ops.
    int want = flags
    int masked = flags & 2048
    if on != 0 {
        want = flags | 2048
    } elsif masked != 0 {
        want = flags - 2048
    }
    int rc = 0
    fly.runtime.fcntl(fd, 4, want, rc)              // F_SETFL
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_sock_error — the pending SO_ERROR, cleared by the read. 0 = none, and -1
// only when the query itself failed. This is how a non-blocking connect reports
// its outcome.
public void net_sock_error(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer v = 0
    fly.runtime.malloc(4, v)
    pointer vlen = 0
    fly.runtime.malloc(4, vlen)
    fly.llvm.ptrPokeInt(vlen, 0, 4)
    fly.llvm.ptrPokeInt(v, 0, 0)
    int rc = 0
    fly.runtime.getsockopt(fd, 1, 4, v, vlen, rc)   // SOL_SOCKET, SO_ERROR
    int val = 0
    fly.llvm.ptrReadInt(v, 0, val)
    fly.runtime.free(v)
    fly.runtime.free(vlen)
    if rc < 0 { out = 0 - 1 } else { out = val }
}

// net_bind — attach to addr:port. port 0 asks the kernel for an ephemeral one.
public void net_bind(const long s, const int addr, const int port, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    int z = 0
    while z < 16 {
        fly.llvm.ptrPokeByte(sa, z, 0)
        z = z + 1
    }
    fly.llvm.ptrPokeByte(sa, 0, 2)                  // AF_INET, low byte
    fly.llvm.ptrPokeByte(sa, 2, (byte)((port >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 3, (byte)(port & 255))
    fly.llvm.ptrPokeByte(sa, 4, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(sa, 5, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(sa, 6, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 7, (byte)(addr & 255))
    int rc = 0
    fly.runtime.bind(fd, sa, 16, rc)
    fly.runtime.free(sa)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

public void net_listen(const long s, const int backlog, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    int rc = 0
    fly.runtime.listen(fd, backlog, rc)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_accept — block until a connection arrives; the new socket, <0 on error.
public void net_accept(const long s, long out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    int cfd = 0
    fly.runtime.accept(fd, 0, 0, cfd)
    if cfd < 0 { out = 0 - 1  return }
    out = cfd
}

public void net_connect(const long s, const int addr, const int port, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    int z = 0
    while z < 16 {
        fly.llvm.ptrPokeByte(sa, z, 0)
        z = z + 1
    }
    fly.llvm.ptrPokeByte(sa, 0, 2)                  // AF_INET, low byte
    fly.llvm.ptrPokeByte(sa, 2, (byte)((port >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 3, (byte)(port & 255))
    fly.llvm.ptrPokeByte(sa, 4, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(sa, 5, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(sa, 6, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 7, (byte)(addr & 255))
    int rc = 0
    fly.runtime.connect(fd, sa, 16, rc)
    fly.runtime.free(sa)
    if rc < 0 { out = 0 - 1 } else { out = 0 }
}

// net_send — ONE send attempt. Returns the byte count actually written, which
// may be LESS than n; <0 on error. The caller loops (fly.net.sendAll does).
public void net_send(const long s, const pointer buf, const int n, long out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    long sent = 0
    fly.runtime.send(fd, buf, n, 16384, sent)       // MSG_NOSIGNAL
    out = sent
}

// net_recv — ONE blocking receive of up to n bytes. >0 = bytes, 0 = orderly peer
// shutdown (EOF), <0 = error.
public void net_recv(const long s, const pointer buf, const int n, long out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    long got = 0
    fly.runtime.recv(fd, buf, n, 0, got)
    out = got
}

// net_local_port — the port the socket is really bound to (host order); -1 on
// error. This is what makes an ephemeral bind (port 0) usable.
public void net_local_port(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int rc = 0
    fly.runtime.getsockname(fd, sa, alen, rc)
    if rc < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = 0 - 1
        return
    }
    byte hi = 0
    byte lo = 0
    fly.llvm.ptrByteAt(sa, 2, hi)
    fly.llvm.ptrByteAt(sa, 3, lo)
    int h = hi & 255
    int l = lo & 255
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = (h << 8) | l
}

// ── UDP datagrams ─────────────────────────────────────────────────────────────
//
// SOCK_DGRAM=2 and IPPROTO_UDP=17 on every platform. The only real difference
// from the TCP path is that the destination travels WITH each datagram, so
// net_send_to builds a sockaddr per call and net_recv_from reads one back.
//
// The sender is reported through a caller-provided 8-byte scratch, OUR layout:
//   [0..3] int packed host-order address   [4..7] int port
// One out-pointer instead of two out-params, matching the std rule that a
// primitive has exactly one `out`.

// net_socket_udp — a blocking IPv4 UDP socket; <0 on failure.
public void net_socket_udp(long out) {
    int fd = 0
    fly.runtime.socket(2, 2, 17, fd)                // AF_INET, SOCK_DGRAM, IPPROTO_UDP
    if fd < 0 { out = 0 - 1  return }
    out = fd
}

// net_send_to — one datagram to addr:port. Returns the bytes accepted, <0 on
// error. A datagram is sent whole or not at all: there is no short write to loop
// over, unlike the TCP path.
public void net_send_to(const long s, const pointer buf, const int n, const int addr, const int port, long out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    int z = 0
    while z < 16 {
        fly.llvm.ptrPokeByte(sa, z, 0)
        z = z + 1
    }
    fly.llvm.ptrPokeByte(sa, 0, 2)                  // AF_INET, low byte
    fly.llvm.ptrPokeByte(sa, 2, (byte)((port >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 3, (byte)(port & 255))
    fly.llvm.ptrPokeByte(sa, 4, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(sa, 5, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(sa, 6, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(sa, 7, (byte)(addr & 255))
    long sent = 0
    fly.runtime.sendto(fd, buf, n, 16384, sa, 16, sent)     // MSG_NOSIGNAL
    fly.runtime.free(sa)
    out = sent
}

// net_recv_from — one datagram of up to n bytes, with the sender written into the
// 8-byte `from` scratch. Returns the byte count, 0 for an empty datagram (which
// is legal in UDP and is NOT end-of-stream), <0 on error or timeout.
//
// A datagram longer than n is TRUNCATED and the remainder discarded — that is
// UDP semantics, not a bug to work around.
public void net_recv_from(const long s, const pointer buf, const int n, const pointer from, long out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    long got = 0
    fly.runtime.recvfrom(fd, buf, n, 0, sa, alen, got)
    if got < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = got
        return
    }
    byte b0 = 0
    byte b1 = 0
    byte b2 = 0
    byte b3 = 0
    byte ph = 0
    byte pl = 0
    fly.llvm.ptrByteAt(sa, 4, b0)
    fly.llvm.ptrByteAt(sa, 5, b1)
    fly.llvm.ptrByteAt(sa, 6, b2)
    fly.llvm.ptrByteAt(sa, 7, b3)
    fly.llvm.ptrByteAt(sa, 2, ph)
    fly.llvm.ptrByteAt(sa, 3, pl)
    int i0 = b0 & 255
    int i1 = b1 & 255
    int i2 = b2 & 255
    int i3 = b3 & 255
    int hp = ph & 255
    int lp = pl & 255
    fly.llvm.ptrPokeInt(from, 0, (i0 << 24) | (i1 << 16) | (i2 << 8) | i3)
    fly.llvm.ptrPokeInt(from, 4, (hp << 8) | lp)
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = got
}

// ── HTTPS: not served here ────────────────────────────────────────────────────
//
// Windows has no generic TLS socket backend, so it serves https through WinHTTP,
// a complete HTTP client. On POSIX that indirection is unnecessary: fly.net.tls
// over OpenSSL is a real transport, and fly.net.http builds the exchange on top
// of it. These stubs exist so the primitive set stays identical across backends
// and fly.net.http can dispatch on net_https_available() rather than on the
// platform name.
public void net_https_available(int out) {
    out = 0
}

public void net_https_request(const pointer verb, const pointer host, const int port,
                             const pointer path, const pointer headers,
                             const pointer bodyIn, const int bodyInLen,
                             const pointer outPath, int out) {
    out = 0 - 1
}

// ── Multiplexing, peer address and full DNS ──────────────────────────────────
//
// net_poll takes OUR OWN entry array — 16 bytes per entry, identical on every
// platform — and translates it into the native one here:
//
//   Fly entry (16 B):  [0..7] long socket   [8..11] int events   [12..15] int revents
//   POSIX pollfd (8 B): int fd@0, short events@4, short revents@6
//   WSAPOLLFD  (16 B):  SOCKET fd@0 (8 bytes!), short events@8, short revents@10
//
// The event BITS differ too, so the Fly-level mask (1=read 2=write 4=err 8=hup)
// is mapped in and out per backend. Keeping both the layout and the bits inside
// the runtime is what lets std/lib/net/net.fly stay one portable source.
//   Linux: POLLIN=1 POLLOUT=4 POLLERR=8 POLLHUP=16 POLLNVAL=32.
public void net_poll(const pointer entries, const int count, const int timeoutMs, int out) {
    if count <= 0 { out = 0  return }
    pointer fds = 0
    fly.runtime.malloc(count * 8, fds)
    int i = 0
    while i < count {
        long sv = 0
        fly.llvm.ptrReadLong(entries, i * 16, sv)
        int fd = 0
        fly.llvm.longToInt(sv, fd)
        int ev = 0
        fly.llvm.ptrReadInt(entries, i * 16 + 8, ev)
        int nev = 0
        int rd = ev & 1
        int wr = ev & 2
        if rd != 0 { nev = nev | 1 }                 // POLLIN
        if wr != 0 { nev = nev | 4 }                 // POLLOUT
        fly.llvm.ptrPokeInt(fds, i * 8, fd)
        fly.llvm.ptrPokeShort(fds, i * 8 + 4, (short)nev)
        fly.llvm.ptrPokeShort(fds, i * 8 + 6, 0)
        i = i + 1
    }
    int rc = 0
    fly.runtime.poll(fds, count, timeoutMs, rc)
    int j = 0
    while j < count {
        short rv = 0
        fly.llvm.ptrReadShort(fds, j * 8 + 6, rv)
        int rvi = rv
        int nrv = rvi & 65535
        int frv = 0
        int m1 = nrv & 1
        int m2 = nrv & 4
        int m3 = nrv & 8
        int m4 = nrv & 16
        int m5 = nrv & 32
        if m1 != 0 { frv = frv | 1 }
        if m2 != 0 { frv = frv | 2 }
        if m3 != 0 { frv = frv | 4 }
        if m4 != 0 { frv = frv | 8 }
        if m5 != 0 { frv = frv | 4 }                 // POLLNVAL folded into "error"
        fly.llvm.ptrPokeInt(entries, j * 16 + 12, frv)
        j = j + 1
    }
    fly.runtime.free(fds)
    out = rc
}

// net_peer_addr / net_peer_port — who is on the other end of a connected
// socket, via getpeername. 0 / -1 when the socket is not connected. Without
// these a server can accept a connection but never learn who made it.
public void net_peer_addr(const long s, int out) {
    if s < 0 { out = 0  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int rc = 0
    fly.runtime.getpeername(fd, sa, alen, rc)
    if rc < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = 0
        return
    }
    byte b0 = 0
    byte b1 = 0
    byte b2 = 0
    byte b3 = 0
    fly.llvm.ptrByteAt(sa, 4, b0)
    fly.llvm.ptrByteAt(sa, 5, b1)
    fly.llvm.ptrByteAt(sa, 6, b2)
    fly.llvm.ptrByteAt(sa, 7, b3)
    int i0 = b0 & 255
    int i1 = b1 & 255
    int i2 = b2 & 255
    int i3 = b3 & 255
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = (i0 << 24) | (i1 << 16) | (i2 << 8) | i3
}

public void net_peer_port(const long s, int out) {
    if s < 0 { out = 0 - 1  return }
    int fd = 0
    fly.llvm.longToInt(s, fd)
    pointer sa = 0
    fly.runtime.malloc(16, sa)
    pointer alen = 0
    fly.runtime.malloc(4, alen)
    fly.llvm.ptrPokeInt(alen, 0, 16)
    int rc = 0
    fly.runtime.getpeername(fd, sa, alen, rc)
    if rc < 0 {
        fly.runtime.free(sa)
        fly.runtime.free(alen)
        out = 0 - 1
        return
    }
    byte hi = 0
    byte lo = 0
    fly.llvm.ptrByteAt(sa, 2, hi)
    fly.llvm.ptrByteAt(sa, 3, lo)
    int h = hi & 255
    int l = lo & 255
    fly.runtime.free(sa)
    fly.runtime.free(alen)
    out = (h << 8) | l
}

// net_resolve_all — every A record for `host`, written as packed host-order ints
// into a caller-provided buffer of `maxCount` slots. Returns the number written,
// or -1 on failure. Walks hostent.h_addr_list past index 0, which net_resolve4
// stops at; the list is NULL-terminated.
public void net_resolve_all(const pointer host, const pointer buf, const int maxCount, int out) {
    pointer he = 0
    fly.runtime.gethostbyname(host, he)
    if he == 0 { out = 0 - 1  return }
    long lstl = 0
    fly.llvm.ptrReadLong(he, 24, lstl)               // h_addr_list
    pointer lst = 0
    lst = lstl
    if lst == 0 { out = 0 - 1  return }
    int n = 0
    bool go = true
    while go {
        if n >= maxCount { go = false } else {
            long al = 0
            fly.llvm.ptrReadLong(lst, n * 8, al)
            pointer a = 0
            a = al
            if a == 0 { go = false } else {
                byte b0 = 0
                byte b1 = 0
                byte b2 = 0
                byte b3 = 0
                fly.llvm.ptrByteAt(a, 0, b0)
                fly.llvm.ptrByteAt(a, 1, b1)
                fly.llvm.ptrByteAt(a, 2, b2)
                fly.llvm.ptrByteAt(a, 3, b3)
                int i0 = b0 & 255
                int i1 = b1 & 255
                int i2 = b2 & 255
                int i3 = b3 & 255
                int packed = (i0 << 24) | (i1 << 16) | (i2 << 8) | i3
                fly.llvm.ptrPokeInt(buf, n * 4, packed)
                n = n + 1
            }
        }
    }
    out = n
}

// net_reverse_dns — the host name for a packed IPv4, written NUL-free into buf.
// Returns the byte length, or -1 when the address has no PTR record. AF_INET is
// 2 and an IPv4 address is 4 bytes, on every platform.
public void net_reverse_dns(const int addr, const pointer buf, const int cap, int out) {
    pointer raw = 0
    fly.runtime.malloc(4, raw)
    fly.llvm.ptrPokeByte(raw, 0, (byte)((addr >> 24) & 255))
    fly.llvm.ptrPokeByte(raw, 1, (byte)((addr >> 16) & 255))
    fly.llvm.ptrPokeByte(raw, 2, (byte)((addr >> 8) & 255))
    fly.llvm.ptrPokeByte(raw, 3, (byte)(addr & 255))
    pointer he = 0
    fly.runtime.gethostbyaddr(raw, 4, 2, he)
    fly.runtime.free(raw)
    if he == 0 { out = 0 - 1  return }
    long nml = 0
    fly.llvm.ptrReadLong(he, 0, nml)                 // h_name
    pointer nm = 0
    nm = nml
    if nm == 0 { out = 0 - 1  return }
    ulong len = 0
    fly.runtime.strlen(nm, len)
    int n = 0
    fly.llvm.longToInt((long)len, n)
    if n >= cap { n = cap - 1 }
    if n < 0 { n = 0 }
    int i = 0
    while i < n {
        byte b = 0
        fly.llvm.ptrByteAt(nm, i, b)
        fly.llvm.ptrPokeByte(buf, i, b)
        i = i + 1
    }
    out = n
}

// net_resolve4 — host name → packed host-order IPv4; 0 on failure.
//
// gethostbyname, not getaddrinfo: addrinfo's field offsets differ on all three
// platforms, while hostent puts h_addr_list at offset 24 everywhere —
//   Linux/macOS: char *h_name@0, char **h_aliases@8, int h_addrtype@16,
//                int h_length@20, char **h_addr_list@24
//   Winsock2:    the same, with two shorts + padding filling 16..23.
// So this is two pointer dereferences and four bytes, once, instead of three
// hand-written struct layouts.
public void net_resolve4(const pointer host, int out) {
    pointer he = 0
    fly.runtime.gethostbyname(host, he)
    if he == 0 { out = 0  return }
    long lstl = 0
    fly.llvm.ptrReadLong(he, 24, lstl)              // h_addr_list
    pointer lst = 0
    lst = lstl
    if lst == 0 { out = 0  return }
    long a0l = 0
    fly.llvm.ptrReadLong(lst, 0, a0l)               // h_addr_list[0]
    pointer a0 = 0
    a0 = a0l
    if a0 == 0 { out = 0  return }
    byte b0 = 0
    byte b1 = 0
    byte b2 = 0
    byte b3 = 0
    fly.llvm.ptrByteAt(a0, 0, b0)
    fly.llvm.ptrByteAt(a0, 1, b1)
    fly.llvm.ptrByteAt(a0, 2, b2)
    fly.llvm.ptrByteAt(a0, 3, b3)
    int i0 = b0 & 255
    int i1 = b1 & 255
    int i2 = b2 & 255
    int i3 = b3 & 255
    out = (i0 << 24) | (i1 << 16) | (i2 << 8) | i3
}

// ── Fly string-array slot helpers (string slot = { i64 ptr, i32 size, i32 pad }) ─
public void str_slot_set(const pointer arr_base, const int idx, const pointer ptr, const int size) {
    int off = idx * 16
    fly.llvm.ptrPokeLong(arr_base, off, ptr)
    fly.llvm.ptrPokeInt(arr_base, off + 8, size)
    fly.llvm.ptrPokeInt(arr_base, off + 12, 0)
}

public void str_slot_ptr(const pointer arr_base, const int idx, pointer out) {
    int off = idx * 16
    long v = 0
    fly.llvm.ptrReadLong(arr_base, off, v)
    out = v
}

public void str_slot_size(const pointer arr_base, const int idx, int out) {
    int off = idx * 16
    fly.llvm.ptrReadInt(arr_base, off + 8, out)
}

// ── Error / suite-runner reporting ───────────────────────────────────────────
// Mirrors the reference runtime/platform/{Err,Suite}.c. Called ONLY by
// compiler-generated code: err_print by main's epilogue for an unhandled
// error, suite_* by the implicit main() of a `suite` binary.

// Write the NUL-terminated C string at s to fd (no-op for null/empty).
private void wrCStr(const int fd, const pointer s) {
    if s == 0 { return }
    int n = 0
    bool go = true
    while go {
        byte b = 0
        fly.llvm.ptrByteAt(s, n, b)
        if b == 0 { go = false } else { n = n + 1 }
    }
    if n == 0 { return }
    long w = 0
    fly.runtime.io_write(fd, s, (ulong)n, w)
}

// Write a string literal to fd.
private void wrLit(const int fd, const string s) {
    pointer p = 0
    toCStr(s, p)
    wrCStr(fd, p)
    fly.runtime.free(p)
}

// Write a single newline to fd (Fly string literals keep escapes raw).
private void wrNl(const int fd) {
    pointer p = 0
    fly.runtime.malloc(1, p)
    fly.llvm.ptrPokeByte(p, 0, 10)
    long w = 0
    fly.runtime.io_write(fd, p, 1, w)
    fly.runtime.free(p)
}

// Write v in decimal to fd.
private void wrDec(const int fd, const int v) {
    pointer buf = 0
    fly.runtime.malloc(12, buf)
    int mag = v
    bool neg = v < 0
    if neg { mag = 0 - mag }
    int len = 0
    int t = mag
    if t == 0 { len = 1 } else {
        while t > 0 {
            len = len + 1
            t = t / 10
        }
    }
    int pos = len
    if neg { pos = pos + 1 }
    int i = pos - 1
    t = mag
    if t == 0 {
        fly.llvm.ptrPokeByte(buf, i, 48)
    } else {
        while t > 0 {
            int d = t - (t / 10) * 10
            fly.llvm.ptrPokeByte(buf, i, 48 + d)
            i = i - 1
            t = t / 10
        }
    }
    if neg { fly.llvm.ptrPokeByte(buf, 0, 45) }
    long w = 0
    fly.runtime.io_write(fd, buf, (ulong)pos, w)
    fly.runtime.free(buf)
}

// " FAIL(<code>)[: <msg>]" + newline — shared tail of a failed case/step line.
private void wrFail(const int code, const pointer msg) {
    wrLit(1, " FAIL(")
    wrDec(1, code)
    wrLit(1, ")")
    if msg != 0 {
        byte b0 = 0
        fly.llvm.ptrByteAt(msg, 0, b0)
        if b0 != 0 {
            wrLit(1, ": ")
            wrCStr(1, msg)
        }
    }
    wrNl(1)
}

// Print "error <code>[: <msg>]" to stderr — unhandled error reaching main().
public void err_print(const int code, const pointer msg) {
    wrLit(2, "error ")
    wrDec(2, code)
    if msg != 0 {
        byte b0 = 0
        fly.llvm.ptrByteAt(msg, 0, b0)
        if b0 != 0 {
            wrLit(2, ": ")
            wrCStr(2, msg)
        }
    }
    wrNl(2)
}

public void suite_begin(const pointer name) {
    wrLit(1, "suite ")
    wrCStr(1, name)
    wrNl(1)
}

public void suite_method(const pointer name) {
    wrLit(1, "  ")
    wrCStr(1, name)
    wrNl(1)
}

// No newline: the case result (or a crash) completes the line.
public void suite_case_begin(const pointer label) {
    wrLit(1, "    ")
    wrCStr(1, label)
    wrLit(1, " ...")
}

public void suite_case_result(const int code, const pointer msg) {
    if code == 0 {
        wrLit(1, " ok")
        wrNl(1)
        return
    }
    wrFail(code, msg)
}

public void suite_step_fail(const pointer label, const int code, const pointer msg) {
    wrLit(1, "    ")
    wrCStr(1, label)
    wrLit(1, " ...")
    wrFail(code, msg)
}

public void suite_end(const pointer name, const int total, const int failed) {
    wrLit(1, "suite ")
    wrCStr(1, name)
    wrLit(1, ": ")
    wrDec(1, total)
    wrLit(1, " cases, ")
    wrDec(1, total - failed)
    wrLit(1, " passed, ")
    wrDec(1, failed)
    wrLit(1, " failed")
    wrNl(1)
}
