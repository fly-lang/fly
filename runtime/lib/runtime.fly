namespace fly.runtime

// ─────────────────────────────────────────────────────────────────────────────
// Fly runtime — Linux/POSIX backend, implemented in Fly over libc/libm (Rust-style
// FFI). OS access is via extern-C calls to the C library, NOT raw syscalls: every
// empty-body function below is a pure libc/libm symbol (lowered to `call @name`,
// resolved by -lc/-lm at link); the bodied functions are the fly.runtime API,
// emitted as unmangled C-ABI symbols (see CodeGenFunction C-ABI mode).
//
// Status: cleanly-portable subset (mem, io, fs, time, proc_exit, basic env,
// str_slot). The environ/argv-iteration env_* helpers and the concurrency
// primitives (thread_spawn/futex/atomics) and proc_exec are still served by the C
// runtime archive until ported — this file does not yet replace it wholesale.
// ─────────────────────────────────────────────────────────────────────────────

// ── libc externs (empty body → pure `call @name`, resolved by -lc/-lm) ────────
public void malloc(const ulong size, pointer out) {}
public void free(const pointer ptr) {}
public void realloc(const pointer ptr, const ulong size, pointer out) {}
public void write(const int fd, const pointer buf, const ulong count, long out) {}
public void read(const int fd, const pointer buf, const ulong count, long out) {}
public void open(const pointer path, const int flags, const int mode, int out) {}
public void close(const int fd, int out) {}
public void lseek(const int fd, const long offset, const int whence, long out) {}
public void mkdir(const pointer path, const int mode, int out) {}
public void rmdir(const pointer path, int out) {}
public void unlink(const pointer path, int out) {}
public void rename(const pointer src, const pointer dst, int out) {}
public void fsync(const int fd, int out) {}
public void truncate(const pointer path, const long size, int out) {}
public void chmod(const pointer path, const int mode, int out) {}
public void symlink(const pointer target, const pointer link, int out) {}
public void readlink(const pointer path, const pointer buf, const ulong size, long out) {}
public void stat(const pointer path, const pointer buf, int out) {}
public void lstat(const pointer path, const pointer buf, int out) {}
public void getdents64(const int fd, const pointer buf, const ulong size, long out) {}
public void clock_gettime(const int clk, const pointer ts, int out) {}
public void nanosleep(const pointer req, const pointer rem, int out) {}
public void getcwd(const pointer buf, const ulong size, pointer out) {}
public void chdir(const pointer path, int out) {}
public void getenv(const pointer name, pointer out) {}
public void setenv(const pointer name, const pointer val, const int overwrite, int out) {}
public void unsetenv(const pointer name, int out) {}
public void uname(const pointer buf, int out) {}
public void exit(const int code) {}
public void strlen(const pointer s, ulong out) {}
// process / threads
public void fork(int out) {}
public void execv(const pointer path, const pointer argv, int out) {}
public void waitpid(const int pid, const pointer status, const int options, int out) {}
public void pthread_create(const pointer thread, const pointer attr, const pointer start, const pointer arg, int out) {}
// futex via libc's syscall() wrapper (@syscall). One fixed arity (number + 5 args);
// SYS_futex ignores the trailing args it doesn't use.
public void syscall(const long n, const long a1, const long a2, const long a3, const long a4, const long a5, long out) {}
// atomics via libatomic (-latomic)
public void __atomic_load_4(const pointer ptr, const int memorder, int out) {}
public void __atomic_store_4(const pointer ptr, const int val, const int memorder) {}
public void __atomic_compare_exchange_4(const pointer ptr, const pointer expected, const int desired, const int wk, const int success, const int failure, bool out) {}
public void __atomic_fetch_add_4(const pointer ptr, const int val, const int memorder, int out) {}

// ── Math (libm, -lm) — declaration-only: fly.math calls these; they lower to the
//    libm symbol directly (call @erf …), so no Fly body is emitted. ────────────
public void erf(const double x, double out) {}
public void erfc(const double x, double out) {}
public void tgamma(const double x, double out) {}
public void asin(const double x, double out) {}
public void acos(const double x, double out) {}
public void atan(const double x, double out) {}
public void atan2(const double y, const double x, double out) {}
public void sinh(const double x, double out) {}
public void cosh(const double x, double out) {}
public void tanh(const double x, double out) {}
public void hypot(const double x, const double y, double out) {}
public void asinh(const double x, double out) {}
public void acosh(const double x, double out) {}
public void atanh(const double x, double out) {}

// ── Memory ────────────────────────────────────────────────────────────────────
public void mem_alloc(const ulong size, pointer out) {
    ulong s = size
    if s == 0 { s = 1 }
    fly.runtime.malloc(s, out)
}

public void mem_free(const pointer ptr, const ulong size) {
    fly.runtime.free(ptr)
}

public void mem_realloc(const pointer ptr, const ulong newSize, pointer out) {
    ulong s = newSize
    if s == 0 { s = 1 }
    fly.runtime.realloc(ptr, s, out)
}

// ── I/O ─────────────────────────────────────────────────────────────────────
public void io_write(const int fd, const pointer buf, const ulong count, long out) {
    fly.runtime.write(fd, buf, count, out)
}

// ── Process ───────────────────────────────────────────────────────────────────
public void proc_exit(const int code) {
    fly.runtime.exit(code)
}

