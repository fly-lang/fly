public void _exit(const int code) {}
public void strlen(const pointer s, ulong out) {}
public void _NSGetExecutablePath(const pointer buf, const pointer bufsize, int out) {}
public void _NSGetArgc(pointer out) {}
public void _NSGetArgv(pointer out) {}
public void _NSGetEnviron(pointer out) {}
// process / threads
public void fork(int out) {}
