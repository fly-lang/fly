namespace fly.lsp

import fly.str
import fly.mem
import fly.json
import fly.codec
import fly.data.List
import fly.compiler.sema.SymbolKind

// ─────────────────────────────────────────────────────────────────────────────
// LspProtocol — LSP type mapping. Port of tools/lsp/{include,lib}/LspProtocol.
//
// The reference builds llvm::json objects; here every builder returns a fly.json
// node handle (an opaque pointer). Ownership follows fly.json's rule: `put`/`add`
// take ownership of the child, and freeing the root frees the whole tree — so a
// node is attached to exactly one parent and only roots are ever freed.
//
// Positions: LSP is 0-based, the compiler is 1-based. The subtraction happens
// HERE and nowhere else, so a mixed-up caller cannot produce an off-by-one that
// looks right in one place and wrong in another.
// ─────────────────────────────────────────────────────────────────────────────

// LspDiag — one diagnostic, 1-BASED compiler coordinates. Kept as a class so the
// analyzer can hand the server a List<LspDiag> (the same pattern as the driver's
// List<ASTModule>; tools compile monolithically, so generics are safe here).
public class LspDiag {
    public int line          // 1-based
    public int col           // 1-based
    public int severity      // LSP: 1=error 2=warning 3=info 4=hint
    public string message
    public string file

    public LspDiag(const int line, const int col, const int severity,
                   const string message, const string file) {
        this.line = line
        this.col = col
        this.severity = severity
        this.message = message
        this.file = file
    }
}

// uriToPath — "file:///c%3A/x/y.fly" → "c:/x/y.fly", "file:///home/u/y.fly" →
// "/home/u/y.fly". The reference strips the scheme and nothing else; real
// editors percent-encode the drive colon, so the decode is not optional here.
public string uriToPath(const string uri) {
    string s = uri
    if str.startsWith(s, "file://") {
        s = str.substring(s, 7, str.len(s))
    }
    int de = 0
    string dec = codec.percentDecode(s, de)
    if de == 0 { s = dec }
    // "/c:/x" → "c:/x": the leading slash is URI syntax, not part of the path.
    if str.len(s) >= 3 {
        byte b0 = 0
        byte b2 = 0
        b0 = str.byteAt(s, 0)
        b2 = str.byteAt(s, 2)
        int i0 = b0
        int i2 = b2
        i0 = i0 & 255
        i2 = i2 & 255
        if i0 == 47 {
            if i2 == 58 { s = str.substring(s, 1, str.len(s)) }
        }
    }
    return s
}

// pathToUri — the inverse: a Windows drive path gains the extra slash.
public string pathToUri(const string path) {
    string p = str.replace(path, "\\", "/")
    bool drive = false
    if str.len(p) >= 2 {
        byte b1 = str.byteAt(p, 1)
        int i1 = b1
        i1 = i1 & 255
        if i1 == 58 { drive = true }
    }
    if drive { return str.concat("file:///", p) } else { return str.concat("file://", p) }
}

// mkPosition — an LSP Position node from 1-based compiler coordinates.
public pointer mkPosition(const int line1, const int col1) {
    int l = line1 - 1
    int c = col1 - 1
    if l < 0 { l = 0 }
    if c < 0 { c = 0 }
    pointer o = json.newObject()
    json.put(o, "line", json.newInt(l))
    json.put(o, "character", json.newInt(c))
    return o
}

// mkRange — a single-character range at (line1, col1): enough to place the
// squiggle, which is all the compiler's point locations carry.
public pointer mkRange(const int line1, const int col1) {
    pointer o = json.newObject()
    json.put(o, "start", mkPosition(line1, col1))
    int endCol = col1 + 1
    json.put(o, "end", mkPosition(line1, endCol))
    return o
}

// mkDiagnostic — one LSP Diagnostic node.
public pointer mkDiagnostic(const LspDiag d) {
    pointer o = json.newObject()
    json.put(o, "range", mkRange(d.line, d.col))
    json.put(o, "severity", json.newInt(d.severity))
    json.put(o, "source", json.newString("fly"))
    json.put(o, "message", json.newString(d.message))
    return o
}

// lfStr — a one-byte "\n" string; literals keep escapes raw in this dialect.
public string lfStr() {
    pointer p = mem.alloc(1)
    mem.writeByte(p, 0, 10)
    string s = str.fromBytes(p, 1)
    return s
}

// isInternalName — a name the compiler made up, never one the user typed: the
// hidden return slots (`__ret`, `__ret_0`…), the call-site result locals
// (`__out_N`), the implicit `__error`, the for-in cursors. None of them belong
// in a completion list.
public bool isInternalName(const string n) {
    return str.startsWith(n, "__")
}

// completionKindOf — SymbolKind → LSP CompletionItemKind.
public int completionKindOf(const SymbolKind k) {
    if k == SymbolKind.FUNCTION { return 3 }
    if k == SymbolKind.CLASS { return 7 }
    if k == SymbolKind.LOCAL_VAR || k == SymbolKind.PARAM || k == SymbolKind.VAR { return 6 }
    if k == SymbolKind.ATTRIBUTE || k == SymbolKind.ENUM_ENTRY { return 5 }
    if k == SymbolKind.NAMESPACE { return 9 }
    return 1
}

// tokenTypeOf — SymbolKind → semantic token type index (the server's legend:
// 0 namespace, 1 class, 2 function, 3 variable, 4 parameter, 5 property,
// 6 enumMember, 7 type). -1 = skip.
public int tokenTypeOf(const SymbolKind k) {
    if k == SymbolKind.NAMESPACE { return 0 }
    if k == SymbolKind.CLASS { return 1 }
    if k == SymbolKind.FUNCTION { return 2 }
    if k == SymbolKind.LOCAL_VAR || k == SymbolKind.VAR { return 3 }
    if k == SymbolKind.PARAM { return 4 }
    if k == SymbolKind.ATTRIBUTE { return 5 }
    if k == SymbolKind.ENUM_ENTRY { return 6 }
    if k == SymbolKind.TYPE || k == SymbolKind.ENUM || k == SymbolKind.BUILTIN_TYPE { return 7 }
    return 0 - 1
}

// severityOfWord — "error"/"fatal" → 1, "warning" → 2, anything else → 3.
public int severityOfWord(const string w) {
    if str.equals(w, "error") { return 1 }
    if str.equals(w, "fatal") { return 1 }
    if str.equals(w, "warning") { return 2 }
    return 3
}

// parseRendered — decode the engine's "line:col: level: message" short form into
// an LspDiag. This is how PARSE diagnostics are recovered: the Parser hardwires
// its own StoringDiagnosticConsumer, which keeps only the rendered string. The
// format is produced by exactly one function (DiagnosticsEngine.emitDiagnostic),
// so this is a stable contract, not screen-scraping. Returns null when the
// string does not have that shape.
public LspDiag parseRendered(const string s, const string file) {
    int n = str.len(s)
    int i = 0
    int line = 0
    bool sawLine = false
    bool go = true
    while go {
        if i >= n { go = false } else {
            byte b = str.byteAt(s, i)
            int c = b
            c = c & 255
            bool digit = c >= 48 && c <= 57
            if digit { line = line * 10 + (c - 48)  sawLine = true  i = i + 1 }
            else { go = false }
        }
    }
    if sawLine == false { return null }
    if i >= n { return null }
    byte sep = str.byteAt(s, i)
    int sepI = sep
    sepI = sepI & 255
    if sepI != 58 { return null }            // ':'
    i = i + 1
    int col = 0
    bool sawCol = false
    go = true
    while go {
        if i >= n { go = false } else {
            byte b2 = str.byteAt(s, i)
            int c2 = b2
            c2 = c2 & 255
            bool digit2 = c2 >= 48 && c2 <= 57
            if digit2 { col = col * 10 + (c2 - 48)  sawCol = true  i = i + 1 }
            else { go = false }
        }
    }
    if sawCol == false { return null }
    // ": level: message"
    string tail = str.substring(s, i, n)
    if str.startsWith(tail, ": ") == false { return null }
    tail = str.substring(tail, 2, str.len(tail))
    int lv = str.indexOf(tail, ": ")
    if lv < 0 { return null }
    string word = str.substring(tail, 0, lv)
    string msg = str.substring(tail, lv + 2, str.len(tail))
    return new LspDiag(line, col, severityOfWord(word), msg, file)
}

// diagFileSet — the distinct files carrying at least one diagnostic, with
// `always` guaranteed present. One project-wide compile can surface errors in
// ANY file of the project, so the server publishes per file; the trigger file is
// in the set even when clean, because publishing its empty list is what clears
// its previous squiggles. First-seen order; diagnostics with an empty file name
// (none today) are skipped rather than invented.
public List<string> diagFileSet(const List<LspDiag> diags, const string always) {
    List<string> files = new List<string>()
    int i = 0
    while i < diags.size() {
        LspDiag d = diags.get(i)
        if str.isEmpty(d.file) == false {
            bool seen = false
            int j = 0
            while j < files.size() {
                if str.equals(files.get(j), d.file) { seen = true  j = (int)files.size() }
                else { j = j + 1 }
            }
            if seen == false { files.add(d.file) }
        }
        i = i + 1
    }
    bool hasTrigger = false
    int k = 0
    while k < files.size() {
        if str.equals(files.get(k), always) { hasTrigger = true  k = (int)files.size() }
        else { k = k + 1 }
    }
    if hasTrigger == false { files.add(always) }
    return files
}

// LspLink — one documentLink: a span on ONE line (1-based, compiler
// coordinates) pointing at a file. Fly's links are import paths, which never
// wrap, so a single-line span is the whole story.
public class LspLink {
    public int line
    public int colStart
    public int colEnd
    public string target        // filesystem path; the server turns it into a URI

    public LspLink(const int line, const int colStart, const int colEnd, const string target) {
        this.line = line
        this.colStart = colStart
        this.colEnd = colEnd
        this.target = target
    }
}

// mkDocumentLink — `{"range":…,"target":"file:///…"}`.
public pointer mkDocumentLink(const LspLink l) {
    pointer range = json.newObject()
    json.put(range, "start", mkPosition(l.line, l.colStart))
    json.put(range, "end", mkPosition(l.line, l.colEnd))
    pointer o = json.newObject()
    json.put(o, "range", range)
    json.put(o, "target", json.newString(pathToUri(l.target)))
    return o
}
