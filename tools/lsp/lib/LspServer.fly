namespace fly.lsp

import fly.str
import fly.json
import fly.hash
import fly.os.fs
import fly.data.List

// ─────────────────────────────────────────────────────────────────────────────
// LspServer — request routing + main loop. Port of tools/lsp/LspServer.
//
// Lifecycle contract (LSP 3.x):
//   • before `initialize`, every REQUEST gets error -32002 and every
//     notification is dropped;
//   • `shutdown` answers null and arms exit; `exit` ends the loop;
//   • an unknown REQUEST gets -32601 — never silence, which would hang the
//     client's pending promise. Unknown notifications are ignored by design.
//
// Document sync: didOpen and didSave RECOMPILE FROM DISK and push diagnostics,
// grouped per file; didChange is a no-op (a whole-project compile per keystroke
// pinned the server, and the compile never saw unsaved buffer text anyway — the
// analyzer compiles paths, not buffers; an unsaved-buffer overlay remains the
// navigation phase's work). A save whose bytes match the last compile of the
// same file is skipped (compiledCrc). didClose clears the file's diagnostics
// and forgets its coalescing state so a reopen recompiles.
// ─────────────────────────────────────────────────────────────────────────────

public class LspServer {
    LspTransport transport
    LspAnalyzer analyzer
    bool initialized
    bool exited
    List<string> openFiles
    string compiledPath          // which file the analyzer's nav state holds
    uint compiledCrc             // CRC-32 of that file's content at compile time
    List<string> diagFiles       // files carrying squiggles from the last publish

    public LspServer() {
        this.transport = new LspTransport()
        this.analyzer = new LspAnalyzer()
        this.initialized = false
        this.exited = false
        this.openFiles = new List<string>()
        this.compiledPath = ""
        this.compiledCrc = 0
        this.diagFiles = new List<string>()
    }

    // run — blocks until exit or stdin closes.
    public void run() {
        while this.exited == false {
            string body = this.transport.readMessage()
            if str.isEmpty(body) { this.exited = true } else {
                this.dispatch(body)
            }
        }
    }

    void dispatch(const string body) {
        int pe = 0
        pointer msg = json.parse(body, pe)
        if pe != 0 { return }
        if json.isObject(msg) == false {
            json.freeValue(msg)
            return
        }

        string method = ""
        pointer mNode = json.get(msg, "method")
        if mNode != 0 { if json.isString(mNode) { method = json.asString(mNode) } }
        if str.isEmpty(method) {
            json.freeValue(msg)
            return
        }

        // The id, kept as ITS OWN JSON TEXT so number/string/null all round-trip
        // through the response without this file caring which it was.
        bool isRequest = false
        string idJson = "null"
        pointer idNode = json.get(msg, "id")
        if idNode != 0 {
            isRequest = true
            idJson = json.write(idNode)
        }

        if this.initialized == false {
            if str.equals(method, "initialize") == false {
                if isRequest { this.transport.sendError(idJson, 0 - 32002, "Server not initialized") }
                json.freeValue(msg)
                return
            }
        }

        if str.equals(method, "initialize") { this.onInitialize(idJson, msg) }
        elsif str.equals(method, "initialized") { }
        elsif str.equals(method, "shutdown") { this.onShutdown(idJson) }
        elsif str.equals(method, "exit") { this.exited = true }
        elsif str.equals(method, "textDocument/didOpen") { this.onDidOpen(msg) }
        elsif str.equals(method, "textDocument/didChange") { this.onDidChange(msg) }
        elsif str.equals(method, "textDocument/didSave") { this.onDidSave(msg) }
        elsif str.equals(method, "textDocument/didClose") { this.onDidClose(msg) }
        elsif str.equals(method, "textDocument/definition") { this.onDefinition(idJson, msg) }
        elsif str.equals(method, "textDocument/hover") { this.onHover(idJson, msg) }
        elsif str.equals(method, "textDocument/references") { this.onReferences(idJson, msg) }
        elsif str.equals(method, "textDocument/documentHighlight") { this.onDocumentHighlight(idJson, msg) }
        elsif str.equals(method, "textDocument/documentSymbol") { this.onDocumentSymbol(idJson, msg) }
        elsif str.equals(method, "textDocument/foldingRange") { this.onFoldingRange(idJson, msg) }
        elsif str.equals(method, "textDocument/completion") { this.onCompletion(idJson, msg) }
        elsif str.equals(method, "textDocument/signatureHelp") { this.onSignatureHelp(idJson, msg) }
        elsif str.equals(method, "textDocument/semanticTokens/full") { this.onSemanticTokens(idJson, msg) }
        elsif str.equals(method, "textDocument/inlayHint") { this.onInlayHint(idJson, msg) }
        elsif str.equals(method, "textDocument/typeDefinition") { this.onTypeDefinition(idJson, msg) }
        elsif str.equals(method, "textDocument/implementation") { this.onImplementation(idJson, msg) }
        elsif str.equals(method, "workspace/symbol") { this.onWorkspaceSymbol(idJson, msg) }
        elsif isRequest {
            this.transport.sendError(idJson, 0 - 32601,
                str.concat("Unknown method: ", method))
        }
        json.freeValue(msg)
    }

    // extractPath — params.textDocument.uri → filesystem path, "" when absent.
    string extractPath(const pointer msg) {
        pointer params = json.get(msg, "params")
        if params == 0 { out = ""  return }
        pointer td = json.get(params, "textDocument")
        if td == 0 { out = ""  return }
        pointer uri = json.get(td, "uri")
        if uri == 0 { out = ""  return }
        if json.isString(uri) == false { out = ""  return }
        out = fly.lsp.uriToPath(json.asString(uri))
    }

    // extractRoot — the PROJECT root announced by `initialize`: rootUri, else the
    // first workspaceFolder, else the deprecated rootPath ("" when the client
    // sends none, e.g. a single loose file).
    //
    // Without it the analyzer only knows the edited file's own directory, and a
    // project whose namespaces span sibling directories reports its entire import
    // graph as "unknown type". Every reference implementation takes the root from
    // this handshake (rust-analyzer, gopls) rather than guessing per file.
    string extractRoot(const pointer msg) {
        pointer params = json.get(msg, "params")
        if params == 0 { out = ""  return }
        pointer ru = json.get(params, "rootUri")
        if ru != 0 {
            if json.isString(ru) { out = fly.lsp.uriToPath(json.asString(ru))  return }
        }
        pointer wf = json.get(params, "workspaceFolders")
        if wf != 0 {
            if json.size(wf) > 0 {
                pointer f0 = json.at(wf, 0)
                if f0 != 0 {
                    pointer u0 = json.get(f0, "uri")
                    if u0 != 0 {
                        if json.isString(u0) { out = fly.lsp.uriToPath(json.asString(u0))  return }
                    }
                }
            }
        }
        pointer rp = json.get(params, "rootPath")
        if rp != 0 {
            if json.isString(rp) { out = json.asString(rp)  return }
        }
        out = ""
    }

    // ── lifecycle ────────────────────────────────────────────────────────────

    void onInitialize(const string idJson, const pointer msg) {
        this.initialized = true
        this.analyzer.setProjectRoot(this.extractRoot(msg))
        pointer caps = json.newObject()
        // Sync as an OBJECT, not the bare number 1: the numeric form has no
        // `save` field, so the client never sends textDocument/didSave — and
        // save is what triggers diagnostics now (whole-project compiles are too
        // expensive to run per keystroke; same reason gopls offers
        // diagnosticsTrigger=Save and rust-analyzer checks on save).
        pointer sync = json.newObject()
        json.put(sync, "openClose", json.newBool(true))
        json.put(sync, "change", json.newInt(1))
        json.put(sync, "save", json.newBool(true))
        json.put(caps, "textDocumentSync", sync)
        json.put(caps, "definitionProvider", json.newBool(true))
        json.put(caps, "hoverProvider", json.newBool(true))
        json.put(caps, "referencesProvider", json.newBool(true))
        json.put(caps, "documentHighlightProvider", json.newBool(true))
        json.put(caps, "documentSymbolProvider", json.newBool(true))
        json.put(caps, "foldingRangeProvider", json.newBool(true))
        json.put(caps, "workspaceSymbolProvider", json.newBool(true))
        json.put(caps, "inlayHintProvider", json.newBool(true))
        json.put(caps, "typeDefinitionProvider", json.newBool(true))
        json.put(caps, "implementationProvider", json.newBool(true))
        pointer comp = json.newObject()
        pointer ctrig = json.newArray()
        json.add(ctrig, json.newString("."))
        json.put(comp, "triggerCharacters", ctrig)
        json.put(caps, "completionProvider", comp)
        pointer sh = json.newObject()
        pointer strig = json.newArray()
        json.add(strig, json.newString("("))
        json.add(strig, json.newString(","))
        json.put(sh, "triggerCharacters", strig)
        json.put(caps, "signatureHelpProvider", sh)
        pointer sem = json.newObject()
        pointer legend = json.newObject()
        pointer tt = json.newArray()
        json.add(tt, json.newString("namespace"))
        json.add(tt, json.newString("class"))
        json.add(tt, json.newString("function"))
        json.add(tt, json.newString("variable"))
        json.add(tt, json.newString("parameter"))
        json.add(tt, json.newString("property"))
        json.add(tt, json.newString("enumMember"))
        json.add(tt, json.newString("type"))
        json.put(legend, "tokenTypes", tt)
        json.put(legend, "tokenModifiers", json.newArray())
        json.put(sem, "legend", legend)
        json.put(sem, "full", json.newBool(true))
        json.put(caps, "semanticTokensProvider", sem)
        pointer info = json.newObject()
        json.put(info, "name", json.newString("fly-lsp"))
        json.put(info, "version", json.newString("0.2.0"))
        pointer result = json.newObject()
        json.put(result, "capabilities", caps)
        json.put(result, "serverInfo", info)
        this.transport.sendResult(idJson, result)
    }

    void onShutdown(const string idJson) {
        // Reference parity: shutdown already arms the exit — a client that never
        // sends the final `exit` still lets the process end.
        this.exited = true
        this.transport.sendResult(idJson, 0)      // 0 → serialized as null
    }

    // ── document sync ────────────────────────────────────────────────────────

    bool isOpen(const string path) {
        int i = 0
        bool found = false
        while i < this.openFiles.size() {
            if str.equals(this.openFiles.get(i), path) { found = true  i = (int)this.openFiles.size() }
            else { i = i + 1 }
        }
        out = found
    }

    void onDidOpen(const pointer msg) {
        string path = this.extractPath(msg)
        if str.isEmpty(path) { return }
        if this.isOpen(path) == false { this.openFiles.add(path) }
        this.recompileAndPublish(path)
    }

    // onDidChange — deliberately does NOT compile. A whole-project compile per
    // keystroke pinned the server for the length of a full sema run on every
    // edit; diagnostics now refresh on didOpen and didSave (the compile reads
    // from disk anyway, so mid-edit buffer content was never visible to it).
    void onDidChange(const pointer msg) {
    }

    void onDidSave(const pointer msg) {
        string path = this.extractPath(msg)
        if str.isEmpty(path) { return }
        this.recompileAndPublish(path)
    }

    void onDidClose(const pointer msg) {
        string path = this.extractPath(msg)
        if str.isEmpty(path) { return }
        List<string> keep = new List<string>()
        int i = 0
        while i < this.openFiles.size() {
            string f = this.openFiles.get(i)
            if str.equals(f, path) == false { keep.add(f) }
            i = i + 1
        }
        this.openFiles = keep
        // Clear the closed file's squiggles.
        pointer params = json.newObject()
        json.put(params, "uri", json.newString(fly.lsp.pathToUri(path)))
        json.put(params, "diagnostics", json.newArray())
        this.transport.sendNotification("textDocument/publishDiagnostics", params)
        // The clear above forgot this file's squiggles, so the coalescing state
        // must forget its compile too: a reopen with unchanged bytes would
        // otherwise skip the recompile and leave a broken file looking clean.
        if str.equals(path, this.compiledPath) {
            this.compiledPath = ""
            this.compiledCrc = 0
        }
    }

    // listHas — membership test for a path list (no Set in this std yet).
    bool listHas(const List<string> xs, const string v) {
        bool found = false
        int i = 0
        while i < xs.size() {
            if str.equals(xs.get(i), v) { found = true  i = (int)xs.size() }
            else { i = i + 1 }
        }
        out = found
    }

    // publishFor — one publishDiagnostics notification for `path`.
    void publishFor(const string path, const pointer arr) {
        pointer params = json.newObject()
        json.put(params, "uri", json.newString(fly.lsp.pathToUri(path)))
        json.put(params, "diagnostics", arr)
        this.transport.sendNotification("textDocument/publishDiagnostics", params)
    }

    void recompileAndPublish(const string triggerFile) {
        // Coalescing: a save that did not change the bytes since the last
        // compile of this same file has nothing new to say — skip the (whole
        // project, seconds-long) recompile. rust-analyzer coalesces rapid
        // restarts the same way, just by time window instead of content.
        uint crc = hash.crc32(fs.readStr(triggerFile))
        if str.equals(triggerFile, this.compiledPath) {
            if crc == this.compiledCrc { return }
        }
        List<LspDiag> diags = this.analyzer.compileFile(triggerFile)
        this.compiledPath = triggerFile
        this.compiledCrc = crc

        // One compile covers the WHOLE project, so a diagnostic may belong to any
        // file in it: group by file and send one notification each. Hanging every
        // message on the edited file's URI (what this did before) would paint
        // another file's line numbers onto this one. Same mapping rust-analyzer's
        // flycheck does when it fans one workspace check back out over many files.
        // The set logic is fly.lsp.diagFileSet (pure, covered by LspProtocolSuite).
        List<string> files = fly.lsp.diagFileSet(diags, triggerFile)

        int fi = 0
        while fi < files.size() {
            string f = files.get(fi)
            pointer arr = json.newArray()
            int di = 0
            while di < diags.size() {
                LspDiag d = diags.get(di)
                if str.equals(d.file, f) { json.add(arr, fly.lsp.mkDiagnostic(d)) }
                di = di + 1
            }
            this.publishFor(f, arr)
            fi = fi + 1
        }

        // NOT cleared here: a file that had squiggles in the previous run but is
        // absent from this one. This compile covers the trigger file's IMPORT
        // CLOSURE, not the whole project, so "absent" usually means "not reached
        // from this file" — clearing on that basis makes another file's errors
        // vanish just because the user switched tab. Stale entries are refreshed
        // when that file is itself compiled. Cross-file clearing becomes correct
        // only with a true whole-project check (rust-analyzer clears the previous
        // workspace set exactly because its cargo check IS workspace-wide).
        this.diagFiles = files
    }

    // ── navigation ───────────────────────────────────────────────────────────
    //
    // The analyzer holds ONE file's compile state. A request against another
    // file recompiles first (cheap at editor scale, and identical to what a
    // didOpen would have done) so navigation never answers from the wrong file.

    void ensureCompiled(const string path) {
        if str.isEmpty(path) { return }
        if str.equals(path, this.compiledPath) { return }
        List<LspDiag> ignored = this.analyzer.compileFile(path)
        this.compiledPath = path
        // Keep the coalescing state truthful: this compile saw these bytes, so
        // a later didSave with unchanged content can skip its own recompile.
        this.compiledCrc = hash.crc32(fs.readStr(path))
    }

    // extractLine/extractCol — params.position, converted to 1-based.
    int extractLine(const pointer msg) {
        pointer params = json.get(msg, "params")
        if params == 0 { out = 1  return }
        pointer pos = json.get(params, "position")
        if pos == 0 { out = 1  return }
        pointer l = json.get(pos, "line")
        if l == 0 { out = 1  return }
        out = json.asInt(l) + 1
    }

    int extractCol(const pointer msg) {
        pointer params = json.get(msg, "params")
        if params == 0 { out = 1  return }
        pointer pos = json.get(params, "position")
        if pos == 0 { out = 1  return }
        pointer c = json.get(pos, "character")
        if c == 0 { out = 1  return }
        out = json.asInt(c) + 1
    }

    // mkLocation — {uri, range} for a 1-based site.
    pointer mkLocation(const string file, const int line, const int col, const int len) {
        pointer o = json.newObject()
        json.put(o, "uri", json.newString(fly.lsp.pathToUri(file)))
        pointer r = json.newObject()
        json.put(r, "start", fly.lsp.mkPosition(line, col))
        json.put(r, "end", fly.lsp.mkPosition(line, col + len))
        json.put(o, "range", r)
        out = o
    }

    void onDefinition(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspTarget t = this.analyzer.findTargetAt(this.extractLine(msg), this.extractCol(msg))
        if t.kind == 0 { this.transport.sendResult(idJson, 0)  return }
        LspLoc loc = this.analyzer.declLocationOf(t)
        if loc.ok == false { this.transport.sendResult(idJson, 0)  return }
        this.transport.sendResult(idJson,
            this.mkLocation(loc.file, loc.line, loc.col, str.len(t.name)))
    }

    void onHover(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspTarget t = this.analyzer.findTargetAt(this.extractLine(msg), this.extractCol(msg))
        string md = this.analyzer.hoverOf(t)
        if str.isEmpty(md) { this.transport.sendResult(idJson, 0)  return }
        pointer contents = json.newObject()
        json.put(contents, "kind", json.newString("markdown"))
        json.put(contents, "value", json.newString(md))
        pointer result = json.newObject()
        json.put(result, "contents", contents)
        this.transport.sendResult(idJson, result)
    }

    void onReferences(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspTarget t = this.analyzer.findTargetAt(this.extractLine(msg), this.extractCol(msg))
        pointer arr = json.newArray()
        if t.kind != 0 {
            bool inclDecl = false
            pointer params = json.get(msg, "params")
            if params != 0 {
                pointer ctx = json.get(params, "context")
                if ctx != 0 {
                    pointer f = json.get(ctx, "includeDeclaration")
                    if f != 0 { inclDecl = json.asBool(f) }
                }
            }
            if inclDecl {
                LspLoc dl = this.analyzer.declLocationOf(t)
                if dl.ok { json.add(arr, this.mkLocation(dl.file, dl.line, dl.col, str.len(t.name))) }
            }
            List<LspUse> uses = this.analyzer.collectUses(t.name)
            int i = 0
            while i < uses.size() {
                LspUse u = uses.get(i)
                json.add(arr, this.mkLocation(path, u.line, u.col, u.len))
                i = i + 1
            }
        }
        this.transport.sendResult(idJson, arr)
    }

    void onDocumentHighlight(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspTarget t = this.analyzer.findTargetAt(this.extractLine(msg), this.extractCol(msg))
        pointer arr = json.newArray()
        if t.kind != 0 {
            List<LspUse> uses = this.analyzer.collectUses(t.name)
            int i = 0
            while i < uses.size() {
                LspUse u = uses.get(i)
                pointer h = json.newObject()
                pointer r = json.newObject()
                json.put(r, "start", fly.lsp.mkPosition(u.line, u.col))
                json.put(r, "end", fly.lsp.mkPosition(u.line, u.col + u.len))
                json.put(h, "range", r)
                json.put(h, "kind", json.newInt(2))     // Read
                json.add(arr, h)
                i = i + 1
            }
        }
        this.transport.sendResult(idJson, arr)
    }

    void onDocumentSymbol(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        List<LspSym> syms = this.analyzer.documentSymbols()
        pointer arr = json.newArray()
        int i = 0
        while i < syms.size() {
            LspSym s = syms.get(i)
            pointer o = json.newObject()
            json.put(o, "name", json.newString(s.name))
            json.put(o, "kind", json.newInt(s.kind))
            pointer r = json.newObject()
            json.put(r, "start", fly.lsp.mkPosition(s.line, s.col))
            json.put(r, "end", fly.lsp.mkPosition(s.line, s.col + str.len(s.name)))
            json.put(o, "range", r)
            pointer r2 = json.newObject()
            json.put(r2, "start", fly.lsp.mkPosition(s.line, s.col))
            json.put(r2, "end", fly.lsp.mkPosition(s.line, s.col + str.len(s.name)))
            json.put(o, "selectionRange", r2)
            json.add(arr, o)
            i = i + 1
        }
        this.transport.sendResult(idJson, arr)
    }

    void onFoldingRange(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        List<LspFold> folds = this.analyzer.foldingRanges()
        pointer arr = json.newArray()
        int i = 0
        while i < folds.size() {
            LspFold f = folds.get(i)
            pointer o = json.newObject()
            json.put(o, "startLine", json.newInt(f.startLine - 1))
            json.put(o, "endLine", json.newInt(f.endLine - 1))
            json.add(arr, o)
            i = i + 1
        }
        this.transport.sendResult(idJson, arr)
    }

    void onCompletion(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        List<LspSym> items = this.analyzer.completionsAt(this.extractLine(msg), this.extractCol(msg))
        pointer arr = json.newArray()
        int i = 0
        while i < items.size() {
            LspSym s = items.get(i)
            pointer o = json.newObject()
            json.put(o, "label", json.newString(s.name))
            json.put(o, "kind", json.newInt(s.kind))
            json.put(o, "insertText", json.newString(s.name))
            json.add(arr, o)
            i = i + 1
        }
        this.transport.sendResult(idJson, arr)
    }

    void onSignatureHelp(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspSignature sig = this.analyzer.signatureAt(this.extractLine(msg), this.extractCol(msg))
        if sig.ok == false { this.transport.sendResult(idJson, 0)  return }
        pointer sio = json.newObject()
        json.put(sio, "label", json.newString(sig.label))
        pointer ps = json.newArray()
        int i = 0
        while i < sig.params.size() {
            pointer po = json.newObject()
            json.put(po, "label", json.newString(sig.params.get(i)))
            json.add(ps, po)
            i = i + 1
        }
        json.put(sio, "parameters", ps)
        pointer sigs = json.newArray()
        json.add(sigs, sio)
        pointer result = json.newObject()
        json.put(result, "signatures", sigs)
        json.put(result, "activeSignature", json.newInt(0))
        json.put(result, "activeParameter", json.newInt(sig.active))
        this.transport.sendResult(idJson, result)
    }

    void onSemanticTokens(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        List<LspSym> sorted = this.analyzer.semanticTokens()
        // Sort by (line, col) — delta encoding requires it. In-place selection
        // sort with get/set: editor files are small and the walk order is
        // already nearly sorted.
        int n = (int)sorted.size()
        int i = 0
        while i < n {
            int best = i
            int k = i + 1
            while k < n {
                LspSym a = sorted.get(k)
                LspSym b = sorted.get(best)
                bool less = a.line < b.line
                if less == false { if a.line == b.line { less = a.col < b.col } }
                if less { best = k }
                k = k + 1
            }
            if best != i {
                LspSym tmp = sorted.get(i)
                sorted.set(i, sorted.get(best))
                sorted.set(best, tmp)
            }
            i = i + 1
        }
        pointer data = json.newArray()
        int prevLine = 0
        int prevCol = 0
        int j = 0
        while j < sorted.size() {
            LspSym t = sorted.get(j)
            int line0 = t.line - 1
            int col0 = t.col - 1
            int dLine = line0 - prevLine
            int dCol = col0
            if dLine == 0 { dCol = col0 - prevCol }
            json.add(data, json.newInt(dLine))
            json.add(data, json.newInt(dCol))
            json.add(data, json.newInt(str.len(t.name)))
            json.add(data, json.newInt(t.kind))
            json.add(data, json.newInt(0))
            prevLine = line0
            prevCol = col0
            j = j + 1
        }
        pointer result = json.newObject()
        json.put(result, "data", data)
        this.transport.sendResult(idJson, result)
    }

    void onInlayHint(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        // The requested range, defaulting to "everything" when absent.
        int startLine = 1
        int endLine = 1000000
        pointer params = json.get(msg, "params")
        if params != 0 {
            pointer r = json.get(params, "range")
            if r != 0 {
                pointer s = json.get(r, "start")
                if s != 0 {
                    pointer sl = json.get(s, "line")
                    if sl != 0 { startLine = json.asInt(sl) + 1 }
                }
                pointer e = json.get(r, "end")
                if e != 0 {
                    pointer el = json.get(e, "line")
                    if el != 0 { endLine = json.asInt(el) + 1 }
                }
            }
        }
        List<LspSym> hints = this.analyzer.inlayHints(startLine, endLine)
        pointer arr = json.newArray()
        int i = 0
        while i < hints.size() {
            LspSym h = hints.get(i)
            pointer o = json.newObject()
            json.put(o, "position", fly.lsp.mkPosition(h.line, h.col))
            json.put(o, "label", json.newString(h.name))
            json.put(o, "kind", json.newInt(2))       // Parameter
            json.add(arr, o)
            i = i + 1
        }
        this.transport.sendResult(idJson, arr)
    }

    void onTypeDefinition(const string idJson, const pointer msg) {
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspTarget t = this.analyzer.findTargetAt(this.extractLine(msg), this.extractCol(msg))
        if t.kind == 0 { this.transport.sendResult(idJson, 0)  return }
        LspLoc loc = this.analyzer.typeDefinitionOf(t)
        if loc.ok == false { this.transport.sendResult(idJson, 0)  return }
        this.transport.sendResult(idJson,
            this.mkLocation(loc.file, loc.line, loc.col, str.len(t.varTypeName)))
    }

    void onImplementation(const string idJson, const pointer msg) {
        // Reference parity: implementations are served as the symbol's
        // references (LspServer.cpp delegates exactly the same way).
        string path = this.extractPath(msg)
        this.ensureCompiled(path)
        LspTarget t = this.analyzer.findTargetAt(this.extractLine(msg), this.extractCol(msg))
        pointer arr = json.newArray()
        if t.kind != 0 {
            List<LspUse> uses = this.analyzer.collectUses(t.name)
            int i = 0
            while i < uses.size() {
                LspUse u = uses.get(i)
                json.add(arr, this.mkLocation(path, u.line, u.col, u.len))
                i = i + 1
            }
        }
        this.transport.sendResult(idJson, arr)
    }

    void onWorkspaceSymbol(const string idJson, const pointer msg) {
        string query = ""
        pointer params = json.get(msg, "params")
        if params != 0 {
            pointer q = json.get(params, "query")
            if q != 0 { if json.isString(q) { query = json.asString(q) } }
        }
        List<LspSym> syms = this.analyzer.workspaceSymbols(query)
        pointer arr = json.newArray()
        int i = 0
        while i < syms.size() {
            LspSym s = syms.get(i)
            pointer o = json.newObject()
            json.put(o, "name", json.newString(s.name))
            json.put(o, "kind", json.newInt(s.kind))
            json.put(o, "location", this.mkLocation(s.file, s.line, s.col, str.len(s.name)))
            if str.isEmpty(s.container) == false {
                json.put(o, "containerName", json.newString(s.container))
            }
            json.add(arr, o)
            i = i + 1
        }
        this.transport.sendResult(idJson, arr)
    }
}
