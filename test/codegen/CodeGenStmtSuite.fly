namespace fly.compiler.codegen.test.stmt

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.compiler.sema.*
import fly.compiler.codegen.*
import fly.data.*
import fly.assert
import fly.os.fs
import fly.str
import fly.test.util.*

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenStmtSuite — statement / control-flow lowering. Faithful port of
// fly/test/CodeGen/CodeGenBaseTest.cpp control-flow cases (CGIfBlock /
// CGIfElseBlock / CGIfElsifElseBlock / CGSwitch / CGWhile) + local decl + break/
// continue. The pipeline runs in the top-level free function `cgIR` (a suite
// method driving codegen SIGSEGVs the reference --test backend).
//
// DEFERRED (reference cases not yet supported): CGForIn (for-in / iterables) —
// needs SemaLoopInStmt codegen + arrays. CGFor (C-style for) is covered below.
// ─────────────────────────────────────────────────────────────────────────────



suite CodeGenStmtSuite {

    void ifTest() {
        case "if / elsif / else → conditional branches + merge block": {
            string ir = cgIR("
                int classify(const int n) { int r = 0
                    if n > 10 { r = 2 } elsif n > 0 { r = 1 } else { r = 0 }
                    out = r
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "br i1"), 11)
            assert.assertTrue(fly.str.contains(ir, "then"), 12)
            assert.assertTrue(fly.str.contains(ir, "ifcont"), 13)
        }
        case "local decl allocas + stores its initializer": {
            string ir = cgIR("int f() { int r = 7  out = r }")
            assert.assertTrue(fly.str.contains(ir, "alloca i32"), 14)
            assert.assertTrue(fly.str.contains(ir, "store i32 7"), 15)
        }
    }

    void loopTest() {
        case "while with break/continue → loop blocks + back-edge": {
            string ir = cgIR("
                int sumTo(const int n) { int acc = 0
                    int i = 0
                    while i < n { i = i + 1
                        if i == 3 { continue }
                        if i > 100 { break }
                        acc = acc + i
                    }
                    out = acc
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "loopcond"), 21)
            assert.assertTrue(fly.str.contains(ir, "loopbody"), 22)
            assert.assertTrue(fly.str.contains(ir, "loopexit"), 23)
            assert.assertTrue(fly.str.contains(ir, "looppost"), 24)
        }
        case "C-style for → init store + loop blocks + post increment (CGFor)": {
            string ir = cgIR("int sum5() { int acc = 0  for int i = 0; i < 5; i++ { acc = acc + i }  out = acc }")
            assert.assertTrue(fly.str.contains(ir, "loopcond"), 25)
            assert.assertTrue(fly.str.contains(ir, "loopbody"), 26)
            assert.assertTrue(fly.str.contains(ir, "looppost"), 27)
            assert.assertTrue(fly.str.contains(ir, "icmp slt i32"), 28)
            assert.assertTrue(fly.str.contains(ir, "add i32"), 29)
        }
    }

    void switchTest() {
        case "switch → llvm switch + case/default blocks": {
            string ir = cgIR("
                int pick(const int k) { int r = 0
                    switch k { case 1: r = 10
                        case 2: r = 20
                        default: r = 99
                    }
                    out = r
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "switch i32"), 31)
            assert.assertTrue(fly.str.contains(ir, "swdefault"), 32)
        }
        case "empty case falls through to the NEXT case (doc 9.4)": {
            string ir = cgIR("int pick(const int k) { int r = 0  switch k { case 3: case 4: r = 34  default: r = 99 }  out = r }")
            assert.assertTrue(fly.str.contains(ir, "swcase"), 41)
            // the empty case's block must NOT be a lone `br %swexit`: it targets
            // the next case block, so two labels feed the shared body
            assert.assertTrue(fly.str.contains(ir, "store i32 34"), 42)
        }
    }

    void forInTest() {
        case "for-in desugars to an indexed loop over size()/get(pointer)": {
            string ir = cgIR("
                class Seq { public int a
                    public Seq() { this.a = 5 }
                    public pointer size() { out = 2 }
                    public int get(const pointer i) { out = this.a }
                }
                int total() { Seq q = new Seq()
                    int acc = 0
                    for v in q { acc = acc + v }
                    out = acc
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "loopcond"), 61)
            assert.assertTrue(fly.str.contains(ir, "looppost"), 62)         // increment in POST (continue-safe)
            assert.assertTrue(fly.str.contains(ir, "icmp ult i64"), 63)     // pointer index vs size()
            assert.assertTrue(fly.str.contains(ir, "3get"), 64)             // call to the duck-typed get
        }
    }

    void inlineFormsTest() {
        case "inline if/while bodies + for multi-init/post (doc 9.3/9.5)": {
            string ir = cgIR("
                int f() { int v = 1
                    if (v == 1) v = 2
                    int c = 0
                    while c < 3 c = c + 1
                    int acc = 0
                    for int i = 0, int j = 10; i < j; i++, j-- { acc = acc + 1 }
                    out = v + c + acc
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "ifcont"), 51)
            assert.assertTrue(fly.str.contains(ir, "loopcond"), 52)
            assert.assertTrue(fly.str.contains(ir, "looppost"), 53)
        }
    }
}
