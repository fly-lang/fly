namespace fly.compiler.codegen.test.err

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.compiler.sema.*
import fly.compiler.codegen.*
import fly.data.*
import fly.assert
import fly.os.fs
import fly.str
import fly.test.util.*

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenErrorSuite — error handling over the shared %error struct: `fail` writes
// the struct then returns early (or, inside a handle's own frame, jumps to the
// handle's `handle.safe` continuation); `handle` clears the code before its block,
// captures the block's outcome into the per-function `lasterr` slot (what the
// implicit `error` variable reads), and consumes the struct code so a handled
// failure never propagates. `if (error)` lowers to `lasterr != 0`. The `main`
// wrapper returns error.code when a failure is left unhandled (exit code).
// Extends fly/test/CodeGen/CodeGenErrorTest.cpp (whose exit-code model this
// mirrors; the reference crashes on error-in-condition, so `error` is validated
// here instead).
// ─────────────────────────────────────────────────────────────────────────────



suite CodeGenErrorSuite {

    void failHandleTest() {
        case "%error struct; fail writes code; handle captures into lasterr": {
            string ir = cgIR("
                int classify(const int n) {
                    out = 0
                    if n < 0 { fail 7 }
                    out = n
                }
                int main() {
                    int neg = 0 - 1
                    int a = 0
                    handle {
                        a = classify(neg)
                    }
                    int b = classify(5)
                    out = a + b
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "%error = type"), 11)
            assert.assertTrue(fly.str.contains(ir, "store i32 7"), 12)        // fail 7 → error.code
            assert.assertTrue(fly.str.contains(ir, "ecode"), 13)              // GEP to error.code
            assert.assertTrue(fly.str.contains(ir, "lasterr"), 14)            // per-function slot
            assert.assertTrue(fly.str.contains(ir, "handle.safe"), 15)        // handle continuation
        }
        case "implicit `error` var reads lasterr != 0 (i1 condition)": {
            string ir = cgIR("void boom() { fail 5 }  int main() { handle { boom() }  int r = 0  if (error) { r = 1 }  out = r }")
            assert.assertTrue(fly.str.contains(ir, "lerr"), 21)               // load of lasterr
            assert.assertTrue(fly.str.contains(ir, "eset"), 22)               // icmp ne 0 → i1
            assert.assertTrue(fly.str.contains(ir, "br i1"), 23)              // valid bool branch
        }
        case "fail inside the handle frame jumps to handle.safe (no early return)": {
            string ir = cgIR("
                int main() { int reached = 0
                    handle { fail 9
                        reached = 1
                    }
                    int r = 0
                    if (error) { r = 1 }
                    out = r
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "handle.safe"), 31)
            assert.assertTrue(fly.str.contains(ir, "afterfail"), 32)          // dead-code park block
            assert.assertTrue(fly.str.contains(ir, "store i32 9"), 33)
        }
        case "main wrapper: exit code = error.code when unhandled": {
            string ir = cgIR("void fetchData() { fail 42 }  void main() { fetchData() }")
            assert.assertTrue(fly.str.contains(ir, "mainerr"), 41)            // ret error.code path
            assert.assertTrue(fly.str.contains(ir, "mainok"), 42)             // clean-exit path
            assert.assertTrue(fly.str.contains(ir, "mfail"), 43)              // code != 0 check
        }
        case "fail with three operands writes code, str and obj slots": {
            string ir = cgIR("
                class Ctx { public int id
                    public Ctx() { this.id = 1 }
                }
                void boom() { Ctx c = new Ctx()
                    fail 42, c
                }
                int main() { handle { boom() }
                    out = 0
                }
            ")
            assert.assertTrue(fly.str.contains(ir, "store i32 42"), 51)       // code slot
            assert.assertTrue(fly.str.contains(ir, "efld"), 52)               // str/obj field stores
        }
    }
}
