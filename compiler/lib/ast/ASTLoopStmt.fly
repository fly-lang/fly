namespace fly.compiler.ast

import fly.compiler.basic.SourceLocation
import fly.compiler.ast.ASTExpr
import fly.compiler.ast.ASTStmt
import fly.compiler.ast.ASTStmtKind
import fly.compiler.ast.ASTVisitor
import fly.data.List

public class ASTLoopStmt : ASTStmt {

    bool verifyConditionAtEnd
    // The condition is the literal `true` (or absent): such a loop never falls
    // through, which is what lets `while true { … return … }` satisfy the
    // every-path-returns rule. Recorded by the parser, so the analysis needs no
    // narrowing of the condition expression.
    bool endlessCond
    ASTExpr expr
    List<ASTStmt> init
    List<ASTStmt> post
    ASTStmt loopStmt

    public ASTLoopStmt(const SourceLocation loc) {
        super(loc, ASTStmtKind.STMT_LOOP)
        this.verifyConditionAtEnd = false
        this.endlessCond = false
        this.init = new List<ASTStmt>()
        this.post = new List<ASTStmt>()
    }

    public bool hasVerifyConditionAtEnd() { return this.verifyConditionAtEnd }
    public bool hasEndlessCond() { return this.endlessCond }
    public void setEndlessCond(const bool v) { this.endlessCond = v }
    public ASTExpr getExpr() { return this.expr }
    public List<ASTStmt> getInit() { return this.init }
    public ASTStmt getLoop() { return this.loopStmt }
    public List<ASTStmt> getPost() { return this.post }
    public void setExpr(const ASTExpr expr) { this.expr = expr }
    public void setLoop(const ASTStmt s) { this.loopStmt = s }
    public void addInit(const ASTStmt s) { this.init.add(s) }
    public void addPost(const ASTStmt s) { this.post.add(s) }
    public void setVerifyConditionAtEnd(const bool v) { this.verifyConditionAtEnd = v }

    public void accept(const ASTVisitor v) { v.visit(this) }
}
