namespace fly.compiler.ast

import fly.compiler.basic.SourceLocation
import fly.compiler.ast.ASTExpr
import fly.compiler.ast.ASTExprKind
import fly.compiler.ast.ASTVisitor
import fly.data.List

public enum ASTValueKind {
    VAL_BOOL,
    VAL_NUMBER,
    VAL_STRING,
    VAL_ARRAY,
    VAL_STRUCT,
    VAL_NULL,
    VAL_DEFAULT,
    VAL_ENUM,
    VAL_UNSET
}

public class ASTValue : ASTExpr {

    ASTValueKind valueKind

    public ASTValue(const ASTValueKind valueKind, const SourceLocation loc) {
        super(loc, ASTExprKind.EXPR_VALUE)
        this.valueKind = valueKind
    }

    public ASTValueKind getValueKind() { return this.valueKind }
    public bool isBool() { return this.valueKind == ASTValueKind.VAL_BOOL }
    public bool isNumber() { return this.valueKind == ASTValueKind.VAL_NUMBER }
    public bool isString() { return this.valueKind == ASTValueKind.VAL_STRING }
    public bool isArray() { return this.valueKind == ASTValueKind.VAL_ARRAY }
    public bool isStruct() { return this.valueKind == ASTValueKind.VAL_STRUCT }
    public bool isNull() { return this.valueKind == ASTValueKind.VAL_NULL }
    public bool isDefault() { return this.valueKind == ASTValueKind.VAL_DEFAULT }
    public bool isUnset() { return this.valueKind == ASTValueKind.VAL_UNSET }
}

public class ASTBoolValue : ASTValue {

    bool value

    public ASTBoolValue(const SourceLocation loc, const bool value) {
        super(ASTValueKind.VAL_BOOL, loc)
        this.value = value
    }

    public bool getValue() { return this.value }

    public void accept(const ASTVisitor v) { v.visit(this) }
}

public class ASTNumberValue : ASTValue {

    string value

    public ASTNumberValue(const SourceLocation loc, const string value) {
        super(ASTValueKind.VAL_NUMBER, loc)
        this.value = value
    }

    public string getValue() { return this.value }
    public ASTNumberValue asNumberValue() { return this }

    public void accept(const ASTVisitor v) { v.visit(this) }
}

public class ASTStringValue : ASTValue {

    string value

    public ASTStringValue(const SourceLocation loc, const string value) {
        super(ASTValueKind.VAL_STRING, loc)
        this.value = value
    }

    public string getValue() { return this.value }
    public ASTStringValue asStringValue() { return this }

    public void accept(const ASTVisitor v) { v.visit(this) }
}

public class ASTArrayValue : ASTValue {

    List<ASTExpr> values

    public ASTArrayValue(const SourceLocation loc) {
        super(ASTValueKind.VAL_ARRAY, loc)
        this.values = new List<ASTExpr>()
    }

    public List<ASTExpr> getValues() { return this.values }
    public void setValues(const List<ASTExpr> v) { this.values = v }
    public ASTArrayValue asArrayValue() { return this }

    public void accept(const ASTVisitor v) { v.visit(this) }
}

// ASTStructValue — `{name = expr, ...}` struct literal (B029): parallel
// name/expr lists in source order (the parser splits the pairs, so sema never
// needs an ASTBinary downcast).
public class ASTStructValue : ASTValue {

    List<string> names
    List<ASTExpr> exprs

    public ASTStructValue(const SourceLocation loc) {
        super(ASTValueKind.VAL_STRUCT, loc)
        this.names = new List<string>()
        this.exprs = new List<ASTExpr>()
    }

    public List<string> getNames() { return this.names }
    public List<ASTExpr> getExprs() { return this.exprs }
    public void addField(const string name, const ASTExpr e) {
        this.names.add(name)
        this.exprs.add(e)
    }

    public void accept(const ASTVisitor v) { v.visit(this) }
}

public class ASTNullValue : ASTValue {

    public ASTNullValue(const SourceLocation loc) {
        super(ASTValueKind.VAL_NULL, loc)
    }

    public void accept(const ASTVisitor v) { v.visit(this) }
}

public class ASTUnsetValue : ASTValue {

    public ASTUnsetValue(const SourceLocation loc) {
        super(ASTValueKind.VAL_UNSET, loc)
    }

    public void accept(const ASTVisitor v) { v.visit(this) }
}
