namespace fly.compiler.ast

import fly.compiler.basic.SourceLocation
import fly.compiler.ast.ASTBlockStmt
import fly.compiler.ast.ASTReturnStmt
import fly.compiler.ast.ASTKind
import fly.compiler.ast.ASTNode
import fly.compiler.ast.ASTType
import fly.compiler.ast.ASTModifier
import fly.compiler.ast.ASTParam
import fly.compiler.ast.ASTVisitor
import fly.data.List

public enum ASTFunctionKind {
    F_FUNCTION,
    F_METHOD
}

public class ASTFunction : ASTNode {

    ASTFunctionKind functionKind
    string name
    List<ASTModifier> modifiers
    List<ASTParam> params
    ASTType returnType
    List<ASTType> returnTypes
    ASTBlockStmt body
    List<ASTType> typeParams
    // Collected by the parser while the body is read, so the NRVO check needs no
    // second walk over the tree: every `return` statement in this body, and the
    // name of every local it declares.
    List<ASTReturnStmt> returnStmts
    List<string> localNames

    public ASTFunction(const SourceLocation loc, const List<ASTModifier> modifiers, const string name, const List<ASTParam> params, const ASTFunctionKind functionKind) {
        super(ASTKind.FUNCTION, loc)
        this.modifiers = modifiers
        this.name = name
        this.params = params
        this.functionKind = functionKind
        this.returnTypes = new List<ASTType>()
        this.typeParams = new List<ASTType>()
        this.returnStmts = new List<ASTReturnStmt>()
        this.localNames = new List<string>()
    }

    public string getName() { return this.name }
    public List<ASTModifier> getModifiers() { return this.modifiers }
    public List<ASTParam> getParams() { return this.params }
    public List<ASTType> getTypeParams() { return this.typeParams }
    public ASTType getReturnType() { return this.returnType }
    public void setReturnType(const ASTType returnType) { this.returnType = returnType }
    public List<ASTType> getReturnTypes() { return this.returnTypes }
    public void setReturnTypes(const List<ASTType> returnTypes) { this.returnTypes = returnTypes }
    public List<ASTReturnStmt> getReturnStmts() { return this.returnStmts }
    public void addReturnStmt(const ASTReturnStmt r) { this.returnStmts.add(r) }
    public List<string> getLocalNames() { return this.localNames }
    public void addLocalName(const string n) { this.localNames.add(n) }
    public ASTFunction asFunction() { return this }
    public ASTFunctionKind getFunctionKind() { return this.functionKind }
    public ASTBlockStmt getBody() { return this.body }
    public void setBody(const ASTBlockStmt body) { this.body = body }

    public void accept(const ASTVisitor v) { v.visit(this) }
}
