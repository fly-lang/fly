namespace fly.compiler.ast

import fly.compiler.basic.SourceLocation
import fly.compiler.ast.ASTKind
import fly.compiler.ast.ASTNode
import fly.compiler.ast.ASTModifier
import fly.compiler.ast.ASTType
import fly.compiler.ast.ASTVisitor
import fly.data.List

public enum ASTClassKind {
    CLASS,
    INTERFACE,
    STRUCT,
    SUITE
}

public class ASTClass : ASTNode {

    List<ASTNode> nodes
    List<ASTModifier> modifiers
    string name
    ASTClassKind classKind
    List<ASTType> bases
    List<ASTType> typeParams
    List<string> ownerFields   // fields a method fills with `this.f = new unique ...` or an owner: they own
    List<string> sharedFields  // fields a method fills with `this.f = new shared ...` or a holder: they hold
    List<string> weakFields    // fields a method fills with `this.f = weak h`: weak references

    public ASTClass(const ASTClassKind classKind, const List<ASTModifier> modifiers, const SourceLocation loc,
            const string name, const List<ASTType> bases) {
        super(ASTKind.CLASS, loc)
        this.classKind = classKind
        this.modifiers = modifiers
        this.name = name
        this.bases = bases
        this.nodes = new List<ASTNode>()
        this.typeParams = new List<ASTType>()
        this.ownerFields = new List<string>()
        this.sharedFields = new List<string>()
        this.weakFields = new List<string>()
    }

    public List<string> getWeakFields() {
        return this.weakFields
    }
    public void addWeakField(const string n) {
        int i = 0
        while i < this.weakFields.size() {
            if this.weakFields.get(i) == n {
                return
            }
            i = i + 1
        }
        this.weakFields.add(n)
    }
    public List<string> getSharedFields() {
        return this.sharedFields
    }
    public void addSharedField(const string n) {
        int i = 0
        while i < this.sharedFields.size() {
            if this.sharedFields.get(i) == n {
                return
            }
            i = i + 1
        }
        this.sharedFields.add(n)
    }
    public List<string> getOwnerFields() {
        return this.ownerFields
    }
    public void addOwnerField(const string n) {
        int i = 0
        while i < this.ownerFields.size() {
            if this.ownerFields.get(i) == n {
                return
            }
            i = i + 1
        }
        this.ownerFields.add(n)
    }
    public List<ASTNode> getNodes() {
        return this.nodes
    }
    public ASTClassKind getClassKind() {
        return this.classKind
    }
    public List<ASTType> getBases() {
        return this.bases
    }
    public List<ASTType> getTypeParams() {
        return this.typeParams
    }
    public List<ASTModifier> getModifiers() {
        return this.modifiers
    }
    public string getName() {
        return this.name
    }
    public ASTClass asClass() {
        return this
    }
    public void addNode(const ASTNode node) {
        this.nodes.add(node)
    }

    public void accept(const ASTVisitor v) {
        v.visit(this)
    }
}
