namespace fly.compiler.sema

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.basic.*
import fly.data.List

// ResolverType — type-node resolution companion (static methods threading the
// Resolver). Sets r.currentType.
public class ResolverType {

    public ResolverType() { }

    public static void builtin(const Resolver r, const ASTBuiltinType node) {
        ASTBuiltinTypeKind k = node.getBuiltinKind()
        SemaType t = SemaBuiltin.getIntType()
        if k == ASTBuiltinTypeKind.TYPE_VOID {
            t = SemaBuiltin.getVoidType()
        } elsif k == ASTBuiltinTypeKind.TYPE_BOOL {
            t = SemaBuiltin.getBoolType()
        } elsif k == ASTBuiltinTypeKind.TYPE_BYTE {
            t = SemaBuiltin.getByteType()
        } elsif k == ASTBuiltinTypeKind.TYPE_SHORT {
            t = SemaBuiltin.getShortType()
        } elsif k == ASTBuiltinTypeKind.TYPE_INT {
            t = SemaBuiltin.getIntType()
        } elsif k == ASTBuiltinTypeKind.TYPE_LONG {
            t = SemaBuiltin.getLongType()
        } elsif k == ASTBuiltinTypeKind.TYPE_USHORT {
            t = SemaBuiltin.getUShortType()
        } elsif k == ASTBuiltinTypeKind.TYPE_UINT {
            t = SemaBuiltin.getUIntType()
        } elsif k == ASTBuiltinTypeKind.TYPE_ULONG {
            t = SemaBuiltin.getULongType()
        } elsif k == ASTBuiltinTypeKind.TYPE_POINTER {
            t = SemaBuiltin.getPtrSizeType()
        } elsif k == ASTBuiltinTypeKind.TYPE_FLOAT {
            t = SemaBuiltin.getFloatType()
        } elsif k == ASTBuiltinTypeKind.TYPE_DOUBLE {
            t = SemaBuiltin.getDoubleType()
        } elsif k == ASTBuiltinTypeKind.TYPE_COMPLEX {
            t = SemaBuiltin.getComplexType()
        } elsif k == ASTBuiltinTypeKind.TYPE_STRING {
            t = SemaBuiltin.getStringType()
        } elsif k == ASTBuiltinTypeKind.TYPE_ERROR {
            t = SemaBuiltin.getErrorType()
        }
        r.setCurrentType(t)
    }

    // named — resolve a class/enum/type-param by name via the symbol table's
    // typeRef. (Generic type arguments are handled in Stage 8.)
    public static void named(const Resolver r, const ASTNamedType node) {
        SemaType t = null
        List<ASTName> names = node.getNames()
        if names.size() > 0 {
            ASTName last = names.get(names.size() - 1)
            Registry reg = r.getReg()
            // A dotted name (pointer) resolves via the namespace path — no import
            // needed. Fall back to a scope lookup of the last component (unqualified
            // types, or names brought into scope by an import).
            Symbol sym = null
            if names.size() > 1 {
                sym = reg.LookupQualifiedType(names)
                // a prefix that is the last segment (or the alias) of an imported
                // namespace — `left.P` after `import probe.left` — expands through
                // the module's imports, as a call's prefix does (fly-lang/fly#268)
                if sym == null {
                    sym = ResolverType.importedType(r, names)
                }
            } else {
                sym = reg.LookupNamedType(last.getName(), r.getCurrentScope())
            }
            if sym != null {
                t = sym.getTypeRef()
            }
        }

        // Generic instantiation: Wrapper<int> → resolve type args, get-or-create the
        // specialization, and resolve it in isolation (T → concrete).
        List<ASTType> targs = node.getTypeArgs()
        if targs.size() > 0 {
            SemaClassType spec = ResolverType.instantiate(r, t, targs)
            if spec != null {
                r.setCurrentType(spec)
                return
            }
            // Type args were written but no specialization exists (non-generic
            // base, arity mismatch, or unresolved arg). Falling through with the
            // raw template used to codegen a null struct type → libLLVM crash.
            if t != null {
                if names.size() > 0 {
                    ASTName last2 = names.get(names.size() - 1)
                    r.diagStr(node.getLoc(), DiagID.err_sema_bad_type_args, last2.getName())
                }
                r.setCurrentType(null)
                return
            }
        }

        // A named type that resolved to nothing is an unknown type.
        if t == null {
            if names.size() > 0 {
                ASTName last = names.get(names.size() - 1)
                r.diagStr(node.getLoc(), DiagID.err_sema_unknown_type, last.getName())
            }
        }

        r.setCurrentType(t)
    }

    // instantiate — build (or fetch) the specialization of generic `t` for `targs`;
    // null if `t` is not an instantiable generic class or a type arg fails to resolve.
    // importedType — a dotted type name whose first segment names an import: the
    // last segment of the imported namespace or its alias. The prefix expands to
    // the full namespace path (ResolverCall.expandNsPath) and the last name is
    // looked up there. Null when the prefix is no import.
    public static Symbol importedType(const Resolver r, const List<ASTName> names) {
        List<string> prefix = new List<string>()
        int i = 0
        while i < names.size() - 1 {
            ASTName n = names.get(i)
            prefix.add(n.getName())
            i = i + 1
        }
        List<string> full = ResolverCall.expandNsPath(r, prefix)
        if full == null {
            return null
        }
        Registry reg = r.getReg()
        SemaNameSpace ns = reg.lookupNameSpaceByStrings(full)
        if ns == null {
            return null
        }
        ASTName last = names.get(names.size() - 1)
        SymbolTable nst = ns.getSymbols()
        return firstOf(nst.lookup(last.getName()))
    }

    // pathType — the type a dotted path of an EXPRESSION names, as in
    // `probe.left.Mode.ON` or `left.P.count` (fly-lang/fly#270): the last name is
    // the type, the names before it its namespace, written in full or through an
    // import (its last segment or its alias, ResolverCall.expandNsPath). Null
    // when the path is no type: a single name, a first name that is a value in
    // scope (a local shadows a prefix), a prefix that is no namespace.
    public static Symbol pathType(const Resolver r, const List<string> path) {
        if path == null {
            return null
        }
        if path.size() < 2 {
            return null
        }
        Registry reg = r.getReg()
        Symbol head = reg.LookupName(path.get(0), r.getCurrentScope())
        if head != null {
            SymbolKind hk = head.getKind()
            if hk == SymbolKind.VAR || hk == SymbolKind.LOCAL_VAR || hk == SymbolKind.PARAM ||
                    hk == SymbolKind.ATTRIBUTE {
                return null
            }
        }
        List<string> prefix = new List<string>()
        int i = 0
        while i < path.size() - 1 {
            prefix.add(path.get(i))
            i = i + 1
        }
        SemaNameSpace ns = reg.lookupNameSpaceByStrings(prefix)
        if ns == null {
            List<string> full = ResolverCall.expandNsPath(r, prefix)
            if full != null {
                ns = reg.lookupNameSpaceByStrings(full)
            }
        }
        if ns == null {
            return null
        }
        SymbolTable nst = ns.getSymbols()
        Symbol sym = firstOf(nst.lookup(path.get(path.size() - 1)))
        if sym == null {
            return null
        }
        if sym.getTypeRef() == null {
            return null
        }
        return sym
    }

    public static SemaClassType instantiate(const Resolver r, const SemaType t, const List<ASTType> targs) {
        if t == null {
            return null
        }
        SemaClassType template = t.asClass()
        if template == null {
            return null
        }
        if template.isGeneric() == false {
            return null
        }

        List<SemaType> typeArgs = new List<SemaType>()
        bool okAll = true
        int i = 0
        while i < targs.size() {
            ASTType ta = targs.get(i)
            ta.accept(r)
            SemaType tas = r.getCurrentType()
            if tas == null {
                okAll = false
            }
            typeArgs.add(tas)
            i = i + 1
        }
        if okAll == false {
            return null
        }
        List<SemaTypeParam> tparams = template.getTypeParams()
        if typeArgs.size() != tparams.size() {
            return null
        }

        // A template whose methods have no bodies cannot be monomorphized: the
        // specialization re-walks the template's AST, so with nothing to walk it
        // ends up with abstract methods and codegen emits EMPTY linkonce_odr
        // definitions — which, being weak, can even outrank the archive's real
        // symbols at link time. Silent wrong code; say so instead. Reachable when a
        // lib ships a generic as a bare declaration, which is exactly what
        // HeaderGen's `.fly` companion exists to prevent.
        if ResolverClass.templateHasNoBodies(template) {
            r.diagStr(template.getAST().getNameLoc(), DiagID.err_sema_generic_template_no_body, template.getName())
            return null
        }
        SemaClassType spec = SemaBuilder.CreateSpecialization(template, typeArgs, r.getCurrentScope())
        ResolverClass.resolveClassTypeIsolated(r, spec)
        // Named inside a body (a local, a `new`, a cast): a use. Named only in a
        // signature or a field of an unused specialization: not yet.
        if r.isInBodies() {
            spec.markUsed()
        }
        return spec
    }

    public static void array(const Resolver r, const ASTArrayType node) {
        ASTType et = node.getElementType()
        et.accept(r)
        SemaType el = r.getCurrentType()
        SemaArrayType at = SemaBuiltin.CreateArrayType(el, 0)
        // Carry the size expression through to codegen (`T[N]` default-init). The
        // compile-time `size` stays 0: codegen reads the expr, not a constant.
        ASTExpr se = node.getSizeExpr()
        if se != null {
            se.accept(r)
            at.setSizeExpr(r.getCurrentExpr())
        }
        r.setCurrentType(at)
    }
}
