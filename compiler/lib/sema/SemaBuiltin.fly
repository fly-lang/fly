namespace fly.compiler.sema

import fly.compiler.sema.SemaType
import fly.compiler.sema.SemaIntType
import fly.compiler.sema.SemaFloatType
import fly.compiler.sema.SemaIntTypeKind
import fly.compiler.sema.SemaFloatTypeKind
import fly.compiler.sema.SemaBoolType
import fly.compiler.sema.SemaComplexType
import fly.compiler.sema.SemaStringType
import fly.compiler.sema.SemaVoidType
import fly.compiler.sema.SemaErrorType
import fly.compiler.sema.SemaArrayType

// ─────────────────────────────────────────────────────────────────────────────
// SemaBuiltin — factory for the builtin types. 1:1 with C++ SemaBuiltin, but the
// getters return a FRESH instance each call instead of a cached singleton: type
// identity here is by Name (SemaType.isEquals), so two `int` instances compare
// equal and no shared CodeGen state needs caching.
// ─────────────────────────────────────────────────────────────────────────────

public class SemaBuiltin {

    public SemaBuiltin() { }

    public static SemaType getBoolType()   { return new SemaBoolType() }
    public static SemaIntType getByteType()   { return new SemaIntType(SemaIntTypeKind.TYPE_BYTE, "byte") }
    public static SemaIntType getUShortType() { return new SemaIntType(SemaIntTypeKind.TYPE_USHORT, "ushort") }
    public static SemaIntType getShortType()  { return new SemaIntType(SemaIntTypeKind.TYPE_SHORT, "short") }
    public static SemaIntType getUIntType()   { return new SemaIntType(SemaIntTypeKind.TYPE_UINT, "uint") }
    public static SemaIntType getIntType()    { return new SemaIntType(SemaIntTypeKind.TYPE_INT, "int") }
    public static SemaIntType getULongType()  { return new SemaIntType(SemaIntTypeKind.TYPE_ULONG, "ulong") }
    public static SemaIntType getLongType()   { return new SemaIntType(SemaIntTypeKind.TYPE_LONG, "long") }
    public static SemaIntType getPtrSizeType() { return new SemaIntType(SemaIntTypeKind.TYPE_POINTER, "pointer") }
    public static SemaFloatType getFloatType()  { return new SemaFloatType(SemaFloatTypeKind.TYPE_FLOAT, "float") }
    public static SemaFloatType getDoubleType() { return new SemaFloatType(SemaFloatTypeKind.TYPE_DOUBLE, "double") }
    public static SemaComplexType getComplexType() { return new SemaComplexType() }
    public static SemaType getVoidType()   { return new SemaVoidType() }
    public static SemaType getStringType() { return new SemaStringType() }
    public static SemaErrorType getErrorType() { return new SemaErrorType() }

    public static SemaArrayType CreateArrayType(const SemaType elementType, const long size) {
        return new SemaArrayType(elementType, size)
    }
}
