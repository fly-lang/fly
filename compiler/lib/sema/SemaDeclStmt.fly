namespace fly.compiler.sema
import fly.compiler.sema.SemaVisitor

import fly.compiler.sema.SemaKind
import fly.compiler.sema.SemaStmt
import fly.compiler.sema.SemaLocalVar
import fly.compiler.sema.SemaExpr
import fly.compiler.ast.ASTStmt

// SemaDeclStmt — a local variable declaration (with optional initializer). 1:1.
public class SemaDeclStmt : SemaStmt {

    SemaLocalVar var
    SemaExpr expr
    SemaExpr moveFrom   // `C y = x` with x a unique owner: x, which the move leaves null

    public SemaDeclStmt(const ASTStmt ast, const SemaLocalVar var, const SemaExpr expr) {
        super(SemaKind.STMT_DECL, ast)
        this.var = var
        this.expr = expr
        this.moveFrom = null
    }

    public SemaLocalVar getVar() {
        return this.var
    }
    public SemaExpr getExpr() {
        return this.expr
    }
    public SemaExpr getMoveFrom() {
        return this.moveFrom
    }
    public void setMoveFrom(const SemaExpr e) {
        this.moveFrom = e
    }
    public void accept(const SemaVisitor v) {
        v.visit(this)
    }
}
