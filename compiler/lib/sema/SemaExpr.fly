namespace fly.compiler.sema
import fly.compiler.sema.SemaVisitor

import fly.compiler.sema.SemaKind
import fly.compiler.sema.SemaNode
import fly.compiler.sema.SemaType
import fly.compiler.sema.SemaCall
import fly.mem

// ─────────────────────────────────────────────────────────────────────────────
// SemaExpr — base of every resolved expression, a 1:1 port of C++ SemaExpr
// (minus the CodeGenExpr back-pointer). Carries the resolved Type and a
// parent/child link used to thread member/call chains.
// ─────────────────────────────────────────────────────────────────────────────

public class SemaExpr : SemaNode {

    SemaExpr child
    SemaExpr parent
    SemaType type
    pointer llvmValue   // CodeGen back-pointer: the LLVM value (null until codegen'd)
    bool escapedFlag    // Stage-7 alloc tracking: this value ESCAPED its scope (was
                        // passed as a call argument or assigned away) — scope-exit
                        // cleanup must not free it. Lives on the base as a plain
                        // field (a narrowing virtual would trip the vtable-shift
                        // gotcha above); only SemaLocalVars in a block's alloc list
                        // are ever consulted.
    bool ownedStrTemp   // CodeGen marker: gen'ing this expr produced a FRESH OWNED
                        // heap string buffer (only string-concat sets it). A consumer
                        // that copies the bytes out (the enclosing concat) frees it
                        // here to avoid leaking the intermediate. A plain field, same
                        // rationale as escapedFlag (no narrowing virtual). NOT set by
                        // borrowed producers (var/param/literal/getter) → never freed.

    public SemaExpr(const SemaKind kind, const SemaType type) {
        super(kind)
        this.type = type
        this.llvmValue = 0
        this.escapedFlag = false
        this.ownedStrTemp = false
    }

    public SemaType getType() { out = this.type }
    public void setType(const SemaType type) { this.type = type }
    public bool isEscaped() { out = this.escapedFlag }
    public void setEscaped(const bool e) { this.escapedFlag = e }
    public bool isOwnedStrTemp() { out = this.ownedStrTemp }
    public void setOwnedStrTemp(const bool o) { this.ownedStrTemp = o }

    // asCall — narrow to SemaCall without a downcast (null on the base; SemaCall
    // overrides to return `this`). Used to spot `new` initializers for alloc tracking.
    public SemaCall asCall() { out = null }

    // isVarExpr — variable-kind test WITHOUT a narrowing virtual: adding a new
    // base-class virtual mis-dispatches under the bootstrap (vtable-shift gotcha,
    // probed 2026-07-04: `asVar()` returned null through a SemaExpr reference for
    // a live SemaParam). Kind checks are dispatch-free and safe.
    public bool isVarExpr() {
        SemaKind k = this.getKind()
        if k == SemaKind.LOCAL_VAR { out = true  return }
        if k == SemaKind.PARAM_VAR { out = true  return }
        if k == SemaKind.ATTRIBUTE { out = true  return }
        if k == SemaKind.INSTANCE_VAR { out = true  return }
        if k == SemaKind.ERROR_VAR { out = true  return }
        out = false
    }

    public pointer getLlvmValue() { out = this.llvmValue }
    public void setLlvmValue(const pointer v) { this.llvmValue = v }

    public SemaExpr getParent() { out = this.parent }
    public SemaExpr getChild() { out = this.child }
    public void setChild(const SemaExpr child) { this.child = child }

    // setParent — link this expr under `parent` and make this its child (the C++
    // setParent sets both directions).
    public void setParent(const SemaExpr parent) {
        this.parent = parent
        parent.setChild(this)
    }
    // accept — base no-op; concrete leaves override with v.visit(this).
    public void accept(const SemaVisitor v) { }
}
