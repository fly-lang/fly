namespace fly.compiler.sema
import fly.compiler.sema.SemaVisitor

import fly.compiler.sema.SemaKind
import fly.compiler.sema.SemaNode
import fly.compiler.sema.SemaType
import fly.compiler.sema.SemaCall

// ─────────────────────────────────────────────────────────────────────────────
// SemaExpr — base of every resolved expression, a 1:1 port of C++ SemaExpr
// (minus the CodeGenExpr back-pointer). Carries the resolved Type and a
// parent/child link used to thread member/call chains.
// ─────────────────────────────────────────────────────────────────────────────

public class SemaExpr : SemaNode {

    SemaExpr child
    SemaExpr parent
    SemaType type
    pointer llvmValue   // CodeGen back-pointer: the LLVM value (null until codegen'd)
    bool escapedFlag    // Stage-7 alloc tracking: this value ESCAPED its scope (was
                        // passed as a call argument or assigned away) — scope-exit
                        // cleanup must not free it. Lives on the base as a plain
                        // field (a narrowing virtual would trip the vtable-shift
                        // gotcha above); only SemaLocalVars in a block's alloc list
                        // are ever consulted.
    bool ownedStrTemp   // CodeGen marker: gen'ing this expr produced a FRESH OWNED
                        // heap string buffer (only string-concat sets it). A consumer
                        // that copies the bytes out (the enclosing concat) frees it
                        // here to avoid leaking the intermediate. A plain field, same
                        // rationale as escapedFlag (no narrowing virtual). NOT set by
                        // borrowed producers (var/param/literal/getter) → never freed.
    bool constVar       // this expression IS a variable declared `const` (a local
                        // or a parameter). Assignment needs to ask its left side
                        // "are you const?", but holds only a SemaExpr and cannot
                        // narrow it to SemaVar.isConstant(); so the flag is
                        // mirrored here as a plain field, like escapedFlag.
    bool uniqueOwner    // this expression IS a variable that OWNS its object (`new unique`):
                        // deleted at scope end, left null by a move. On the base class with a
                        // plain accessor, like constVar: a narrowing virtual mis-dispatches.
    bool sharedHolder   // this expression IS a variable holding a counted `new shared` reference:
                        // released at scope end; copying it into another holder counts it.
    bool weakRef        // this expression IS a variable holding a weak reference: reads see the
                        // object while it lives and null after; released at scope end.
    bool weakMake       // this expression IS `weak h`: it creates one weak reference.

    public SemaExpr(const SemaKind kind, const SemaType type) {
        super(kind)
        this.type = type
        this.llvmValue = 0
        this.escapedFlag = false
        this.ownedStrTemp = false
        this.constVar = false
        this.uniqueOwner = false
        this.sharedHolder = false
        this.weakRef = false
        this.weakMake = false
    }

    public SemaType getType() {
        return this.type
    }
    public void setType(const SemaType type) {
        this.type = type
    }
    public bool isEscaped() {
        return this.escapedFlag
    }
    public void setEscaped(const bool e) {
        this.escapedFlag = e
    }
    public bool isOwnedStrTemp() {
        return this.ownedStrTemp
    }
    public void setOwnedStrTemp(const bool o) {
        this.ownedStrTemp = o
    }
    public bool isWeakRef() {
        return this.weakRef
    }
    public void setWeakRef(const bool v) {
        this.weakRef = v
    }
    public bool isWeakMake() {
        return this.weakMake
    }
    public void setWeakMake(const bool v) {
        this.weakMake = v
    }
    public bool isSharedHolder() {
        return this.sharedHolder
    }
    public void setSharedHolder(const bool v) {
        this.sharedHolder = v
    }
    public bool isUniqueOwner() {
        return this.uniqueOwner
    }
    public void setUniqueOwner(const bool v) {
        this.uniqueOwner = v
    }
    public bool isConstVar() {
        return this.constVar
    }
    public void setConstVar(const bool c) {
        this.constVar = c
    }

    // asCall — narrow to SemaCall without a downcast (null on the base; SemaCall
    // overrides to return `this`). Used to spot `new` initializers for alloc tracking.
    public SemaCall asCall() {
        return null
    }

    // isVarExpr — variable-kind test WITHOUT a narrowing virtual: adding a new
    // base-class virtual mis-dispatches under the bootstrap (vtable-shift gotcha,
    // probed 2026-07-04: `asVar()` returned null through a SemaExpr reference for
    // a live SemaParam). Kind checks are dispatch-free and safe.
    public bool isVarExpr() {
        SemaKind k = this.getKind()
        if k == SemaKind.LOCAL_VAR {
            return true
        }
        if k == SemaKind.PARAM_VAR {
            return true
        }
        if k == SemaKind.ATTRIBUTE {
            return true
        }
        if k == SemaKind.INSTANCE_VAR {
            return true
        }
        if k == SemaKind.ERROR_VAR {
            return true
        }
        return false
    }

    public pointer getLlvmValue() {
        return this.llvmValue
    }
    public void setLlvmValue(const pointer v) {
        this.llvmValue = v
    }

    public SemaExpr getParent() {
        return this.parent
    }
    public SemaExpr getChild() {
        return this.child
    }
    public void setChild(const SemaExpr child) {
        this.child = child
    }

    // setParent — link this expr under `parent` and make this its child (the C++
    // setParent sets both directions).
    public void setParent(const SemaExpr parent) {
        this.parent = parent
        parent.setChild(this)
    }
    // accept — base no-op; concrete leaves override with v.visit(this).
    public void accept(const SemaVisitor v) { }
}
