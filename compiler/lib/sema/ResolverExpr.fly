namespace fly.compiler.sema

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.basic.*
import fly.data.List
import fly.str as s

// ResolverExpr — expression resolution companion. Sets r.currentExpr.
public class ResolverExpr {

    public ResolverExpr() { }

    // identifier — resolve a name to the variable it references (via the symbol's
    // exprRef). Function/type identifiers and member chains come later.
    public static void identifier(const Resolver r, const ASTIdentifier node) {
        // The implicit `error` variable: reads as bool ("did the last handle
        // block record a failure?"). handle blocks update it automatically.
        if s.equals(node.getName(), "error") {
            SemaError eref = new SemaError(null)
            eref.setType(SemaBuiltin.getBoolType())
            r.setCurrentExpr(eref)
            return
        }
        Registry reg = r.getReg()
        Symbol sym = reg.LookupName(node.getName(), r.getCurrentScope())
        SemaExpr e = null
        if sym != null {
            e = sym.getExprRef()
            // A user-declared `error`-typed variable cannot be read as a value
            // (its state lives in the hidden per-function struct): point the
            // user at the implicit `error` variable instead.
            if e != null {
                SemaType et = e.getType()
                if et != null {
                    if et.isError() {
                        r.diagStr(node.getLoc(), DiagID.err_sema_error_var_read, node.getName())
                    }
                }
            } else {
                // The name resolved to a symbol that yields no value — a namespace
                // (`int x = fly`), a type/class/enum name (`int y = C`), or a function
                // name (`int y = g`). Previously all of these returned null with NO
                // diagnostic — a silent hole that compiled to a no-op. Report by kind.
                // (VAR/PARAM/ATTRIBUTE keep their value; ENUM_ENTRY/VALUE stay silent —
                // they are genuine values whose exprRef, if absent, is handled upstream.)
                SymbolKind sk = sym.getKind()
                if sk == SymbolKind.NAMESPACE {
                    r.diagStr(node.getLoc(), DiagID.err_sema_not_a_value, node.getName())
                } elsif sk == SymbolKind.FUNCTION {
                    r.diagStr(node.getLoc(), DiagID.err_sema_function_not_a_value, node.getName())
                } elsif sk == SymbolKind.TYPE || sk == SymbolKind.CLASS || sk == SymbolKind.ENUM || sk == SymbolKind.BUILTIN_TYPE {
                    r.diagStr(node.getLoc(), DiagID.err_sema_type_not_a_value, node.getName())
                }
            }
        } else {
            r.diagStr(node.getLoc(), DiagID.err_sema_unresolved_identifier, node.getName())
        }
        r.setCurrentExpr(e)
    }

    public static void binary(const Resolver r, const ASTBinary node) {
        ASTExpr l = node.getLeftExpr()
        l.accept(r)
        SemaExpr left = r.getCurrentExpr()
        ASTExpr rt = node.getRightExpr()
        rt.accept(r)
        SemaExpr right = r.getCurrentExpr()
        SemaBinary b = SemaBuilder.CreateBinary(node, left, right)
        // Numeric promotion: an arithmetic op over two numbers yields the wider type
        // (Stage 7). Comparisons/logic (bool) and assignments (assignee type) keep the
        // default. CreateBinary defaulted the type to the left operand's.
        if node.isArith() {
            if left != null {
                if right != null {
                    SemaType lt = left.getType()
                    SemaType rtp = right.getType()
                    if lt != null {
                        if rtp != null {
                            if lt.isNumber() {
                                if rtp.isNumber() {
                                    b.setType(promoteNumberTypes(lt, rtp))
                                }
                            }
                        }
                    }
                }
            }
        } else {
            // comparisons and logic yield BOOL (the CreateBinary default is the
            // left operand's type, which broke overload matching on args like
            // `assertTrue(x >= 0, tag)` — audit V4). Assignments keep the default
            // (the assignee's type).
            ASTBinaryKind bk = node.getBinaryKind()
            if bk != ASTBinaryKind.OP_BINARY_ASSIGN {
                b.setType(SemaBuiltin.getBoolType())
            } else {
                // Stage-7 escape marking: an assigned-away variable (`this.f = p`,
                // `x = p`, `out = p`) escapes its scope — never free it at exit.
                // EXCEPTION (clone-on-store): a STRING RHS is deep-copied by the assign
                // (CodeGenExprOps.assign → cloneIfString), so `a = b` does NOT alias b's
                // buffer — b stays solely owned and is safe to free at scope exit.
                // Marking it escaped would needlessly leak it. Only non-string assigns
                // (class handles, which truly alias the same object) must escape.
                if right != null {
                    if right.isVarExpr() {
                        SemaType rvt = right.getType()
                        bool rIsStr = false
                        if rvt != null { rIsStr = rvt.isString() }
                        if rIsStr == false { right.setEscaped(true) }
                    }
                }
            }
        }
        r.setCurrentExpr(b)
    }

    public static void unary(const Resolver r, const ASTUnary node) {
        ASTExpr e = node.getExpr()
        e.accept(r)
        SemaExpr inner = r.getCurrentExpr()
        SemaUnary u = SemaBuilder.CreateUnary(node, inner)
        r.setCurrentExpr(u)
    }

    public static void ternary(const Resolver r, const ASTTernary node) {
        ASTExpr c = node.getConditionExpr()
        c.accept(r)
        SemaExpr cond = r.getCurrentExpr()
        ASTExpr te = node.getTrueExpr()
        te.accept(r)
        SemaExpr trueE = r.getCurrentExpr()
        ASTExpr fe = node.getFalseExpr()
        fe.accept(r)
        SemaExpr falseE = r.getCurrentExpr()
        // numeric promotion of the two branches is deferred to Stage 7.
        SemaTernary t = SemaBuilder.CreateTernary(node, cond, trueE, falseE)
        r.setCurrentExpr(t)
    }

    public static void cast(const Resolver r, const ASTCast node) {
        ASTExpr e = node.getExpr()
        e.accept(r)
        SemaExpr from = r.getCurrentExpr()
        // an unresolved inner expr already reported its diagnostic — building a
        // cast around null would segfault codegen (gen on a null expr)
        if from == null { r.setCurrentExpr(null)  return }
        ASTType tt = node.getToType()
        tt.accept(r)
        SemaType toType = r.getCurrentType()
        SemaCast c = SemaBuilder.CreateCast(node, from, toType)
        r.setCurrentExpr(c)
    }

    // member — `obj.field` / `this.field`: resolve the receiver expression, then
    // look up the field on its class (LookupAttribute traverses the inheritance
    // chain). Enum accessors / static / namespace member access are Stage 7+.
    public static void member(const Resolver r, const ASTMember node) {
        ASTExpr parent = node.getParent()
        if parent == null { r.setCurrentExpr(null)  return }

        // `super.attr` (audit V4): read an INHERITED field through the current
        // method's `this` — the attribute is looked up from the FIRST base up the
        // chain (never the current class). Flat object layout means the base
        // field lives at the same slot, so codegen needs no receiver adjustment.
        ASTIdentifier suid = parent.asIdentifier()
        if suid != null {
            if parent.getParent() == null {
                if s.equals(suid.getName(), "super") {
                    SemaClassType scls = r.getCurrentClass()
                    if scls != null {
                        List<SemaClassType> sbases = scls.getBaseClasses()
                        if sbases.size() > 0 {
                            SemaClassType sbase = sbases.get(0)
                            SemaClassAttribute sattr = sbase.LookupAttribute(node.getName())
                            if sattr == null {
                                r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
                                r.setCurrentExpr(null)
                                return
                            }
                            Registry sreg = r.getReg()
                            Symbol tsym = sreg.LookupName("this", r.getCurrentScope())
                            SemaExpr thisE = null
                            if tsym != null { thisE = tsym.getExprRef() }
                            SemaMember smem = SemaBuilder.CreateMemberVar(node, sattr, thisE)
                            r.setCurrentExpr(smem)
                            return
                        }
                    }
                    r.setCurrentExpr(null)
                    return
                }
            }
        }

        // Enum entry access `EnumName.ENTRY`: the parent is a bare identifier naming
        // an enum TYPE (not a value), so resolve it as a named type first — this also
        // avoids the spurious "unresolved identifier" diagnostic that resolving the
        // type name as a value expression would emit.
        ASTIdentifier pid = parent.asIdentifier()
        if pid != null {
            Registry ereg = r.getReg()
            Symbol tsym = ereg.LookupNamedType(pid.getName(), r.getCurrentScope())
            if tsym != null {
                SemaType tt = tsym.getTypeRef()
                if tt != null {
                    SemaEnumType et = tt.asEnum()
                    if et != null {
                        SemaEnumEntry entry = et.LookupEntry(node.getName())
                        if entry != null { r.setCurrentExpr(entry)  return }
                        r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
                        r.setCurrentExpr(null)
                        return
                    }
                }
            }
        }

        parent.accept(r)
        SemaExpr pe = r.getCurrentExpr()
        if pe == null { r.setCurrentExpr(null)  return }
        SemaType pt = pe.getType()
        if pt == null { r.setCurrentExpr(null)  return }

        // Enum property access: `<entry-or-enum-var>.value` (int, the 1-based
        // index) / `.name` (string). Builds SemaEnumAccessor with exactly one of
        // {entry, var} set — mirrors the reference's SemaEnumAccessor model.
        SemaEnumType pen = pt.asEnum()
        if pen != null {
            bool accName = s.equals(node.getName(), "name")
            bool accValue = s.equals(node.getName(), "value")
            if accName || accValue {
                SemaEnumEntry accEntry = pe.asEnumEntry()
                SemaType accTy = SemaBuiltin.getStringType()
                if accValue { accTy = SemaBuiltin.getIntType() }
                // var slot stays null: codegen reads NON-entry receivers through
                // the accessor's parent expr (narrowing to SemaVar would need a
                // new base virtual — the bootstrap mis-dispatches those)
                SemaEnumAccessor acc = new SemaEnumAccessor(pen, accEntry, null, accName, accTy)
                // non-literal receivers (locals, params, field chains like
                // `this.kind`) travel as the accessor's parent expr; codegen
                // gens the parent for the runtime i32 value
                if accEntry == null { acc.setParent(pe) }
                r.setCurrentExpr(acc)
                return
            }
            r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
            r.setCurrentExpr(null)
            return
        }

        SemaClassType pcls = pt.asClass()
        if pcls == null { r.setCurrentExpr(null)  return }
        SemaClassAttribute attr = pcls.LookupAttribute(node.getName())
        if attr == null {
            r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
            r.setCurrentExpr(null)
            return
        }
        SemaMember mem = SemaBuilder.CreateMemberVar(node, attr, pe)
        r.setCurrentExpr(mem)
    }
}

// promoteNumberTypes — rank-based widening (1:1 with C++ Resolver::PromoteNumberTypes):
// the operand with the higher (or equal) rank wins.
public SemaType promoteNumberTypes(const SemaType left, const SemaType right) {
    if left.getRank() >= right.getRank() { out = left } else { out = right }
}
