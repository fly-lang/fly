namespace fly.compiler.sema

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.basic.*
import fly.data.List
import fly.str

// ResolverExpr — expression resolution companion. Sets r.currentExpr.
public class ResolverExpr {

    public ResolverExpr() { }

    // identifier — resolve a name to the variable it references (via the symbol's
    // exprRef). Function/type identifiers and member chains come later.
    public static void identifier(const Resolver r, const ASTIdentifier node) {
        // The implicit `error` variable: reads as bool ("did the last handle
        // block record a failure?"). handle blocks update it automatically.
        if str.equals(node.getName(), "error") {
            SemaError eref = new SemaError(null)
            eref.setType(SemaBuiltin.getBoolType())
            r.setCurrentExpr(eref)
            return
        }
        Registry reg = r.getReg()
        Symbol sym = reg.LookupName(node.getName(), r.getCurrentScope())
        SemaExpr e = null
        if sym != null {
            e = sym.getExprRef()
            // A user-declared `error`-typed variable cannot be read as a value
            // (its state lives in the hidden per-function struct): point the
            // user at the implicit `error` variable instead.
            if e != null {
                SemaType et = e.getType()
                if et != null {
                    if et.isError() {
                        r.diagStr(node.getLoc(), DiagID.err_sema_error_var_read, node.getName())
                    }
                }
                if e.getKind() == SemaKind.INSTANCE_VAR {
                    r.noteThis(node)
                }
            } else {
                // The name resolved to a symbol that yields no value — a namespace
                // (`int x = fly`), a type/class/enum name (`int y = C`), or a function
                // name (`int y = g`). Previously all of these returned null with NO
                // diagnostic — a silent hole that compiled to a no-op. Report by kind.
                // (VAR/PARAM/ATTRIBUTE keep their value; ENUM_ENTRY/VALUE stay silent —
                // they are genuine values whose exprRef, if absent, is handled upstream.)
                SymbolKind sk = sym.getKind()
                if sk == SymbolKind.NAMESPACE {
                    r.diagStr(node.getLoc(), DiagID.err_sema_not_a_value, node.getName())
                } elsif sk == SymbolKind.FUNCTION {
                    r.diagStr(node.getLoc(), DiagID.err_sema_function_not_a_value, node.getName())
                } elsif sk == SymbolKind.TYPE || sk == SymbolKind.CLASS || sk == SymbolKind.ENUM ||
                        sk == SymbolKind.BUILTIN_TYPE {
                    r.diagStr(node.getLoc(), DiagID.err_sema_type_not_a_value, node.getName())
                }
            }
        } else {
            r.diagStr(node.getLoc(), DiagID.err_sema_unresolved_identifier, node.getName())
        }
        r.setCurrentExpr(e)
    }

    // ownedSource — may an owner take this value? A `new unique` object, another
    // owner (moved), the result of a call that returns an owner, or null (which
    // just deletes what the owner held).
    // sharedSource — may a shared holder take this value? A `new shared` object,
    // another holder (counted copy), the result of a call that returns a
    // holder, or null (which just releases what the holder had).
    public static bool sharedSource(const SemaExpr e) {
        if e.isSharedHolder() {
            return true          // a counted copy, from a local or a holding field
        }
        if e.isWeakRef() {
            return true          // a promotion: counted when the object still lives, else null
        }
        if e.getKind() == SemaKind.VALUE && e.getType() == null {
            return true
        }
        SemaCall c = e.asCall()
        if c == null {
            return false
        }
        if c.getAST().getCallKind() == ASTCallKind.CALL_NEW_SHARED {
            return true
        }
        return ResolverStmt.callReturnsShared(c)
    }

    public static bool ownedSource(const SemaExpr e) {
        if e.isUniqueOwner() {
            // only a LOCAL owner moves; an owning field lends, it never gives up
            return e.getKind() == SemaKind.LOCAL_VAR
        }
        if e.getKind() == SemaKind.VALUE && e.getType() == null {
            return true
        }
        SemaCall c = e.asCall()
        if c == null {
            return false
        }
        if c.getAST().getCallKind() == ASTCallKind.CALL_NEW_UNIQUE {
            return true
        }
        return ResolverStmt.callReturnsOwned(c)
    }

    public static void binary(const Resolver r, const ASTBinary node) {
        ASTExpr l = node.getLeftExpr()
        l.accept(r)
        SemaExpr left = r.getCurrentExpr()
        // literal operands, for checkSignCompare (only the last literal is tracked)
        bool lLit = left != null && left == r.getLitExpr()
        bool lNeg = r.isLitNeg()
        ASTExpr rt = node.getRightExpr()
        // `owner = new unique C()`: an owner may take a fresh object, so the
        // right side is a place where `new unique` is allowed.
        bool ownerTarget = false
        if left != null {
            bool owningLeft = left.isUniqueOwner() || left.isSharedHolder() || left.isWeakRef()
            ownerTarget = node.getBinaryKind() == ASTBinaryKind.OP_BINARY_ASSIGN && owningLeft
        }
        ASTExpr savedSite = r.getUniqueSite()
        if ownerTarget {
            r.setUniqueSite(rt)
        }
        rt.accept(r)
        r.setUniqueSite(savedSite)
        SemaExpr right = r.getCurrentExpr()
        bool rLit = right != null && right == r.getLitExpr()
        bool rNeg = r.isLitNeg()
        SemaBinary b = SemaBuilder.CreateBinary(node, left, right)
        if node.isCompare() && left != null && right != null {
            checkSignCompare(r, node.getOpLocation(), left.getType(), right.getType(), lLit, lNeg, rLit, rNeg)
        }
        // Numeric promotion: an arithmetic op over two numbers yields the wider type
        // (Stage 7). Comparisons/logic (bool) and assignments (assignee type) keep the
        // default. CreateBinary defaulted the type to the left operand's.
        if node.isArith() {
            if left != null {
                if right != null {
                    SemaType lt = left.getType()
                    SemaType rtp = right.getType()
                    if lt != null {
                        if rtp != null {
                            if lt.isNumber() {
                                if rtp.isNumber() {
                                    b.setType(promoteNumberTypes(lt, rtp))
                                }
                            }
                            // A string combines only with a string (`a + b` is
                            // concatenation). `"a" + 1` used to resolve as a
                            // string-typed binary and reach codegen with one
                            // operand that is not a string at all.
                            bool lStr = lt.isString()
                            bool rStr = rtp.isString()
                            if lStr != rStr {
                                bool anyGeneric = lt.getKind() == SemaKind.TYPE_PARAM ||
                                        rtp.getKind() == SemaKind.TYPE_PARAM
                                if anyGeneric == false {
                                    r.diagStr2(node.getOpLocation(), DiagID.err_sema_types_operation, lt.getName(),
                                            rtp.getName())
                                }
                            }
                        }
                    }
                }
            }
        } else {
            // comparisons and logic yield BOOL (the CreateBinary default is the
            // left operand's type, which broke overload matching on args like
            // `assertTrue(x >= 0, tag)` — audit V4). Assignments — plain AND
            // compound (B015) — keep the default (the assignee's type).
            ASTBinaryKind bk = node.getBinaryKind()
            bool assignish = bk == ASTBinaryKind.OP_BINARY_ASSIGN || node.isCompoundAssign()
            if assignish == false {
                b.setType(SemaBuiltin.getBoolType())
            } else {
                // Stage-7 escape marking: an assigned-away variable (`this.f = p`,
                // `x = p`, `out = p`) escapes its scope — never free it at exit.
                // EXCEPTION (clone-on-store): a STRING RHS is deep-copied by the assign
                // (CodeGenExprOps.assign → cloneIfString), so `a = b` does NOT alias b's
                // buffer — b stays solely owned and is safe to free at scope exit.
                // Marking it escaped would needlessly leak it. Only non-string assigns
                // (class handles, which truly alias the same object) must escape.
                // EXCEPTION 2 (reference counting): an ARRAY is not escaped either.
                // Escaping suppresses the scope-exit release, and for a refcounted
                // buffer that is precisely the wrong move — `out = xs` retains, so
                // the release is what brings the count back down. Marking it escaped
                // leaves the count permanently raised and NOTHING is ever freed: the
                // whole scheme goes silently inert while every test stays green.
                if right != null {
                    if right.isVarExpr() {
                        SemaType rvt = right.getType()
                        bool rIsStr = false
                        bool rIsArr = false
                        if rvt != null {
                            rIsStr = rvt.isString()
                            rIsArr = rvt.isArray()
                        }
                        if rIsStr == false {
                            if rIsArr == false {
                                right.setEscaped(true)
                            }
                        }
                    }
                }
                // `new unique` ownership. An owner takes only what it may delete: a
                // fresh `new unique` object, another owner (a move, which leaves the
                // source null), an owned call result, or null; its old object is
                // deleted first (codegen). An owner moves only into another owner, a
                // new declaration or a return: anything else would leave two names
                // for one owned object.
                if left != null && right != null {
                    bool rLocal = right.getKind() == SemaKind.LOCAL_VAR
                    if r.isReturnAssign() {
                        // a returned owner OR holder hands its reference to the caller:
                        // the local is left null, so its scope end neither deletes nor
                        // releases it
                        bool handsOut = right.isUniqueOwner() || right.isSharedHolder()
                        if handsOut && rLocal {
                            r.getReturnMoves().add(right)
                        }
                    } elsif left.isWeakRef() {
                        // a weak variable takes only a new weak reference (`w = weak h`)
                        // or null; anything else would be released without being counted
                        bool wNull = right.getKind() == SemaKind.VALUE && right.getType() == null
                        if right.isWeakMake() == false && wNull == false {
                            r.diagStr(node.getOpLocation(), DiagID.err_sema_weak_ref,
                                    "a weak variable takes only 'weak h' or null")
                        }
                    } elsif left.isSharedHolder() {
                        if ResolverExpr.sharedSource(right) == false {
                            r.diagStr(node.getOpLocation(), DiagID.err_sema_shared_ref,
                                    "a holder takes only a 'new shared' object, a holder, a held result or null")
                        }
                    } elsif right.isSharedHolder() && rLocal {
                        r.diagStr(node.getOpLocation(), DiagID.err_sema_shared_ref,
                                "a holder is copied only into another holder, a new declaration (C y = x) or a return")
                    } elsif left.isUniqueOwner() {
                        if left == right {
                            r.diagStr(node.getOpLocation(), DiagID.err_sema_unique_move,
                                    "an owner cannot be assigned to itself")
                        } elsif ResolverExpr.ownedSource(right) == false {
                            r.diagStr(node.getOpLocation(), DiagID.err_sema_unique_move,
                                    "an owner takes only a 'new unique' object, another owner, an owned result or null")
                        }
                    } elsif right.isUniqueOwner() && right.getKind() == SemaKind.LOCAL_VAR {
                        r.diagStr(node.getOpLocation(), DiagID.err_sema_unique_move,
                                "the owner moves only into another owner, a new declaration (C y = x) or a return")
                    }
                }
                // Assignment compatibility: the assignee's type must accept the RHS
                if left != null {
                    if right != null {
                        checkAssignTypes(r, node.getOpLocation(), left.getType(), right.getType())
                        // narrowing applies to a plain `=`; a compound `a += b`
                        // computes in the assignee's own type by definition
                        if node.isCompoundAssign() == false {
                            checkNarrowing(r, node.getOpLocation(), left.getType(), right)
                        }
                    }
                    // A `const` local, parameter or field is read-only (a field
                    // outside the one write constFieldLocked allows). Only the
                    // variable ITSELF is protected: `p.x = 1` through a const `p`
                    // writes a field of the object, which const does not cover.
                    if writesConst(r, l, left) {
                        string cn = "?"
                        ASTIdentifier cid = l.asIdentifier()
                        if cid != null {
                            cn = cid.getName()
                        }
                        ASTMember cmem = l.asMember()
                        if cmem != null {
                            cn = cmem.getName()
                        }
                        r.diagStr(node.getOpLocation(), DiagID.err_sema_const_assign, cn)
                    }
                }
                // string `+=` (or any compound on strings) is UNDEFINED by the
                // docs — reject rather than emit an integer op over %string.
                if node.isCompoundAssign() {
                    if left != null {
                        SemaType clt = left.getType()
                        if clt != null {
                            if clt.isString() {
                                r.diagStr(node.getOpLocation(), DiagID.err_sema_not_supported,
                                        "compound assignments on strings")
                            }
                        }
                    }
                }
            }
        }
        r.setCurrentExpr(b)
    }

    public static void unary(const Resolver r, const ASTUnary node) {
        ASTExpr e = node.getExpr()
        e.accept(r)
        SemaExpr inner = r.getCurrentExpr()
        SemaUnary u = SemaBuilder.CreateUnary(node, inner)
        ASTUnaryKind uk = node.getOpKind()
        // `weak h`: one weak reference to the object of h, which must be a shared
        // holder (or another weak reference). Like `new unique`, it only appears
        // where a variable takes it — a weak reference left in mid-air would be
        // counted and never released.
        if uk == ASTUnaryKind.OP_UNARY_WEAK {
            u.setWeakMake(true)
            if inner != null {
                if inner.isSharedHolder() == false && inner.isWeakRef() == false {
                    r.diagStr(node.getLoc(), DiagID.err_sema_weak_ref,
                            "it observes a 'new shared' object: write 'weak h' with h a shared holder")
                }
            }
            if r.getUniqueSite() != node {
                r.diagStr(node.getLoc(), DiagID.err_sema_weak_ref,
                        "it must initialize a variable declaration or be assigned to a weak variable")
            }
            r.setCurrentExpr(u)
            return
        }
        if inner != null {
            // `-5` is still a constant for the narrowing check: re-record the
            // literal under the unary that negates it.
            if uk == ASTUnaryKind.OP_UNARY_NEG {
                if inner == r.getLitExpr() {
                    if r.isLitNeg() == false {
                        r.noteLiteral(u, r.getLitRaw(), true)
                    }
                }
            }
            // ++ / -- write their operand: not on a const variable.
            bool writes = uk == ASTUnaryKind.OP_UNARY_PRE_INCR || uk == ASTUnaryKind.OP_UNARY_POST_INCR
            if uk == ASTUnaryKind.OP_UNARY_PRE_DECR {
                writes = true
            }
            if uk == ASTUnaryKind.OP_UNARY_POST_DECR {
                writes = true
            }
            if writes {
                if writesConst(r, e, inner) {
                    string un = "?"
                    ASTIdentifier uid = e.asIdentifier()
                    if uid != null {
                        un = uid.getName()
                    }
                    ASTMember umem = e.asMember()
                    if umem != null {
                        un = umem.getName()
                    }
                    r.diagStr(node.getLoc(), DiagID.err_sema_const_assign, un)
                }
            }
        }
        r.setCurrentExpr(u)
    }

    // arrayAccess — `base[index]`. The base must be an array and the index an
    // integer; the resulting expression takes the array's ELEMENT type, so
    // `int x = k[1]` type-checks like any other int expression.
    //
    // A rejected subscript yields a null expression rather than a node of the
    // wrong type: codegen would otherwise GEP through a base it cannot address,
    // which is a backend abort instead of a diagnostic.
    public static void arrayAccess(const Resolver r, const ASTArrayAccess node) {
        ASTExpr be = node.getBase()
        be.accept(r)
        SemaExpr base = r.getCurrentExpr()
        ASTExpr ie = node.getIndex()
        ie.accept(r)
        SemaExpr index = r.getCurrentExpr()
        if base == null {
            r.setCurrentExpr(null)
            return
        }
        if index == null {
            r.setCurrentExpr(null)
            return
        }

        SemaType bt = base.getType()
        SemaArrayType at = null
        if bt != null {
            at = bt.asArray()
        }
        if at == null {
            string bn = "?"
            if bt != null {
                bn = bt.getName()
            }
            r.diagStr(node.getLoc(), DiagID.err_sema_subscript_not_array, bn)
            r.setCurrentExpr(null)
            return
        }

        SemaType it = index.getType()
        bool intIndex = false
        if it != null {
            intIndex = it.isInteger()
        }
        if intIndex == false {
            string inm = "?"
            if it != null {
                inm = it.getName()
            }
            r.diagStr(node.getLoc(), DiagID.err_sema_subscript_index_not_int, inm)
            r.setCurrentExpr(null)
            return
        }

        SemaArrayAccess acc = SemaBuilder.CreateArrayAccess(node, base, index, at.getElementType())
        r.setCurrentExpr(acc)
    }

    public static void ternary(const Resolver r, const ASTTernary node) {
        ASTExpr c = node.getConditionExpr()
        c.accept(r)
        SemaExpr cond = r.getCurrentExpr()
        checkCondition(r, c.getLoc(), cond)
        ASTExpr te = node.getTrueExpr()
        te.accept(r)
        SemaExpr trueE = r.getCurrentExpr()
        ASTExpr fe = node.getFalseExpr()
        fe.accept(r)
        SemaExpr falseE = r.getCurrentExpr()
        // numeric promotion of the two branches is deferred to Stage 7.
        SemaTernary t = SemaBuilder.CreateTernary(node, cond, trueE, falseE)
        r.setCurrentExpr(t)
    }

    public static void cast(const Resolver r, const ASTCast node) {
        ASTExpr e = node.getExpr()
        e.accept(r)
        SemaExpr from = r.getCurrentExpr()
        // an unresolved inner expr already reported its diagnostic — building a
        // cast around null would segfault codegen (gen on a null expr)
        if from == null {
            r.setCurrentExpr(null)
            return
        }
        ASTType tt = node.getToType()
        tt.accept(r)
        SemaType toType = r.getCurrentType()
        checkCastTypes(r, node.getLoc(), from.getType(), toType)
        SemaCast c = SemaBuilder.CreateCast(node, from, toType)
        r.setCurrentExpr(c)
    }

    // member — `obj.field` / `this.field`: resolve the receiver expression, then
    // look up the field on its class (LookupAttribute traverses the inheritance
    // chain). Enum accessors / static / namespace member access are Stage 7+.
    public static void member(const Resolver r, const ASTMember node) {
        ASTExpr parent = node.getParent()
        if parent == null {
            r.setCurrentExpr(null)
            return
        }

        // `super.attr` (audit V4): read an INHERITED field through the current
        // method's `this` — the attribute is looked up from the FIRST base up the
        // chain (never the current class). Flat object layout means the base
        // field lives at the same slot, so codegen needs no receiver adjustment.
        ASTIdentifier suid = parent.asIdentifier()
        if suid != null {
            if parent.getParent() == null {
                if str.equals(suid.getName(), "super") {
                    SemaClassType scls = r.getCurrentClass()
                    if scls != null {
                        List<SemaClassType> sbases = scls.getBaseClasses()
                        if sbases.size() > 0 {
                            SemaClassType sbase = sbases.get(0)
                            SemaClassAttribute sattr = sbase.LookupAttribute(node.getName())
                            if sattr == null {
                                r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
                                r.setCurrentExpr(null)
                                return
                            }
                            if checkMemberAccess(r, node.getLoc(), node.getName(), sattr.getVisibility(),
                                    sattr.getClass()) == false {
                                r.setCurrentExpr(null)
                                return
                            }
                            Registry sreg = r.getReg()
                            Symbol tsym = sreg.LookupName("this", r.getCurrentScope())
                            SemaExpr thisE = null
                            if tsym != null {
                                thisE = tsym.getExprRef()
                            }
                            SemaMember smem = SemaBuilder.CreateMemberVar(node, sattr, thisE)
                            // `super.v` names a field of a base, never this class's
                            // own: a const one is read-only even in a constructor
                            if constFieldLocked(r, sattr, false) {
                                smem.setConstVar(true)
                            }
                            r.setCurrentExpr(smem)
                            return
                        }
                    }
                    r.setCurrentExpr(null)
                    return
                }
            }
        }

        // Enum entry access `EnumName.ENTRY`: the parent is a bare identifier naming
        // an enum TYPE (not a value), so resolve it as a named type first — this also
        // avoids the spurious "unresolved identifier" diagnostic that resolving the
        // type name as a value expression would emit.
        ASTIdentifier pid = parent.asIdentifier()
        if pid != null {
            Registry ereg = r.getReg()
            Symbol tsym = ereg.LookupNamedType(pid.getName(), r.getCurrentScope())
            if tsym != null {
                SemaType tt = tsym.getTypeRef()
                if tt != null {
                    SemaEnumType et = tt.asEnum()
                    if et != null {
                        SemaEnumEntry entry = et.LookupEntry(node.getName())
                        if entry != null {
                            r.setCurrentExpr(entry)
                            return
                        }
                        r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
                        r.setCurrentExpr(null)
                        return
                    }
                    // STATIC field access `ClassName.field` (B030): the parent
                    // names a class TYPE and the member is a static attribute —
                    // build a receiver-less SemaMember carrying the attribute
                    // (codegen reads/writes its module global). A NON-static
                    // attribute through a type name falls through to the normal
                    // path and its "type name, not a value" diagnostic.
                    SemaClassType stc = tt.asClass()
                    if stc != null {
                        SemaClassAttribute sattr2 = stc.LookupAttribute(node.getName())
                        if sattr2 != null {
                            if sattr2.isStatic() {
                                if checkMemberAccess(r, node.getLoc(), node.getName(), sattr2.getVisibility(),
                                        sattr2.getClass()) == false {
                                    r.setCurrentExpr(null)
                                    return
                                }
                                SemaClassType sowner = sattr2.getClass()
                                if sowner != null {
                                    sowner.markUsed()
                                }
                                SemaMember sm2 = SemaBuilder.CreateMemberVar(node, sattr2, null)
                                sm2.setStaticAttr(sattr2)
                                // a static const is set by its initializer only
                                if sattr2.isConstant() {
                                    sm2.setConstVar(true)
                                }
                                r.setCurrentExpr(sm2)
                                return
                            }
                        }
                    }
                }
            }
        }

        parent.accept(r)
        r.takeThisReceiver(parent)
        SemaExpr pe = r.getCurrentExpr()
        if pe == null {
            r.setCurrentExpr(null)
            return
        }
        SemaType pt = pe.getType()
        if pt == null {
            r.setCurrentExpr(null)
            return
        }

        // Enum property access: `<entry-or-enum-var>.value` (int, the 0-based
        // index) / `.name` (string). Builds SemaEnumAccessor with exactly one of
        // {entry, var} set — mirrors the reference's SemaEnumAccessor model.
        SemaEnumType pen = pt.asEnum()
        if pen != null {
            bool accName = str.equals(node.getName(), "name")
            bool accValue = str.equals(node.getName(), "value")
            if accName || accValue {
                SemaEnumEntry accEntry = pe.asEnumEntry()
                SemaType accTy = SemaBuiltin.getStringType()
                if accValue {
                    accTy = SemaBuiltin.getIntType()
                }
                // var slot stays null: codegen reads NON-entry receivers through
                // the accessor's parent expr (narrowing to SemaVar would need a
                // new base virtual — the bootstrap mis-dispatches those)
                SemaEnumAccessor acc = new SemaEnumAccessor(pen, accEntry, null, accName, accTy)
                // non-literal receivers (locals, params, field chains like
                // `this.kind`) travel as the accessor's parent expr; codegen
                // gens the parent for the runtime i32 value
                if accEntry == null {
                    acc.setParent(pe)
                }
                r.setCurrentExpr(acc)
                return
            }
            r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
            r.setCurrentExpr(null)
            return
        }

        SemaClassType pcls = pt.asClass()
        if pcls == null {
            // A member of a value that is not an object (an array, a number, a
            // string): there is none. Resolving to nothing without a diagnostic made
            // `xs.size` read 0, or crash the compiler inside an expression.
            r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
            r.setCurrentExpr(null)
            return
        }
        SemaClassAttribute attr = pcls.LookupAttribute(node.getName())
        if attr == null {
            r.diagStr(node.getLoc(), DiagID.err_sema_unknown_member, node.getName())
            r.setCurrentExpr(null)
            return
        }
        // A PRIVATE field is reachable only from the class that declares it, a
        // PROTECTED one from that class and its subclasses (checkMemberAccess).
        if checkMemberAccess(r, node.getLoc(), node.getName(), attr.getVisibility(), attr.getClass()) == false {
            r.setCurrentExpr(null)
            return
        }
        // reading a field needs the class's layout: a use (lazy generics)
        SemaClassType fowner = attr.getClass()
        if fowner != null {
            fowner.markUsed()
        }
        SemaMember mem = SemaBuilder.CreateMemberVar(node, attr, pe)
        // A `const` field is read-only here unless constFieldLocked lets this
        // constructor set it. The flag rides on the expression (see
        // SemaExpr.constVar), so the assignment and ++/-- checks treat it exactly
        // like a const local.
        if constFieldLocked(r, attr, pe.getKind() == SemaKind.INSTANCE_VAR) {
            mem.setConstVar(true)
        }
        r.setCurrentExpr(mem)
    }

    // constFieldLocked — is a write to `attr` rejected at this point? Only a
    // `const` field is ever locked. A static const is set by its initializer
    // alone. An instance const is set once, by a constructor of the class that
    // declares it, on its own object (`this.v`, or the bare name: `viaThis`), and
    // only when it has no initializer: an initialized const field is fixed like a
    // static one. Every other write — another object, another method, a subclass
    // constructor — is the `cannot assign` error of a const local.
    public static bool constFieldLocked(const Resolver r, const SemaClassAttribute attr, const bool viaThis) {
        if attr.isConstant() == false {
            return false
        }
        if attr.isStatic() {
            return true
        }
        if viaThis == false {
            return true
        }
        ASTVar fast = attr.getAST()
        if fast != null {
            if fast.getExpr() != null {
                return true
            }
        }
        SemaFunctionBase cfn = r.getCurrentFunction()
        if cfn == null {
            return true
        }
        SemaClassMethod cm = cfn.asClassMethod()
        if cm == null {
            return true
        }
        if cm.isConstructor() == false {
            return true
        }
        return classMayAccess(r, attr.getClass()) == false
    }

    // writesConst — does writing `left` (resolved from `ast`) assign a const?
    // A const local, parameter or member expression carries the flag itself; a
    // field named bare inside a method (`v = 1`) resolves to the attribute shared
    // by every use, which cannot carry a per-site flag, so it is judged here.
    public static bool writesConst(const Resolver r, const ASTExpr ast, const SemaExpr left) {
        if left.isConstVar() {
            return true
        }
        if left.getKind() != SemaKind.ATTRIBUTE {
            return false
        }
        ASTIdentifier id = ast.asIdentifier()
        SemaClassType here = r.getCurrentClass()
        if id == null || here == null {
            return false
        }
        SemaClassAttribute attr = here.LookupAttribute(id.getName())
        if attr == null {
            return false
        }
        return constFieldLocked(r, attr, true)
    }

    // arrayValue — resolve an array literal `{e0, e1, ...}`. The element type is
    // taken from the threaded expected type (`T[] a = {...}` → element T), which
    // also gives an empty `{}` a type; otherwise it is inferred from the first
    // element. A resolved element whose type differs from the expected element
    // type is a diagnostic. An empty literal with no expected type cannot infer.
    public static void arrayValue(const Resolver r, const ASTArrayValue node) {
        SemaType expectedEl = null
        SemaType exp = r.getExpectedType()
        if exp != null {
            SemaArrayType ea = exp.asArray()
            if ea != null {
                expectedEl = ea.getElementType()
            }
        }
        List<ASTExpr> asts = node.getValues()
        List<SemaExpr> vals = new List<SemaExpr>()
        SemaType elemT = expectedEl
        int i = 0
        while i < asts.size() {
            ASTExpr ae = asts.get(i)
            SemaType saved = r.getExpectedType()
            r.setExpectedType(expectedEl)       // propagate for nested arrays
            ae.accept(r)
            r.setExpectedType(saved)
            SemaExpr ev = r.getCurrentExpr()
            if ev != null {
                vals.add(ev)
                if elemT == null {
                    elemT = ev.getType()
                }
            }
            i = i + 1
        }
        if elemT == null {
            r.diag(node.getLoc(), DiagID.err_sema_cannot_infer_array_type)
            r.setCurrentExpr(null)
            return
        }
        r.setCurrentExpr(SemaBuilder.CreateArrayValue(node, elemT, vals))
    }

    // structValue — `{name = expr, ...}` (B029): the target type comes from the
    // EXPECTED type (decl initializer / nested struct field); each field name is
    // looked up on the struct class, its expr resolved under the field's expected
    // type, and the pair recorded in source order for codegen.
    public static void structValue(const Resolver r, const ASTStructValue node) {
        SemaType exp = r.getExpectedType()
        SemaClassType ct = null
        if exp != null {
            ct = exp.asClass()
        }
        bool ok = false
        if ct != null {
            if ct.getClassKind() == SemaClassKind.STRUCT {
                ok = true
            }
        }
        if ok == false {
            r.diagStr(node.getLoc(), DiagID.err_sema_not_supported,
                      "struct literals without a struct-typed target (declare as 'T v = {...}')")
            r.setCurrentExpr(null)
            return
        }
        SemaStructValue sv = SemaBuilder.CreateStructValue(node, ct)
        List<string> names = node.getNames()
        List<ASTExpr> exprs = node.getExprs()
        int i = 0
        while i < names.size() {
            string nm = names.get(i)
            SemaClassAttribute a = ct.LookupAttribute(nm)
            if a == null {
                r.diagStr(node.getLoc(), DiagID.err_sema_unresolved_identifier, nm)
            } else {
                ASTExpr fe = exprs.get(i)
                SemaType saved = r.getExpectedType()
                r.setExpectedType(a.getType())
                fe.accept(r)
                r.setExpectedType(saved)
                SemaExpr se = r.getCurrentExpr()
                if se != null {
                    checkAssignTypes(r, fe.getLoc(), a.getType(), se.getType())
                    checkNarrowing(r, fe.getLoc(), a.getType(), se)
                    sv.addField(nm, se)
                }
            }
            i = i + 1
        }
        r.setCurrentExpr(sv)
    }
}

// promoteNumberTypes — rank-based widening (1:1 with C++ Resolver::PromoteNumberTypes):
// the operand with the higher (or equal) rank wins.
public SemaType promoteNumberTypes(const SemaType left, const SemaType right) {
    if left.getRank() >= right.getRank() {
        return left
    } else {
        return right
    }
}

// checkAssignTypes — assignment compatibility: the KIND (string↔number etc.,
// the silent-miscompile class), and for a class the hierarchy (the value's
// class is the target or derives from it, fly-lang/fly#267) and for an enum the
// same enum. Constant narrowing and array element equality are checked
// elsewhere or not yet. Used by the binary-assign resolution (a `return` is one),
// the decl-initializer, field-initializer and struct-literal checks. A null
// side is skipped — an unresolved expr (already diagnosed), or a null/unset
// literal, which carries no type — as are generic type variables (substituted
// at monomorphization).
public void checkAssignTypes(const Resolver r, const SourceLocation loc, const SemaType lhs, const SemaType rhs) {
    if lhs == null {
        return
    }
    if rhs == null {
        return
    }
    if lhs.getKind() == SemaKind.TYPE_PARAM {
        return
    }
    if rhs.getKind() == SemaKind.TYPE_PARAM {
        return
    }
    bool ok = true
    if lhs.isNumber() {
        // class handles are pointer-sized: class → long/pointer stays legal
        ok = rhs.isNumber() || rhs.isClass()
    } elsif lhs.isString() {
        ok = rhs.isString()
    } elsif lhs.isArray() {
        ok = rhs.isArray()
    } elsif lhs.isClass() {
        // integer → class is legal (pointer-sized slots, reference long→class)
        ok = rhs.isClass() || rhs.isInteger()
        // a class value goes only where its class, or a base or an interface of
        // it, is expected (fly-lang/fly#267): the kind alone let any
        // class into any class variable
        SemaClassType lc = lhs.asClass()
        SemaClassType rc = rhs.asClass()
        if ok && lc != null && rc != null {
            ok = rc.isDerivedOrEquals(lc)
        }
    } elsif lhs.isEnum() {
        ok = rhs.isEnum() || rhs.isInteger()
        if ok && rhs.isEnum() {
            ok = lhs.isEquals(rhs)
        }
    }
    if ok == false {
        r.diagStr2(loc, DiagID.err_sema_type_mismatch, typeLabel(rhs, lhs), typeLabel(lhs, rhs))
    }
}

// typeLabel — how a diagnostic names type `t` next to type `other`: its short
// name, qualified with its namespace (`probe.left.P`) for a class or an enum
// whose short name `other` shares while being another type, and followed by
// its type arguments for a specialization (`List<SemaExpr>`).
public string typeLabel(const SemaType t, const SemaType other) {
    string label = t.getName()
    if str.equals(label, other.getName()) && str.equals(t.home(), other.home()) == false {
        label = qualifiedName(t)
    }
    SemaClassType c = t.asClass()
    if c == null {
        return label
    }
    List<SemaType> args = c.getTypeArgs()
    if args == null {
        return label
    }
    if args.size() == 0 {
        return label
    }
    label = str.concat(label, "<")
    int i = 0
    while i < args.size() {
        SemaType a = args.get(i)
        if i > 0 {
            label = str.concat(label, ", ")
        }
        if a != null {
            label = str.concat(label, typeLabel(a, a))
        }
        i = i + 1
    }
    return str.concat(label, ">")
}

// qualifiedName — a class or an enum named with its full namespace
// (`probe.left.P`); the short name for a file without a namespace or any
// other type.
public string qualifiedName(const SemaType t) {
    string name = t.getName()
    SemaModule m = null
    SemaClassType c = t.asClass()
    if c != null {
        m = c.getModule()
    } else {
        SemaEnumType e = t.asEnum()
        if e != null {
            m = e.getModule()
        }
    }
    if m == null {
        return name
    }
    ASTModule am = m.getAST()
    if am == null {
        return name
    }
    ASTNameSpace ns = am.getNameSpace()
    if ns == null {
        return name                         // a file without a namespace
    }
    string label = name
    List<ASTName> parts = ns.getNames()
    int i = (int)parts.size() - 1
    while i >= 0 {
        ASTName part = parts.get(i)
        label = str.concat(part.getName(), str.concat(".", label))
        i = i - 1
    }
    return label
}

// checkNarrowing — the VALUE-level half of assignment compatibility, a port of
// the rank test in the reference SemaValidator::CheckAssignment: a number may be
// stored into a number type of equal or higher rank, never a lower one. Without
// it `int n = aLong` compiled and silently kept the low 32 bits.
//
// Two constants are exempt, because their value is known to fit:
//   - an INTEGER LITERAL whose value fits the target (`byte b = 200`,
//     `short s = -5`, `uint x = 3144134277`) — literals are typed int/long by
//     default, so every small-typed initializer would otherwise need a cast;
//   - a FLOAT LITERAL stored into a `float` (`float f = 1.5`): literals are
//     typed double, and rounding a written constant is not a hidden loss.
// Everything else that loses range needs an explicit cast, which checkCastTypes
// accepts across the whole numeric group. A `bool` target is not a number and is
// left to checkAssignTypes, as in the reference.
public void checkNarrowing(const Resolver r, const SourceLocation loc, const SemaType lhs, const SemaExpr rhsExpr) {
    if lhs == null {
        return
    }
    if rhsExpr == null {
        return
    }
    SemaType rhs = rhsExpr.getType()
    if rhs == null {
        return
    }
    if lhs.isNumber() == false {
        return
    }
    if rhs.isNumber() == false {
        return
    }
    int lr = lhs.getRank()
    int rr = rhs.getRank()
    // An integer into a floating type is implicit but may round: a float holds 24
    // bits of mantissa, a double 53. Warned (not rejected) beyond that, unless the
    // value is a literal, whose rounding the program can see.
    if rhs.isInteger() && lhs.isInteger() == false {
        int ibits = rr
        if ibits % 2 == 1 {
            ibits = ibits + 1
        }
        int mbits = 24
        if lr > 320 {
            mbits = 53
        }
        if ibits > mbits && rhsExpr != r.getLitExpr() {
            r.diagStr2(loc, DiagID.warn_sema_lossy_conversion, rhs.getName(), lhs.getName())
        }
        return
    }
    // A signed value into an unsigned type has no counterpart when it is negative
    // (`uint u = -1` is 4294967295): it needs a cast, whatever the ranks, unless it
    // is a literal that fits. `pointer` is exempt: address arithmetic.
    if lhs.isInteger() && rhs.isInteger() {
        if isSignedInt(rhs) && isPlainUnsignedInt(lhs) {
            if rhsExpr == r.getLitExpr() {
                if intLiteralFits(r.getLitRaw(), r.isLitNeg(), lr) {
                    return
                }
            }
            r.diagStr2(loc, DiagID.err_sema_narrowing, rhs.getName(), lhs.getName())
            return
        }
    }
    if lr >= rr {
        return
    }

    bool bothInt = lhs.isInteger() && rhs.isInteger()
    if bothInt {
        if rhsExpr == r.getLitExpr() {
            if intLiteralFits(r.getLitRaw(), r.isLitNeg(), lr) {
                return
            }
        }
    } else {
        if rhsExpr.getKind() == SemaKind.VALUE {
            bool lFloat = lhs.isInteger() == false
            bool rFloat = rhs.isInteger() == false
            if lFloat && rFloat {
                return
            }
        }
    }
    r.diagStr2(loc, DiagID.err_sema_narrowing, rhs.getName(), lhs.getName())
}

// intLiteralFits — does the decimal literal `raw` (negated when `neg`) fit an
// integer type of promotion rank `rank`? The rank IS the layout: an even rank is
// an unsigned type of that many bits (8, 16, 32, 64), an odd rank a signed type
// of rank+1 bits (15, 31, 63). A literal that is not plain decimal digits is
// accepted — this check only ever rejects what it can prove does not fit.
public bool intLiteralFits(const string raw, const bool neg, const int rank) {
    bool isUnsigned = rank % 2 == 0
    int bits = rank
    if isUnsigned == false {
        bits = rank + 1
    }
    if bits >= 64 {
        return true
    }

    long mag = 0
    bool huge = false
    int n = str.len(raw)
    int i = 0
    while i < n {
        byte b = str.byteAt(raw, i)
        int c = b
        if c < 48 {
            return true
        }
        if c > 57 {
            return true
        }
        if huge == false {
            long d = c - 48
            mag = mag * 10 + d
            if mag > 4294967296 {
                huge = true
            }
        }
        i = i + 1
    }
    if huge {
        return false
    }

    long max = 255
    if bits == 16 {
        max = 65535
    }
    if bits == 32 {
        max = 4294967295
    }
    if isUnsigned {
        // a negative constant never fits an unsigned type (zero does)
        if neg {
            return mag == 0
        }
        return mag <= max
    }
    // signed: the positive range is half the unsigned one, the negative range
    // reaches one further (-32768, -2147483648)
    long smax = 32767
    if bits == 32 {
        smax = 2147483647
    }
    if neg {
        return mag <= smax + 1
    }
    return mag <= smax
}

// checkCastTypes — a port of the reference SemaValidator::CheckCast: which
// `(T)expr` conversions the language actually allows. bool / integer / float
// form one mutually-castable numeric group (`pointer` is an integer KIND, so
// pointer<->long arithmetic keeps working); string, complex and array cast only
// to themselves; a class or an enum casts only along its own derivation chain.
// Everything else is rejected HERE — `(pointer)aClassRef` used to sail through
// sema and die in the backend verifier on `sext ptr to i64`, which reports no
// source location at all.
// The reference's lossy-narrowing WARNINGS are deliberately not ported: the
// self-host has no warning id for them, and they are not what this guard is for.
// A null side is skipped — an unresolved expr (already diagnosed) or a `null` /
// `unset` literal, which carries no type — as are generic type variables, which
// only take their real type at monomorphization.
public void checkCastTypes(const Resolver r, const SourceLocation loc, const SemaType fromType, const SemaType toType) {
    if fromType == null {
        return
    }
    if toType == null {
        return
    }
    if fromType.getKind() == SemaKind.TYPE_PARAM {
        return
    }
    if toType.getKind() == SemaKind.TYPE_PARAM {
        return
    }

    // identity: the same type is always castable to itself
    if fromType.isEquals(toType) {
        return
    }

    // numeric group: bool / integer / float convert freely among themselves
    bool fromNum = fromType.isBool() || fromType.isNumber()
    bool toNum = toType.isBool() || toType.isNumber()
    if fromNum && toNum {
        return
    }

    // same-kind identity casts (string, complex, array)
    if fromType.isString() && toType.isString() {
        return
    }
    if fromType.isComplex() && toType.isComplex() {
        return
    }
    if fromType.isArray() && toType.isArray() {
        return
    }

    // class / enum: allow an upcast or the same derivation
    SemaClassType fromCls = fromType.asClass()
    SemaClassType toCls = toType.asClass()
    if fromCls != null && toCls != null {
        if fromCls.isDerivedOrEquals(toCls) {
            return
        }
    }
    SemaEnumType fromEnum = fromType.asEnum()
    SemaEnumType toEnum = toType.asEnum()
    if fromEnum != null && toEnum != null {
        if fromEnum.isDerivedOrEquals(toEnum) {
            return
        }
    }

    // every other combination is invalid
    r.diagStr2(loc, DiagID.err_sema_invalid_cast, fromType.getName(), toType.getName())
}

// checkCondition — an `if` / `elsif` / loop / ternary condition must be `bool`
// (the reference SemaValidator::CheckCondition). The implicit `error` variable
// already reads as bool. An `int` condition used to resolve and then fail in the
// LLVM verifier (`br` on an i32) with no source location. A null expression or
// type was diagnosed where it failed to resolve; a generic type variable only
// takes its real type at monomorphization.
public void checkCondition(const Resolver r, const SourceLocation loc, const SemaExpr cond) {
    if cond == null {
        return
    }
    SemaType t = cond.getType()
    if t == null {
        return
    }
    if t.isBool() {
        return
    }
    if t.isError() {
        return
    }
    if t.getKind() == SemaKind.TYPE_PARAM {
        return
    }
    r.diagStr(loc, DiagID.err_sema_condition_not_bool, t.getName())
}

// classMayAccess — may the code being resolved touch a PRIVATE member of
// `owner`? Only from inside `owner` itself (the reference rule:
// CurrentClass != &Attr->getClass()). Compared by identity first and by isEquals
// (name and namespace) second: a generic specialization resolves its methods against its own member
// copies, but a member inherited into one may still name the template.
public bool classMayAccess(const Resolver r, const SemaClassType owner) {
    SemaClassType here = r.getCurrentClass()
    if here == null {
        return false
    }
    if owner == null {
        return false
    }
    if here == owner {
        return true
    }
    return here.isEquals(owner)            // same name, same namespace (fly-lang/fly#264)
}

// classMayAccessProtected — may the code being resolved touch a PROTECTED
// member of `owner`? From `owner` itself and from every class derived from it,
// directly or not. The rule looks only at WHERE the code is, never at the
// receiver: a method of a subclass reaches the member through `this`, `super`,
// another instance of the subclass or a plain `owner` alike.
public bool classMayAccessProtected(const Resolver r, const SemaClassType owner) {
    if owner == null {
        return false
    }
    SemaClassType here = r.getCurrentClass()
    if here == null {
        return false
    }
    return derivesFrom(here, owner, 0)
}

// derivesFrom — `cls` is `owner` or one of its descendants, compared like
// classMayAccess (identity, then name and namespace). `depth` stops a malformed cyclic
// hierarchy, which Sema reports elsewhere, from recursing forever.
public bool derivesFrom(const SemaClassType cls, const SemaClassType owner, const int depth) {
    if cls == null {
        return false
    }
    if cls == owner {
        return true
    }
    if cls.isEquals(owner) {
        return true
    }
    if depth > 64 {
        return false
    }
    List<SemaClassType> bases = cls.getBaseClasses()
    int i = 0
    while i < bases.size() {
        if derivesFrom(bases.get(i), owner, depth + 1) {
            return true
        }
        i = i + 1
    }
    return false
}

// checkMemberAccess — report a member of `owner` the code being resolved may
// not reach: a PRIVATE one outside `owner`, a PROTECTED one outside `owner` and
// its subclasses. Every member path calls it (instance, static and `super`
// fields and calls, `new`), so a member is guarded however it is named.
// Returns false after the diagnostic.
public bool checkMemberAccess(const Resolver r, const SourceLocation loc, const string name,
        const SemaVisibilityKind vis, const SemaClassType owner) {
    string on = "?"
    if owner != null {
        on = owner.getName()
    }
    if vis == SemaVisibilityKind.PRIVATE {
        if classMayAccess(r, owner) == false {
            r.diagStr2(loc, DiagID.err_sema_symbol_not_accessible, name, on)
            return false
        }
    } elsif vis == SemaVisibilityKind.PROTECTED {
        if classMayAccessProtected(r, owner) == false {
            r.diagStr2(loc, DiagID.err_sema_symbol_protected, name, on)
            return false
        }
    }
    return true
}

// checkCallAccess — checkMemberAccess for the method a call resolved to
// (nothing to check when it is a free function or did not resolve).
public void checkCallAccess(const Resolver r, const ASTCall node, const Symbol sym) {
    if sym == null {
        return
    }
    SemaNode ref = sym.getRef()
    if ref == null {
        return
    }
    SemaFunctionBase fn = ref.asFunctionBase()
    if fn == null {
        return
    }
    SemaClassMethod m = fn.asClassMethod()
    if m == null {
        return
    }
    bool _ok = checkMemberAccess(r, node.getLoc(), node.getName(), m.getVisibility(), m.getClass())
}

// checkProtectedPlacement — `protected` is written only on the methods
// (constructors included) and attributes of a class: anywhere else (a function,
// a variable or parameter, a type, a member of an interface, struct or suite)
// there is no subclass for it to open the member to. `what` names the place.
public void checkProtectedPlacement(const Resolver r, const List<ASTModifier> mods, const string what) {
    int i = 0
    while i < mods.size() {
        ASTModifier m = mods.get(i)
        if m.getModifierKind() == ASTModifierKind.MOD_PROTECTED {
            r.diagStr(m.getLoc(), DiagID.err_sema_protected_placement, what)
        }
        i = i + 1
    }
}

// isSignedInt — an integer type with a sign (odd rank: short, int, long).
public bool isSignedInt(const SemaType t) {
    if t == null {
        return false
    }
    if t.isInteger() == false {
        return false
    }
    return t.getRank() % 2 == 1
}

// isPlainUnsignedInt — an unsigned integer type other than `pointer` (byte,
// ushort, uint, ulong). `pointer` is address arithmetic: a negative offset added
// to it is meant to wrap, so it takes signed values freely.
public bool isPlainUnsignedInt(const SemaType t) {
    if t == null {
        return false
    }
    if t.isInteger() == false {
        return false
    }
    if t.getRank() % 2 == 1 {
        return false
    }
    return str.equals(t.getName(), "pointer") == false
}

// checkSignCompare — a comparison of a signed with an unsigned integer is done
// in the unsigned type when that one is the wider (`-1 < 1u` is false: -1 reads
// as 4294967295). Rejected unless the signed side is a non-negative literal, or
// the signed type is the wider one (`aLong < aUint` compares exactly). The
// literal operands are passed in because only the last literal is tracked.
public void checkSignCompare(const Resolver r, const SourceLocation loc, const SemaType lt, const SemaType rt,
        const bool lLit, const bool lNeg, const bool rLit, const bool rNeg) {
    SemaType st = null
    SemaType ut = null
    bool sLit = false
    bool sNeg = false
    if isSignedInt(lt) && isPlainUnsignedInt(rt) {
        st = lt
        ut = rt
        sLit = lLit
        sNeg = lNeg
    } elsif isSignedInt(rt) && isPlainUnsignedInt(lt) {
        st = rt
        ut = lt
        sLit = rLit
        sNeg = rNeg
    }
    if st == null {
        return
    }
    if st.getRank() > ut.getRank() {
        return
    }
    if sLit && sNeg == false {
        return
    }
    r.diagStr2(loc, DiagID.err_sema_sign_compare, st.getName(), ut.getName())
}
