namespace fly.compiler.sema

import fly.compiler.sema.SemaKind
import fly.compiler.sema.SemaExpr
import fly.compiler.sema.SemaType
import fly.compiler.ast.ASTVar
import fly.mem

// ─────────────────────────────────────────────────────────────────────────────
// SemaVar — base of the resolved variable kinds (local var, parameter, class
// attribute, error var, `this` instance). 1:1 port of C++ SemaVar minus the
// allocation tracking (SemaAlloc) and CodeGenVar, both deferred to the CodeGen
// stage. `getName()` defers to the AST var.
// ─────────────────────────────────────────────────────────────────────────────

public class SemaVar : SemaExpr {

    ASTVar varAst
    bool constant
    pointer llvmAlloca   // CodeGen back-pointer: the var's stack slot (null until codegen'd)
    // NRVO: this local IS the caller's return slot and has no storage of its own,
    // so building it field by field writes straight into the returned struct and
    // `return name` copies nothing — the speed the old `out.field = …` had.
    bool returnSlot

    public SemaVar(const ASTVar varAst, const SemaKind kind, const SemaType type) {
        super(kind, type)
        this.varAst = varAst
        this.constant = false
        this.llvmAlloca = 0
        this.returnSlot = false
    }

    public ASTVar getAST() { return this.varAst }
    public string getName() { return this.varAst.getName() }
    public bool isConstant() { return this.constant }
    public void setConstant(const bool constant) { this.constant = constant }
    public bool isReturnSlot() { return this.returnSlot }
    public void setReturnSlot(const bool v) { this.returnSlot = v }
    public pointer getLlvmAlloca() { return this.llvmAlloca }
    public void setLlvmAlloca(const pointer a) { this.llvmAlloca = a }
}
