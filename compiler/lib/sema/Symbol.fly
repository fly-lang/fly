namespace fly.compiler.sema

import fly.compiler.sema.SymbolKind
import fly.compiler.sema.SemaNode
import fly.compiler.sema.SemaType
import fly.compiler.sema.SemaExpr
import fly.compiler.basic.SourceLocation
import fly.data.List

// ─────────────────────────────────────────────────────────────────────────────
// Symbol — a symbol-table entry: a name, its kind, and a reference to the
// resolved semantic object it denotes. 1:1 with the C++ `struct Symbol`.
//
// The C++ `getRefAs<T>()` template downcast has no Fly analog: `getRef()` returns
// the SemaNode base; callers narrow by `getKind()` + the concrete node's getters.
// ─────────────────────────────────────────────────────────────────────────────

public class Symbol {

    string name
    SymbolKind kind
    SemaNode ref
    List<SemaType> paramTypes   // explicit param types for FUNCTION symbols (else null)
    SemaExpr exprRef            // the ref as a SemaExpr, for VAR/LOCAL_VAR/PARAM (else null)
    SemaType typeRef            // the ref as a SemaType, for BUILTIN_TYPE/CLASS/ENUM (else null)
    bool used                   // a name lookup found it (the unused-variable warning)
    SourceLocation declLoc      // where a LOCAL_VAR was declared (its name), else null
    Symbol aliasOf              // `import ns.X as Y`: the symbol Y stands for, else null

    public Symbol(const string name, const SymbolKind kind, const SemaNode ref) {
        this.name = name
        this.kind = kind
        this.ref = ref
        this.used = false
        this.declLoc = null
        this.aliasOf = null
    }

    // alias — `name` standing for `of` (`import geom.Circle as C`). Everything but
    // the name reads through to `of`, which the resolver keeps completing (param
    // types, type ref) after the import has been injected.
    public static Symbol alias(const string name, const Symbol of) {
        Symbol s = new Symbol(name, of.getKind(), of.getRef())
        s.aliasOf = of
        return s
    }

    public string getName() {
        return this.name
    }
    public SymbolKind getKind() {
        if this.aliasOf != null {
            return this.aliasOf.getKind()
        }
        return this.kind
    }
    public SemaNode getRef() {
        if this.aliasOf != null {
            return this.aliasOf.getRef()
        }
        return this.ref
    }

    public bool isUsed() {
        return this.used
    }

    public void setUsed(const bool u) {
        this.used = u
        if this.aliasOf != null {
            this.aliasOf.setUsed(u)
        }
    }

    public SourceLocation getDeclLoc() {
        return this.declLoc
    }

    public void setDeclLoc(const SourceLocation loc) {
        this.declLoc = loc
    }

    // Function signature for overload lookup. Set by the Resolver when inserting a
    // function/method symbol (the C++ recovers this via static_cast on the ref;
    // Fly has no downcast, so it is carried on the Symbol instead).
    public List<SemaType> getParamTypes() {
        if this.aliasOf != null {
            return this.aliasOf.getParamTypes()
        }
        return this.paramTypes
    }
    public void setParamTypes(const List<SemaType> paramTypes) {
        this.paramTypes = paramTypes
    }

    // The variable this symbol denotes, as a SemaExpr (set for VAR/LOCAL_VAR/PARAM),
    // so an identifier reference can recover it without downcasting `ref`.
    public SemaExpr getExprRef() {
        if this.aliasOf != null {
            return this.aliasOf.getExprRef()
        }
        return this.exprRef
    }
    public void setExprRef(const SemaExpr exprRef) {
        this.exprRef = exprRef
    }

    // The type this symbol denotes (set for BUILTIN_TYPE/CLASS/ENUM), recovered
    // without downcasting `ref`.
    public SemaType getTypeRef() {
        if this.aliasOf != null {
            return this.aliasOf.getTypeRef()
        }
        return this.typeRef
    }
    public void setTypeRef(const SemaType typeRef) {
        this.typeRef = typeRef
    }

    // isVarKind — true for any variable kind (VAR, LOCAL_VAR, PARAM, ATTRIBUTE).
    public bool isVarKind() {
        return this.kind == SymbolKind.VAR
           || this.kind == SymbolKind.LOCAL_VAR
           || this.kind == SymbolKind.PARAM
           || this.kind == SymbolKind.ATTRIBUTE
    }
}
