namespace fly.compiler.sema
import fly.compiler.sema.SemaVisitor

import fly.compiler.sema.SemaKind
import fly.compiler.sema.SemaVar
import fly.compiler.sema.SemaType
import fly.compiler.sema.SemaClassType
import fly.compiler.sema.SemaComment
import fly.compiler.sema.SemaExpr
import fly.compiler.sema.SemaVisibilityKind
import fly.compiler.sema.SemaConstValue
import fly.compiler.ast.ASTAttribute

// SemaClassAttribute — a resolved class member variable. 1:1 with C++.
public class SemaClassAttribute : SemaVar {

    SemaClassType classType
    SemaVisibilityKind visibility
    bool staticFlag
    SemaClassType inherited
    SemaComment comment
    SemaExpr initExpr
    SemaConstValue constInit
    bool headerInit

    public SemaClassAttribute(const ASTAttribute attrAst, const SemaClassType classType, const SemaType type) {
        super(attrAst, SemaKind.ATTRIBUTE, type)
        this.classType = classType
        this.visibility = SemaVisibilityKind.DEFAULT
        this.staticFlag = false
        this.initExpr = null
        this.constInit = null
        this.headerInit = false
    }

    public SemaClassType getClass() {
        return this.classType
    }
    public SemaComment getComment() {
        return this.comment
    }
    public void setComment(const SemaComment comment) {
        this.comment = comment
    }
    public SemaVisibilityKind getVisibility() {
        return this.visibility
    }
    public void setVisibility(const SemaVisibilityKind visibility) {
        this.visibility = visibility
    }
    public bool isStatic() {
        return this.staticFlag
    }
    public void setStatic(const bool staticFlag) {
        this.staticFlag = staticFlag
    }
    public SemaClassType getInherited() {
        return this.inherited
    }
    public void setInherited(const SemaClassType inherited) {
        this.inherited = inherited
    }
    public SemaExpr getInitExpr() {
        return this.initExpr
    }
    public void setInitExpr(const SemaExpr initExpr) {
        this.initExpr = initExpr
    }

    // getConstInit — a STATIC field's folded initializer (SemaConstFold): the
    // initial value of its global. Null without an initializer.
    public SemaConstValue getConstInit() {
        return this.constInit
    }
    public void setConstInit(const SemaConstValue constInit) {
        this.constInit = constInit
    }

    // isHeaderInit — a field of a HEADER type whose declaration has an
    // initializer: the archive's fieldinit routine sets it (HeaderGen).
    public bool isHeaderInit() {
        return this.headerInit
    }
    public void setHeaderInit(const bool headerInit) {
        this.headerInit = headerInit
    }

    public void accept(const SemaVisitor v) {
        v.visit(this)
    }
}
