namespace fly.compiler.sema

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.basic.*
import fly.data.List
import fly.str

// ResolverStmt — statement resolution companion. Statements append themselves to
// r.currentSemaBlock; a completed block is published via r.lastBlock.
public class ResolverStmt {

    public ResolverStmt() { }

    // block — visit(ASTBlockStmt): a new scope + SemaBlockStmt populated by its
    // statements. The previous currentSemaBlock is restored; the finished block is
    // left in r.lastBlock for the caller (function body / control-flow stmt).
    public static void block(const Resolver r, const ASTBlockStmt node) {
        r.enterScope()
        SemaBlockStmt blk = SemaBuilder.CreateBlockStmt(node)
        SemaBlockStmt prev = r.getCurrentSemaBlock()
        r.setCurrentSemaBlock(blk)
        List<ASTStmt> content = node.getContent()
        // Does control certainly leave the function inside this block? One exiting
        // statement is enough — whatever follows it is unreachable.
        bool anyExit = false
        int i = 0
        while i < content.size() {
            ASTStmt s = content.get(i)
            r.setStmtExits(false)
            s.accept(r)
            if r.getStmtExits() { anyExit = true }
            // A bare nested `{ }` block (scoping block, braced switch-case body)
            // resolves into r.lastBlock but attaches itself NOWHERE — every other
            // statement kind appends to currentSemaBlock in its own visit. Adopt
            // it here, or its statements silently vanish (B021).
            if s.getStmtKind() == ASTStmtKind.STMT_BLOCK {
                SemaBlockStmt child = r.getLastBlock()
                if child != null { blk.addContent(child) }
            }
            i = i + 1
        }
        r.setCurrentSemaBlock(prev)
        r.setLastBlock(blk)
        r.exitScope()
        r.setStmtExits(anyExit)
    }

    // decl — a local variable declaration, registered in the current scope.
    public static void decl(const Resolver r, const ASTDeclStmt node) {
        ASTLocalVar lv = node.getLocalVar()
        lv.accept(r)
        SemaLocalVar slv = r.getCurrentLocalVar()
        // NRVO: this is the local every return hands back, so it lives in the
        // caller's return slot instead of a stack slot of its own.
        if str.equals(r.getNrvoName(), lv.getName()) { slv.setReturnSlot(true) }
        Symbol sym = new Symbol(lv.getName(), SymbolKind.LOCAL_VAR, slv)
        sym.setExprRef(slv)
        r.addSymbol(sym)
        SemaExpr init = null
        ASTExpr ie = node.getExpr()
        if ie != null {
            r.setExpectedType(slv.getType())    // so `T[] a = {...}` types the literal
            ie.accept(r)
            r.setExpectedType(null)
            init = r.getCurrentExpr()
            // the initializer must be assignable to the declared type (the
            // reference runs CheckAssignment here; parity for the kind level)
            if init != null {
                checkAssignTypes(r, ie.getLoc(), slv.getType(), init.getType())
            }
        }
        // `T[] k` with NEITHER a size NOR an initializer has no length to give it,
        // so it can only ever be an empty array nobody can fill — the reference has
        // always rejected it and B048 rule 2 makes that the agreed semantics. The
        // self-host used to accept it silently and hand back {null, 0}.
        if init == null {
            SemaType dt = slv.getType()
            if dt != null {
                SemaArrayType dat = dt.asArray()
                if dat != null {
                    if dat.getSizeExpr() == null {
                        r.diag(node.getLoc(), DiagID.err_sema_array_no_size_or_init)
                    } else {
                        // A SIZED array of objects is born full: codegen puts one
                        // `new C()` in every index, so the element must be
                        // constructible with no arguments. Say so at the
                        // declaration rather than letting codegen reach for a
                        // constructor that does not exist.
                        //
                        // In practice this catches INTERFACES: every class gets a
                        // synthesized no-argument constructor when it declares none
                        // (ResolverClass.declareClass), so `new C()` is always
                        // available — even for a class whose only written
                        // constructor takes arguments. Interfaces are excluded from
                        // that synthesis and so have nothing to build. Only the
                        // no-initializer form preallocates; `C[3] xs = {a, b, c}`
                        // takes its elements from the literal.
                        SemaType det = dat.getElementType()
                        SemaClassType dec = null
                        if det != null { dec = det.asClass() }
                        if dec != null {
                            if dec.getClassKind() != SemaClassKind.STRUCT {
                                if dec.getDefaultConstructor() == null {
                                    r.diagStr(node.getLoc(), DiagID.err_sema_array_class_no_default_ctor, dec.getName())
                                }
                            }
                        }
                    }
                }
            }
        }

        SemaDeclStmt ds = SemaBuilder.CreateDeclStmt(node, slv, init)
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        blk.addContent(ds)

        // Alloc tracking (Stage 7): a `C x = new C(...)` binds an owned heap class
        // handle — register it for free at this scope's exit. (Conservative: only
        // direct new-into-local; escape analysis / smart-pointer ownership is the
        // soundness follow-up.)
        if init != null {
            SemaCall ic = init.asCall()
            if ic != null {
                if ic.isNew() {
                    SemaType vt = slv.getType()
                    if vt != null {
                        SemaClassType vc = vt.asClass()
                        if vc != null {
                            // STRUCTs are stack objects (alloca): freeing them at
                            // scope exit would call free() on a stack pointer
                            if vc.getClassKind() != SemaClassKind.STRUCT {
                                blk.addAlloc(slv)
                            }
                        }
                    }
                }
            }
        }

        // A string LOCAL owns a heap buffer under clone-on-store (its decl clones a
        // borrowed RHS / moves an owned temp / defaults to {null,0}) → register it for
        // scope-exit free. Independent of the initializer (an uninitialized string is
        // {null,0}, free(null) is a no-op). Escaped ones (assigned away / passed to a
        // call / returned) are skipped by the isEscaped() gate in the cleanup, so they
        // leak rather than double-free — the conservative-but-safe choice.
        SemaType svt = slv.getType()
        // An NRVO local owns nothing: its storage IS the caller's return slot, so
        // the buffer it ends up holding belongs to the caller. Registering it for
        // scope-exit free would release the value we just returned.
        if slv.isReturnSlot() { svt = null }
        if svt != null {
            if svt.isString() { blk.addAlloc(slv) }
            // An ARRAY local is an OWNER of its reference-counted buffer: register
            // it for a scope-exit release. Independent of the initializer, exactly
            // like a string — an uninitialized array is {null,0} and the release is
            // null-guarded. Binding another array retains (CodeGenStmt.decl /
            // CodeGenExprOps.assign), so two names mean a count of two and two
            // releases; the buffer goes back when the last one leaves.
            if svt.isArray() { blk.addAlloc(slv) }
        }
    }

    public static void expr(const Resolver r, const ASTExprStmt node) {
        SemaExpr se = null
        ASTExpr e = node.getExpr()
        if e != null {
            e.accept(r)
            se = r.getCurrentExpr()
        }
        SemaExprStmt es = SemaBuilder.CreateExprStmt(node, se)
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        blk.addContent(es)
    }

    // ret — `return`, `return expr`, `return a, b`. The values are lowered here
    // into assignments to the function's hidden return params, emitted just
    // before the return itself: downstream (string clone, array retain, struct
    // copy, scope cleanup order) this is the very path the old `out = expr` took,
    // so the generated code is unchanged.
    public static void ret(const Resolver r, const ASTReturnStmt node) {
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        List<SemaParam> retParams = ResolverStmt.returnParamsOf(r)
        List<ASTExpr> values = node.getExprs()

        if values.size() == 0 {
            // A bare `return` is an early exit, valid only where no value is due.
            if retParams.size() > 0 {
                r.diagStr(node.getLoc(), DiagID.err_sema_return_missing_value, str.convert((int)retParams.size()))
            }
        } elsif retParams.size() == 0 {
            r.diag(node.getLoc(), DiagID.err_sema_return_value_in_void)
        } elsif values.size() != retParams.size() {
            r.diagStr2(node.getLoc(), DiagID.err_sema_return_arity,
                       str.convert((int)values.size()), str.convert((int)retParams.size()))
        } else {
            int i = 0
            while i < values.size() {
                ASTExpr value = values.get(i)
                SemaParam slot = retParams.get(i)
                // NRVO: the returned local already IS the caller's slot, so the
                // assignment would copy it onto itself. Resolve the name anyway,
                // to keep it counted as a read, and emit nothing.
                if ResolverStmt.isNrvoName(r, value) {
                    value.accept(r)
                } else {
                    ASTExpr lhs = ASTBuilder.CreateIdentifier(node.getLoc(), slot.getName(), null)
                    ASTExpr assign = ASTBuilder.CreateBinary(node.getLoc(), ASTBinaryKind.OP_BINARY_ASSIGN, lhs, value)
                    assign.accept(r)
                    SemaExprStmt es = SemaBuilder.CreateExprStmt(node, r.getCurrentExpr())
                    blk.addContent(es)
                }
                i = i + 1
            }
        }

        SemaReturnStmt rs = SemaBuilder.CreateReturnStmt(node, null)
        blk.addContent(rs)
        r.setStmtExits(true)
    }

    // returnParamsOf — the hidden slots appended to the current function's
    // signature, in declaration order: one per declared return type.
    public static List<SemaParam> returnParamsOf(const Resolver r) {
        List<SemaParam> res = new List<SemaParam>()
        SemaFunctionBase fn = r.getCurrentFunction()
        if fn == null { return res }
        List<SemaParam> params = fn.getParams()
        int i = 0
        while i < params.size() {
            SemaParam p = params.get(i)
            if p.isSynthetic() { res.add(p) }
            i = i + 1
        }
        return res
    }

    // isNrvoName — true when this returned value is exactly the local the whole
    // body hands back, and that local was bound to the return slot.
    public static bool isNrvoName(const Resolver r, const ASTExpr value) {
        string nrvo = r.getNrvoName()
        if str.equals(nrvo, "") { return false }
        ASTIdentifier id = value.asIdentifier()
        if id == null { return false }
        if id.getParent() != null { return false }
        return str.equals(id.getName(), nrvo)
    }

    // captureStmts — resolve a flat list of statements (loop init/post) into a
    // throwaway block, restoring the previous currentSemaBlock afterwards.
    public static SemaBlockStmt captureStmts(const Resolver r, const List<ASTStmt> stmts) {
        SemaBlockStmt cap = SemaBuilder.CreateBlockStmt(null)
        SemaBlockStmt prev = r.getCurrentSemaBlock()
        r.setCurrentSemaBlock(cap)
        int i = 0
        while i < stmts.size() {
            ASTStmt s = stmts.get(i)
            s.accept(r)
            i = i + 1
        }
        r.setCurrentSemaBlock(prev)
        return cap
    }

    // resolveBlock — accept an ASTBlockStmt (its block() leaves the finished
    // SemaBlockStmt in r.lastBlock) and return that captured block.
    public static SemaBlockStmt resolveBlock(const Resolver r, const ASTStmt blockAst) {
        blockAst.accept(r)
        return r.getLastBlock()
    }

    // if — condition + then block (from ASTRuleStmt base) + elsif chain + else.
    public static void ifStmt(const Resolver r, const ASTIfStmt node) {
        ASTExpr condAst = node.getExpr()
        condAst.accept(r)
        SemaExpr cond = r.getCurrentExpr()
        ASTStmt thenAst = node.getStmt()
        SemaBlockStmt thenBlk = ResolverStmt.resolveBlock(r, thenAst)
        // An if-chain exits only when it is total: an `else` must exist and every
        // branch, elsif included, must exit.
        bool allExit = r.getStmtExits()
        SemaIfStmt sif = SemaBuilder.CreateIfStmt(node, cond, thenBlk)

        List<ASTRuleStmt> elsifs = node.getElsif()
        int i = 0
        while i < elsifs.size() {
            ASTRuleStmt e = elsifs.get(i)
            ASTExpr ec = e.getExpr()
            ec.accept(r)
            SemaExpr ecExpr = r.getCurrentExpr()
            ASTStmt eStmt = e.getStmt()
            SemaBlockStmt eBlk = ResolverStmt.resolveBlock(r, eStmt)
            if r.getStmtExits() == false { allExit = false }
            sif.addElsif(ecExpr, eBlk)
            i = i + 1
        }

        ASTStmt elseAst = node.getElse()
        if elseAst == null {
            allExit = false
        } else {
            SemaBlockStmt elseBlk = ResolverStmt.resolveBlock(r, elseAst)
            if r.getStmtExits() == false { allExit = false }
            sif.setElse(elseBlk)
        }

        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(sif) }
        r.setStmtExits(allExit)
    }

    // switch — selector + case rules + optional default.
    public static void switchStmt(const Resolver r, const ASTSwitchStmt node) {
        ASTExpr se = node.getExpr()
        se.accept(r)
        SemaExpr sExpr = r.getCurrentExpr()
        SemaSwitchStmt ssw = SemaBuilder.CreateSwitchStmt(node, sExpr)
        // A switch exits when it has a default and no case can fall out of it: a
        // case ending in `break` continues after the switch, so it does not.
        bool allExit = true
        bool prevBreak = r.getSawBreak()
        r.enterSwitch()

        List<ASTCaseStmt> cases = node.getCases()
        int i = 0
        while i < cases.size() {
            ASTCaseStmt c = cases.get(i)
            ASTExpr ce = c.getExpr()
            ce.accept(r)
            SemaExpr cExpr = r.getCurrentExpr()
            ASTBlockStmt cs = c.getStmt()
            // A case with NO statements falls through to the next case (doc 9.4):
            // mark it with a null block so codegen branches to the next case body.
            List<ASTStmt> cc = cs.getContent()
            if cc.size() == 0 {
                ssw.addCase(cExpr, null)
            } else {
                SemaBlockStmt cBlk = ResolverStmt.resolveBlock(r, cs)
                if r.getStmtExits() == false { allExit = false }
                ssw.addCase(cExpr, cBlk)
            }
            i = i + 1
        }

        ASTStmt def = node.getDefault()
        if def == null {
            allExit = false
        } else {
            SemaBlockStmt dBlk = ResolverStmt.resolveBlock(r, def)
            if r.getStmtExits() == false { allExit = false }
            ssw.setDefault(dBlk)
        }

        r.exitSwitch()
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(ssw) }
        r.setSawBreak(prevBreak)
        r.setStmtExits(allExit)
    }

    // loop — init / condition / body / post, all sharing one loop scope.
    public static void loopStmt(const Resolver r, const ASTLoopStmt node) {
        SemaLoopStmt slp = SemaBuilder.CreateLoopStmt(node, false)
        r.enterLoop()
        r.enterScope()

        List<ASTStmt> init = node.getInit()
        SemaBlockStmt initCap = ResolverStmt.captureStmts(r, init)
        List<SemaStmt> initC = initCap.getContent()
        int i = 0
        while i < initC.size() { slp.addInit(initC.get(i))  i = i + 1 }

        ASTExpr ce = node.getExpr()
        SemaExpr cond = null
        if ce != null { ce.accept(r)  cond = r.getCurrentExpr() }
        slp.setCond(cond)

        // An endless loop with no `break` of its own never falls through — the
        // classic "loop until we return" shape.
        bool prevBreak = r.getSawBreak()
        r.setSawBreak(false)
        ASTStmt body = node.getLoop()
        SemaBlockStmt bodyBlk = ResolverStmt.resolveBlock(r, body)
        bool loopExits = false
        if node.hasEndlessCond() { loopExits = r.getSawBreak() == false }
        r.setSawBreak(prevBreak)
        slp.setBody(bodyBlk)

        List<ASTStmt> post = node.getPost()
        SemaBlockStmt postCap = ResolverStmt.captureStmts(r, post)
        List<SemaStmt> postC = postCap.getContent()
        int j = 0
        while j < postC.size() { slp.addPost(postC.get(j))  j = j + 1 }

        r.exitScope()
        r.exitLoop()
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(slp) }
        r.setStmtExits(loopExits)
    }

    // loop-in — `for item in coll { body }`, DESUGARED here to an indexed loop
    // so the existing SemaLoopStmt codegen handles everything:
    //
    //   for CollT __forin_a = coll, pointer __forin_b ; __forin_b < __forin_a.size()
    //       ; __forin_b = __forin_b + 1 {
    //       ElemT item = __forin_a.get(__forin_b)
    //       <body>
    //   }
    //
    // Duck-typed contract: the collection type must expose size() and get(index);
    // the element type is get's RETURN type (concrete on monomorphized specs, so
    // List<T> yields T). The collection expression is resolved exactly ONCE
    // (hoisted into __forin_a). The increment lives in the loop POST, so
    // `continue` re-tests the condition only after advancing — correct semantics.
    // `item` is a per-iteration copy (value semantics via get()).
    public static void loopInStmt(const Resolver r, const ASTLoopInStmt node) {
        SourceLocation loc = node.getLoc()

        // 1) resolve the collection; derive the element type from get()
        ASTExpr lst = node.getList()
        lst.accept(r)
        SemaExpr listE = r.getCurrentExpr()
        if listE == null { return }
        SemaType lt = listE.getType()

        // A native array `T[]` iterates directly (no get()/size() methods) via a
        // dedicated SemaLoopInStmt lowered by CodeGenArray.loopIn.
        if lt != null {
            SemaArrayType arrT = lt.asArray()
            if arrT != null {
                ResolverStmt.loopInArray(r, node, listE, arrT)
                return
            }
        }

        SemaClassType cls = null
        if lt != null { cls = lt.asClass() }
        if cls == null {
            string tn = "unknown"
            if lt != null { tn = lt.getName() }
            r.diagStr(loc, DiagID.err_sema_forin_not_iterable, tn)
            return
        }
        SemaClassMethod getM = cls.LookupMethod("get")
        SemaClassMethod sizeM = cls.LookupMethod("size")
        if getM == null || sizeM == null {
            r.diagStr(loc, DiagID.err_sema_forin_not_iterable, cls.getName())
            return
        }
        // get must take an INDEX (pointer) — a keyed get (Map.get(K key)) is not
        // positional iteration; accepting it would silently iterate wrong.
        bool idxOk = false
        List<SemaParam> gps = getM.getParams()
        if gps.size() > 0 {
            SemaParam gp0 = gps.get(0)
            SemaType gpt = gp0.getType()
            if gpt != null {
                if str.equals(gpt.getName(), "pointer") { idxOk = true }
            }
        }
        if idxOk == false {
            r.diagStr(loc, DiagID.err_sema_forin_not_iterable, cls.getName())
            return
        }
        SemaType elemT = getM.getReturnType()

        ASTIdentifier itemId = node.getItem().asIdentifier()
        if itemId == null {
            r.diagStr(loc, DiagID.err_sema_forin_not_iterable, cls.getName())
            return
        }
        string itemName = itemId.getName()

        string xsName = r.nextForInName()
        string ivName = r.nextForInName()
        List<ASTModifier> noMods = new List<ASTModifier>()

        SemaLoopStmt slp = SemaBuilder.CreateLoopStmt(node, false)
        r.enterLoop()
        r.enterScope()

        // 2) init: CollT __forin_a = <resolved collection expr>  (hoist)
        ASTLocalVar xsAst = ASTBuilder.CreateLocalVar(loc, ASTBuilder.CreatePtrSizeType(loc), xsName, noMods)
        SemaLocalVar xsVar = SemaBuilder.CreateLocalVar(xsAst, lt)
        Symbol xsSym = new Symbol(xsName, SymbolKind.LOCAL_VAR, xsVar)
        xsSym.setExprRef(xsVar)
        r.addSymbol(xsSym)
        SemaDeclStmt xsDecl = SemaBuilder.CreateDeclStmt(node, xsVar, listE)
        slp.addInit(xsDecl)

        // 3) init: pointer __forin_b  (no initializer → zero-initialized)
        ASTLocalVar ivAst = ASTBuilder.CreateLocalVar(loc, ASTBuilder.CreatePtrSizeType(loc), ivName, noMods)
        SemaLocalVar ivVar = SemaBuilder.CreateLocalVar(ivAst, SemaBuiltin.getPtrSizeType())
        Symbol ivSym = new Symbol(ivName, SymbolKind.LOCAL_VAR, ivVar)
        ivSym.setExprRef(ivVar)
        r.addSymbol(ivSym)
        SemaDeclStmt ivDecl = SemaBuilder.CreateDeclStmt(node, ivVar, null)
        slp.addInit(ivDecl)

        // 4) cond: __forin_b < __forin_a.size()   (synthetic AST, resolved normally)
        List<ASTExpr> noArgs = new List<ASTExpr>()
        ASTExpr sizeCall = ASTBuilder.CreateCall(loc, "size", noArgs, ASTCallKind.CALL_DIRECT, ASTBuilder.CreateIdentifier(loc, xsName, null))
        ASTExpr condAst = ASTBuilder.CreateBinary(loc, ASTBinaryKind.OP_BINARY_COMPARE_LT, ASTBuilder.CreateIdentifier(loc, ivName, null), sizeCall)
        condAst.accept(r)
        slp.setCond(r.getCurrentExpr())

        // 5) item: ElemT <item> = __forin_a.get(__forin_b) — registered BEFORE the
        //    body resolves so the body's references find it in scope
        ASTLocalVar itAst = ASTBuilder.CreateLocalVar(loc, ASTBuilder.CreatePtrSizeType(loc), itemName, noMods)
        SemaLocalVar itVar = SemaBuilder.CreateLocalVar(itAst, elemT)
        Symbol itSym = new Symbol(itemName, SymbolKind.LOCAL_VAR, itVar)
        itSym.setExprRef(itVar)
        r.addSymbol(itSym)
        List<ASTExpr> getArgs = new List<ASTExpr>()
        getArgs.add(ASTBuilder.CreateIdentifier(loc, ivName, null))
        ASTExpr getCall = ASTBuilder.CreateCall(loc, "get", getArgs, ASTCallKind.CALL_DIRECT, ASTBuilder.CreateIdentifier(loc, xsName, null))
        getCall.accept(r)
        SemaDeclStmt itDecl = SemaBuilder.CreateDeclStmt(node, itVar, r.getCurrentExpr())

        // 6) body: [ itemDecl, <original body> ] (nested block — codegen recurses)
        SemaBlockStmt bodyBlk = ResolverStmt.resolveBlock(r, node.getStmt())
        SemaBlockStmt wrap = SemaBuilder.CreateBlockStmt(null)
        wrap.addContent(itDecl)
        wrap.addContent(bodyBlk)
        slp.setBody(wrap)

        // 7) post: __forin_b = __forin_b + 1
        ASTExprStmt postStmt = new ASTExprStmt(loc)
        ASTExpr incr = ASTBuilder.CreateBinary(loc, ASTBinaryKind.OP_BINARY_ARITH_ADD, ASTBuilder.CreateIdentifier(loc, ivName, null), ASTBuilder.CreateNumberValue(loc, "1"))
        postStmt.setExpr(ASTBuilder.CreateBinary(loc, ASTBinaryKind.OP_BINARY_ASSIGN, ASTBuilder.CreateIdentifier(loc, ivName, null), incr))
        List<ASTStmt> postList = new List<ASTStmt>()
        postList.add(postStmt)
        SemaBlockStmt postCap = ResolverStmt.captureStmts(r, postList)
        List<SemaStmt> postC = postCap.getContent()
        int j = 0
        while j < postC.size() { slp.addPost(postC.get(j))  j = j + 1 }

        r.exitScope()
        r.exitLoop()
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(slp) }
    }

    // loopInArray — `for item in arr` over a native `T[]`. The item local is
    // declared ONCE in the enclosing block (its alloca is reused each iteration),
    // then a SemaLoopInStmt (lowered by CodeGenArray.loopIn) drives index/load/store.
    public static void loopInArray(const Resolver r, const ASTLoopInStmt node, const SemaExpr listE, const SemaArrayType at) {
        SourceLocation loc = node.getLoc()
        ASTIdentifier itemId = node.getItem().asIdentifier()
        if itemId == null {
            r.diagStr(loc, DiagID.err_sema_forin_not_iterable, "array")
            return
        }
        string itemName = itemId.getName()
        SemaType elemT = at.getElementType()

        SemaBlockStmt blk = r.getCurrentSemaBlock()
        r.enterLoop()
        r.enterScope()

        List<ASTModifier> noMods = new List<ASTModifier>()
        ASTLocalVar itAst = ASTBuilder.CreateLocalVar(loc, ASTBuilder.CreatePtrSizeType(loc), itemName, noMods)
        SemaLocalVar itVar = SemaBuilder.CreateLocalVar(itAst, elemT)
        Symbol itSym = new Symbol(itemName, SymbolKind.LOCAL_VAR, itVar)
        itSym.setExprRef(itVar)
        r.addSymbol(itSym)
        SemaDeclStmt itDecl = SemaBuilder.CreateDeclStmt(node, itVar, null)
        if blk != null { blk.addContent(itDecl) }

        SemaBlockStmt bodyBlk = ResolverStmt.resolveBlock(r, node.getStmt())

        r.exitScope()
        r.exitLoop()

        SemaLoopInStmt slp = SemaBuilder.CreateLoopInStmt(node, itVar, listE, bodyBlk)
        if blk != null { blk.addContent(slp) }
    }

    // fail — sets the enclosing function fallible when not inside a handle block.
    public static void failStmt(const Resolver r, const ASTFailStmt node) {
        SemaFunctionBase fn = r.getCurrentFunction()
        if fn == null { return }
        if r.getHandleDepth() == 0 { fn.setFallible(true) }
        SemaFailStmt sf = SemaBuilder.CreateFailStmt(node)
        ASTExpr first = node.getFirstExpr()
        if first != null { first.accept(r)  sf.setFirst(r.getCurrentExpr()) }
        ASTExpr second = node.getSecondExpr()
        if second != null { second.accept(r)  sf.setSecond(r.getCurrentExpr()) }
        ASTExpr third = node.getThirdExpr()
        if third != null { third.accept(r)  sf.setThird(r.getCurrentExpr()) }
        ResolverStmt.escapeFailOperand(sf.getFirst())
        ResolverStmt.escapeFailOperand(sf.getSecond())
        ResolverStmt.escapeFailOperand(sf.getThird())
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(sf) }
        // `fail` writes the error struct and returns — not stack unwinding, but
        // from this function's point of view control is gone.
        r.setStmtExits(true)
    }

    // escapeFailOperand — an object handle named in a `fail` travels out in the
    // error's obj field, so the scope cleanup that `fail` runs must not free it.
    // Strings are copied into the error and arrays are refcounted: neither
    // escapes (the same exceptions as a call argument, ResolverCall).
    public static void escapeFailOperand(const SemaExpr e) {
        if e == null { return }
        if e.isVarExpr() == false { return }
        SemaType t = e.getType()
        if t == null { return }
        if t.isString() { return }
        if t.isArray() { return }
        e.setEscaped(true)
    }

    // handle — guards a captured body region with a fresh error handler.
    public static void handleStmt(const Resolver r, const ASTHandleStmt node) {
        r.enterHandle()
        SemaError eh = SemaBuilder.CreateErrorHandler()
        r.setCurrentErrorHandler(eh)
        SemaHandleStmt sh = SemaBuilder.CreateHandleStmt(node)
        sh.setErrorHandler(eh)
        ASTBlockStmt hb = node.getHandle()
        SemaBlockStmt hblk = ResolverStmt.resolveBlock(r, hb)
        sh.setHandle(hblk)
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(sh) }
        r.exitHandle()
    }

    // test — inline `test { body }`: STRIPPED entirely when not compiling in test
    // mode (zero IR); otherwise the body resolves in its own scope/block into a
    // SemaTestStmt (reference Resolver::visit(ASTTestStmt)).
    public static void testStmt(const Resolver r, const ASTTestStmt node) {
        if r.isTestMode() == false { return }
        ASTBlockStmt bodyAst = node.getBody()
        if bodyAst == null { return }
        SemaBlockStmt body = ResolverStmt.resolveBlock(r, bodyAst)
        SemaTestStmt st = new SemaTestStmt(node)
        st.setBody(body)
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(st) }
    }

    // case — standalone `case "label": { body }`: only valid inside a suite
    // method whose name ends with "Test" (reference Resolver::visit(ASTCaseStmt)).
    // The label was recorded by the parser on the AST node; the body resolves in
    // its own scope/block into a SemaCaseStmt.
    public static void caseStmt(const Resolver r, const ASTCaseStmt node) {
        bool inSuiteTest = false
        SemaClassType cc = r.getCurrentClass()
        SemaFunctionBase cf = r.getCurrentFunction()
        if cc != null {
            if cf != null {
                if cc.getClassKind() == SemaClassKind.SUITE {
                    if str.endsWith(cf.getName(), "Test") { inSuiteTest = true }
                }
            }
        }
        if inSuiteTest == false {
            r.diag(node.getLoc(), DiagID.err_parser_syntax_error)
            return
        }

        SemaBlockStmt body = null
        ASTBlockStmt bodyAst = node.getStmt()
        if bodyAst != null {
            body = ResolverStmt.resolveBlock(r, bodyAst)
        } else {
            body = SemaBuilder.CreateBlockStmt(null)
        }
        SemaCaseStmt sc = new SemaCaseStmt(node, node.getLabel(), body)
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null { blk.addContent(sc) }
    }

    // delete — the parser rejects `delete` today, so this only fires for AST
    // built programmatically; diagnose (the codegen visit is empty — a silent
    // no-op would leak and skip the intended destruction).
    public static void deleteStmt(const Resolver r, const ASTDeleteStmt node) {
        r.diagStr(node.getLoc(), DiagID.err_sema_not_supported, "delete statements")

        ASTExpr e = node.getExpr()
        e.accept(r)
        SemaExpr re = r.getCurrentExpr()
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null {
            if re != null {
                SemaDeleteStmt sd = SemaBuilder.CreateDeleteStmt(node, re)
                blk.addContent(sd)
            }
        }
    }

    public static void breakStmt(const Resolver r, const ASTBreakStmt node) {
        r.setSawBreak(true)
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null {
            SemaBreakStmt sb = SemaBuilder.CreateBreakStmt(node)
            blk.addContent(sb)
        }
    }

    public static void continueStmt(const Resolver r, const ASTContinueStmt node) {
        SemaBlockStmt blk = r.getCurrentSemaBlock()
        if blk != null {
            SemaContinueStmt sc = SemaBuilder.CreateContinueStmt(node)
            blk.addContent(sc)
        }
    }

    // rule — a bare conditional rule: resolve its expression and statement.
    public static void ruleStmt(const Resolver r, const ASTRuleStmt node) {
        ASTExpr e = node.getExpr()
        if e != null { e.accept(r) }
        ASTStmt s = node.getStmt()
        if s != null { s.accept(r) }
    }
}
