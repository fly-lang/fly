namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenIntrinsics
import llvm.api.*
import fly.mem
import fly.data.List

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenStmt — static companions lowering control-flow statements, threading the
// CodeGenExpr visitor (cge). Kept off CodeGenExpr's visit() methods so each visit
// stays a one-liner (the "Broken function" codegen bug bites large many-branch
// methods). Block management goes through cge's helpers: newBlock (append a block
// to the current function), position (move the builder + clear `terminated`), and
// br (branch only if the current block isn't already terminated).
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenStmt {

    public CodeGenStmt() { }

    // decl — `T x [= init]`: an alloca for the local, an optional store of init.
    // The initializer is coerced to the DECLARED type: an int literal stored raw
    // into a long/pointer/double slot writes only 4 of 8 bytes and leaves the
    // upper half as stack garbage.
    public static void decl(const CodeGenExpr cge, const SemaDeclStmt node) {
        SemaLocalVar v = node.getVar()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer ty = cge.lowerType(v.getType())

        // Native array: alloca %array, then store the literal value or a {null,0}
        // default. (String/scalar clone-on-store below does not apply to arrays.)
        SemaType vt = v.getType()
        if vt != null {
            if vt.isArray() {
                pointer aalloca
                llvm.buildAlloca(b, ty, "arr", aalloca)
                v.setLlvmAlloca(aalloca)
                SemaExpr ainit = node.getExpr()
                if ainit != null {
                    pointer av = cge.gen(ainit)
                    llvm.buildStore(b, av, aalloca)
                } else {
                    CodeGenArray.storeDefault(cge, aalloca, vt.asArray())
                }
                return
            }
        }

        pointer alloca
        llvm.buildAlloca(b, ty, "lv", alloca)
        v.setLlvmAlloca(alloca)
        SemaExpr init = node.getExpr()
        if init != null {
            pointer iv = cge.gen(init)
            iv = cge.coerce(iv, init.getType(), v.getType())
            // clone-on-store: a borrowed string RHS is deep-copied so this local owns
            // an independent buffer (the invariant that lets each owner free exactly
            // once); an owned temp (concat, flagged ownedStrTemp) is MOVED as-is —
            // cloning it would double-allocate. cloneIfString no-ops for non-strings.
            if init.isOwnedStrTemp() == false {
                iv = CodeGenIntrinsics.cloneIfString(cge, iv, v.getType())
            }
            // Same clone-on-store rule for STRUCTs: they are value types, so the
            // local must get its own aggregate rather than a pointer into the
            // initializer's storage. cloneIfStruct no-ops for everything else.
            iv = CodeGenIntrinsics.cloneIfStruct(cge, iv, v.getType())
            llvm.buildStore(b, iv, alloca)
        } else {
            // no initializer → DEFAULT-initialize (0 / null / empty struct):
            // `T def  out = def` in the std templates relies on it, and an
            // uninitialized alloca is stack garbage (audit V4)
            pointer zv
            llvm.constNull(ty, zv)
            llvm.buildStore(b, zv, alloca)
        }
    }

    // ret — bare `return`: any attached value-assignment is gen'd, then ret void
    // (the out-param model already stored the result via an `out = …` assignment).
    public static void ret(const CodeGenExpr cge, const SemaReturnStmt node) {
        if cge.isTerminated() { return }
        SemaExpr e = node.getExpr()
        if e != null { pointer ignore = cge.gen(e) }
        LLVM llvm = cge.getLLVM()
        pointer r
        llvm.buildRetVoid(cge.getBuilder(), r)
        cge.setTerminated(true)
    }

    // ifStmt — cond/then, an elsif chain, and an optional else, merging at ifcont.
    public static void ifStmt(const CodeGenExpr cge, const SemaIfStmt node) {
        pointer mergeBB = cge.newBlock("ifcont")
        emitIfChain(cge, node.getCond(), node.getThen(), node.getElsif(), 0, node.getElse(), mergeBB)
        cge.position(mergeBB)
    }

    // emitIfChain — recursively lower `if cond { then } [elsif…] [else]`. Each
    // level: condBr(cond → then, next); then → merge; next holds the rest.
    public static void emitIfChain(const CodeGenExpr cge, const SemaExpr cond, const SemaStmt thenS,
                                   const List<SemaRuleStmt> elsifs, const int idx,
                                   const SemaStmt elseS, const pointer mergeBB) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer cv = cge.gen(cond)
        pointer thenBB = cge.newBlock("then")
        pointer nextBB = cge.newBlock("else")
        pointer cbr
        llvm.buildCondBr(b, cv, thenBB, nextBB, cbr)
        cge.setTerminated(true)

        cge.position(thenBB)
        if thenS != null { thenS.accept(cge) }
        cge.br(mergeBB)

        cge.position(nextBB)
        if idx < elsifs.size() {
            SemaRuleStmt r = elsifs.get(idx)
            emitIfChain(cge, r.getExpr(), r.getStmt(), elsifs, idx + 1, elseS, mergeBB)
        } else {
            if elseS != null { elseS.accept(cge) }
            cge.br(mergeBB)
        }
    }

    // loopStmt — while/for: init → cond → body → post → cond, exit on false cond.
    // break targets exit, continue targets post. Handles do/while via the
    // verify-condition-at-end flag (body runs before the first cond check).
    public static void loopStmt(const CodeGenExpr cge, const SemaLoopStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        List<SemaStmt> init = node.getInit()
        int i = 0
        while i < init.size() {
            SemaStmt s = init.get(i)
            s.accept(cge)
            i = i + 1
        }

        pointer condBB = cge.newBlock("loopcond")
        pointer bodyBB = cge.newBlock("loopbody")
        pointer postBB = cge.newBlock("looppost")
        pointer exitBB = cge.newBlock("loopexit")

        bool atEnd = node.hasVerifyConditionAtEnd()
        if atEnd { cge.br(bodyBB) } else { cge.br(condBB) }

        // cond
        cge.position(condBB)
        SemaExpr cond = node.getCond()
        if cond != null {
            pointer cv = cge.gen(cond)
            pointer cbr
            llvm.buildCondBr(b, cv, bodyBB, exitBB, cbr)
            cge.setTerminated(true)
        } else {
            cge.br(bodyBB)
        }

        // body (save/restore enclosing break/continue targets)
        pointer savedBreak = cge.getBreakTarget()
        pointer savedCont = cge.getContinueTarget()
        cge.setBreakTarget(exitBB)
        cge.setContinueTarget(postBB)
        cge.position(bodyBB)
        SemaStmt body = node.getBody()
        if body != null { body.accept(cge) }
        cge.br(postBB)
        cge.setBreakTarget(savedBreak)
        cge.setContinueTarget(savedCont)

        // post
        cge.position(postBB)
        List<SemaStmt> post = node.getPost()
        int j = 0
        while j < post.size() {
            SemaStmt s = post.get(j)
            s.accept(cge)
            j = j + 1
        }
        cge.br(condBB)

        cge.position(exitBB)
    }

    // switchStmt — buildSwitch over the selector; one block per case; break exits.
    // A case with NO statements (Sema marks it with a null block) FALLS THROUGH to
    // the next case (or default/exit) — doc 9.4; a case with statements implicitly
    // breaks to swexit. Case blocks are pre-created so a fall-through can branch
    // forward to the next case's block.
    public static void switchStmt(const CodeGenExpr cge, const SemaSwitchStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        pointer sel = cge.gen(node.getExpr())
        List<SemaRuleStmt> cases = node.getCases()
        int n = (int)cases.size()

        pointer exitBB = cge.newBlock("swexit")
        pointer defaultBB = exitBB
        SemaStmt defS = node.getDefault()
        if defS != null { defaultBB = cge.newBlock("swdefault") }

        pointer sw
        llvm.buildSwitch(b, sel, defaultBB, n, sw)
        cge.setTerminated(true)

        pointer savedBreak = cge.getBreakTarget()
        cge.setBreakTarget(exitBB)

        // pre-create every case block and register the labels
        SemaExpr selE = node.getExpr()
        List<pointer> caseBBs = new List<pointer>()
        int pi = 0
        while pi < n {
            SemaRuleStmt pr = cases.get(pi)
            SemaExpr caseE = pr.getExpr()
            pointer onVal = cge.gen(caseE)
            // case labels must match the selector's integer width (switch on a
            // long with int case literals would otherwise mix i64/i32)
            onVal = cge.coerce(onVal, caseE.getType(), selE.getType())
            pointer caseBB = cge.newBlock("swcase")
            llvm.addCase(sw, onVal, caseBB)
            caseBBs.add(caseBB)
            pi = pi + 1
        }

        int i = 0
        while i < n {
            SemaRuleStmt r = cases.get(i)
            pointer caseBB = caseBBs.get(i)
            cge.position(caseBB)
            SemaStmt cs = r.getStmt()
            if cs != null {
                cs.accept(cge)
                cge.br(exitBB)
            } else {
                // empty case: fall through to the NEXT case body (or default/exit)
                pointer nextBB = defaultBB
                if i + 1 < n { nextBB = caseBBs.get(i + 1) }
                cge.br(nextBB)
            }
            i = i + 1
        }

        if defS != null {
            cge.position(defaultBB)
            defS.accept(cge)
            cge.br(exitBB)
        }

        cge.setBreakTarget(savedBreak)
        cge.position(exitBB)
    }

    // breakStmt / continueStmt — branch to the innermost exit / post block.
    public static void breakStmt(const CodeGenExpr cge, const SemaBreakStmt node) {
        cge.br(cge.getBreakTarget())
    }
    public static void continueStmt(const CodeGenExpr cge, const SemaContinueStmt node) {
        cge.br(cge.getContinueTarget())
    }
}
