namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenIntrinsics
import fly.compiler.codegen.CodeGenTrace
import llvm.api.*
import fly.mem
import fly.os.io
import fly.str
import fly.data.List

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenStmt — static companions lowering control-flow statements, threading the
// CodeGenExpr visitor (cge). Kept off CodeGenExpr's visit() methods so each visit
// stays a one-liner (the "Broken function" codegen bug bites large many-branch
// methods). Block management goes through cge's helpers: newBlock (append a block
// to the current function), position (move the builder + clear `terminated`), and
// br (branch only if the current block isn't already terminated).
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenStmt {

    public CodeGenStmt() { }

    // decl — `T x [= init]`: an alloca for the local, an optional store of init.
    // The initializer is coerced to the DECLARED type: an int literal stored raw
    // into a long/pointer/double slot writes only 4 of 8 bytes and leaves the
    // upper half as stack garbage.
    public static void decl(const CodeGenExpr cge, const SemaDeclStmt node) {
        SemaLocalVar v = node.getVar()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer ty = cge.lowerType(v.getType())

        // Native array: alloca %array, then store the literal value or a {null,0}
        // default. (String/scalar clone-on-store below does not apply to arrays.)
        SemaType vt = v.getType()
        if vt != null {
            if vt.isArray() {
                pointer aalloca
                llvm.buildAlloca(b, ty, "arr", aalloca)
                v.setLlvmAlloca(aalloca)
                SemaExpr ainit = node.getExpr()
                if ainit != null {
                    pointer av = cge.gen(ainit)
                    // `int[] j = k` binds a SECOND OWNER to one buffer: retain, or
                    // the first scope exit frees it under the other name. This is
                    // one of TWO retain sites — the other is CodeGenExprOps.assign —
                    // because a declaration with an initializer and a plain
                    // assignment are independent paths here (the reference routes
                    // both through one). Missing this one breaks the commonest
                    // shape of all.
                    CodeGenArray.retainValueIfLValue(cge, av, ainit)
                    llvm.buildStore(b, av, aalloca)
                } else {
                    CodeGenArray.storeDefault(cge, aalloca, vt.asArray())
                }
                return
            }
        }

        // NRVO: this local is the value every return hands back, so it gets no
        // storage of its own — its pointer slot points at the CALLER's struct,
        // read from the hidden return argument. Field writes then land in the
        // returned object and `return name` emits nothing at all.
        //
        // Deliberately an if/else, so exactly ONE alloca is emitted per
        // declaration: written as an early return instead, the seed emitted the
        // binding AND the default-init that follows it, and that null store
        // clobbered the slot the binding had just installed.
        bool useNrvo = false
        pointer slotArg = cge.getReturnSlotArg()
        if v.isReturnSlot() {
            if slotArg != 0 {
                useNrvo = true
            } else {
                // Sema decided NRVO and dropped the assignment at `return name`,
                // so a body emitted without its slot bound would hand back
                // nothing. Say so instead of miscompiling in silence.
                io.printErrLn(str.concat("error: internal: return slot not bound for NRVO local '", str.concat(v.getName(), "'")))
            }
        }
        if useNrvo {
            // Two shapes. A STRUCT variable is a pointer cell, so it gets a cell of
            // its own pointing at the caller's object. A STRING variable IS its
            // {ptr,size} aggregate, so the caller's storage backs it directly and
            // every write lands there — which is what the old out parameter did.
            bool nrvoStruct = false
            SemaClassType nct = null
            if vt != null { nct = vt.asClass() }
            if nct != null {
                if nct.getClassKind() == SemaClassKind.STRUCT { nrvoStruct = true }
            }
            if nrvoStruct {
                pointer nrvoCell
                llvm.buildAlloca(b, ty, "nrvo", nrvoCell)
                pointer callerData
                llvm.buildLoad2(b, cge.ptrType(), slotArg, "nrvodst", callerData)
                llvm.buildStore(b, callerData, nrvoCell)
                v.setLlvmAlloca(nrvoCell)
                cge.setNrvoCell(nrvoCell)
                SemaExpr nrvoInit = node.getExpr()
                if nrvoInit != null {
                    pointer niv = cge.gen(nrvoInit)
                    // Copy THROUGH the slot, exactly as assigning to a struct param:
                    // storing the pointer would re-point the cell at callee memory
                    // and the caller would never see the value.
                    CodeGenExprOps.copyStructThroughSlot(cge, nrvoCell, niv, v.getType())
                }
            } else {
                v.setLlvmAlloca(slotArg)
                SemaExpr sInit = node.getExpr()
                if sInit != null {
                    pointer siv = cge.gen(sInit)
                    siv = cge.coerce(siv, sInit.getType(), v.getType())
                    if sInit.isOwnedStrTemp() == false {
                        siv = CodeGenIntrinsics.cloneIfString(cge, siv, v.getType())
                    }
                    llvm.buildStore(b, siv, slotArg)
                } else {
                    // Start from "" rather than from whatever the slot holds. The
                    // self-host caller zeroes it before every call, but a seed-built
                    // caller zeroes it once per frame: in a loop an early `return s`
                    // would hand back the previous call's string. Nothing is freed —
                    // that stale buffer belongs to the caller.
                    pointer zs
                    llvm.constNull(ty, zs)
                    llvm.buildStore(b, zs, slotArg)
                }
            }
        } else {

            pointer alloca
            llvm.buildAlloca(b, ty, "lv", alloca)
            v.setLlvmAlloca(alloca)
            SemaExpr init = node.getExpr()
            if init != null {
                pointer iv = cge.gen(init)
                iv = cge.coerce(iv, init.getType(), v.getType())
                // clone-on-store: a borrowed string RHS is deep-copied so this local owns
                // an independent buffer (the invariant that lets each owner free exactly
                // once); an owned temp (concat, flagged ownedStrTemp) is MOVED as-is —
                // cloning it would double-allocate. cloneIfString no-ops for non-strings.
                if init.isOwnedStrTemp() == false {
                    iv = CodeGenIntrinsics.cloneIfString(cge, iv, v.getType())
                }
                // Same clone-on-store rule for STRUCTs: they are value types, so the
                // local must get its own aggregate rather than a pointer into the
                // initializer's storage. cloneIfStruct no-ops for everything else.
                iv = CodeGenIntrinsics.cloneIfStruct(cge, iv, v.getType())
                llvm.buildStore(b, iv, alloca)
            } else {
                // A STRUCT variable is a POINTER CELL, so it needs STORAGE to point
                // at: a second alloca of the struct body, zeroed, installed in the
                // cell. Nulling the cell instead (what every other type wants, see
                // below) left `P p  p.x = 3` writing through null. This mirrors the
                // reference CodeGenVar::Alloca(), where the T->isStructTy() branch
                // adds the data alloca for STRUCT-kind class types only — CLASS and
                // INTERFACE are heap handles and keep the null store, both because a
                // declared-but-unassigned handle must read as null and because the
                // scope-exit cleanup would otherwise free a garbage pointer. Struct
                // locals are never registered for cleanup (ResolverStmt skips them:
                // free() on a stack pointer), so a stack address in the cell is safe.
                // The NRVO branch above does the analogous thing with the caller's
                // storage, and cloneIfStruct covers the with-initializer case.
                pointer sdataTy = 0
                SemaClassType dct = null
                if vt != null { dct = vt.asClass() }
                if dct != null {
                    if dct.getClassKind() == SemaClassKind.STRUCT {
                        if dct.getLlvmStructType() == 0 { CodeGenClass.declareStruct(cge.getCgm(), dct) }
                        sdataTy = dct.getLlvmStructType()
                    }
                }
                if sdataTy != 0 {
                    pointer sdata
                    llvm.buildAlloca(b, sdataTy, "sdata", sdata)
                    pointer sz
                    llvm.constNull(sdataTy, sz)
                    llvm.buildStore(b, sz, sdata)
                    llvm.buildStore(b, sdata, alloca)
                } else {
                    // no initializer → DEFAULT-initialize (0 / null / empty struct):
                    // `T def  out = def` in the std templates relies on it, and an
                    // uninitialized alloca is stack garbage (audit V4). Strings and
                    // arrays share this branch and NEED the null store: their
                    // scope-exit cleanup loads the slot even when control flow never
                    // reached the declaration, and {null,0} makes free/release no-ops.
                    pointer zv
                    llvm.constNull(ty, zv)
                    llvm.buildStore(b, zv, alloca)
                }
            }
        }
    }

    // ret — bare `return`: any attached value-assignment is gen'd, then ret void
    // (the out-param model already stored the result via an `out = …` assignment).
    public static void ret(const CodeGenExpr cge, const SemaReturnStmt node) {
        if cge.isTerminated() { return }
        SemaExpr e = node.getExpr()
        if e != null { pointer ignore = cge.gen(e) }
        // The value is already in the return slot (strings cloned, arrays
        // retained, the returned handle spared), so every scope's locals can go.
        cge.emitReturnCleanup()
        CodeGenTrace.emitExit(cge)
        LLVM llvm = cge.getLLVM()
        pointer r
        llvm.buildRetVoid(cge.getBuilder(), r)
        cge.setTerminated(true)
    }

    // ifStmt — cond/then, an elsif chain, and an optional else, merging at ifcont.
    public static void ifStmt(const CodeGenExpr cge, const SemaIfStmt node) {
        pointer mergeBB = cge.newBlock("ifcont")
        emitIfChain(cge, node.getCond(), node.getThen(), node.getElsif(), 0, node.getElse(), mergeBB)
        cge.position(mergeBB)
    }

    // emitIfChain — recursively lower `if cond { then } [elsif…] [else]`. Each
    // level: condBr(cond → then, next); then → merge; next holds the rest.
    public static void emitIfChain(const CodeGenExpr cge, const SemaExpr cond, const SemaStmt thenS,
                                   const List<SemaRuleStmt> elsifs, const int idx,
                                   const SemaStmt elseS, const pointer mergeBB) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer cv = cge.gen(cond)
        pointer thenBB = cge.newBlock("then")
        pointer nextBB = cge.newBlock("else")
        pointer cbr
        llvm.buildCondBr(b, cv, thenBB, nextBB, cbr)
        cge.setTerminated(true)

        cge.position(thenBB)
        if thenS != null { thenS.accept(cge) }
        cge.br(mergeBB)

        cge.position(nextBB)
        if idx < elsifs.size() {
            SemaRuleStmt r = elsifs.get(idx)
            emitIfChain(cge, r.getExpr(), r.getStmt(), elsifs, idx + 1, elseS, mergeBB)
        } else {
            if elseS != null { elseS.accept(cge) }
            cge.br(mergeBB)
        }
    }

    // loopStmt — while/for: init → cond → body → post → cond, exit on false cond.
    // break targets exit, continue targets post. Handles do/while via the
    // verify-condition-at-end flag (body runs before the first cond check).
    public static void loopStmt(const CodeGenExpr cge, const SemaLoopStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        List<SemaStmt> init = node.getInit()
        int i = 0
        while i < init.size() {
            SemaStmt s = init.get(i)
            s.accept(cge)
            i = i + 1
        }

        pointer condBB = cge.newBlock("loopcond")
        pointer bodyBB = cge.newBlock("loopbody")
        pointer postBB = cge.newBlock("looppost")
        pointer exitBB = cge.newBlock("loopexit")

        bool atEnd = node.hasVerifyConditionAtEnd()
        if atEnd { cge.br(bodyBB) } else { cge.br(condBB) }

        // cond
        cge.position(condBB)
        SemaExpr cond = node.getCond()
        if cond != null {
            pointer cv = cge.gen(cond)
            pointer cbr
            llvm.buildCondBr(b, cv, bodyBB, exitBB, cbr)
            cge.setTerminated(true)
        } else {
            cge.br(bodyBB)
        }

        // body (save/restore enclosing break/continue targets)
        pointer savedBreak = cge.getBreakTarget()
        pointer savedCont = cge.getContinueTarget()
        pointer savedBreakDepth = cge.getBreakDepth()
        pointer savedContDepth = cge.getContinueDepth()
        cge.setBreakTarget(exitBB)
        cge.setContinueTarget(postBB)
        cge.setBreakDepth(cge.getFrameDepth())
        cge.setContinueDepth(cge.getFrameDepth())
        cge.position(bodyBB)
        SemaStmt body = node.getBody()
        if body != null { body.accept(cge) }
        cge.br(postBB)
        cge.setBreakTarget(savedBreak)
        cge.setContinueTarget(savedCont)
        cge.setBreakDepth(savedBreakDepth)
        cge.setContinueDepth(savedContDepth)

        // post
        cge.position(postBB)
        List<SemaStmt> post = node.getPost()
        int j = 0
        while j < post.size() {
            SemaStmt s = post.get(j)
            s.accept(cge)
            j = j + 1
        }
        cge.br(condBB)

        cge.position(exitBB)
    }

    // switchStmt — buildSwitch over the selector; one block per case; break exits.
    // C fallthrough (doc 9.4, aligned with the reference B024 fix): a case body
    // left OPEN (no break) falls through to the NEXT case body, the last one into
    // default/exit; an explicit `break` branches to swexit via breakTarget. A case
    // with NO statements (Sema marks it with a null block) shares the next body
    // the same way. Case blocks are pre-created so a fall-through can branch
    // forward to the next case's block.
    public static void switchStmt(const CodeGenExpr cge, const SemaSwitchStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        pointer sel = cge.gen(node.getExpr())
        List<SemaRuleStmt> cases = node.getCases()
        int n = (int)cases.size()

        pointer exitBB = cge.newBlock("swexit")
        pointer defaultBB = exitBB
        SemaStmt defS = node.getDefault()
        if defS != null { defaultBB = cge.newBlock("swdefault") }

        pointer sw
        llvm.buildSwitch(b, sel, defaultBB, n, sw)
        cge.setTerminated(true)

        pointer savedBreak = cge.getBreakTarget()
        pointer savedBreakDepth = cge.getBreakDepth()
        cge.setBreakTarget(exitBB)
        cge.setBreakDepth(cge.getFrameDepth())

        // pre-create every case block and register the labels
        SemaExpr selE = node.getExpr()
        List<pointer> caseBBs = new List<pointer>()
        int pi = 0
        while pi < n {
            SemaRuleStmt pr = cases.get(pi)
            SemaExpr caseE = pr.getExpr()
            pointer onVal = cge.gen(caseE)
            // case labels must match the selector's integer width (switch on a
            // long with int case literals would otherwise mix i64/i32)
            onVal = cge.coerce(onVal, caseE.getType(), selE.getType())
            pointer caseBB = cge.newBlock("swcase")
            llvm.addCase(sw, onVal, caseBB)
            caseBBs.add(caseBB)
            pi = pi + 1
        }

        int i = 0
        while i < n {
            SemaRuleStmt r = cases.get(i)
            pointer caseBB = caseBBs.get(i)
            cge.position(caseBB)
            SemaStmt cs = r.getStmt()
            // fall-through target: the next case body, or default/exit after the
            // last case. br() is a no-op when the body already terminated (break/
            // return/fail), so only OPEN bodies fall through (B023).
            pointer nextBB = defaultBB
            if i + 1 < n { nextBB = caseBBs.get(i + 1) }
            if cs != null { cs.accept(cge) }
            cge.br(nextBB)
            i = i + 1
        }

        if defS != null {
            cge.position(defaultBB)
            defS.accept(cge)
            cge.br(exitBB)
        }

        cge.setBreakTarget(savedBreak)
        cge.setBreakDepth(savedBreakDepth)
        cge.position(exitBB)
    }

    // breakStmt / continueStmt — free the locals of the scopes being left (those
    // opened since the loop/switch began), then branch to the innermost exit /
    // post block.
    public static void breakStmt(const CodeGenExpr cge, const SemaBreakStmt node) {
        if cge.isTerminated() { return }
        cge.emitCleanup(cge.getFrameDepth() - cge.getBreakDepth())
        cge.br(cge.getBreakTarget())
    }
    public static void continueStmt(const CodeGenExpr cge, const SemaContinueStmt node) {
        if cge.isTerminated() { return }
        cge.emitCleanup(cge.getFrameDepth() - cge.getContinueDepth())
        cge.br(cge.getContinueTarget())
    }
}
