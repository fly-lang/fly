namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenIntrinsics
import fly.compiler.codegen.CodeGenClass
import fly.compiler.codegen.CodeGenTrace
import fly.compiler.codegen.CodeGenDebug
import llvm.api.*
import fly.os.io
import fly.str
import fly.data.List

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenStmt — static companions lowering control-flow statements, threading the
// CodeGenExpr visitor (cge). Kept off CodeGenExpr's visit() methods so each visit
// stays a one-liner (the "Broken function" codegen bug bites large many-branch
// methods). Block management goes through cge's helpers: newBlock (append a block
// to the current function), position (move the builder + clear `terminated`), and
// br (branch only if the current block isn't already terminated).
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenStmt {

    public CodeGenStmt() { }

    // decl — `T x [= init]`: an alloca for the local, an optional store of init.
    // The initializer is coerced to the DECLARED type: an int literal stored raw
    // into a long/pointer/double slot writes only 4 of 8 bytes and leaves the
    // upper half as stack garbage.
    public static void decl(const CodeGenExpr cge, const SemaDeclStmt node) {
        SemaLocalVar v = node.getVar()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer ty = cge.lowerType(v.getType())

        // Native array: alloca %array, then store the literal value or a {null,0}
        // default. (String/scalar clone-on-store below does not apply to arrays.)
        SemaType vt = v.getType()
        if vt != null {
            if vt.isArray() {
                pointer aalloca
                llvm.buildAlloca(b, ty, "arr", aalloca)
                v.setLlvmAlloca(aalloca)
                SemaExpr ainit = node.getExpr()
                if ainit != null {
                    pointer av = cge.gen(ainit)
                    // `int[] j = k` binds a SECOND OWNER to one buffer: retain, or
                    // the first scope exit frees it under the other name. This is
                    // one of TWO retain sites — the other is CodeGenExprOps.assign —
                    // because a declaration with an initializer and a plain
                    // assignment are independent paths here (the reference routes
                    // both through one). Missing this one breaks the commonest
                    // shape of all.
                    CodeGenArray.retainValueIfLValue(cge, av, ainit)
                    llvm.buildStore(b, av, aalloca)
                } else {
                    CodeGenArray.storeDefault(cge, aalloca, vt.asArray())
                }
                return
            }
        }

        // NRVO: this local is the value every return hands back, so it gets no
        // storage of its own — its pointer slot points at the CALLER's struct,
        // read from the hidden return argument. Field writes then land in the
        // returned object and `return name` emits nothing at all.
        //
        // Deliberately an if/else, so exactly ONE alloca is emitted per
        // declaration: written as an early return instead, the seed emitted the
        // binding AND the default-init that follows it, and that null store
        // clobbered the slot the binding had just installed.
        bool useNrvo = false
        pointer slotArg = cge.getReturnSlotArg()
        if v.isReturnSlot() {
            if slotArg != 0 {
                useNrvo = true
            } else {
                // Sema decided NRVO and dropped the assignment at `return name`,
                // so a body emitted without its slot bound would hand back
                // nothing. Say so instead of miscompiling in silence.
                io.printErrLn(str.concat("error: internal: return slot not bound for NRVO local '",
                        str.concat(v.getName(), "'")))
            }
        }
        if useNrvo {
            // Two shapes. A STRUCT variable is a pointer cell, so it gets a cell of
            // its own pointing at the caller's object. A STRING variable IS its
            // {ptr,size} aggregate, so the caller's storage backs it directly and
            // every write lands there — which is what the old out parameter did.
            bool nrvoStruct = false
            SemaClassType nct = null
            if vt != null {
                nct = vt.asClass()
            }
            if nct != null {
                if nct.getClassKind() == SemaClassKind.STRUCT {
                    nrvoStruct = true
                }
            }
            if nrvoStruct {
                pointer nrvoCell
                llvm.buildAlloca(b, ty, "nrvo", nrvoCell)
                pointer callerData
                llvm.buildLoad2(b, cge.ptrType(), slotArg, "nrvodst", callerData)
                llvm.buildStore(b, callerData, nrvoCell)
                v.setLlvmAlloca(nrvoCell)
                cge.setNrvoCell(nrvoCell)
                SemaExpr nrvoInit = node.getExpr()
                if nrvoInit != null {
                    pointer niv = cge.gen(nrvoInit)
                    // Copy THROUGH the slot, exactly as assigning to a struct param:
                    // storing the pointer would re-point the cell at callee memory
                    // and the caller would never see the value.
                    CodeGenExprOps.copyStructThroughSlot(cge, nrvoCell, niv, v.getType())
                }
            } else {
                v.setLlvmAlloca(slotArg)
                SemaExpr sInit = node.getExpr()
                if sInit != null {
                    pointer siv = cge.gen(sInit)
                    siv = cge.coerce(siv, sInit.getType(), v.getType())
                    if sInit.isOwnedStrTemp() == false {
                        siv = CodeGenIntrinsics.cloneIfString(cge, siv, v.getType())
                    }
                    llvm.buildStore(b, siv, slotArg)
                } else {
                    // Start from "" rather than from whatever the slot holds. The
                    // self-host caller zeroes it before every call, but a seed-built
                    // caller zeroes it once per frame: in a loop an early `return s`
                    // would hand back the previous call's string. Nothing is freed —
                    // that stale buffer belongs to the caller.
                    pointer zs
                    llvm.constNull(ty, zs)
                    llvm.buildStore(b, zs, slotArg)
                }
            }
        } else {

            pointer alloca
            llvm.buildAlloca(b, ty, "lv", alloca)
            v.setLlvmAlloca(alloca)
            SemaExpr init = node.getExpr()
            if init != null {
                pointer iv = cge.gen(init)
                iv = cge.coerce(iv, init.getType(), v.getType())
                // clone-on-store: a borrowed string RHS is deep-copied so this local owns
                // an independent buffer (the invariant that lets each owner free exactly
                // once); an owned temp (concat, flagged ownedStrTemp) is MOVED as-is —
                // cloning it would double-allocate. cloneIfString no-ops for non-strings.
                if init.isOwnedStrTemp() == false {
                    iv = CodeGenIntrinsics.cloneIfString(cge, iv, v.getType())
                }
                // Same clone-on-store rule for STRUCTs: they are value types, so the
                // local must get its own aggregate rather than a pointer into the
                // initializer's storage. cloneIfStruct no-ops for everything else.
                iv = CodeGenIntrinsics.cloneIfStruct(cge, iv, v.getType())
                llvm.buildStore(b, iv, alloca)
            } else {
                // A STRUCT variable is a POINTER CELL, so it needs STORAGE to point
                // at: a second alloca of the struct body, zeroed, installed in the
                // cell. Nulling the cell instead (what every other type wants, see
                // below) left `P p  p.x = 3` writing through null. This mirrors the
                // reference CodeGenVar::Alloca(), where the T->isStructTy() branch
                // adds the data alloca for STRUCT-kind class types only — CLASS and
                // INTERFACE are heap handles and keep the null store, both because a
                // declared-but-unassigned handle must read as null and because the
                // scope-exit cleanup would otherwise free a garbage pointer. Struct
                // locals are never registered for cleanup (ResolverStmt skips them:
                // free() on a stack pointer), so a stack address in the cell is safe.
                // The NRVO branch above does the analogous thing with the caller's
                // storage, and cloneIfStruct covers the with-initializer case.
                pointer sdataTy = 0
                SemaClassType dct = null
                if vt != null {
                    dct = vt.asClass()
                }
                if dct != null {
                    if dct.getClassKind() == SemaClassKind.STRUCT {
                        if dct.getLlvmStructType() == 0 {
                            CodeGenClass.declareStruct(cge.getCgm(), dct)
                        }
                        sdataTy = dct.getLlvmStructType()
                    }
                }
                if sdataTy != 0 {
                    pointer sdata
                    llvm.buildAlloca(b, sdataTy, "sdata", sdata)
                    pointer sz
                    llvm.constNull(sdataTy, sz)
                    llvm.buildStore(b, sz, sdata)
                    llvm.buildStore(b, sdata, alloca)
                } else {
                    // no initializer → DEFAULT-initialize (0 / null / empty struct):
                    // `T def  out = def` in the std templates relies on it, and an
                    // uninitialized alloca is stack garbage (audit V4). Strings and
                    // arrays share this branch and NEED the null store: their
                    // scope-exit cleanup loads the slot even when control flow never
                    // reached the declaration, and {null,0} makes free/release no-ops.
                    pointer zv
                    llvm.constNull(ty, zv)
                    llvm.buildStore(b, zv, alloca)
                }
            }
        }
    }

    // deleteStmt — `delete x`: when x is not null, call its class's `free()` (if
    // it declares one), release the object, then store null into x. Deleting a
    // null reference does nothing, and the null store makes a second `delete`, or
    // the scope-exit release of a local created with `new`, a no-op instead of a
    // double free.
    public static void deleteStmt(const CodeGenExpr cge, const SemaDeleteStmt node) {
        SemaExpr target = node.getExpr()
        SemaClassType cls = target.getType().asClass()
        pointer slot = cge.genAddr(target)
        // `delete h` on a shared holder lets go of h's reference only: the object
        // goes when its last holder does.
        if target.isSharedHolder() {
            CodeGenStmt.emitReleaseSlot(cge, cls, slot)
            return
        }
        // `delete w` on a weak reference lets go of the weak reference only.
        if target.isWeakRef() {
            CodeGenStmt.emitWeakReleaseSlot(cge, slot)
            return
        }
        CodeGenStmt.emitDeleteSlot(cge, cls, slot)
    }

    // emitNullStore — store null into a reference slot: what a move leaves behind.
    public static void emitNullStore(const CodeGenExpr cge, const pointer slot) {
        LLVM llvm = cge.getLLVM()
        pointer nul
        llvm.constPointerNull(cge.ptrType(), nul)
        llvm.buildStore(cge.getBuilder(), nul, slot)
    }

    // emitDeleteSlot — the body of `delete`, for the reference stored at `slot`;
    // also what a `new unique` owner runs when its scope ends.
    public static void emitDeleteSlot(const CodeGenExpr cge, const SemaClassType cls, const pointer slot) {
        // One `@__fly_drop.<class>` per class holds the body (emitDeleteBody), so a
        // class owning a field of its own type (a list node owning the next one)
        // recurses at run time, over real objects, not in the compiler.
        CodeGenModule cgm = cge.getCgm()
        pointer fn = cgm.dropFn(cls)
        List<pointer> args = new List<pointer>()
        args.add(cge.getErrPtr())
        args.add(slot)
        pointer cv
        cgm.getCg().buildCallN(cge.getBuilder(), cgm.dropFnTy(), fn, args, "", cv)
    }

    // emitDeleteBody — what `@__fly_drop.<class>` does with the reference at `slot`:
    // nothing when it is null; otherwise free() (if the class declares one), the
    // owning fields, the object itself, and null into the slot.
    public static void emitDeleteBody(const CodeGenExpr cge, const SemaClassType cls, const pointer slot) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer ptrTy = cge.ptrType()
        pointer obj
        llvm.buildLoad2(b, ptrTy, slot, "del", obj)
        pointer nul
        llvm.constPointerNull(ptrTy, nul)
        pointer notNull
        llvm.buildICmp(b, 33, obj, nul, "delnn", notNull)
        pointer doBB = cge.newBlock("delete.do")
        pointer endBB = cge.newBlock("delete.end")
        pointer cbr
        llvm.buildCondBr(b, notNull, doBB, endBB, cbr)
        cge.position(doBB)
        CodeGenStmt.emitDestroy(cge, cls, obj)
        cge.getCgm().freeHandle(obj)
        llvm.buildStore(b, nul, slot)
        cge.br(endBB)
        cge.position(endBB)
    }

    // emitDestroy — what an object does before its memory goes: the class's free()
    // (when it declares one), then its owning fields. Shared by `delete` and by the
    // last release of a `new shared` object.
    public static void emitDestroy(const CodeGenExpr cge, const SemaClassType cls, const pointer obj) {
        SemaClassMethod freeM = CodeGenClass.findFreeMethod(cls)
        if freeM != null {
            CodeGenClass.callNoArgMethod(cge, cls, freeM, obj)
        }
        CodeGenStmt.emitDeleteOwnedFields(cge, cls, obj)
    }

    // ── `new shared` ──────────────────────────────────────────────────────────
    //
    // A shared object is allocated with a 16-byte header IN FRONT of it: the strong
    // count at -16 and the weak count at -8 (for `new weak`). The object pointer is
    // the one every other object has, so methods, fields and vtables are unchanged;
    // only allocation and release know about the header. The counts are plain, not
    // atomic: a shared object must not be shared between threads yet.

    // emitRetain — count one more holder of `obj` (null does nothing).
    public static void emitRetain(const CodeGenExpr cge, const pointer obj) {
        CodeGenModule cgm = cge.getCgm()
        List<pointer> args = new List<pointer>()
        args.add(obj)
        pointer cv
        cgm.getCg().buildCallN(cge.getBuilder(), cgm.retainFnTy(), cgm.retainFn(), args, "", cv)
    }

    // emitReleaseSlot — the holder at `slot` lets go of its reference: one count
    // less, the object destroyed and freed at zero, and null into the slot.
    public static void emitReleaseSlot(const CodeGenExpr cge, const SemaClassType cls, const pointer slot) {
        CodeGenModule cgm = cge.getCgm()
        List<pointer> args = new List<pointer>()
        args.add(cge.getErrPtr())
        args.add(slot)
        pointer cv
        cgm.getCg().buildCallN(cge.getBuilder(), cgm.dropFnTy(), cgm.releaseFn(cls), args, "", cv)
    }

    // emitReleaseBody — `@__fly_release.<class>`: when the slot holds an object,
    // decrement its strong count; at zero, destroy it (free(), owning fields) and,
    // with no weak reference left, free the whole block from its header. Null
    // goes into the slot either way: this holder no longer holds anything.
    public static void emitReleaseBody(const CodeGenExpr cge, const SemaClassType cls, const pointer slot) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer ptrTy = cge.ptrType()
        pointer i8Ty
        llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
        pointer i64Ty
        llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
        pointer obj
        llvm.buildLoad2(b, ptrTy, slot, "rel", obj)
        pointer nul
        llvm.constPointerNull(ptrTy, nul)
        pointer notNull
        llvm.buildICmp(b, 33, obj, nul, "relnn", notNull)
        pointer doBB = cge.newBlock("release.do")
        pointer endBB = cge.newBlock("release.end")
        pointer cbr
        llvm.buildCondBr(b, notNull, doBB, endBB, cbr)
        cge.position(doBB)
        pointer hdr = CodeGenStmt.sharedHeader(cge, obj)
        pointer strong
        llvm.buildLoad2(b, i64Ty, hdr, "strong", strong)
        pointer one
        llvm.constInt(i64Ty, 1, false, one)
        pointer left
        llvm.buildSub(b, strong, one, "strong.left", left)
        llvm.buildStore(b, left, hdr)
        pointer zero
        llvm.constInt(i64Ty, 0, false, zero)
        pointer last
        llvm.buildICmp(b, 32, left, zero, "lastref", last)
        pointer destroyBB = cge.newBlock("release.destroy")
        pointer doneBB = cge.newBlock("release.done")
        pointer cbr2
        llvm.buildCondBr(b, last, destroyBB, doneBB, cbr2)
        cge.position(destroyBB)
        CodeGenStmt.emitDestroy(cge, cls, obj)
        // the block outlives the object while a weak reference may still look at
        // the header; with none, it goes now
        List<pointer> wIdx = new List<pointer>()
        pointer eight
        llvm.constInt(i64Ty, 8, false, eight)
        wIdx.add(eight)
        pointer weakP
        cgm.getCg().buildGEP2N(b, i8Ty, hdr, wIdx, "weakp", weakP)
        pointer weak
        llvm.buildLoad2(b, i64Ty, weakP, "weak", weak)
        pointer noWeak
        llvm.buildICmp(b, 32, weak, zero, "noweak", noWeak)
        pointer freeBB = cge.newBlock("release.free")
        pointer cbr3
        llvm.buildCondBr(b, noWeak, freeBB, doneBB, cbr3)
        cge.position(freeBB)
        cgm.freeHandle(hdr)
        cge.br(doneBB)
        cge.position(doneBB)
        llvm.buildStore(b, nul, slot)
        cge.br(endBB)
        cge.position(endBB)
    }

    // ── `weak` ────────────────────────────────────────────────────────────────

    // emitWeakGet — the object a weak reference points at while it lives, else
    // null: what every read of a weak variable or field yields.
    public static pointer emitWeakGet(const CodeGenExpr cge, const pointer obj) {
        CodeGenModule cgm = cge.getCgm()
        List<pointer> args = new List<pointer>()
        args.add(obj)
        pointer v
        cgm.getCg().buildCallN(cge.getBuilder(), cgm.weakGetTy(), cgm.weakGetFn(), args, "weakget", v)
        return v
    }

    // emitWeakRetain — one more weak reference to `obj` (null does nothing).
    public static void emitWeakRetain(const CodeGenExpr cge, const pointer obj) {
        CodeGenModule cgm = cge.getCgm()
        List<pointer> args = new List<pointer>()
        args.add(obj)
        pointer cv
        cgm.getCg().buildCallN(cge.getBuilder(), cgm.retainFnTy(), cgm.weakRetainFn(), args, "", cv)
    }

    // emitWeakReleaseSlot — the weak reference at `slot` goes (null into the slot).
    public static void emitWeakReleaseSlot(const CodeGenExpr cge, const pointer slot) {
        CodeGenModule cgm = cge.getCgm()
        List<pointer> args = new List<pointer>()
        args.add(slot)
        pointer cv
        cgm.getCg().buildCallN(cge.getBuilder(), cgm.retainFnTy(), cgm.weakReleaseFn(), args, "", cv)
    }

    // sharedHeader — the header of a shared object: 16 bytes before it.
    public static pointer sharedHeader(const CodeGenExpr cge, const pointer obj) {
        LLVM llvm = cge.getLLVM()
        CodeGenModule cgm = cge.getCgm()
        pointer i8Ty
        llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
        pointer i64Ty
        llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
        pointer minus16
        llvm.constInt(i64Ty, 0 - 16, true, minus16)
        List<pointer> idx = new List<pointer>()
        idx.add(minus16)
        pointer hdr
        cgm.getCg().buildGEP2N(cge.getBuilder(), i8Ty, obj, idx, "shhdr", hdr)
        return hdr
    }

    // emitDeleteOwnedFields — delete every OWNING field of `obj` (a field a method
    // fills with `new unique` or an owner), after the class's free() and before
    // the object goes: what the object owns goes with it. The fields are those of
    // the STATIC type `cls`, bases included; deleting through a base or interface
    // type therefore misses fields only a subclass declares (they leak, nothing
    // is freed twice).
    public static void emitDeleteOwnedFields(const CodeGenExpr cge, const SemaClassType cls, const pointer obj) {
        if cls.getClassKind() == SemaClassKind.INTERFACE {
            return
        }
        List<SemaClassAttribute> attrs = CodeGenClass.allAttributes(cls)
        int i = 0
        while i < attrs.size() {
            SemaClassAttribute a = attrs.get(i)
            // a WEAK field lets go of its weak reference (the observed object is
            // not touched)
            if a.isWeakRef() {
                if cls.getLlvmStructType() == 0 {
                    CodeGenClass.declareStruct(cge.getCgm(), cls)
                }
                int widx = CodeGenClass.fieldIndex(cls, a.getName())
                pointer wPtr
                cge.getLLVM().buildStructGEP2(cge.getBuilder(), cls.getLlvmStructType(), obj, widx, "weakfld", wPtr)
                CodeGenStmt.emitWeakReleaseSlot(cge, wPtr)
            }
            // a HOLDING field lets go of its reference: the object goes only if
            // that was the last one
            if a.isSharedHolder() {
                SemaType ht = a.getType()
                SemaClassType hcls = ht.asClass()
                if hcls != null {
                    if cls.getLlvmStructType() == 0 {
                        CodeGenClass.declareStruct(cge.getCgm(), cls)
                    }
                    int hidx = CodeGenClass.fieldIndex(cls, a.getName())
                    pointer hPtr
                    cge.getLLVM().buildStructGEP2(cge.getBuilder(), cls.getLlvmStructType(), obj, hidx, "heldfld", hPtr)
                    CodeGenStmt.emitReleaseSlot(cge, hcls, hPtr)
                }
            }
            if a.isUniqueOwner() {
                SemaType at = a.getType()
                SemaClassType fcls = at.asClass()
                if fcls != null {
                    if cls.getLlvmStructType() == 0 {
                        CodeGenClass.declareStruct(cge.getCgm(), cls)
                    }
                    int idx = CodeGenClass.fieldIndex(cls, a.getName())
                    pointer fldPtr
                    cge.getLLVM().buildStructGEP2(cge.getBuilder(), cls.getLlvmStructType(), obj, idx, "ownfld", fldPtr)
                    CodeGenStmt.emitDeleteSlot(cge, fcls, fldPtr)
                }
            }
            i = i + 1
        }
    }

    // ret — bare `return`: any attached value-assignment is gen'd, then ret void
    // (the out-param model already stored the result via an `out = …` assignment).
    public static void ret(const CodeGenExpr cge, const SemaReturnStmt node) {
        if cge.isTerminated() {
            return
        }
        SemaExpr e = node.getExpr()
        if e != null {
            pointer _ignore = cge.gen(e)
        }
        // `return x` with x a `new unique` owner: the object now belongs to the
        // caller, so x is left null and its scope-exit delete finds nothing.
        List<SemaExpr> moves = node.getMoves()
        int mi = 0
        while mi < moves.size() {
            CodeGenStmt.emitNullStore(cge, cge.genAddr(moves.get(mi)))
            mi = mi + 1
        }
        // The value is already in the return slot (strings cloned, arrays
        // retained, the returned handle spared), so every scope's locals can go.
        cge.emitReturnCleanup()
        CodeGenTrace.emitExit(cge)
        LLVM llvm = cge.getLLVM()
        pointer r
        llvm.buildRetVoid(cge.getBuilder(), r)
        cge.setTerminated(true)
    }

    // ifStmt — cond/then, an elsif chain, and an optional else, merging at ifcont.
    public static void ifStmt(const CodeGenExpr cge, const SemaIfStmt node) {
        pointer mergeBB = cge.newBlock("ifcont")
        emitIfChain(cge, node.getCond(), node.getThen(), node.getElsif(), 0, node.getElse(), mergeBB)
        cge.position(mergeBB)
    }

    // emitIfChain — recursively lower `if cond { then } [elsif…] [else]`. Each
    // level: condBr(cond → then, next); then → merge; next holds the rest.
    public static void emitIfChain(const CodeGenExpr cge, const SemaExpr cond, const SemaStmt thenS,
                                   const List<SemaRuleStmt> elsifs, const int idx,
                                   const SemaStmt elseS, const pointer mergeBB) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer cv = cge.gen(cond)
        pointer thenBB = cge.newBlock("then")
        pointer nextBB = cge.newBlock("else")
        pointer cbr
        llvm.buildCondBr(b, cv, thenBB, nextBB, cbr)
        cge.setTerminated(true)

        cge.position(thenBB)
        if thenS != null {
            thenS.accept(cge)
        }
        cge.br(mergeBB)

        cge.position(nextBB)
        if idx < elsifs.size() {
            SemaRuleStmt r = elsifs.get(idx)
            // The elsif condition belongs to the elsif's own line; its block
            // opens with `{` on that line (expressions carry no location).
            CodeGenDebug dbg = cge.getCgm().getDebug()
            if dbg != null {
                dbg.atStmt(r.getStmt())
            }
            emitIfChain(cge, r.getExpr(), r.getStmt(), elsifs, idx + 1, elseS, mergeBB)
        } else {
            if elseS != null {
                elseS.accept(cge)
            }
            cge.br(mergeBB)
        }
    }

    // loopStmt — while/for: init → cond → body → post → cond, exit on false cond.
    // break targets exit, continue targets post. Handles do/while via the
    // verify-condition-at-end flag (body runs before the first cond check).
    public static void loopStmt(const CodeGenExpr cge, const SemaLoopStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        List<SemaStmt> init = node.getInit()
        int i = 0
        while i < init.size() {
            SemaStmt s = init.get(i)
            s.accept(cge)
            i = i + 1
        }

        pointer condBB = cge.newBlock("loopcond")
        pointer bodyBB = cge.newBlock("loopbody")
        pointer postBB = cge.newBlock("looppost")
        pointer exitBB = cge.newBlock("loopexit")

        bool atEnd = node.hasVerifyConditionAtEnd()
        if atEnd {
            cge.br(bodyBB)
        } else {
            cge.br(condBB)
        }

        // cond — reached again from the end of the body, so give it back the
        // loop's own line rather than the last body statement's.
        cge.position(condBB)
        CodeGenDebug ldbg = cge.getCgm().getDebug()
        if ldbg != null {
            ldbg.atStmt(node)
        }
        SemaExpr cond = node.getCond()
        if cond != null {
            pointer cv = cge.gen(cond)
            pointer cbr
            llvm.buildCondBr(b, cv, bodyBB, exitBB, cbr)
            cge.setTerminated(true)
        } else {
            cge.br(bodyBB)
        }

        // body (save/restore enclosing break/continue targets)
        pointer savedBreak = cge.getBreakTarget()
        pointer savedCont = cge.getContinueTarget()
        pointer savedBreakDepth = cge.getBreakDepth()
        pointer savedContDepth = cge.getContinueDepth()
        cge.setBreakTarget(exitBB)
        cge.setContinueTarget(postBB)
        cge.setBreakDepth(cge.getFrameDepth())
        cge.setContinueDepth(cge.getFrameDepth())
        cge.position(bodyBB)
        SemaStmt body = node.getBody()
        if body != null {
            body.accept(cge)
        }
        cge.br(postBB)
        cge.setBreakTarget(savedBreak)
        cge.setContinueTarget(savedCont)
        cge.setBreakDepth(savedBreakDepth)
        cge.setContinueDepth(savedContDepth)

        // post
        cge.position(postBB)
        List<SemaStmt> post = node.getPost()
        int j = 0
        while j < post.size() {
            SemaStmt s = post.get(j)
            s.accept(cge)
            j = j + 1
        }
        cge.br(condBB)

        cge.position(exitBB)
    }

    // switchStmt — buildSwitch over the selector; one block per case. From 0.15 no
    // case falls into the next: a body that ends without `break`, `return` or
    // `fail` continues after the switch, like one that ends with `break` (which
    // branches to swexit via breakTarget). Up to 0.14 it fell through to the next
    // case body (C semantics, doc 9.4). Only a value of `case 3, 4:` other than
    // the last (Sema marks it with a null block) branches to the next case's body,
    // which is why the case blocks are pre-created.
    public static void switchStmt(const CodeGenExpr cge, const SemaSwitchStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        pointer sel = cge.gen(node.getExpr())
        List<SemaRuleStmt> cases = node.getCases()
        int n = (int)cases.size()

        pointer exitBB = cge.newBlock("swexit")
        pointer defaultBB = exitBB
        SemaStmt defS = node.getDefault()
        if defS != null {
            defaultBB = cge.newBlock("swdefault")
        }

        pointer sw
        llvm.buildSwitch(b, sel, defaultBB, n, sw)
        cge.setTerminated(true)

        pointer savedBreak = cge.getBreakTarget()
        pointer savedBreakDepth = cge.getBreakDepth()
        cge.setBreakTarget(exitBB)
        cge.setBreakDepth(cge.getFrameDepth())

        // pre-create every case block and register the labels
        SemaExpr selE = node.getExpr()
        List<pointer> caseBBs = new unique List<pointer>()
        int pi = 0
        while pi < n {
            SemaRuleStmt pr = cases.get(pi)
            SemaExpr caseE = pr.getExpr()
            pointer onVal = cge.gen(caseE)
            // case labels must match the selector's integer width (switch on a
            // long with int case literals would otherwise mix i64/i32)
            onVal = cge.coerce(onVal, caseE.getType(), selE.getType())
            pointer caseBB = cge.newBlock("swcase")
            llvm.addCase(sw, onVal, caseBB)
            caseBBs.add(caseBB)
            pi = pi + 1
        }

        int i = 0
        while i < n {
            SemaRuleStmt r = cases.get(i)
            pointer caseBB = caseBBs.get(i)
            cge.position(caseBB)
            SemaStmt cs = r.getStmt()
            // a shared value (null block) runs the next case's body; a body leaves
            // the switch. br() is a no-op when the body already terminated
            // (break/return/fail).
            if cs != null {
                cs.accept(cge)
                cge.br(exitBB)
            } else {
                pointer nextBB = defaultBB
                if i + 1 < n {
                    nextBB = caseBBs.get(i + 1)
                }
                cge.br(nextBB)
            }
            i = i + 1
        }

        if defS != null {
            cge.position(defaultBB)
            defS.accept(cge)
            cge.br(exitBB)
        }

        cge.setBreakTarget(savedBreak)
        cge.setBreakDepth(savedBreakDepth)
        cge.position(exitBB)
    }

    // breakStmt / continueStmt — free the locals of the scopes being left (those
    // opened since the loop/switch began), then branch to the innermost exit /
    // post block.
    public static void breakStmt(const CodeGenExpr cge, const SemaBreakStmt node) {
        if cge.isTerminated() {
            return
        }
        cge.emitCleanup(cge.getFrameDepth() - cge.getBreakDepth())
        cge.br(cge.getBreakTarget())
    }
    public static void continueStmt(const CodeGenExpr cge, const SemaContinueStmt node) {
        if cge.isTerminated() {
            return
        }
        cge.emitCleanup(cge.getFrameDepth() - cge.getContinueDepth())
        cge.br(cge.getContinueTarget())
    }
}
