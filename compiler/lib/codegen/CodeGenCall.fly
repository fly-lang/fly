namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenLLVM
import fly.compiler.codegen.CodeGenIntrinsics
import llvm.api.*
import fly.mem
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenCall — lower a SemaCall to the uniform calling convention (from the
// reference compiler): the callee is `void (errPtr, arg1, …, argN, [outPtr])` with
// every operand passed BY POINTER. So the call site:
//   1) passes the current function's error pointer (LLVM param 0) first,
//   2) materialises each argument into a fresh alloca and passes that pointer,
//   3) for a non-void result, allocas the synthetic out local and passes its
//      pointer last, then loads it back as the call's value.
// Marshalled through CodeGenLLVM.buildCallN (the bridge can't pass multi-arg
// arrays directly).
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenCall {

    public CodeGenCall() { }

    public static void call(const CodeGenExpr cge, const SemaCall node) {
        SemaFunctionBase fn = node.getFunction()

        // fly.llvm.* calls lower to INLINE IR (no archive symbol exists) and
        // fly.runtime.* to DIRECT C calls — mirrors the reference's
        // CodeGenStdLibLLVM / CodeGenStdLibRuntime dispatch (audit V4 fase 2).
        if fly.str.equals(fn.getNamespaceName(), "fly_llvm") {
            CodeGenIntrinsics.genLLVM(cge, node)
            return
        }
        if fly.str.equals(fn.getNamespaceName(), "fly_runtime") {
            CodeGenIntrinsics.genRuntime(cge, node)
            return
        }

        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer fnTy = fn.getLlvmFnType()
        pointer fnVal = fn.getLlvmFn()

        List<pointer> argAddrs = new List<pointer>()

        // (1) error pointer — forward the current function's param-0 handler.
        pointer err = cge.getErrPtr()
        argAddrs.add(err)

        // (1b) a RECEIVER-LESS class-method call (a static `ClassName.m(args)`,
        // or a bare same-class helper call) still targets the method ABI
        // `void (errPtr, this, params…)` — fill the `this` slot with null
        // (a static/suite-helper body never dereferences it).
        SemaClassMethod scm = fn.asClassMethod()
        if scm != null {
            pointer thisPty = cge.ptrType()
            pointer nullThis
            llvm.constPointerNull(thisPty, nullThis)
            argAddrs.add(nullThis)
        }

        // The resolver appends the synthetic out var to getArgs() (so it is the
        // LAST element when the call returns non-void); it must be passed by
        // pointer, NOT gen'd as a value. So gen only the leading `realCount` args.
        List<SemaExpr> args = node.getArgs()
        SemaLocalVar outVar = node.getOutVar()
        bool hasOut = outVar != null
        // A MULTI-RETURN callee carries one synthetic out slot per declared return
        // type, so drop all of them — subtracting a fixed 1 would gen the surplus
        // out vars as ordinary value args and leave the call short of the callee's
        // LLVM signature (which crashes inside libLLVM at buildCall).
        List<SemaLocalVar> outVars = node.getOutVars()
        int outCount = (int)outVars.size()
        if hasOut { if outCount == 0 { outCount = 1 } }
        int realCount = (int)args.size() - outCount

        // (2) actual arguments — fresh temp per arg, store the rvalue, pass &temp. The
        // uniform convention passes every operand BY POINTER, so the temp must have the
        // PARAM type, not the arg's: a narrower integer arg (int literal → long param)
        // is sext/trunc'd to the param type first, else the callee reads a wrong-sized
        // slot. Non-integer or exactly-matching args are stored as-is.
        List<SemaParam> calleeParams = fn.getParams()
        int i = 0
        while i < realCount {
            SemaExpr a = args.get(i)

            // Writable (non-const) param + variable arg: pass the ORIGINAL
            // storage address, so callee writes reach the caller's variable —
            // multi-out functions like math.divmod(q, r) depend on it (audit V4;
            // mirrors the reference's addArgs output-param fast-path).
            bool passedDirect = false
            if i < calleeParams.size() {
                SemaParam cp = calleeParams.get(i)
                if cp.isConstant() == false {
                    if a.isVarExpr() {
                        pointer addr = cge.genAddr(a)
                        argAddrs.add(addr)
                        passedDirect = true
                    }
                }
            }
            if passedDirect == false {
                pointer av = cge.gen(a)
                SemaType aTy = a.getType()
                SemaType pTy = aTy
                bool cpConst = false
                if i < calleeParams.size() {
                    SemaParam cp2 = calleeParams.get(i)
                    SemaType cpt = cp2.getType()
                    if cpt != null { pTy = cpt }
                    cpConst = cp2.isConstant()
                }
                // Reference ABI: a CONST CLASS/INTERFACE handle (a heap pointer) is passed
                // BY VALUE — the handle itself in the register — NOT wrapped in a temp.
                // Mirrors fly/ CodeGenExpr::addArgs, which pushes an already-pointer value
                // directly and only allocas non-pointer values. Passing a handle by &temp
                // made an archive callee store the temp's ADDRESS (a stack ptr) where the
                // handle belongs → later virtual dispatch jumped to garbage. STRUCTs are
                // value aggregates (they lower to ptr too, but are NOT heap handles) and
                // stay on the by-pointer path, as do non-const params (so callee writes
                // reach the caller). Mirrors the callee split in CodeGenModule.genBody.
                SemaClassType pcls = null
                if pTy != null { pcls = pTy.asClass() }
                bool byValHandle = false
                if cpConst {
                    if pcls != null {
                        if pcls.getClassKind() != SemaClassKind.STRUCT { byValHandle = true }
                    }
                }
                if byValHandle {
                    argAddrs.add(av)
                } else {
                    // bring the arg to the param's numeric type (coerce compares lowered
                    // WIDTHS, so same-width rank pairs like int/uint don't emit bogus
                    // same-type sext/trunc; it also covers int→float params)
                    pointer storeVal = cge.coerce(av, aTy, pTy)
                    pointer aty = cge.lowerType(pTy)
                    pointer tmp
                    llvm.buildAlloca(b, aty, "arg", tmp)
                    llvm.buildStore(b, storeVal, tmp)
                    argAddrs.add(tmp)
                }
            }
            i = i + 1
        }

        // (3) out pointer for a non-void return. For a CLASS-kind result the
        // reference convention is: the out slot holds a POINTER to storage the
        // callee writes through — STRUCT results get a stack pre-allocation,
        // CLASS/INTERFACE results a heap one (mirrors addArgs; without it the
        // archive callee writes through garbage → segfault, audit V4 fase 2).
        // One slot per synthetic out var, in declaration order; the FIRST is the
        // call's rvalue. Multi-return passes several, so this loops.
        pointer outPtr = 0
        if hasOut {
            int oi = 0
            while oi < outCount {
                SemaLocalVar ov = outVar
                if oi < outVars.size() { ov = outVars.get(oi) }
                SemaType ot = ov.getType()
                pointer oty = cge.lowerType(ot)
                pointer slot
                llvm.buildAlloca(b, oty, "callout", slot)
                SemaClassType oc = null
                if ot != null { oc = ot.asClass() }
                if oc != null {
                    pointer sty = oc.getLlvmStructType()
                    if sty != 0 {
                        pointer target
                        if oc.getClassKind() == SemaClassKind.STRUCT {
                            llvm.buildAlloca(b, sty, "outobj", target)
                        } else {
                            llvm.buildMalloc(b, sty, "outobj", target)
                        }
                        llvm.buildStore(b, target, slot)
                    }
                }
                ov.setLlvmAlloca(slot)
                argAddrs.add(slot)
                if oi == 0 { outPtr = slot }
                oi = oi + 1
            }
        }

        CodeGenModule m = cge.getCgm()
        CodeGenLLVM cg = m.getCg()
        pointer callV
        cg.buildCallN(b, fnTy, fnVal, argAddrs, "", callV)

        // the call's rvalue is the out slot reloaded (void calls produce nothing).
        if hasOut {
            pointer oty2 = cge.lowerType(outVar.getType())
            pointer loaded
            llvm.buildLoad2(b, oty2, outPtr, "callres", loaded)
            node.setLlvmValue(loaded)
        }
    }
}
