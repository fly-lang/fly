namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenLLVM
import fly.compiler.codegen.CodeGenTrace
import llvm.api.*
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenError — `fail` / `handle` lowering over the shared `%error` struct
// ({ i32 code, ptr str, ptr obj }) that every function receives by pointer
// (param 0). `fail` writes the struct then returns early; after every call to a
// Fly function the caller checks the code and leaves too (`propagate`) — no
// stack unwinding. The struct owns its message (a NUL-terminated heap copy);
// `handle` runs its guarded block, then consumes the failure: frees the message
// and clears message, object and code, so the next failure starts empty.
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenError {

    public CodeGenError() { }

    // fail — write the error struct (code / str / obj by operand type), then:
    // inside a handle block, jump to the handle's continuation ("safe") block;
    // otherwise return early (the failing callee returns; the caller continues).
    public static void emitFail(const CodeGenExpr cge, const SemaFailStmt node) {
        if cge.isTerminated() {
            return
        }
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer errTy = cgm.getErrorTy()
        pointer errPtr = cge.getErrPtr()

        // Evaluate EVERY operand before writing any field: an operand may be a call
        // (`fail c, str.concat(w, ": x")`), and the failure check after that call
        // reads the code field. With the code already written it took the exit
        // itself and the message was never stored.
        List<SemaExpr> ops = new List<SemaExpr>()
        if node.getFirst() != null {
            ops.add(node.getFirst())
        }
        if node.getSecond() != null {
            ops.add(node.getSecond())
        }
        if node.getThird() != null {
            ops.add(node.getThird())
        }
        List<pointer> vals = new List<pointer>()
        int i = 0
        while i < ops.size() {
            vals.add(cge.gen(ops.get(i)))
            i = i + 1
        }
        bool wroteCode = false
        i = 0
        while i < ops.size() {
            SemaExpr op = ops.get(i)
            writeField(cge, errTy, errPtr, op, vals.get(i))
            SemaType ot = op.getType()
            if ot != null {
                if isCodeField(ot) {
                    wroteCode = true
                }
            }
            i = i + 1
        }

        // A failure with no integer code still signals "failed": default code = 1.
        if wroteCode == false {
            pointer i32
            llvm.int32TypeInContext(cgm.getCtx(), i32)
            pointer one
            llvm.constInt(i32, 1, true, one)
            pointer cp
            llvm.buildStructGEP2(b, errTy, errPtr, 0, "ecode", cp)
            llvm.buildStore(b, one, cp)
        }

        pointer safe = cge.getHandleSafe()
        if safe != 0 {
            // fail inside the handle's own frame: skip the rest of the block
            cge.br(safe)
        } else {
            cge.emitReturnCleanup()
            CodeGenTrace.emitExitFail(cge)
            pointer r
            llvm.buildRetVoid(b, r)
            cge.setTerminated(true)
        }
        // statements after a fail are unreachable, but the visitor still emits
        // them: park the builder in a fresh block so they don't land after the
        // terminator (the block itself gets closed by the surrounding flow).
        pointer deadBB = cge.newBlock("afterfail")
        cge.position(deadBB)
    }

    // failWithCode — a failure raised BY THE COMPILER rather than by a `fail`
    // statement: store a fixed integer code, then take the same exit emitFail
    // takes — jump to the enclosing handle's safe block, or return. The array
    // bounds check needs this: there is no SemaFailStmt to carry the code.
    //
    // `message` (may be empty) goes into the error's str field, as a constant
    // NUL-terminated string: an uncaught failure then prints
    // "error <code>: <message>", like a fail with a string operand.
    //
    // Unlike emitFail it does NOT park the builder in a dead block: the caller is
    // mid-expression and goes on emitting into the in-range block it created, so
    // parking here would strand that block.
    public static void failWithCode(const CodeGenExpr cge, const int code, const string message) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer errTy = cgm.getErrorTy()
        pointer errPtr = cge.getErrPtr()
        pointer i32
        llvm.int32TypeInContext(cgm.getCtx(), i32)
        pointer cv
        llvm.constInt(i32, (long)code, true, cv)
        pointer cp
        llvm.buildStructGEP2(b, errTy, errPtr, 0, "ecode", cp)
        llvm.buildStore(b, cv, cp)
        if str.isEmpty(message) == false {
            // The error owns its message (handle frees it): store a heap copy of
            // the constant, never the constant itself.
            pointer i64t
            llvm.int64TypeInContext(cgm.getCtx(), i64t)
            pointer nV
            llvm.constInt(i64t, (long)str.len(message) + 1, false, nV)
            pointer buf = cgm.emitMalloc(nV)
            pointer mcr
            llvm.buildMemCpy(b, buf, cgm.cstr(message), nV, mcr)
            pointer sp
            llvm.buildStructGEP2(b, errTy, errPtr, 1, "estr", sp)
            llvm.buildStore(b, buf, sp)
        }

        pointer safe = cge.getHandleSafe()
        if safe != 0 {
            cge.br(safe)
        } else {
            cge.emitReturnCleanup()
            CodeGenTrace.emitExitFail(cge)
            pointer r
            llvm.buildRetVoid(b, r)
            cge.setTerminated(true)
        }
    }

    // propagate — emitted right after every call to a Fly function (plain, method,
    // interface, constructor): a failure is not ignorable. If the callee left a
    // code in the shared %error, the caller stops where it is and takes the same
    // exit a `fail` of its own would take: the enclosing handle's safe block, the
    // enclosing suite case's end, or a return (scope cleanup + trace hook). The
    // error is NOT cleared: it travels on to whoever handles it, or to main.
    //
    // Like failWithCode it runs mid-expression, so it leaves the builder in a
    // fresh "call.ok" block where the expression goes on.
    public static void propagate(const CodeGenExpr cge) {
        if cge.isTerminated() {
            return
        }
        pointer errPtr = cge.getErrPtr()
        if errPtr == 0 {
            return
        }
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer errTy = cgm.getErrorTy()
        pointer i32
        llvm.int32TypeInContext(cgm.getCtx(), i32)
        pointer zero
        llvm.constInt(i32, 0, true, zero)
        pointer cp
        llvm.buildStructGEP2(b, errTy, errPtr, 0, "pcode", cp)
        pointer codeV
        llvm.buildLoad2(b, i32, cp, "pcodev", codeV)
        pointer hasErr
        llvm.buildICmp(b, 33, codeV, zero, "pfailed", hasErr)   // NE

        pointer okBB = cge.newBlock("call.ok")
        pointer safe = cge.getHandleSafe()
        pointer caseEnd = cge.getCaseEnd()
        pointer cbr
        if safe != 0 {
            llvm.buildCondBr(b, hasErr, safe, okBB, cbr)
        } elsif caseEnd != 0 {
            llvm.buildCondBr(b, hasErr, caseEnd, okBB, cbr)
        } else {
            pointer failBB = cge.newBlock("call.fail")
            llvm.buildCondBr(b, hasErr, failBB, okBB, cbr)
            cge.setTerminated(true)
            cge.position(failBB)
            cge.emitReturnCleanup()
            CodeGenTrace.emitExitFail(cge)
            pointer r
            llvm.buildRetVoid(b, r)
        }
        cge.setTerminated(true)
        cge.position(okBB)
    }

    // writeField — store one evaluated fail operand `v` into its slot:
    // int/enum/bool → code (0), string → str (1), class/other ptr → obj (2).
    public static void writeField(const CodeGenExpr cge, const pointer errTy, const pointer errPtr, const SemaExpr e,
            const pointer v) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        int idx = 2
        bool isStr = false
        SemaType t = e.getType()
        if t != null {
            if isCodeField(t) {
                idx = 0
            } elsif t.isString() {
                idx = 1
                isStr = true
            }
        }
        pointer fp
        llvm.buildStructGEP2(b, errTy, errPtr, idx, "efld", fp)
        if isStr {
            // The str field is a char* the runtime helpers (err_print /
            // suite_case_result) read until NUL — but a Fly string is {ptr,size}
            // and is NOT NUL-terminated, so store a fresh NUL-terminated copy:
            // malloc(size+1), memcpy, buf[size] = 0. The error owns that copy: the
            // handle that consumes the failure frees it (an unhandled one ends the run).
            CodeGenModule cgm = cge.getCgm()
            CodeGenLLVM cg = cgm.getCg()
            pointer srcP
            llvm.buildExtractValue(b, v, 0, "efsp", srcP)
            pointer szV
            llvm.buildExtractValue(b, v, 1, "efsz", szV)
            pointer i64t
            llvm.int64TypeInContext(cgm.getCtx(), i64t)
            pointer szW
            llvm.buildZExt(b, szV, i64t, "efszw", szW)
            pointer one64
            llvm.constInt(i64t, 1, false, one64)
            pointer bufSz
            llvm.buildAdd(b, szW, one64, "efbufsz", bufSz)
            pointer buf = cgm.emitMalloc(bufSz)
            pointer mcr
            llvm.buildMemCpy(b, buf, srcP, szW, mcr)
            pointer i8t
            llvm.int8TypeInContext(cgm.getCtx(), i8t)
            List<pointer> gidx = new List<pointer>()
            gidx.add(szW)
            pointer endP
            cg.buildGEP2N(b, i8t, buf, gidx, "efend", endP)
            pointer z8
            llvm.constInt(i8t, 0, false, z8)
            llvm.buildStore(b, z8, endP)
            llvm.buildStore(b, buf, fp)
            // A temporary message (a call result, a concat) has no other owner: its
            // bytes now live in the copy, so release it here — it moved into the error.
            if e.isOwnedStrTemp() {
                cgm.freeHandle(srcP)
            }
        } else {
            llvm.buildStore(b, v, fp)
        }
    }

    // isCodeField — operand types that land in the i32 code slot.
    public static bool isCodeField(const SemaType t) {
        if t.isInteger() {
            return true
        }
        if t.isBool() {
            return true
        }
        if t.getKind() == SemaKind.TYPE_ENUM {
            return true
        }
        return false
    }

    // handle — run the guarded block and UPDATE the implicit `error` variable:
    //   1. clear the slot before the block (a fresh capture window)
    //   2. run the block; a direct `fail` inside it jumps to the "safe" block
    //   3. lasterr = struct.code (what `error` reads); then consume the whole
    //      failure — free its message, clear message, object and code — so a handled
    //      failure never propagates to the caller and the next one starts empty
    public static void emitHandle(const CodeGenExpr cge, const SemaHandleStmt node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer errTy = cgm.getErrorTy()
        pointer errPtr = cge.getErrPtr()
        pointer i32
        llvm.int32TypeInContext(cgm.getCtx(), i32)

        // 1) fresh window: clear the slot before the guarded block
        cgm.zeroErrSlot(errPtr)

        // 2) run the block; direct fails jump to `handle.safe`
        pointer safeBB = cge.newBlock("handle.safe")
        pointer savedSafe = cge.getHandleSafe()
        cge.setHandleSafe(safeBB)
        SemaBlockStmt block = node.getHandle()
        if block != null {
            block.accept(cge)
        }
        cge.setHandleSafe(savedSafe)
        cge.br(safeBB)
        cge.position(safeBB)

        // 3) error := struct.code ; consume the failure (message, object, code)
        pointer cp1
        llvm.buildStructGEP2(b, errTy, errPtr, 0, "ecode", cp1)
        pointer codeV
        llvm.buildLoad2(b, i32, cp1, "hcode", codeV)
        llvm.buildStore(b, codeV, cge.getLastErrPtr())
        cgm.zeroErrSlot(errPtr)
    }
}
