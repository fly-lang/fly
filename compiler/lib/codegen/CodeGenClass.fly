namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenBridge
import fly.compiler.codegen.CodeGenLLVM
import fly.compiler.codegen.CodeGenDebug
import fly.compiler.codegen.CodeGenType
import fly.compiler.codegen.CodeGenIntrinsics
import fly.compiler.codegen.CodeGenTrace
import fly.compiler.codegen.CodeGenStmt
import fly.compiler.codegen.CodeGenError
import llvm.api.*
import fly.data.List
import fly.str
import fly.math
import fly.os.io

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenClass — class lowering (Stage 5a: single classes, no inheritance yet).
// Layout mirrors the reference compiler: every object is `{ ptr vtable, fields… }`
// (the vtable pointer at slot 0, attributes from slot 1 in declaration order).
// Each class gets a vtable global `[null, method0, method1, …]` (methodList order);
// instance method calls dispatch through it (vtable load → slot GEP → indirect
// call). Methods lower to `void (errPtr, this, params…, [out])`; `this` is a real
// object pointer passed by value (so it gets its own alloca, unlike by-pointer
// params). Inheritance / base subobjects / this-adjusting thunks: Stage 5b.
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenClass {

    public CodeGenClass() { }

    // declareStruct — create the named LLVM struct type.
    //   CLASS:  { ptr vtable, flattened fields… } — bases first, then own (flat)
    //   STRUCT: { fields… }
    // The same for a class read from a header: the archive behind it was built
    // by this compiler. (It used to take the seed's base-subobject layout, when
    // the shipped std was compiled by the seed.)
    public static void declareStruct(const CodeGenModule cgm, const SemaClassType cls) {
        if cls.getLlvmStructType() != 0 { // already declared (recursion)
            return
        }
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()

        string sname = structName(cls)
        pointer st
        llvm.structCreateNamed(cgm.getCtx(), sname, st)
        cls.setLlvmStructType(st)

        List<pointer> fieldTys = new List<pointer>()
        bool isStruct = cls.getClassKind() == SemaClassKind.STRUCT
        if isStruct == false {
            pointer vtp = types.ptrType()
            fieldTys.add(vtp)                   // slot 0: vtable pointer
        }
        // ONE layout for every class, wherever it comes from: a class read from a
        // `.fly.h` was compiled into its archive by this same compiler, so its
        // objects have exactly the layout computed here.
        List<SemaClassAttribute> attrs = allAttributes(cls)   // base fields first, then own
        int i = 0
        while i < attrs.size() {
            SemaClassAttribute a = attrs.get(i)
            pointer fty = fieldLlvmType(cgm, a.getType())
            fieldTys.add(fty)
            i = i + 1
        }
        cg.structSetBodyN(st, fieldTys, false)

        // STATIC attributes live in module GLOBALS (B030); the handle rides the
        // attribute's llvmAlloca slot (SemaVar). They also still occupy an
        // instance slot above — wasted bytes, but keeping the layout untouched
        // avoids re-threading fieldIndex/vtable math. The global starts at the
        // field's initializer, folded to a constant by Sema (fly-lang/fly#243),
        // or at zero.
        List<SemaClassAttribute> ownAttrs = cls.getAttributeList()
        int si = 0
        while si < ownAttrs.size() {
            SemaClassAttribute sa = ownAttrs.get(si)
            if sa.isStatic() {
                if sa.getLlvmAlloca() == 0 {
                    pointer gty = fieldLlvmType(cgm, sa.getType())
                    string gname = str.concat(sname, str.concat(".static.", sa.getName()))
                    pointer g
                    llvm.addGlobal(cgm.getModule(), gty, gname, g)
                    llvm.setInitializer(g, staticInitValue(cgm, sa, gty))
                    sa.setLlvmAlloca(g)
                }
            }
            si = si + 1
        }
    }

    // fieldLlvmType — the LLVM type a FIELD slot uses. A STRUCT-kind field is laid
    // out INLINE (reference ABI: %Holder = { ptr, %Point }); lowerType would give
    // the opaque pointer used for struct VALUES, and a ptr-sized slot can only
    // hold a pointer to storage the object does not own (the assignment's stack
    // clone — dead on return, the WrapperSuite/Linux garbage reads). Everything
    // else lowers as usual (class handles stay opaque pointers).
    public static pointer fieldLlvmType(const CodeGenModule cgm, const SemaType t) {
        SemaClassType fc = t.asClass()
        if fc != null {
            if fc.getClassKind() == SemaClassKind.STRUCT {
                declareStruct(cgm, fc)
                return fc.getLlvmStructType()
            }
        }
        return cgm.getTypes().lowerType(t)
    }

    // refClassId — the reference codegen's class Id (`io.FileWriter`): LAST
    // namespace segment + "." + class name. Used to reference archive-defined
    // helpers like `<Id>.init_ctor` for header classes.
    public static string refClassId(const SemaClassType cls) {
        SemaModule mod = cls.getModule()
        string nsn = ""
        if mod != null {
            SemaNameSpace ns = mod.getNameSpace()
            if ns != null {
                nsn = ns.getName()
            }
        }
        int dot = str.lastIndexOf(nsn, ".")
        if dot >= 0 {
            int L = str.len(nsn)
            string seg = str.substring(nsn, dot + 1, L)
            string a = str.concat(seg, ".")
            return str.concat(a, className(cls))
        }
        string b2 = str.concat(nsn, ".")
        return str.concat(b2, className(cls))
    }

    // declareMethod — LLVM signature `void (errPtr, this, params…)` (params already
    // include the synthetic out for a non-void return). No body.
    public static void declareMethod(const CodeGenModule cgm, const SemaClassType cls, const SemaClassMethod m) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()

        pointer voidTy
        llvm.voidTypeInContext(cgm.getCtx(), voidTy)
        List<pointer> ptypes = new List<pointer>()
        pointer err = types.ptrType()
        ptypes.add(err)                         // errPtr
        pointer thisp = types.ptrType()
        ptypes.add(thisp)                       // this
        List<SemaParam> params = m.getParams()
        int i = 0
        while i < params.size() {
            pointer pp = types.ptrType()
            ptypes.add(pp)
            i = i + 1
        }
        pointer fnTy
        cg.functionTypeN(voidTy, ptypes, false, fnTy)
        m.setLlvmFnType(fnTy)

        string name = methodMangle(cgm, cls, m)
        pointer f
        llvm.addFunction(cgm.getModule(), name, fnTy, f)
        m.setLlvmFn(f)
    }

    // ── field initializers (fly-lang/fly#243) ─────────────────────────────────
    //
    // An instance field's initializer runs when its object is created: after the
    // zeroing, before any constructor, inherited fields first, in declaration
    // order — whether or not a constructor calls super(...). A struct value runs
    // its struct's initializers wherever it is made: `new P()`, `P p`, a brace
    // literal (for the fields it omits) and a struct field inside an object.
    //
    // A class or struct with something to run gets a routine
    // `void fieldinit.<ns>.<T>(err, obj)` in the object that defines it. A header
    // carries no initializer, only a mark on each field that has one
    // (HeaderGen: `= 0`), so code creating a header type calls the archive's
    // routine; an archive built by an older release has no marks and no calls.

    // fieldInitName — the routine's symbol: the FULL namespace (fly_os_io), as a
    // last segment alone could name two types the same.
    public static string fieldInitName(const SemaClassType cls) {
        string ns = SemaBuilder.classNsFlat(cls)
        string a = str.concat("fieldinit.", ns)
        string b2 = str.concat(a, ".")
        return str.concat(b2, className(cls))
    }

    public static pointer fieldInitFnType(const CodeGenModule cgm) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        pointer voidTy
        llvm.voidTypeInContext(cgm.getCtx(), voidTy)
        List<pointer> ps = new List<pointer>()
        ps.add(cgm.getTypes().ptrType())        // errPtr
        ps.add(cgm.getTypes().ptrType())        // the object
        pointer fty
        cg.functionTypeN(voidTy, ps, false, fty)
        return fty
    }

    // fieldInitFn — the routine of `cls`, declared on first use.
    public static pointer fieldInitFn(const CodeGenModule cgm, const SemaClassType cls) {
        LLVM llvm = cgm.getCg().getLLVM()
        string name = fieldInitName(cls)
        pointer fn
        llvm.getNamedFunction(cgm.getModule(), name, fn)
        if fn == 0 {
            llvm.addFunction(cgm.getModule(), name, fieldInitFnType(cgm), fn)
        }
        return fn
    }

    // inlineStructOf — the struct type of a field laid out inline, else null.
    public static SemaClassType inlineStructOf(const SemaType t) {
        if t == null {
            return null
        }
        SemaClassType c = t.asClass()
        if c == null {
            return null
        }
        if c.getClassKind() != SemaClassKind.STRUCT {
            return null
        }
        return c
    }

    // needsFieldInit — does creating a `cls` run an initializer? A header type
    // says so field by field (SemaClassAttribute.isHeaderInit): an archive built
    // by a release that never emitted the routine never asks for it.
    public static bool needsFieldInit(const SemaClassType cls) {
        if cls == null {
            return false
        }
        if cls.getClassKind() == SemaClassKind.INTERFACE {
            return false
        }
        List<SemaClassType> bases = cls.getBaseClasses()
        if bases.size() > 0 {
            if needsFieldInit(bases.get(0)) {
                return true
            }
        }
        List<SemaClassAttribute> own = cls.getAttributeList()
        int i = 0
        while i < own.size() {
            SemaClassAttribute a = own.get(i)
            if a.isStatic() == false {
                if a.getInitExpr() != null || a.isHeaderInit() {
                    return true
                }
                SemaClassType sc = inlineStructOf(a.getType())
                if sc != null {
                    if needsFieldInit(sc) {
                        return true
                    }
                }
            }
            i = i + 1
        }
        return false
    }

    // emitFieldInitFn — define `fieldinit.<T>`: the initializers of `cls` run on
    // the object it is given. Weak, like init_ctor: a generic specialization is
    // emitted by every object that uses it.
    public static void emitFieldInitFn(const CodeGenModule cgm, const SemaClassType cls) {
        if cls.getLlvmStructType() == 0 {
            return
        }
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        pointer b = cgm.getBuilder()
        pointer fn = fieldInitFn(cgm, cls)
        llvm.setLinkage(fn, 3)
        cgm.setWeakComdat(fn, fieldInitName(cls))

        pointer entry
        llvm.appendBasicBlockInContext(cgm.getCtx(), fn, "entry", entry)
        llvm.positionBuilderAtEnd(b, entry)
        CodeGenExpr cge = new CodeGenExpr(cgm)
        pointer errParam
        llvm.getParam(fn, 0, errParam)
        cge.setErrPtr(errParam)
        pointer i32le
        llvm.int32TypeInContext(cgm.getCtx(), i32le)
        pointer leSlot
        llvm.buildAlloca(b, i32le, "lasterr", leSlot)
        pointer leZero
        llvm.constInt(i32le, 0, true, leZero)
        llvm.buildStore(b, leZero, leSlot)
        cge.setLastErrPtr(leSlot)
        pointer obj
        llvm.getParam(fn, 1, obj)

        emitFieldInits(cge, cls, obj, null)
        if cge.isTerminated() == false {
            pointer ret
            llvm.buildRetVoid(b, ret)
        }
    }

    // callFieldInit — run the initializers of `cls` on `obj` from a body: a call
    // to its routine, then the failure check of any call.
    public static void callFieldInit(const CodeGenExpr cge, const SemaClassType cls, const pointer obj) {
        CodeGenModule cgm = cge.getCgm()
        pointer fn = fieldInitFn(cgm, cls)
        List<pointer> args = new List<pointer>()
        args.add(cge.getErrPtr())
        args.add(obj)
        pointer cv
        cgm.getCg().buildCallN(cge.getBuilder(), fieldInitFnType(cgm), fn, args, "", cv)
        CodeGenError.propagate(cge)
    }

    // emitFieldInits — the initializers of `cls`, emitted inline on `obj` (laid
    // out as `cls`), skipping the fields named in `skip` (those a brace literal
    // gives). The base comes first: inline too, unless it is a header type,
    // whose routine is called. A CLASS lays the fields of a STRUCT base flat
    // after its vtable slot, at the same offsets as in the struct itself.
    // Each initializer is stored like the assignment `f = init` in a
    // constructor (string copy, inline struct copy, coercion); a struct field
    // without one gets its own struct's initializers.
    public static void emitFieldInits(const CodeGenExpr cge, const SemaClassType cls, const pointer obj,
            const List<string> skip) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer structTy = cls.getLlvmStructType()
        bool isStruct = cls.getClassKind() == SemaClassKind.STRUCT

        List<SemaClassType> bases = cls.getBaseClasses()
        if bases.size() > 0 {
            SemaClassType base = bases.get(0)
            if needsFieldInit(base) {
                pointer baddr = obj
                if isStruct == false && base.getClassKind() == SemaClassKind.STRUCT {
                    llvm.buildStructGEP2(b, structTy, obj, 1, "init.base", baddr)
                }
                if base.isFromHeader() {
                    callFieldInit(cge, base, baddr)
                } else {
                    emitFieldInits(cge, base, baddr, skip)
                }
            }
        }

        // `this` in an initializer is the object being made: the class instance
        // reads it from a slot of its own while the initializers are emitted.
        SemaClassInstance ti = cls.getThis()
        pointer savedThis = 0
        bool bound = false
        List<SemaClassAttribute> own = cls.getAttributeList()
        int i = 0
        while i < own.size() {
            SemaClassAttribute a = own.get(i)
            bool run = a.isStatic() == false
            if run {
                if skip != null {
                    if listHasName(skip, a.getName()) {
                        run = false
                    }
                }
            }
            SemaExpr init = null
            SemaClassType sc = null
            if run {
                init = a.getInitExpr()
                if init == null {
                    sc = inlineStructOf(a.getType())
                    if sc != null {
                        if needsFieldInit(sc) == false {
                            sc = null
                        }
                    }
                }
            }
            if init != null && cge.isTerminated() == false {
                if bound == false {
                    if ti != null {
                        savedThis = ti.getLlvmAlloca()
                        pointer slot
                        llvm.buildAlloca(b, cge.ptrType(), "init.this", slot)
                        llvm.buildStore(b, obj, slot)
                        ti.setLlvmAlloca(slot)
                    }
                    bound = true
                }
                SemaBinary asg = new SemaBinary(null, a, init, a.getType())
                CodeGenExprOps.assign(cge, asg)
                delete asg
            } elsif sc != null && cge.isTerminated() == false {
                pointer faddr
                llvm.buildStructGEP2(b, structTy, obj, fieldIndex(cls, a.getName()), "init.fld", faddr)
                if sc.isFromHeader() {
                    callFieldInit(cge, sc, faddr)
                } else {
                    emitFieldInits(cge, sc, faddr, null)
                }
            }
            i = i + 1
        }
        if bound {
            if ti != null {
                ti.setLlvmAlloca(savedThis)
            }
        }
    }

    public static bool listHasName(const List<string> names, const string name) {
        int i = 0
        while i < names.size() {
            if str.equals(names.get(i), name) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // staticInitValue — the initial value of a static field's global: its folded
    // initializer (SemaConstFold) as a constant of the field's LLVM type, or zero.
    public static pointer staticInitValue(const CodeGenModule cgm, const SemaClassAttribute sa, const pointer gty) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        SemaConstValue cv = sa.getConstInit()
        SemaType ft = sa.getType()
        pointer v
        if cv == null || ft == null {
            llvm.constNull(gty, v)
            return v
        }
        SemaConstKind k = cv.getKind()
        if k == SemaConstKind.CONST_INT {
            if ft.isFloat() {
                llvm.constRealOfString(gty, str.concat(str.convertL(cv.getInt()), ".0"), v)
            } else {
                // an odd integer rank is signed (SemaIntType.isUnsigned)
                bool signed = true
                if ft.isInteger() {
                    signed = ft.getRank() % 2 == 1
                }
                llvm.constInt(gty, cv.getInt(), signed, v)
            }
        } elsif k == SemaConstKind.CONST_FLOAT {
            llvm.constRealOfString(gty, cv.getText(), v)
        } elsif k == SemaConstKind.CONST_BOOL {
            long bv = 0
            if cv.getBool() {
                bv = 1
            }
            llvm.constInt(gty, bv, false, v)
        } elsif k == SemaConstKind.CONST_STRING {
            string sv = cv.getText()
            pointer g = cg.globalString(cgm.getModule(), cgm.getCtx(), sv)
            pointer i32len
            llvm.int32TypeInContext(cgm.getCtx(), i32len)
            pointer lenC
            llvm.constInt(i32len, str.len(sv), false, lenC)
            List<pointer> fields = new List<pointer>()
            fields.add(g)
            fields.add(lenC)
            cg.constNamedStructN(cgm.getStringTy(), fields, v)
        } else {
            llvm.constNull(gty, v)
        }
        return v
    }

    // buildVTable — emit `@vtable.<ns>.<Class> = constant [N x ptr] [null, m0, …]`.
    // emitInitCtor — define `ptr <Id>.init_ctor(ptr obj)`: zero the instance then store
    // the vtable at slot 0, returning obj. The reference emits this per class; a program
    // constructing a HEADER class (a non-generic std class via its .fly.h stub) CALLS it
    // (genNew), so fly_std_lib.a must DEFINE it — else `undefined symbol <Id>.init_ctor`.
    // LinkOnceODR (weak) so a program that also compiles the class doesn't collide.
    public static void emitInitCtor(const CodeGenModule cgm, const SemaClassType cls) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        pointer b = cgm.getBuilder()
        pointer ptrTy = cgm.getTypes().ptrType()
        string icName = str.concat(refClassId(cls), ".init_ctor")
        List<pointer> ps = new List<pointer>()
        ps.add(ptrTy)
        pointer fty
        cg.functionTypeN(ptrTy, ps, false, fty)
        pointer fn
        llvm.getNamedFunction(cgm.getModule(), icName, fn)
        if fn == 0 {
            llvm.addFunction(cgm.getModule(), icName, fty, fn)
        }
        llvm.setLinkage(fn, 3)
        cgm.setWeakComdat(fn, icName)

        pointer entry
        llvm.appendBasicBlockInContext(cgm.getCtx(), fn, "entry", entry)
        llvm.positionBuilderAtEnd(b, entry)
        pointer obj
        llvm.getParam(fn, 0, obj)
        pointer structTy = cls.getLlvmStructType()
        pointer i8Ty
        llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
        pointer zeroVal
        llvm.constInt(i8Ty, 0, false, zeroVal)
        pointer szVal
        llvm.sizeOf(structTy, szVal)
        pointer memsetV
        llvm.buildMemSet(b, obj, zeroVal, szVal, 0, memsetV)
        pointer vtSlot
        llvm.buildStructGEP2(b, structTy, obj, 0, "vtslot", vtSlot)
        pointer vtable = cls.getLlvmVTable()
        llvm.buildStore(b, vtable, vtSlot)
        pointer ret
        llvm.buildRet(b, obj, ret)
    }

    public static void buildVTable(const CodeGenModule cgm, const SemaClassType cls) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()
        pointer ptrTy = types.ptrType()

        List<SemaClassMethod> ms = vmethods(cls)     // inherited slots + own (overrides in-place)
        List<pointer> slots = new List<pointer>()
        pointer nullSlot
        llvm.constPointerNull(ptrTy, nullSlot)
        slots.add(nullSlot)                     // slot 0: the itable directory, set below (null when none)
        int i = 0
        while i < ms.size() {
            SemaClassMethod m = ms.get(i)
            pointer f = m.getLlvmFn()
            slots.add(f)
            i = i + 1
        }

        // Interfaces: one ITABLE per implemented interface — the implementations
        // in the interface's own method order — and slot 0 of the vtable points to
        // a directory of (interface id, itable) pairs ending in (null, null).
        //
        // This replaced a module-global interface region (every interface at a
        // fixed slot past the largest class's methods). That only works inside
        // ONE object: a program and a library compiled separately computed
        // different regions, so an interface call across the boundary — a
        // program calling Reader.read on an object built by the std archive —
        // hit the wrong slot. The itable index depends only on the interface's
        // declaration and the id only on its qualified name, so both sides of
        // any boundary agree. See emitInterfaceFn for the lookup.
        List<SemaClassType> ifs = implementedInterfaces(cls)
        if ifs.size() > 0 {
            pointer i64Ty
            llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
            List<pointer> dir = new List<pointer>()
            int fi = 0
            while fi < ifs.size() {
                SemaClassType ifc = ifs.get(fi)
                List<SemaClassMethod> ims = vmethods(ifc)
                List<pointer> its = new List<pointer>()
                int im = 0
                while im < ims.size() {
                    SemaClassMethod idecl = ims.get(im)
                    // match the implementation by FULL SIGNATURE — by name the
                    // overloaded visitor methods would all hit the same entry
                    pointer ifn = nullSlot
                    int own = indexOfMethodSig(ms, idecl)
                    if own >= 0 {
                        SemaClassMethod impl = ms.get(own)
                        pointer implFn = impl.getLlvmFn()
                        if implFn != 0 {
                            ifn = implFn
                        }
                    }
                    its.add(ifn)
                    im = im + 1
                }
                pointer itInit
                cg.constArrayN(ptrTy, its, itInit)
                pointer itTy
                llvm.arrayType(ptrTy, (int)its.size(), itTy)
                string itName = str.concat(vtableName(cls), str.concat(".itable.", ifc.getName()))
                pointer itG
                llvm.addGlobal(cgm.getModule(), itTy, itName, itG)
                llvm.setInitializer(itG, itInit)
                llvm.setGlobalConstant(itG, true)
                if cls.getGenericTemplate() != null {
                    llvm.setLinkage(itG, 3)
                    cgm.setWeakComdat(itG, itName)
                }
                pointer idVal
                llvm.constInt(i64Ty, ifaceId(ifc), false, idVal)
                pointer idPtr
                llvm.constIntToPtr(idVal, ptrTy, idPtr)
                dir.add(idPtr)
                dir.add(itG)
                fi = fi + 1
            }
            dir.add(nullSlot)
            dir.add(nullSlot)
            pointer dirInit
            cg.constArrayN(ptrTy, dir, dirInit)
            pointer dirTy
            llvm.arrayType(ptrTy, (int)dir.size(), dirTy)
            string dirName = str.concat(vtableName(cls), ".itables")
            pointer dirG
            llvm.addGlobal(cgm.getModule(), dirTy, dirName, dirG)
            llvm.setInitializer(dirG, dirInit)
            llvm.setGlobalConstant(dirG, true)
            if cls.getGenericTemplate() != null {
                llvm.setLinkage(dirG, 3)
                cgm.setWeakComdat(dirG, dirName)
            }
            slots.set(0, dirG)
        }

        // Three entries sit BEFORE the address point, where an object's vtable pointer
        // points (the itable directory, slot 0):
        //   vt[-1]  the release entry `@__fly_destroy.<Class>` (CodeGenModule.destroyFn):
        //           `delete` and the last release of a `new shared` object call it,
        //           so destruction runs for the DYNAMIC class — every owning, holding
        //           and weak field of the real object, also through a base or an
        //           interface reference (fly-lang/fly#202);
        //   vt[-2]  the type info `{ ptr name, i64 size }` (fly-lang/fly#235 reports
        //           undeleted objects by class with it);
        //   vt[-3]  the magic word "FlyVTbl1": the end-of-main teardown trusts -2
        //           and -1 only when it is there, since an object of a class built
        //           by an earlier release (a package, the seed's archive) has a
        //           vtable without these entries.
        // Negative, so slot 0 and every method slot keep their index: a class built
        // by an earlier release (the seed, a package) still dispatches its methods.
        // An interface is never the dynamic class: both entries are null there.
        List<pointer> all = new List<pointer>()
        if cls.getClassKind() == SemaClassKind.INTERFACE {
            all.add(nullSlot)
            all.add(nullSlot)
            all.add(nullSlot)
        } else {
            all.add(vtableMagic(cgm))
            all.add(typeInfo(cgm, cls))
            all.add(cgm.destroyFn(cls))
        }
        int si = 0
        while si < slots.size() {
            all.add(slots.get(si))
            si = si + 1
        }

        pointer init
        cg.constArrayN(ptrTy, all, init)
        int n = (int)all.size()
        pointer arrTy
        llvm.arrayType(ptrTy, n, arrTy)
        pointer g
        llvm.addGlobal(cgm.getModule(), arrTy, vtableName(cls), g)
        llvm.setInitializer(g, init)
        llvm.setGlobalConstant(g, true)
        // A generic-class specialization's vtable is emitted per-object; weak linkage
        // (LinkOnceODR = 3) merges duplicates across a program + fly_std_lib.a.
        // The comdat makes the dedup real on COFF too (no weak defs there).
        if cls.getGenericTemplate() != null {
            llvm.setLinkage(g, 3)
            cgm.setWeakComdat(g, vtableName(cls))
        }
        // the address point: element 3, past the three entries above
        pointer i64Ty
        llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
        pointer zero
        llvm.constInt(i64Ty, 0, false, zero)
        pointer three
        llvm.constInt(i64Ty, 3, false, three)
        List<pointer> apIdx = new List<pointer>()
        apIdx.add(zero)
        apIdx.add(three)
        pointer ap
        cg.constInBoundsGEP2N(arrTy, g, apIdx, ap)
        cls.setLlvmVTable(ap)
    }

    // displayName — the class as the teardown report prints it: the dotted
    // namespace (none in the default one), the name, and a specialization's type
    // arguments (`fly.data.List<string>`).
    public static string displayName(const SemaClassType cls) {
        string qual = cls.getName()
        SemaModule m = cls.getModule()
        if m != null {
            ASTModule am = m.getAST()
            if am != null {
                ASTNameSpace ns = am.getNameSpace()
                if ns != null {
                    List<ASTName> names = ns.getNames()
                    string dotted = ""
                    int i = 0
                    while i < names.size() {
                        if i > 0 {
                            dotted = str.concat(dotted, ".")
                        }
                        dotted = str.concat(dotted, names.get(i).getName())
                        i = i + 1
                    }
                    if str.len(dotted) > 0 {
                        qual = str.concat(dotted, str.concat(".", qual))
                    }
                }
            }
        }
        List<SemaType> args = cls.getTypeArgs()
        if args != null {
            if args.size() > 0 {
                string list = ""
                int j = 0
                while j < args.size() {
                    if j > 0 {
                        list = str.concat(list, ", ")
                    }
                    SemaType ta = args.get(j)
                    SemaClassType tc = ta.asClass()
                    if tc != null {
                        list = str.concat(list, displayName(tc))
                    } else {
                        list = str.concat(list, ta.str())
                    }
                    j = j + 1
                }
                qual = str.concat(qual, str.concat("<", str.concat(list, ">")))
            }
        }
        return qual
    }

    // vtableMagic — entry -3 of every class vtable: the 64-bit word "FlyVTbl1"
    // (little-endian bytes), as a pointer constant. The runtime's teardown
    // (runtime/lib/ObjHeap.fly) compares it before reading -2 and -1.
    public static pointer vtableMagic(const CodeGenModule cgm) {
        LLVM llvm = cgm.getCg().getLLVM()
        pointer i64Ty
        llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
        pointer mv
        llvm.constInt(i64Ty, 3561329519710792774, true, mv)
        pointer pv
        llvm.constIntToPtr(mv, cgm.getTypes().ptrType(), pv)
        return pv
    }

    // typeInfo — `@typeinfo.<ns>.<Class> = constant { ptr, i64 } { "<ns>.<Class>", size }`,
    // entry -2 of the class's vtable: the qualified name (just `<Class>` in the
    // default namespace) and the object size.
    public static pointer typeInfo(const CodeGenModule cgm, const SemaClassType cls) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        pointer ptrTy = cgm.getTypes().ptrType()
        pointer i64Ty
        llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
        string qual = displayName(cls)
        List<pointer> elems = new unique List<pointer>()
        elems.add(ptrTy)
        elems.add(i64Ty)
        pointer tiTy
        cg.structTypeN(cgm.getCtx(), elems, tiTy)
        pointer szVal
        llvm.sizeOf(cls.getLlvmStructType(), szVal)
        List<pointer> vals = new List<pointer>()
        vals.add(cgm.cstr(qual))
        vals.add(szVal)
        pointer tiInit
        cg.constNamedStructN(tiTy, vals, tiInit)
        string tiName = str.concat("typeinfo.", structName(cls))
        pointer ti
        llvm.addGlobal(cgm.getModule(), tiTy, tiName, ti)
        llvm.setInitializer(ti, tiInit)
        llvm.setGlobalConstant(ti, true)
        if cls.getGenericTemplate() != null {
            llvm.setLinkage(ti, 3)
            cgm.setWeakComdat(ti, tiName)
        }
        return ti
    }

    // ifaceId — an interface's identity in every itable directory: an FNV-1a-style
    // 64-bit hash of its namespace-qualified name. A hash rather than the address
    // of a global, so it is the same in every object and every DLL without any
    // linker cooperation. Never 0: (0, null) terminates a directory.
    public static long ifaceId(const SemaClassType iface) {
        string key = str.concat(SemaBuilder.classNsFlat(iface), str.concat(".", iface.getName()))
        long h = 1469598103934665603
        int n = str.len(key)
        int i = 0
        while i < n {
            byte kb = str.byteAt(key, i)
            int kc = kb & 255
            h = h ^ kc
            h = math.wrapMulL(h, 1099511628211)
            i = i + 1
        }
        if h == 0 {
            h = 1
        }
        return h
    }

    // ifaceMethodIndex — the entry of interface method `fn` in any itable of
    // `iface`: its position in the interface's own method order.
    public static int ifaceMethodIndex(const SemaClassType iface, const SemaFunctionBase fn) {
        List<SemaClassMethod> ims = vmethods(iface)
        int idx = indexOfMethodSig(ims, fn)
        if idx < 0 {
            idx = 0
        }
        return idx
    }

    // implementedInterfaces — every INTERFACE reachable through the base list
    // (all bases, recursively), deduplicated by name.
    public static List<SemaClassType> implementedInterfaces(const SemaClassType cls) {
        List<SemaClassType> r = new List<SemaClassType>()
        collectInterfaces(cls, r)
        return r
    }

    public static void collectInterfaces(const SemaClassType cls, List<SemaClassType> acc) {
        List<SemaClassType> bases = cls.getBaseClasses()
        int i = 0
        while i < bases.size() {
            SemaClassType b = bases.get(i)
            if b.getClassKind() == SemaClassKind.INTERFACE {
                bool seen = false
                int k = 0
                while k < acc.size() {
                    SemaClassType ak = acc.get(k)
                    if str.equals(ak.getName(), b.getName()) {
                        seen = true
                    }
                    k = k + 1
                }
                if seen == false {
                    acc.add(b)
                }
            }
            collectInterfaces(b, acc)
            i = i + 1
        }
    }

    // genMethodBody — entry + prologue (err=param0; this gets its own alloca from
    // param1; params from param2 are by-pointer) + body + ret void.
    public static void genMethodBody(const CodeGenModule cgm, const SemaClassType cls, const SemaClassMethod m) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()
        pointer b = cgm.getBuilder()
        pointer f = m.getLlvmFn()

        // Methods (incl. the constructor) of a GENERIC-CLASS specialization (List<string>,
        // Map<string,int>, …) can be emitted by multiple self-host objects (a program AND
        // fly_std_lib.a). Weak linkage (LinkOnceODR = 3) merges the duplicates. Mirrors the
        // reference weak-linkage fix; keyed on the class being a specialization. The
        // comdat makes the dedup real on COFF too (no weak defs there).
        if cls.getGenericTemplate() != null {
            llvm.setLinkage(f, 3)
            cgm.setWeakComdat(f, methodMangle(cgm, cls, m))
        }

        pointer entry
        llvm.appendBasicBlockInContext(cgm.getCtx(), f, "entry", entry)
        llvm.positionBuilderAtEnd(b, entry)
        CodeGenDebug dbg = cgm.getDebug()
        if dbg != null {
            dbg.beginFunction(m, f, false)
        }

        CodeGenExpr cge = new CodeGenExpr(cgm)
        pointer errParam
        llvm.getParam(f, 0, errParam)
        cge.setErrPtr(errParam)
        // per-function `lasterr` slot backing the implicit `error` variable
        pointer i32le
        llvm.int32TypeInContext(cgm.getCtx(), i32le)
        pointer leSlot
        llvm.buildAlloca(cgm.getBuilder(), i32le, "lasterr", leSlot)
        pointer leZero
        llvm.constInt(i32le, 0, true, leZero)
        llvm.buildStore(cgm.getBuilder(), leZero, leSlot)
        cge.setLastErrPtr(leSlot)

        // `this` is passed by value (the object pointer); store it into its own slot.
        pointer thisParam
        llvm.getParam(f, 1, thisParam)
        pointer ptrTy = types.ptrType()
        pointer thisSlot
        llvm.buildAlloca(b, ptrTy, "this", thisSlot)
        llvm.buildStore(b, thisParam, thisSlot)
        SemaClassInstance ti = m.getThis()
        if ti != null {
            ti.setLlvmAlloca(thisSlot)
        }

        List<SemaParam> params = m.getParams()
        int i = 0
        while i < params.size() {
            SemaParam pm = params.get(i)
            pointer arg
            llvm.getParam(f, i + 2, arg)
            // CONST CLASS/INTERFACE/STRUCT params arrive BY VALUE (like `this`); bind them
            // through a fresh local slot so body loads read the object, not *object.
            // Everything else keeps the incoming pointer as storage. Mirrors
            // CodeGenModule.genBody + the reference ABI (see CodeGenCall).
            SemaType pty = pm.getType()
            bool byValueHandle = false
            if pm.isConstant() {
                SemaClassType pcls = null
                if pty != null {
                    pcls = pty.asClass()
                }
                if pcls != null {
                    byValueHandle = true
                }
            }
            if byValueHandle {
                pointer pslot
                llvm.buildAlloca(b, ptrTy, "pval", pslot)
                llvm.buildStore(b, arg, pslot)
                pm.setLlvmAlloca(pslot)
            } else {
                pm.setLlvmAlloca(arg)
            }
            i = i + 1
        }
        if dbg != null {
            dbg.declareThis(cls, m, thisSlot)
            dbg.declareParams(params, 1)
        }
        // NRVO needs the return slot here too. Sema decides the optimization per
        // function and DROPS the assignment at `return name`, so a method whose
        // slot was never bound would hand back nothing at all.
        int ri = 0
        while ri < params.size() {
            if params.get(ri).isSynthetic() {
                cge.setReturnSlotArg(params.get(ri).getLlvmAlloca())
            }
            ri = ri + 1
        }
        CodeGenTrace.emitEnter(cgm, cge, cls, m)

        SemaBlockStmt body = m.getBody()
        if body != null {
            body.accept(cge)
        }
        if cge.isTerminated() == false {
            CodeGenTrace.emitExit(cge)
            pointer ret
            llvm.buildRetVoid(b, ret)
        }
        if dbg != null {
            dbg.endFunction()
        }
    }

    // emitDefaultInstance — one `new C()` with NO arguments, returning the object
    // pointer. The same sequence genNew performs, minus everything that only a
    // written `new` needs (argument coercion, by-value handle params, struct
    // stack allocation): a sized array of classes builds its elements with the
    // no-argument constructor and nothing else.
    //
    // Returns 0 when the class cannot be instantiated — no materialized struct
    // type, or no no-argument constructor. Sema rejects those at the declaration
    // (err_sema_array_class_no_default_ctor), so reaching here means the program
    // was already diagnosed and the caller simply emits nothing.
    public static pointer emitDefaultInstance(const CodeGenExpr cge, const SemaClassType cls) {
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        pointer structTy = cls.getLlvmStructType()
        if structTy == 0 {
            return 0
        }
        SemaClassMethod ctor = cls.getDefaultConstructor()

        pointer obj = allocObject(cge, structTy)

        if cls.isFromHeader() {
            // Header classes follow the reference protocol: the archive-defined
            // `<Id>.init_ctor` wires the vtable and the field defaults.
            string icName = str.concat(refClassId(cls), ".init_ctor")
            pointer icFn
            llvm.getNamedFunction(cgm.getModule(), icName, icFn)
            pointer ptrTy2 = cge.ptrType()
            List<pointer> icParams = new List<pointer>()
            icParams.add(ptrTy2)
            pointer icTy
            cg.functionTypeN(ptrTy2, icParams, false, icTy)
            if icFn == 0 {
                llvm.addFunction(cgm.getModule(), icName, icTy, icFn)
            }
            List<pointer> icArgs = new List<pointer>()
            icArgs.add(obj)
            pointer icV
            cg.buildCallN(b, icTy, icFn, icArgs, "", icV)
        } else {
            // Zero the instance so fields the constructor leaves alone are
            // deterministic (Windows malloc returns garbage, Linux zeroes).
            pointer i8Ty
            llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
            pointer zeroVal
            llvm.constInt(i8Ty, 0, false, zeroVal)
            pointer szVal
            llvm.sizeOf(structTy, szVal)
            pointer memsetV
            llvm.buildMemSet(b, obj, zeroVal, szVal, 0, memsetV)
            pointer vtSlot
            llvm.buildStructGEP2(b, structTy, obj, 0, "anew.vtslot", vtSlot)
            pointer vtable = cls.getLlvmVTable()
            llvm.buildStore(b, vtable, vtSlot)
        }

        // A failing initializer or constructor releases the half-built element,
        // as for `new` (emitFailedNew), then goes on to the caller's exit: the
        // array's own fail block, which releases the elements built before it
        // (fly-lang/fly#257).
        bool initFields = needsFieldInit(cls)
        pointer savedSafe = cge.getHandleSafe()
        pointer savedDepth = cge.getHandleDepth()
        pointer failBB = 0
        if initFields || ctor != null {
            if cge.getErrPtr() != 0 {
                failBB = cge.newBlock("anew.efail")
                cge.setHandleSafe(failBB)
                cge.setHandleDepth(cge.getFrameDepth())
            }
        }

        if initFields {
            callFieldInit(cge, cls, obj)
        }

        if ctor != null {
            pointer cf = ctor.getLlvmFn()
            if cf != 0 {
                List<pointer> cargs = new List<pointer>()
                cargs.add(cge.getErrPtr())
                cargs.add(obj)
                pointer cty = ctor.getLlvmFnType()
                pointer cv
                cg.buildCallN(b, cty, cf, cargs, "", cv)
                CodeGenError.propagate(cge)
            }
        }
        cge.setHandleSafe(savedSafe)
        cge.setHandleDepth(savedDepth)
        if failBB != 0 {
            emitFailedNew(cge, cls, obj, 0, failBB)
        }
        return obj
    }

    // genNew — `new C(args)`: malloc the struct, store the vtable pointer, run the
    // constructor (errPtr, this, args…). The expression's value is the object ptr.
    public static void genNew(const CodeGenExpr cge, const SemaCall node) {
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        SemaType t = node.getType()
        SemaClassType cls = t.asClass()
        pointer structTy = cls.getLlvmStructType()

        // Defensive guard (audit V2): a class that was never materialized (header
        // import, raw generic template) has structTy == 0; passing it to
        // LLVMBuildMalloc segfaults inside libLLVM. Sema rejects these upstream —
        // if one still slips through, report and yield a null pointer instead.
        if structTy == 0 {
            io.printErrLn(str.concat(str.concat("error: cannot instantiate class '", cls.getName()),
                    "': no materialized LLVM struct type"))
            pointer nullObj
            llvm.constPointerNull(cge.ptrType(), nullObj)
            node.setLlvmValue(nullObj)
            return
        }

        // STRUCTs are STACK objects with no vtable (reference ABI): alloca + zero,
        // no vtable store, and — for HEADER structs — no constructor call either
        // (the archive defines none; alloca+zero IS the reference behaviour).
        // HEADER classes follow the reference protocol instead: malloc +
        // `<Id>.init_ctor(obj)` (archive-defined; wires the REFERENCE vtable and
        // field defaults with the Itanium layout) + the mangled constructor.
        bool isStruct = cls.getClassKind() == SemaClassKind.STRUCT
        bool headerClass = false
        if isStruct == false {
            headerClass = cls.isFromHeader()
        }
        pointer obj
        if isStruct {
            llvm.buildAlloca(b, structTy, "sobj", obj)
        } elsif node.getAST().getCallKind() == ASTCallKind.CALL_NEW_SHARED {
            obj = allocShared(cge, structTy)
        } else {
            obj = allocObject(cge, structTy)
        }

        if headerClass {
            string icName = str.concat(refClassId(cls), ".init_ctor")
            pointer icFn
            llvm.getNamedFunction(cgm.getModule(), icName, icFn)
            pointer ptrTy2 = cge.ptrType()
            List<pointer> icParams = new List<pointer>()
            icParams.add(ptrTy2)
            pointer icTy
            cg.functionTypeN(ptrTy2, icParams, false, icTy)
            if icFn == 0 {
                llvm.addFunction(cgm.getModule(), icName, icTy, icFn)
            }
            List<pointer> icArgs = new List<pointer>()
            icArgs.add(obj)
            pointer icV
            cg.buildCallN(b, icTy, icFn, icArgs, "", icV)
        } else {
            // Zero the instance so fields the constructor does not assign are
            // deterministic across platforms (Windows malloc returns garbage;
            // Linux zeroes). Mirrors the reference's memset-after-malloc.
            pointer i8Ty
            llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
            pointer zeroVal
            llvm.constInt(i8Ty, 0, false, zeroVal)
            pointer szVal
            llvm.sizeOf(structTy, szVal)
            pointer memsetV
            llvm.buildMemSet(b, obj, zeroVal, szVal, 0, memsetV)

            if isStruct == false {
                pointer vtSlot
                llvm.buildStructGEP2(b, structTy, obj, 0, "vtslot", vtSlot)
                pointer vtable = cls.getLlvmVTable()
                llvm.buildStore(b, vtable, vtSlot)
            }
        }

        SemaFunctionBase ctor = node.getFunction()
        if isStruct {
            if cls.isFromHeader() {
                ctor = null
            }
        }

        // A failure from here on (a field initializer, a constructor argument,
        // the constructor) leaves a half-built object: every failure check
        // jumps to `new.fail`, which releases it before taking the exit the
        // check would have taken (fly-lang/fly#254).
        bool initFields = needsFieldInit(cls)
        // new.fail leaves no scope: the exit it then takes frees what that exit leaves
        pointer savedSafe = cge.getHandleSafe()
        pointer savedDepth = cge.getHandleDepth()
        pointer failBB = 0
        if initFields || ctor != null {
            if cge.getErrPtr() != 0 {
                failBB = cge.newBlock("new.fail")
                cge.setHandleSafe(failBB)
                cge.setHandleDepth(cge.getFrameDepth())
            }
        }

        // the field initializers, before any constructor (fly-lang/fly#243)
        if initFields {
            callFieldInit(cge, cls, obj)
        }

        if ctor != null {
            pointer cf = ctor.getLlvmFn()
            List<pointer> argAddrs = new List<pointer>()
            pointer err = cge.getErrPtr()
            argAddrs.add(err)
            argAddrs.add(obj)
            List<SemaExpr> args = node.getArgs()
            List<SemaParam> cparams = ctor.getParams()
            List<pointer> argTemps = new List<pointer>()
            int i = 0
            while i < args.size() {
                SemaExpr a = args.get(i)
                pointer av = cge.gen(a)
                // coerce to the CTOR PARAM's type and size the slot by it — a
                // literal `new Wrapper<long>(9999)` otherwise stores i32 into a
                // slot the callee reads as i64 (audit V4)
                SemaType aTy = a.getType()
                SemaType pTy = aTy
                bool cpConst = false
                if i < cparams.size() {
                    SemaParam cp = cparams.get(i)
                    SemaType cpt = cp.getType()
                    if cpt != null {
                        pTy = cpt
                    }
                    cpConst = cp.isConstant()
                }
                // A CONST CLASS/INTERFACE/STRUCT ctor arg is passed BY VALUE (the object
                // pointer), matching the reference ABI — the same rule as CodeGenCall.
                // Passing it by &temp made the archive ctor (e.g. Frontend(CompilerInstance))
                // store the temp's ADDRESS as `this.ci` → later virtual dispatch jumped to
                // garbage, and a `const StructType` ctor param reached a seed-built ctor as
                // a pointer to a pointer. Non-const params keep the by-pointer path.
                SemaClassType pcls = null
                if pTy != null {
                    pcls = pTy.asClass()
                }
                bool byValHandle = false
                if cpConst {
                    if pcls != null {
                        byValHandle = true
                    }
                }
                if cpConst {
                    CodeGenExprOps.noteArgTemp(argTemps, a, av)
                }
                if byValHandle {
                    argAddrs.add(av)
                } else {
                    pointer cvv = cge.coerce(av, aTy, pTy)
                    pointer aty = cge.lowerType(pTy)
                    pointer tmp
                    llvm.buildAlloca(b, aty, "arg", tmp)
                    llvm.buildStore(b, cvv, tmp)
                    argAddrs.add(tmp)
                }
                i = i + 1
            }
            pointer cty = ctor.getLlvmFnType()
            pointer cv
            cg.buildCallN(b, cty, cf, argAddrs, "", cv)
            CodeGenExprOps.freeArgTemps(cge, argTemps)
            CodeGenError.propagate(cge)
        }
        cge.setHandleSafe(savedSafe)
        cge.setHandleDepth(savedDepth)
        if failBB != 0 {
            int kind = 0
            if isStruct {
                kind = 2
            } elsif node.getAST().getCallKind() == ASTCallKind.CALL_NEW_SHARED {
                kind = 1
            }
            emitFailedNew(cge, cls, obj, kind, failBB)
        }
        // `new CLang("libm.so")` → register the -lm linker flag (bridge)
        if CodeGenBridge.isCLangClass(cls) {
            CodeGenBridge.captureCtorLib(cge, node)
        }
        node.setLlvmValue(obj)
    }

    // emitFailedNew — the body of `new.fail`, where every failure check of a
    // `new` jumps (genNew): the half-built `obj` is released, then the failure
    // goes on where the check would have sent it. `kind` is how it was made:
    // 0 the object heap (`new`, `new unique`), 1 `new shared` (a block with a
    // header in front), 2 a struct on the stack (no memory to give back).
    // The class's free() does NOT run: the object was never built. The fields
    // it owns, holds or observes already go — those the constructor did not
    // reach are still null. They are released with an error slot of their
    // own, so the pending failure neither stops nor is overwritten by them: what
    // they fail with is attached to it (fly-lang/fly#260).
    // An object that travels in the error (a method the constructor called
    // did `fail c, this`) belongs to the error: its `handle` deletes it.
    public static void emitFailedNew(const CodeGenExpr cge, const SemaClassType cls, const pointer obj, const int kind,
            const pointer failBB) {
        CodeGenModule cgm = cge.getCgm()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer ptrTy = cge.ptrType()
        pointer contBB
        llvm.getInsertBlock(b, contBB)
        bool wasTerminated = cge.isTerminated()

        cge.position(failBB)
        pointer errTy = cgm.getErrorTy()
        pointer errPtr = cge.getErrPtr()
        pointer exitBB = cge.newBlock("new.fail.exit")
        pointer relBB = cge.newBlock("new.fail.release")
        pointer eobj
        llvm.buildLoad2(b, ptrTy, cgm.errField(errPtr, 2, "nfo"), "nfobj", eobj)
        pointer notInError
        llvm.buildICmp(b, 33, eobj, obj, "nfown", notInError)   // NE
        pointer cbr
        llvm.buildCondBr(b, notInError, relBB, exitBB, cbr)

        cge.position(relBB)
        pointer relErr
        llvm.buildAlloca(b, errTy, "nferr", relErr)
        pointer zeroErr
        llvm.constNull(errTy, zeroErr)
        llvm.buildStore(b, zeroErr, relErr)
        cge.setErrPtr(relErr)
        CodeGenStmt.emitDeleteOwnedFields(cge, cls, obj)
        cge.setErrPtr(errPtr)
        // what they fail with is attached to the pending failure (fly-lang/fly#260)
        cgm.errMerge(errPtr, relErr)
        if kind == 0 {
            cgm.objFree(obj)
        } elsif kind == 1 {
            cgm.objFree(CodeGenStmt.sharedHeader(cge, obj))
        }
        cge.br(exitBB)

        cge.position(exitBB)
        CodeGenError.takeFailExit(cge)

        cge.position(contBB)
        cge.setTerminated(wasTerminated)
    }

    // methodCall — `obj.m(args)`: virtual dispatch through the receiver's vtable
    // (load vtable → GEP to the method's slot → indirect call), passing
    // (errPtr, obj, args…, [out]) and reloading the out slot as the call value.
    public static void methodCall(const CodeGenExpr cge, const SemaCall node) {
        // CLang FFI bridge: `<CLang>.call(sym, args[, out])` is intercepted at
        // compile time (direct C call) — the archive method is an empty stub.
        if CodeGenBridge.isBridgeCall(node) {
            CodeGenBridge.genCall(cge, node)
            return
        }
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenType types = cgm.getTypes()
        pointer ptrTy = types.ptrType()

        SemaFunctionBase fn = node.getFunction()
        SemaExpr parent = node.getParent()
        pointer objPtr = cge.gen(parent)
        SemaType pt = parent.getType()
        SemaClassType cls = pt.asClass()
        pointer structTy = cls.getLlvmStructType()
        if needsNullCheck(parent, cls) {
            string onWhat = str.concat("' on a null '", str.concat(cls.getName(), "'"))
            cge.nullCheck(objPtr, str.concat(str.concat("calling '", fn.getName()), onWhat))
        }

        // super calls dispatch DIRECT to the resolved base function — loading the
        // vtable would re-dispatch to the most-derived override (audit V4).
        // Everything else loads the vtable pointer (field 0 of the object):
        //   super / STRUCT  → DIRECT call (a base's own body / no vtable)
        //   CLASS receiver  → vtable[ its vmethods position + 1 ]
        //   INTERFACE receiver → the itable the vtable's directory holds for that
        //     interface, at the method's index within the interface (see
        //     buildVTable). Header-origin or not makes no difference: the
        //     archive behind a header was built by this compiler.
        bool direct = false
        if node.isSuper() {
            direct = true
        }
        if cls.getClassKind() == SemaClassKind.STRUCT {
            direct = true
        }
        pointer fnPtr
        if direct {
            fnPtr = fn.getLlvmFn()
        } else {
            pointer vtSlot
            llvm.buildStructGEP2(b, structTy, objPtr, 0, "vtslot", vtSlot)
            pointer vt
            llvm.buildLoad2(b, ptrTy, vtSlot, "vt", vt)
            // `table` is where the function pointer is read: the vtable itself,
            // or — for a native interface receiver — the itable that the object's
            // itable directory holds for that interface.
            pointer table = vt
            int slot = 0
            if cls.getClassKind() == SemaClassKind.INTERFACE {
                table = cgm.emitItableLookup(vt, ifaceId(cls))
                slot = ifaceMethodIndex(cls, fn)
            } else {
                slot = methodSlot(cls, fn)
            }
            pointer i64Ty
            llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
            pointer slotIdx
            llvm.constInt(i64Ty, slot, false, slotIdx)
            List<pointer> idxAddrs = new List<pointer>()
            idxAddrs.add(slotIdx)
            pointer fnSlot
            cg.buildGEP2N(b, ptrTy, table, idxAddrs, "vfnslot", fnSlot)
            llvm.buildLoad2(b, ptrTy, fnSlot, "vfn", fnPtr)
        }

        // arguments: errPtr, obj, real args…, out
        List<pointer> argAddrs = new List<pointer>()
        pointer err = cge.getErrPtr()
        argAddrs.add(err)
        argAddrs.add(objPtr)

        List<SemaExpr> args = node.getArgs()
        SemaLocalVar outVar = node.getOutVar()
        bool hasOut = outVar != null
        int realCount = (int)args.size()
        if hasOut {
            realCount = realCount - 1
        }
        List<SemaParam> mParams = fn.getParams()
        List<pointer> argTemps = new List<pointer>()
        int i = 0
        while i < realCount {
            SemaExpr a = args.get(i)

            // writable (non-const) param + variable arg → pass the original
            // storage address (out-params); otherwise copy + numeric coercion
            // to the param's type (audit V4 — mirrors CodeGenCall)
            bool passedDirect = false
            if i < mParams.size() {
                SemaParam mp = mParams.get(i)
                if mp.isConstant() == false {
                    if a.isVarExpr() {
                        pointer addr = cge.genAddr(a)
                        argAddrs.add(addr)
                        passedDirect = true
                    }
                }
            }
            if passedDirect == false {
                pointer av = cge.gen(a)
                SemaType aTy = a.getType()
                SemaType pTy = aTy
                bool mpConst = false
                if i < mParams.size() {
                    SemaParam mp2 = mParams.get(i)
                    SemaType mpt = mp2.getType()
                    if mpt != null {
                        pTy = mpt
                    }
                    mpConst = mp2.isConstant()
                }
                // A CONST CLASS/INTERFACE/STRUCT arg goes BY VALUE (the object pointer),
                // matching the reference ABI (same rule as CodeGenCall/genNew). Non-const
                // params keep the by-pointer path.
                SemaClassType mpcls = null
                if pTy != null {
                    mpcls = pTy.asClass()
                }
                bool mByVal = false
                if mpConst {
                    if mpcls != null {
                        mByVal = true
                    }
                }
                if mpConst {
                    CodeGenExprOps.noteArgTemp(argTemps, a, av)
                }
                if mByVal {
                    argAddrs.add(av)
                } else {
                    pointer sv = cge.coerce(av, aTy, pTy)
                    pointer aty = cge.lowerType(pTy)
                    pointer tmp
                    llvm.buildAlloca(b, aty, "arg", tmp)
                    llvm.buildStore(b, sv, tmp)
                    argAddrs.add(tmp)
                }
            }
            i = i + 1
        }
        pointer outPtr = 0
        if hasOut {
            SemaType ot2 = outVar.getType()
            pointer oty = cge.lowerType(ot2)
            llvm.buildAlloca(b, oty, "callout", outPtr)
            // CLASS-kind results: pre-allocate the target the callee writes
            // through (reference out convention — mirrors CodeGenCall)
            SemaClassType oc2 = null
            if ot2 != null {
                oc2 = ot2.asClass()
            }
            if oc2 != null {
                pointer sty2 = oc2.getLlvmStructType()
                if sty2 != 0 {
                    // a class result: the callee stores its object's pointer
                    // into the slot, null until it does (a failing callee
                    // leaves it null)
                    pointer target2
                    if oc2.getClassKind() == SemaClassKind.STRUCT {
                        llvm.buildAlloca(b, sty2, "outobj", target2)
                    } else {
                        llvm.constPointerNull(cge.ptrType(), target2)
                    }
                    llvm.buildStore(b, target2, outPtr)
                }
            }
            outVar.setLlvmAlloca(outPtr)
            argAddrs.add(outPtr)
        }

        pointer fnTy = fn.getLlvmFnType()
        pointer cv
        cg.buildCallN(b, fnTy, fnPtr, argAddrs, "", cv)
        CodeGenExprOps.freeArgTemps(cge, argTemps)
        CodeGenError.propagate(cge)
        if hasOut {
            pointer oty2 = cge.lowerType(outVar.getType())
            pointer loaded
            llvm.buildLoad2(b, oty2, outPtr, "callres", loaded)
            node.setLlvmValue(loaded)
            CodeGenExprOps.markOwnedResult(node, outVar.getType())
        }
    }

    // member — `obj.field`: GEP to the field slot; load it (rvalue) or return its
    // address (addrMode, for an assignment LHS).
    public static void member(const CodeGenExpr cge, const SemaMember node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        // Capture addrMode BEFORE gen(parent) — gen() resets it to rvalue mode.
        bool addr = cge.isAddrMode()
        // STATIC field `ClassName.field` (B030): no receiver — the storage is
        // the module global created at declareStruct (riding the attribute's
        // llvmAlloca). addr mode hands out the global pointer for assignment.
        SemaClassAttribute sattr = node.getStaticAttr()
        if sattr != null {
            SemaClassType scls = sattr.getClass()
            if scls.getLlvmStructType() == 0 {
                declareStruct(cge.getCgm(), scls)
            }
            pointer g = sattr.getLlvmAlloca()
            if addr {
                node.setLlvmValue(g)
            } else {
                pointer sfty = cge.lowerType(sattr.getType())
                pointer sfv
                llvm.buildLoad2(b, sfty, g, "sfld", sfv)
                node.setLlvmValue(sfv)
            }
            return
        }
        SemaExpr parent = node.getParent()
        pointer objPtr = cge.gen(parent)
        SemaType pt = parent.getType()
        SemaClassType cls = pt.asClass()
        pointer structTy = cls.getLlvmStructType()

        ASTMember mast = node.getAST()
        string fname = mast.getName()
        if needsNullCheck(parent, cls) {
            string ofWhat = str.concat("' of a null '", str.concat(cls.getName(), "'"))
            cge.nullCheck(objPtr, str.concat(str.concat("accessing field '", fname), ofWhat))
        }
        int idx = fieldIndex(cls, fname)
        pointer fldPtr
        llvm.buildStructGEP2(b, structTy, objPtr, idx, "fld", fldPtr)

        if addr {
            node.setLlvmValue(fldPtr)
        } else {
            SemaClassAttribute a = cls.LookupAttribute(fname)
            SemaType at = a.getType()
            SemaClassType ac = at.asClass()
            if ac != null {
                if ac.getClassKind() == SemaClassKind.STRUCT {
                    // STRUCT field: the aggregate lives INLINE in the object
                    // (fieldLlvmType) and a struct VALUE is a pointer to its
                    // storage — the slot address IS the value; loading would
                    // read the first field bytes as a pointer.
                    node.setLlvmValue(fldPtr)
                    return
                }
            }
            pointer fty = cge.lowerType(a.getType())
            pointer loaded
            llvm.buildLoad2(b, fty, fldPtr, "fldv", loaded)
            // a weak field reads as the object only while it lives
            if a.isWeakRef() {
                loaded = CodeGenStmt.emitWeakGet(cge, loaded)
            }
            node.setLlvmValue(loaded)
        }
    }

    // structValue — `{name = expr, ...}` literal (B029): fresh zeroed alloca of
    // the struct type, one store per named field, and the SLOT POINTER is the
    // value (a struct value is a pointer to its storage; the decl/assign path
    // clones it via cloneIfStruct, keeping value semantics). Field stores follow
    // the member() rules: inline STRUCT fields memcpy from the nested literal's
    // slot, strings clone-on-store, scalars coerce to the field type.
    public static void structValue(const CodeGenExpr cge, const SemaStructValue node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        SemaType t = node.getType()
        SemaClassType ct = t.asClass()
        pointer sty = ct.getLlvmStructType()
        pointer slot
        llvm.buildAlloca(b, sty, "slit", slot)
        pointer zv
        llvm.constNull(sty, zv)
        llvm.buildStore(b, zv, slot)

        List<string> names = node.getNames()
        List<SemaExpr> exprs = node.getExprs()
        // the struct's initializers, for the fields the literal does not give
        // (fly-lang/fly#243); a header struct's routine runs them all
        if needsFieldInit(ct) {
            if ct.isFromHeader() {
                callFieldInit(cge, ct, slot)
            } else {
                emitFieldInits(cge, ct, slot, names)
            }
        }
        int i = 0
        while i < names.size() {
            string nm = names.get(i)
            SemaExpr fe = exprs.get(i)
            SemaClassAttribute a = ct.LookupAttribute(nm)
            if a != null {
                int idx = fieldIndex(ct, nm)
                pointer fp
                llvm.buildStructGEP2(b, sty, slot, idx, "slitf", fp)
                pointer v = cge.gen(fe)
                SemaType at = a.getType()
                bool inlineStruct = false
                SemaClassType ac = null
                if at != null {
                    ac = at.asClass()
                }
                if ac != null {
                    if ac.getClassKind() == SemaClassKind.STRUCT {
                        inlineStruct = true
                    }
                }
                if inlineStruct {
                    pointer fsty = ac.getLlvmStructType()
                    pointer szV
                    llvm.sizeOf(fsty, szV)
                    pointer mcv
                    llvm.buildMemCpy(b, fp, v, szV, mcv)
                } else {
                    v = cge.coerce(v, fe.getType(), at)
                    if fe.isOwnedStrTemp() == false {
                        v = CodeGenIntrinsics.cloneIfString(cge, v, at)
                    }
                    llvm.buildStore(b, v, fp)
                }
            }
            i = i + 1
        }
        node.setLlvmValue(slot)
    }

    // ── name + index helpers ──────────────────────────────────────────────────

    // fieldIndex — slot index of a field.
    //   CLASS:  1 + position in the FLATTENED list (slot 0 = vtable) — inherited
    //           fields included, which the old header layout could not reach;
    //   STRUCT: plain position (no vtable slot).
    // allocObject — memory for a class object, from the runtime's object heap
    // (fly-lang/fly#235): what `new` and `new unique` allocate; not zeroed.
    public static pointer allocObject(const CodeGenExpr cge, const pointer structTy) {
        pointer szVal
        cge.getLLVM().sizeOf(structTy, szVal)
        return cge.getCgm().objAlloc(szVal, 0)
    }

    // allocShared — memory for a `new shared` object: a 16-byte header (strong count
    // 1, weak count 0) followed by the object, whose address is returned. Freed
    // from the header by the last release (CodeGenStmt.emitReleaseBody).
    public static pointer allocShared(const CodeGenExpr cge, const pointer structTy) {
        CodeGenModule cgm = cge.getCgm()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer i8Ty
        llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
        pointer i64Ty
        llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
        pointer objSize
        llvm.sizeOf(structTy, objSize)
        pointer sixteen
        llvm.constInt(i64Ty, 16, false, sixteen)
        pointer total
        llvm.buildAdd(b, objSize, sixteen, "shsize", total)
        pointer hdr = cgm.objAlloc(total, 1)
        pointer one
        llvm.constInt(i64Ty, 1, false, one)
        llvm.buildStore(b, one, hdr)
        pointer eight
        llvm.constInt(i64Ty, 8, false, eight)
        List<pointer> wIdx = new List<pointer>()
        wIdx.add(eight)
        pointer weakP
        cgm.getCg().buildGEP2N(b, i8Ty, hdr, wIdx, "shweak", weakP)
        pointer zero
        llvm.constInt(i64Ty, 0, false, zero)
        llvm.buildStore(b, zero, weakP)
        List<pointer> oIdx = new List<pointer>()
        oIdx.add(sixteen)
        pointer obj
        cgm.getCg().buildGEP2N(b, i8Ty, hdr, oIdx, "shobj", obj)
        return obj
    }

    // findFreeMethod — the class's `free()` with no parameters (its own or
    // inherited), which `delete` calls before releasing the object; null if the
    // class has none.
    public static SemaClassMethod findFreeMethod(const SemaClassType cls) {
        SemaClassMethod m = cls.LookupMethod("free")
        if m == null {
            return null
        }
        if m.getParams().size() != 0 {
            return null
        }
        return m
    }

    // callNoArgMethod — `obj.m()` for a method with no parameters and no result,
    // dispatched like methodCall does: through the vtable of a class, the itable of
    // an interface, directly for a struct. `obj` is known to be non-null.
    public static void callNoArgMethod(const CodeGenExpr cge, const SemaClassType cls, const SemaClassMethod m,
            const pointer obj) {
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer ptrTy = cgm.getTypes().ptrType()
        pointer fnPtr = 0
        if cls.getClassKind() == SemaClassKind.STRUCT {
            fnPtr = m.getLlvmFn()
        } else {
            pointer vtSlot
            llvm.buildStructGEP2(b, cls.getLlvmStructType(), obj, 0, "vtslot", vtSlot)
            pointer vt
            llvm.buildLoad2(b, ptrTy, vtSlot, "vt", vt)
            pointer table = vt
            int slot = 0
            if cls.getClassKind() == SemaClassKind.INTERFACE {
                table = cgm.emitItableLookup(vt, ifaceId(cls))
                slot = ifaceMethodIndex(cls, m)
            } else {
                slot = methodSlot(cls, m)
            }
            pointer i64Ty
            llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
            pointer slotIdx
            llvm.constInt(i64Ty, slot, false, slotIdx)
            List<pointer> idx = new List<pointer>()
            idx.add(slotIdx)
            pointer fnSlot
            cg.buildGEP2N(b, ptrTy, table, idx, "vfnslot", fnSlot)
            llvm.buildLoad2(b, ptrTy, fnSlot, "vfn", fnPtr)
        }
        List<pointer> args = new List<pointer>()
        args.add(cge.getErrPtr())
        args.add(obj)
        pointer cv
        cg.buildCallN(b, m.getLlvmFnType(), fnPtr, args, "", cv)
    }

    // needsNullCheck — does reading through this receiver need the null trap?
    // Not for `this`, which the caller already checked before the call, and not
    // for a STRUCT, a value whose variable always points at its own storage.
    // Every CLASS and INTERFACE reference may be null and is checked.
    public static bool needsNullCheck(const SemaExpr receiver, const SemaClassType cls) {
        if receiver.getKind() == SemaKind.INSTANCE_VAR {
            return false
        }
        if cls.getClassKind() == SemaClassKind.STRUCT {
            return false
        }
        return true
    }

    public static int fieldIndex(const SemaClassType cls, const string name) {
        int base = 1
        if cls.getClassKind() == SemaClassKind.STRUCT {
            base = 0
        }
        List<SemaClassAttribute> attrs = allAttributes(cls)
        int i = 0
        while i < attrs.size() {
            SemaClassAttribute a = attrs.get(i)
            if str.equals(a.getName(), name) {
                return i + base
            }
            i = i + 1
        }
        return base
    }

    // methodSlot — vtable slot of a method: 1 + its position in the FLATTENED
    // virtual-method list. Overrides keep the base's slot (vmethods replaces
    // in-place), so a base-typed dispatch and a derived object agree on the slot.
    public static int methodSlot(const SemaClassType cls, const SemaFunctionBase fn) {
        List<SemaClassMethod> ms = vmethods(cls)
        int slot = indexOfMethodSig(ms, fn)
        if slot >= 0 {
            return slot + 1
        }
        return 1
    }

    // allAttributes — every field, base classes first then own, in declaration
    // order (single-inheritance flattened layout; first base only for now).
    public static List<SemaClassAttribute> allAttributes(const SemaClassType cls) {
        List<SemaClassAttribute> r = new List<SemaClassAttribute>()
        List<SemaClassType> bases = cls.getBaseClasses()
        if bases.size() > 0 {
            SemaClassType base = bases.get(0)
            List<SemaClassAttribute> ba = allAttributes(base)
            int i = 0
            while i < ba.size() {
                r.add(ba.get(i))
                i = i + 1
            }
        }
        List<SemaClassAttribute> own = cls.getAttributeList()
        int j = 0
        while j < own.size() {
            r.add(own.get(j))
            j = j + 1
        }
        return r
    }

    // vmethods — the effective virtual method per vtable slot: start from the base's
    // slots, then for each own (non-constructor) method, replace the inherited slot
    // of the same name (override) or append a new slot. This keeps slot indices
    // stable across the hierarchy so single-vtable dispatch is correct.
    public static List<SemaClassMethod> vmethods(const SemaClassType cls) {
        List<SemaClassMethod> r = new List<SemaClassMethod>()
        List<SemaClassType> bases = cls.getBaseClasses()
        if bases.size() > 0 {
            SemaClassType base = bases.get(0)
            List<SemaClassMethod> bm = vmethods(base)
            int i = 0
            while i < bm.size() {
                r.add(bm.get(i))
                i = i + 1
            }
        }
        List<SemaClassMethod> own = cls.getMethodList()
        int j = 0
        while j < own.size() {
            SemaClassMethod m = own.get(j)
            if m.isConstructor() {
                // reference parity: constructors occupy their own vtable slot in
                // declaration order (never override) so the self-host layout is
                // index-compatible with an archive-built (reference) vtable.
                r.add(m)
            } else {
                // an OVERRIDE has the same full signature; a same-name OVERLOAD
                // (visit(A)/visit(B)) gets its OWN slot
                int slot = indexOfMethodSig(r, m)
                if slot >= 0 {
                    r.set(slot, m)
                } else {
                    r.add(m)
                }
            }
            j = j + 1
        }
        return r
    }

    public static int indexOfMethodName(const List<SemaClassMethod> ms, const string name) {
        int i = 0
        while i < ms.size() {
            SemaClassMethod m = ms.get(i)
            if str.equals(m.getName(), name) {
                return i
            }
            i = i + 1
        }
        // -1 sentinel built through an int var: a literal `0 - 1` fold is typed
        // i8 by the bootstrap and this value feeds vtable slot layout (methodSlot
        // / vmethods `if slot >= 0`) — a mis-widened 255 would index out of bounds.
        int notFound = 0
        notFound = notFound - 1
        return notFound
    }

    // sameSignature — overload-aware method identity: same name AND same parameter
    // type list, compared by type NAME (the synthetic out param is part of the list
    // and matches naturally). NAME-ONLY matching collapsed the ~50 `visit(...)`
    // overloads of the AST/Sema visitors into one vtable slot, so a stage-3
    // compiler (compiled by the self-host) dispatched every visit to the LAST
    // overload — empty resolution, wrong probes, visitor segfaults.
    public static bool sameSignature(const SemaFunctionBase a, const SemaFunctionBase b) {
        if str.equals(a.getName(), b.getName()) == false {
            return false
        }
        List<SemaParam> pa = a.getParams()
        List<SemaParam> pb = b.getParams()
        if pa.size() != pb.size() {
            return false
        }
        int i = 0
        while i < pa.size() {
            SemaType ta = pa.get(i).getType()
            SemaType tb = pb.get(i).getType()
            string na = ""
            string nb = ""
            if ta != null {
                na = ta.getName()
            }
            if tb != null {
                nb = tb.getName()
            }
            if str.equals(na, nb) == false {
                return false
            }
            i = i + 1
        }
        return true
    }

    // indexOfMethodSig — position of the method matching `probe`'s full signature
    // (same -1 sentinel discipline as indexOfMethodName).
    public static int indexOfMethodSig(const List<SemaClassMethod> ms, const SemaFunctionBase probe) {
        int i = 0
        while i < ms.size() {
            SemaClassMethod m = ms.get(i)
            if sameSignature(m, probe) {
                return i
            }
            i = i + 1
        }
        int notFound = 0
        notFound = notFound - 1
        return notFound
    }

    // className — the disambiguating name: a generic specialization carries a mangled
    // name (e.g. "Wrapper_int") so its struct/methods don't collide with sibling
    // specializations (which all share the template's simple getName()).
    public static string className(const SemaClassType cls) {
        string mn = cls.getMangledName()
        if str.isEmpty(mn) == false {
            return mn
        }
        return cls.getName()
    }

    public static string structName(const SemaClassType cls) {
        SemaModule mod = cls.getModule()
        string nsn = ""
        if mod != null {
            SemaNameSpace ns = mod.getNameSpace()
            if ns != null {
                nsn = ns.getName()
            }
        }
        string a = str.concat(nsn, ".")
        return str.concat(a, className(cls))
    }

    public static string vtableName(const SemaClassType cls) {
        string a = str.concat("vtable.", structName(cls))
        return a
    }

    // methodMangle — `<Class>` + the standard function mangling of the method
    // (which already starts with `_F…`): `FileWriter_F9fly_os_io5write…`, exactly
    // the reference's scheme, so header-class methods link against the archive.
    public static string methodMangle(const CodeGenModule cgm, const SemaClassType cls, const SemaClassMethod m) {
        string pfx = className(cls)
        string body = cgm.mangleMethod(m)
        return str.concat(pfx, body)
    }
}
