namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenBridge
import fly.compiler.codegen.CodeGenLLVM
import fly.compiler.codegen.CodeGenType
import llvm.api.*
import fly.mem
import fly.data.List
import fly.str
import fly.os.io

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenClass — class lowering (Stage 5a: single classes, no inheritance yet).
// Layout mirrors the reference compiler: every object is `{ ptr vtable, fields… }`
// (the vtable pointer at slot 0, attributes from slot 1 in declaration order).
// Each class gets a vtable global `[null, method0, method1, …]` (methodList order);
// instance method calls dispatch through it (vtable load → slot GEP → indirect
// call). Methods lower to `void (errPtr, this, params…, [out])`; `this` is a real
// object pointer passed by value (so it gets its own alloca, unlike by-pointer
// params). Inheritance / base subobjects / this-adjusting thunks: Stage 5b.
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenClass {

    public CodeGenClass() { }

    // declareStruct — create the named LLVM struct type.
    //   native CLASS:  { ptr vtable, flattened fields… }          (flat model)
    //   STRUCT:        { fields… }                                 (reference ABI)
    //   HEADER class:  { ptr vtable, base subobjects…, own fields }(reference
    //                   Itanium-style layout — these objects cross the archive
    //                   boundary, so field offsets must match the reference)
    public static void declareStruct(const CodeGenModule cgm, const SemaClassType cls) {
        if cls.getLlvmStructType() != 0 { return }   // already declared (recursion)
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()

        string sname = structName(cls)
        pointer st
        llvm.structCreateNamed(cgm.getCtx(), sname, st)
        cls.setLlvmStructType(st)

        List<pointer> fieldTys = new List<pointer>()
        bool isStruct = cls.getClassKind() == SemaClassKind.STRUCT
        if isStruct == false {
            pointer vtp = types.ptrType()
            fieldTys.add(vtp)                   // slot 0: vtable pointer
        }
        if cls.isFromHeader() && isStruct == false {
            // base subobjects BY VALUE (reference layout), then OWN fields only
            List<SemaClassType> hb = cls.getBaseClasses()
            int bi = 0
            while bi < hb.size() {
                SemaClassType hbase = hb.get(bi)
                if hbase.getClassKind() != SemaClassKind.STRUCT {
                    declareStruct(cgm, hbase)
                    fieldTys.add(hbase.getLlvmStructType())
                }
                bi = bi + 1
            }
            List<SemaClassAttribute> own = cls.getAttributeList()
            int oi = 0
            while oi < own.size() {
                SemaClassAttribute oa = own.get(oi)
                pointer ofty = types.lowerType(oa.getType())
                fieldTys.add(ofty)
                oi = oi + 1
            }
        } else {
            List<SemaClassAttribute> attrs = allAttributes(cls)   // base fields first, then own
            int i = 0
            while i < attrs.size() {
                SemaClassAttribute a = attrs.get(i)
                pointer fty = types.lowerType(a.getType())
                fieldTys.add(fty)
                i = i + 1
            }
        }
        cg.structSetBodyN(st, fieldTys, false)
    }

    // nonStructBaseCount — subobject slots a HEADER class's own fields sit after.
    public static int nonStructBaseCount(const SemaClassType cls) {
        int n = 0
        List<SemaClassType> bs = cls.getBaseClasses()
        int i = 0
        while i < bs.size() {
            SemaClassType b = bs.get(i)
            if b.getClassKind() != SemaClassKind.STRUCT { n = n + 1 }
            i = i + 1
        }
        out = n
    }

    // refClassId — the reference codegen's class Id (`io.FileWriter`): LAST
    // namespace segment + "." + class name. Used to reference archive-defined
    // helpers like `<Id>.init_ctor` for header classes.
    public static string refClassId(const SemaClassType cls) {
        SemaModule mod = cls.getModule()
        string nsn = ""
        if mod != null {
            SemaNameSpace ns = mod.getNameSpace()
            if ns != null { nsn = ns.getName() }
        }
        int dot = str.lastIndexOf(nsn, ".")
        if dot >= 0 {
            int L = str.len(nsn)
            string seg = str.substring(nsn, dot + 1, L)
            string a = str.concat(seg, ".")
            out = str.concat(a, className(cls))
            return
        }
        string b2 = str.concat(nsn, ".")
        out = str.concat(b2, className(cls))
    }

    // declareMethod — LLVM signature `void (errPtr, this, params…)` (params already
    // include the synthetic out for a non-void return). No body.
    public static void declareMethod(const CodeGenModule cgm, const SemaClassType cls, const SemaClassMethod m) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()

        pointer voidTy
        llvm.voidTypeInContext(cgm.getCtx(), voidTy)
        List<pointer> ptypes = new List<pointer>()
        pointer err = types.ptrType()
        ptypes.add(err)                         // errPtr
        pointer thisp = types.ptrType()
        ptypes.add(thisp)                       // this
        List<SemaParam> params = m.getParams()
        int i = 0
        while i < params.size() {
            pointer pp = types.ptrType()
            ptypes.add(pp)
            i = i + 1
        }
        pointer fnTy
        cg.functionTypeN(voidTy, ptypes, false, fnTy)
        m.setLlvmFnType(fnTy)

        string name = methodMangle(cgm, cls, m)
        pointer f
        llvm.addFunction(cgm.getModule(), name, fnTy, f)
        m.setLlvmFn(f)
    }

    // buildVTable — emit `@vtable.<ns>.<Class> = constant [N x ptr] [null, m0, …]`.
    // emitInitCtor — define `ptr <Id>.init_ctor(ptr obj)`: zero the instance then store
    // the vtable at slot 0, returning obj. The reference emits this per class; a program
    // constructing a HEADER class (a non-generic std class via its .fly.h stub) CALLS it
    // (genNew), so fly_std_lib.a must DEFINE it — else `undefined symbol <Id>.init_ctor`.
    // LinkOnceODR (weak) so a program that also compiles the class doesn't collide.
    public static void emitInitCtor(const CodeGenModule cgm, const SemaClassType cls) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        pointer b = cgm.getBuilder()
        pointer ptrTy = cgm.getTypes().ptrType()
        string icName = str.concat(refClassId(cls), ".init_ctor")
        List<pointer> ps = new List<pointer>()
        ps.add(ptrTy)
        pointer fty
        cg.functionTypeN(ptrTy, ps, false, fty)
        pointer fn
        llvm.getNamedFunction(cgm.getModule(), icName, fn)
        if fn == 0 { llvm.addFunction(cgm.getModule(), icName, fty, fn) }
        llvm.setLinkage(fn, 3)
        cgm.setWeakComdat(fn, icName)

        pointer entry
        llvm.appendBasicBlockInContext(cgm.getCtx(), fn, "entry", entry)
        llvm.positionBuilderAtEnd(b, entry)
        pointer obj
        llvm.getParam(fn, 0, obj)
        pointer structTy = cls.getLlvmStructType()
        pointer i8Ty
        llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
        pointer zeroVal
        llvm.constInt(i8Ty, 0, false, zeroVal)
        pointer szVal
        llvm.sizeOf(structTy, szVal)
        pointer memsetV
        llvm.buildMemSet(b, obj, zeroVal, szVal, 0, memsetV)
        pointer vtSlot
        llvm.buildStructGEP2(b, structTy, obj, 0, "vtslot", vtSlot)
        pointer vtable = cls.getLlvmVTable()
        llvm.buildStore(b, vtable, vtSlot)
        pointer ret
        llvm.buildRet(b, obj, ret)
    }

    public static void buildVTable(const CodeGenModule cgm, const SemaClassType cls) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()
        pointer ptrTy = types.ptrType()

        List<SemaClassMethod> ms = vmethods(cls)     // inherited slots + own (overrides in-place)
        List<pointer> slots = new List<pointer>()
        pointer nullSlot
        llvm.constPointerNull(ptrTy, nullSlot)
        slots.add(nullSlot)                     // slot 0: offset-to-top (null)
        int i = 0
        while i < ms.size() {
            SemaClassMethod m = ms.get(i)
            pointer f = m.getLlvmFn()
            slots.add(f)
            i = i + 1
        }

        // Interface region (audit V4): implemented interfaces put their methods at
        // MODULE-GLOBAL slots (cgm.ifaceBase + method index) so an interface-typed
        // dispatch indexes the same slot in every implementing class's vtable. The
        // gap between the own methods and the region is null padding.
        List<SemaClassType> ifs = implementedInterfaces(cls)
        int fi = 0
        while fi < ifs.size() {
            SemaClassType ifc = ifs.get(fi)
            int base = cgm.ifaceBase(ifc.getName())
            if base > 0 {
                List<SemaClassMethod> ims = vmethods(ifc)
                int need = base + (int)ims.size()
                while slots.size() < need { slots.add(nullSlot) }
                int im = 0
                while im < ims.size() {
                    SemaClassMethod idecl = ims.get(im)
                    // match the implementation by FULL SIGNATURE — by name the
                    // overloaded visitor methods all hit the same slot
                    int own = indexOfMethodSig(ms, idecl)
                    if own >= 0 {
                        SemaClassMethod impl = ms.get(own)
                        pointer ifn = impl.getLlvmFn()
                        if ifn != 0 { slots.set(base + im, ifn) }
                    }
                    im = im + 1
                }
            }
            fi = fi + 1
        }

        pointer init
        cg.constArrayN(ptrTy, slots, init)
        int n = (int)slots.size()
        pointer arrTy
        llvm.arrayType(ptrTy, n, arrTy)
        pointer g
        llvm.addGlobal(cgm.getModule(), arrTy, vtableName(cls), g)
        llvm.setInitializer(g, init)
        llvm.setGlobalConstant(g, true)
        // A generic-class specialization's vtable is emitted per-object; weak linkage
        // (LinkOnceODR = 3) merges duplicates across a program + fly_std_lib.a.
        // The comdat makes the dedup real on COFF too (no weak defs there).
        if cls.getGenericTemplate() != null {
            llvm.setLinkage(g, 3)
            cgm.setWeakComdat(g, vtableName(cls))
        }
        cls.setLlvmVTable(g)
    }

    // implementedInterfaces — every INTERFACE reachable through the base list
    // (all bases, recursively), deduplicated by name.
    public static List<SemaClassType> implementedInterfaces(const SemaClassType cls) {
        List<SemaClassType> r = new List<SemaClassType>()
        collectInterfaces(cls, r)
        out = r
    }

    public static void collectInterfaces(const SemaClassType cls, List<SemaClassType> acc) {
        List<SemaClassType> bases = cls.getBaseClasses()
        int i = 0
        while i < bases.size() {
            SemaClassType b = bases.get(i)
            if b.getClassKind() == SemaClassKind.INTERFACE {
                bool seen = false
                int k = 0
                while k < acc.size() {
                    SemaClassType ak = acc.get(k)
                    if str.equals(ak.getName(), b.getName()) { seen = true }
                    k = k + 1
                }
                if seen == false { acc.add(b) }
            }
            collectInterfaces(b, acc)
            i = i + 1
        }
    }

    // genMethodBody — entry + prologue (err=param0; this gets its own alloca from
    // param1; params from param2 are by-pointer) + body + ret void.
    public static void genMethodBody(const CodeGenModule cgm, const SemaClassType cls, const SemaClassMethod m) {
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cg.getLLVM()
        CodeGenType types = cgm.getTypes()
        pointer b = cgm.getBuilder()
        pointer f = m.getLlvmFn()

        // Methods (incl. the constructor) of a GENERIC-CLASS specialization (List<string>,
        // Map<string,int>, …) can be emitted by multiple self-host objects (a program AND
        // fly_std_lib.a). Weak linkage (LinkOnceODR = 3) merges the duplicates. Mirrors the
        // reference weak-linkage fix; keyed on the class being a specialization. The
        // comdat makes the dedup real on COFF too (no weak defs there).
        if cls.getGenericTemplate() != null {
            llvm.setLinkage(f, 3)
            cgm.setWeakComdat(f, methodMangle(cgm, cls, m))
        }

        pointer entry
        llvm.appendBasicBlockInContext(cgm.getCtx(), f, "entry", entry)
        llvm.positionBuilderAtEnd(b, entry)

        CodeGenExpr cge = new CodeGenExpr(cgm)
        pointer errParam
        llvm.getParam(f, 0, errParam)
        cge.setErrPtr(errParam)
        // per-function `lasterr` slot backing the implicit `error` variable
        pointer i32le
        llvm.int32TypeInContext(cgm.getCtx(), i32le)
        pointer leSlot
        llvm.buildAlloca(cgm.getBuilder(), i32le, "lasterr", leSlot)
        pointer leZero
        llvm.constInt(i32le, 0, true, leZero)
        llvm.buildStore(cgm.getBuilder(), leZero, leSlot)
        cge.setLastErrPtr(leSlot)

        // `this` is passed by value (the object pointer); store it into its own slot.
        pointer thisParam
        llvm.getParam(f, 1, thisParam)
        pointer ptrTy = types.ptrType()
        pointer thisSlot
        llvm.buildAlloca(b, ptrTy, "this", thisSlot)
        llvm.buildStore(b, thisParam, thisSlot)
        SemaClassInstance ti = m.getThis()
        if ti != null { ti.setLlvmAlloca(thisSlot) }

        List<SemaParam> params = m.getParams()
        int i = 0
        while i < params.size() {
            SemaParam pm = params.get(i)
            pointer arg
            llvm.getParam(f, i + 2, arg)
            // CONST CLASS/INTERFACE handle params arrive BY VALUE (like `this`); bind
            // them through a fresh local slot so body loads read the handle, not *handle.
            // STRUCTs (value aggregates) and everything else keep the incoming pointer as
            // storage. Mirrors CodeGenModule.genBody + the reference ABI (see CodeGenCall).
            SemaType pty = pm.getType()
            bool byValueHandle = false
            if pm.isConstant() {
                SemaClassType pcls = null
                if pty != null { pcls = pty.asClass() }
                if pcls != null {
                    if pcls.getClassKind() != SemaClassKind.STRUCT { byValueHandle = true }
                }
            }
            if byValueHandle {
                pointer pslot
                llvm.buildAlloca(b, ptrTy, "pval", pslot)
                llvm.buildStore(b, arg, pslot)
                pm.setLlvmAlloca(pslot)
            } else {
                pm.setLlvmAlloca(arg)
            }
            i = i + 1
        }
        cge.bindOutSlot(params)

        SemaBlockStmt body = m.getBody()
        if body != null { body.accept(cge) }
        if cge.isTerminated() == false {
            pointer ret
            llvm.buildRetVoid(b, ret)
        }
    }

    // genNew — `new C(args)`: malloc the struct, store the vtable pointer, run the
    // constructor (errPtr, this, args…). The expression's value is the object ptr.
    public static void genNew(const CodeGenExpr cge, const SemaCall node) {
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()

        SemaType t = node.getType()
        SemaClassType cls = t.asClass()
        pointer structTy = cls.getLlvmStructType()

        // Defensive guard (audit V2): a class that was never materialized (header
        // import, raw generic template) has structTy == 0; passing it to
        // LLVMBuildMalloc segfaults inside libLLVM. Sema rejects these upstream —
        // if one still slips through, report and yield a null pointer instead.
        if structTy == 0 {
            fly.os.io.printErrLn(fly.str.concat(fly.str.concat("error: cannot instantiate class '", cls.getName()), "': no materialized LLVM struct type"))
            pointer nullObj
            llvm.constPointerNull(cge.ptrType(), nullObj)
            node.setLlvmValue(nullObj)
            return
        }

        // STRUCTs are STACK objects with no vtable (reference ABI): alloca + zero,
        // no vtable store, and — for HEADER structs — no constructor call either
        // (the archive defines none; alloca+zero IS the reference behaviour).
        // HEADER classes follow the reference protocol instead: malloc +
        // `<Id>.init_ctor(obj)` (archive-defined; wires the REFERENCE vtable and
        // field defaults with the Itanium layout) + the mangled constructor.
        bool isStruct = cls.getClassKind() == SemaClassKind.STRUCT
        bool headerClass = false
        if isStruct == false { headerClass = cls.isFromHeader() }
        pointer obj
        if isStruct {
            llvm.buildAlloca(b, structTy, "sobj", obj)
        } else {
            llvm.buildMalloc(b, structTy, "obj", obj)
        }

        if headerClass {
            string icName = str.concat(refClassId(cls), ".init_ctor")
            pointer icFn
            llvm.getNamedFunction(cgm.getModule(), icName, icFn)
            pointer ptrTy2 = cge.ptrType()
            List<pointer> icParams = new List<pointer>()
            icParams.add(ptrTy2)
            pointer icTy
            cg.functionTypeN(ptrTy2, icParams, false, icTy)
            if icFn == 0 {
                llvm.addFunction(cgm.getModule(), icName, icTy, icFn)
            }
            List<pointer> icArgs = new List<pointer>()
            icArgs.add(obj)
            pointer icV
            cg.buildCallN(b, icTy, icFn, icArgs, "", icV)
        } else {
            // Zero the instance so fields the constructor does not assign are
            // deterministic across platforms (Windows malloc returns garbage;
            // Linux zeroes). Mirrors the reference's memset-after-malloc.
            pointer i8Ty
            llvm.int8TypeInContext(cgm.getCtx(), i8Ty)
            pointer zeroVal
            llvm.constInt(i8Ty, 0, false, zeroVal)
            pointer szVal
            llvm.sizeOf(structTy, szVal)
            pointer memsetV
            llvm.buildMemSet(b, obj, zeroVal, szVal, 0, memsetV)

            if isStruct == false {
                pointer vtSlot
                llvm.buildStructGEP2(b, structTy, obj, 0, "vtslot", vtSlot)
                pointer vtable = cls.getLlvmVTable()
                llvm.buildStore(b, vtable, vtSlot)
            }
        }

        SemaFunctionBase ctor = node.getFunction()
        if isStruct {
            if cls.isFromHeader() { ctor = null }
        }
        if ctor != null {
            pointer cf = ctor.getLlvmFn()
            List<pointer> argAddrs = new List<pointer>()
            pointer err = cge.getErrPtr()
            argAddrs.add(err)
            argAddrs.add(obj)
            List<SemaExpr> args = node.getArgs()
            List<SemaParam> cparams = ctor.getParams()
            int i = 0
            while i < args.size() {
                SemaExpr a = args.get(i)
                pointer av = cge.gen(a)
                // coerce to the CTOR PARAM's type and size the slot by it — a
                // literal `new Wrapper<long>(9999)` otherwise stores i32 into a
                // slot the callee reads as i64 (audit V4)
                SemaType aTy = a.getType()
                SemaType pTy = aTy
                bool cpConst = false
                if i < cparams.size() {
                    SemaParam cp = cparams.get(i)
                    SemaType cpt = cp.getType()
                    if cpt != null { pTy = cpt }
                    cpConst = cp.isConstant()
                }
                // A CONST CLASS/INTERFACE handle ctor arg is passed BY VALUE (the handle),
                // matching the reference ABI — the same rule as CodeGenCall. Passing it by
                // &temp made the archive ctor (e.g. Frontend(CompilerInstance)) store the
                // temp's ADDRESS as `this.ci` → later virtual dispatch jumped to garbage.
                // STRUCTs and non-const params keep the by-pointer path.
                SemaClassType pcls = null
                if pTy != null { pcls = pTy.asClass() }
                bool byValHandle = false
                if cpConst {
                    if pcls != null {
                        if pcls.getClassKind() != SemaClassKind.STRUCT { byValHandle = true }
                    }
                }
                if byValHandle {
                    argAddrs.add(av)
                } else {
                    pointer cvv = cge.coerce(av, aTy, pTy)
                    pointer aty = cge.lowerType(pTy)
                    pointer tmp
                    llvm.buildAlloca(b, aty, "arg", tmp)
                    llvm.buildStore(b, cvv, tmp)
                    argAddrs.add(tmp)
                }
                i = i + 1
            }
            pointer cty = ctor.getLlvmFnType()
            pointer cv
            cg.buildCallN(b, cty, cf, argAddrs, "", cv)
        }
        // `new CLang("libm.so")` → register the -lm linker flag (bridge)
        if CodeGenBridge.isCLangClass(cls) {
            CodeGenBridge.captureCtorLib(cge, node)
        }
        node.setLlvmValue(obj)
    }

    // methodCall — `obj.m(args)`: virtual dispatch through the receiver's vtable
    // (load vtable → GEP to the method's slot → indirect call), passing
    // (errPtr, obj, args…, [out]) and reloading the out slot as the call value.
    public static void methodCall(const CodeGenExpr cge, const SemaCall node) {
        // CLang FFI bridge: `<CLang>.call(sym, args[, out])` is intercepted at
        // compile time (direct C call) — the archive method is an empty stub.
        if CodeGenBridge.isBridgeCall(node) {
            CodeGenBridge.genCall(cge, node)
            return
        }
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenType types = cgm.getTypes()
        pointer ptrTy = types.ptrType()

        SemaFunctionBase fn = node.getFunction()
        SemaExpr parent = node.getParent()
        pointer objPtr = cge.gen(parent)
        SemaType pt = parent.getType()
        SemaClassType cls = pt.asClass()
        pointer structTy = cls.getLlvmStructType()

        // super calls dispatch DIRECT to the resolved base function — loading the
        // vtable would re-dispatch to the most-derived override (audit V4).
        // Everything else loads the vtable pointer (slot 0) + the method slot:
        // for a CLASS-typed receiver the slot comes from its vmethods position;
        // for an INTERFACE-typed receiver from the module-global interface region
        // (same index in every implementing class's vtable).
        // Dispatch selection:
        //   super / STRUCT / header CLASS  → DIRECT (no vtable, or the archive's
        //     Itanium vtable whose class-slot indices differ from ours)
        //   header INTERFACE → vtable dispatch with the REFERENCE per-base layout:
        //     the receiver IS a base-subobject pointer (produced by archive code),
        //     slot 0 = offset-to-top, methods at their interface order + 1 —
        //     which is exactly methodSlot() over the interface itself
        //   native INTERFACE → module-global interface slots (flat model)
        //   native CLASS → own vmethods slot
        bool direct = false
        if node.isSuper() { direct = true }
        if cls.getClassKind() == SemaClassKind.STRUCT { direct = true }
        // (removed) header CLASS → direct workaround: the self-host vtable now
        // includes constructors (reference numbering), so an archive-built class
        // vtable is index-compatible → dispatch through it like a native class.
        pointer fnPtr
        if direct {
            fnPtr = fn.getLlvmFn()
        } else {
            pointer vtSlot
            llvm.buildStructGEP2(b, structTy, objPtr, 0, "vtslot", vtSlot)
            pointer vt
            llvm.buildLoad2(b, ptrTy, vtSlot, "vt", vt)
            int slot = 0
            if cls.getClassKind() == SemaClassKind.INTERFACE {
                if cls.isFromHeader() { slot = methodSlot(cls, fn) }
                else { slot = cgm.ifaceSlot(cls, fn) }
            } else {
                slot = methodSlot(cls, fn)
            }
            pointer i64Ty
            llvm.int64TypeInContext(cgm.getCtx(), i64Ty)
            pointer slotIdx
            llvm.constInt(i64Ty, slot, false, slotIdx)
            List<pointer> idxAddrs = new List<pointer>()
            idxAddrs.add(slotIdx)
            pointer fnSlot
            cg.buildGEP2N(b, ptrTy, vt, idxAddrs, "vfnslot", fnSlot)
            llvm.buildLoad2(b, ptrTy, fnSlot, "vfn", fnPtr)
        }

        // arguments: errPtr, obj, real args…, out
        List<pointer> argAddrs = new List<pointer>()
        pointer err = cge.getErrPtr()
        argAddrs.add(err)
        argAddrs.add(objPtr)

        List<SemaExpr> args = node.getArgs()
        SemaLocalVar outVar = node.getOutVar()
        bool hasOut = outVar != null
        int realCount = (int)args.size()
        if hasOut { realCount = realCount - 1 }
        List<SemaParam> mParams = fn.getParams()
        int i = 0
        while i < realCount {
            SemaExpr a = args.get(i)

            // writable (non-const) param + variable arg → pass the original
            // storage address (out-params); otherwise copy + numeric coercion
            // to the param's type (audit V4 — mirrors CodeGenCall)
            bool passedDirect = false
            if i < mParams.size() {
                SemaParam mp = mParams.get(i)
                if mp.isConstant() == false {
                    if a.isVarExpr() {
                        pointer addr = cge.genAddr(a)
                        argAddrs.add(addr)
                        passedDirect = true
                    }
                }
            }
            if passedDirect == false {
                pointer av = cge.gen(a)
                SemaType aTy = a.getType()
                SemaType pTy = aTy
                bool mpConst = false
                if i < mParams.size() {
                    SemaParam mp2 = mParams.get(i)
                    SemaType mpt = mp2.getType()
                    if mpt != null { pTy = mpt }
                    mpConst = mp2.isConstant()
                }
                // A CONST CLASS/INTERFACE handle arg goes BY VALUE (the handle), matching
                // the reference ABI (same rule as CodeGenCall/genNew). STRUCTs and
                // non-const params keep the by-pointer path.
                SemaClassType mpcls = null
                if pTy != null { mpcls = pTy.asClass() }
                bool mByVal = false
                if mpConst {
                    if mpcls != null {
                        if mpcls.getClassKind() != SemaClassKind.STRUCT { mByVal = true }
                    }
                }
                if mByVal {
                    argAddrs.add(av)
                } else {
                    pointer sv = cge.coerce(av, aTy, pTy)
                    pointer aty = cge.lowerType(pTy)
                    pointer tmp
                    llvm.buildAlloca(b, aty, "arg", tmp)
                    llvm.buildStore(b, sv, tmp)
                    argAddrs.add(tmp)
                }
            }
            i = i + 1
        }
        pointer outPtr = 0
        if hasOut {
            SemaType ot2 = outVar.getType()
            pointer oty = cge.lowerType(ot2)
            llvm.buildAlloca(b, oty, "callout", outPtr)
            // CLASS-kind results: pre-allocate the target the callee writes
            // through (reference out convention — mirrors CodeGenCall)
            SemaClassType oc2 = null
            if ot2 != null { oc2 = ot2.asClass() }
            if oc2 != null {
                pointer sty2 = oc2.getLlvmStructType()
                if sty2 != 0 {
                    pointer target2
                    if oc2.getClassKind() == SemaClassKind.STRUCT {
                        llvm.buildAlloca(b, sty2, "outobj", target2)
                    } else {
                        llvm.buildMalloc(b, sty2, "outobj", target2)
                    }
                    llvm.buildStore(b, target2, outPtr)
                }
            }
            outVar.setLlvmAlloca(outPtr)
            argAddrs.add(outPtr)
        }

        pointer fnTy = fn.getLlvmFnType()
        pointer cv
        cg.buildCallN(b, fnTy, fnPtr, argAddrs, "", cv)
        if hasOut {
            pointer oty2 = cge.lowerType(outVar.getType())
            pointer loaded
            llvm.buildLoad2(b, oty2, outPtr, "callres", loaded)
            node.setLlvmValue(loaded)
        }
    }

    // member — `obj.field`: GEP to the field slot; load it (rvalue) or return its
    // address (addrMode, for an assignment LHS).
    public static void member(const CodeGenExpr cge, const SemaMember node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        // Capture addrMode BEFORE gen(parent) — gen() resets it to rvalue mode.
        bool addr = cge.isAddrMode()
        SemaExpr parent = node.getParent()
        pointer objPtr = cge.gen(parent)
        SemaType pt = parent.getType()
        SemaClassType cls = pt.asClass()
        pointer structTy = cls.getLlvmStructType()

        ASTMember mast = node.getAST()
        string fname = mast.getName()
        int idx = fieldIndex(cls, fname)
        pointer fldPtr
        llvm.buildStructGEP2(b, structTy, objPtr, idx, "fld", fldPtr)

        if addr {
            node.setLlvmValue(fldPtr)
        } else {
            SemaClassAttribute a = cls.LookupAttribute(fname)
            pointer fty = cge.lowerType(a.getType())
            pointer loaded
            llvm.buildLoad2(b, fty, fldPtr, "fldv", loaded)
            node.setLlvmValue(loaded)
        }
    }

    // ── name + index helpers ──────────────────────────────────────────────────

    // fieldIndex — slot index of a field.
    //   native CLASS: 1 + position in the FLATTENED list (slot 0 = vtable);
    //   STRUCT:       plain position (no vtable slot, reference ABI);
    //   HEADER class: 1 + base-subobject count + position among OWN fields
    //                 (reference Itanium layout; inherited fields would need a
    //                 nested subobject GEP — unsupported for now).
    public static int fieldIndex(const SemaClassType cls, const string name) {
        if cls.isFromHeader() {
            if cls.getClassKind() != SemaClassKind.STRUCT {
                int hb = 1 + nonStructBaseCount(cls)
                List<SemaClassAttribute> own = cls.getAttributeList()
                int oi = 0
                while oi < own.size() {
                    SemaClassAttribute oa = own.get(oi)
                    if str.equals(oa.getName(), name) { out = oi + hb  return }
                    oi = oi + 1
                }
                out = hb
                return
            }
        }
        int base = 1
        if cls.getClassKind() == SemaClassKind.STRUCT { base = 0 }
        List<SemaClassAttribute> attrs = allAttributes(cls)
        int i = 0
        while i < attrs.size() {
            SemaClassAttribute a = attrs.get(i)
            if str.equals(a.getName(), name) { out = i + base  return }
            i = i + 1
        }
        out = base
    }

    // methodSlot — vtable slot of a method: 1 + its position in the FLATTENED
    // virtual-method list. Overrides keep the base's slot (vmethods replaces
    // in-place), so a base-typed dispatch and a derived object agree on the slot.
    public static int methodSlot(const SemaClassType cls, const SemaFunctionBase fn) {
        List<SemaClassMethod> ms = vmethods(cls)
        int slot = indexOfMethodSig(ms, fn)
        if slot >= 0 { out = slot + 1  return }
        out = 1
    }

    // allAttributes — every field, base classes first then own, in declaration
    // order (single-inheritance flattened layout; first base only for now).
    public static List<SemaClassAttribute> allAttributes(const SemaClassType cls) {
        List<SemaClassAttribute> r = new List<SemaClassAttribute>()
        List<SemaClassType> bases = cls.getBaseClasses()
        if bases.size() > 0 {
            SemaClassType base = bases.get(0)
            List<SemaClassAttribute> ba = allAttributes(base)
            int i = 0
            while i < ba.size() { r.add(ba.get(i))  i = i + 1 }
        }
        List<SemaClassAttribute> own = cls.getAttributeList()
        int j = 0
        while j < own.size() { r.add(own.get(j))  j = j + 1 }
        out = r
    }

    // vmethods — the effective virtual method per vtable slot: start from the base's
    // slots, then for each own (non-constructor) method, replace the inherited slot
    // of the same name (override) or append a new slot. This keeps slot indices
    // stable across the hierarchy so single-vtable dispatch is correct.
    public static List<SemaClassMethod> vmethods(const SemaClassType cls) {
        List<SemaClassMethod> r = new List<SemaClassMethod>()
        List<SemaClassType> bases = cls.getBaseClasses()
        if bases.size() > 0 {
            SemaClassType base = bases.get(0)
            List<SemaClassMethod> bm = vmethods(base)
            int i = 0
            while i < bm.size() { r.add(bm.get(i))  i = i + 1 }
        }
        List<SemaClassMethod> own = cls.getMethodList()
        int j = 0
        while j < own.size() {
            SemaClassMethod m = own.get(j)
            if m.isConstructor() {
                // reference parity: constructors occupy their own vtable slot in
                // declaration order (never override) so the self-host layout is
                // index-compatible with an archive-built (reference) vtable.
                r.add(m)
            } else {
                // an OVERRIDE has the same full signature; a same-name OVERLOAD
                // (visit(A)/visit(B)) gets its OWN slot
                int slot = indexOfMethodSig(r, m)
                if slot >= 0 { r.set(slot, m) } else { r.add(m) }
            }
            j = j + 1
        }
        out = r
    }

    public static int indexOfMethodName(const List<SemaClassMethod> ms, const string name) {
        int i = 0
        while i < ms.size() {
            SemaClassMethod m = ms.get(i)
            if str.equals(m.getName(), name) { out = i  return }
            i = i + 1
        }
        // -1 sentinel built through an int var: a literal `0 - 1` fold is typed
        // i8 by the bootstrap and this value feeds vtable slot layout (methodSlot
        // / vmethods `if slot >= 0`) — a mis-widened 255 would index out of bounds.
        int notFound = 0
        notFound = notFound - 1
        out = notFound
    }

    // sameSignature — overload-aware method identity: same name AND same parameter
    // type list, compared by type NAME (the synthetic out param is part of the list
    // and matches naturally). NAME-ONLY matching collapsed the ~50 `visit(...)`
    // overloads of the AST/Sema visitors into one vtable slot, so a stage-3
    // compiler (compiled by the self-host) dispatched every visit to the LAST
    // overload — empty resolution, wrong probes, visitor segfaults.
    public static bool sameSignature(const SemaFunctionBase a, const SemaFunctionBase b) {
        if str.equals(a.getName(), b.getName()) == false { out = false  return }
        List<SemaParam> pa = a.getParams()
        List<SemaParam> pb = b.getParams()
        if pa.size() != pb.size() { out = false  return }
        int i = 0
        while i < pa.size() {
            SemaType ta = pa.get(i).getType()
            SemaType tb = pb.get(i).getType()
            string na = ""
            string nb = ""
            if ta != null { na = ta.getName() }
            if tb != null { nb = tb.getName() }
            if str.equals(na, nb) == false { out = false  return }
            i = i + 1
        }
        out = true
    }

    // indexOfMethodSig — position of the method matching `probe`'s full signature
    // (same -1 sentinel discipline as indexOfMethodName).
    public static int indexOfMethodSig(const List<SemaClassMethod> ms, const SemaFunctionBase probe) {
        int i = 0
        while i < ms.size() {
            SemaClassMethod m = ms.get(i)
            if sameSignature(m, probe) { out = i  return }
            i = i + 1
        }
        int notFound = 0
        notFound = notFound - 1
        out = notFound
    }

    // className — the disambiguating name: a generic specialization carries a mangled
    // name (e.g. "Wrapper_int") so its struct/methods don't collide with sibling
    // specializations (which all share the template's simple getName()).
    public static string className(const SemaClassType cls) {
        string mn = cls.getMangledName()
        if str.isEmpty(mn) == false { out = mn  return }
        out = cls.getName()
    }

    public static string structName(const SemaClassType cls) {
        SemaModule mod = cls.getModule()
        string nsn = ""
        if mod != null {
            SemaNameSpace ns = mod.getNameSpace()
            if ns != null { nsn = ns.getName() }
        }
        string a = str.concat(nsn, ".")
        out = str.concat(a, className(cls))
    }

    public static string vtableName(const SemaClassType cls) {
        string a = str.concat("vtable.", structName(cls))
        out = a
    }

    // methodMangle — `<Class>` + the standard function mangling of the method
    // (which already starts with `_F…`): `FileWriter_F9fly_os_io5write…`, exactly
    // the reference's scheme, so header-class methods link against the archive.
    public static string methodMangle(const CodeGenModule cgm, const SemaClassType cls, const SemaClassMethod m) {
        string pfx = className(cls)
        string body = cgm.mangleMethod(m)
        out = str.concat(pfx, body)
    }
}
