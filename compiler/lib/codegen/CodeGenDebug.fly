namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.basic.SourceLocation
import fly.compiler.basic.SourceManager
import llvm.api.*
import fly.data.List
import fly.mem
import fly.str
import fly.os.path
import fly.os.env

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenDebug — DWARF line tables for `--debug-symbols` (the seed's
// CodeGenModule DBuilder + EmitDebugLocation, through the LLVM-C DIBuilder).
//
// What it describes: one DICompileUnit per module, one DIFile per source file,
// one DISubprogram per function or method body, and a !dbg location on every
// instruction a statement emits. That is what a debugger needs to map an address
// to file:line, set a breakpoint on a line and step; variables and types are not
// described yet.
//
// The one rule that keeps the module valid: an instruction may only carry a
// location whose scope is the subprogram of ITS OWN function. So the current
// location is set when a body begins, moved per statement, and CLEARED when the
// body ends — every function emitted outside a body (wrappers, vtables, the test
// runner, lazily created helpers) then gets no location at all.
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenDebug {

    LLVM llvm
    pointer ctx
    pointer builder
    pointer db
    pointer cu
    pointer cuFile
    pointer scope              // subprogram of the body being generated; 0 outside one
    List<string> fileNames     // source path → DIFile, linear (a module has few files)
    List<pointer> fileRefs
    List<string> typeNames     // Fly type → DWARF type, created once
    List<pointer> typeRefs
    pointer ptrTy              // the opaque `ptr` type (parameter spill slots)
    string prefixMap           // --debug-prefix-map pairs, ";OLD=NEW;" (CodeGenOptions)

    public CodeGenDebug(const LLVM llvm, const pointer ctx, const pointer module, const pointer builder,
            const string name, const string prefixMap, const pointer ptrTy) {
        this.ptrTy = ptrTy
        this.llvm = llvm
        this.prefixMap = prefixMap
        this.ctx = ctx
        this.builder = builder
        this.scope = 0
        this.fileNames = new List<string>()
        this.fileRefs = new List<pointer>()
        this.typeNames = new List<string>()
        this.typeRefs = new List<pointer>()
        pointer d
        llvm.createDIBuilder(module, d)
        this.db = d
        this.cuFile = this.fileFor(name)
        pointer u
        llvm.diCreateCompileUnit(d, this.cuFile, "Fly Compiler", u)
        this.cu = u

        // Without these two flags LLVM drops the debug info (version mismatch) or
        // picks its default DWARF version per target; clang sets both the same way.
        // On Windows the absence of "CodeView" keeps the output DWARF, which is what
        // the bundled lldb reads.
        pointer i32
        llvm.int32TypeInContext(ctx, i32)
        pointer three
        llvm.constInt(i32, 3, false, three)
        pointer mdVer
        llvm.valueAsMetadata(three, mdVer)
        llvm.addModuleFlag(module, 1, "Debug Info Version", mdVer)
        pointer four
        llvm.constInt(i32, 4, false, four)
        pointer mdDwarf
        llvm.valueAsMetadata(four, mdDwarf)
        llvm.addModuleFlag(module, 1, "Dwarf Version", mdDwarf)
    }

    // fileFor — the DIFile for a source path, created once. A relative path is
    // described relative to the current directory, which is where the compiler
    // resolved it.
    public pointer fileFor(const string p) {
        int i = 0
        while i < this.fileNames.size() {
            if str.equals(this.fileNames.get(i), p) {
                return this.fileRefs.get(i)
            }
            i = i + 1
        }
        string name = p
        string dir = "."
        if path.isAbsolute(p) {
            name = path.basename(p)
            dir = path.dirname(p)
        } else {
            string cwd = env.cwdGet()
            if str.isEmpty(cwd) == false {
                dir = cwd
            }
        }
        dir = this.remap(dir)
        pointer f
        this.llvm.diCreateFile(this.db, name, dir, f)
        this.fileNames.add(p)
        this.fileRefs.add(f)
        return f
    }

    // remap — apply --debug-prefix-map (";OLD=NEW;" pairs) to a directory, as
    // clang's -fdebug-prefix-map: a directory equal to OLD, or below it, has OLD
    // replaced by NEW; when several match, the LAST one given wins. '/' and '\'
    // compare equal, since Windows paths reach here in both spellings. What it
    // is for: two compilers in different places must describe the same sources
    // with the same bits (the stage 3 fixpoint compares objects byte by byte),
    // and a debug build should not depend on the machine that made it.
    public string remap(const string dir) {
        string result = dir
        string m = this.prefixMap
        int n = str.len(m)
        int start = 0
        while start < n {
            int end = start
            while end < n && (str.byteAt(m, end) & 255) != 59 { // ';'
                end = end + 1
            }
            if end > start {
                string pair = str.substring(m, start, end)
                int eq = str.indexOf(pair, "=")
                if eq > 0 {
                    string oldP = str.substring(pair, 0, eq)
                    if isPathPrefix(dir, oldP) {
                        string newP = str.substring(pair, eq + 1, str.len(pair))
                        result = str.concat(newP, str.substring(dir, str.len(oldP), str.len(dir)))
                    }
                }
            }
            start = end + 1
        }
        return result
    }

    // beginFunction — attach a subprogram to `fn` and point the builder at its
    // first line. A body with no usable location is left undescribed (scope 0),
    // and so are the statements inside it.
    public void beginFunction(const SemaFunctionBase sfn, const pointer fn, const bool isLocal) {
        this.scope = 0
        this.llvm.setCurrentDebugLocation(this.builder, 0)
        ASTFunction ast = sfn.getAST()
        if ast == null {
            return
        }
        SourceLocation loc = ast.getNameLoc()
        if loc == null {
            return
        }
        SourceManager sm = loc.getSourceManager()
        if sm == null {
            return
        }
        int line = sm.getLineNumber(loc)
        pointer file = this.fileFor(sm.getFilename())
        pointer ty
        this.llvm.diCreateSubroutineType(this.db, file, ty)
        pointer sp
        this.llvm.diCreateFunction(this.db, file, sfn.getName(), "", file, line, ty, isLocal, sp)
        this.llvm.setSubprogram(fn, sp)
        this.scope = sp
        this.setLine(line, sm.getColumnNumber(loc))
    }

    // endFunction — clear the location, so nothing emitted outside a described
    // body inherits it.
    public void endFunction() {
        this.scope = 0
        this.llvm.setCurrentDebugLocation(this.builder, 0)
    }

    // atStmt — move the current location to the start of a statement.
    public void atStmt(const SemaStmt s) {
        if this.scope == 0 {
            return
        }
        if s == null {
            return
        }
        ASTStmt ast = s.getAST()
        if ast == null {
            return
        }
        SourceLocation loc = ast.getLoc()
        if loc == null {
            return
        }
        if loc.isInvalid() {
            return
        }
        SourceManager sm = loc.getSourceManager()
        if sm == null {
            return
        }
        this.setLine(sm.getLineNumber(loc), sm.getColumnNumber(loc))
    }

    public void setLine(const int line, const int col) {
        pointer dl
        this.llvm.diCreateDebugLocation(this.ctx, line, col, this.scope, dl)
        this.llvm.setCurrentDebugLocation(this.builder, dl)
    }

    // suspend / resume — around a helper function created in the middle of a
    // body: it must not carry the body's location.
    public pointer suspend() {
        pointer cur
        this.llvm.getCurrentDebugLocation(this.builder, cur)
        this.llvm.setCurrentDebugLocation(this.builder, 0)
        return cur
    }

    public void resume(const pointer saved) {
        this.llvm.setCurrentDebugLocation(this.builder, saved)
    }

    // ── Variables ─────────────────────────────────────────────────────────────
    //
    // A variable is described where its storage is: `storage` is the address
    // the value lives at (a local's alloca; a parameter's incoming pointer, since
    // parameters are passed by reference; the cell holding a class handle). The
    // DWARF type matches what is AT that address, so a class variable is a
    // pointer to the class, and a string is its {data, size} pair.

    // typeFor — the DWARF type of a Fly type, created once per module; 0 when the
    // type is not described (a variable of that type is then left out).
    public pointer typeFor(const SemaType t) {
        if t == null {
            return 0
        }
        SemaClassType cls = t.asClass()
        string key = t.getName()
        if cls != null {
            key = str.concat("class ", key)
        }
        int i = 0
        while i < this.typeNames.size() {
            if str.equals(this.typeNames.get(i), key) {
                return this.typeRefs.get(i)
            }
            i = i + 1
        }
        pointer d = 0
        string n = t.getName()
        if cls != null {
            pointer fwd
            this.llvm.diCreateForwardDecl(this.db, n, this.cuFile, this.cuFile, fwd)
            this.llvm.diCreatePointerType(this.db, fwd, "", d)
        } elsif t.isBool() {
            d = this.basic("bool", 8, 2)                   // DW_ATE_boolean
        } elsif t.isInteger() {
            if str.equals(n, "byte") { // DW_ATE_unsigned_char
                d = this.basic(n, 8, 8)
            } elsif str.equals(n, "ushort") { // DW_ATE_unsigned
                d = this.basic(n, 16, 7)
            } elsif str.equals(n, "uint") {
                d = this.basic(n, 32, 7)
            } elsif str.equals(n, "ulong") {
                d = this.basic(n, 64, 7)
            } elsif str.equals(n, "short") { // DW_ATE_signed
                d = this.basic(n, 16, 5)
            } elsif str.equals(n, "int") {
                d = this.basic(n, 32, 5)
            } elsif str.equals(n, "long") {
                d = this.basic(n, 64, 5)
            } elsif str.equals(n, "pointer") { // DW_ATE_address
                d = this.basic(n, 64, 1)
            }
        } elsif t.isFloat() {
            if str.equals(n, "double") {
                d = this.basic(n, 64, 4)
            } else { // DW_ATE_float
                d = this.basic(n, 32, 4)
            }
        } elsif t.isString() {
            // %string = { ptr data, i32 size } — the bytes are NOT NUL-terminated,
            // so `size` is the length to trust when a debugger prints `data`.
            pointer chr = this.basic("char", 8, 8)
            pointer chrPtr
            this.llvm.diCreatePointerType(this.db, chr, "", chrPtr)
            d = this.pair("string", "data", chrPtr, "size", this.basic("int", 32, 5), 32)
        } elsif t.isArray() {
            // %array = { ptr data, i64 len }
            d = this.pair(n, "data", this.basic("pointer", 64, 1), "len", this.basic("long", 64, 5), 64)
        } elsif t.isEnum() {
            d = this.basic(n, 32, 5)
        }
        if d != 0 {
            this.typeNames.add(key)
            this.typeRefs.add(d)
        }
        return d
    }

    public pointer basic(const string name, const long bits, const int encoding) {
        pointer d
        this.llvm.diCreateBasicType(this.db, name, bits, encoding, d)
        return d
    }

    // pair — a 128-bit struct of two members: a 64-bit `first` at offset 0 and a
    // `second` of `secondBits` at offset 64 (the shape of %string and %array).
    public pointer pair(const string name, const string first, const pointer firstTy,
                        const string second, const pointer secondTy, const long secondBits) {
        pointer m0
        this.llvm.diCreateMemberType(this.db, this.cuFile, first, this.cuFile, 64, 64, 0, firstTy, m0)
        pointer m1
        this.llvm.diCreateMemberType(this.db, this.cuFile, second, this.cuFile, secondBits, 0, 64, secondTy, m1)
        pointer elems = mem.alloc(16)
        mem.writePtr(elems, 0, m0)
        mem.writePtr(elems, 8, m1)
        pointer d
        this.llvm.diCreateStructType(this.db, this.cuFile, name, this.cuFile, 128, 64, elems, 2, d)
        return d
    }

    // declareVar — describe a local (argNo 0) or a parameter (argNo >= 1, unique
    // within the function) whose value lives at `storage`.
    public void declareVar(const SemaVar v, const pointer storage, const int argNo, const bool deref) {
        if this.scope == 0 {
            return
        }
        if storage == 0 {
            return
        }
        if v == null {
            return
        }
        ASTVar ast = v.getAST()
        if ast == null {
            return
        }
        this.declareAt(v.getName(), v.getType(), ast.getNameLoc(), storage, argNo, deref)
    }

    // declareParams — every written parameter, numbered from offset + 1 (a
    // method's `this` is number 1). The hidden return slot is not a variable.
    public void declareParams(const List<SemaParam> params, const int offset) {
        int argNo = offset
        int i = 0
        while i < params.size() {
            SemaParam pm = params.get(i)
            if pm.isSynthetic() == false {
                argNo = argNo + 1
                this.declareParam(pm, argNo)
            }
            i = i + 1
        }
    }

    // declareParam — a parameter arrives as a POINTER to its value, in a register.
    // Described through that register, it is lost as soon as the register is
    // reused (an unused `const string` showed "no location" at its own first
    // line). So, like clang's `.addr` slots, the pointer is stored in a stack
    // slot and the variable is described as *slot (DW_OP_deref). A parameter
    // already bound through a slot of its own (a by-value class handle) is
    // described there directly.
    public void declareParam(const SemaParam pm, const int argNo) {
        if this.scope == 0 {
            return
        }
        pointer st = pm.getLlvmAlloca()
        if st == 0 {
            return
        }
        if this.llvm.isArgument(st) {
            pointer slot
            this.llvm.buildAlloca(this.builder, this.ptrTy, "dbg.arg", slot)
            this.llvm.buildStore(this.builder, st, slot)
            this.declareVar(pm, slot, argNo, true)
        } else {
            this.declareVar(pm, st, argNo, false)
        }
    }

    // declareThis — `this` in a method: the slot holding the object pointer.
    public void declareThis(const SemaClassType cls, const SemaFunctionBase sfn, const pointer slot) {
        if this.scope == 0 {
            return
        }
        if cls == null {
            return
        }
        ASTFunction ast = sfn.getAST()
        if ast == null {
            return
        }
        this.declareAt("this", cls, ast.getNameLoc(), slot, 1, false)
    }

    public void declareAt(const string name, const SemaType t, const SourceLocation loc, const pointer storage,
            const int argNo, const bool deref) {
        if loc == null {
            return
        }
        if loc.isInvalid() {
            return
        }
        SourceManager sm = loc.getSourceManager()
        if sm == null {
            return
        }
        pointer ty = this.typeFor(t)
        if ty == 0 {
            return
        }
        int line = sm.getLineNumber(loc)
        int col = sm.getColumnNumber(loc)
        pointer file = this.fileFor(sm.getFilename())
        pointer var
        if argNo > 0 {
            this.llvm.diCreateParameterVariable(this.db, this.scope, name, argNo, file, line, ty, var)
        } else {
            this.llvm.diCreateAutoVariable(this.db, this.scope, name, file, line, ty, var)
        }
        pointer expr
        if deref {
            this.llvm.diCreateDerefExpression(this.db, expr)
        } else {
            this.llvm.diCreateEmptyExpression(this.db, expr)
        }
        pointer dl
        this.llvm.diCreateDebugLocation(this.ctx, line, col, this.scope, dl)
        pointer bb
        this.llvm.getInsertBlock(this.builder, bb)
        if bb == 0 {
            return
        }
        this.llvm.diInsertDeclareAtEnd(this.db, storage, var, expr, dl, bb)
    }

    // finalize — must run before the module is verified or emitted.
    public void finalize() {
        this.llvm.diBuilderFinalize(this.db)
    }
}

// isPathPrefix — `dir` equals `prefix` or lies below it, with '/' and '\'
// treated as the same separator. A trailing separator on `prefix` is allowed.
public bool isPathPrefix(const string dir, const string prefix) {
    int pn = str.len(prefix)
    int dn = str.len(dir)
    if pn == 0 || pn > dn {
        return false
    }
    int i = 0
    while i < pn {
        int a = str.byteAt(dir, i) & 255
        int b = str.byteAt(prefix, i) & 255
        if a == 92 {
            a = 47
        }
        if b == 92 {
            b = 47
        }
        if a != b {
            return false
        }
        i = i + 1
    }
    if pn == dn {
        return true
    }
    int last = str.byteAt(prefix, pn - 1) & 255
    if last == 47 || last == 92 {
        return true
    }
    int next = str.byteAt(dir, pn) & 255
    return next == 47 || next == 92
}
