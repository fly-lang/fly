namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenLLVM
import fly.compiler.codegen.CodeGenType
import fly.compiler.codegen.CodeGenExprOps
import fly.compiler.codegen.CodeGenStmt
import fly.compiler.codegen.CodeGenCall
import fly.compiler.codegen.CodeGenClass
import fly.compiler.codegen.CodeGenError
import llvm.api.*
import fly.mem
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenExpr — the SemaVisitor that lowers a function body. It implements the
// whole SemaVisitor (statements + expressions); Stage 2 fills in expressions and
// the minimal statement scaffolding (block / expr-stmt / return) needed to observe
// them, leaving control-flow statements stubbed for Stage 3.
//
// Each expr visit stores its LLVM value on the node (SemaExpr.llvmValue); gen()
// reads it back. addrMode flips a variable visit between LOAD (rvalue) and its
// storage address (lvalue, for an assignment LHS). It holds the CodeGenModule
// one-directionally (no stored back-reference from CodeGenModule → no cycle).
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenExpr : SemaVisitor {

    CodeGenModule cgm
    LLVM llvm
    pointer builder
    bool addrMode
    bool terminated            // current block already has a terminator?
    pointer breakTarget    // innermost loop/switch exit block
    pointer continueTarget // innermost loop post block
    pointer errPtr         // current function's error-handler pointer (LLVM param 0)
    pointer caseEndBB      // inside a suite `case`: the end block a fail jumps to
                           // after any statement (fail-fast per case). 0 = not in a case.
    pointer lastErrPtr     // alloca i32: code of the LAST handle block (implicit `error` var)
    pointer handleSafe     // innermost handle's continuation block (0 = not in a handle)
    string lastStrLit      // text of the last string LITERAL gen'd (bridge symbol capture)
    string traceName       // --trace-calls: this function's pretty name; "" = not traced
                           // (set by CodeGenTrace.emitEnter, read by the exit hooks)
    pointer outSlot        // class-return: the `out` param's slot (a ptr to the return
                           // slot). Its stored value is the RETURNED heap handle, which
                           // must NOT be freed at scope exit (ownership escapes). 0 = the
                           // function does not return a class (free every owned handle).

    public CodeGenExpr(const CodeGenModule cgm) {
        this.cgm = cgm
        CodeGenLLVM c = cgm.getCg()
        this.llvm = c.getLLVM()
        this.builder = cgm.getBuilder()
        this.addrMode = false
        this.terminated = false
        this.breakTarget = 0
        this.continueTarget = 0
        this.errPtr = 0
        this.caseEndBB = 0
        this.lastErrPtr = 0
        this.handleSafe = 0
        this.lastStrLit = ""
        this.traceName = ""
        this.outSlot = 0
    }
    public string getTraceName() { out = this.traceName }
    public void setTraceName(const string n) { this.traceName = n }
    public void setOutSlot(const pointer p) { this.outSlot = p }
    // bindOutSlot — if the function returns a CLASS/INTERFACE handle, record its synthetic
    // `out` param's slot so scope-exit cleanup can spare the returned handle. Called after
    // the param allocas are bound. No-op for void/struct/primitive returns.
    public void bindOutSlot(const List<SemaParam> params) {
        int i = 0
        while i < params.size() {
            SemaParam p = params.get(i)
            if str.equals(p.getName(), "out") {
                SemaType pt = p.getType()
                if pt != null {
                    SemaClassType pc = pt.asClass()
                    if pc != null {
                        if pc.getClassKind() != SemaClassKind.STRUCT { this.outSlot = p.getLlvmAlloca() }
                    }
                }
            }
            i = i + 1
        }
    }
    public pointer getLastErrPtr() { out = this.lastErrPtr }
    public void setLastErrPtr(const pointer p) { this.lastErrPtr = p }
    public pointer getHandleSafe() { out = this.handleSafe }
    public void setHandleSafe(const pointer b) { this.handleSafe = b }
    // getLastStrLit — the compile-time text of the most recently gen'd string
    // literal: lets the CLang bridge read `call("strlen", …)`'s symbol without a
    // SemaStringValue downcast (none exists) or a new base virtual (vtable-shift).
    public string getLastStrLit() { out = this.lastStrLit }
    public pointer getErrPtr() { out = this.errPtr }
    public void setErrPtr(const pointer p) { this.errPtr = p }

    public CodeGenModule getCgm() { out = this.cgm }
    public LLVM getLLVM() { out = this.llvm }
    public pointer getBuilder() { out = this.builder }
    public bool isAddrMode() { out = this.addrMode }

    // ── basic-block / control-flow helpers ────────────────────────────────────
    public bool isTerminated() { out = this.terminated }
    public void setTerminated(const bool t) { this.terminated = t }
    public pointer getBreakTarget() { out = this.breakTarget }
    public void setBreakTarget(const pointer b) { this.breakTarget = b }
    public pointer getContinueTarget() { out = this.continueTarget }
    public void setContinueTarget(const pointer b) { this.continueTarget = b }

    // position the builder at the end of a block and clear the terminated flag.
    public void position(const pointer bb) {
        this.llvm.positionBuilderAtEnd(this.builder, bb)
        this.terminated = false
    }

    // newBlock — append a fresh basic block to the current function.
    public pointer newBlock(const string name) {
        pointer cur
        this.llvm.getInsertBlock(this.builder, cur)
        pointer fn
        this.llvm.getBasicBlockParent(cur, fn)
        pointer bb
        this.llvm.appendBasicBlockInContext(this.cgm.getCtx(), fn, name, bb)
        out = bb
    }

    // br — branch to dest if the current block isn't already terminated.
    public void br(const pointer dest) {
        if this.terminated == false {
            pointer v
            this.llvm.buildBr(this.builder, dest, v)
            this.terminated = true
        }
    }

    // type helpers (avoid chaining cgm.getTypes().lowerType(...) on a call result)
    public pointer lowerType(const SemaType t) {
        CodeGenType ct = this.cgm.getTypes()
        out = ct.lowerType(t)
    }
    public pointer ptrType() {
        CodeGenType ct = this.cgm.getTypes()
        out = ct.ptrType()
    }

    // ── numeric coercion (shared by decl/assign/arith/compare/args/ternary) ────
    // The resolver computes promoted RESULT types but never inserts operand casts,
    // so every consumer of a gen'd value must bring it to the expected numeric
    // type itself. These three helpers centralise that (mirrors the reference's
    // CodeGenExpr::ConvertNumber).

    // numWidth — lowered bit width for a numeric rank. Ranks encode width AND
    // signedness (odd = signed of the next even width: short 15→i16, int 31→i32,
    // long 63→i64), so rank comparison alone would emit same-width sext/trunc.
    public int numWidth(const SemaType t) {
        int w = t.getRank()
        if w % 2 == 1 { w = w + 1 }
        out = w
    }

    // isUnsignedInt — integer with an even rank (byte/ushort/uint/ulong/pointer).
    public bool isUnsignedInt(const SemaType t) {
        bool r = false
        if t != null {
            if t.isInteger() {
                if t.getRank() % 2 == 0 { r = true }
            }
        }
        out = r
    }

    // coerce — bring `val` (typed `from`) to numeric type `to`: zext/sext/trunc
    // for integer width changes (extension follows the SOURCE signedness),
    // si/uitofp for int→float, fpext/fptrunc for float widths, fptosi for
    // float→int. Anything non-numeric (or already the right width) is unchanged.
    public pointer coerce(const pointer val, const SemaType from, const SemaType to) {
        pointer r = val
        if val == 0 { out = r  return }
        if from == null { out = r  return }
        if to == null { out = r  return }
        if from.isNumber() == false { out = r  return }
        if to.isNumber() == false { out = r  return }
        bool ff = from.isFloat()
        bool tf = to.isFloat()
        pointer destTy = this.lowerType(to)
        if ff {
            if tf {
                if to.getRank() > from.getRank() {
                    this.llvm.buildFPExt(this.builder, val, destTy, "cofpx", r)
                } elsif to.getRank() < from.getRank() {
                    this.llvm.buildFPTrunc(this.builder, val, destTy, "cofpt", r)
                }
            } else {
                this.llvm.buildFPToSI(this.builder, val, destTy, "cofsi", r)
            }
        } else {
            if tf {
                if this.isUnsignedInt(from) {
                    this.llvm.buildUIToFP(this.builder, val, destTy, "couif", r)
                } else {
                    this.llvm.buildSIToFP(this.builder, val, destTy, "cosif", r)
                }
            } else {
                int fw = this.numWidth(from)
                int tw = this.numWidth(to)
                if tw > fw {
                    if this.isUnsignedInt(from) {
                        this.llvm.buildZExt(this.builder, val, destTy, "cozx", r)
                    } else {
                        this.llvm.buildSExt(this.builder, val, destTy, "cosx", r)
                    }
                } elsif tw < fw {
                    this.llvm.buildTrunc(this.builder, val, destTy, "cotr", r)
                }
            }
        }
        out = r
    }

    // gen — codegen an expression as an rvalue, returning its LLVM value.
    public pointer gen(const SemaExpr e) {
        this.addrMode = false
        e.accept(this)
        out = e.getLlvmValue()
    }

    // genAddr — codegen an expression as an lvalue, returning its storage address.
    public pointer genAddr(const SemaExpr e) {
        this.addrMode = true
        e.accept(this)
        this.addrMode = false
        out = e.getLlvmValue()
    }

    // ── statements (minimal for Stage 2) ──────────────────────────────────────
    public void visit(const SemaBlockStmt node) {
        List<SemaStmt> content = node.getContent()
        int i = 0
        while i < content.size() {
            SemaStmt s = content.get(i)
            s.accept(this)
            // Fail-fast per case: inside a suite `case`, if a statement left an
            // error in the case's slot, jump to the case end so later statements
            // never run (reference: visit(SemaBlockStmt) checks after each stmt
            // while CurrentCaseEndBB is set). Only the FIRST failure of the case
            // is reported. NOT inside a `handle` block: a callee fail there is
            // the handle's to consume (emitHandle step 3), and jumping to the
            // case end first would report a HANDLED error as a case failure —
            // matching standalone semantics, where the handle block always runs
            // to completion and the caught error never escapes.
            if this.caseEndBB != 0 {
                if this.terminated == false {
                    if this.handleSafe == 0 {
                        this.emitCaseFailFast()
                    }
                }
            }
            i = i + 1
        }
        // Stage 7: on fall-through, free this scope's owned heap class handles. (A
        // terminating return inside the block skips this — early-return cleanup is a
        // follow-up; the milestone programs fall through.)
        if this.terminated == false {
            List<SemaLocalVar> allocs = node.getAllocs()
            // The RETURNED heap handle escapes: `C mk(){ C c=new C() out=c }` stores c into
            // the out slot and must NOT free it (else the caller gets a dangling pointer —
            // e.g. fly.os.io.fileWriter → printLn crashed). For a class-returning function,
            // load the out slot's value and free every owned handle EXCEPT that one.
            pointer outVal = 0
            if this.outSlot != 0 {
                pointer ptrTy = this.ptrType()
                this.llvm.buildLoad2(this.builder, ptrTy, this.outSlot, "retv", outVal)
            }
            int j = 0
            while j < allocs.size() {
                SemaLocalVar v = allocs.get(j)
                // ESCAPED handles (passed as a call argument or assigned away —
                // see the Stage-7 escape marking in ResolverCall/ResolverExpr)
                // may be retained elsewhere: freeing them here left dangling
                // handles inside containers (LockfileSuite segfault).
                if v.isEscaped() == false {
                    SemaType vty = v.getType()
                    bool isStr = false
                    if vty != null { isStr = vty.isString() }
                    if isStr {
                        // String local: free its owned heap buffer (field 0 of the
                        // {ptr,size} struct). Under clone-on-store it owns the buffer
                        // uniquely; a returned string was CLONED into the out slot
                        // (value semantics), so freeing the local never touches the
                        // caller's copy — no out-slot compare needed (unlike class
                        // handles below). free(null) covers the empty {null,0} case.
                        pointer salloca = v.getLlvmAlloca()
                        pointer strTy2 = this.cgm.getStringTy()
                        pointer sval2
                        this.llvm.buildLoad2(this.builder, strTy2, salloca, "sfreeld", sval2)
                        pointer sptr2
                        this.llvm.buildExtractValue(this.builder, sval2, 0, "sfreep", sptr2)
                        this.cgm.freeHandle(sptr2)
                        j = j + 1
                        continue
                    }
                    // Array local: drop ONE reference to its buffer. The block goes
                    // back only when the count reaches zero, so two names over one
                    // buffer release twice and free once. Handled here, before the
                    // out-slot compare below: a returned array needs no such compare
                    // because `out = xs` RETAINED it, so this release just undoes
                    // this frame's own reference — the same reasoning as strings,
                    // which are cloned into the out slot.
                    bool isArr = false
                    if vty != null { isArr = vty.isArray() }
                    if isArr {
                        CodeGenArray.emitRelease(this, v.getLlvmAlloca(), vty.asArray())
                        j = j + 1
                        continue
                    }
                    pointer alloca = v.getLlvmAlloca()
                    pointer ty = this.lowerType(v.getType())
                    pointer objPtr
                    this.llvm.buildLoad2(this.builder, ty, alloca, "freeld", objPtr)
                    if this.outSlot != 0 {
                        pointer cmp
                        this.llvm.buildICmp(this.builder, 33, objPtr, outVal, "retcmp", cmp)  // NE
                        pointer freeBB = this.newBlock("free.do")
                        pointer skipBB = this.newBlock("free.skip")
                        pointer cbr
                        this.llvm.buildCondBr(this.builder, cmp, freeBB, skipBB, cbr)
                        this.position(freeBB)
                        this.cgm.freeHandle(objPtr)
                        this.br(skipBB)
                        this.position(skipBB)
                    } else {
                        this.cgm.freeHandle(objPtr)
                    }
                }
                j = j + 1
            }
        }
    }
    public void visit(const SemaExprStmt node) {
        SemaExpr e = node.getExpr()
        if e != null { e.accept(this) }
    }
    public void visit(const SemaReturnStmt node) { CodeGenStmt.ret(this, node) }
    public void visit(const SemaDeclStmt node) { CodeGenStmt.decl(this, node) }
    public void visit(const SemaIfStmt node) { CodeGenStmt.ifStmt(this, node) }
    public void visit(const SemaLoopStmt node) { CodeGenStmt.loopStmt(this, node) }
    public void visit(const SemaSwitchStmt node) { CodeGenStmt.switchStmt(this, node) }
    public void visit(const SemaBreakStmt node) { CodeGenStmt.breakStmt(this, node) }
    public void visit(const SemaContinueStmt node) { CodeGenStmt.continueStmt(this, node) }

    // ── value expressions ─────────────────────────────────────────────────────
    public void visit(const SemaIntValue node) {
        pointer ty = this.lowerType(node.getType())
        long v = parseLong(node.getValue())
        pointer c
        this.llvm.constInt(ty, v, true, c)
        node.setLlvmValue(c)
    }
    public void visit(const SemaBoolValue node) {
        pointer ty = this.lowerType(node.getType())
        long v = 0
        if node.getValue() { v = 1 }
        pointer c
        this.llvm.constInt(ty, v, false, c)
        node.setLlvmValue(c)
    }
    public void visit(const SemaFloatValue node) {
        pointer ty = this.lowerType(node.getType())
        double d = parseDouble(node.getValue())
        pointer c
        this.llvm.constReal(ty, d, c)
        node.setLlvmValue(c)
    }
    public void visit(const SemaNullValue node) {
        pointer ty = this.ptrType()
        pointer c
        this.llvm.constPointerNull(ty, c)
        node.setLlvmValue(c)
    }

    // ── variable references (load rvalue, or address in addrMode) ──────────────
    public void visit(const SemaParam node) { this.genVarAccess(node) }
    public void visit(const SemaLocalVar node) { this.genVarAccess(node) }
    public void visit(const SemaClassInstance node) { this.genVarAccess(node) }
    public void visit(const SemaClassAttribute node) { this.genAttrAccess(node) }
    // Subscript: the element ADDRESS in addrMode, the loaded element otherwise —
    // one node, both directions (A6 fills CodeGenArray.arrayAccess in).
    public void visit(const SemaArrayAccess node) { CodeGenArray.arrayAccess(this, node) }
    // the implicit `error` variable: true when the LAST handle block recorded a
    // failure (lasterr != 0). handle blocks update the per-function lasterr slot.
    public void visit(const SemaError node) {
        pointer i32t
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32t)
        pointer lv
        this.llvm.buildLoad2(this.builder, i32t, this.lastErrPtr, "lerr", lv)
        pointer zero
        this.llvm.constInt(i32t, 0, true, zero)
        pointer cmp
        this.llvm.buildICmp(this.builder, 33, lv, zero, "eset", cmp)   // NE
        node.setLlvmValue(cmp)
    }

    public void genVarAccess(const SemaVar v) {
        pointer addr = v.getLlvmAlloca()
        if this.addrMode {
            v.setLlvmValue(addr)
        } else {
            pointer ty = this.lowerType(v.getType())
            pointer loaded
            this.llvm.buildLoad2(this.builder, ty, addr, "ld", loaded)
            v.setLlvmValue(loaded)
        }
    }

    // genAttrAccess — a BARE instance-field reference (`fd` for `this.fd`, no explicit
    // `this.`). Unlike a local/param, an attribute has no alloca: its storage is a field
    // of the current method's `this`. Load `this` (its instance slot, set in
    // genMethodBody), GEP the field, then load/return the address. Mirrors the reference
    // GenExpr(SemaClassAttribute). (Own fields only; inherited bare fields resolve
    // through the declaring class's `this`, valid under the flat object layout.)
    public void genAttrAccess(const SemaClassAttribute a) {
        SemaClassType cls = a.getClass()
        SemaClassInstance ti = cls.getThis()
        pointer thisSlot = ti.getLlvmAlloca()
        pointer ptrTy = this.ptrType()
        pointer thisPtr
        this.llvm.buildLoad2(this.builder, ptrTy, thisSlot, "this", thisPtr)
        pointer structTy = cls.getLlvmStructType()
        int idx = CodeGenClass.fieldIndex(cls, a.getName())
        pointer fldPtr
        this.llvm.buildStructGEP2(this.builder, structTy, thisPtr, idx, "fld", fldPtr)
        if this.addrMode {
            a.setLlvmValue(fldPtr)
        } else {
            SemaType at = a.getType()
            SemaClassType ac = at.asClass()
            if ac != null {
                if ac.getClassKind() == SemaClassKind.STRUCT {
                    // STRUCT field: inline aggregate (CodeGenClass.fieldLlvmType);
                    // the slot address IS the struct value — same rule as
                    // CodeGenClass.member.
                    a.setLlvmValue(fldPtr)
                    return
                }
            }
            pointer fty = this.lowerType(a.getType())
            pointer loaded
            this.llvm.buildLoad2(this.builder, fty, fldPtr, "fldv", loaded)
            a.setLlvmValue(loaded)
        }
    }

    // ── binary ────────────────────────────────────────────────────────────────
    public void visit(const SemaBinary node) {
        ASTBinary ba = node.getAST()
        ASTBinaryKind k = ba.getBinaryKind()
        if k == ASTBinaryKind.OP_BINARY_ASSIGN {
            CodeGenExprOps.assign(this, node)
        } elsif ba.isCompoundAssign() {
            CodeGenExprOps.compoundAssign(this, node, k)
        } elsif k == ASTBinaryKind.OP_BINARY_LOGIC_AND {
            CodeGenExprOps.logic(this, node, k)
        } elsif k == ASTBinaryKind.OP_BINARY_LOGIC_OR {
            CodeGenExprOps.logic(this, node, k)
        } elsif ba.isArith() {
            CodeGenExprOps.arith(this, node, k)
        } else {
            CodeGenExprOps.compare(this, node, k)
        }
    }

    public void visit(const SemaUnary node) { CodeGenExprOps.unary(this, node) }
    public void visit(const SemaCast node) { CodeGenExprOps.cast(this, node) }
    public void visit(const SemaTernary node) { CodeGenExprOps.ternary(this, node) }

    // ── calls + member access ─────────────────────────────────────────────────
    public void visit(const SemaCall node) {
        if node.isNew() {
            CodeGenClass.genNew(this, node)
        } elsif node.getParent() != null {
            CodeGenClass.methodCall(this, node)
        } else {
            CodeGenCall.call(this, node)
        }
    }
    public void visit(const SemaMember node) { CodeGenClass.member(this, node) }

    // ── enums (each entry is its integer index, lowered to i32) ───────────────
    public void visit(const SemaEnumEntry node) {
        pointer ty = this.lowerType(node.getType())
        long idx = node.getIndex()
        pointer c
        this.llvm.constInt(ty, idx, true, c)
        node.setLlvmValue(c)
    }
    // enum property access — mirrors the reference's GenExpr(SemaEnumAccessor):
    //   .value on a literal entry  → constant i32 index
    //   .value on a variable/chain → the receiver's loaded i32 (the enum IS its value)
    //   .name  on a literal entry  → constant %string
    //   .name  on a variable/chain → load from the enum's names table by value
    public void visit(const SemaEnumAccessor node) {
        SemaEnumEntry e = node.getEntry()
        CodeGenLLVM cg = this.cgm.getCg()

        if node.isName() == false {
            if e != null {
                pointer ty = this.lowerType(node.getType())
                pointer c
                this.llvm.constInt(ty, e.getIndex(), true, c)
                node.setLlvmValue(c)
            } else {
                pointer rv = this.gen(node.getParent())
                node.setLlvmValue(rv)
            }
            return
        }

        pointer strTy = this.cgm.getStringTy()
        pointer i32n
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32n)
        if e != null {
            string nm = e.getName()
            pointer g = cg.globalString(this.cgm.getModule(), this.cgm.getCtx(), nm)
            pointer lenC
            this.llvm.constInt(i32n, str.len(nm), false, lenC)
            List<pointer> fields = new List<pointer>()
            fields.add(g)
            fields.add(lenC)
            pointer sv
            cg.constNamedStructN(strTy, fields, sv)
            node.setLlvmValue(sv)
            return
        }

        // runtime name: GEP into the per-enum names table by the loaded value
        pointer idx = this.gen(node.getParent())
        SemaEnumType en = node.getEnumType()
        pointer table = this.cgm.enumNamesTable(en)
        List<SemaNode> ens = en.getNodes()
        int n = (int)ens.size()
        pointer arrTy
        this.llvm.arrayType(strTy, n + 1, arrTy)
        pointer i32t
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32t)
        pointer zero
        this.llvm.constInt(i32t, 0, false, zero)
        List<pointer> idxs = new List<pointer>()
        idxs.add(zero)
        idxs.add(idx)
        pointer slot
        cg.buildGEP2N(this.builder, arrTy, table, idxs, "enname", slot)
        pointer loaded
        this.llvm.buildLoad2(this.builder, strTy, slot, "ennm", loaded)
        node.setLlvmValue(loaded)
    }

    // ── error handling ────────────────────────────────────────────────────────
    public void visit(const SemaFailStmt node) { CodeGenError.emitFail(this, node) }
    public void visit(const SemaHandleStmt node) { CodeGenError.emitHandle(this, node) }

    // ── stubbed (later stages) ────────────────────────────────────────────────
    public void visit(const SemaEnumList node) { }

    // string literal → a private `[N x i8]` global + a constant %string { ptr, len }.
    public void visit(const SemaStringValue node) {
        string val = node.getValue()
        this.lastStrLit = val
        int len = str.len(val)
        CodeGenLLVM cg = this.cgm.getCg()
        pointer g = cg.globalString(this.cgm.getModule(), this.cgm.getCtx(), val)
        pointer i32len
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32len)
        pointer lenC
        this.llvm.constInt(i32len, len, false, lenC)
        List<pointer> fields = new List<pointer>()
        fields.add(g)
        fields.add(lenC)
        pointer strTy = this.cgm.getStringTy()
        pointer sv
        cg.constNamedStructN(strTy, fields, sv)
        node.setLlvmValue(sv)
    }
    public void visit(const SemaComplexValue node) { }
    public void visit(const SemaArrayValue node) { CodeGenArray.arrayValue(this, node) }
    public void visit(const SemaStructValue node) { CodeGenClass.structValue(this, node) }
    // unset — lower to a typed zero. The empty visit left llvmValue = 0, and a
    // null handle reaching buildStore/buildRet crashes inside libLLVM.
    public void visit(const SemaUnsetValue node) {
        SemaType t = node.getType()
        pointer c = 0
        if t != null {
            if t.isFloat() {
                pointer fty = this.lowerType(t)
                this.llvm.constReal(fty, 0.0, c)
            } elsif t.isNumber() || t.isBool() || t.isEnum() {
                pointer ity = this.lowerType(t)
                this.llvm.constInt(ity, 0, false, c)
            } else {
                pointer pty = this.ptrType()
                this.llvm.constPointerNull(pty, c)
            }
        } else {
            pointer pty2 = this.ptrType()
            this.llvm.constPointerNull(pty2, c)
        }
        node.setLlvmValue(c)
    }
    public void visit(const SemaLoopInStmt node) { CodeGenArray.loopIn(this, node) }
    public void visit(const SemaDeleteStmt node) { }

    // emitCaseFailFast — called after each statement of a case body: if the case's
    // %error slot holds a code, branch to the case end (skipping the rest). Else
    // continue in a fresh block. Assumes this.caseEndBB != 0 and this.errPtr is the
    // case slot.
    public void emitCaseFailFast() {
        pointer errTy = this.cgm.getErrorTy()
        pointer i32
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32)
        pointer zero
        this.llvm.constInt(i32, 0, true, zero)
        pointer codeP
        this.llvm.buildStructGEP2(this.builder, errTy, this.errPtr, 0, "ffc", codeP)
        pointer code
        this.llvm.buildLoad2(this.builder, i32, codeP, "ffcode", code)
        pointer hasErr
        this.llvm.buildICmp(this.builder, 33, code, zero, "ffhas", hasErr)   // NE
        pointer cont = this.newBlock("case.ffcont")
        pointer cbr
        this.llvm.buildCondBr(this.builder, hasErr, this.caseEndBB, cont, cbr)
        this.terminated = true
        this.position(cont)
    }

    // case — a suite test case: `suite_case_begin(label)`, then the body run under
    // the METHOD's error handler (this.errPtr) with per-statement fail-fast
    // (this.caseEndBB), then `suite_case_result(code, msg)` and, on failure, bump
    // __fly_suite_failed. __fly_suite_total is bumped up front. Mirrors the
    // reference CodeGenModule::visit(SemaCaseStmt): the case uses the method's
    // handler (the shared suite %error passed as arg 0) — zeroed on entry, consumed
    // on exit — so a `fail` reached through an assert call OR written directly in
    // the case body both land in it. A direct `fail` returns from the method (its
    // RetVoid) before the case-end report; the runner's CheckEscaped then reports
    // it as a "body" failure — matching the reference.
    public void visit(const SemaCaseStmt node) {
        string label = node.getLabel()
        pointer bb = this.newBlock(str.concat("case.", label))
        this.br(bb)
        this.position(bb)

        pointer i32
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32)
        pointer zero
        this.llvm.constInt(i32, 0, true, zero)
        pointer pty = this.ptrType()

        // suite_case_begin(label) — prints "    <label> ...", no newline.
        List<pointer> lblTy = new List<pointer>()
        lblTy.add(pty)
        List<pointer> beginArgs = new List<pointer>()
        beginArgs.add(this.cgm.cstr(label))
        this.cgm.callVoidRt("suite_case_begin", lblTy, beginArgs)

        // Per-case isolation: zero the METHOD's error slot on entry (fresh window).
        pointer errTy = this.cgm.getErrorTy()
        pointer errSlot = this.errPtr
        this.cgm.zeroErrSlot(errSlot)
        this.cgm.incrSuiteCounter(this.cgm.suiteCounter("__fly_suite_total"))

        // Run the body under the fail-fast target (this.errPtr stays the method slot).
        pointer endBB = this.newBlock(str.concat("case.end.", label))
        pointer savedEnd = this.caseEndBB
        this.caseEndBB = endBB
        SemaBlockStmt body = node.getBody()
        if body != null { body.accept(this) }
        this.caseEndBB = savedEnd
        this.br(endBB)
        this.position(endBB)

        // Report the outcome: suite_case_result(code, msg).
        pointer endCodeP
        this.llvm.buildStructGEP2(this.builder, errTy, errSlot, 0, "endc", endCodeP)
        pointer endCode
        this.llvm.buildLoad2(this.builder, i32, endCodeP, "endcode", endCode)
        pointer endMsgP
        this.llvm.buildStructGEP2(this.builder, errTy, errSlot, 1, "endm", endMsgP)
        pointer endMsg
        this.llvm.buildLoad2(this.builder, pty, endMsgP, "endmsg", endMsg)
        List<pointer> resTy = new List<pointer>()
        resTy.add(i32)
        resTy.add(pty)
        List<pointer> resArgs = new List<pointer>()
        resArgs.add(endCode)
        resArgs.add(endMsg)
        this.cgm.callVoidRt("suite_case_result", resTy, resArgs)

        // On failure, count it and clear the slot before the next case.
        pointer hasErr
        this.llvm.buildICmp(this.builder, 33, endCode, zero, "endne", hasErr)   // NE
        pointer failBB = this.newBlock(str.concat("case.fail.", label))
        pointer contBB = this.newBlock(str.concat("case.cont.", label))
        pointer cbr
        this.llvm.buildCondBr(this.builder, hasErr, failBB, contBB, cbr)
        this.terminated = true
        this.position(failBB)
        this.cgm.incrSuiteCounter(this.cgm.suiteCounter("__fly_suite_failed"))
        this.cgm.zeroErrSlot(errSlot)
        this.br(contBB)
        this.position(contBB)
    }

    // test — an inline `test {}` block, gated at RUN TIME on the thread-local
    // test-context pointer being non-null (the suite runner / --test main holds
    // it open; a production binary leaves it null, so the body is skipped).
    // Mirrors the reference CodeGenModule::visit(SemaTestStmt); the Resolver
    // already stripped the statement entirely when not compiling under --test.
    public void visit(const SemaTestStmt node) {
        pointer tls = this.cgm.getTestCtxPtr()
        pointer pty = this.ptrType()
        pointer ctxV
        this.llvm.buildLoad2(this.builder, pty, tls, "test_ctx", ctxV)
        pointer nullP
        this.llvm.constPointerNull(pty, nullP)
        pointer isNull
        this.llvm.buildICmp(this.builder, 32, ctxV, nullP, "ctx_isnull", isNull)   // EQ

        pointer bodyBB = this.newBlock("testbody")
        pointer mergeBB = this.newBlock("testmerge")
        pointer cb
        this.llvm.buildCondBr(this.builder, isNull, mergeBB, bodyBB, cb)
        this.terminated = true

        this.position(bodyBB)
        SemaBlockStmt body = node.getBody()
        if body != null { body.accept(this) }
        this.br(mergeBB)
        this.position(mergeBB)
    }
}

// ── literal parsing helpers (free functions; intrinsic byte access) ─────────────
public long parseLong(const string s) {
    long r = 0
    int n = str.len(s)
    int i = 0
    bool neg = false
    if n > 0 {
        byte b0 = 0
        str.byteAt(s, 0, b0)
        if b0 == 45 { neg = true  i = 1 }   // '-'
    }
    while i < n {
        byte b = 0
        str.byteAt(s, i, b)
        int bi = b
        if bi >= 48 {
            if bi <= 57 {
                long d = bi - 48
                r = r * 10 + d
            }
        }
        i = i + 1
    }
    if neg { r = 0 - r }
    out = r
}

public double parseDouble(const string s) {
    // integer + fractional parts split on '.'; minimal (no exponent) for Stage 2.
    int dot = str.indexOf(s, ".")
    double result = 0.0
    if dot < 0 {
        result = parseLong(s)
    } else {
        string ip = str.substring(s, 0, dot)
        int n = str.len(s)
        string fp = str.substring(s, dot + 1, n)
        double whole = parseLong(ip)
        double frac = 0.0
        double scale = 1.0
        int fn = str.len(fp)
        int i = 0
        while i < fn {
            byte b = 0
            str.byteAt(fp, i, b)
            int bi = b
            double d = bi - 48
            scale = scale * 10.0
            frac = frac + d / scale
            i = i + 1
        }
        result = whole + frac
    }
    out = result
}
