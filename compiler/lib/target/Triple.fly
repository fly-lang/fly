namespace fly.compiler.target
import fly.compiler.target.*
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// Triple — a target triple value object, a minimal re-implementation of the
// slice of llvm::Triple the compiler actually uses (arch / 64-bit / endianness /
// OS). LLVM's own Triple is C++-only and cannot be reached from the self-host,
// so the canonical "arch-vendor-os-environment" string is parsed here directly.
//
// Faithful port adaptations (see compiler/basic/SourceLocation.fly for the full
// list of self-host limitations):
//   • No static member functions → llvm::Triple::normalize / the constructor's
//     parsing become the free factory `tripleParse(string)`.
//   • No enum-method overloading  → arch is a plain `Arch` enum; queries are
//     ordinary methods.
//
// Only x86_64 is recognised (the bootstrap target). Every other arch parses to
// Arch.UNKNOWN, which TargetInfo turns into a diagnostic.
// ─────────────────────────────────────────────────────────────────────────────

// Arch — the architecture component of a triple. One value per LLVM arch token
// the self-host recognises (the canonical token; aliases map in archFromName).
public enum Arch {
    UNKNOWN,
    X86, X86_64,
    AARCH64, AARCH64_BE,
    ARM, ARMEB,
    MIPS, MIPSEL, MIPS64, MIPS64EL,
    PPC, PPC64, PPC64LE,
    RISCV32, RISCV64,
    SPARC, SPARCV9,
    SYSTEMZ,
    WASM32, WASM64,
    BPFEL, BPFEB,
    NVPTX, NVPTX64,
    AMDGCN, R600,
    AVR, MSP430,
    HEXAGON, LANAI, LE64, ARC, XCORE,
    SPIR, SPIR64,
    TCE, TCELE,
    VE
}

public class Triple {
    string full        // the original/normalised triple string
    Arch arch
    string archName    // raw arch token (e.g. "x86_64")
    string vendor      // e.g. "unknown", "pc", "apple"
    string os          // e.g. "linux", "darwin", "windows"
    string env         // e.g. "gnu", "musl", "" (may be empty)

    public Triple(const string full, const Arch arch, const string archName,
                  const string vendor, const string os, const string env) {
        this.full = full
        this.arch = arch
        this.archName = archName
        this.vendor = vendor
        this.os = os
        this.env = env
    }

    // getTriple — the full triple string (llvm::Triple::getTriple / str()).
    public string getTriple() { return this.full }

    public Arch getArch()        { return this.arch }
    public string getArchName()  { return this.archName }
    public string getVendorName(){ return this.vendor }
    public string getOSName()    { return this.os }
    public string getEnvName()   { return this.env }

    public bool isOSLinux()      { return str.equals(this.os, "linux") }
    public bool isKnown()        { return this.arch != Arch.UNKNOWN }

    // ── Query helpers consumed by the ToolChain port (1:1 with llvm::Triple) ──
    public bool isOSDarwin() {
        return str.equals(this.os, "darwin") || str.equals(this.os, "macosx") || str.equals(this.os, "ios")
    }
    public bool isWindowsMSVC() {
        return str.equals(this.os, "windows") && str.equals(this.env, "msvc")
    }
    public bool isOSWindows() { return str.equals(this.os, "windows") }
    public bool isAndroid()  { return str.contains(this.env, "android") }
    public bool isOSIAMCU()  { return str.equals(this.os, "elfiamcu") }
    public bool isVE()       { return this.arch == Arch.VE }
    public bool isARM()      { return this.arch == Arch.ARM || this.arch == Arch.ARMEB }
    public bool isThumb()    { return false }   // self-host has no separate thumb arch token
    public bool isAArch64()  { return this.arch == Arch.AARCH64 || this.arch == Arch.AARCH64_BE }
    public bool isArmBigEndian() { return this.arch == Arch.ARMEB }
    // Object format: ELF unless Darwin (Mach-O) or Windows (COFF). ALL Windows
    // environments (msvc AND gnu/gnullvm) emit PE/COFF, not just -msvc.
    public bool isOSBinFormatELF()   { return this.isOSDarwin() == false && this.isOSWindows() == false }
    public bool isOSBinFormatMachO() { return this.isOSDarwin() }
    public bool isOSBinFormatCOFF()  { return this.isOSWindows() }
    // x32 ABI (32-bit pointers on x86_64). env == "gnux32".
    public bool isX32()      { return str.equals(this.env, "gnux32") }

    // isArch64Bit — true for the 64-bit-pointer arches (used by getOSLibDir).
    public bool isArch64Bit() {
        return this.arch == Arch.X86_64 || this.arch == Arch.AARCH64 || this.arch == Arch.AARCH64_BE
           || this.arch == Arch.MIPS64 || this.arch == Arch.MIPS64EL
           || this.arch == Arch.PPC64 || this.arch == Arch.PPC64LE
           || this.arch == Arch.RISCV64 || this.arch == Arch.SPARCV9 || this.arch == Arch.SYSTEMZ
           || this.arch == Arch.WASM64 || this.arch == Arch.BPFEL || this.arch == Arch.BPFEB
           || this.arch == Arch.NVPTX64 || this.arch == Arch.AMDGCN || this.arch == Arch.LE64
           || this.arch == Arch.SPIR64 || this.arch == Arch.VE
    }
    public bool isArch32Bit() { return this.isArch64Bit() == false }
}

// archFromName — map the raw arch token onto the Arch enum, accepting the
// canonical token plus the common aliases LLVM's parseArch recognises. The
// `eq` helper keeps the long chain readable.
public bool archEq(const string a, const string b) { return str.equals(a, b) }

public Arch archFromName(const string name) {
    // x86 family
    if archEq(name, "x86_64") || archEq(name, "amd64")           { return Arch.X86_64 }
    if archEq(name, "x86") || archEq(name, "i386") || archEq(name, "i486") || archEq(name, "i586") || archEq(name, "i686") { return Arch.X86 }
    // aarch64
    if archEq(name, "aarch64") || archEq(name, "arm64")          { return Arch.AARCH64 }
    if archEq(name, "aarch64_be")                                { return Arch.AARCH64_BE }
    // arm
    if archEq(name, "arm") || archEq(name, "thumb")              { return Arch.ARM }
    if archEq(name, "armeb") || archEq(name, "thumbeb")          { return Arch.ARMEB }
    // mips
    if archEq(name, "mips")                                      { return Arch.MIPS }
    if archEq(name, "mipsel")                                    { return Arch.MIPSEL }
    if archEq(name, "mips64")                                    { return Arch.MIPS64 }
    if archEq(name, "mips64el")                                  { return Arch.MIPS64EL }
    // powerpc
    if archEq(name, "ppc") || archEq(name, "powerpc")           { return Arch.PPC }
    if archEq(name, "ppc64") || archEq(name, "powerpc64")       { return Arch.PPC64 }
    if archEq(name, "ppc64le") || archEq(name, "powerpc64le")   { return Arch.PPC64LE }
    // riscv
    if archEq(name, "riscv32")                                   { return Arch.RISCV32 }
    if archEq(name, "riscv64")                                   { return Arch.RISCV64 }
    // sparc
    if archEq(name, "sparc")                                     { return Arch.SPARC }
    if archEq(name, "sparcv9") || archEq(name, "sparc64")       { return Arch.SPARCV9 }
    // systemz
    if archEq(name, "systemz") || archEq(name, "s390x")         { return Arch.SYSTEMZ }
    // wasm
    if archEq(name, "wasm32")                                    { return Arch.WASM32 }
    if archEq(name, "wasm64")                                    { return Arch.WASM64 }
    // bpf
    if archEq(name, "bpfel") || archEq(name, "bpf")             { return Arch.BPFEL }
    if archEq(name, "bpfeb")                                     { return Arch.BPFEB }
    // nvptx
    if archEq(name, "nvptx")                                     { return Arch.NVPTX }
    if archEq(name, "nvptx64")                                   { return Arch.NVPTX64 }
    // amdgpu
    if archEq(name, "amdgcn")                                    { return Arch.AMDGCN }
    if archEq(name, "r600")                                      { return Arch.R600 }
    // micro / dsp / ir / vector
    if archEq(name, "avr")                                       { return Arch.AVR }
    if archEq(name, "msp430")                                    { return Arch.MSP430 }
    if archEq(name, "hexagon")                                   { return Arch.HEXAGON }
    if archEq(name, "lanai")                                     { return Arch.LANAI }
    if archEq(name, "le64")                                      { return Arch.LE64 }
    if archEq(name, "arc")                                       { return Arch.ARC }
    if archEq(name, "xcore")                                     { return Arch.XCORE }
    if archEq(name, "spir")                                      { return Arch.SPIR }
    if archEq(name, "spir64")                                    { return Arch.SPIR64 }
    if archEq(name, "tce")                                       { return Arch.TCE }
    if archEq(name, "tcele")                                     { return Arch.TCELE }
    if archEq(name, "ve")                                        { return Arch.VE }
    return Arch.UNKNOWN
}

// tripleComponent — return the substring of `s` up to the first '-', and (via the
// shared cursor pattern is not available) leave splitting to tripleParse. This
// helper returns the head; tripleParse advances the tail itself.
public string tripleHead(const string s) {
    int p = str.indexOf(s, "-")
    if p < 0 { return s }
    return str.substring(s, 0, p)
}

// tripleTail — the remainder of `s` after the first '-' ("" if there is none).
public string tripleTail(const string s) {
    int p = str.indexOf(s, "-")
    if p < 0 { return "" }
    return str.substring(s, p + 1, str.len(s))
}

// tripleParse — split "arch-vendor-os-env" into a Triple. Missing trailing
// components become "". (llvm::Triple::Triple(StringRef) + normalize, reduced.)
//
// Each tail is bound to a FRESH variable (r0/r1/r2/r3): the self-host miscompiles
// `x = substring(x, …)` (the return aliases the source), so the source and the
// destination of every split step must be different variables.
public Triple tripleParse(const string s) {
    string r0 = s
    string archName = tripleHead(r0)
    string r1 = tripleTail(r0)
    string vendor = tripleHead(r1)
    string r2 = tripleTail(r1)
    string os = tripleHead(r2)
    string r3 = tripleTail(r2)
    string env = r3                 // whatever is left (may contain further '-')

    Arch a = archFromName(archName)
    return new Triple(s, a, archName, vendor, os, env)
}
