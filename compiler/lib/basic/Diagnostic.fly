namespace fly.compiler.basic
import fly.compiler.basic.*
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// Diagnostic — the diagnostics engine, ported from include/Basic/Diagnostic.h +
// Diagnostic.cpp. Adapted to Fly: dropped the LLVM-only machinery (RefCountedBase,
// llvm::Error payload, SFINAE responses); kept the functional surface — a
// DiagnosticConsumer sink, a fluent DiagnosticBuilder (with %0 formatting and
// FixItHints), and the DiagnosticsEngine that maps id→level, renders
// "line:col: level: message", and tracks error/warning counts.
//
// The C++ '<<' builder operator (emit-on-destruction) becomes an explicit
// builder.emit(); callers write: engine.report(loc, id).addStr(x).emit().
// ─────────────────────────────────────────────────────────────────────────────

// formatMessage — substitute %0..%9 placeholders in a description with args[i].
public string formatMessage(const string desc, const List<string> args) {
    string res = desc
    int n = (int)args.size()
    int i = 0
    while i < n {
        string ph = str.concat("%", str.convert(i))
        // NOTE: must use a distinct temp — `res = replace(res, …)` (reassigning a
        // string var from a result computed over itself) corrupts under this compiler.
        string next = str.replace(res, ph, args.get(i))
        res = next
        i = i + 1
    }
    return res
}

// FixItHint — a suggested source edit attached to a diagnostic (insert/remove/
// replace over a source range). A 1:1 analog of clang's FixItHint.
public class FixItHint {
    SourceRange range
    string insertText

    public FixItHint(const SourceRange range, const string insertText) {
        this.range = range
        this.insertText = insertText
    }

    public SourceRange getRange() { return this.range }
    public string getInsertText() { return this.insertText }
}

public FixItHint fixItInsert(const SourceLocation loc, const string text) {
    return new FixItHint(srcRangeFromLoc(loc), text)
}
public FixItHint fixItReplace(const SourceRange range, const string text) {
    return new FixItHint(range, text)
}
public FixItHint fixItRemove(const SourceRange range) {
    return new FixItHint(range, "")
}

// Diagnostic — a fully-formed diagnostic handed to a DiagnosticConsumer. Carries
// the level + location (+ decoded line/col/filename) + the formatted message AND
// the "line:col: level: message" rendered short form, plus the SourceManager so a
// rich consumer (TextDiagnosticPrinter) can fetch the source line for a caret.
// (1:1 with the C++ Diagnostic info passed to DiagnosticConsumer::HandleDiagnostic.)
public class Diagnostic {
    DiagLevel level
    SourceLocation loc
    int line
    int col
    string filename
    string message
    string rendered
    SourceManager sm

    public Diagnostic(const DiagLevel level, const SourceLocation loc, const int line, const int col,
                      const string filename, const string message, const string rendered, const SourceManager sm) {
        this.level = level
        this.loc = loc
        this.line = line
        this.col = col
        this.filename = filename
        this.message = message
        this.rendered = rendered
        this.sm = sm
    }

    public DiagLevel getLevel()        { return this.level }
    public SourceLocation getLoc()     { return this.loc }
    public int getLine()               { return this.line }
    public int getColumn()             { return this.col }
    public string getFilename()        { return this.filename }
    public string getMessage()         { return this.message }
    public string getRendered()        { return this.rendered }
    public SourceManager getSourceManager() { return this.sm }
}

// DiagnosticConsumer — sink for fully-formed diagnostics. The base is a no-op;
// concrete consumers override handleDiagnostic (vtable dispatch). Receives a rich
// Diagnostic (the C++ HandleDiagnostic(Level, Diagnostic&) shape) so consumers can
// render carets; the rendered short form is on Diagnostic.getRendered().
public class DiagnosticConsumer {
    public DiagnosticConsumer() { }
    public void handleDiagnostic(const Diagnostic diag) { }
}

// StoringDiagnosticConsumer — records rendered diagnostics for inspection/tests.
public class StoringDiagnosticConsumer : DiagnosticConsumer {
    List<string> messages
    // The same diagnostics kept FIELD BY FIELD. getRendered() is the "line:col:
    // level: message" short form and carries no filename by contract (the LSP
    // decodes it in fly.lsp.parseRendered), so a caller that needs to report or
    // log a parse error structurally — with its file — reads these instead of
    // re-parsing the rendered string. Line/col are stored pre-rendered as
    // strings: fly.data.List stores `long` and str.convert takes an int.
    List<string> levels
    List<string> files
    List<string> lines
    List<string> cols
    List<string> texts
    int errors
    int warnings

    public StoringDiagnosticConsumer() {
        super()
        this.messages = new List<string>()
        this.levels = new List<string>()
        this.files = new List<string>()
        this.lines = new List<string>()
        this.cols = new List<string>()
        this.texts = new List<string>()
        this.errors = 0
        this.warnings = 0
    }

    public void handleDiagnostic(const Diagnostic diag) {
        this.messages.add(diag.getRendered())
        this.levels.add(levelName(diag.getLevel()))
        this.files.add(diag.getFilename())
        this.lines.add(str.convert(diag.getLine()))
        this.cols.add(str.convert(diag.getColumn()))
        this.texts.add(diag.getMessage())
        DiagLevel level = diag.getLevel()
        if level == DiagLevel.Error || level == DiagLevel.Fatal { this.errors = this.errors + 1 }
        elsif level == DiagLevel.Warning { this.warnings = this.warnings + 1 }
    }

    public int count() { return (int)this.messages.size() }
    public string getMessage(const int i) { return this.messages.get(i) }
    public string getLevelName(const int i) { return this.levels.get(i) }
    public string getFile(const int i) { return this.files.get(i) }
    public string getLine(const int i) { return this.lines.get(i) }
    public string getCol(const int i) { return this.cols.get(i) }
    public string getText(const int i) { return this.texts.get(i) }
    public int errorCount() { return this.errors }
    public int warningCount() { return this.warnings }
}

// DiagnosticBuilder — accumulates a diagnostic's arguments and fix-its, then emits
// it via the engine. addStr/addInt/addFixIt return `this` for fluent chaining.
public class DiagnosticBuilder {
    DiagnosticsEngine engine
    DiagID id
    SourceLocation loc
    List<string> args
    List<FixItHint> fixits

    public DiagnosticBuilder(const DiagnosticsEngine engine, const SourceLocation loc, const DiagID id) {
        this.engine = engine
        this.loc = loc
        this.id = id
        this.args = new List<string>()
        this.fixits = new List<FixItHint>()
    }

    public DiagnosticBuilder addStr(const string s) { this.args.add(s)  return this }
    public DiagnosticBuilder addInt(const int n) { this.args.add(str.convert(n))  return this }
    public DiagnosticBuilder addFixIt(const FixItHint h) { this.fixits.add(h)  return this }

    public DiagID getId() { return this.id }
    public SourceLocation getLoc() { return this.loc }
    public List<string> getArgs() { return this.args }
    public List<FixItHint> getFixits() { return this.fixits }

    public void emit() { this.engine.emitDiagnostic(this) }
}

// DiagnosticsEngine — central diagnostics state: maps id→level (applying options),
// renders the message, dispatches to the consumer, and tracks counts.
public class DiagnosticsEngine {
    DiagnosticOptions opts
    DiagnosticConsumer consumer
    SourceManager sm
    int errorCount
    int warningCount
    bool errorOccurred

    public DiagnosticsEngine(const DiagnosticOptions opts, const DiagnosticConsumer consumer, const SourceManager sm) {
        this.opts = opts
        this.consumer = consumer
        this.sm = sm
        this.errorCount = 0
        this.warningCount = 0
        this.errorOccurred = false
    }

    // report — begin a diagnostic at loc with id; caller adds args then calls emit().
    public DiagnosticBuilder report(const SourceLocation loc, const DiagID id) {
        return new DiagnosticBuilder(this, loc, id)
    }

    public void emitDiagnostic(const DiagnosticBuilder b) {
        DiagLevel level = getDefaultLevel(b.getId())
        // Apply warning options.
        if level == DiagLevel.Warning {
            if this.opts.isIgnoreWarnings() { return }
            if this.opts.isWarningsAsErrors() { level = DiagLevel.Error }
        }
        string msg = formatMessage(getDescription(b.getId()), b.getArgs())
        SourceLocation loc = b.getLoc()
        int line = this.sm.getLineNumber(loc)
        int col = this.sm.getColumnNumber(loc)
        string prefix = str.concat(str.convert(line),
                        str.concat(":", str.concat(str.convert(col), ": ")))
        string full = str.concat(prefix, str.concat(levelName(level), str.concat(": ", msg)))
        PresumedLoc pl = this.sm.getPresumedLoc(loc)
        string fname = pl.getFilename()
        Diagnostic diag = new Diagnostic(level, loc, line, col, fname, msg, full, this.sm)
        this.consumer.handleDiagnostic(diag)
        if level == DiagLevel.Error || level == DiagLevel.Fatal {
            this.errorCount = this.errorCount + 1
            this.errorOccurred = true
        } elsif level == DiagLevel.Warning {
            this.warningCount = this.warningCount + 1
        }
    }

    public bool hasErrorOccurred() { return this.errorOccurred }
    public int getNumErrors() { return this.errorCount }
    public int getNumWarnings() { return this.warningCount }
    public DiagnosticConsumer getConsumer() { return this.consumer }
}
