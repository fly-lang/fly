namespace fly.compiler.basic
import fly.compiler.basic.*
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// SourceManager — decodes a SourceLocation (an opaque byte offset) into line,
// column and a PresumedLoc, ported from fly/include/Basic/SourceManager.{h,cpp}.
//
// The C++ SourceManager is a ~3500-line, multi-buffer, macro-aware service. The
// self-host compiles ONE buffer with no macros and no #line, so this is the
// single-buffer essence — but it KEEPS the C++ line cache
// (ComputeLineNumbers / SourceLineCache): one O(n) scan builds a table of line
// starts and every query is a binary search over it. Dropping that cache, as an
// earlier revision did, made getLineNumber O(offset) and — since Parser.bump()
// asks for the line of every token — parsing quadratic in file size.
//
// Behaviour matches the eager line/col the Lexer used to track (newline = byte
// 10), so existing position assertions are preserved. Line/col are 1-based;
// column counts from the last '\n'.
// ─────────────────────────────────────────────────────────────────────────────

public class SourceManager {
    string filename
    string buffer
    int len

    // Offset where each line begins, index 0 = line 1. Built ONCE, lazily.
    //
    // Without it getLineNumber counted newlines from offset 0 on every call —
    // and Parser.bump() calls it for EVERY token, which made parsing quadratic
    // in file size: a 1300-line file spent 1.6s here alone. One O(n) scan plus a
    // binary search per query replaces that. (The C++ SourceManager this was
    // ported from had the same cache; the port dropped it.)
    List<int> lineStarts
    bool linesBuilt

    public SourceManager(const string filename, const string buffer) {
        this.filename = filename
        this.buffer = buffer
        this.len = str.len(buffer)
        this.lineStarts = new List<int>()
        this.linesBuilt = false
    }

    // buildLines — the line table. Safe to keep for the object's lifetime: the
    // buffer is set at construction and never replaced (setFilename renames the
    // buffer, it does not re-point it).
    void buildLines() {
        if this.linesBuilt { return }
        this.lineStarts.add(0)
        int i = 0
        while i < this.len {
            if this.byteAt(i) == 10 { this.lineStarts.add(i + 1) }
            i = i + 1
        }
        this.linesBuilt = true
    }

    // lineIndexOf — 0-based index of the line containing `pos`: the last line
    // whose start is <= pos.
    int lineIndexOf(const int pos) {
        this.buildLines()
        int lo = 0
        int hi = (int)this.lineStarts.size() - 1
        while lo < hi {
            int mid = (lo + hi + 1) / 2
            if this.lineStarts.get(mid) <= pos { lo = mid } else { hi = mid - 1 }
        }
        out = lo
    }

    // byteAt — byte code at index i, or 256 past end (mirrors Lexer.byteAt).
    public int byteAt(const int i) {
        if i >= this.len {
            out = 256
            return
        }
        byte b = 0
        str.byteAt(this.buffer, i, b)
        out = b
    }

    // getColumnNumber — 1-based column of the location: offset minus the start
    // of its line. (C++ SourceManager::getColumnNumber simple path.)
    public int getColumnNumber(const SourceLocation loc) {
        int pos = loc.getOffset()
        out = (pos - this.lineStarts.get(this.lineIndexOf(pos))) + 1
    }

    // getLineNumber — 1-based line of the location: 1 + the number of newlines
    // before the offset. (C++ SourceManager::getLineNumber, sans line cache.)
    public int getLineNumber(const SourceLocation loc) {
        out = this.lineIndexOf(loc.getOffset()) + 1
    }

    // getCharacterByte — byte at the location's offset (the single-buffer analog
    // of C++ getCharacterData, which returns a pointer to that character).
    public int getCharacterByte(const SourceLocation loc) {
        out = this.byteAt(loc.getOffset())
    }

    // getBufferData — the whole source buffer (single FileID).
    public string getBufferData() {
        out = this.buffer
    }

    // getFilename — the name this buffer was registered under (for diagnostics).
    public string getFilename() {
        out = this.filename
    }

    // setFilename — rename the buffer. The Parser builds its SourceManager before
    // it knows which file it is parsing (the path arrives with parseModule), so
    // the placeholder name is replaced there; without this every parse diagnostic
    // reports the "<input>" placeholder instead of the real source.
    public void setFilename(const string fn) {
        this.filename = fn
    }

    // getLineStartOffset — byte offset where 1-based `line` begins (start of buffer
    // for line 1; just past the (line-1)th '\n' otherwise). Caret-diagnostic helper.
    public int getLineStartOffset(const int line) {
        this.buildLines()
        int idx = line - 1
        if idx < 0 { idx = 0 }
        // Past the last line: the old scan ran off the end and returned len,
        // and callers (getSourceLine) rely on that yielding an empty line.
        if idx >= (int)this.lineStarts.size() { out = this.len  return }
        out = this.lineStarts.get(idx)
    }

    // getSourceLine — the text of 1-based `line` (without the trailing newline).
    // The ingredient TextDiagnostic needs to render a source snippet. (C++ uses
    // SourceManager buffer + getLineNumber; here we scan the single buffer.)
    public string getSourceLine(const int line) {
        int start = this.getLineStartOffset(line)
        int end = start
        while end < this.len && this.byteAt(end) != 10 {
            end = end + 1
        }
        out = str.substring(this.buffer, start, end)
    }

    // getPresumedLoc — filename + decoded line/col for display. FileID is the
    // single main-file id (1); no #include location in a single-buffer build.
    public PresumedLoc getPresumedLoc(const SourceLocation loc) {
        out = new PresumedLoc(this.filename, fileIDGet(1),
                              this.getLineNumber(loc), this.getColumnNumber(loc),
                              slInvalid())
    }
}

// newSourceManager — convenience factory.
public SourceManager newSourceManager(const string filename, const string buffer) {
    out = new SourceManager(filename, buffer)
}
