namespace fly.compiler.basic
import fly.compiler.basic.*
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// OperatorPrecedence — precedence levels for binary/ternary operators, ported
// from compiler/Basic/OperatorPrecedence.cpp. Low numbers bind more weakly than
// high numbers.
//
// Divergence from the C++ original: getBinOpPrecedence there switches on the
// tok::TokenKind punctuator enum, which the self-host lexer does not yet model
// (punctuators are lexed as TOK_PUNCT carrying their text). So this version is
// keyed on the operator spelling instead. The C++ template-only cases for `>`
// and `>>` (GreaterThanIsOperator / CPlusPlus11) are dropped — not applicable.
// ─────────────────────────────────────────────────────────────────────────────

// Precedence levels — ordinals match the C++ prec::Level values (0..15).
public enum Prec {
    UNKNOWN,
    COMMA,
    ASSIGNMENT,
    CONDITIONAL,
    LOGICALOR,
    LOGICALAND,
    INCLUSIVEOR,
    EXCLUSIVEOR,
    AND,
    EQUALITY,
    RELATIONAL,
    SPACESHIP,
    SHIFT,
    ADDITIVE,
    MULTIPLICATIVE,
    POINTERTOMEMBER
}

// getBinOpPrecedence — precedence of a binary operator given its spelling.
// Returns Prec.UNKNOWN for anything that is not a binary operator.
public Prec getBinOpPrecedence(const string op) {
    if str.equals(op, ",") { return Prec.COMMA }

    if str.equals(op, "=")   || str.equals(op, "*=")  || str.equals(op, "/=")
    || str.equals(op, "%=")  || str.equals(op, "+=")  || str.equals(op, "-=")
    || str.equals(op, "<<=") || str.equals(op, ">>=") || str.equals(op, "&=")
    || str.equals(op, "^=")  || str.equals(op, "|=") {
        return Prec.ASSIGNMENT
    }

    if str.equals(op, "?")  { return Prec.CONDITIONAL }
    if str.equals(op, "||") { return Prec.LOGICALOR }
    if str.equals(op, "&&") { return Prec.LOGICALAND }
    if str.equals(op, "|")  { return Prec.INCLUSIVEOR }
    if str.equals(op, "^")  { return Prec.EXCLUSIVEOR }
    if str.equals(op, "&")  { return Prec.AND }

    if str.equals(op, "==") || str.equals(op, "!=") { return Prec.EQUALITY }

    if str.equals(op, "<=") || str.equals(op, "<")
    || str.equals(op, ">=") || str.equals(op, ">") {
        return Prec.RELATIONAL
    }

    if str.equals(op, "<<") || str.equals(op, ">>") { return Prec.SHIFT }

    if str.equals(op, "+") || str.equals(op, "-") { return Prec.ADDITIVE }

    if str.equals(op, "*") || str.equals(op, "/") || str.equals(op, "%") {
        return Prec.MULTIPLICATIVE
    }

    return Prec.UNKNOWN
}
