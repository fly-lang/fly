namespace fly.compiler.basic
import fly.compiler.basic.*
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// DiagnosticOptions — options controlling the diagnostics engine, ported from
// include/Basic/DiagnosticOptions.h. The C++ version is a bitfield set generated
// from DiagnosticOptions.def; here we keep the representative scalar options the
// engine consults (warnings-as-errors, ignore-warnings, tab stop, error limit).
// ─────────────────────────────────────────────────────────────────────────────

public class DiagnosticOptions {
    bool warningsAsErrors   // -Werror: promote warnings to errors
    bool ignoreWarnings     // -w: suppress all warnings
    bool pedantic           // -pedantic: enable extension diagnostics
    int tabStop             // columns per tab when rendering carets
    int errorLimit          // stop after this many errors (0 = no limit)
    string disabled         // --no-warn=<name> warnings switched off, ";a;b;"

    public DiagnosticOptions() {
        this.warningsAsErrors = false
        this.ignoreWarnings = false
        this.pedantic = false
        this.tabStop = 8
        this.errorLimit = 0
        this.disabled = ";"
    }

    public bool isWarningsAsErrors() {
        return this.warningsAsErrors
    }
    public void setWarningsAsErrors(const bool v) {
        this.warningsAsErrors = v
    }
    public bool isIgnoreWarnings() {
        return this.ignoreWarnings
    }
    public void setIgnoreWarnings(const bool v) {
        this.ignoreWarnings = v
    }
    public bool isPedantic() {
        return this.pedantic
    }
    public void setPedantic(const bool v) {
        this.pedantic = v
    }
    public int getTabStop() {
        return this.tabStop
    }
    public void setTabStop(const int v) {
        this.tabStop = v
    }
    // disableWarning — switch off the warning called `name` (see warningName).
    public void disableWarning(const string name) {
        this.disabled = str.concat(this.disabled, str.concat(name, ";"))
    }

    // setDisabledWarnings — the whole ";a;b;" list at once (FrontendOptions carries it).
    public void setDisabledWarnings(const string list) {
        this.disabled = list
    }

    public bool isWarningDisabled(const string name) {
        return str.contains(this.disabled, str.concat(";", str.concat(name, ";")))
    }

    public int getErrorLimit() {
        return this.errorLimit
    }
    public void setErrorLimit(const int v) {
        this.errorLimit = v
    }
}
