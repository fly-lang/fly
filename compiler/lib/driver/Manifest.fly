namespace fly.driver

import fly.data.List
import fly.str
import fly.os.fs

// ─────────────────────────────────────────────────────────────────────────────
// Manifest — the in-memory package manifest model. It is populated by
// FlyManifestReader (flymanifest.fly) from the Fly-native `Manifest.fly` — a class
// extending fly.meta.Manifest, parsed by the compiler's own parser — and serialized
// back to `Manifest.fly` by serialize()/save(). There is no TOML: the manifest IS
// Fly source, one language and one parser.
//
// Map-like sections (deps/repos/profiles) are stored as ordered Lists of entry
// classes (Fly's Map has no key iteration, and we need both lookup and order).
// ─────────────────────────────────────────────────────────────────────────────

// A git/path/registry dependency. refKind: 0=Tag 1=Branch 2=Rev.
public class GitDep {
    string gitUrl
    int refKind
    string refValue
    string path
    string registryName
    string pkgName
    string versionReq

    public GitDep() {
        this.gitUrl = ""
        this.refKind = 0
        this.refValue = ""
        this.path = ""
        this.registryName = ""
        this.pkgName = ""
        this.versionReq = ""
    }

    public string getGitUrl() {
        return this.gitUrl
    }
    public int getRefKind() {
        return this.refKind
    }
    public string getRefValue() {
        return this.refValue
    }
    public string getPath() {
        return this.path
    }
    public string getRegistryName() {
        return this.registryName
    }
    public string getPkgName() {
        return this.pkgName
    }
    public string getVersionReq() {
        return this.versionReq
    }

    public void setGitUrl(const string v) {
        this.gitUrl = v
    }
    public void setRef(const int k, const string v) {
        this.refKind = k
        this.refValue = v
    }
    public void setPath(const string v) {
        this.path = v
    }
    public void setRegistry(const string r, const string pkg, const string ver) {
        this.registryName = r
        this.pkgName = pkg
        this.versionReq = ver
    }

    public bool isPathDep() {
        return str.isEmpty(this.path) == false
    }
    public bool isRegistryDep() {
        return str.isEmpty(this.registryName) == false
    }
    public bool isGitDep() {
        return str.isEmpty(this.gitUrl) == false
    }
}

// A build profile (opt-level etc.).
public class BuildProfile {
    int optLevel
    bool debugInfo
    bool assertions
    bool lto
    bool strip
    bool warningsAsErrors    // a warning fails the build (--warnings-as-errors)
    string debugPrefixMap    // "OLD=NEW" for --debug-prefix-map ("" = none; @out = the output dir)

    public BuildProfile() {
        this.optLevel = 0
        this.debugInfo = true
        this.assertions = true
        this.lto = false
        this.strip = false
        this.warningsAsErrors = false
        this.debugPrefixMap = ""
    }

    public int getOptLevel() {
        return this.optLevel
    }
    public bool getDebugInfo() {
        return this.debugInfo
    }
    public bool getAssertions() {
        return this.assertions
    }
    public bool getLto() {
        return this.lto
    }
    public bool getStrip() {
        return this.strip
    }
    public void setOptLevel(const int v) {
        this.optLevel = v
    }
    public void setDebugInfo(const bool v) {
        this.debugInfo = v
    }
    public void setAssertions(const bool v) {
        this.assertions = v
    }
    public void setLto(const bool v) {
        this.lto = v
    }
    public void setStrip(const bool v) {
        this.strip = v
    }
    public bool getWarningsAsErrors() {
        return this.warningsAsErrors
    }
    public void setWarningsAsErrors(const bool v) {
        this.warningsAsErrors = v
    }
    public string getDebugPrefixMap() {
        return this.debugPrefixMap
    }
    public void setDebugPrefixMap(const string v) {
        this.debugPrefixMap = v
    }
}

// A build target. The positional form `new Target(name, path, lib)` names one
// source file whose directory is compiled; the named form (0.15.2)
// `{ name = ..., srcDirs = {...}, ... }` also carries the fields below. No
// `lib` = an executable. Paths are relative to the package root; in libDirs,
// flags and a profile's debugPrefixMap, `@out` stands for the output directory.
public class Target {
    string key
    string name
    string path
    string lib
    List<string> srcDirs    // source roots; the FIRST is the discovery root (overrides path)
    List<string> files      // compile exactly these files (staged into a dir of their own)
    string entry            // the file declaring main(), instead of discovering it
    string os               // "linux" | "windows" | "macos": build only on that host ("" = all)
    string artifact         // exact output name (no lib prefix; extension added per platform)
    List<string> libDirs    // -L package dirs (headers + archives)
    List<string> linkLibs   // native libraries for this target (--link-lib)
    List<string> flags      // extra compiler arguments, passed verbatim
    string dir              // subdirectory of the output dir the artifact lands in ("" = the output dir)
    List<string> copy       // files or directories copied into the target dir (a target of copies only
                            // compiles nothing)
    List<string> rpaths     // run-time library search paths of an executable (--rpath)

    public Target(const string k, const string nm, const string p, const string lb) {
        this.key = k
        this.name = nm
        this.path = p
        this.lib = lb
        this.srcDirs = new List<string>()
        this.files = new List<string>()
        this.entry = ""
        this.os = ""
        this.artifact = ""
        this.libDirs = new List<string>()
        this.linkLibs = new List<string>()
        this.flags = new List<string>()
        this.dir = ""
        this.copy = new List<string>()
        this.rpaths = new List<string>()
    }

    public List<string> getSrcDirs() {
        return this.srcDirs
    }
    public List<string> getFiles() {
        return this.files
    }
    public string getEntry() {
        return this.entry
    }
    public void setEntry(const string v) {
        this.entry = v
    }
    public string getOs() {
        return this.os
    }
    public void setOs(const string v) {
        this.os = v
    }
    public string getArtifact() {
        return this.artifact
    }
    public void setArtifact(const string v) {
        this.artifact = v
    }
    public List<string> getLibDirs() {
        return this.libDirs
    }
    public List<string> getLinkLibs() {
        return this.linkLibs
    }
    public List<string> getFlags() {
        return this.flags
    }
    public string getDir() {
        return this.dir
    }
    public void setDir(const string v) {
        this.dir = v
    }
    public List<string> getCopy() {
        return this.copy
    }
    public List<string> getRpaths() {
        return this.rpaths
    }
    public void setPath(const string v) {
        this.path = v
    }
    public void setLib(const string v) {
        this.lib = v
    }

    public string getKey() {
        return this.key
    }
    public string getName() {
        return this.name
    }
    public string getPath() {
        return this.path
    }
    public string getLib() {
        return this.lib
    }
    public bool isLib() {
        return str.isEmpty(this.lib) == false
    }
    public bool isBin() {
        return str.isEmpty(this.lib)
    }
}

// [test] — suite-based test configuration.
public class TestConfig {
    List<string> suites
    bool parallel
    bool failFast

    public TestConfig() {
        this.suites = new List<string>()
        this.parallel = false
        this.failFast = false
    }

    public void addSuite(const string s) {
        this.suites.add(s)
    }
    public int suiteCount() {
        return (int)this.suites.size()
    }
    public string suiteAt(const int idx) {
        return this.suites.get(idx)
    }
    public bool getParallel() {
        return this.parallel
    }
    public bool getFailFast() {
        return this.failFast
    }
    public void setParallel(const bool v) {
        this.parallel = v
    }
    public void setFailFast(const bool v) {
        this.failFast = v
    }
}

// Ordered name→GitDep entry (dependencies / dev-dependencies).
public class DepEntry {
    string name
    GitDep dep
    public DepEntry(const string n, const GitDep d) {
        this.name = n
        this.dep = d
    }
    public string getName() {
        return this.name
    }
    public GitDep getDep() {
        return this.dep
    }
}

// Ordered name→string entry (repo aliases).
public class StrEntry {
    string name
    string value
    public StrEntry(const string n, const string v) {
        this.name = n
        this.value = v
    }
    public string getName() {
        return this.name
    }
    public string getValue() {
        return this.value
    }
}

// Ordered name→BuildProfile entry.
public class ProfileEntry {
    string name
    BuildProfile prof
    public ProfileEntry(const string n, const BuildProfile p) {
        this.name = n
        this.prof = p
    }
    public string getName() {
        return this.name
    }
    public BuildProfile getProf() {
        return this.prof
    }
}

// The parsed manifest.
public class Manifest {
    string name
    string version
    string description
    string license
    string flyVersion
    string homepage
    string repository
    string defaultRegistry
    List<string> authors
    List<Target> targets
    TestConfig tst                 // `test` is a reserved keyword
    List<DepEntry> deps
    List<DepEntry> devDeps
    List<StrEntry> repos
    List<ProfileEntry> profiles
    List<string> linkLibs
    List<string> wsMembers         // workspace members (empty = not a workspace root)
    bool isWorkspace
    string preBuild
    string postBuild

    public Manifest() {
        this.name = ""
        this.version = ""
        this.description = ""
        this.license = ""
        this.flyVersion = ""
        this.homepage = ""
        this.repository = ""
        this.defaultRegistry = ""
        this.authors = new List<string>()
        this.targets = new List<Target>()
        this.tst = new TestConfig()
        this.deps = new List<DepEntry>()
        this.devDeps = new List<DepEntry>()
        this.repos = new List<StrEntry>()
        this.profiles = new List<ProfileEntry>()
        this.linkLibs = new List<string>()
        this.wsMembers = new List<string>()
        this.isWorkspace = false
        this.preBuild = ""
        this.postBuild = ""
    }

    public string getName() {
        return this.name
    }
    public string getVersion() {
        return this.version
    }
    public string getDescription() {
        return this.description
    }
    public string getLicense() {
        return this.license
    }
    public string getFlyVersion() {
        return this.flyVersion
    }
    public string getHomepage() {
        return this.homepage
    }
    public string getRepository() {
        return this.repository
    }
    public string getDefaultRegistry() {
        return this.defaultRegistry
    }
    public void setName(const string v) {
        this.name = v
    }
    public void setVersion(const string v) {
        this.version = v
    }
    public void setDescription(const string v) {
        this.description = v
    }
    public void setLicense(const string v) {
        this.license = v
    }
    public void setFlyVersion(const string v) {
        this.flyVersion = v
    }
    public void setHomepage(const string v) {
        this.homepage = v
    }
    public void setRepository(const string v) {
        this.repository = v
    }
    public void setDefaultRegistry(const string v) {
        this.defaultRegistry = v
    }

    public void addAuthor(const string a) {
        this.authors.add(a)
    }
    public int authorCount() {
        return (int)this.authors.size()
    }
    public string authorAt(const int idx) {
        return this.authors.get(idx)
    }

    public void addTarget(const Target t) {
        this.targets.add(t)
    }
    public int targetCount() {
        return (int)this.targets.size()
    }
    public Target targetAt(const int idx) {
        return this.targets.get(idx)
    }

    public TestConfig getTest() {
        return this.tst
    }

    public void addLinkLib(const string l) {
        this.linkLibs.add(l)
    }
    public int linkLibCount() {
        return (int)this.linkLibs.size()
    }
    public string linkLibAt(const int idx) {
        return this.linkLibs.get(idx)
    }

    public bool isWorkspaceRoot() {
        return this.isWorkspace
    }
    public void addMember(const string m) {
        this.wsMembers.add(m)
        this.isWorkspace = true
    }
    public int memberCount() {
        return (int)this.wsMembers.size()
    }
    public string memberAt(const int idx) {
        return this.wsMembers.get(idx)
    }

    public void setHooks(const string pre, const string post) {
        this.preBuild = pre
        this.postBuild = post
    }
    public string getPreBuild() {
        return this.preBuild
    }
    public string getPostBuild() {
        return this.postBuild
    }

    // dependency access (ordered, linear lookup)
    public void addDep(const string n, const GitDep d) {
        this.deps.add(new DepEntry(n, d))
    }
    public void addDevDep(const string n, const GitDep d) {
        this.devDeps.add(new DepEntry(n, d))
    }
    public int depCount() {
        return (int)this.deps.size()
    }
    public DepEntry depAt(const int idx) {
        return this.deps.get(idx)
    }
    public int devDepCount() {
        return (int)this.devDeps.size()
    }
    public DepEntry devDepAt(const int idx) {
        return this.devDeps.get(idx)
    }

    public bool hasDep(const string n) {
        int i = 0
        while i < this.deps.size() {
            DepEntry e = this.deps.get(i)
            if str.equals(e.getName(), n) {
                return true
            }
            i = i + 1
        }
        return false
    }
    public GitDep getDep(const string n) {
        int i = 0
        while i < this.deps.size() {
            DepEntry e = this.deps.get(i)
            if str.equals(e.getName(), n) {
                return e.getDep()
            }
            i = i + 1
        }
        return null
    }

    // repo aliases
    public void addRepo(const string n, const string url) {
        this.repos.add(new StrEntry(n, url))
    }
    public int repoCount() {
        return (int)this.repos.size()
    }
    public StrEntry repoAt(const int idx) {
        return this.repos.get(idx)
    }
    public string getRepo(const string n) {
        int i = 0
        while i < this.repos.size() {
            StrEntry e = this.repos.get(i)
            if str.equals(e.getName(), n) {
                return e.getValue()
            }
            i = i + 1
        }
        return ""
    }

    // profiles
    public void addProfile(const string n, const BuildProfile p) {
        this.profiles.add(new ProfileEntry(n, p))
    }
    public int profileCount() {
        return (int)this.profiles.size()
    }
    public ProfileEntry profileAt(const int idx) {
        return this.profiles.get(idx)
    }
    public bool hasProfile(const string n) {
        int i = 0
        while i < this.profiles.size() {
            ProfileEntry e = this.profiles.get(i)
            if str.equals(e.getName(), n) {
                return true
            }
            i = i + 1
        }
        return false
    }
    public BuildProfile getProfile(const string n) {
        int i = 0
        while i < this.profiles.size() {
            ProfileEntry e = this.profiles.get(i)
            if str.equals(e.getName(), n) {
                return e.getProf()
            }
            i = i + 1
        }
        return null
    }

    // removeDep — drop a dependency (and dev-dependency) by name.
    public bool removeDep(const string name) {
        bool found = false
        List<DepEntry> keep = new List<DepEntry>()
        int i = 0
        while i < this.deps.size() {
            DepEntry e = this.deps.get(i)
            if str.equals(e.getName(), name) {
                found = true
            } else {
                keep.add(e)
            }
            i = i + 1
        }
        this.deps = keep
        List<DepEntry> keepDev = new List<DepEntry>()
        int j = 0
        while j < this.devDeps.size() {
            DepEntry e = this.devDeps.get(j)
            if str.equals(e.getName(), name) {
                found = true
            } else {
                keepDev.add(e)
            }
            j = j + 1
        }
        this.devDeps = keepDev
        return found
    }

    // serialize — the Manifest.fly source: a class extending fly.meta.Manifest, read
    // back by FlyManifestReader. Emits package scalars, authors/linkLibs (string[]),
    // dependencies/dev-dependencies (positional `new Dependency(...)`) and targets.
    public string serialize() {
        string q = "\""
        string nl = "\n"
        string s = str.concat("namespace pkg.manifest", nl)
        s = str.concat(s, str.concat("import fly.meta.*", nl))
        s = str.concat(s, nl)
        s = str.concat(s, str.concat("class Manifest : fly.meta.Manifest {", nl))
        s = str.concat(s, this.scalarField("name", this.name, q, nl))
        s = str.concat(s, this.scalarField("version", this.version, q, nl))
        if str.isEmpty(this.description) == false {
            s = str.concat(s, this.scalarField("description", this.description, q, nl))
        }
        if str.isEmpty(this.license) == false {
            s = str.concat(s, this.scalarField("license", this.license, q, nl))
        }
        if str.isEmpty(this.flyVersion) == false {
            s = str.concat(s, this.scalarField("flyVersion", this.flyVersion, q, nl))
        }
        if str.isEmpty(this.homepage) == false {
            s = str.concat(s, this.scalarField("homepage", this.homepage, q, nl))
        }
        if str.isEmpty(this.repository) == false {
            s = str.concat(s, this.scalarField("repository", this.repository, q, nl))
        }
        if str.isEmpty(this.defaultRegistry) == false {
            s = str.concat(s, this.scalarField("registry", this.defaultRegistry, q, nl))
        }
        if this.authors.size() > 0 {
            s = str.concat(s, this.strArray("string[] authors", this.authors, q, nl))
        }
        if this.linkLibs.size() > 0 {
            s = str.concat(s, this.strArray("string[] linkLibs", this.linkLibs, q, nl))
        }
        if this.deps.size() > 0 {
            s = str.concat(s, this.depArray("dependencies", this.deps, q, nl))
        }
        if this.devDeps.size() > 0 {
            s = str.concat(s, this.depArray("devDependencies", this.devDeps, q, nl))
        }
        if this.profiles.size() > 0 {
            s = str.concat(s, this.profileArray(q, nl))
        }
        if this.targets.size() > 0 {
            s = str.concat(s, this.targetArray(this.targets, q, nl))
        }
        s = str.concat(s, str.concat("}", nl))
        return s
    }

    // profileArray — `  Profile[] profiles = { { name = "dist", optLevel = 0, ... } }`,
    // every field written, so reading it back gives the same profile whatever
    // the built-in defaults of its name are.
    string profileArray(const string q, const string nl) {
        string a = str.concat("  Profile[] profiles = {", nl)
        int i = 0
        while i < this.profiles.size() {
            ProfileEntry e = this.profiles.get(i)
            BuildProfile p = e.getProf()
            string l = str.concat("    { name = ", str.concat(q, str.concat(e.getName(), q)))
            l = str.concat(l, str.concat(", optLevel = ", str.convert(p.getOptLevel())))
            l = str.concat(l, this.boolField("debugInfo", p.getDebugInfo()))
            l = str.concat(l, this.boolField("assertions", p.getAssertions()))
            l = str.concat(l, this.boolField("lto", p.getLto()))
            l = str.concat(l, this.boolField("strip", p.getStrip()))
            l = str.concat(l, this.boolField("warningsAsErrors", p.getWarningsAsErrors()))
            if str.isEmpty(p.getDebugPrefixMap()) == false {
                l = str.concat(l, str.concat(", debugPrefixMap = ", str.concat(q, str.concat(p.getDebugPrefixMap(), q))))
            }
            l = str.concat(l, " }")
            if i + 1 < this.profiles.size() {
                l = str.concat(l, ",")
            }
            a = str.concat(a, str.concat(l, nl))
            i = i + 1
        }
        return str.concat(a, str.concat("  }", nl))
    }

    // boolField — `, <name> = true|false`.
    string boolField(const string name, const bool v) {
        string b = "false"
        if v {
            b = "true"
        }
        return str.concat(", ", str.concat(name, str.concat(" = ", b)))
    }

    // usesNamedForm — a target with any 0.15.2 (or later) field, written as a
    // struct literal.
    bool usesNamedForm(const Target t) {
        if t.getSrcDirs().size() > 0 || t.getFiles().size() > 0 {
            return true
        }
        if t.getCopy().size() > 0 || t.getRpaths().size() > 0 || str.isEmpty(t.getDir()) == false {
            return true
        }
        if t.getLibDirs().size() > 0 || t.getLinkLibs().size() > 0 || t.getFlags().size() > 0 {
            return true
        }
        if str.isEmpty(t.getEntry()) == false || str.isEmpty(t.getOs()) == false {
            return true
        }
        return str.isEmpty(t.getArtifact()) == false
    }

    // namedTarget — `{ name = "...", <each non-empty field> }`.
    string namedTarget(const Target t, const string q) {
        string l = str.concat("{ name = ", str.concat(q, str.concat(t.getName(), q)))
        l = str.concat(l, this.optStr("path", t.getPath(), q))
        l = str.concat(l, this.optStr("lib", t.getLib(), q))
        l = str.concat(l, this.optStr("os", t.getOs(), q))
        l = str.concat(l, this.optStr("artifact", t.getArtifact(), q))
        l = str.concat(l, this.optStr("entry", t.getEntry(), q))
        l = str.concat(l, this.optList("srcDirs", t.getSrcDirs(), q))
        l = str.concat(l, this.optList("files", t.getFiles(), q))
        l = str.concat(l, this.optList("libDirs", t.getLibDirs(), q))
        l = str.concat(l, this.optList("linkLibs", t.getLinkLibs(), q))
        l = str.concat(l, this.optList("flags", t.getFlags(), q))
        l = str.concat(l, this.optStr("dir", t.getDir(), q))
        l = str.concat(l, this.optList("copy", t.getCopy(), q))
        l = str.concat(l, this.optList("rpaths", t.getRpaths(), q))
        return str.concat(l, " }")
    }

    // optStr — `, <name> = "<v>"`, or nothing for an empty value.
    string optStr(const string name, const string v, const string q) {
        if str.isEmpty(v) {
            return ""
        }
        return str.concat(", ", str.concat(name, str.concat(" = ", str.concat(q, str.concat(v, q)))))
    }

    // optList — `, <name> = { "a", "b" }`, or nothing for an empty list.
    string optList(const string name, const List<string> xs, const string q) {
        if xs.size() == 0 {
            return ""
        }
        string l = str.concat(", ", str.concat(name, " = { "))
        int i = 0
        while i < xs.size() {
            if i > 0 {
                l = str.concat(l, ", ")
            }
            l = str.concat(l, str.concat(q, str.concat(xs.get(i), q)))
            i = i + 1
        }
        return str.concat(l, " }")
    }

    // scalarField — `  string <name> = "<val>"`.
    string scalarField(const string name, const string val, const string q, const string nl) {
        return str.concat("  string ",
                str.concat(name, str.concat(" = ", str.concat(q, str.concat(val, str.concat(q, nl))))))
    }

    // strArray — `  <decl> = { "a", "b" }`.
    string strArray(const string decl, const List<string> items, const string q, const string nl) {
        string a = str.concat("  ", str.concat(decl, " = { "))
        int i = 0
        while i < items.size() {
            if i > 0 {
                a = str.concat(a, ", ")
            }
            a = str.concat(a, str.concat(q, str.concat(items.get(i), q)))
            i = i + 1
        }
        return str.concat(a, str.concat(" }", nl))
    }

    // depArray — `  Dependency[] <field> = { new Dependency(...), ... }`.
    string depArray(const string field, const List<DepEntry> ds, const string q, const string nl) {
        string a = str.concat("  Dependency[] ", str.concat(field, " = { "))
        int i = 0
        while i < ds.size() {
            if i > 0 {
                a = str.concat(a, ", ")
            }
            DepEntry e = ds.get(i)
            a = str.concat(a, this.depNew(e.getName(), e.getDep(), q))
            i = i + 1
        }
        return str.concat(a, str.concat(" }", nl))
    }

    // depNew — new Dependency(name, version, registry, git, tag, branch, rev, path).
    string depNew(const string name, const GitDep g, const string q) {
        string tag = ""
        string br = ""
        string rev = ""
        if str.isEmpty(g.getGitUrl()) == false {
            if g.getRefKind() == 0 {
                tag = g.getRefValue()
            } elsif g.getRefKind() == 1 {
                br = g.getRefValue()
            } else {
                rev = g.getRefValue()
            }
        }
        string s = str.concat("new Dependency(", this.qc(name, q))
        s = str.concat(s, this.qc(g.getVersionReq(), q))
        s = str.concat(s, this.qc(g.getRegistryName(), q))
        s = str.concat(s, this.qc(g.getGitUrl(), q))
        s = str.concat(s, this.qc(tag, q))
        s = str.concat(s, this.qc(br, q))
        s = str.concat(s, this.qc(rev, q))
        s = str.concat(s, str.concat(q, str.concat(g.getPath(), q)))
        return str.concat(s, ")")
    }

    // targetArray — `  Target[] targets = { new Target("name", "path", "lib"), ... }`;
    // a target with any 0.15.2 field is written in the named form instead.
    string targetArray(const List<Target> ts, const string q, const string nl) {
        string a = "  Target[] targets = { "
        int i = 0
        while i < ts.size() {
            if i > 0 {
                a = str.concat(a, ", ")
            }
            Target t = ts.get(i)
            if this.usesNamedForm(t) {
                a = str.concat(a, this.namedTarget(t, q))
            } else {
                string tn = str.concat("new Target(", this.qc(t.getName(), q))
                tn = str.concat(tn, this.qc(t.getPath(), q))
                tn = str.concat(tn, str.concat(q, str.concat(t.getLib(), str.concat(q, ")"))))
                a = str.concat(a, tn)
            }
            i = i + 1
        }
        return str.concat(a, str.concat(" }", nl))
    }

    // qc — a quoted value followed by ", " (a comma-separated arg).
    string qc(const string v, const string q) {
        return str.concat(q, str.concat(v, str.concat(q, ", ")))
    }

    // save — write serialize() to Manifest.fly in the current directory.
    public void save() {
        fs.writeStr("Manifest.fly", this.serialize(), 420)
    }
}

// ── validation (hand-rolled; the C++ uses std::regex) ─────────────────────────

// nameValid — non-empty, all chars in [a-z0-9_-].
public bool nameValid(const string s) {
    int n = str.len(s)
    if n == 0 {
        return false
    }
    int i = 0
    while i < n {
        byte bb = str.byteAt(s, i)
        int c = bb
        bool lower = c >= 97 && c <= 122
        bool digit = c >= 48 && c <= 57
        bool other = c == 45 || c == 95
        if lower == false && digit == false && other == false {
            return false
        }
        i = i + 1
    }
    return true
}

// versionValid — exactly digits '.' digits '.' digits (MAJOR.MINOR.PATCH).
public bool versionValid(const string s) {
    int n = str.len(s)
    int i = 0
    int dots = 0
    int digitsInGroup = 0
    while i < n {
        byte bb = str.byteAt(s, i)
        int c = bb
        if c >= 48 && c <= 57 {
            digitsInGroup = digitsInGroup + 1
        } elsif c == 46 {
            if digitsInGroup == 0 {
                return false
            }
            dots = dots + 1
            digitsInGroup = 0
        } else {
            return false
        }
        i = i + 1
    }
    return dots == 2 && digitsInGroup > 0
}

// ── parse ─────────────────────────────────────────────────────────────────────

// defaultProfile — the built-in defaults (release lowers debug-info/assertions,
// raises opt-level); everything else keeps the debug defaults (Manifest.cpp:51-58).
public BuildProfile defaultProfile(const string name) {
    BuildProfile p = new BuildProfile()
    if str.equals(name, "release") {
        p.setOptLevel(3)
        p.setDebugInfo(false)
        p.setAssertions(false)
    }
    return p
}
