namespace fly.driver

import fly.str
import fly.os.env
import fly.os.path
import fly.os.fs
import fly.os.io
import fly.os.proc

// ─────────────────────────────────────────────────────────────────────────────
// Builder — invoke the fly compiler to build a manifest's targets. Port of
// the reference C++ package manager builder/Builder.{h,cpp}, simplified: SEQUENTIAL (the C++ builds
// targets on a thread pool; Fly has no easy threading here). The C++'s
// incremental-fingerprint cache IS ported (fingerprint.fly), upgraded: the
// whole source tree is hashed (not just the entry file), the output artifacts
// must still exist, and the compiler's own identity is part of the key. A
// fresh target is skipped ("up-to-date <key>"); --force bypasses. Fingerprints
// live in <outDir>/.fly/<key>.fp — content hashes only, no mtimes.
// Lockfile-based -L include paths are a follow-up (needs the Lockfile port).
// ─────────────────────────────────────────────────────────────────────────────

public class Builder {
    Manifest manifest
    string profile
    bool isTest
    string targetTriple
    string flyBinary
    bool force

    public Builder(const Manifest m, const string prof, const bool testMode) {
        this.manifest = m
        this.profile = prof
        this.isTest = testMode
        this.targetTriple = ""
        this.flyBinary = ""
        this.force = false
    }

    public void setTargetTriple(const string t) { this.targetTriple = t }

    public void setForce(const bool f) { this.force = f }

    // getFlyBinary — resolve lazily (a constructor cannot call a method here).
    public string getFlyBinary() {
        if str.isEmpty(this.flyBinary) { this.flyBinary = this.resolveFly() }
        out = this.flyBinary
    }

    // resolveFly — FLYLANG_BIN (the DIRECTORY holding the fly binary) → <dir>/fly[.exe];
    // else the running binary ITSELF (package commands run inside the `fly` compiler, so
    // exePath() is the compiler and they self-exec it in compile mode); else bare `fly`
    // on PATH as the last resort.
    public string resolveFly() {
        string binDir = env.get("FLYLANG_BIN")
        if str.isEmpty(binDir) == false {
            string exe = "fly"
            if str.equals(env.osname(), "windows") { exe = "fly.exe" }
            out = path.join(binDir, exe)
            return
        }
        string self = env.exePath()
        if str.isEmpty(self) == false { out = self  return }
        out = "fly"
    }

    // outDir — ABSOLUTE target/<profile>[/<triple>] or target/test. Absolute so
    // the `cd out_dir` in invokeFly does not break relative source/output paths.
    public string outDir() {
        string rel = "target"
        if this.isTest {
            rel = path.join(rel, "test")
        } else {
            rel = path.join(rel, this.profile)
            if str.isEmpty(this.targetTriple) == false {
                rel = path.join(rel, this.targetTriple)
            }
        }
        out = path.absolute(rel)
    }

    // activeProfile — the profile driving this build: a profile declared in the
    // manifest wins; otherwise the BUILT-IN defaults (defaultProfile) apply, so
    // `fly build --release` gives -O3/no-debug even when the manifest declares
    // no [profiles] at all (it used to fall back to the debug defaults).
    public BuildProfile activeProfile() {
        if this.manifest.hasProfile(this.profile) {
            out = this.manifest.getProfile(this.profile)
            return
        }
        out = fly.driver.defaultProfile(this.profile)
    }

    // profileFlags — "-O<n> [--debug-symbols]" from the active profile.
    public string profileFlags() {
        BuildProfile bp = this.activeProfile()
        string f = str.concat("-O", str.convert(bp.getOptLevel()))
        if bp.getDebugInfo() { f = str.concat(f, " --debug-symbols") }
        out = f
    }

    // linkFlags — "--link-lib=<name>" for each [link] lib.
    public string linkFlags() {
        string f = ""
        int i = 0
        while i < this.manifest.linkLibCount() {
            // No quoting: these flags go straight into an argv (invokeFly execs
            // directly), never through a shell. shellQuote here was worse than
            // useless — it replaced an apostrophe with an underscore, silently
            // corrupting any library name containing one.
            string one = str.concat(" --link-lib=", this.manifest.linkLibAt(i))
            f = str.concat(f, one)
            i = i + 1
        }
        out = f
    }

    // invokeFly — run: fly <profile-flags> <link-flags> [--runtime-lib-dir <dir>]
    // [--target=..] [extra] -o <output> <source>. Execs the compiler DIRECTLY (no
    // shell): `source` and `output` are already ABSOLUTE (buildTarget), so no `cd`
    // is needed — and `/bin/sh -c` does not exist on Windows (CreateProcessA maps
    // `/bin/sh`→`\bin\sh`, absent → exit 127). Direct exec also needs no shellQuote
    // (each arg is passed verbatim, never re-parsed by a shell). Returns true on exit 0.
    public bool invokeFly(const string source, const string output, const string extra) {
        fs.dirCreateAll(this.outDir(), 493)

        pointer h = proc.argsNew()
        // profile: -O<n> [--debug-symbols] — same source of truth as profileFlags()
        BuildProfile bp = this.activeProfile()
        proc.argsAdd(h, str.concat("-O", str.convert(bp.getOptLevel())))
        if bp.getDebugInfo() { proc.argsAdd(h, "--debug-symbols") }
        // [link].libs → --link-lib=<name>
        int i = 0
        while i < this.manifest.linkLibCount() {
            proc.argsAdd(h, str.concat("--link-lib=", this.manifest.linkLibAt(i)))
            i = i + 1
        }
        // FLYLANG_LIB — directory holding fly_std_lib.a / fly_runtime_lib.a (else the
        // compiler auto-detects <exe>/../lib).
        string libDir = env.get("FLYLANG_LIB")
        if str.isEmpty(libDir) == false {
            proc.argsAdd(h, "--runtime-lib-dir")
            proc.argsAdd(h, libDir)
        }
        if str.isEmpty(this.targetTriple) == false {
            proc.argsAdd(h, str.concat("--target=", this.targetTriple))
        }
        if str.isEmpty(extra) == false { proc.argsAdd(h, extra) }
        proc.argsAdd(h, "-o")
        proc.argsAdd(h, output)
        // DIRECTORY CLI: no positional source — the target's directory is the
        // source root (a bin target's main() is discovered there; --lib compiles
        // the whole directory).
        proc.argsAdd(h, "--src-dir")
        proc.argsAdd(h, path.dirname(source))

        io.printLn(str.concat("  fly ", source))
        int rc = proc.exec(this.getFlyBinary(), h)
        proc.argsFree(h)
        out = rc == 0
    }

    // ── Incremental fingerprint cache ────────────────────────────────────────

    // fpDir / fpPath — fingerprint files live under <outDir>/.fly/<key>.fp, so
    // debug/release (separate outDirs) are isolated for free and `fly clean`
    // sweeps them with target/.
    //
    // The leading dot is what keeps them out of the way: discoverySkipsDir
    // refuses to descend into ANY dot-directory, so nothing here can ever be
    // mistaken for a project source.
    public string fpDir() { out = path.join(this.outDir(), ".fly") }

    public string fpPath(const string key) {
        out = path.join(this.fpDir(), str.concat(key, ".fp"))
    }

    // fpHeader — the non-source fingerprint fields (see fingerprint.fly for the
    // format): compiler identity, target triple, profile flags, link flags,
    // target kind+name, Lock.fly hash. Empty values print "-"/"none" so every
    // line is non-empty and the shape is fixed. Ends with a newline, as
    // Fingerprint.compute expects.
    public string fpHeader(const string kind, const string name) {
        string h = str.concat("fly-fp 1", fly.driver.nl())
        h = str.concat(h, "compiler ")
        h = str.concat(h, fly.driver.fpCompilerId(this.getFlyBinary()))
        h = str.concat(h, fly.driver.nl())
        string tr = this.targetTriple
        if str.isEmpty(tr) { tr = "-" }
        h = str.concat(h, str.concat("triple ", tr))
        h = str.concat(h, fly.driver.nl())
        h = str.concat(h, str.concat("profile ", this.profileFlags()))
        h = str.concat(h, fly.driver.nl())
        // trim only a NON-empty string: the pinned seed's std has an unguarded
        // first read in trim() that segfaults on an empty heap string (fixed
        // in-tree, but this code must also run compiled against the seed).
        string lk = "-"
        string lkRaw = this.linkFlags()
        if str.isEmpty(lkRaw) == false {
            string lkTrim = str.trim(lkRaw)
            if str.isEmpty(lkTrim) == false { lk = lkTrim }
        }
        h = str.concat(h, str.concat("link ", lk))
        h = str.concat(h, fly.driver.nl())
        h = str.concat(h, str.concat("kind ", str.concat(kind, str.concat(" ", name))))
        h = str.concat(h, fly.driver.nl())
        // Lock.fly is cwd-relative: package commands run in the package root,
        // same contract as loadManifest. Missing lock → "none" (and a lock
        // appearing/disappearing flips the line → rebuild).
        string lock = fly.driver.sha256File("Lock.fly")
        if str.isEmpty(lock) { lock = "none" }
        h = str.concat(h, str.concat("lock ", lock))
        h = str.concat(h, fly.driver.nl())
        out = h
    }

    // computeFpForDir — full fingerprint text for one source dir. Also used by
    // cmdTest, which has suite files instead of Targets.
    public string computeFpForDir(const string srcDir, const string kind, const string name) {
        Fingerprint f = new Fingerprint()
        out = f.compute(srcDir, this.fpHeader(kind, name))
    }

    // computeFpFor — fingerprint of a [targets] entry. The hashed dir is exactly
    // what invokeFly passes as --src-dir: dirname of the target's source path.
    public string computeFpFor(const Target t) {
        string kind = "bin"
        if t.isLib() {
            string lib = t.getLib()
            if str.equals(lib, "dynamic") {
                kind = "lib-dynamic"
            } elsif str.equals(lib, "both") {
                kind = "lib-both"
            } else {
                kind = "lib-static"
            }
        }
        string srcDir = path.dirname(path.absolute(t.getPath()))
        out = this.computeFpForDir(srcDir, kind, t.getName())
    }

    // artifactsExist — every output the target produces is still on disk (a
    // deleted artifact must rebuild even with a matching fingerprint). Mirrors
    // buildTarget's outputs, including the deliberate lib<name>.so naming.
    public bool artifactsExist(const Target t) {
        string od = this.outDir()
        if t.isLib() {
            string lib = t.getLib()
            bool ok = true
            if str.equals(lib, "dynamic") || str.equals(lib, "both") {
                string so = str.concat(od, str.concat("/lib", str.concat(t.getName(), ".so")))
                if fs.exists(so) == false { ok = false }
            }
            if str.equals(lib, "dynamic") == false {
                string ar = str.concat(od, str.concat("/lib", str.concat(t.getName(), ".a")))
                if fs.exists(ar) == false { ok = false }
            }
            out = ok
        } else {
            string bin = str.concat(od, str.concat("/", t.getName()))
            bool have = fs.exists(bin)
            if have == false { have = fs.exists(str.concat(bin, ".exe")) }
            out = have
        }
    }

    // isUpToDate — stored fingerprint matches the computed one. A missing,
    // unreadable or corrupted .fp reads as ""/garbage → mismatch → rebuild
    // (never deleted; the next successful build overwrites it).
    public bool isUpToDate(const string fpFile, const string computed) {
        if fs.exists(fpFile) == false { out = false  return }
        string stored = fs.readStr(fpFile)
        out = str.equals(stored, computed)
    }

    // saveFp — persist the fingerprint. Called ONLY after a successful build,
    // so a failed build retries on the next run.
    public void saveFp(const string fpFile, const string computed) {
        fs.dirCreateAll(this.fpDir(), 493)
        fs.writeStr(fpFile, computed, 420)
    }

    // buildTarget — build one [targets] entry (bin or lib); skip when the
    // fingerprint matches and the artifacts exist (unless --force).
    // libShapeFlag — the compile-mode SHAPE flag for a lib target's build pass.
    // The dynamic pass MUST use --lib-dyn: the old `--shared` spelling is gone
    // from the driver and would now be a hard unknown-option error. Extracted so
    // BuilderSuite can pin the contract.
    public string libShapeFlag(const bool dynamicPass) {
        if dynamicPass { out = "--lib-dyn"  return }
        out = "--lib"
    }

    public bool buildTarget(const string key) {
        int idx = 0
        Target t = null
        while idx < this.manifest.targetCount() {
            Target cand = this.manifest.targetAt(idx)
            if str.equals(cand.getKey(), key) { t = cand }
            idx = idx + 1
        }
        if t == null {
            io.printErrLn(str.concat("error: no [targets] entry named ", key))
            out = false
            return
        }
        string computed = this.computeFpFor(t)
        string fpFile = this.fpPath(t.getKey())
        if this.force == false {
            if this.isUpToDate(fpFile, computed) && this.artifactsExist(t) {
                io.printLn(str.concat("  up-to-date ", key))
                out = true
                return
            }
        }
        string src = path.absolute(t.getPath())
        bool ok = true
        if t.isLib() {
            string lib = t.getLib()
            if str.equals(lib, "dynamic") || str.equals(lib, "both") {
                string so = str.concat(this.outDir(), str.concat("/lib", str.concat(t.getName(), ".so")))
                ok = this.invokeFly(src, so, this.libShapeFlag(true))
            }
            if ok && (str.equals(lib, "dynamic") == false) {
                string ar = str.concat(this.outDir(), str.concat("/lib", str.concat(t.getName(), ".a")))
                ok = this.invokeFly(src, ar, this.libShapeFlag(false))
            }
        } else {
            string o = str.concat(this.outDir(), str.concat("/", t.getName()))
            ok = this.invokeFly(src, o, "")
        }
        if ok { this.saveFp(fpFile, computed) }
        out = ok
    }

    // buildAll — build every target sequentially; false if any fails.
    public bool buildAll() {
        bool allOk = true
        int i = 0
        while i < this.manifest.targetCount() {
            Target t = this.manifest.targetAt(i)
            if this.buildTarget(t.getKey()) == false { allOk = false }
            i = i + 1
        }
        out = allOk
    }

    // runTarget — build a bin target then execute it. Returns the child exit code
    // (or a negative build-failure marker mapped to 1).
    public int runTarget(const string key) {
        if this.buildTarget(key) == false { out = 1  return }
        int idx = 0
        Target t = null
        while idx < this.manifest.targetCount() {
            Target cand = this.manifest.targetAt(idx)
            if str.equals(cand.getKey(), key) { t = cand }
            idx = idx + 1
        }
        if t == null { out = 1  return }
        string bin = str.concat(this.outDir(), str.concat("/", t.getName()))
        // Direct spawn, not `sh -c`: the shell form is dead on Windows, and there
        // is nothing here a shell was needed for.
        out = proc.run(bin)
    }
}
