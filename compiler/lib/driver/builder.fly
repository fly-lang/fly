namespace fly.driver

import fly.str
import fly.os.env
import fly.os.path
import fly.os.fs
import fly.os.io
import fly.os.proc
import fly.data.List
import fly.mem
import fly.llvm
import fly.compiler.basic.segCount
import fly.compiler.basic.segAt

// ─────────────────────────────────────────────────────────────────────────────
// Builder — invoke the fly compiler to build a manifest's targets. Port of
// the reference C++ package manager builder/Builder.{h,cpp}, simplified: SEQUENTIAL (the C++ builds
// targets on a thread pool; Fly has no easy threading here). The C++'s
// incremental-fingerprint cache IS ported (fingerprint.fly), upgraded: the
// whole source tree is hashed (not just the entry file), the output artifacts
// must still exist, and the compiler's own identity is part of the key. A
// fresh target is skipped ("up-to-date <key>"); --force bypasses. Fingerprints
// live in <outDir>/.fly/<key>.fp — content hashes only, no mtimes.
// Lockfile-based -L include paths are a follow-up (needs the Lockfile port).
// ─────────────────────────────────────────────────────────────────────────────

public class Builder {
    Manifest manifest
    string profile
    bool isTest
    string targetTriple
    string flyBinary
    bool force
    string outRoot          // --out-dir: the output directory instead of target/<profile>
    bool keepObjects        // --keep-objects: executables keep their object (--keep-object)

    public Builder(const Manifest m, const string prof, const bool testMode) {
        this.manifest = m
        this.profile = prof
        this.isTest = testMode
        this.targetTriple = ""
        this.flyBinary = ""
        this.force = false
        this.outRoot = ""
        this.keepObjects = false
    }

    public void setTargetTriple(const string t) {
        this.targetTriple = t
    }

    public void setForce(const bool f) {
        this.force = f
    }

    public void setOutRoot(const string d) {
        this.outRoot = d
    }

    public void setKeepObjects(const bool k) {
        this.keepObjects = k
    }

    // getFlyBinary — resolve lazily (a constructor cannot call a method here).
    public string getFlyBinary() {
        if str.isEmpty(this.flyBinary) {
            this.flyBinary = this.resolveFly()
        }
        return this.flyBinary
    }

    // resolveFly — FLYLANG_BIN (the DIRECTORY holding the fly binary) → <dir>/fly[.exe];
    // else the running binary ITSELF (package commands run inside the `fly` compiler, so
    // exePath() is the compiler and they self-exec it in compile mode); else bare `fly`
    // on PATH as the last resort.
    public string resolveFly() {
        string binDir = env.get("FLYLANG_BIN")
        if str.isEmpty(binDir) == false {
            string exe = "fly"
            if str.equals(env.osname(), "windows") {
                exe = "fly.exe"
            }
            return path.join(binDir, exe)
        }
        string self = env.exePath()
        if str.isEmpty(self) == false {
            return self
        }
        return "fly"
    }

    // outDir — ABSOLUTE target/<profile>[/<triple>] or target/test. Absolute so
    // the `cd out_dir` in invokeFly does not break relative source/output paths.
    public string outDir() {
        if str.isEmpty(this.outRoot) == false {
            return path.absolute(this.outRoot)
        }
        string rel = "target"
        if this.isTest {
            rel = path.join(rel, "test")
        } else {
            rel = path.join(rel, this.profile)
            if str.isEmpty(this.targetTriple) == false {
                rel = path.join(rel, this.targetTriple)
            }
        }
        return path.absolute(rel)
    }

    // activeProfile — the profile driving this build: a profile declared in the
    // manifest wins; otherwise the BUILT-IN defaults (defaultProfile) apply, so
    // `fly build --release` gives -O3/no-debug even when the manifest declares
    // no [profiles] at all (it used to fall back to the debug defaults).
    public BuildProfile activeProfile() {
        if this.manifest.hasProfile(this.profile) {
            return this.manifest.getProfile(this.profile)
        }
        return fly.driver.defaultProfile(this.profile)
    }

    // profileFlags — "-O<n> [--debug-symbols]" from the active profile.
    public string profileFlags() {
        BuildProfile bp = this.activeProfile()
        string f = str.concat("-O", str.convert(bp.getOptLevel()))
        if bp.getDebugInfo() {
            f = str.concat(f, " --debug-symbols")
        }
        if bp.getWarningsAsErrors() {
            f = str.concat(f, " --warnings-as-errors")
        }
        if str.isEmpty(bp.getDebugPrefixMap()) == false {
            f = str.concat(f, str.concat(" --debug-prefix-map=", bp.getDebugPrefixMap()))
        }
        return f
    }

    // linkFlags — "--link-lib=<name>" for each [link] lib.
    public string linkFlags() {
        string f = ""
        int i = 0
        while i < this.manifest.linkLibCount() {
            // No quoting: these flags go straight into an argv (invokeFly execs
            // directly), never through a shell. shellQuote here was worse than
            // useless — it replaced an apostrophe with an underscore, silently
            // corrupting any library name containing one.
            string one = str.concat(" --link-lib=", this.manifest.linkLibAt(i))
            f = str.concat(f, one)
            i = i + 1
        }
        return f
    }

    // invokeFly — run: fly <profile-flags> <link-flags> [--runtime-lib-dir <dir>]
    // [--target=..] [extra] -o <output> <source>. Execs the compiler DIRECTLY (no
    // shell): `source` and `output` are already ABSOLUTE (buildTarget), so no `cd`
    // is needed — and `/bin/sh -c` does not exist on Windows (CreateProcessA maps
    // `/bin/sh`→`\bin\sh`, absent → exit 127). Direct exec also needs no shellQuote
    // (each arg is passed verbatim, never re-parsed by a shell). Returns true on exit 0.
    public bool invokeFly(const string source, const string output, const string extra) {
        List<string> roots = new List<string>()
        roots.add(path.dirname(source))
        return this.runFly(null, roots, output, "", extra, source)
    }

    // runFly — the compiler run behind every build: profile flags, link libraries,
    // runtime lib dir and triple as before, then for a named-form target `t` its
    // own link libraries, -L dirs, verbatim flags and --entry; `-o output` (with
    // `--out-dir outDirArg` when given: a library's headers land there) and one
    // --src-dir per root, the first being the discovery root. `label` is what the
    // progress line names.
    public bool runFly(const Target t, const List<string> roots, const string output, const string outDirArg,
            const string extra, const string label) {
        fs.dirCreateAll(this.outDir(), 493)

        pointer h = proc.argsNew()
        // profile: -O<n> [--debug-symbols] — same source of truth as profileFlags()
        BuildProfile bp = this.activeProfile()
        proc.argsAdd(h, str.concat("-O", str.convert(bp.getOptLevel())))
        if bp.getDebugInfo() {
            proc.argsAdd(h, "--debug-symbols")
        }
        if bp.getWarningsAsErrors() {
            proc.argsAdd(h, "--warnings-as-errors")
        }
        List<string> pairs = this.prefixMapPairs(bp.getDebugPrefixMap())
        int pk = 0
        while pk < pairs.size() {
            proc.argsAdd(h, str.concat("--debug-prefix-map=", pairs.get(pk)))
            pk = pk + 1
        }
        // [link].libs → --link-lib=<name>
        int i = 0
        while i < this.manifest.linkLibCount() {
            proc.argsAdd(h, str.concat("--link-lib=", this.manifest.linkLibAt(i)))
            i = i + 1
        }
        // FLYLANG_LIB — directory holding fly_std_lib.a / fly_runtime_lib.a (else the
        // compiler auto-detects <exe>/../lib).
        string libDir = env.get("FLYLANG_LIB")
        if str.isEmpty(libDir) == false {
            proc.argsAdd(h, "--runtime-lib-dir")
            proc.argsAdd(h, libDir)
        }
        if str.isEmpty(this.targetTriple) == false {
            proc.argsAdd(h, str.concat("--target=", this.targetTriple))
        }
        if str.isEmpty(extra) == false {
            proc.argsAdd(h, extra)
        }
        if t != null {
            List<string> tl = t.getLinkLibs()
            int li = 0
            while li < tl.size() {
                proc.argsAdd(h, str.concat("--link-lib=", tl.get(li)))
                li = li + 1
            }
            List<string> ld = t.getLibDirs()
            int di = 0
            while di < ld.size() {
                proc.argsAdd(h, "-L")
                proc.argsAdd(h, this.projectPath(ld.get(di)))
                di = di + 1
            }
            List<string> tf = t.getFlags()
            int fi = 0
            while fi < tf.size() {
                proc.argsAdd(h, this.expandOut(tf.get(fi)))
                fi = fi + 1
            }
            if str.isEmpty(t.getEntry()) == false {
                proc.argsAdd(h, "--entry")
                proc.argsAdd(h, path.absolute(t.getEntry()))
            }
            List<string> rp = t.getRpaths()
            int pi = 0
            while pi < rp.size() {
                proc.argsAdd(h, "--rpath")
                proc.argsAdd(h, this.expandOut(rp.get(pi)))
                pi = pi + 1
            }
        }
        if this.keepObjects && (t == null || t.isBin()) {
            proc.argsAdd(h, "--keep-object")
        }
        proc.argsAdd(h, "-o")
        proc.argsAdd(h, output)
        if str.isEmpty(outDirArg) == false {
            proc.argsAdd(h, "--out-dir")
            proc.argsAdd(h, outDirArg)
        }
        // DIRECTORY CLI: no positional source — the first root is where main() is
        // discovered (or, with --lib, the whole directory compiled); the others
        // resolve imports.
        int ri = 0
        while ri < roots.size() {
            proc.argsAdd(h, "--src-dir")
            proc.argsAdd(h, roots.get(ri))
            ri = ri + 1
        }

        io.printLn(str.concat("  fly ", label))
        int rc = proc.exec(this.getFlyBinary(), h)
        proc.argsFree(h)
        return rc == 0
    }

    // ── named-form targets (0.15.2) ──────────────────────────────────────────

    // hostOs — "linux" | "windows" | "macos", what a target's `os` is matched with.
    public string hostOs() {
        return env.osname()
    }

    // skipsHost — a target restricted to another OS is not built here.
    public bool skipsHost(const Target t) {
        if str.isEmpty(t.getOs()) {
            return false
        }
        return str.equals(t.getOs(), this.hostOs()) == false
    }

    // prefixMapPairs — a profile's debugPrefixMap as --debug-prefix-map values:
    // several OLD=NEW pairs may be given, ";"-separated, each with its
    // placeholders expanded. (segCount and segAt read the ";a;b;" form, hence
    // the bracketing ";"; empty pairs are dropped.)
    public List<string> prefixMapPairs(const string m) {
        List<string> res = new List<string>()
        string pm = str.concat(";", str.concat(m, ";"))
        int n = segCount(pm)
        int i = 0
        while i < n {
            string pair = segAt(pm, i)
            if str.isEmpty(pair) == false {
                res.add(this.expandOut(pair))
            }
            i = i + 1
        }
        return res
    }

    // expandOut — the placeholders of a flag, -L dir, copy, rpath or prefix map:
    // `@out` is the output directory, `@root` the package root (the directory
    // fly build runs in), `@fly` the installation of the fly that compiles (the
    // directory above its bin/, whose lib/ it reads headers from).
    public string expandOut(const string s) {
        string r = str.replace(s, "@out", this.outDir())
        if str.contains(r, "@root") {
            r = str.replace(r, "@root", env.cwdGet())
        }
        if str.contains(r, "@fly") {
            r = str.replace(r, "@fly", path.dirname(path.dirname(path.absolute(this.getFlyBinary()))))
        }
        return r
    }

    // projectPath — a manifest path made absolute (`@out` expanded first).
    public string projectPath(const string p) {
        string e = this.expandOut(p)
        if path.isAbsolute(e) {
            return e
        }
        return path.absolute(e)
    }

    // isNamed — a target that uses any 0.15.2 field: built with --out-dir and
    // its exact artifact name, from its source roots.
    public bool isNamed(const Target t) {
        if t.getSrcDirs().size() > 0 {
            return true
        }
        if t.getFiles().size() > 0 {
            return true
        }
        return str.isEmpty(t.getArtifact()) == false
    }

    // stageDir — where a target's `files` are copied to be compiled on their own
    // (the CLI compiles directories). A dot-dir, so discovery never enters it.
    public string stageDir(const Target t) {
        return path.join(this.fpDir(), path.join("src", t.getKey()))
    }

    // genDir — where a bin target's package module is written.
    public string genDir(const Target t) {
        return path.join(this.fpDir(), path.join("gen", t.getKey()))
    }

    // stageFiles — copy the target's files into a fresh stage dir.
    public void stageFiles(const Target t) {
        string d = this.stageDir(t)
        if fs.exists(d) {
            fs.dirDeleteAll(d)
        }
        fs.dirCreateAll(d, 493)
        List<string> fl = t.getFiles()
        int i = 0
        while i < fl.size() {
            string src = this.projectPath(fl.get(i))
            fs.copy(src, path.join(d, path.basename(src)))
            i = i + 1
        }
    }

    // writePackageModule — the bin target's `fly.meta.package` module (name,
    // version, description from the manifest), rewritten only when it changes.
    public void writePackageModule(const Target t) {
        string d = this.genDir(t)
        fs.dirCreateAll(d, 493)
        string p = path.join(d, "package.fly")
        string text = this.packageModule()
        if fs.exists(p) {
            if str.equals(fs.readStr(p), text) {
                return
            }
        }
        fs.writeStr(p, text, 420)
    }

    // targetRoots — the --src-dir list: the staged files or the srcDirs (or the
    // directory of `path`), then, for an executable, the package module.
    public List<string> targetRoots(const Target t) {
        List<string> roots = new List<string>()
        if t.getFiles().size() > 0 {
            roots.add(this.stageDir(t))
        }
        List<string> sd = t.getSrcDirs()
        int i = 0
        while i < sd.size() {
            roots.add(this.projectPath(sd.get(i)))
            i = i + 1
        }
        if roots.size() == 0 {
            roots.add(path.dirname(path.absolute(t.getPath())))
        }
        if t.isBin() {
            roots.add(this.genDir(t))
        }
        return roots
    }

    // archiveExt — the static-library extension the toolchain looks for.
    public string archiveExt() {
        if str.equals(this.hostOs(), "windows") {
            return ".lib"
        }
        return ".a"
    }

    // targetOut — the directory a target's artifact (and a library's headers, and
    // its copies) land in: the output dir, or its `dir` subdirectory.
    public string targetOut(const Target t) {
        if str.isEmpty(t.getDir()) {
            return this.outDir()
        }
        return path.join(this.outDir(), t.getDir())
    }

    // namedArtifact — the file a named-form target leaves in its target dir.
    public string namedArtifact(const Target t) {
        string base = t.getArtifact()
        if str.isEmpty(base) {
            base = t.getName()
        }
        string p = path.join(this.targetOut(t), base)
        if t.isLib() {
            return str.concat(p, this.archiveExt())
        }
        if str.equals(this.hostOs(), "windows") {
            return str.concat(p, ".exe")
        }
        return p
    }

    // buildNamed — build a named-form target: a static library goes to the
    // output dir under its exact name (+ extension) with its headers next to it;
    // an executable gets its package module as an extra source root.
    public bool buildNamed(const Target t) {
        List<string> roots = this.targetRoots(t)
        string base = t.getArtifact()
        if str.isEmpty(base) {
            base = t.getName()
        }
        string od = this.targetOut(t)
        fs.dirCreateAll(od, 493)
        if t.isLib() {
            string lib = t.getLib()
            bool dyn = str.equals(lib, "dynamic")
            bool ok = this.runFly(t, roots, base, od, this.libShapeFlag(dyn), t.getKey())
            if ok && (dyn == false) {
                // the CLI writes the archive under the exact -o name: give it the
                // extension the linker and --runtime-lib-dir look for
                string raw = path.join(od, base)
                string want = this.namedArtifact(t)
                if fs.exists(raw) {
                    if fs.exists(want) {
                        fs.del(want)
                    }
                    fs.rename(raw, want)
                }
            }
            return ok
        }
        return this.runFly(t, roots, path.join(od, base), "", "", t.getKey())
    }

    // ── copies (0.16) ────────────────────────────────────────────────────────

    // hasSources — the target compiles something: source roots, files or a path.
    public bool hasSources(const Target t) {
        if t.getSrcDirs().size() > 0 || t.getFiles().size() > 0 {
            return true
        }
        return str.isEmpty(t.getPath()) == false
    }

    // copyOnly — a target made of copies alone: nothing to compile.
    public bool copyOnly(const Target t) {
        return t.getCopy().size() > 0 && this.hasSources(t) == false
    }

    // copyFiles — every `copy` entry into the target dir: a file under its own
    // name (a symbolic link is followed: the copy has the link's name and the
    // target's bytes), a directory as a whole tree, or `dir/prefix*suffix` for
    // the files of dir that match (possibly none: a pattern is how an optional
    // file is listed). False, with a message, when a plain entry names nothing.
    public bool copyFiles(const Target t) {
        string od = this.targetOut(t)
        fs.dirCreateAll(od, 493)
        List<string> cl = t.getCopy()
        int i = 0
        while i < cl.size() {
            string src = this.projectPath(cl.get(i))
            string base = path.basename(src)
            if str.contains(base, "*") {
                this.copyMatching(path.dirname(src), base, od)
            } elsif path.isDir(src) {
                this.copyTree(src, path.join(od, base))
            } elsif fs.exists(src) {
                this.copyOne(src, path.join(od, base))
            } else {
                io.printErrLn(str.concat("error: copy: not found: ", cl.get(i)))
                return false
            }
            i = i + 1
        }
        return true
    }

    // copyOne — copy a file unless the copy is already there: same size and no
    // older than the source. The mode comes along (an executable stays one).
    public void copyOne(const string src, const string dst) {
        fly.os.fs.Stat ss = fs.stat(src)
        if fs.exists(dst) {
            fly.os.fs.Stat ds = fs.stat(dst)
            if ds.size == ss.size && ds.mtime_sec >= ss.mtime_sec {
                return
            }
        }
        fs.copy(src, dst)
        if str.equals(this.hostOs(), "windows") == false {
            uint perm = ss.mode & (uint)4095
            fs.chmod(dst, (int)perm)
        }
    }

    // copyTree — a directory and everything under it.
    public void copyTree(const string src, const string dst) {
        fs.dirCreateAll(dst, 493)
        List<string> names = this.dirNames(src)
        int i = 0
        while i < names.size() {
            string from = path.join(src, names.get(i))
            string to = path.join(dst, names.get(i))
            if path.isDir(from) {
                this.copyTree(from, to)
            } else {
                this.copyOne(from, to)
            }
            i = i + 1
        }
    }

    // copyMatching — the files of `dir` matching `pattern` (one `*`) into
    // `dst`; returns how many.
    public int copyMatching(const string dir, const string pattern, const string dst) {
        int star = str.indexOf(pattern, "*")
        string pre = str.substring(pattern, 0, star)
        string post = str.substring(pattern, star + 1, str.len(pattern))
        List<string> names = this.dirNames(dir)
        int count = 0
        int i = 0
        while i < names.size() {
            string nm = names.get(i)
            bool fits = str.len(nm) >= str.len(pre) + str.len(post)
            if fits && str.startsWith(nm, pre) && str.endsWith(nm, post) {
                string from = path.join(dir, nm)
                if path.isDir(from) == false {
                    this.copyOne(from, path.join(dst, nm))
                    count = count + 1
                }
            }
            i = i + 1
        }
        return count
    }

    // dirNames — the entry names of `dir`. The bytes are copied before fromBytes,
    // which takes ownership of what it is given (the DirEntries array keeps its own).
    public List<string> dirNames(const string dir) {
        List<string> names = new List<string>()
        fly.os.fs.DirEntries de = fs.dirRead(dir)
        pointer items = de.items
        if items == 0 {
            return names
        }
        long lenL = (long)de.len
        int n = 0
        fly.llvm.longToInt(lenL, n)
        int i = 0
        while i < n {
            int off = i * 56
            pointer namePtr = mem.readPtr(items, off)
            int nameLen = mem.readInt(items, off + 8)
            if nameLen > 0 {
                pointer cp = mem.alloc(nameLen)
                mem.copy(cp, namePtr, nameLen)
                names.add(str.fromBytes(cp, nameLen))
            }
            i = i + 1
        }
        return names
    }

    // ── Incremental fingerprint cache ────────────────────────────────────────

    // fpDir / fpPath — fingerprint files live under <outDir>/.fly/<key>.fp, so
    // debug/release (separate outDirs) are isolated for free and `fly clean`
    // sweeps them with target/.
    //
    // The leading dot is what keeps them out of the way: discoverySkipsDir
    // refuses to descend into ANY dot-directory, so nothing here can ever be
    // mistaken for a project source.
    public string fpDir() {
        return path.join(this.outDir(), ".fly")
    }

    public string fpPath(const string key) {
        return path.join(this.fpDir(), str.concat(key, ".fp"))
    }

    // fpHeader — the non-source fingerprint fields (see fingerprint.fly for the
    // format): compiler identity, target triple, profile flags, link flags,
    // target kind+name, Lock.fly hash. Empty values print "-"/"none" so every
    // line is non-empty and the shape is fixed. Ends with a newline, as
    // Fingerprint.compute expects.
    public string fpHeader(const string kind, const string name) {
        string h = str.concat("fly-fp 1", "\n")
        h = str.concat(h, "compiler ")
        h = str.concat(h, fly.driver.fpCompilerId(this.getFlyBinary()))
        h = str.concat(h, "\n")
        string tr = this.targetTriple
        if str.isEmpty(tr) {
            tr = "-"
        }
        h = str.concat(h, str.concat("triple ", tr))
        h = str.concat(h, "\n")
        h = str.concat(h, str.concat("profile ", this.profileFlags()))
        h = str.concat(h, "\n")
        // trim only a NON-empty string: the pinned seed's std has an unguarded
        // first read in trim() that segfaults on an empty heap string (fixed
        // in-tree, but this code must also run compiled against the seed).
        string lk = "-"
        string lkRaw = this.linkFlags()
        if str.isEmpty(lkRaw) == false {
            string lkTrim = str.trim(lkRaw)
            if str.isEmpty(lkTrim) == false {
                lk = lkTrim
            }
        }
        h = str.concat(h, str.concat("link ", lk))
        h = str.concat(h, "\n")
        h = str.concat(h, str.concat("kind ", str.concat(kind, str.concat(" ", name))))
        h = str.concat(h, "\n")
        // Lock.fly is cwd-relative: package commands run in the package root,
        // same contract as loadManifest. Missing lock → "none" (and a lock
        // appearing/disappearing flips the line → rebuild).
        string lock = fly.driver.sha256File("Lock.fly")
        if str.isEmpty(lock) {
            lock = "none"
        }
        h = str.concat(h, str.concat("lock ", lock))
        h = str.concat(h, "\n")
        // the package module every executable gets carries name and version
        h = str.concat(h, str.concat("package ", str.concat(this.manifest.getName(), str.concat(" ",
                this.manifest.getVersion()))))
        h = str.concat(h, "\n")
        return h
    }

    // targetLine — the named-form fields of a target, one line, for its
    // fingerprint (a changed flag, entry or -L dir rebuilds it).
    public string targetLine(const Target t) {
        string l = str.concat("os=", t.getOs())
        l = str.concat(l, str.concat(" artifact=", t.getArtifact()))
        l = str.concat(l, str.concat(" entry=", t.getEntry()))
        l = str.concat(l, this.listLine(" srcDirs=", t.getSrcDirs()))
        l = str.concat(l, this.listLine(" files=", t.getFiles()))
        l = str.concat(l, this.listLine(" libDirs=", t.getLibDirs()))
        l = str.concat(l, this.listLine(" linkLibs=", t.getLinkLibs()))
        l = str.concat(l, this.listLine(" flags=", t.getFlags()))
        l = str.concat(l, str.concat(" dir=", t.getDir()))
        l = str.concat(l, this.listLine(" rpaths=", t.getRpaths()))
        return l
    }

    public string listLine(const string label, const List<string> xs) {
        string l = label
        int i = 0
        while i < xs.size() {
            if i > 0 {
                l = str.concat(l, ",")
            }
            l = str.concat(l, xs.get(i))
            i = i + 1
        }
        return l
    }

    // packageModule — the `fly.meta.package` module an executable is built with:
    // the manifest's name, version and description as functions, so a program
    // reads its own manifest data (`import fly.meta.package`, then
    // `package.version()`). Functions, not static strings: a static string
    // initializer is a known seed landmine.
    public string packageModule() {
        string q = "\""
        string nl = "\n"
        string t = str.concat("namespace fly.meta.package", nl)
        t = str.concat(t, nl)
        t = str.concat(t, str.concat("// GENERATED from Manifest.fly - do not edit.", nl))
        t = str.concat(t, this.packageFn("name", this.manifest.getName(), q, nl))
        t = str.concat(t, this.packageFn("version", this.manifest.getVersion(), q, nl))
        t = str.concat(t, this.packageFn("description", this.manifest.getDescription(), q, nl))
        return t
    }

    // packageFn — `public string <fn>() { return "<value>" }`, the value with its
    // quotes and backslashes escaped.
    public string packageFn(const string fn, const string value, const string q, const string nl) {
        string bs = "\\"
        string v = str.replace(value, bs, str.concat(bs, bs))
        v = str.replace(v, q, str.concat(bs, q))
        string t = str.concat("public string ", str.concat(fn, str.concat("() {", nl)))
        t = str.concat(t, str.concat("    return ", str.concat(q, str.concat(v, str.concat(q, nl)))))
        t = str.concat(t, str.concat("}", nl))
        return t
    }

    // computeFpForDir — full fingerprint text for one source dir. Also used by
    // cmdTest, which has suite files instead of Targets.
    public string computeFpForDir(const string srcDir, const string kind, const string name) {
        Fingerprint f = new Fingerprint()
        return f.compute(srcDir, this.fpHeader(kind, name))
    }

    // computeFpFor — fingerprint of a [targets] entry. The hashed dir is exactly
    // what invokeFly passes as --src-dir: dirname of the target's source path.
    public string computeFpFor(const Target t) {
        string kind = "bin"
        if t.isLib() {
            string lib = t.getLib()
            if str.equals(lib, "dynamic") {
                kind = "lib-dynamic"
            } elsif str.equals(lib, "both") {
                kind = "lib-both"
            } else {
                kind = "lib-static"
            }
        }
        if this.isNamed(t) == false {
            string srcDir = path.dirname(path.absolute(t.getPath()))
            return this.computeFpForDir(srcDir, kind, t.getName())
        }
        // a named-form target: every root, and what else reaches the command line
        string head = this.fpHeader(kind, t.getName())
        head = str.concat(head, str.concat("target ", this.targetLine(t)))
        head = str.concat(head, "\n")
        List<string> roots = this.targetRoots(t)
        string all = ""
        Fingerprint fpr = new Fingerprint()
        int i = 0
        while i < roots.size() {
            string r = roots.get(i)
            if fs.exists(r) {
                all = str.concat(all, fpr.compute(r, str.concat(head, str.concat("root ", r))))
            } else {
                all = str.concat(all, str.concat("missing root ", r))
            }
            i = i + 1
        }
        return all
    }

    // artifactsExist — every output the target produces is still on disk (a
    // deleted artifact must rebuild even with a matching fingerprint). Mirrors
    // buildTarget's outputs, including the deliberate lib<name>.so naming.
    public bool artifactsExist(const Target t) {
        if this.isNamed(t) {
            return fs.exists(this.namedArtifact(t))
        }
        bool res
        string od = this.outDir()
        if t.isLib() {
            string lib = t.getLib()
            bool ok = true
            if str.equals(lib, "dynamic") || str.equals(lib, "both") {
                string so = str.concat(od, str.concat("/lib", str.concat(t.getName(), ".so")))
                if fs.exists(so) == false {
                    ok = false
                }
            }
            if str.equals(lib, "dynamic") == false {
                string ar = str.concat(od, str.concat("/lib", str.concat(t.getName(), ".a")))
                if fs.exists(ar) == false {
                    ok = false
                }
            }
            res = ok
        } else {
            string bin = str.concat(od, str.concat("/", t.getName()))
            bool have = fs.exists(bin)
            if have == false {
                have = fs.exists(str.concat(bin, ".exe"))
            }
            return have
        }
        return res
    }

    // isUpToDate — stored fingerprint matches the computed one. A missing,
    // unreadable or corrupted .fp reads as ""/garbage → mismatch → rebuild
    // (never deleted; the next successful build overwrites it).
    public bool isUpToDate(const string fpFile, const string computed) {
        if fs.exists(fpFile) == false {
            return false
        }
        string stored = fs.readStr(fpFile)
        return str.equals(stored, computed)
    }

    // saveFp — persist the fingerprint. Called ONLY after a successful build,
    // so a failed build retries on the next run.
    public void saveFp(const string fpFile, const string computed) {
        fs.dirCreateAll(this.fpDir(), 493)
        fs.writeStr(fpFile, computed, 420)
    }

    // buildTarget — build one [targets] entry (bin or lib); skip when the
    // fingerprint matches and the artifacts exist (unless --force).
    // libShapeFlag — the compile-mode SHAPE flag for a lib target's build pass.
    // The dynamic pass MUST use --lib-dyn: the old `--shared` spelling is gone
    // from the driver and would now be a hard unknown-option error. Extracted so
    // BuilderSuite can pin the contract.
    public string libShapeFlag(const bool dynamicPass) {
        if dynamicPass {
            return "--lib-dyn"
        }
        return "--lib"
    }

    public bool buildTarget(const string key) {
        int idx = 0
        Target t = null
        while idx < this.manifest.targetCount() {
            Target cand = this.manifest.targetAt(idx)
            if str.equals(cand.getKey(), key) {
                t = cand
            }
            idx = idx + 1
        }
        if t == null {
            io.printErrLn(str.concat("error: no [targets] entry named ", key))
            return false
        }
        if this.skipsHost(t) {
            io.printLn(str.concat("  skipped ", str.concat(key, str.concat(" (os ", str.concat(t.getOs(), ")")))))
            return true
        }
        // a target of copies alone compiles nothing; copyOne keeps it incremental
        if this.copyOnly(t) {
            io.printLn(str.concat("  copy ", key))
            return this.copyFiles(t)
        }
        // staged files and the package module are part of what is fingerprinted
        if t.getFiles().size() > 0 {
            this.stageFiles(t)
        }
        if t.isBin() {
            this.writePackageModule(t)
        }
        string computed = this.computeFpFor(t)
        string fpFile = this.fpPath(t.getKey())
        if this.force == false {
            if this.isUpToDate(fpFile, computed) && this.artifactsExist(t) {
                io.printLn(str.concat("  up-to-date ", key))
                return true
            }
        }
        string src = path.absolute(t.getPath())
        bool ok = true
        if this.isNamed(t) {
            ok = this.buildNamed(t)
        } elsif t.isLib() {
            string lib = t.getLib()
            if str.equals(lib, "dynamic") || str.equals(lib, "both") {
                string so = str.concat(this.outDir(), str.concat("/lib", str.concat(t.getName(), ".so")))
                ok = this.invokeFly(src, so, this.libShapeFlag(true))
            }
            if ok && (str.equals(lib, "dynamic") == false) {
                string ar = str.concat(this.outDir(), str.concat("/lib", str.concat(t.getName(), ".a")))
                ok = this.invokeFly(src, ar, this.libShapeFlag(false))
            }
        } else {
            string o = str.concat(this.outDir(), str.concat("/", t.getName()))
            this.writePackageModule(t)
            List<string> broots = new List<string>()
            broots.add(path.dirname(src))
            broots.add(this.genDir(t))
            ok = this.runFly(null, broots, o, "", "", src)
        }
        if ok {
            this.saveFp(fpFile, computed)
        }
        if ok && t.getCopy().size() > 0 {
            ok = this.copyFiles(t)
        }
        return ok
    }

    // buildAll — build every target sequentially; false if any fails.
    public bool buildAll() {
        bool allOk = true
        int i = 0
        while i < this.manifest.targetCount() {
            Target t = this.manifest.targetAt(i)
            if this.buildTarget(t.getKey()) == false {
                allOk = false
            }
            i = i + 1
        }
        return allOk
    }

    // runTarget — build a bin target then execute it. Returns the child exit code
    // (or a negative build-failure marker mapped to 1).
    public int runTarget(const string key) {
        if this.buildTarget(key) == false {
            return 1
        }
        int idx = 0
        Target t = null
        while idx < this.manifest.targetCount() {
            Target cand = this.manifest.targetAt(idx)
            if str.equals(cand.getKey(), key) {
                t = cand
            }
            idx = idx + 1
        }
        if t == null {
            return 1
        }
        string bin = str.concat(this.outDir(), str.concat("/", t.getName()))
        if this.isNamed(t) {
            bin = this.namedArtifact(t)
        }
        // Direct spawn, not `sh -c`: the shell form is dead on Windows, and there
        // is nothing here a shell was needed for.
        return proc.run(bin)
    }
}
