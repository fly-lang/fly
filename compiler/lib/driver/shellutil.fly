namespace fly.driver

import fly.str
import fly.hash
import fly.os.proc
import fly.os.fs
import fly.os.env
import fly.mem
import fly.llvm

// ─────────────────────────────────────────────────────────────────────────────
// subprocess helpers — NO SHELL.
//
// This file used to route every external command through `sh -c "…"`, mirroring
// the C++ popen()/system() usage. That was dead code on Windows: there is no
// /bin/sh, and the runtime's CreateProcessA normalises arg0 '/'→'\' into a
// nonexistent `\bin\sh`, so `fly build`/`fly test`/every git operation silently
// failed there. Programs are now invoked DIRECTLY through fly.os.proc.
//
// The distinction that matters: invoking a named tool (git) is fine — the user
// opted into git by writing a git dependency, exactly as they opted into ld.lld
// by compiling at all. Requiring a POSIX SHELL to do it is not.
//
// curl and tar are both GONE: HTTP and HTTPS are served natively by
// fly.net.http, and gzip/ustar by fly.targz. git is the last external program
// the driver invokes, and it stays by design.
//
// Output capture goes through fly.os.proc.execCapture, which redirects the
// child's stdout to a file with no shell. Note that stderr is now INHERITED
// rather than sent to /dev/null: a failing command's diagnostics reach the user.
// ─────────────────────────────────────────────────────────────────────────────

// tmpPath — a fresh temporary file path under the platform temp dir.
public string tmpPath(const string tag) {
    string tmpdir = env.get("TMPDIR")
    if str.isEmpty(tmpdir) { tmpdir = env.get("TEMP") }
    if str.isEmpty(tmpdir) { tmpdir = "." }
    string d = fs.tempDir(tmpdir, tag)
    out = str.concat(d, "/out")
}

// captureArgs — run `prog` with the ArgList `h` and return its stdout. The exit
// code goes to `rcOut`; the output is returned even on a non-zero exit, which is
// what the callers want (git prints a usable answer and still fails sometimes).
public string captureArgs(const string prog, const pointer h, int rcOut) {
    string tmp = tmpPath("flycap")
    int rc = proc.execCapture(prog, h, tmp)
    rcOut = rc
    string data = ""
    if fs.exists(tmp) {
        data = fs.readStr(tmp)
        fs.delete(tmp)
    }
    out = data
}

// runArgs — run `prog` with the ArgList `h`, output inherited; returns the exit
// code, or -1 if the program could not be spawned.
public int runArgs(const string prog, const pointer h) {
    out = proc.exec(prog, h)
}

// trimTrailingNewline — drop a single trailing '\n'/'\r\n' (command output tidy).
public string trimTrailingNewline(const string s) {
    int n = str.len(s)
    if n == 0 { out = s  return }
    byte last = 0
    str.byteAt(s, n - 1, last)
    if last == 10 {
        n = n - 1
        if n > 0 {
            byte prev = 0
            str.byteAt(s, n - 1, prev)
            if prev == 13 { n = n - 1 }
        }
    }
    out = str.substring(s, 0, n)
}


// ── checksum — forwarders to fly.hash ─────────────────────────────────────────
// The SHA-256 implementation MOVED to std/lib/hash.fly. It only ever lived here
// because of same-namespace source discovery, and that placement put it ABOVE
// std, so std itself could not use it. These three forwarders keep every existing
// caller (registryfetcher, gitfetcher, lockfile, ChecksumSuite) unchanged.

// sha256String — "sha256:<hex>" of a string's bytes.
public string sha256String(const string data) {
    out = hash.sha256String(data)
}

// sha256File — "sha256:<hex>" of a file's contents ("" if the file is missing).
public string sha256File(const string path) {
    out = hash.sha256File(path)
}

// verifyChecksum — true if the file hashes to `expected` ("sha256:<hex>").
public bool verifyChecksum(const string path, const string expected) {
    out = hash.sha256Verify(path, expected)
}
// dq — a one-byte string holding a double quote (34); string literals keep escapes
// raw, so a bare `"` cannot be produced from a literal.
public string dq() {
    pointer buf = mem.alloc(1)
    byte q = 34
    fly.llvm.strPoke(buf, 0, q)
    string s = ""
    fly.llvm.strMake(buf, 1, s)
    out = s
}

// tabStr — a one-byte string holding a tab (9); literals keep escapes raw, so
// "\t" would be the two characters backslash and t.
public string tabStr() {
    pointer buf = mem.alloc(1)
    byte t = 9
    fly.llvm.strPoke(buf, 0, t)
    string s = ""
    fly.llvm.strMake(buf, 1, s)
    out = s
}

// nl — a one-byte string holding a newline (10); literals keep escapes raw.
public string nl() {
    pointer buf = mem.alloc(1)
    byte n = 10
    fly.llvm.strPoke(buf, 0, n)
    string s = ""
    fly.llvm.strMake(buf, 1, s)
    out = s
}

