namespace fly.driver

import fly.compiler.basic.*
import fly.os.fs
import fly.os.path
import fly.mem
import fly.str
import fly.llvm
import fly.data.List

// ─────────────────────────────────────────────────────────────────────────────
// Fingerprint — content-hash staleness key for the Builder's incremental cache.
// A fingerprint is a deterministic multi-line text: a caller-provided header
// (compiler id, flags, triple, lock hash — see Builder.fpHeader) followed by a
// "files" section listing every *.fly under a source dir, sorted bytewise by
// path relative to that dir, each with its sha256. Two fingerprints compare by
// plain string equality: any changed/added/removed source, flag, dependency
// lock or compiler flips the text. Content hashes only — no mtimes (an mtime
// changes on checkout/touch without a real change; content does not).
// ─────────────────────────────────────────────────────────────────────────────

// fpStrCompare — bytewise lexicographic compare (-1/0/1). fly.str has no
// compare; bytes are masked to unsigned because byte widens with SIGN extension.
public int fpStrCompare(const string a, const string b) {
    int la = str.len(a)
    int lb = str.len(b)
    int n = la
    if lb < n {
        n = lb
    }
    int i = 0
    while i < n {
        byte ba = 0
        byte bb = 0
        ba = str.byteAt(a, i)
        bb = str.byteAt(b, i)
        int ia = (int)ba
        ia = ia & 255
        int ib = (int)bb
        ib = ib & 255
        if ia < ib {
            return 0 - 1
        }
        if ia > ib {
            return 1
        }
        i = i + 1
    }
    if la < lb {
        return 0 - 1
    }
    if la > lb {
        return 1
    }
    return 0
}

// fpBackslash — a one-byte string holding "\" (92); literals keep escapes raw,
// so a lone backslash cannot come from a literal. Same construction as dq()/nl().
public string fpBackslash() {
    pointer buf = mem.alloc(1)
    byte b = 92
    fly.llvm.strPoke(buf, 0, b)
    string s = ""
    fly.llvm.strMake(buf, 1, s)
    return s
}

// fpCompilerId — "<version> <size> <mtimeSec>" identity of the compiler binary:
// cheap (no hashing of a large executable) yet flips when the compiler is
// rebuilt or FLYLANG_BIN points somewhere else. A non-existing path (bare "fly"
// PATH fallback) degrades to "<version> 0 0" — still versioned.
public string fpCompilerId(const string flyBinaryPath) {
    string ver = flyVersion()
    if fs.exists(flyBinaryPath) == false {
        return str.concat(ver, " 0 0")
    }
    fly.os.fs.Stat st = fs.stat(flyBinaryPath)
    long szL = (long)st.size
    long mtL = (long)st.mtime_sec
    string r = str.concat(ver, " ")
    r = str.concat(r, str.convertL(szL))
    r = str.concat(r, " ")
    r = str.concat(r, str.convertL(mtL))
    return r
}

// Fingerprint — computes the "files" section for one source dir: every *.fly
// under it, sorted bytewise by absolute path (so the text does not depend on
// the filesystem's directory order), each with its sha256.
//
// Lists, an insertion sort and per-item helpers: O(n²) compares with O(1)
// access. It used to keep its lists as ";"-joined strings with a selection sort
// re-scanning them on every access - about n³ bytes of work, which took six
// minutes for the 343 files of the compiler tree once `fly build` built it
// (0.15.2). The output text is unchanged, so existing .fp files stay valid.
public class Fingerprint {
    string lines     // accumulated "relpath sha256:<hex>\n" text
    string root      // absolute source dir (relpath base)

    public Fingerprint() {
        this.lines = ""
        this.root = ""
    }

    // compute — walk srcDir, sort, hash; return header + "files" section.
    // `header` must already end with a newline (Builder.fpHeader does).
    // An absolute srcDir (isAbsolute knows the Windows forms too) is kept
    // verbatim so the fingerprint text stays stable across normalize changes.
    public string compute(const string srcDir, const string header) {
        if path.isAbsolute(srcDir) {
            this.root = str.concat("", srcDir)
        } else {
            this.root = path.absolute(srcDir)
        }
        List<string> pending = new List<string>()
        List<string> files = new List<string>()
        pending.add(this.root)
        int qi = 0
        while qi < pending.size() {
            this.scanDir(pending.get(qi), pending, files)
            qi = qi + 1
        }
        this.sortPaths(files)
        this.lines = ""
        int i = 0
        while i < files.size() {
            this.hashOne(files.get(i))
            i = i + 1
        }
        string filesHdr = str.concat("files", fly.driver.nl())
        return str.concat(header, str.concat(filesHdr, this.lines))
    }

    // scanDir — enqueue the subdirectories of `dir` and collect its *.fly files
    // (never *.fly.h — it does not end with ".fly").
    public void scanDir(const string dir, const List<string> pending, const List<string> files) {
        if path.isDir(dir) == false {
            return
        }
        fly.os.fs.DirEntries de = fs.dirRead(dir)
        pointer items = de.items
        if items == 0 {
            return
        }
        long lenL = (long)de.len
        int n = 0
        fly.llvm.longToInt(lenL, n)
        int i = 0
        while i < n {
            int off = i * 56
            pointer namePtr = mem.readPtr(items, off)
            int nameLen = mem.readInt(items, off + 8)
            string entry = str.fromBytes(namePtr, nameLen)
            string full = path.join(dir, entry)
            if path.isDir(full) {
                pending.add(full)
            } elsif str.endsWith(entry, ".fly") {
                files.add(full)
            }
            i = i + 1
        }
    }

    // sortPaths — insertion sort, bytewise (fpStrCompare).
    public void sortPaths(const List<string> xs) {
        int i = 1
        while i < xs.size() {
            string cur = xs.get(i)
            int j = i - 1
            bool go = true
            while go {
                if j < 0 {
                    go = false
                } elsif fpStrCompare(xs.get(j), cur) > 0 {
                    xs.set(j + 1, xs.get(j))
                    j = j - 1
                } else {
                    go = false
                }
            }
            xs.set(j + 1, cur)
            i = i + 1
        }
    }

    // hashOne — append "relpath sha256:<hex>\n" for one file. relpath is relative
    // to root with "\" normalized to "/", so Windows and Linux produce
    // byte-identical fingerprints for identical trees.
    public void hashOne(const string full) {
        string hash = fly.driver.sha256File(full)
        int rootLen = str.len(this.root)
        string rel = str.substring(full, rootLen + 1, str.len(full))
        string relNorm = str.replace(rel, fpBackslash(), "/")
        string line = str.concat(relNorm, str.concat(" ", hash))
        this.lines = str.concat(this.lines, str.concat(line, fly.driver.nl()))
    }
}
