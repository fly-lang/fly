namespace fly.driver

import fly.data.List
import fly.str
import fly.os.fs
import fly.compiler.parser.*
import fly.compiler.ast.*

// ─────────────────────────────────────────────────────────────────────────────
// Lockfile — the resolved dependency lock. Like the manifest, it is Fly-native:
// serialize() writes a `Lock.fly` (a class extending fly.meta.Lockfile) and
// readLock() reads it back with the compiler's OWN parser (FlyLockReader walks the
// AST). No TOML, one language, one parser. Machine-generated: "do not edit".
// ─────────────────────────────────────────────────────────────────────────────

public class LockedPackage {
    string name
    string version
    string source        // "git+<url>" | "registry+<name>"
    string rev
    string tag
    string checksum
    List<string> deps    // "name version" strings

    public LockedPackage() {
        this.name = ""
        this.version = ""
        this.source = ""
        this.rev = ""
        this.tag = ""
        this.checksum = ""
        this.deps = new List<string>()
    }
    public string getName()     { out = this.name }
    public string getVersion()  { out = this.version }
    public string getSource()   { out = this.source }
    public string getRev()      { out = this.rev }
    public string getTag()      { out = this.tag }
    public string getChecksum() { out = this.checksum }
    public void setName(const string v)     { this.name = v }
    public void setVersion(const string v)  { this.version = v }
    public void setSource(const string v)   { this.source = v }
    public void setRev(const string v)      { this.rev = v }
    public void setTag(const string v)      { this.tag = v }
    public void setChecksum(const string v) { this.checksum = v }
    public void addDep(const string d)      { this.deps.add(d) }
    public int depCount()                   { out = (int)this.deps.size() }
    public string depAt(const int i)        { out = this.deps.get(i) }
}

public class Lockfile {
    int formatVersion
    string flyVersion
    string tomlChecksum
    List<LockedPackage> packages

    public Lockfile() {
        this.formatVersion = 1
        this.flyVersion = ""
        this.tomlChecksum = ""
        this.packages = new List<LockedPackage>()
    }

    public int getFormatVersion()    { out = this.formatVersion }
    public string getTomlChecksum()  { out = this.tomlChecksum }
    public void setTomlChecksum(const string v) { this.tomlChecksum = v }
    public void setFlyVersion(const string v)  { this.flyVersion = v }

    public void addPackage(const LockedPackage p) { this.packages.add(p) }
    public int packageCount()                     { out = (int)this.packages.size() }
    public LockedPackage packageAt(const int i)   { out = this.packages.get(i) }

    public LockedPackage find(const string name) {
        int i = 0
        while i < this.packages.size() {
            LockedPackage p = this.packages.get(i)
            if str.equals(p.getName(), name) { out = p  return }
            i = i + 1
        }
        out = null
    }

    // isStale — the on-disk Manifest.fly no longer matches the recorded checksum.
    public bool isStale(const string tomlPath) {
        if str.isEmpty(this.tomlChecksum) { out = true  return }
        out = str.equals(fly.driver.sha256File(tomlPath), this.tomlChecksum) == false
    }

    // serialize — the Lock.fly source: a class extending fly.meta.Lockfile, read back
    // by FlyLockReader. Each package is `new LockedPackage(name, version, source, rev,
    // tag, checksum, <deps...>)` — the "<name> <version>" deps are trailing positional
    // args. Machine-generated: "do not edit".
    public string serialize() {
        string q = fly.driver.dq()
        string nl = fly.driver.nl()
        string s = str.concat("namespace pkg.lock", nl)
        s = str.concat(s, str.concat("import fly.meta.*", nl))
        s = str.concat(s, nl)
        s = str.concat(s, str.concat("// Lock.fly — generated by fly. Do not edit.", nl))
        s = str.concat(s, str.concat("class Lockfile : fly.meta.Lockfile {", nl))
        s = str.concat(s, this.kv("  string flyVersion = ", this.flyVersion, q, nl))
        s = str.concat(s, this.kv("  string checksum = ", this.tomlChecksum, q, nl))
        string a = "  LockedPackage[] packages = { "
        int i = 0
        while i < this.packages.size() {
            if i > 0 { a = str.concat(a, ", ") }
            a = str.concat(a, this.pkgNew(this.packages.get(i), q))
            i = i + 1
        }
        a = str.concat(a, " }")
        s = str.concat(s, str.concat(a, nl))
        s = str.concat(s, str.concat("}", nl))
        out = s
    }

    // pkgNew — new LockedPackage(name, version, source, rev, tag, checksum, dep...).
    public string pkgNew(const LockedPackage p, const string q) {
        List<string> args = new List<string>()
        args.add(p.getName())
        args.add(p.getVersion())
        args.add(p.getSource())
        args.add(p.getRev())
        args.add(p.getTag())
        args.add(p.getChecksum())
        int d = 0
        while d < p.depCount() { args.add(p.depAt(d))  d = d + 1 }
        string s = "new LockedPackage("
        int i = 0
        while i < args.size() {
            if i > 0 { s = str.concat(s, ", ") }
            s = str.concat(s, str.concat(q, str.concat(args.get(i), q)))
            i = i + 1
        }
        out = str.concat(s, ")")
    }

    // kv — `<prefix>"<value>"<nl>`
    public string kv(const string prefix, const string value, const string q, const string nl) {
        string body = str.concat(q, str.concat(value, q))
        out = str.concat(prefix, str.concat(body, nl))
    }

    // write — serialize to `path`.
    public void write(const string path) {
        fs.writeStr(path, this.serialize(), 420)
    }
}

// FlyLockReader — parse a Lock.fly (a class extending fly.meta.Lockfile) with the
// compiler's OWN parser and walk the AST into a Lockfile — the same declarative,
// parse-only approach FlyManifestReader uses for the manifest.
public class FlyLockReader {

    public FlyLockReader() { }

    public Lockfile read(const string src, int errOut) {
        Parser p = new Parser(src)
        ASTModule mod = p.parseModule("Lock")
        if p.isSuccess() == false { errOut = 210  out = new Lockfile()  return }
        ASTClass lc = this.findLockClass(mod)
        if lc == null { errOut = 211  out = new Lockfile()  return }
        Lockfile lf = new Lockfile()
        this.readLockClass(lc, lf)
        errOut = 0
        out = lf
    }

    ASTClass findLockClass(const ASTModule mod) {
        List<ASTNode> nodes = mod.getNodes()
        int i = 0
        while i < nodes.size() {
            ASTClass c = nodes.get(i).asClass()
            if c != null { out = c  return }      // a Lock.fly holds exactly one class
            i = i + 1
        }
        out = null
    }

    void readLockClass(const ASTClass c, const Lockfile lf) {
        List<ASTNode> members = c.getNodes()
        int i = 0
        while i < members.size() {
            ASTVar v = members.get(i).asVar()
            if v != null { this.readField(v, lf) }
            i = i + 1
        }
    }

    void readField(const ASTVar v, const Lockfile lf) {
        string name = v.getName()
        ASTExpr init = v.getExpr()
        if init == null { return }
        if str.equals(name, "flyVersion") { lf.setFlyVersion(this.strOf(init))    return }
        if str.equals(name, "checksum")   { lf.setTomlChecksum(this.strOf(init))  return }
        if str.equals(name, "packages")   { this.readPackages(init, lf)           return }
    }

    // readPackages — `{ new LockedPackage(name, version, source, rev, tag, checksum,
    // dep0, dep1, ...), ... }`. Args 0..5 are scalars; 6+ are dependency entries.
    void readPackages(const ASTExpr e, const Lockfile lf) {
        ASTArrayValue arr = e.asArrayValue()
        if arr == null { return }
        List<ASTExpr> vals = arr.getValues()
        int i = 0
        while i < vals.size() {
            ASTCall call = vals.get(i).asCall()
            if call != null {
                List<ASTArg> args = call.getArgs()
                LockedPackage p = new LockedPackage()
                if args.size() > 0 { p.setName(this.argStr(args, 0)) }
                if args.size() > 1 { p.setVersion(this.argStr(args, 1)) }
                if args.size() > 2 { p.setSource(this.argStr(args, 2)) }
                if args.size() > 3 { p.setRev(this.argStr(args, 3)) }
                if args.size() > 4 { p.setTag(this.argStr(args, 4)) }
                if args.size() > 5 { p.setChecksum(this.argStr(args, 5)) }
                int d = 6
                while d < args.size() { p.addDep(this.argStr(args, d))  d = d + 1 }
                lf.addPackage(p)
            }
            i = i + 1
        }
    }

    string strOf(const ASTExpr e) {
        ASTStringValue sv = e.asStringValue()
        if sv != null { out = sv.getValue() } else { out = "" }
    }
    string argStr(const List<ASTArg> args, const int idx) {
        ASTNode e = args.get(idx).getExpr()
        ASTStringValue sv = e.asStringValue()
        if sv != null { out = sv.getValue() } else { out = "" }
    }
}

// readLock — read the Lock.fly at `path` with the compiler's parser (empty Lockfile
// if missing or on a parse error — a stale/absent lock just forces a re-lock).
public Lockfile readLock(const string path, int errOut) {
    Lockfile lf = new Lockfile()
    if fs.exists(path) == false { errOut = 0  out = lf  return }
    string src = fs.readStr(path)
    int e = 0
    FlyLockReader r = new FlyLockReader()
    Lockfile parsed = r.read(src, e)
    errOut = 0
    out = parsed
}
