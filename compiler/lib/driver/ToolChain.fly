namespace fly.driver

import fly.compiler.basic.*
import fly.compiler.target.*
import fly.compiler.frontend.FrontendOptions
import fly.os.proc
import fly.os.fs
import fly.os.path
import fly.os.env
import fly.os.io
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// ToolChain — faithful 1:1 port of fly/compiler/Driver/ToolChain.cpp (+ .h):
// build the platform linker command line (arch/OS dispatch, crt objects, dynamic
// linker, lib paths, system libs) and link.
//
// Self-host adaptations (the language/runtime can't do these 1:1):
//   • In-process LLD → subprocess. The C++ calls lld::{elf,coff,macho}::link(args)
//     (the LLD library). The self-host has no LLD binding, so it builds the SAME
//     argument list and EXECs the LLD binary `ld.lld`/`ld64.lld`/`lld-link`
//     (fallback `ld`) via fly.os.proc.exec.
//   • llvm::vfs / llvm::sys::path → fly.os.fs.exists / fly.os.path.join.
//   • Windows VS/SDK discovery (COM + registry) is not expressible in pure Fly:
//     getUniversalCRTLibraryPath / getWindowsSDKLibraryPath are stubs (false).
//     LinkWindows structure is kept; it is inert on the Linux self-host.
//   • The external Archiver (CreateLibrary path, Archiver.cpp — not in scope) is
//     stubbed: BuildOutput's library branch returns false.
//   • Diag.Report (location-less toolchain errors) → fly.os.io.printErrLn.
//   • FLY_LLVM_VERSION_MAJOR / FLY_LLVM_DIR (read by the C++ reference) are NOT read
//     by the self-host: llvmMajor() is hardcoded "20" and the LLVM lib dir is fixed
//     (getLLVMLibDir / system /usr/lib/llvm-20). The Windows sysroot / LLVM-lib
//     overrides are CLI flags (--mingw-sysroot / --llvm-lib-dir), NOT env vars — the
//     compiler takes no env config; the ci scripts pass the flags.
//
// SmallVector<std::string> CmdArgs → a fly.os.proc ArgList handle, accumulated
// with argsAdd and run with exec (the program name is exec's `path`, not arg 0).
// ─────────────────────────────────────────────────────────────────────────────

// segCount / segAt / segAppend (";"-delimited list helpers) now live in
// fly.compiler.basic (compiler/lib/basic/StrList.fly), imported above.

// llvmMajor — the LLVM major version the self-host targets (libLLVM-20).
public string llvmMajor() { out = "20" }

// envPathSeparator — the $PATH list separator for host os name `osName`
// (llvm::sys::EnvPathSeparator in the reference): ";" on Windows, whose PATH
// entries are drive paths like "C:\...", ":" everywhere else. Pure, so
// ToolChainSuite can pin both branches.
public string envPathSeparator(const string osName) {
    if str.equals(osName, "windows") { out = ";" } else { out = ":" }
}

// archToCompilerRTSuffix — compiler-rt arch suffix; "" if unsupported.
public string archToCompilerRTSuffix(const Arch a) {
    if a == Arch.X86_64  { out = "x86_64"  return }
    if a == Arch.X86     { out = "i386"    return }
    if a == Arch.AARCH64 { out = "aarch64" return }
    if a == Arch.ARM     { out = "arm"     return }
    if a == Arch.RISCV32 { out = "riscv32" return }
    if a == Arch.RISCV64 { out = "riscv64" return }
    out = ""
}

public class ToolChain {

    DiagnosticsEngine diags
    Triple t
    CodeGenOptions codeGenOpts

    public ToolChain(const DiagnosticsEngine diags, const Triple t, const CodeGenOptions codeGenOpts) {
        this.diags = diags
        this.t = t
        this.codeGenOpts = codeGenOpts
    }

    // resolveProg — resolve a program name to a full path via $PATH. The runtime's
    // proc_exec is raw execve (no PATH search, unlike the C++'s in-process LLD, which
    // never spawned), so the linker must be an absolute path. "" if not found.
    // The list separator is the HOST's (envPathSeparator: ";" on Windows, ":"
    // elsewhere — splitting a Windows PATH on ":" cuts at every drive letter and
    // the search can never hit), and on Windows each dir is probed for `name`
    // then `name.exe`, since the on-disk linker is `ld.lld.exe`.
    public string resolveProg(const string name) {
        if str.contains(name, "/") || path.isAbsolute(name) { out = name  return }
        string hostOs = env.osname()
        bool win = str.equals(hostOs, "windows")
        string sep = envPathSeparator(hostOs)
        string pathEnv = env.get("PATH")
        if str.isEmpty(pathEnv) {
            if win { out = ""  return }
            pathEnv = "/usr/bin:/bin"
        }
        int from = 0
        int len = str.len(pathEnv)
        string found = ""
        bool go = true
        while go {
            string tail = str.substring(pathEnv, from, len)
            int rel = str.indexOf(tail, sep)
            int end = len
            if rel >= 0 { end = from + rel }
            string dir = str.substring(pathEnv, from, end)
            if str.isEmpty(dir) == false {
                string cand = path.join(dir, name)
                if fs.exists(cand) { found = cand  go = false }
                elsif win {
                    string candExe = path.join(dir, str.concat(name, ".exe"))
                    if fs.exists(candExe) { found = candExe  go = false }
                }
            }
            if rel < 0 { go = false } else { from = end + 1 }
        }
        out = found
    }

    // ── runLinker — exec `prog` (fallback `alt`) with the built ArgList. Returns
    // true on a 0 exit code. Replaces the in-process lld::*::link(args) call;
    // resolves the binary against $PATH (execve needs a full path).
    //
    // The LLD linker bundled next to the fly executable (<exe_dir>/<prog>, e.g.
    // <exe_dir>/ld.lld — or lld-link.exe on Windows — the linker the release ships)
    // is preferred over the host's PATH, so a machine with no system linker can still
    // link. It is the fork LLVM's own relocatable ld.lld shipped verbatim under its
    // native name: LLD picks its flavor from argv[0] (ld.lld → ELF, ld64.lld → Mach-O,
    // lld-link → COFF), so shipping it under `prog` needs no `-flavor` and no custom
    // driver. Falls back to the system linker (prog then alt) when no bundled copy sits
    // beside the binary (the dev build).
    public bool runLinker(const string prog, const string alt, const pointer h) {
        string p = ""
        string exe = env.exePath()
        if str.isEmpty(exe) == false {
            string dir = path.dirname(exe)
            // Preferred: the fork LLD shipped under its native name (<exe_dir>/ld.lld,
            // ld64.lld or lld-link[.exe]) — LLD self-selects the flavor from argv[0].
            // Only original LLVM tool names are bundled (no fly-specific renames).
            string bundled = path.join(dir, prog)
            string bundledExe = path.join(dir, str.concat(prog, ".exe"))
            if fs.exists(bundled) { p = bundled }
            elsif fs.exists(bundledExe) { p = bundledExe }
        }
        if str.isEmpty(p) { p = this.resolveProg(prog) }
        if str.isEmpty(p) { p = this.resolveProg(alt) }
        if str.isEmpty(p) {
            io.printErrLn(str.concat(str.concat("error: linker not found: ", prog), str.concat(" / ", alt)))
            out = false
            return
        }
        int rc = proc.exec(p, h)
        out = rc == 0
    }

    // ── BuildOutput — top-level dispatcher (cpp:72-108) ───────────────────────
    public bool BuildOutput(const string inFilesSemi, const FrontendOptions frontendOpts) {
        string outFileName = frontendOpts.getOutputFile()
        // A generated .fly.h is a standalone artifact, never an input to the linker.
        // Only the archive path used to filter it, so every LINKING build that also
        // emitted a header (--lib-dyn, or --header alongside a normal link) handed
        // lld the .fly.h and died with "unknown file type". (reference parity.)
        string objFiles = this.dropHeaders(inFilesSemi)
        if frontendOpts.getCreateLibrary() {
            // Archiver (Archiver.cpp) is not ported — library archiving unavailable.
            io.printErrLn("error: library archiving (Archiver) not ported in the self-host")
            out = false
            return
        }
        if this.t.isWindowsMSVC() {
            out = this.LinkWindows(objFiles, outFileName)
        } elsif this.t.isOSWindows() {
            // windows-gnu / gnullvm: link against the bundled mingw/UCRT sysroot
            // (no Visual Studio needed).
            out = this.LinkWindowsGNU(objFiles, outFileName)
        } elsif this.t.isOSDarwin() {
            out = this.LinkDarwin(objFiles, outFileName)
        } else {
            out = this.LinkLinux(objFiles, outFileName, frontendOpts)
        }
    }

    public bool BuildLib() { out = false }

    // dropHeaders — the ";"-list without any generated `.fly.h`. Those are
    // declaration files, not objects; handing one to the linker aborts the build
    // with "unknown file type". (reference ToolChain.cpp::BuildOutput parity.)
    public string dropHeaders(const string filesSemi) {
        string kept = ";"
        int n = segCount(filesSemi)
        int i = 0
        while i < n {
            string f = segAt(filesSemi, i)
            if str.endsWith(f, ".fly.h") == false { kept = segAppend(kept, f) }
            i = i + 1
        }
        out = kept
    }

    // ── LinkLinux — the core (cpp:793-1019) ───────────────────────────────────
    public bool LinkLinux(const string inFilesSemi, const string outFile, const FrontendOptions frontendOpts) {
        pointer h = proc.argsNew()

        if str.isEmpty(this.codeGenOpts.getToolchainLibDir()) == false {
            proc.argsAdd(h, str.concat("-L", this.codeGenOpts.getToolchainLibDir()))
        }

        Arch arch = this.t.getArch()
        bool isAndroid = this.t.isAndroid()
        bool isIAMCU = this.t.isOSIAMCU()
        bool isVE = this.t.isVE()
        bool isPIE = this.getPIE()
        bool isStaticPIE = this.codeGenOpts.getStaticPIE()
        bool isStatic = this.codeGenOpts.getStatic() && this.codeGenOpts.getStaticPIE() == false

        if isPIE { proc.argsAdd(h, "-pie") }

        if isStaticPIE {
            proc.argsAdd(h, "-static")
            proc.argsAdd(h, "-pie")
            proc.argsAdd(h, "--no-dynamic-linker")
            proc.argsAdd(h, "-z")
            proc.argsAdd(h, "text")
        }

        if this.codeGenOpts.getRDynamic() { proc.argsAdd(h, "-export-dynamic") }

        // ARM endianness
        if this.t.isARM() || this.t.isThumb() || this.t.isAArch64() {
            bool isBE = this.isArmBigEndian()
            if isBE { proc.argsAdd(h, "--be8") }
            bool be2 = isBE || arch == Arch.AARCH64_BE
            if be2 { proc.argsAdd(h, "-EB") } else { proc.argsAdd(h, "-EL") }
        }

        if isAndroid { proc.argsAdd(h, "--warn-shared-textrel") }

        proc.argsAdd(h, "--eh-frame-hdr")

        string ldm = this.getLDMOption()
        if str.isEmpty(ldm) {
            io.printErrLn(str.concat("error: unknown target triple: ", this.t.getTriple()))
            proc.argsFree(h)
            out = false
            return
        }
        proc.argsAdd(h, "-m")
        proc.argsAdd(h, ldm)

        if isStatic {
            if arch == Arch.ARM || arch == Arch.ARMEB {
                proc.argsAdd(h, "-Bstatic")
            } else {
                proc.argsAdd(h, "-static")
            }
        } elsif this.codeGenOpts.getShared() {
            proc.argsAdd(h, "-shared")
        }

        if isStatic == false {
            if this.codeGenOpts.getRDynamic() { proc.argsAdd(h, "-export-dynamic") }
            if this.codeGenOpts.getShared() == false && isStaticPIE == false {
                string dynLinker = ""
                if arch == Arch.X86_64      { dynLinker = "/lib64/ld-linux-x86-64.so.2" }
                elsif arch == Arch.AARCH64  { dynLinker = "/lib/ld-linux-aarch64.so.1" }
                elsif arch == Arch.ARM      { dynLinker = "/lib/ld-linux-armhf.so.3" }
                elsif arch == Arch.RISCV64  { dynLinker = "/lib/ld-linux-riscv64-lp64d.so.1" }
                if str.isEmpty(dynLinker) == false && fs.exists(dynLinker) {
                    proc.argsAdd(h, "-dynamic-linker")
                    proc.argsAdd(h, dynLinker)
                }
            }
        }

        // Output
        proc.argsAdd(h, "-o")
        proc.argsAdd(h, outFile)

        // Path list (";"-delimited)
        string pathList = this.CreatePathList()

        // crt1 + crti
        if isAndroid == false && isIAMCU == false {
            string crt1 = ""
            if this.codeGenOpts.getShared() == false {
                if isPIE { crt1 = "Scrt1.o" }
                elsif isStaticPIE { crt1 = "rcrt1.o" }
                else { crt1 = "crt1.o" }
            }
            if str.isEmpty(crt1) == false {
                proc.argsAdd(h, this.GetFilePath(crt1, pathList))
            }
            proc.argsAdd(h, this.GetFilePath("crti.o", pathList))
        }

        if isVE {
            proc.argsAdd(h, "-z")
            proc.argsAdd(h, "max-page-size=0x4000000")
        }

        // Inputs (the emitted object files, ";"-delimited)
        int ni = segCount(inFilesSemi)
        int i = 0
        while i < ni {
            proc.argsAdd(h, segAt(inFilesSemi, i))
            i = i + 1
        }

        // User .a/.lib inputs
        int nf = frontendOpts.inputCount()
        int j = 0
        while j < nf {
            string inp = frontendOpts.inputAt(j)
            string ex = path.ext(inp)
            if str.equals(ex, ".a") || str.equals(ex, ".lib") {
                proc.argsAdd(h, inp)
            }
            j = j + 1
        }

        // fly_std_lib.a then libfly_runtime — required: linking without them only
        // surfaces later as cryptic undefined-symbol errors from ld.
        if this.requireFlyArchives() == false {
            proc.argsFree(h)
            out = false
            return
        }
        proc.argsAdd(h, this.GetStdLibPath())
        proc.argsAdd(h, this.GetRuntimeLibPath())
        this.addTlsArchives(h, "-lssl", "-lcrypto")

        // -L for every path in the list
        int np = segCount(pathList)
        int k = 0
        while k < np {
            proc.argsAdd(h, str.concat("-L", segAt(pathList, k)))
            k = k + 1
        }

        // LLVM lib dir, so programs using the LLVM C-API (the compiler's own
        // CodeGen/Target test suites reference `libLLVM-20.so` → `-lLLVM-20`)
        // link. With the fork LLVM there is no apt/system libLLVM anywhere:
        // it lives next to fly (release bundle) or in build/llvm/lib (dev) —
        // same probe as LinkWindowsGNU. Skipped if absent: ordinary user
        // programs don't reference LLVM.
        string llvmLibDir = this.getLLVMLibDir()
        if str.isEmpty(llvmLibDir) == false {
            proc.argsAdd(h, str.concat("-L", llvmLibDir))
        }

        if isStatic || isStaticPIE { proc.argsAdd(h, "--start-group") }

        proc.argsAdd(h, "-lc")
        proc.argsAdd(h, "-lm")

        // CLang-bridge libs
        string lo = this.codeGenOpts.getLinkerOptions()
        int nl = segCount(lo)
        int li = 0
        while li < nl {
            proc.argsAdd(h, segAt(lo, li))
            li = li + 1
        }

        // compiler-rt builtins
        string builtins = this.GetCompilerRTBuiltinsPath()
        if str.isEmpty(builtins) {
            io.printErrLn(str.concat("error: compiler-rt builtins not found for ", this.t.getTriple()))
            proc.argsFree(h)
            out = false
            return
        }
        proc.argsAdd(h, builtins)

        if isIAMCU { proc.argsAdd(h, "-lgloss") }

        if isStatic || isStaticPIE { proc.argsAdd(h, "--end-group") }

        if isIAMCU {
            proc.argsAdd(h, "--as-needed")
            proc.argsAdd(h, "-lsoftfp")
            proc.argsAdd(h, "--no-as-needed")
        }

        if isIAMCU == false && isAndroid == false {
            string crtn = this.GetFilePath("crtn.o", pathList)
            if str.isEmpty(crtn) == false { proc.argsAdd(h, crtn) }
        }

        bool ok = false
        if this.t.isOSBinFormatELF() {
            ok = this.runLinker("ld.lld", "ld", h)
        } else {
            io.printErrLn(str.concat("error: unsupported object format for target ", this.t.getTriple()))
        }
        proc.argsFree(h)
        out = ok
    }

    // ── LinkDarwin (cpp:749-791) ──────────────────────────────────────────────
    public bool LinkDarwin(const string inFilesSemi, const string outFile) {
        pointer h = proc.argsNew()
        proc.argsAdd(h, "-e")
        proc.argsAdd(h, "_main")
        proc.argsAdd(h, "-o")
        proc.argsAdd(h, outFile)

        if str.isEmpty(this.codeGenOpts.getToolchainLibDir()) == false {
            proc.argsAdd(h, str.concat("-L", this.codeGenOpts.getToolchainLibDir()))
        }

        int ni = segCount(inFilesSemi)
        int i = 0
        while i < ni { proc.argsAdd(h, segAt(inFilesSemi, i))  i = i + 1 }

        if this.requireFlyArchives() == false {
            proc.argsFree(h)
            out = false
            return
        }
        proc.argsAdd(h, this.GetStdLibPath())
        proc.argsAdd(h, this.GetRuntimeLibPath())
        this.addTlsArchives(h, "-lssl", "-lcrypto")

        string lo = this.codeGenOpts.getLinkerOptions()
        int nl = segCount(lo)
        int li = 0
        while li < nl { proc.argsAdd(h, segAt(lo, li))  li = li + 1 }

        bool ok = false
        if this.t.isOSBinFormatMachO() {
            ok = this.runLinker("ld64.lld", "ld", h)
        } else {
            io.printErrLn(str.concat("error: unsupported object format for target ", this.t.getTriple()))
        }
        proc.argsFree(h)
        out = ok
    }

    // ── LinkWindows (cpp:499-608) — structural; SDK discovery stubbed ─────────
    public bool LinkWindows(const string inFilesSemi, const string outFile) {
        pointer h = proc.argsNew()
        // A dynamic library (--lib-dyn) is a .dll produced with /dll — which also
        // yields its import .lib; anything else is an .exe. Without /dll lld-link
        // stops at "subsystem must be defined", which is why a dynamic library never
        // linked on Windows: LinkLinux honours CodeGenOpts.Shared (-shared) but this
        // path never did. The extension is appended only when -o did not carry one,
        // so `-o app` gives app.exe while `-o app.exe` is left alone. (reference parity.)
        bool buildDll = this.codeGenOpts.getShared()
        string outPath = outFile
        if str.isEmpty(path.ext(outFile)) {
            if buildDll { outPath = str.concat(outFile, ".dll") }
            else { outPath = str.concat(outFile, ".exe") }
        }
        proc.argsAdd(h, str.concat("/out:", outPath))
        if buildDll { proc.argsAdd(h, "/dll") }

        if str.isEmpty(this.codeGenOpts.getToolchainLibDir()) == false {
            proc.argsAdd(h, str.concat("/libpath:", this.codeGenOpts.getToolchainLibDir()))
        }
        proc.argsAdd(h, "/defaultlib:libcmt")
        proc.argsAdd(h, "/defaultlib:synchronization")
        proc.argsAdd(h, "/defaultlib:kernel32")
        proc.argsAdd(h, "/defaultlib:ws2_32")   // Winsock (runtime net_*)

        // VS toolchain + UCRT + Windows SDK lib paths are discovered via COM/
        // registry in the C++ — not expressible in pure Fly, so stubbed (skipped).
        string ucrt = ""
        if this.getUniversalCRTLibraryPath() == true { proc.argsAdd(h, ucrt) }
        string sdk = ""
        if this.getWindowsSDKLibraryPath() == true { proc.argsAdd(h, sdk) }

        int ni = segCount(inFilesSemi)
        int i = 0
        while i < ni { proc.argsAdd(h, segAt(inFilesSemi, i))  i = i + 1 }

        if this.requireFlyArchives() == false {
            proc.argsFree(h)
            out = false
            return
        }
        proc.argsAdd(h, this.GetStdLibPath())
        proc.argsAdd(h, this.GetRuntimeLibPath())
        this.addTlsArchives(h, "secur32.lib", "crypt32.lib")

        // -lNAME → NAME.lib
        string lo = this.codeGenOpts.getLinkerOptions()
        int nl = segCount(lo)
        int li = 0
        while li < nl {
            string flag = segAt(lo, li)
            if str.len(flag) > 2 && str.startsWith(flag, "-l") {
                string nm = str.substring(flag, 2, str.len(flag))
                proc.argsAdd(h, str.concat(nm, ".lib"))
            } else {
                proc.argsAdd(h, flag)
            }
            li = li + 1
        }

        bool ok = false
        if this.t.isOSBinFormatCOFF() {
            ok = this.runLinker("lld-link", "link", h)
        } else {
            io.printErrLn(str.concat("error: unsupported object format for target ", this.t.getTriple()))
        }
        proc.argsFree(h)
        out = ok
    }

    // Windows VS/SDK discovery needs COM + registry — not portable. Stubs.
    public bool getUniversalCRTLibraryPath() { out = false }
    public bool getWindowsSDKLibraryPath()   { out = false }

    // ── LinkWindowsGNU — link a PE/COFF exe against the bundled mingw/UCRT sysroot
    // (llvm-mingw), needing NO Visual Studio. Mirrors the fork's fly-lang bootstrap
    // link: `ld.lld -m i386pep` with the mingw CRT startup objects + import libs +
    // compiler-rt builtins. The gnu triple makes LLVM emit `___chkstk_ms` (resolved
    // from the builtins archive) and no `_fltused`, so no CRT-glue shim is needed.
    // The sysroot ships in the release next to fly.exe (<exe_dir>/mingw); x86_64 only.
    public bool LinkWindowsGNU(const string inFilesSemi, const string outFile) {
        string sysroot = this.getMingwSysrootDir()
        if str.isEmpty(sysroot) {
            io.printErrLn("error: mingw/UCRT sysroot not found (expected <fly_dir>/mingw; pass --mingw-sysroot <dir>)")
            out = false
            return
        }
        string slib = path.join(sysroot, "lib")
        string builtinsDir = path.join(sysroot, "builtins")
        string builtinsLib = path.join(builtinsDir, "libclang_rt.builtins-x86_64.a")

        // NOTE: -static / -pie are NOT honored here — this path otherwise links a
        // console .exe (crt2.o startup); those link modes are implemented only on the
        // ELF/Linux path. --lib-dyn IS honoured: it passes --shared and names the
        // artifact .dll, matching what LinkWindows does with /dll (reference parity).
        bool buildDll = this.codeGenOpts.getShared()
        pointer h = proc.argsNew()
        if buildDll {
            proc.argsAdd(h, "--shared")
            // x86_64 PE DLL entry: dllcrt2.o defines DllMainCRTStartup (no
            // underscore); ld's --shared default is the i386 `_`-prefixed
            // spelling, so name it explicitly (what mingw gcc does with -e).
            proc.argsAdd(h, "--entry")
            proc.argsAdd(h, "DllMainCRTStartup")
        }
        proc.argsAdd(h, "-m")
        proc.argsAdd(h, "i386pep")                       // x86_64 PE emulation
        proc.argsAdd(h, str.concat("-L", slib))
        proc.argsAdd(h, str.concat("-L", builtinsDir))
        if str.isEmpty(this.codeGenOpts.getToolchainLibDir()) == false {
            proc.argsAdd(h, str.concat("-L", this.codeGenOpts.getToolchainLibDir()))
        }
        // LLVM import-lib dir, so programs using the LLVM C-API (the compiler's own
        // CodeGen/Target test suites reference `libLLVM-20.so` → `-lLLVM-20`) link.
        // Windows has no system LLVM (on Linux `-lLLVM-20` resolves from the
        // apt-installed system libdir enumerated by CreatePathList); here it lives
        // next to fly.exe (release) or in build/llvm/lib (dev). Skipped if absent —
        // ordinary user programs don't reference LLVM.
        string llvmLibDir = this.getLLVMLibDir()
        if str.isEmpty(llvmLibDir) == false {
            proc.argsAdd(h, str.concat("-L", llvmLibDir))
        }

        // CRT startup objects. `___chkstk_ms` (large-frame stack probe) resolves
        // from the compiler-rt builtins archive added below — no compat shim.
        // A DLL uses the DLL entry stub (dllcrt2.o, DllMainCRTStartup): crt2.o is
        // the console-exe stub whose startup calls main/WinMain, which a library
        // does not have.
        if buildDll {
            proc.argsAdd(h, path.join(slib, "dllcrt2.o"))
        } else {
            proc.argsAdd(h, path.join(slib, "crt2.o"))
        }
        proc.argsAdd(h, path.join(slib, "crtbegin.o"))

        // User objects.
        int ni = segCount(inFilesSemi)
        int i = 0
        while i < ni { proc.argsAdd(h, segAt(inFilesSemi, i))  i = i + 1 }

        // The Fly std + runtime archives.
        if this.requireFlyArchives() == false {
            proc.argsFree(h)
            out = false
            return
        }
        proc.argsAdd(h, this.GetStdLibPath())
        proc.argsAdd(h, this.GetRuntimeLibPath())
        this.addTlsArchives(h, "-lsecur32", "-lcrypt32")

        // User -l options pass through (mingw resolves `-lNAME` → libNAME.a), EXCEPT
        // -lc / -lm: those are POSIX, the mingw/UCRT CRT ships no libc.a/libm.a, and
        // their symbols (strlen, sin, …) come from -lmsvcrt/-lmingwex linked below.
        // A C-bridge program that names libc.so.6 (→ -lc) must still link on Windows.
        string lo = this.codeGenOpts.getLinkerOptions()
        int nl = segCount(lo)
        int li = 0
        while li < nl {
            string opt = segAt(lo, li)
            if str.equals(opt, "-lc") == false && str.equals(opt, "-lm") == false {
                proc.argsAdd(h, opt)
            }
            li = li + 1
        }

        // mingw import libs + compiler-rt builtins (libmingw32 brackets the group).
        proc.argsAdd(h, "-lmingw32")
        if fs.exists(builtinsLib) { proc.argsAdd(h, builtinsLib) }
        proc.argsAdd(h, "-lmoldname")
        proc.argsAdd(h, "-lmingwex")
        proc.argsAdd(h, "-lmsvcrt")
        proc.argsAdd(h, "-ladvapi32")
        proc.argsAdd(h, "-lshell32")
        proc.argsAdd(h, "-luser32")
        proc.argsAdd(h, "-lkernel32")
        proc.argsAdd(h, "-lntdll")              // RtlGetVersion (runtime env_kernel*)
        proc.argsAdd(h, "-lws2_32")             // Winsock (runtime net_*)
        proc.argsAdd(h, "-lwinhttp")            // WinHTTP (runtime net_https_*)
        proc.argsAdd(h, "-lsynchronization")
        proc.argsAdd(h, "-lmingw32")
        proc.argsAdd(h, path.join(slib, "crtend.o"))

        proc.argsAdd(h, "-o")
        // Same rule as LinkWindows: --lib-dyn builds a .dll (with --shared, the GNU
        // spelling of /dll), everything else an .exe; the extension is appended only
        // when -o did not already carry one.
        string gnuOut = outFile
        if str.isEmpty(path.ext(outFile)) {
            if buildDll { gnuOut = str.concat(outFile, ".dll") }
            else { gnuOut = str.concat(outFile, ".exe") }
        }
        proc.argsAdd(h, gnuOut)

        // Already dispatched here via isOSWindows() → PE/COFF; ld.lld picks the GNU
        // flavour from argv[0] and `-m i386pep` selects x86_64 PE.
        bool ok = this.runLinker("ld.lld", "ld", h)
        proc.argsFree(h)
        out = ok
    }

    // getMingwSysrootDir — locate the bundled mingw/UCRT sysroot: the --mingw-sysroot
    // override, else <exe_dir>/mingw (release layout), else <exe_dir>/../../mingw (dev
    // build: build/stage$STAGE/bin → build/mingw). "" if none found. The compiler is
    // driven only by CLI flags — no env var here; the ci scripts pass the flag.
    public string getMingwSysrootDir() {
        string ovr = this.codeGenOpts.getMingwSysrootDir()
        if str.isEmpty(ovr) == false {
            if fs.exists(ovr) { out = ovr  return }
        }
        string exe = env.exePath()
        if str.isEmpty(exe) == false {
            string dir = path.dirname(exe)
            string s1 = path.join(dir, "mingw")
            if fs.exists(s1) { out = s1  return }
            string build = path.dirname(path.dirname(dir))
            string s2 = path.join(build, "mingw")
            if fs.exists(s2) { out = s2  return }
        }
        out = ""
    }

    // llvmLibDirCandidates — the probe list relative to the fly binary's dir, as
    // a ";"-separated list in probe order (reference Driver.cpp: <exe>/llvm/lib,
    // <exe>/../llvm/lib, <exe>/../../llvm/lib). Pure, so ToolChainSuite can pin
    // the order without touching the filesystem.
    public string llvmLibDirCandidates(const string exeDir) {
        string s1 = path.join(path.join(exeDir, "llvm"), "lib")
        string parent = path.dirname(exeDir)
        string s2 = path.join(path.join(parent, "llvm"), "lib")
        string build = path.dirname(parent)
        string s3 = path.join(path.join(build, "llvm"), "lib")
        out = str.concat(s1, str.concat(";", str.concat(s2, str.concat(";", s3))))
    }

    // getLLVMLibDir — locate the dir holding the LLVM import lib (LLVM-20.lib, the
    // stage0 alias of LLVM-C.lib) so `-lLLVM-20` (emitted for codegen-using
    // programs) resolves on Windows, where there is no system LLVM. Probe order
    // mirrors the reference Driver.cpp: the --llvm-lib-dir override, then
    // <exe_dir>/llvm/lib (release bundle), <exe_dir>/../llvm/lib, and
    // <exe_dir>/../../llvm/lib (dev: build/stage$STAGE/bin → build/llvm/lib).
    // "" if none found (ordinary programs don't need LLVM).
    public string getLLVMLibDir() {
        string ovr = this.codeGenOpts.getLlvmLibDir()
        if str.isEmpty(ovr) == false {
            if fs.exists(ovr) { out = ovr  return }
        }
        string exe = env.exePath()
        if str.isEmpty(exe) == false {
            string rest = this.llvmLibDirCandidates(path.dirname(exe))
            while str.isEmpty(rest) == false {
                string cand = rest
                int sep = str.indexOf(rest, ";")
                if sep >= 0 {
                    cand = str.substring(rest, 0, sep)
                    // distinct temp: `x = substring(x, …)` would self-alias
                    string tail = str.substring(rest, sep + 1, str.len(rest))
                    rest = tail
                } else {
                    rest = ""
                }
                if fs.exists(cand) { out = cand  return }
            }
        }
        out = ""
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    public bool getPIE() {
        if this.codeGenOpts.getShared() || this.codeGenOpts.getStatic() { out = false  return }
        out = this.codeGenOpts.getPIE()
    }

    public bool isArmBigEndian() { out = this.t.getArch() == Arch.ARMEB }

    // getLDMOption — arch → ld emulation name ("" = unknown). (cpp:1031-1086)
    public string getLDMOption() {
        Arch a = this.t.getArch()
        if a == Arch.X86 {
            if this.t.isOSIAMCU() { out = "elf_iamcu" } else { out = "elf_i386" }
            return
        }
        if a == Arch.X86_64 {
            if this.t.isX32() { out = "elf32_x86_64" } else { out = "elf_x86_64" }
            return
        }
        if a == Arch.AARCH64    { out = "aarch64linux"  return }
        if a == Arch.AARCH64_BE { out = "aarch64linuxb" return }
        if a == Arch.ARM        { out = "armelf_linux_eabi"  return }
        if a == Arch.ARMEB      { out = "armelfb_linux_eabi" return }
        if a == Arch.PPC        { out = "elf32ppclinux" return }
        if a == Arch.PPC64      { out = "elf64ppc"      return }
        if a == Arch.PPC64LE    { out = "elf64lppc"     return }
        if a == Arch.RISCV32    { out = "elf32lriscv"   return }
        if a == Arch.RISCV64    { out = "elf64lriscv"   return }
        if a == Arch.SPARC      { out = "elf32_sparc"   return }
        if a == Arch.SPARCV9    { out = "elf64_sparc"   return }
        if a == Arch.MIPS       { out = "elf32btsmip"   return }
        if a == Arch.MIPSEL     { out = "elf32ltsmip"   return }
        if a == Arch.MIPS64     { out = "elf64btsmip"   return }
        if a == Arch.MIPS64EL   { out = "elf64ltsmip"   return }
        if a == Arch.SYSTEMZ    { out = "elf64_s390"    return }
        if a == Arch.VE         { out = "elf64ve"       return }
        out = ""
    }

    // GetFilePath — find Name within the ";"-delimited path list; "" if absent.
    public string GetFilePath(const string name, const string pathList) {
        int n = segCount(pathList)
        int i = 0
        while i < n {
            string dir = segAt(pathList, i)
            if str.isEmpty(dir) == false {
                string p = path.join(dir, name)
                if fs.exists(p) { out = p  return }
            }
            i = i + 1
        }
        out = ""
    }

    public string getCompilerRT(const string name, const string pathList) {
        int n = segCount(pathList)
        int i = 0
        while i < n {
            string p = path.join(segAt(pathList, i), name)
            if fs.exists(p) { out = p  return }
            i = i + 1
        }
        out = ""
    }

    // getMultiarch — Debian multiarch dir guess, probed via fs.exists. (cpp:1134)
    public string getMultiarch() {
        Arch a = this.t.getArch()
        bool isAndroid = this.t.isAndroid()
        if a == Arch.ARM {
            if isAndroid { out = "arm-linux-androideabi"  return }
            if fs.exists("/lib/arm-linux-gnueabihf") { out = "arm-linux-gnueabihf"  return }
            if fs.exists("/lib/arm-linux-gnueabi")   { out = "arm-linux-gnueabi"    return }
        } elsif a == Arch.ARMEB {
            if fs.exists("/lib/armeb-linux-gnueabi") { out = "armeb-linux-gnueabi"  return }
        } elsif a == Arch.X86 {
            if isAndroid { out = "i686-linux-android"  return }
            if fs.exists("/lib/i386-linux-gnu") { out = "i386-linux-gnu"  return }
        } elsif a == Arch.X86_64 {
            if isAndroid { out = "x86_64-linux-android"  return }
            if this.t.isX32() == false && fs.exists("/lib/x86_64-linux-gnu") { out = "x86_64-linux-gnu"  return }
        } elsif a == Arch.AARCH64 {
            if isAndroid { out = "aarch64-linux-android"  return }
            if fs.exists("/lib/aarch64-linux-gnu") { out = "aarch64-linux-gnu"  return }
        } elsif a == Arch.AARCH64_BE {
            if fs.exists("/lib/aarch64_be-linux-gnu") { out = "aarch64_be-linux-gnu"  return }
        } elsif a == Arch.MIPS {
            if fs.exists("/lib/mips-linux-gnu") { out = "mips-linux-gnu"  return }
        } elsif a == Arch.MIPSEL {
            if isAndroid { out = "mipsel-linux-android"  return }
            if fs.exists("/lib/mipsel-linux-gnu") { out = "mipsel-linux-gnu"  return }
        } elsif a == Arch.MIPS64 {
            if fs.exists("/lib/mips64-linux-gnuabi64") { out = "mips64-linux-gnuabi64"  return }
            if fs.exists("/lib/mips64-linux-gnu")      { out = "mips64-linux-gnu"       return }
        } elsif a == Arch.MIPS64EL {
            if isAndroid { out = "mips64el-linux-android"  return }
            if fs.exists("/lib/mips64el-linux-gnuabi64") { out = "mips64el-linux-gnuabi64"  return }
            if fs.exists("/lib/mips64el-linux-gnu")      { out = "mips64el-linux-gnu"       return }
        } elsif a == Arch.PPC {
            if fs.exists("/lib/powerpc-linux-gnuspe") { out = "powerpc-linux-gnuspe"  return }
            if fs.exists("/lib/powerpc-linux-gnu")    { out = "powerpc-linux-gnu"     return }
        } elsif a == Arch.PPC64 {
            if fs.exists("/lib/powerpc64-linux-gnu") { out = "powerpc64-linux-gnu"  return }
        } elsif a == Arch.PPC64LE {
            if fs.exists("/lib/powerpc64le-linux-gnu") { out = "powerpc64le-linux-gnu"  return }
        } elsif a == Arch.SPARC {
            if fs.exists("/lib/sparc-linux-gnu") { out = "sparc-linux-gnu"  return }
        } elsif a == Arch.SPARCV9 {
            if fs.exists("/lib/sparc64-linux-gnu") { out = "sparc64-linux-gnu"  return }
        } elsif a == Arch.SYSTEMZ {
            if fs.exists("/lib/s390x-linux-gnu") { out = "s390x-linux-gnu"  return }
        }
        out = this.t.getTriple()
    }

    // getOSLibDir — lib / lib64 / lib32 / libx32. (cpp:1260-1301)
    public string getOSLibDir() {
        Arch a = this.t.getArch()
        if a == Arch.X86 || a == Arch.PPC { out = "lib32"  return }
        if a == Arch.X86_64 && this.t.isX32() { out = "libx32"  return }
        if a == Arch.RISCV32 { out = "lib32"  return }
        if this.t.isArch32Bit() { out = "lib" } else { out = "lib64" }
    }

    // CreatePathList — the ";"-delimited library search path list. (cpp:1303-1366)
    public string CreatePathList() {
        string list = ";"
        string multiarch = this.getMultiarch()
        string osLibDir = this.getOSLibDir()

        string osLib = str.concat("/", osLibDir)
        if fs.exists(osLib) { list = segAppend(list, osLib) }

        if str.equals(osLib, "/lib") == false {
            if fs.exists("/lib") { list = segAppend(list, "/lib") }
        }
        if fs.exists("/usr/lib") { list = segAppend(list, "/usr/lib") }
        if fs.exists("/usr/local/lib") { list = segAppend(list, "/usr/local/lib") }

        string usrLocalArch = path.join("/usr/local/lib", multiarch)
        if fs.exists(usrLocalArch) { list = segAppend(list, usrLocalArch) }
        string libArch = path.join("/lib", multiarch)
        if fs.exists(libArch) { list = segAppend(list, libArch) }
        string usrLibArch = path.join("/usr/lib", multiarch)
        if fs.exists(usrLibArch) { list = segAppend(list, usrLibArch) }

        // GCC dir (libgcc_eh.a etc.). The C++ scans the directory for the newest
        // version subdir; the self-host appends the base dir plus a fixed probe of
        // the common major-version subdirs (where libgcc*/crt* actually live).
        string gccBase = path.join("/usr/lib/gcc", multiarch)
        if fs.exists(gccBase) {
            list = segAppend(list, gccBase)
            int gv = 15
            while gv >= 9 {
                string vdir = path.join(gccBase, str.convert(gv))
                if fs.exists(vdir) { list = segAppend(list, vdir) }
                gv = gv - 1
            }
        }

        out = list
    }

    // requireFlyArchives — both Fly archives must resolve before linking; report
    // which one is missing and where it was looked for (a silent skip surfaces
    // later as undefined `fly_*` symbols from the linker with no hint).
    public bool requireFlyArchives() {
        bool ok = true
        string base = this.codeGenOpts.getRuntimeLibDir()
        if str.isEmpty(this.GetStdLibPath()) {
            io.printErrLn(str.concat(str.concat("error: fly_std_lib archive not found under '", base), "' (set --runtime-lib-dir)"))
            ok = false
        }
        if str.isEmpty(this.GetRuntimeLibPath()) {
            io.printErrLn(str.concat(str.concat("error: fly_runtime_lib archive not found under '", base), "' (set --runtime-lib-dir)"))
            ok = false
        }
        out = ok
    }

    // GetStdLibPath / GetRuntimeLibPath — locate the Fly archives under runtimeLibDir.
    public string GetStdLibPath() {
        string base = this.codeGenOpts.getRuntimeLibDir()
        string p1 = path.join(base, "fly_std_lib.a")
        if fs.exists(p1) { out = p1  return }
        string p2 = path.join(base, "fly_std_lib.lib")
        if fs.exists(p2) { out = p2  return }
        out = ""
    }

    public string GetRuntimeLibPath() {
        string base = this.codeGenOpts.getRuntimeLibDir()
        string p1 = path.join(base, "fly_runtime_lib.a")
        if fs.exists(p1) { out = p1  return }
        string p2 = path.join(base, "fly_runtime_lib.lib")
        if fs.exists(p2) { out = p2  return }
        out = ""
    }

    // GetTlsLibPath / GetTlsStubPath — the two TLS archives. "" when absent, which
    // is tolerated: an older lib dir simply has no TLS.
    //
    // THE LINK ORDER IS THE WHOLE MECHANISM. Both archives define the same seven
    // tls_* symbols, and archive lazy extraction resolves the conflict for free: a
    // member is pulled only to satisfy a still-undefined symbol, so emitting the
    // real archive FIRST means the stub member is never extracted — no duplicate
    // symbol, no compiler support needed. Emit them the other way round and the
    // stub silently wins.
    //
    // The stub is emitted ALWAYS so that a program which never asked for TLS still
    // links on a machine with no libssl: appending `-lssl -lcrypto` unconditionally
    // would break hello world wherever the development symlink is absent, which is
    // a far worse regression than "TLS needs a flag".
    public string GetTlsLibPath() {
        string base = this.codeGenOpts.getRuntimeLibDir()
        string p1 = path.join(base, "fly_tls_lib.a")
        if fs.exists(p1) { out = p1  return }
        string p2 = path.join(base, "fly_tls_lib.lib")
        if fs.exists(p2) { out = p2  return }
        out = ""
    }

    public string GetTlsStubPath() {
        string base = this.codeGenOpts.getRuntimeLibDir()
        string p1 = path.join(base, "fly_tls_stub.a")
        if fs.exists(p1) { out = p1  return }
        string p2 = path.join(base, "fly_tls_stub.lib")
        if fs.exists(p2) { out = p2  return }
        out = ""
    }

    // addTlsArchives — the real backend (only when --tls asked for it, and only
    // where one exists) followed by the always-present stub.
    //
    // `dep1`/`dep2` are the SYSTEM libraries that backend needs, and they differ
    // per platform: OpenSSL wants -lssl -lcrypto, Schannel wants -lsecur32
    // -lcrypt32. They are passed in rather than chosen here because the caller is
    // already the platform-specific link function, and hardcoding one pair made
    // the Windows link ask for OpenSSL. They must follow the archive: the linker
    // resolves left to right.
    public void addTlsArchives(const pointer h, const string dep1, const string dep2) {
        bool tookReal = false
        if this.codeGenOpts.getEnableTls() {
            string real = this.GetTlsLibPath()
            if str.isEmpty(real) == false {
                proc.argsAdd(h, real)
                if str.isEmpty(dep1) == false { proc.argsAdd(h, dep1) }
                if str.isEmpty(dep2) == false { proc.argsAdd(h, dep2) }
                tookReal = true
            }
        }
        // EITHER the real backend OR the stub — never both.
        //
        // This used to emit both and let archive lazy extraction pick: the real
        // one first resolves every tls_* symbol, so the stub member is never
        // pulled. That held only while the archives carried the plain C names
        // alone. The self-host ALSO emits a mangled thunk per function, so from
        // stage2 on both archives export the same two names for all seven
        // primitives and the link dies on a duplicate symbol — a failure that
        // needed a --tls build to see, which no CI job does.
        //
        // Choosing here is not a workaround, it is what the code always meant:
        // the stub exists for builds with no backend.
        if tookReal == false {
            string stub = this.GetTlsStubPath()
            if str.isEmpty(stub) == false { proc.argsAdd(h, stub) }
        }
    }

    // GetCompilerRTBuiltinsPath — libclang_rt.builtins for the target. (cpp:1383)
    public string GetCompilerRTBuiltinsPath() {
        string suffix = archToCompilerRTSuffix(this.t.getArch())
        if str.isEmpty(suffix) { out = ""  return }

        string major = llvmMajor()
        string tripleDir = this.t.getTriple()
        string newLib = "libclang_rt.builtins.a"
        string oldLib = str.concat(str.concat("libclang_rt.builtins-", suffix), ".a")
        string sysBase = str.concat("/usr/lib/llvm-", major)

        // 1) system new-style: /usr/lib/llvm-20/lib/clang/20/lib/<triple>/libclang_rt.builtins.a
        string c1 = path.join(path.join(path.join(sysBase, str.concat("lib/clang/", str.concat(major, "/lib"))), tripleDir), newLib)
        if fs.exists(c1) { out = c1  return }
        // 2) system legacy: .../lib/clang/20/lib/linux/libclang_rt.builtins-<arch>.a
        string c2 = path.join(path.join(sysBase, str.concat("lib/clang/", str.concat(major, "/lib/linux"))), oldLib)
        if fs.exists(c2) { out = c2  return }
        // 3) /usr/lib/clang/20/lib/linux/libclang_rt.builtins-<arch>.a
        string c3 = path.join(str.concat("/usr/lib/clang/", str.concat(major, "/lib/linux")), oldLib)
        if fs.exists(c3) { out = c3  return }
        out = ""
    }
}
