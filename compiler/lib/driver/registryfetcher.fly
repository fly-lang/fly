namespace fly.driver

import fly.data.List
import fly.str
import fly.json
import fly.targz
import fly.net.http
import fly.os.fs
import fly.os.proc
import fly.os.io

// ─────────────────────────────────────────────────────────────────────────────
// RegistryFetcher — download a package from a REST registry into the cache. Port of
// the reference C++ package manager fetcher/RegistryFetcher.{h,cpp}.
//
// NO CURL, and no subprocess of any kind for HTTP: everything goes through
// fly.net.http, which serves plaintext over fly.net's own sockets and https
// through whichever backend the build has (WinHTTP on Windows, fly.net.tls over
// OpenSSL on a Linux built with --tls). Registry JSON is parsed with fly.json;
// version selection reuses the semver range matcher.
//
// When a build has NO https backend, an https registry URL now FAILS WITH A
// DIAGNOSTIC rather than silently working through an external tool that may or
// may not be installed. That is the point of the change: one code path, and a
// clear message when it cannot be taken.
//
// All methods (this module pulls the manifest reader → the toml reader).
// ─────────────────────────────────────────────────────────────────────────────

public class RegistryFetcher {
    fly.driver.Cache cache

    public RegistryFetcher(const fly.driver.Cache c) { this.cache = c }

    // ── HTTP ──────────────────────────────────────────────────────────────────
    //
    // Thin wrappers over fly.net.http, which picks the transport itself:
    // plaintext over fly.net sockets, https over WinHTTP or fly.net.tls. There is
    // no scheme branch here any more, and no external tool.

    // httpsUsable — can this build actually serve an https URL? Used only to turn
    // "it returned nothing" into an actionable message.
    public bool httpsUsable(const string url) {
        if str.equals(http.urlScheme(url), "https") == false { out = true  return }
        out = http.httpsSupported()
    }

    // reportNoHttps — one clear diagnostic instead of a silent empty result. A
    // registry that cannot be reached because the compiler was built without a TLS
    // backend is a configuration problem, and the user can only fix it if told.
    public void reportNoHttps(const string url) {
        io.printErrLn(str.concat("error: cannot fetch ", str.concat(url,
            " — this build has no HTTPS backend (rebuild with --tls, or use an http:// registry)")))
    }

    public string httpGet(const string url) {
        if this.httpsUsable(url) == false { this.reportNoHttps(url)  out = ""  return }
        out = http.get(url)
    }
    public bool httpDownload(const string url, const string dest) {
        if this.httpsUsable(url) == false { this.reportNoHttps(url)  out = false  return }
        out = http.download(url, dest)
    }
    public bool httpPostFile(const string url, const string file, const string token) {
        if this.httpsUsable(url) == false { this.reportNoHttps(url)  out = false  return }
        out = http.postFile(url, file, token)
    }

    // ── version listing / resolution ──────────────────────────────────────────

    // listVersions — GET <registry>/v1/<pkg> → JSON array → the version strings.
    public List<string> listVersions(const string registryUrl, const string pkg) {
        List<string> vers = new List<string>()
        string url = str.concat(registryUrl, str.concat("/v1/", pkg))
        string body = this.httpGet(url)
        int e = 0
        pointer v = json.parse(body, e)
        if e != 0 { json.freeValue(v)  out = vers  return }
        if json.isArray(v) == false { json.freeValue(v)  out = vers  return }
        int i = 0
        while i < json.size(v) {
            pointer el = json.at(v, i)
            if json.isString(el) {
                string s = json.asString(el)
                if str.isEmpty(s) == false {
                    byte b0 = 0
                    str.byteAt(s, 0, b0)
                    int c = b0
                    if c >= 48 && c <= 57 { vers.add(s) }   // starts with a digit
                }
            }
            i = i + 1
        }
        json.freeValue(v)
        out = vers
    }

    // resolveVersion — exact req → normalised; else max version satisfying the
    // range. Returns "" if nothing matches (caller reports the error).
    public string resolveVersion(const string registryUrl, const string pkg, const string req) {
        // exact "v?d.d.d" → normalise
        if this.isExact(req) {
            SemVer sv = semverParse(req)
            out = sv.str()
            return
        }
        List<string> vers = this.listVersions(registryUrl, pkg)
        SemVerRange range = rangeParse(req)
        SemVer best = new SemVer(0, 0, 0)
        string bestStr = ""
        int i = 0
        while i < vers.size() {
            string vstr = vers.get(i)
            SemVer sv = semverParse(vstr)
            if range.matches(sv) {
                if str.isEmpty(bestStr) || sv.gt(best) {
                    best = sv
                    bestStr = vstr
                }
            }
            i = i + 1
        }
        out = bestStr
    }

    // isExact — v?DIGITS.DIGITS.DIGITS (no range operators).
    public bool isExact(const string s) {
        int n = str.len(s)
        if n == 0 { out = false  return }
        int i = 0
        byte b0 = 0
        str.byteAt(s, 0, b0)
        if b0 == 118 || b0 == 86 { i = 1 }      // leading v/V
        int dots = 0
        int digits = 0
        while i < n {
            byte bb = 0
            str.byteAt(s, i, bb)
            int c = bb
            if c >= 48 && c <= 57 { digits = digits + 1 }
            elsif c == 46 {
                if digits == 0 { out = false  return }
                dots = dots + 1
                digits = 0
            } else { out = false  return }
            i = i + 1
        }
        out = dots == 2 && digits > 0
    }

    // ── fetch ─────────────────────────────────────────────────────────────────

    // fetch — resolve+download a registry package into the cache. ok=false with an
    // error message on any failure.
    public FetchResult fetch(const string alias, const GitDep dep, const string registryUrl) {
        FetchResult r = new FetchResult()
        string pkg = dep.getPkgName()
        if str.isEmpty(pkg) { pkg = alias }

        string version = this.resolveVersion(registryUrl, pkg, dep.getVersionReq())
        if str.isEmpty(version) {
            r.setError(str.concat("registry: no version of ", str.concat(pkg, str.concat(" satisfies ", dep.getVersionReq()))))
            out = r
            return
        }

        string key = str.concat(pkg, str.concat("/", version))
        if this.cache.has(registryUrl, key) {
            string entry = this.cache.entryPath(registryUrl, key)
            this.fill(r, version, entry)
            out = r
            return
        }

        // download tarball → extract → clean up
        this.cache.prepare(registryUrl, key)
        string entry = this.cache.entryPath(registryUrl, key)
        string durl = str.concat(registryUrl, str.concat("/v1/",
                      str.concat(pkg, str.concat("/", str.concat(version, "/download")))))
        string tarball = str.concat(entry, str.concat("/", str.concat(pkg,
                         str.concat("-", str.concat(version, ".tar.gz")))))
        if this.httpDownload(durl, tarball) == false {
            r.setError(str.concat("registry: download failed for ", pkg))
            out = r
            return
        }
        // Unpacked in-process by fly.targz — no `tar` on PATH, which is what
        // makes this work on a stock Windows box. It also gains two things the
        // external tool did not give us: gzip's CRC-32 and ISIZE are VERIFIED,
        // so a truncated download is reported instead of silently unpacked; and
        // entries whose paths would escape the cache entry are refused.
        int xe = 0
        bool xok = targz.extractTarGz(tarball, entry, xe)
        fs.delete(tarball)
        if xok == false {
            r.setError(str.concat("registry: corrupt or unreadable archive for ", pkg))
            out = r
            return
        }
        this.fill(r, version, entry)
        out = r
    }

    // fill — populate a FetchResult from a cache entry (rev==version for registry).
    public void fill(FetchResult r, const string version, const string entry) {
        r.setRev(version)
        r.setVersion(version)
        r.setLocalPath(entry)
        string tomlPath = str.concat(entry, "/Manifest.fly")
        if fs.exists(tomlPath) {
            r.setChecksum(fly.driver.sha256File(tomlPath))
        }
        r.setOk(true)
    }

    // publish — POST a tarball to <registry>/v1/<pkg>/<version>.
    public bool publish(const string pkg, const string version, const string tarball, const string registryUrl, const string token) {
        string url = str.concat(registryUrl, str.concat("/v1/",
                     str.concat(pkg, str.concat("/", version))))
        out = this.httpPostFile(url, tarball, token)
    }

    // readManifest — parse <entry>/Manifest.fly. errOut: 1 = missing, else parser code.
    public Manifest readManifest(const string alias, const string entry, int errOut) {
        string mpath = str.concat(entry, "/Manifest.fly")
        if fs.exists(mpath) == false {
            errOut = 1
            out = new Manifest()
            return
        }
        string src = fs.readStr(mpath)
        int e = 0
        FlyManifestReader r = new FlyManifestReader()
        Manifest m = r.read(src, e)
        errOut = e
        out = m
    }
}
