namespace fly.compiler.frontend

import fly.compiler.frontend.*
import fly.compiler.basic.*
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// LogDiagnosticPrinter — accumulates a structured machine-readable log of every
// diagnostic, a reduced port of fly/Frontend/LogDiagnosticPrinter.{h,cpp} (clang
// emits a plist; we emit JSON or a flat text log). Each entry records
// level/file/line/col/message; toJson()/toText() serialise the collected log.
//
// Adapted: line/col are kept pre-rendered as strings (fly.data.List stores `long`,
// and fly.str.convert takes an int) — sidesteps the long/int marshalling.
// ─────────────────────────────────────────────────────────────────────────────

public class LogDiagnosticPrinter : DiagnosticConsumer {
    List<string> levels
    List<string> files
    List<string> lines
    List<string> cols
    List<string> messages

    public LogDiagnosticPrinter() {
        super()
        this.levels = new List<string>()
        this.files = new List<string>()
        this.lines = new List<string>()
        this.cols = new List<string>()
        this.messages = new List<string>()
    }

    public void handleDiagnostic(const Diagnostic diag) {
        this.add(diagLevelName(diag.getLevel()), diag.getFilename(),
                 str.convert(diag.getLine()), str.convert(diag.getColumn()),
                 diag.getMessage())
    }

    // add — record one entry directly. Used by handleDiagnostic and by the
    // Frontend for PARSER errors, which bypass the DiagnosticsEngine (they are
    // pre-rendered strings; line/col arrive as already-formatted text).
    public void add(const string level, const string file, const string line, const string col, const string message) {
        this.levels.add(level)
        this.files.add(file)
        this.lines.add(line)
        this.cols.add(col)
        this.messages.add(message)
    }

    public int count() { out = (int)this.levels.size() }

    // jsonEscape — escape `\` then `"` so messages embed safely in JSON strings
    // (the search/replacement patterns are built from real bytes, since `"\\"` /
    // `"\""` string literals are stored RAW under this compiler).
    public string jsonEscape(const string s) {
        string bs = backslashChar()
        string q = quoteChar()
        string a = str.replace(s, bs, str.concat(bs, bs))
        string b = str.replace(a, q, str.concat(bs, q))
        out = b
    }

    // jstr — a JSON `"key":"val"` pair (val quoted), with real `"` bytes.
    public string jstr(const string key, const string val) {
        string q = quoteChar()
        out = str.concat(q, str.concat(key, str.concat(q,
              str.concat(":", str.concat(q, str.concat(val, q))))))
    }

    // jnum — a JSON `"key":val` pair (val unquoted, e.g. a number).
    public string jnum(const string key, const string val) {
        string q = quoteChar()
        out = str.concat(q, str.concat(key, str.concat(q, str.concat(":", val))))
    }

    // toJson — `[{"level":..,"file":..,"line":N,"column":M,"message":".."}, …]`.
    // Each entry is built as ONE nested concat expression: repeatedly reassigning
    // `entry = concat(entry, …)` self-aliases and frees the first fragment under
    // this compiler (see the formatMessage note in basic/Diagnostic.fly).
    public string toJson() {
        string res = "["
        int n = (int)this.levels.size()
        int i = 0
        while i < n {
            string sep = ""
            if i > 0 { sep = "," }
            string p1 = this.jstr("level", this.levels.get(i))
            string p2 = this.jstr("file", this.jsonEscape(this.files.get(i)))
            string p3 = this.jnum("line", this.lines.get(i))
            string p4 = this.jnum("column", this.cols.get(i))
            string p5 = this.jstr("message", this.jsonEscape(this.messages.get(i)))
            string body = str.concat(p1, str.concat(",", str.concat(p2,
                          str.concat(",", str.concat(p3, str.concat(",",
                          str.concat(p4, str.concat(",", p5))))))))
            string entry = str.concat("{", str.concat(body, "}"))
            string acc = str.concat(res, str.concat(sep, entry))
            res = acc
            i = i + 1
        }
        out = str.concat(res, "]")
    }

    // toTextReport — the full text log written to --log-file: an `inputs:` /
    // `output:` header (when non-empty), a `---` separator, then toText().
    // Reduced port of the reference LogDiagnosticPrinter::EndSourceFile text shape.
    public string toTextReport(const string inputs, const string output) {
        string res = ""
        if str.isEmpty(inputs) == false {
            string l1 = str.concat("inputs: ", str.concat(inputs, lineFeed()))
            string a1 = str.concat(res, l1)
            res = a1
        }
        if str.isEmpty(output) == false {
            string l2 = str.concat("output: ", str.concat(output, lineFeed()))
            string a2 = str.concat(res, l2)
            res = a2
        }
        string sep = str.concat("---", lineFeed())
        string a3 = str.concat(res, sep)
        out = str.concat(a3, this.toText())
    }

    // toJsonReport — the full JSON log written to --log-file:
    // {"inputs":"..","output":"..","diagnostics":[…]} (reference plist reduced;
    // the `options` block is omitted in this minimal port).
    public string toJsonReport(const string inputs, const string output) {
        string p1 = this.jstr("inputs", this.jsonEscape(inputs))
        string p2 = this.jstr("output", this.jsonEscape(output))
        string q = quoteChar()
        string dk = str.concat(q, str.concat("diagnostics", str.concat(q, ":")))
        string body = str.concat(p1, str.concat(",", str.concat(p2,
                      str.concat(",", str.concat(dk, this.toJson())))))
        out = str.concat("{", str.concat(body, "}"))
    }

    // toText — one `level: file:line:col: message` line per diagnostic.
    public string toText() {
        string res = ""
        int n = (int)this.levels.size()
        int i = 0
        while i < n {
            string loc = str.concat(this.files.get(i),
                         str.concat(":", str.concat(this.lines.get(i),
                         str.concat(":", str.concat(this.cols.get(i), ": ")))))
            string line = str.concat(this.levels.get(i),
                          str.concat(": ", str.concat(loc, this.messages.get(i))))
            string acc = str.concat(res, str.concat(line, lineFeed()))
            res = acc
            i = i + 1
        }
        out = res
    }
}
