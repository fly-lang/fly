namespace fly.compiler.parser
import fly.compiler.basic.*
import fly.compiler.parser.*
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// Lexer — scans a source string into a stream of tokens. It is the single owner
// of the source text and resolves token/node spellings via spanText/tokenText.
// next() dispatches to small per-token helpers (a monolithic next() trips a
// codegen "Broken function" bug).
// ─────────────────────────────────────────────────────────────────────────────

public class Lexer {
    string source
    int pos
    int len
    SourceManager sm     // the buffer's manager: every location the lexer makes is tagged with it

    public Lexer(const string src) {
        this.source = src
        this.pos = 0
        this.len = str.len(src)
        this.sm = null
    }

    public void setSourceManager(const SourceManager m) {
        this.sm = m
    }

    // spanText / tokenText — resolve a source slice to a fresh string (owned by
    // the caller, so safe to return and store as a local).
    public string spanText(const int s0, const int s1) {
        return str.substring(this.source, s0, s1)
    }
    public string tokenText(const Token t) {
        return str.substring(this.source, t.start, t.end)
    }

    // byteAt — byte code at index i, or 256 past end (256 matches no real byte).
    public int byteAt(const int i) {
        if i >= this.len {
            return 256
        }
        byte b = str.byteAt(this.source, i)
        return b
    }

    // here — the current position as a SourceLocation (byte offset). Line/col
    // are no longer tracked eagerly; SourceManager decodes them from the offset.
    public SourceLocation here() {
        return slGetFileLocIn(this.pos, this.sm)
    }

    // advance — consume one byte.
    public void advance() {
        this.pos = this.pos + 1
    }

    // skipTrivia — skip whitespace and // line and /* block */ comments.
    public void skipTrivia() {
        bool go = true
        while go {
            if this.pos >= this.len {
                go = false
            } else {
                int c = this.byteAt(this.pos)
                if isWhitespace(c) {
                    this.advance()
                } elsif c == 47 && this.byteAt(this.pos + 1) == 47 {
                    // line comment
                    while this.pos < this.len && this.byteAt(this.pos) != 10 {
                        this.advance()
                    }
                } elsif c == 47 && this.byteAt(this.pos + 1) == 42 {
                    // block comment
                    this.advance()
                    this.advance()
                    bool inComment = true
                    while inComment {
                        if this.pos >= this.len {
                            inComment = false
                        } elsif this.byteAt(this.pos) == 42 && this.byteAt(this.pos + 1) == 47 {
                            this.advance()
                            this.advance()
                            inComment = false
                        } else {
                            this.advance()
                        }
                    }
                } else {
                    go = false
                }
            }
        }
    }

    // matchPunct — return the punctuator spelling starting at pos using maximal
    // munch (longest first), or "" if the next char is not a punctuator.
    public string matchPunct() {
        int c1 = this.byteAt(this.pos)
        int c2 = this.byteAt(this.pos + 1)
        int c3 = this.byteAt(this.pos + 2)
        // 3-char: <<=  >>=
        if c1 == 60 && c2 == 60 && c3 == 61 {
            return "<<="
        }
        if c1 == 62 && c2 == 62 && c3 == 61 {
            return ">>="
        }
        // 2-char
        if c1 == 61 && c2 == 61 {
            return "=="
        }
        if c1 == 33 && c2 == 61 {
            return "!="
        }
        if c1 == 60 && c2 == 61 {
            return "<="
        }
        if c1 == 62 && c2 == 61 {
            return ">="
        }
        if c1 == 38 && c2 == 38 {
            return "&&"
        }
        if c1 == 124 && c2 == 124 {
            return "||"
        }
        if c1 == 60 && c2 == 60 {
            return "<<"
        }
        if c1 == 62 && c2 == 62 {
            return ">>"
        }
        if c1 == 43 && c2 == 43 {
            return "++"
        }
        if c1 == 45 && c2 == 45 {
            return "--"
        }
        if c1 == 43 && c2 == 61 {
            return "+="
        }
        if c1 == 45 && c2 == 61 {
            return "-="
        }
        if c1 == 42 && c2 == 61 {
            return "*="
        }
        if c1 == 47 && c2 == 61 {
            return "/="
        }
        if c1 == 37 && c2 == 61 {
            return "%="
        }
        if c1 == 38 && c2 == 61 {
            return "&="
        }
        if c1 == 124 && c2 == 61 {
            return "|="
        }
        if c1 == 94 && c2 == 61 {
            return "^="
        }
        // 1-char
        if c1 == 40 {
            return "("
        }
        if c1 == 41 {
            return ")"
        }
        if c1 == 123 {
            return "{"
        }
        if c1 == 125 {
            return "}"
        }
        if c1 == 91 {
            return "["
        }
        if c1 == 93 {
            return "]"
        }
        if c1 == 46 {
            return "."
        }
        if c1 == 44 {
            return ","
        }
        if c1 == 58 {
            return ":"
        }
        if c1 == 59 {
            return ";"
        }
        if c1 == 63 {
            return "?"
        }
        if c1 == 64 {
            return "@"
        }
        if c1 == 43 {
            return "+"
        }
        if c1 == 45 {
            return "-"
        }
        if c1 == 42 {
            return "*"
        }
        if c1 == 47 {
            return "/"
        }
        if c1 == 37 {
            return "%"
        }
        if c1 == 61 {
            return "="
        }
        if c1 == 60 {
            return "<"
        }
        if c1 == 62 {
            return ">"
        }
        if c1 == 33 {
            return "!"
        }
        if c1 == 38 {
            return "&"
        }
        if c1 == 124 {
            return "|"
        }
        if c1 == 94 {
            return "^"
        }
        if c1 == 126 {
            return "~"
        }
        return ""
    }

    // lexWord — identifier or keyword, starting at `start` (alpha already seen).
    public Token lexWord(const SourceLocation loc, const int start) {
        while this.pos < this.len && isIdentifierBody(this.byteAt(this.pos)) {
            this.advance()
        }
        string word = str.substring(this.source, start, this.pos)
        TokenKind kind = TokenKind.IDENT
        if isKeyword(word) {
            kind = TokenKind.KEYWORD
        }
        return new Token(kind, loc, start, this.pos)
    }

    // lexNumber — integer / float / hex (digits, '.', trailing alnum), plus the
    // SIGN of a decimal exponent: `1.5e-16` is one token. Without it the lexer
    // stopped after the `e`, and `d * 1.1102230246251565e-16` compiled as
    // `d * 1.1102230246251565 - 16` — silently, since that is valid Fly. A hex
    // literal never takes a sign: in `0x1e-5` the `e` is a digit and `-` is a
    // subtraction.
    public Token lexNumber(const SourceLocation loc, const int start) {
        bool hex = false
        if this.byteAt(start) == 48 {
            int x = this.byteAt(start + 1)
            if x == 120 || x == 88 { // 0x / 0X
                hex = true
            }
        }
        bool more = true
        while more && this.pos < this.len {
            int d = this.byteAt(this.pos)
            if isIdentifierBody(d) || d == 46 {
                this.advance()
                bool isExp = d == 101 || d == 69        // e / E
                if isExp && hex == false {
                    int sg = this.byteAt(this.pos)
                    bool hasSign = sg == 43 || sg == 45  // + / -
                    if hasSign {
                        int nd = this.byteAt(this.pos + 1)
                        if nd >= 48 && nd <= 57 {
                            this.advance()
                        }
                    }
                }
            } else {
                more = false
            }
        }
        return new Token(TokenKind.NUMBER, loc, start, this.pos)
    }

    // lexQuoted — string ("...") or char ('...') literal; `quote` is the delimiter
    // byte, `kind` the token kind. The token span covers the content (no delimiters).
    public Token lexQuoted(const SourceLocation loc, const int quote, const TokenKind kind) {
        this.advance()                 // opening delimiter
        int contentStart = this.pos
        while this.pos < this.len && this.byteAt(this.pos) != quote {
            if this.byteAt(this.pos) == 92 {
                this.advance()         // skip escape backslash
            }
            this.advance()
        }
        int contentEnd = this.pos
        if this.pos < this.len {
            this.advance()             // closing delimiter
        }
        return new Token(kind, loc, contentStart, contentEnd)
    }

    // lexRaw — a raw string literal `"""…"""`: everything up to the next `"""`, newlines
    // and backslashes included, is its text (no escape sequences).
    public Token lexRaw(const SourceLocation loc) {
        this.advance()
        this.advance()
        this.advance()
        int contentStart = this.pos
        bool go = true
        while go && this.pos < this.len {
            if this.byteAt(this.pos) == 34 && this.pos + 2 < this.len && this.byteAt(this.pos + 1) == 34 &&
                    this.byteAt(this.pos + 2) == 34 {
                go = false
            } else {
                this.advance()
            }
        }
        int contentEnd = this.pos
        if this.pos < this.len {
            this.advance()
            this.advance()
            this.advance()
        }
        Token t = new Token(TokenKind.STRING, loc, contentStart, contentEnd)
        t.setRaw(true)
        return t
    }

    // lexPunct — punctuator via maximal munch, or TOK_UNKNOWN for a stray byte.
    public Token lexPunct(const SourceLocation loc, const int start) {
        string p = this.matchPunct()
        if str.len(p) > 0 {
            int k = 0
            int plen = str.len(p)
            while k < plen {
                this.advance()
                k = k + 1
            }
            return new Token(TokenKind.PUNCT, loc, start, this.pos)
        }
        this.advance()
        return new Token(TokenKind.UNKNOWN, loc, start, this.pos)
    }

    // next — produce the next token (TOK_EOF at end of input).
    public Token next() {
        this.skipTrivia()
        SourceLocation loc = this.here()
        if this.pos >= this.len {
            return new Token(TokenKind.EOF, loc, this.pos, this.pos)
        }
        int c = this.byteAt(this.pos)
        int start = this.pos
        if isIdentifierHead(c) {
            return this.lexWord(loc, start)
        } elsif isDigit(c) {
            return this.lexNumber(loc, start)
        } elsif c == 34 {
            if this.pos + 2 < this.len && this.byteAt(this.pos + 1) == 34 && this.byteAt(this.pos + 2) == 34 {
                return this.lexRaw(loc)
            }
            return this.lexQuoted(loc, 34, TokenKind.STRING)
        } elsif c == 39 {
            return this.lexQuoted(loc, 39, TokenKind.CHAR)
        } else {
            return this.lexPunct(loc, start)
        }
    }
}

// newLexer — convenience factory.
public Lexer newLexer(const string src) {
    return new Lexer(src)
}
