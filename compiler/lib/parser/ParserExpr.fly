namespace fly.compiler.parser

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.data.*
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// ParserExpr — expression parsing, split out of Parser to mirror the C++
// fly/compiler/Parser/ParserExpr.cpp. Uses STATIC methods that thread the Parser
// `p` (like the C++ ParserClass/Enum/Function which take a Parser*), so there is
// no stored Parser field and thus no Parser<->ParserExpr instance cycle (that
// cycle crashes the current fly codegen — see task #11). Precedence climbing:
// assignment → ternary → binary → unary → postfix → primary.
// ─────────────────────────────────────────────────────────────────────────────

public class ParserExpr {

    public ParserExpr() { }

    // parse — entry point: an assignment expression.
    public static ASTExpr parse(const Parser p) {
        return ParserExpr.parseAssign(p)
    }

    public static ASTExpr parseAssign(const Parser p) {
        ASTExpr left = ParserExpr.parseTernary(p)
        if p.curIsPunct("=") {
            SourceLocation oploc = p.curLoc()
            p.bump()
            ASTExpr right = ParserExpr.parseAssign(p)
            p.noteOwnerField(left, right)
            return ASTBuilder.CreateBinary(oploc, ASTBinaryKind.OP_BINARY_ASSIGN, left, right)
        }
        // compound assignment `a += b` … `a >>= b` (B015, doc 8.4): right-
        // associative like `=`; lowered as `a = a op b` in codegen.
        if p.curIsAnyPunct() {
            string cop = p.curText()
            ASTBinaryKind ck = ASTBinaryKind.OP_BINARY_ASSIGN
            bool isCompound = true
            if cop == "+=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_ADD
            } elsif cop == "-=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_SUB
            } elsif cop == "*=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_MUL
            } elsif cop == "/=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_DIV
            } elsif cop == "%=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_MOD
            } elsif cop == "&=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_AND
            } elsif cop == "|=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_OR
            } elsif cop == "^=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_XOR
            } elsif cop == "<<=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_SHIFT_L
            } elsif cop == ">>=" {
                ck = ASTBinaryKind.OP_BINARY_ASSIGN_SHIFT_R
            } else {
                isCompound = false
            }
            if isCompound {
                SourceLocation oploc = p.curLoc()
                p.bump()
                ASTExpr right = ParserExpr.parseAssign(p)
                return ASTBuilder.CreateBinary(oploc, ck, left, right)
            }
        }
        return left
    }

    // parseTernary — `cond ? then : else` (binds tighter than '=', looser than binary).
    public static ASTExpr parseTernary(const Parser p) {
        ASTExpr cond = ParserExpr.parseBin(p, 2)
        if p.curIsPunct("?") {
            SourceLocation tloc = p.curLoc()
            p.bump()
            ASTExpr t = ParserExpr.parse(p)
            SourceLocation floc = p.curLoc()
            if p.curIsPunct(":") {
                p.bump()
            } else {
                p.reportErr(DiagID.err_parser_ternary_expr)
            }
            ASTExpr f = ParserExpr.parseTernary(p)
            return ASTBuilder.CreateTernary(cond, tloc, t, floc, f)
        }
        return cond
    }

    public static ASTExpr parseBin(const Parser p, const int minPrec) {
        ASTExpr left = ParserExpr.parseUnary(p)
        // the operator at the top of `left` when `left` is a binary built HERE, so
        // without parentheses ("" otherwise: a parenthesized operand comes back
        // from parsePrimary and is never a naked binary)
        string leftOp = ""
        bool go = true
        while go {
            string op = ""
            if p.curIsAnyPunct() {
                op = p.curText()
            }
            int prec = binPrec(op)
            if prec >= minPrec && prec > 0 {
                SourceLocation oploc = p.curLoc()
                p.bump()
                ASTExpr right = ParserExpr.parseBin(p, prec + 1)
                string rightOp = p.getLastBinOp()
                ParserExpr.checkMix(p, oploc, op, leftOp)
                ParserExpr.checkMix(p, oploc, op, rightOp)
                ASTBinaryKind bk = binKindFor(op)
                left = ASTBuilder.CreateBinary(oploc, bk, left, right)
                leftOp = op
            } else {
                go = false
            }
        }
        p.setLastBinOp(leftOp)
        return left
    }

    // checkMix — `op` takes an operand whose top operator, unparenthesized, is
    // `inner`. Fly's precedence is flat where C's is not, so two readings would
    // both look natural; the program must say which one it means:
    //   - `|| && | ^ & << >>` share one level, left to right: two DIFFERENT ones in
    //     a chain (`a || b && c`, `x << 2 | y`) need parentheses; the same one
    //     repeated (`a && b && c`) does not;
    //   - a comparison under a bitwise or shift operator: `a & b == c` is
    //     `a & (b == c)` in Fly, `(a & b) == c` in C. A comparison under `&&` or
    //     `||` (`a == b && c < d`) means the same everywhere and stays legal.
    public static void checkMix(const Parser p, const SourceLocation oploc, const string op, const string inner) {
        if str.isEmpty(inner) {
            return
        }
        if binPrec(op) != 2 {
            return
        }
        int ip = binPrec(inner)
        if ip == 2 && str.equals(inner, op) == false {
            p.noteMix(oploc, false, inner, op)
        } elsif ip == 3 && str.equals(op, "&&") == false && str.equals(op, "||") == false {
            p.noteMix(oploc, true, op, inner)
        }
    }

    public static ASTExpr parseUnary(const Parser p) {
        // `weak h` — CONTEXTUAL like the `new` qualifiers: `weak` is an operator only
        // when a name follows, so it stays a valid name everywhere else.
        if p.curIsIdent() && p.nxtIsIdent() && str.equals(p.curText(), "weak") {
            SourceLocation wloc = p.curLoc()
            p.bump()
            ASTExpr target = ParserExpr.parseUnary(p)
            ASTExpr w = ASTBuilder.CreateUnary(wloc, ASTUnaryKind.OP_UNARY_WEAK, target)
            p.setLastWeak(w)
            return w
        }
        if p.curIsPunct("!") {
            SourceLocation loc = p.curLoc()
            p.bump()
            ASTExpr operand = ParserExpr.parseUnary(p)
            return ASTBuilder.CreateUnary(loc, ASTUnaryKind.OP_UNARY_NOT_LOG, operand)
        }
        if p.curIsPunct("++") {
            SourceLocation loc = p.curLoc()
            p.bump()
            ASTExpr operand = ParserExpr.parseUnary(p)
            return ASTBuilder.CreateUnary(loc, ASTUnaryKind.OP_UNARY_PRE_INCR, operand)
        }
        if p.curIsPunct("--") {
            SourceLocation loc = p.curLoc()
            p.bump()
            ASTExpr operand = ParserExpr.parseUnary(p)
            return ASTBuilder.CreateUnary(loc, ASTUnaryKind.OP_UNARY_PRE_DECR, operand)
        }
        // unary minus (B007, doc Appendix B): `-x` in operand position only —
        // binary `a - b` never reaches here (parseBin consumes it after a left
        // operand), so there is no ambiguity.
        if p.curIsPunct("-") {
            SourceLocation loc = p.curLoc()
            p.bump()
            ASTExpr operand = ParserExpr.parseUnary(p)
            return ASTBuilder.CreateUnary(loc, ASTUnaryKind.OP_UNARY_NEG, operand)
        }
        return ParserExpr.parsePostfix(p)
    }

    public static ASTExpr parsePostfix(const Parser p) {
        ASTExpr e = ParserExpr.parsePrimary(p)
        bool go = true
        while go {
            if p.curIsPunct(".") {
                p.bump()
                SourceLocation loc = p.curLoc()
                string nm = ""
                if p.curIsNamePart() {
                    nm = p.curText()
                    p.bump()
                } else {
                    p.reportErr(DiagID.err_parser_identifier_expected)
                    go = false
                }
                if p.curIsPunct("(") {
                    ASTCall call = ParserExpr.parseCallTail(p, loc, nm, ASTCallKind.CALL_DIRECT, e)
                    e = call
                } else {
                    ASTMember mem = ASTBuilder.CreateMember(loc, nm, e)
                    e = mem
                }
            } elsif p.curIsPunct("[") {
                // Array subscript `base[index]`. It belongs INSIDE the suffix loop,
                // not after it, so it chains in both directions: `m[i][j]` reads a
                // nested array and `k[i].f` reaches a field of an element. (The
                // reference parser cannot chain the second form — here it comes for
                // free from the loop.)
                SourceLocation sloc = p.curLoc()
                p.bump()
                ASTExpr idx = ParserExpr.parse(p)
                p.expectPunct("]")
                ASTArrayAccess acc = ASTBuilder.CreateArrayAccess(sloc, e, idx)
                e = acc
            } else {
                go = false
            }
        }
        // postfix increment / decrement — SAME-LINE only: without the line gate
        // the parse is greedy across newlines and eats the NEXT statement's
        // prefix operator (`int a = 5` + `++a` parsed as `5++` then garbage —
        // B014's real root cause; newlines are otherwise insignificant).
        if p.curLine() == p.prevTokenLine() {
            if p.curIsPunct("++") {
                SourceLocation ploc = p.curLoc()
                p.bump()
                e = ASTBuilder.CreateUnary(ploc, ASTUnaryKind.OP_UNARY_POST_INCR, e)
            } elsif p.curIsPunct("--") {
                SourceLocation ploc = p.curLoc()
                p.bump()
                e = ASTBuilder.CreateUnary(ploc, ASTUnaryKind.OP_UNARY_POST_DECR, e)
            }
        }
        return e
    }

    // parseCallTail — parse '(' args ')' for a call named `nm` with parent `parent`.
    public static ASTCall parseCallTail(const Parser p, const SourceLocation loc, const string nm,
            const ASTCallKind kind, const ASTExpr parent) {
        ASTCall call = new ASTCall(loc, nm, kind)
        if parent != null {
            call.setParent(parent)
        }
        p.expectPunct("(")
        bool go = p.curIsPunct(")") == false
        int idx = 0
        while go {
            ASTExpr a = ParserExpr.parse(p)
            ASTArg arg = new ASTArg(loc, a, (uint)idx)
            call.addArg(arg)
            idx = idx + 1
            if p.curIsPunct(",") {
                p.bump()
            } else {
                go = false
            }
        }
        p.expectPunct(")")
        return call
    }

    // parseLiteral — a value literal (number/string/bool/null), or null if the current
    // token is not a literal. Split out of parsePrimary to keep each method small (a
    // monolithic many-branch method trips a codegen "Broken function").
    public static ASTExpr parseLiteral(const Parser p) {
        SourceLocation loc = p.curLoc()
        if p.curIsNumber() {
            ASTNumberValue n = ASTBuilder.CreateNumberValue(loc, p.curText())
            p.bump()
            return n
        }
        if p.curIsStringLit() {
            ASTStringValue s = ASTBuilder.CreateStringValue(loc, p.curText())
            p.bump()
            return s
        }
        if p.curIsKw("true") {
            p.bump()
            return ASTBuilder.CreateBoolValue(loc, true)
        }
        if p.curIsKw("false") {
            p.bump()
            return ASTBuilder.CreateBoolValue(loc, false)
        }
        if p.curIsKw("null") {
            p.bump()
            return ASTBuilder.CreateNullValue(loc)
        }
        return null
    }

    public static ASTExpr parsePrimary(const Parser p) {
        SourceLocation loc = p.curLoc()
        if p.curIsKw("new") {
            return ParserExpr.parseNew(p)
        }
        if p.curIsNumber() || p.curIsStringLit() || p.curIsKw("true") || p.curIsKw("false") || p.curIsKw("null") {
            return ParserExpr.parseLiteral(p)
        }
        // `error` in an EXPRESSION is the implicit error variable of the current
        // function ("was the last handle block's code non-zero?") — `if error {`.
        // As a TYPE it only appears in declarations, which never reach parsePrimary.
        if p.curIsKw("error") {
            p.bump()
            return ASTBuilder.CreateIdentifier(loc, "error", null)
        }
        if p.curIsPunct("(") {
            p.bump()
            // C-style cast to a builtin type: `(int)x` — unambiguous because a builtin
            // type keyword followed by ')' cannot be a parenthesized expression.
            // EXCEPT `(error)`: that is the parenthesized implicit error variable
            // (a sub-expression, e.g. `if (error) && ready {`), never a cast —
            // nothing casts TO the error type.
            if p.curIsBuiltinType() && p.nxtIsPunct(")") && p.curIsKw("error") == false {
                ASTType castTy = p.parseBuiltinType()
                p.expectPunct(")")
                ASTExpr operand = ParserExpr.parseUnary(p)
                return ASTBuilder.CreateCast(operand, castTy)
            }
            ASTExpr e = ParserExpr.parse(p)
            p.expectPunct(")")
            return e
        }
        // array literal: `{ e0, e1, ... }` (elements are any expression, so
        // `{ new Dep(...), ... }` works too). Unambiguous in expression position —
        // a block `{` is only a statement, never a primary.
        if p.curIsPunct("{") {
            return ParserExpr.parseArrayLiteral(p)
        }
        // identifier, or call `name(...)`
        if p.curIsNamePart() {
            string nm = p.curText()
            p.bump()
            if p.curIsPunct("(") {
                return ParserExpr.parseCallTail(p, loc, nm, ASTCallKind.CALL_DIRECT, null)
            }
            return ASTBuilder.CreateIdentifier(loc, nm, null)
        }
        p.reportErr(DiagID.err_parser_expr_expected_primary)
        return ASTBuilder.CreateNullValue(loc)
    }

    // parseArrayLiteral — `{ expr (, expr)* }` → ASTArrayValue. A trailing comma and
    // the empty `{}` are accepted. `{ ident = expr, ... }` is a STRUCT literal
    // (B029, mirroring the reference's ParseValues): ident + `=` can't begin an
    // array element (assignment isn't a value), so the shape is unambiguous.
    public static ASTExpr parseArrayLiteral(const Parser p) {
        SourceLocation loc = p.curLoc()
        p.expectPunct("{")
        if p.curIsIdent() && p.nxtIsPunct("=") {
            return ParserExpr.parseStructLiteral(p, loc)
        }
        List<ASTExpr> elems = new List<ASTExpr>()
        bool go = p.curIsPunct("}") == false && p.hadErr() == false
        while go {
            ASTExpr e = ParserExpr.parse(p)
            elems.add(e)
            if p.curIsPunct(",") {
                p.bump()
                if p.curIsPunct("}") {
                    go = false
                }
            } else {
                go = false
            }
            if p.hadErr() {
                go = false
            }
        }
        p.expectPunct("}")
        return ASTBuilder.CreateArrayValue(loc, elems)
    }

    // parseStructLiteral — `name = expr (, name = expr)*` up to `}` (the opening
    // `{` is already consumed). Pairs land in ASTStructValue's parallel lists.
    public static ASTExpr parseStructLiteral(const Parser p, const SourceLocation loc) {
        ASTStructValue st = ASTBuilder.CreateStructValue(loc)
        bool go = p.curIsPunct("}") == false && p.hadErr() == false
        while go {
            string nm = ""
            if p.curIsIdent() {
                nm = p.curText()
                p.bump()
            } else {
                p.reportErr(DiagID.err_parser_identifier_expected)
                go = false
            }
            if go {
                p.expectPunct("=")
                ASTExpr v = ParserExpr.parse(p)
                st.addField(nm, v)
                if p.curIsPunct(",") {
                    p.bump()
                    if p.curIsPunct("}") {
                        go = false
                    }
                } else {
                    go = false
                }
            }
            if p.hadErr() {
                go = false
            }
        }
        p.expectPunct("}")
        return st
    }

    public static ASTExpr parseNew(const Parser p) {
        SourceLocation loc = p.curLoc()
        p.expectKw("new")
        // `new unique C()`, `new shared C()`, `new weak C()`: the ownership
        // qualifiers are CONTEXTUAL — a qualifier only right after `new` and only
        // when a class name follows (`new unique()` still constructs a class named
        // `unique`), so they stay usable as ordinary names everywhere else.
        ASTCallKind newKind = ASTCallKind.CALL_NEW
        if p.curIsIdent() && p.nxtIsIdent() {
            string q = p.curText()
            if str.equals(q, "unique") {
                newKind = ASTCallKind.CALL_NEW_UNIQUE
                p.bump()
            } elsif str.equals(q, "shared") {
                newKind = ASTCallKind.CALL_NEW_SHARED
                p.bump()
            } elsif str.equals(q, "weak") {
                newKind = ASTCallKind.CALL_NEW_WEAK
                p.bump()
            }
        }
        // The NAME token, for setNameLoc. `loc` is the `new` keyword and stays the
        // call's start (diagnostics, signature help); anything that has to find
        // the TYPE by position — a ctrl-click on `Point` in `new Point()` — needs
        // where the name actually is, four columns further.
        SourceLocation nloc = p.curLoc()
        string nm = ""
        if p.curIsNamePart() {
            nm = p.curText()
            p.bump()
        } else {
            p.reportErr(DiagID.err_parser_new_instance)
        }
        // optional generic type args: new Wrapper<int>(...)
        List<ASTType> targs = new List<ASTType>()
        if p.curIsPunct("<") {
            p.bump()
            bool go = true
            while go {
                ASTType ta = p.parseType()
                targs.add(ta)
                if p.curIsPunct(",") {
                    p.bump()
                } else {
                    go = false
                }
            }
            p.closeTypeArgs()
        }
        ASTCall call = ParserExpr.parseCallTail(p, loc, nm, newKind, null)
        call.setNameLoc(nloc)
        int i = 0
        while i < targs.size() {
            call.addTypeArg(targs.get(i))
            i = i + 1
        }
        return call
    }
}
