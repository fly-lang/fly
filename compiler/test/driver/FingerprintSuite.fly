namespace fly.driver.test.fingerprint

import fly.driver.*
import fly.driver
import fly.os.fs
import fly.os.env
import fly.os.path
import fly.str
import fly.assert

// ─────────────────────────────────────────────────────────────────────────────
// FingerprintSuite — pure tests for the incremental-build fingerprint
// (fingerprint.fly): bytewise compare, deterministic compute, content change
// detection, creation-order independence, relpath normalization. Scratch trees
// live in the OS temp dir and are removed BEFORE the asserts (a failing assert
// aborts the case; nothing must survive a failed run). Free helper functions,
// never `this`, per suite convention.
// ─────────────────────────────────────────────────────────────────────────────

// fpsTempDir — <OS temp>/<name>, mirroring BuilderSuite's temp resolution.
string fpsTempDir(const string name) {
    string tmp = env.get("TMPDIR")
    if str.isEmpty(tmp) { tmp = env.get("TEMP") }
    if str.isEmpty(tmp) { tmp = "/tmp" }
    out = path.join(tmp, name)
}

// fpsHeader — a fixed fake header ending with a newline, as compute expects.
string fpsHeader() {
    out = str.concat("hdr test", driver.nl())
}

// fpsCompute — one-shot compute with a fresh Fingerprint.
string fpsCompute(const string dir) {
    Fingerprint f = new Fingerprint()
    out = f.compute(dir, fpsHeader())
}

suite FingerprintSuite {

    void compareTest() {
        case "fpStrCompare orders bytewise": {
            assert.assertTrue(driver.fpStrCompare("a", "b") < 0, 1)
            assert.assertTrue(driver.fpStrCompare("b", "a") > 0, 2)
            assert.assertEqI(driver.fpStrCompare("abc", "abc"), 0, 3)
            assert.assertTrue(driver.fpStrCompare("a", "ab") < 0, 4)   // prefix first
            assert.assertTrue(driver.fpStrCompare("Z", "a") < 0, 5)    // 90 < 97
            assert.assertTrue(driver.fpStrCompare("", "a") < 0, 6)
        }
    }

    void computeTest() {
        case "compute is deterministic and content-sensitive": {
            string dir = fpsTempDir("fp_suite_dir")
            fs.dirDeleteAll(dir)
            fs.dirCreateAll(path.join(dir, "sub"), 493)
            fs.writeStr(path.join(dir, "a.fly"), "alpha", 420)
            string sub = path.join(dir, "sub")
            fs.writeStr(path.join(sub, "b.fly"), "beta", 420)
            fs.writeStr(path.join(dir, "note.txt"), "ignored", 420)

            string fp1 = fpsCompute(dir)
            string fp2 = fpsCompute(dir)                 // same tree, fresh object

            // content change flips the fingerprint
            fs.writeStr(path.join(dir, "a.fly"), "alpha2", 420)
            string fp3 = fpsCompute(dir)

            // added source flips it again
            fs.writeStr(path.join(dir, "c.fly"), "gamma", 420)
            string fp4 = fpsCompute(dir)

            // non-.fly files are invisible
            fs.writeStr(path.join(dir, "note2.txt"), "ignored too", 420)
            string fp5 = fpsCompute(dir)

            fs.dirDeleteAll(dir)

            assert.assertStr(fp1, fp2, 10)                                  // deterministic
            assert.assertTrue(str.startsWith(fp1, "hdr test"), 11)      // header kept
            assert.assertTrue(str.contains(fp1, "a.fly sha256:"), 12)
            assert.assertTrue(str.contains(fp1, "sub/b.fly sha256:"), 13)  // "/" relpath
            assert.assertFalse(str.contains(fp1, "note.txt"), 14)
            assert.assertFalse(str.equals(fp1, fp3), 15)                // content change
            assert.assertFalse(str.equals(fp3, fp4), 16)                // added file
            assert.assertStr(fp4, fp5, 17)                                  // non-.fly inert
        }
        case "creation order does not matter; empty dir is header-only": {
            string dirA = fpsTempDir("fp_suite_ord_a")
            string dirB = fpsTempDir("fp_suite_ord_b")
            string dirE = fpsTempDir("fp_suite_empty")
            fs.dirDeleteAll(dirA)
            fs.dirDeleteAll(dirB)
            fs.dirDeleteAll(dirE)
            fs.dirCreateAll(dirA, 493)
            fs.dirCreateAll(dirB, 493)
            fs.dirCreateAll(dirE, 493)
            // same files, opposite creation order
            fs.writeStr(path.join(dirA, "x.fly"), "xx", 420)
            fs.writeStr(path.join(dirA, "y.fly"), "yy", 420)
            fs.writeStr(path.join(dirB, "y.fly"), "yy", 420)
            fs.writeStr(path.join(dirB, "x.fly"), "xx", 420)

            string fpA = fpsCompute(dirA)
            string fpB = fpsCompute(dirB)
            string fpE = fpsCompute(dirE)
            string wantE = str.concat(fpsHeader(), str.concat("files", driver.nl()))

            fs.dirDeleteAll(dirA)
            fs.dirDeleteAll(dirB)
            fs.dirDeleteAll(dirE)

            assert.assertStr(fpA, fpB, 20)     // filesystem order irrelevant
            assert.assertStr(fpE, wantE, 21)   // zero sources: header + empty files section
        }
    }
}
