namespace fly.driver.test.builder

import fly.driver.*
import fly.driver
import fly.compiler.basic.*
import fly.os.fs
import fly.os.env
import fly.os.path
import fly.str
import fly.assert

// ─────────────────────────────────────────────────────────────────────────────
// BuilderSuite — exercises the `fly build` flow DIRECTLY (loadManifest → Builder →
// buildAll → invokeFly → compile a real target), the same path cmdBuild takes,
// but WITHOUT going through Driver.run. `fly build` crashes with a stack overflow
// (heap corruption) only when this path is reached via Driver.run's arg loop
// (which corrupts the heap first); called directly it must work. So this suite is
// both real coverage of the Builder AND a diagnostic isolating the crash to
// Driver.run (if BuilderSuite passes while `fly build` crashes, the fault is in
// Driver.run, not the reader/Builder).
//
// Real quotes for the generated Manifest.fly come from fly.driver.dq() (the lexer
// keeps `\"` raw). Free helpers, not `this.` methods (suite `this` is invalid).
// ─────────────────────────────────────────────────────────────────────────────

string qb(const string v) { out = str.concat(driver.dq(), str.concat(v, driver.dq())) }

suite BuilderSuite {

    void outDirTest() {
        case "outDir is target/<profile> and target/test": {
            Manifest m = new Manifest()
            Builder b = new Builder(m, "debug", false)
            assert.assertTrue(str.contains(b.outDir(), "target"), 1)
            assert.assertTrue(str.contains(b.outDir(), "debug"), 2)
            Builder bt = new Builder(m, "debug", true)
            assert.assertTrue(str.contains(bt.outDir(), "test"), 3)
        }
        case "buildTarget on a missing key returns false": {
            Manifest m = new Manifest()
            Builder b = new Builder(m, "debug", false)
            assert.assertFalse(b.buildTarget("no_such_target"), 4)
        }
        case "built-in release profile gives -O3 without debug symbols": {
            // Regression: with no [profiles] in the manifest, `--release` used to
            // fall back to the debug defaults (-O0 --debug-symbols).
            Manifest m = new Manifest()
            Builder br = new Builder(m, "release", false)
            assert.assertStr(br.profileFlags(), "-O3", 7)
            Builder bd = new Builder(m, "debug", false)
            assert.assertStr(bd.profileFlags(), "-O0 --debug-symbols", 8)
        }
        case "a manifest-declared profile overrides the built-in": {
            Manifest m = new Manifest()
            BuildProfile p = new BuildProfile()
            p.setOptLevel(2)
            m.addProfile("release", p)
            Builder b = new Builder(m, "release", false)
            assert.assertStr(b.profileFlags(), "-O2 --debug-symbols", 9)
        }
        case "lib passes use --lib-dyn / --lib (never the removed --shared)": {
            // Regression: buildTarget once passed `--shared`, which the driver
            // dropped — under the unknown-option hard error every dynamic lib
            // build would fail. The flag contract is pinned here.
            Manifest m = new Manifest()
            Builder b = new Builder(m, "debug", false)
            assert.assertStr(b.libShapeFlag(true), "--lib-dyn", 5)
            assert.assertStr(b.libShapeFlag(false), "--lib", 6)
        }
    }

    void buildFlowTest() {
        case "loadManifest + buildAll compiles a target (bypasses Driver.run)": {
            string repo = env.cwdGet()
            // Builder.resolveFly reads FLYLANG_BIN (the dir holding fly[.exe]); point
            // it at the shipped compiler so invokeFly execs the real fly, not this test.
            // CI runs these suites at every stage: prefer stage2, then stage1 (STAGE=1
            // runs BEFORE stage2.ps1), then the stage0 seed (STAGE=0 runs BEFORE
            // stage1.ps1, when only the downloaded bootstrap exists).
            string bin = str.concat(repo, "/build/stage2/bin")
            bool have = fs.exists(str.concat(bin, "/fly"))
            if have == false { have = fs.exists(str.concat(bin, "/fly.exe")) }
            if have == false {
                bin = str.concat(repo, "/build/stage1/bin")
                have = fs.exists(str.concat(bin, "/fly"))
                if have == false { have = fs.exists(str.concat(bin, "/fly.exe")) }
            }
            if have == false { bin = str.concat(repo, "/build/stage0/bin") }
            env.set("FLYLANG_BIN", bin)

            // The scratch project lives OUTSIDE the repo (OS temp dir): a leftover
            // in the repo root would be picked up by the directory CLI's discovery
            // (--src-dir . in build_compiler) and abort the monolithic stage1 build
            // with "multiple main()".
            string tmp = env.get("TMPDIR")
            if str.isEmpty(tmp) { tmp = env.get("TEMP") }
            if str.isEmpty(tmp) { tmp = "/tmp" }
            string proj = path.join(tmp, "bld_suite_proj")
            fs.dirDeleteAll(proj)     // stale leftover from a previous failed run
            fs.dirCreateAll(str.concat(proj, "/src"), 493)

            // Manifest.fly with one bin target -> a trivial (import-free) source, so
            // it links against the auto-discovered runtime with no extra -L.
            string man = "namespace pkg.manifest"
            man = str.concat(man, driver.nl())
            man = str.concat(man, "import fly.meta.*")
            man = str.concat(man, driver.nl())
            man = str.concat(man, "class Manifest : fly.meta.Manifest {")
            man = str.concat(man, driver.nl())
            man = str.concat(man, str.concat("  string name = ", qb("hello")))
            man = str.concat(man, driver.nl())
            man = str.concat(man, str.concat("  string version = ", qb("0.1.0")))
            man = str.concat(man, driver.nl())
            string tgt = str.concat("  Target[] targets = { new Target(", qb("hello"))
            tgt = str.concat(tgt, str.concat(", ", qb("src/main.fly")))
            tgt = str.concat(tgt, str.concat(", ", qb("")))
            tgt = str.concat(tgt, ") }")
            man = str.concat(man, tgt)
            man = str.concat(man, driver.nl())
            man = str.concat(man, "}")
            fs.writeStr(str.concat(proj, "/Manifest.fly"), man, 420)

            string src = str.concat("namespace app", driver.nl())
            src = str.concat(src, "void main() { }")
            fs.writeStr(str.concat(proj, "/src/main.fly"), src, 420)

            // Enter the project so loadManifest reads ./Manifest.fly (CWD-relative).
            env.cwdSet(proj)

            int e = 0
            Manifest m = driver.loadManifest(e)
            int targets = m.targetCount()
            string name = m.getName()

            Builder b = new Builder(m, "debug", false)
            bool ok = b.buildAll()                     // execs fly to compile src/main.fly
            // the emitted binary (Windows appends .exe; POSIX doesn't)
            bool built = fs.exists("target/debug/hello.exe")
            if built == false { built = fs.exists("target/debug/hello") }

            // restore + clean up BEFORE asserting: a failing assert aborts the
            // case, and the scratch project must never survive a failed run
            env.cwdSet(repo)
            fs.dirDeleteAll(proj)
            env.delete("FLYLANG_BIN")

            assert.assertEqI(e, 0, 11)                 // reader parsed the manifest (no crash)
            assert.assertEqI(targets, 1, 12)           // the targets array was read
            assert.assertStr(name, "hello", 13)
            assert.assertTrue(ok, 14)
            assert.assertTrue(built, 15)
        }
    }

    void incrementalTest() {
        case "fingerprint cache: skip when fresh, rebuild on edit, --force": {
            string repo = env.cwdGet()
            string bin = str.concat(repo, "/build/stage2/bin")
            bool have = fs.exists(str.concat(bin, "/fly"))
            if have == false { have = fs.exists(str.concat(bin, "/fly.exe")) }
            if have == false {
                bin = str.concat(repo, "/build/stage1/bin")
                have = fs.exists(str.concat(bin, "/fly"))
                if have == false { have = fs.exists(str.concat(bin, "/fly.exe")) }
            }
            if have == false { bin = str.concat(repo, "/build/stage0/bin") }
            env.set("FLYLANG_BIN", bin)

            string tmp = env.get("TMPDIR")
            if str.isEmpty(tmp) { tmp = env.get("TEMP") }
            if str.isEmpty(tmp) { tmp = "/tmp" }
            string proj = path.join(tmp, "bld_suite_incr")
            fs.dirDeleteAll(proj)
            fs.dirCreateAll(str.concat(proj, "/src"), 493)

            string man = "namespace pkg.manifest"
            man = str.concat(man, driver.nl())
            man = str.concat(man, "import fly.meta.*")
            man = str.concat(man, driver.nl())
            man = str.concat(man, "class Manifest : fly.meta.Manifest {")
            man = str.concat(man, driver.nl())
            man = str.concat(man, str.concat("  string name = ", qb("hello")))
            man = str.concat(man, driver.nl())
            man = str.concat(man, str.concat("  string version = ", qb("0.1.0")))
            man = str.concat(man, driver.nl())
            string tgt = str.concat("  Target[] targets = { new Target(", qb("hello"))
            tgt = str.concat(tgt, str.concat(", ", qb("src/main.fly")))
            tgt = str.concat(tgt, str.concat(", ", qb("")))
            tgt = str.concat(tgt, ") }")
            man = str.concat(man, tgt)
            man = str.concat(man, driver.nl())
            man = str.concat(man, "}")
            fs.writeStr(str.concat(proj, "/Manifest.fly"), man, 420)

            string src = str.concat("namespace app", driver.nl())
            src = str.concat(src, "void main() { }")
            fs.writeStr(str.concat(proj, "/src/main.fly"), src, 420)

            env.cwdSet(proj)

            int e = 0
            Manifest m = driver.loadManifest(e)
            Builder b = new Builder(m, "debug", false)
            Target t = m.targetAt(0)

            bool ok1 = b.buildAll()                    // cold: compiles + saves fp
            bool fpThere = fs.exists("target/debug/.fly/hello.fp")
            // freshness via the direct API (no mtime flakiness)
            string comp1 = b.computeFpFor(t)
            bool fresh1 = b.isUpToDate(b.fpPath("hello"), comp1) && b.artifactsExist(t)
            bool ok2 = b.buildTarget("hello")          // warm: takes the skip path

            // edit the source → fingerprint must flip → rebuild → fresh again
            string src2 = str.concat("namespace app", driver.nl())
            src2 = str.concat(src2, "void main() { int x = 1 }")
            fs.writeStr("src/main.fly", src2, 420)
            string comp2 = b.computeFpFor(t)
            bool fresh2 = b.isUpToDate(b.fpPath("hello"), comp2)
            bool ok3 = b.buildAll()
            string comp3 = b.computeFpFor(t)
            bool fresh3 = b.isUpToDate(b.fpPath("hello"), comp3)

            b.setForce(true)
            bool ok4 = b.buildTarget("hello")          // force: recompiles anyway

            env.cwdSet(repo)
            fs.dirDeleteAll(proj)
            env.delete("FLYLANG_BIN")

            assert.assertEqI(e, 0, 21)
            assert.assertTrue(ok1, 22)
            assert.assertTrue(fpThere, 23)
            assert.assertTrue(fresh1, 24)              // cold build left a matching fp
            assert.assertTrue(ok2, 25)                 // warm build succeeds via skip
            assert.assertFalse(fresh2, 26)             // edit invalidated the fp
            assert.assertTrue(ok3, 27)                 // rebuild after edit
            assert.assertTrue(fresh3, 28)              // fresh again after rebuild
            assert.assertTrue(ok4, 29)                 // --force still succeeds
        }
    }
}
