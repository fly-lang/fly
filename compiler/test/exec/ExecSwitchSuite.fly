import fly.assert

// ─────────────────────────────────────────────────────────────────────────────
// ExecSwitchSuite — EXECUTED switch/case semantics (bug-hunt Phase 1).
// B021 is FIXED: braced case bodies lower (nested-block adoption in the
// Resolver; the 6xx cases pin it). From 0.15 no case falls into the next one
// (it did up to 0.14, C-style: doc 9.4, B023/B024) and `case 3, 4:` lists
// several values; an empty case is rejected (ci/sema_probes/reject/empty_case).
// STAGE=0 needs the re-cut seed (the pinned one cannot parse this switch form).
//
// Assert codes: 1xx dispatch, 2xx no fall-through, 3xx value lists,
// 4xx default, 5xx interactions, 6xx braced bodies.
// ─────────────────────────────────────────────────────────────────────────────

int execSwitchPick(const int v) {
    int r = 0
    switch v {
        case 1:
            r = 10
            break
        case 2:
            r = 20
            break
        default:
            r = 99
            break
    }
    return r
}

suite ExecSwitchSuite {

    void dispatchTest() {
        case "each case selects its own body": {
            assert.assertEqI(execSwitchPick(1), 10, 101)
            assert.assertEqI(execSwitchPick(2), 20, 102)
        }
        case "no match lands in default": {
            assert.assertEqI(execSwitchPick(7), 99, 111)
            assert.assertEqI(execSwitchPick(0 - 1), 99, 112)
        }
    }

    void fallthroughTest() {
        case "a case without break does not fall into the next": {
            int hits = 0
            int v = 1
            switch v {
                case 1:
                    hits = hits + 1
                case 2:
                    hits = hits + 10
                case 3:
                    hits = hits + 100
            }
            assert.assertEqI(hits, 1, 201)               // from 0.15: no fall-through
        }
        case "the last case does not fall into default": {
            int hits = 0
            int v = 3
            switch v {
                case 3:
                    hits = hits + 1
                default:
                    hits = hits + 10
            }
            assert.assertEqI(hits, 1, 211)
        }
        case "break still leaves a case early": {
            int hits = 0
            int v = 2
            switch v {
                case 2:
                    hits = hits + 1
                    if hits == 1 {
                        break
                    }
                    hits = hits + 10
                default:
                    hits = hits + 100
            }
            assert.assertEqI(hits, 1, 221)
        }
    }

    void stackedCasesTest() {
        case "one case lists several values": {
            int r = 0
            int v = 3
            switch v {
                case 3, 4:
                    r = 34
                case 5:
                    r = 5
            }
            assert.assertEqI(r, 34, 301)
        }
        case "every value of the list matches": {
            int r = 0
            int v = 4
            switch v {
                case 2, 3, 4:
                    r = 34
                default:
                    r = 9
            }
            assert.assertEqI(r, 34, 311)
        }
        case "a value outside the list goes to default": {
            int r = 0
            int v = 6
            switch v {
                case 3, 4:
                    r = 34
                default:
                    r = 9
            }
            assert.assertEqI(r, 9, 321)
        }
    }

    void defaultOnlyTest() {
        case "switch with only default always runs it": {
            int r = 0
            int v = 42
            switch v {
                default:
                    r = 1
                    break
            }
            assert.assertEqI(r, 1, 401)
        }
    }

    void interactionTest() {
        case "break inside switch binds to the switch": {
            int total = 0
            for int i = 0; i < 3; i++ {
                switch i {
                    case 1:
                        total = total + 10
                        break
                    default:
                        total = total + 1
                        break
                }
            }
            assert.assertEqI(total, 12, 501)             // 1 + 10 + 1: loop completes
        }
        case "switch on a long discriminant": {
            long v = 4294967296                          // 2^32: needs 64-bit compare
            int r = 0
            switch v {
                case 4294967296:
                    r = 1
                    break
                default:
                    r = 2
                    break
            }
            assert.assertEqI(r, 1, 511)
        }
    }

    void bracedBodyTest() {
        case "braced case body runs": {
            int r = 0
            int v = 1
            switch v {
                case 1: {
                    r = 10
                    break
                }
                default: {
                    r = 99
                    break
                }
            }
            assert.assertEqI(r, 10, 601)
        }
        case "braced default runs": {
            int r = 0
            int v = 7
            switch v {
                case 1: {
                    r = 10
                    break
                }
                default: {
                    r = 99
                    break
                }
            }
            assert.assertEqI(r, 99, 611)
        }
        case "bare scoping block runs its statements": {
            int r = 0
            {
                r = 5
            }
            assert.assertEqI(r, 5, 621)                  // nested-block adoption (B021 root cause)
        }
    }
}
