namespace fly.compiler.target.test.pointer

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.compiler.sema.*
import fly.compiler.codegen.*
import fly.compiler.target.*
import fly.data.*
import fly.assert
import fly.os.fs
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// PtrSizeWidthSuite — pointer is the pointer-sized unsigned integer: it lowers to
// the TARGET pointer width, while long stays a fixed 64-bit type on every target.
// Proven by emitting the same source for x86_64 (64-bit) and riscv32 (32-bit) and
// inspecting the integer widths in the IR.
// ─────────────────────────────────────────────────────────────────────────────

// cgIRTarget — compile `src` for `triple` and return the emitted LLVM IR text.
public string cgIRTarget(const string src, const string triple) {
    Parser p = new Parser(src)
    ASTModule m = p.parseModule("t")
    assert.assertTrue(p.isSuccess(), 90)
    List<ASTModule> mods = new List<ASTModule>()
    mods.add(m)
    // Twin of TestUtil.cgIR, and it needs the same guard: resolve with a REAL
    // engine (a null one swallows every semantic error, so a bad source reached
    // codegen as a half-built AST and segfaulted the suite binary). The old body
    // also assigned the out slot before failing, so a caller that read it after
    // the failure saw an empty string; a failing function now simply hands back
    // nothing, and every caller here asserts success first.
    DiagnosticsEngine diags = p.getDiags()
    SemaContext ctx = new SemaContext(diags)
    List<SemaModule> mres = ctx.Resolve(mods, false)
    if diags.hasErrorOccurred() {
        fail 92, "cgIRTarget: source did not resolve"
    }
    CodeGenModule cgm = new CodeGenModule("t")
    TargetInfo ti = targetInfoCreate(new TargetOptions(triple))
    cgm.configureTarget(ti)              // sets pointer width for pointer
    cgm.generate(ctx.getReg())
    bool ok = false
    cgm.verify(ok)
    assert.assertTrue(ok, 91)
    cgm.emitIR("/tmp/cg/pointer.ll")
    return fs.readStr("/tmp/cg/pointer.ll")
}

suite PtrSizeWidthSuite {

    void widthTest() {
        case "pointer = i64 on x86_64, i32 on riscv32; long stays i64": {
            string src = "pointer uid(const pointer a) { return a }  long lid(const long a) { return a }"
            string ir64 = cgIRTarget(src, "x86_64-unknown-linux-gnu")
            string ir32 = cgIRTarget(src, "riscv32-unknown-linux-gnu")

            // x86_64: pointer and long both i64; no i32 integer load present.
            assert.assertTrue(str.contains(ir64, "load i64"), 1)
            assert.assertFalse(str.contains(ir64, "load i32"), 2)

            // riscv32: pointer became i32, but long is STILL i64 (fixed-width).
            assert.assertTrue(str.contains(ir32, "load i32"), 3)
            assert.assertTrue(str.contains(ir32, "load i64"), 4)
        }
    }
}
