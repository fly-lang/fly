namespace fly.compiler.parser.test

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.data.*
import fly.str
import fly.assert

// Array parsing — literals `{...}`, array types `T[]`/`T[N]`/`T[][]`, and field/
// local initializers. Literal structure is read back through the `asArrayValue()`
// downcast (base ASTNode returns null, ASTArrayValue overrides). Type/decl cases
// are acceptance-only (`isSuccess`), mirroring the sibling parser suites. Mirrors
// the reference ParserValueTest / ParserLocalVarTest coverage.

// declaredLocals — parse `src` and count the locals its LAST function declares:
// what tells a statement read as a declaration from one read as an expression
// (both may parse). -1 when the source does not parse.
int declaredLocals(const string src) {
    Parser p = new unique Parser(src)
    ASTModule mod = p.parseModule("t")
    if p.isSuccess() == false {
        return -1
    }
    List<ASTNode> nodes = mod.getNodes()
    ASTFunction f = nodes.get(nodes.size() - 1).asFunction()
    if f == null {
        return -1
    }
    return (int)f.getLocalNames().size()
}

// sizeAt — parse `src` as a type and give the literal size of its dimension
// `depth`, counted from the outermost array (0); "" for a dimension without a
// size, "?" when the type has no such dimension.
string sizeAt(const string src, const int depth) {
    Parser p = new unique Parser(src)
    ASTType t = p.parseType()
    int d = 0
    while d < depth {
        if t == null {
            return "?"
        }
        ASTArrayType outer = t.asArrayType()
        if outer == null {
            return "?"
        }
        t = outer.getElementType()
        d = d + 1
    }
    if t == null {
        return "?"
    }
    ASTArrayType at = t.asArrayType()
    if at == null {
        return "?"
    }
    ASTExpr se = at.getSizeExpr()
    if se == null {
        return ""
    }
    ASTNumberValue nv = se.asNumberValue()
    if nv == null {
        return "?"
    }
    return nv.getValue()
}

suite ParserArraySuite {

    void literalTest() {
        case "empty {}": {
            Parser p = new unique Parser("{}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 1)
            ASTArrayValue a = e.asArrayValue()
            assert.assertTrue(a != null, 2)
            assert.assertEqI((int)a.getValues().size(), 0, 3)
        }
        case "int elements {1,2,3}": {
            Parser p = new unique Parser("{1, 2, 3}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 4)
            ASTArrayValue a = e.asArrayValue()
            assert.assertTrue(a != null, 5)
            assert.assertEqI((int)a.getValues().size(), 3, 6)
        }
        case "bool elements {true,false}": {
            Parser p = new unique Parser("{true, false}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 7)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI((int)a.getValues().size(), 2, 8)
        }
        case "trailing comma {1,2,}": {
            Parser p = new unique Parser("{1, 2,}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 9)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI((int)a.getValues().size(), 2, 10)
        }
    }

    void nestedTest() {
        case "nested {{1,2},{3,4}}": {
            Parser p = new unique Parser("{{1, 2}, {3, 4}}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 11)
            ASTArrayValue a = e.asArrayValue()
            assert.assertTrue(a != null, 12)
            assert.assertEqI((int)a.getValues().size(), 2, 13)
            ASTArrayValue row0 = a.getValues().get(0).asArrayValue()
            assert.assertTrue(row0 != null, 14)
            assert.assertEqI((int)row0.getValues().size(), 2, 15)
        }
    }

    void objectElementsTest() {
        case "array of new {new C()}": {
            Parser p = new unique Parser("{new C(), new C()}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 16)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI((int)a.getValues().size(), 2, 17)
        }
        case "string elements": {
            string Q = "\""
            // build:  {"a", "b", ""}
            string src = str.concat("{", str.concat(Q, str.concat("a", Q)))
            src = str.concat(src, ", ")
            src = str.concat(src, str.concat(Q, str.concat("b", Q)))
            src = str.concat(src, "}")
            Parser p = new unique Parser(src)
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 18)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI((int)a.getValues().size(), 2, 19)
        }
    }

    void arrayTypeTest() {
        case "T[] field decl": {
            Parser p = new unique Parser("class C { int[] xs }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 20)
        }
        case "T[N] sized decl": {
            Parser p = new unique Parser("void f() { int[3] a }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 21)
        }
        case "T[][] nested type": {
            Parser p = new unique Parser("void f() { int[][] m }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 22)
        }
    }

    void initTest() {
        case "field init T[] xs = {1,2}": {
            Parser p = new unique Parser("class C { int[] xs = {1, 2} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 23)
        }
        case "local init int[] a = {1,2,3}": {
            Parser p = new unique Parser("void f() { int[] a = {1, 2, 3} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 24)
        }
        case "empty init int[] a = {}": {
            Parser p = new unique Parser("void f() { int[] a = {} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 25)
        }
    }

    void forInParseTest() {
        case "for x in a parses": {
            Parser p = new unique Parser("void f() { int[] a = {1, 2, 3}  for x in a { } }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 26)
        }
    }

    // ── subscript `base[index]` ───────────────────────────────────────────────
    // The '[' suffix lives inside parsePostfix's loop, so it chains with itself
    // and with '.'; and `Ident [` at statement start is ambiguous between a
    // declaration and a subscript expression, decided by bracketDeclAhead.
    void subscriptTest() {
        case "read k[1]": {
            Parser p = new unique Parser("void f() { int[] k = {1, 2}  int x = k[1] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 31)
        }
        case "write k[0] = 9 stays an expression statement": {
            Parser p = new unique Parser("void f() { int[] k = {1, 2}  k[0] = 9 }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 32)
        }
        case "computed index k[i + 1]": {
            Parser p = new unique Parser("void f() { int[] k = {1, 2}  int i = 0  int x = k[i + 1] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 33)
        }
        case "chained m[i][j]": {
            Parser p = new unique Parser("void f() { int[][] m = {{1}}  int x = m[0][0] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 34)
        }
        case "nested index m[k[0]]": {
            Parser p = new unique Parser("void f() { int[] k = {0}  int[] m = {5}  int x = m[k[0]] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 35)
        }
    }

    // The declaration/expression fork. Both start `Ident [`; only what follows
    // the closing bracket run tells them apart.
    void bracketDeclTest() {
        case "C[3] cs is a declaration": {
            Parser p = new unique Parser("class C { } void f() { C[3] cs }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 41)
        }
        case "C[] cs = {} is a declaration": {
            Parser p = new unique Parser("class C { } void f() { C[] cs = {} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 42)
        }
        case "C[2][3] grid — consecutive groups are one run": {
            Parser p = new unique Parser("class C { } void f() { C[2][3] grid }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 43)
        }
        case "k[0].m() is an expression, not a declaration": {
            Parser p = new unique Parser("class C { public void m() { } } void f() { C[1] k  k[0].m() }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 44)
        }
    }

    // The probe walks the token stream ahead of the parser and must push every
    // token it consumed back into `pending`. If it drops even one, the stream
    // desynchronises SILENTLY — the parse keeps going and produces a wrong tree
    // rather than an error. These cases put a subscript-or-decl fork in the
    // middle of a function and check the statements AFTER it still parse.
    void probeNeutralityTest() {
        case "statements after a decl fork are intact": {
            Parser p = new unique Parser("class C { } void f() { C[2] cs  int a = 1  int b = a + 1  return }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 51)
        }
        case "statements after an expression fork are intact": {
            Parser p = new unique Parser("void f() { int[] k = {1, 2}  k[0] = 9  int a = 1  int b = a + 1  return }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 52)
        }
        case "an unterminated bracket run still reports, not hangs": {
            Parser p = new unique Parser("void f() { int[] k = {1}  k[0 }")
            ASTModule mod = p.parseModule("t")
            assert.assertFalse(p.isSuccess(), 53)
        }
    }

    // The element type may be a dotted name (fly-lang/fly#269): `a.b.C[2] cs`
    // was read as an expression indexing a member, and `a.C[] cs = {}` did not
    // parse. The name after the bracket run is what makes it a declaration; an
    // index into a member (`o.items[2] = v`) stays an expression.
    void dottedElementTest() {
        case "a.b.C[2] cs is a declaration": {
            assert.assertEqI(declaredLocals("void f() { a.b.C[2] cs }"), 1, 71)
        }
        case "a.C[] cs = {} is a declaration": {
            assert.assertEqI(declaredLocals("void f() { a.C[] cs = {} }"), 1, 72)
        }
        case "a.b.C[2][3] grid — consecutive groups are one run": {
            assert.assertEqI(declaredLocals("void f() { a.b.C[2][3] grid }"), 1, 73)
        }
        case "a.b.C<int>[2] bs — brackets after type arguments": {
            assert.assertEqI(declaredLocals("void f() { a.b.C<int>[2] bs }"), 1, 74)
            assert.assertEqI(declaredLocals("void f() { a.C<List<int>>[] bs = {} }"), 1, 75)
        }
        case "C<int>[2] bs — a single name with type arguments": {
            assert.assertEqI(declaredLocals("void f() { C<int>[2] bs }"), 1, 76)
            assert.assertEqI(declaredLocals("void f() { C<int>[] bs = {} }"), 1, 77)
        }
        case "o.items[2] = v stays an expression statement": {
            assert.assertEqI(declaredLocals("void f() { o.items[2] = 1 }"), 0, 78)
            assert.assertEqI(declaredLocals("void f() { a.b.items[k[0]] = 1 }"), 0, 79)
        }
        case "o.rows[0].use() is an expression, not a declaration": {
            assert.assertEqI(declaredLocals("void f() { o.rows[0].use() }"), 0, 80)
            assert.assertEqI(declaredLocals("void f() { o.grid[0][1] = 2 }"), 0, 81)
        }
        case "a dotted array declaration in a for header": {
            assert.assertEqI(declaredLocals("void f() { for a.b.C[1] one, int i = 0; i < 1; i++ { } }"), 2, 82)
        }
        case "statements after a dotted decl fork are intact": {
            assert.assertEqI(declaredLocals("void f() { a.b.C[2] cs  int x = 1  int y = x + 1  return }"), 3, 83)
        }
        case "statements after a dotted expression fork are intact": {
            assert.assertEqI(declaredLocals("void f() { o.items[0] = 9  int x = 1  int y = x + 1  return }"), 2, 84)
        }
        case "an unterminated dotted bracket run still reports, not hangs": {
            assert.assertEqI(declaredLocals("void f() { o.items[0 }"), -1, 85)
        }
    }

    // The dimensions of an array type read in the order of the subscripts
    // (fly-lang/fly#271): in `int[2][3]` the FIRST group is the outermost
    // array — 2 rows — and the last one holds the elements — 3 per row.
    void dimensionOrderTest() {
        case "int[2][3]: the first size is the outer array": {
            assert.assertStr(sizeAt("int[2][3]", 0), "2", 91)
            assert.assertStr(sizeAt("int[2][3]", 1), "3", 92)
            assert.assertStr(sizeAt("int[2][3]", 2), "?", 93)
        }
        case "three dimensions nest in the same order": {
            assert.assertStr(sizeAt("C[4][5][6]", 0), "4", 94)
            assert.assertStr(sizeAt("C[4][5][6]", 1), "5", 95)
            assert.assertStr(sizeAt("C[4][5][6]", 2), "6", 96)
        }
        case "a dimension without a size keeps its place": {
            assert.assertStr(sizeAt("int[2][]", 0), "2", 97)
            assert.assertStr(sizeAt("int[2][]", 1), "", 98)
            assert.assertStr(sizeAt("int[][3]", 0), "", 99)
            assert.assertStr(sizeAt("int[][3]", 1), "3", 100)
        }
        case "one dimension is unchanged": {
            assert.assertStr(sizeAt("int[7]", 0), "7", 101)
            assert.assertStr(sizeAt("int[7]", 1), "?", 102)
        }
    }

    // `out[N] = expr` is intercepted by parseExprStmt BEFORE parseExpr runs, so
    // the new '[' suffix must not disturb multi-return assignment.
    void outSlotTest() {
        case "out[0] = x in a multi-return function": {
            Parser p = new unique Parser("int,int g() { out[0] = 1  out[1] = 2 } void f() { }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 61)
        }
    }
}
