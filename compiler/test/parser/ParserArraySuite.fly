import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.data.*
import fly.mem
import fly.str
import fly.assert

// Array parsing — literals `{...}`, array types `T[]`/`T[N]`/`T[][]`, and field/
// local initializers. Literal structure is read back through the `asArrayValue()`
// downcast (base ASTNode returns null, ASTArrayValue overrides). Type/decl cases
// are acceptance-only (`isSuccess`), mirroring the sibling parser suites. Mirrors
// the reference ParserValueTest / ParserLocalVarTest coverage.

// dq — a real double-quote char (the self-host lexer keeps `\"` raw, so string
// literals inside a parsed source are built at runtime). Same trick as dquote().
string dq() {
    pointer buf = mem.alloc(1)
    byte q = 34
    fly.llvm.strPoke(buf, 0, q)
    string s = ""
    fly.llvm.strMake(buf, 1, s)
    out = s
}

suite ParserArraySuite {

    void literalTest() {
        case "empty {}": {
            Parser p = new Parser("{}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 1)
            ASTArrayValue a = e.asArrayValue()
            assert.assertTrue(a != null, 2)
            assert.assertEqI(a.getValues().size(), 0, 3)
        }
        case "int elements {1,2,3}": {
            Parser p = new Parser("{1, 2, 3}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 4)
            ASTArrayValue a = e.asArrayValue()
            assert.assertTrue(a != null, 5)
            assert.assertEqI(a.getValues().size(), 3, 6)
        }
        case "bool elements {true,false}": {
            Parser p = new Parser("{true, false}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 7)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI(a.getValues().size(), 2, 8)
        }
        case "trailing comma {1,2,}": {
            Parser p = new Parser("{1, 2,}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 9)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI(a.getValues().size(), 2, 10)
        }
    }

    void nestedTest() {
        case "nested {{1,2},{3,4}}": {
            Parser p = new Parser("{{1, 2}, {3, 4}}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 11)
            ASTArrayValue a = e.asArrayValue()
            assert.assertTrue(a != null, 12)
            assert.assertEqI(a.getValues().size(), 2, 13)
            ASTArrayValue row0 = a.getValues().get(0).asArrayValue()
            assert.assertTrue(row0 != null, 14)
            assert.assertEqI(row0.getValues().size(), 2, 15)
        }
    }

    void objectElementsTest() {
        case "array of new {new C()}": {
            Parser p = new Parser("{new C(), new C()}")
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 16)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI(a.getValues().size(), 2, 17)
        }
        case "string elements": {
            string Q = dq()
            // build:  {"a", "b", ""}
            string src = str.concat("{", str.concat(Q, str.concat("a", Q)))
            src = str.concat(src, ", ")
            src = str.concat(src, str.concat(Q, str.concat("b", Q)))
            src = str.concat(src, "}")
            Parser p = new Parser(src)
            ASTExpr e = p.parseExpr()
            assert.assertTrue(p.isSuccess(), 18)
            ASTArrayValue a = e.asArrayValue()
            assert.assertEqI(a.getValues().size(), 2, 19)
        }
    }

    void arrayTypeTest() {
        case "T[] field decl": {
            Parser p = new Parser("class C { int[] xs }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 20)
        }
        case "T[N] sized decl": {
            Parser p = new Parser("void f() { int[3] a }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 21)
        }
        case "T[][] nested type": {
            Parser p = new Parser("void f() { int[][] m }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 22)
        }
    }

    void initTest() {
        case "field init T[] xs = {1,2}": {
            Parser p = new Parser("class C { int[] xs = {1, 2} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 23)
        }
        case "local init int[] a = {1,2,3}": {
            Parser p = new Parser("void f() { int[] a = {1, 2, 3} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 24)
        }
        case "empty init int[] a = {}": {
            Parser p = new Parser("void f() { int[] a = {} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 25)
        }
    }

    void forInParseTest() {
        case "for x in a parses": {
            Parser p = new Parser("void f() { int[] a = {1, 2, 3}  for x in a { } }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 26)
        }
    }

    // ── subscript `base[index]` ───────────────────────────────────────────────
    // The '[' suffix lives inside parsePostfix's loop, so it chains with itself
    // and with '.'; and `Ident [` at statement start is ambiguous between a
    // declaration and a subscript expression, decided by bracketDeclAhead.
    void subscriptTest() {
        case "read k[1]": {
            Parser p = new Parser("void f() { int[] k = {1, 2}  int x = k[1] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 31)
        }
        case "write k[0] = 9 stays an expression statement": {
            Parser p = new Parser("void f() { int[] k = {1, 2}  k[0] = 9 }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 32)
        }
        case "computed index k[i + 1]": {
            Parser p = new Parser("void f() { int[] k = {1, 2}  int i = 0  int x = k[i + 1] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 33)
        }
        case "chained m[i][j]": {
            Parser p = new Parser("void f() { int[][] m = {{1}}  int x = m[0][0] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 34)
        }
        case "nested index m[k[0]]": {
            Parser p = new Parser("void f() { int[] k = {0}  int[] m = {5}  int x = m[k[0]] }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 35)
        }
    }

    // The declaration/expression fork. Both start `Ident [`; only what follows
    // the closing bracket run tells them apart.
    void bracketDeclTest() {
        case "C[3] cs is a declaration": {
            Parser p = new Parser("class C { } void f() { C[3] cs }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 41)
        }
        case "C[] cs = {} is a declaration": {
            Parser p = new Parser("class C { } void f() { C[] cs = {} }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 42)
        }
        case "C[2][3] grid — consecutive groups are one run": {
            Parser p = new Parser("class C { } void f() { C[2][3] grid }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 43)
        }
        case "k[0].m() is an expression, not a declaration": {
            Parser p = new Parser("class C { public void m() { } } void f() { C[1] k  k[0].m() }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 44)
        }
    }

    // The probe walks the token stream ahead of the parser and must push every
    // token it consumed back into `pending`. If it drops even one, the stream
    // desynchronises SILENTLY — the parse keeps going and produces a wrong tree
    // rather than an error. These cases put a subscript-or-decl fork in the
    // middle of a function and check the statements AFTER it still parse.
    void probeNeutralityTest() {
        case "statements after a decl fork are intact": {
            Parser p = new Parser("class C { } void f() { C[2] cs  int a = 1  int b = a + 1  return }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 51)
        }
        case "statements after an expression fork are intact": {
            Parser p = new Parser("void f() { int[] k = {1, 2}  k[0] = 9  int a = 1  int b = a + 1  return }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 52)
        }
        case "an unterminated bracket run still reports, not hangs": {
            Parser p = new Parser("void f() { int[] k = {1}  k[0 }")
            ASTModule mod = p.parseModule("t")
            assert.assertFalse(p.isSuccess(), 53)
        }
    }

    // `out[N] = expr` is intercepted by parseExprStmt BEFORE parseExpr runs, so
    // the new '[' suffix must not disturb multi-return assignment.
    void outSlotTest() {
        case "out[0] = x in a multi-return function": {
            Parser p = new Parser("int,int g() { out[0] = 1  out[1] = 2 } void f() { }")
            ASTModule mod = p.parseModule("t")
            assert.assertTrue(p.isSuccess(), 61)
        }
    }
}
