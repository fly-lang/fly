namespace fly.compiler.sema.test.importstyle

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.compiler.sema.*
import fly.data.*
import fly.str
import fly.assert

// ─────────────────────────────────────────────────────────────────────────────
// ImportStyleSuite — the CANONICAL import semantics, one cell per case:
//   A. `import my.utils.*` + bare `foo()`        → resolves (wildcard injects the
//      namespace's symbols into module scope)
//   B. `import my.utils.*` + prefixed `utils.foo()` → ERROR (a wildcard does NOT
//      bind the `utils.` prefix — expandNsPath skips wildcard imports; mirrors
//      the reference, whose ResolveImports never inserts the namespace symbol
//      for a wildcard)
//   C. `import my.utils` + prefixed `utils.foo()` → resolves (a plain import
//      binds the LAST path segment as the prefix)
//   D. `import my.utils` + bare `foo()`          → ERROR (a plain import brings
//      no member symbols into scope)
// Each case parses a lib module + a main module and runs the real Resolver
// in-process (same vehicle as SameNamespaceSuite); the assertion is on
// DiagnosticsEngine.hasErrorOccurred().
// ─────────────────────────────────────────────────────────────────────────────

// resolveErr — parse libSrc+mainSrc, resolve, out = "did an error occur".
bool resolveErr(const string libSrc, const string mainSrc) {
    Parser pa = new unique Parser(libSrc)
    ASTModule ma = pa.parseModule("lib")
    Parser pb = new unique Parser(mainSrc)
    ASTModule mb = pb.parseModule("main")
    List<ASTModule> mods = new List<ASTModule>()
    mods.add(ma)
    mods.add(mb)
    DiagnosticsEngine diags = pa.getDiags()
    SemaContext ctx = new unique SemaContext(diags)
    List<SemaModule> res = ctx.Resolve(mods, false)
    return diags.hasErrorOccurred()
}

string libSrc() {
    return "namespace my.utils  public int foo(const int x) { return x + 1 }"
}

// typesSrc — a namespace with an enum and a class with static members, for the
// values reached through a namespace prefix (fly-lang/fly#270).
string typesSrc() {
    string e = "namespace my.utils  public enum Mode { ON, OFF }  "
    string c = "public class K { public static int count = 0  public static int twice(const int n) { return n * 2 } }"
    return str.concat(e, c)
}

suite ImportStyleSuite {

    void wildcardBareTest() {
        case "A: wildcard import + bare call resolves": {
            string m = "namespace app  import my.utils.*  public int useA(const int y) { return foo(y) }"
            bool err = resolveErr(libSrc(), m)
            assert.assertFalse(err, 1)
        }
    }

    void wildcardPrefixTest() {
        case "B: wildcard import does NOT bind the prefix": {
            string m = "namespace app  import my.utils.*  public int useB(const int y) { return utils.foo(y) }"
            bool err = resolveErr(libSrc(), m)
            assert.assertTrue(err, 2)
        }
    }

    void plainPrefixTest() {
        case "C: plain import binds the last-segment prefix": {
            string m = "namespace app  import my.utils  public int useC(const int y) { return utils.foo(y) }"
            bool err = resolveErr(libSrc(), m)
            assert.assertFalse(err, 3)
        }
    }

    void plainBareTest() {
        case "D: plain import brings no bare symbols": {
            string m = "namespace app  import my.utils  public int useD(const int y) { return foo(y) }"
            bool err = resolveErr(libSrc(), m)
            assert.assertTrue(err, 4)
        }
    }

    void aliasPrefixTest() {
        case "alias import binds the alias, not the segment": {
            string lib = libSrc()
            string m1 = "namespace app  import my.utils as u  public int useE(const int y) { return u.foo(y) }"
            bool err1 = resolveErr(lib, m1)
            assert.assertFalse(err1, 5)
            string m2 = "namespace app  import my.utils as u  public int useF(const int y) { return utils.foo(y) }"
            bool err2 = resolveErr(lib, m2)
            assert.assertTrue(err2, 6)
        }
    }

    // An enum value and a static member take the namespace of their type: the
    // full path, or the prefix a plain import binds (fly-lang/fly#270). Before,
    // only the imported name worked (`import my.utils.Mode`, then `Mode.ON`).
    void prefixValueTest() {
        case "enum value by full path, no import": {
            string m = "namespace app  public bool on(const int y) { return my.utils.Mode.ON == my.utils.Mode.OFF }"
            assert.assertFalse(resolveErr(typesSrc(), m), 7)
        }
        case "enum value through the import prefix": {
            string m = "namespace app  import my.utils  public utils.Mode pick() { return utils.Mode.OFF }"
            assert.assertFalse(resolveErr(typesSrc(), m), 8)
        }
        case "enum value through an alias": {
            string m = "namespace app  import my.utils as u  public u.Mode pick() { return u.Mode.ON }"
            assert.assertFalse(resolveErr(typesSrc(), m), 9)
            string m2 = "namespace app  import my.utils as u  public u.Mode pick() { return utils.Mode.ON }"
            assert.assertTrue(resolveErr(typesSrc(), m2), 10)
        }
        case "enum value in a case label": {
            string h = "namespace app  import my.utils  public int rank(const utils.Mode m) { "
            string b = "switch m { case utils.Mode.ON: return 1  case my.utils.Mode.OFF: return 2 }  return 0 }"
            assert.assertFalse(resolveErr(typesSrc(), str.concat(h, b)), 11)
        }
        case "a wildcard import does not bind the prefix of a value": {
            string m = "namespace app  import my.utils.*  public Mode pick() { return utils.Mode.ON }"
            assert.assertTrue(resolveErr(typesSrc(), m), 12)
        }
        case "an unknown prefix is an error, not the bare name": {
            string m = "namespace app  import my.utils.Mode  public Mode pick() { return zzz.Mode.ON }"
            assert.assertTrue(resolveErr(typesSrc(), m), 13)
        }
        case "an unknown entry through a prefix is an error": {
            string m = "namespace app  import my.utils  public utils.Mode pick() { return utils.Mode.MAYBE }"
            assert.assertTrue(resolveErr(typesSrc(), m), 14)
        }
        case "static field and static method through a prefix": {
            string m = "namespace app  import my.utils  public int use() { return utils.K.count + my.utils.K.twice(2) }"
            assert.assertFalse(resolveErr(typesSrc(), m), 15)
            string w = "namespace app  import my.utils  public void set() { utils.K.count = my.utils.K.count + 1 }"
            assert.assertFalse(resolveErr(typesSrc(), w), 16)
        }
        case "a local named like the prefix shadows it": {
            string h = "namespace app  import my.utils  class Box { public int Mode = 1 }  "
            string b = "public int use() { Box utils = new unique Box()  return utils.Mode }"
            assert.assertFalse(resolveErr(typesSrc(), str.concat(h, b)), 17)
        }
    }
}
