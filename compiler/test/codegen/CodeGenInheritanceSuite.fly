namespace fly.compiler.codegen.test.inherit

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.compiler.sema.*
import fly.compiler.codegen.*
import fly.data.*
import fly.assert
import fly.os.fs
import fly.str
import fly.test.util.*

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenInheritanceSuite — single inheritance (flattened layout + per-class
// vtable with overrides in-place) + virtual dispatch through a base-typed
// receiver. Faithful port of fly/test/CodeGen/CodeGenClassTest.cpp
// (CGClassExtendsClass / CGClassBaseFieldAccess / CGClassOverrideDispatch).
//
// DEFERRED: CGClassMultiLevelUpcast / CGClassUpcastBaseFieldWrite (multiple
// inheritance, secondary vtables + this-adjusting thunks), CGClassExtendsStruct /
// CGClassExtendsInterface, super calls.
// ─────────────────────────────────────────────────────────────────────────────



suite CodeGenInheritanceSuite {

    void overrideTest() {
        case "derived overrides base method in its vtable (override dispatch)": {
            string ir = cgIR("
                public class Animal { int legs
                    public Animal() { this.legs = 4 }
                    public int sound() { out = 0 }
                    public int getLegs() { out = this.legs }
                }
                public class Dog : Animal { public Dog() { this.legs = 4 }
                    public int sound() { out = 7 }
                }
                int poke(Animal a) { out = a.sound() }
                void main() { Dog d = new Dog()
                    int s = poke(d)
                    int l = d.getLegs()
                    fail s + l
                }
            ")
            assert.assertTrue(str.contains(ir, "@vtable..Animal"), 11)
            assert.assertTrue(str.contains(ir, "@vtable..Dog"), 12)
            // Dog's vtable holds the overriding Dog sound + the inherited Animal getLegs
            assert.assertTrue(str.contains(ir, "@Dog_F05sound"), 13)
            assert.assertTrue(str.contains(ir, "@Animal_F07getLegs"), 14)
        }
        case "base-typed receiver dispatches through the loaded vtable": {
            string ir = cgIR("
                public class Animal { int legs
                    public Animal() { this.legs = 4 }
                    public int sound() { out = 0 }
                }
                public class Dog : Animal { public Dog() { this.legs = 4 }
                    public int sound() { out = 7 }
                }
                int poke(Animal a) { out = a.sound() }
                void main() { Dog d = new Dog()
                    fail poke(d)
                }
            ")
            assert.assertTrue(str.contains(ir, "getelementptr ptr"), 21)  // vtable slot GEP
            assert.assertTrue(str.contains(ir, "call void %"), 22)        // indirect call
        }
    }

    // layoutTest — REGRESSION GUARD for the source-path class layout + inherited
    // field access. A source-compiled class uses the FLAT model: `{ vtable, base
    // fields inlined…, own fields }` with a SINGLE vtable, and `fieldIndex` returns
    // `1 + position in the flattened base-then-own list`. This must stay in lockstep
    // with the header-path layout (`CodeGenClass.declareStruct`/`fieldIndex`
    // `isFromHeader()` branch) and the archive-emitted `<Id>.init_ctor`, because a
    // class DEFINED here (flat) is CONSUMED elsewhere via its `.fly.h` header — a
    // mismatch corrupts every object crossing the archive boundary. (2026-07-19:
    // a `fly build` heap-corruption hunt showed how easily these two layouts drift;
    // interface-implementing classes additionally rely on the reference/Itanium
    // nested layout — see os_io_test — so any change here must keep BOTH paths and
    // all suites green + a full stage0→2 re-bootstrap passing.)
    void layoutTest() {
        case "single inheritance FLATTENS base fields into the derived struct (one vtable)": {
            string ir = cgIR("
                public class Base { int a
                    int b
                    public Base() { this.a = 1  this.b = 2 }
                }
                public class Derived : Base { int c
                    public Derived() { this.a = 10  this.c = 30 }
                    public int total() { out = this.a + this.b + this.c }
                }
                void main() { Derived d = new Derived()  fail d.total() }
            ")
            // vtable(0) + a(1) + b(2)  — base itself.
            assert.assertTrue(str.contains(ir, "%.Base = type { ptr, i32, i32 }"), 31)
            // vtable(0) + INLINED base a(1),b(2) + own c(3) — one vtable, NO nested
            // %.Base subobject. A regression to a nested/Itanium source layout would
            // make this `{ ptr, %.Base, i32 }` and break the flat header consumers.
            assert.assertTrue(str.contains(ir, "%.Derived = type { ptr, i32, i32, i32 }"), 32)
        }
        case "a derived method reads INHERITED + own fields inline on the derived struct": {
            string ir = cgIR("
                public class Base { int a
                    int b
                    public Base() { this.a = 1  this.b = 2 }
                }
                public class Derived : Base { int c
                    public Derived() { this.a = 10  this.c = 30 }
                    public int total() { out = this.a + this.b + this.c }
                }
                void main() { Derived d = new Derived()  fail d.total() }
            ")
            // total() GEPs the inherited a/b AND own c directly on %.Derived at the
            // flat slots 1/2/3 — no base-subobject indirection. If fieldIndex regressed
            // for inherited fields the slots (or the type GEP'd) would change.
            assert.assertTrue(str.contains(ir, "getelementptr inbounds nuw %.Derived, ptr"), 41)
            assert.assertTrue(str.contains(ir, ", i32 0, i32 1"), 42)   // inherited a @ slot 1
            assert.assertTrue(str.contains(ir, ", i32 0, i32 2"), 43)   // inherited b @ slot 2
            assert.assertTrue(str.contains(ir, ", i32 0, i32 3"), 44)   // own c @ slot 3
        }
    }
}
