namespace fly.compiler.codegen.test.alloc

import fly.compiler.basic.*
import fly.compiler.ast.*
import fly.compiler.parser.*
import fly.compiler.sema.*
import fly.compiler.codegen.*
import fly.data.*
import fly.assert
import fly.os.fs
import fly.str
import fly.test.util.*

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenAllocSuite — who releases a class object at scope exit. From 0.16 a
// plain `new` belongs to the program until `delete`: leaving the scope of its
// local emits no free. A `new unique` owner is released (libc free) at the end
// of its scope.
// ─────────────────────────────────────────────────────────────────────────────

suite CodeGenAllocSuite {

    void scopeExitFreeTest() {
        case "a plain new'd handle is not freed at scope exit": {
            string ir = cgIR("
                public class Box { int v
                    public Box(const int x) { this.v = x }
                    public int get() { return this.v }
                }
                void main() { Box b = new Box(42)
                    int r = b.get()
                    fail r
                }
            ")
            // objects come from the runtime's object heap (fly-lang/fly#235)
            assert.assertTrue(str.contains(ir, "@obj_alloc"), 11)
            // no delete of the Box at scope exit (obj_free itself appears: the error
            // object drop that main emits)
            assert.assertFalse(str.contains(ir, "@__fly_drop..Box"), 12)
        }
        case "a new unique owner is freed via @obj_free at scope exit": {
            string ir = cgIR("
                public class Box { int v
                    public Box(const int x) { this.v = x }
                    public int get() { return this.v }
                }
                void main() { Box b = new unique Box(42)
                    int r = b.get()
                    fail r
                }
            ")
            assert.assertTrue(str.contains(ir, "@obj_alloc"), 13)
            assert.assertTrue(str.contains(ir, "call void @obj_free"), 14)
        }
    }
}
