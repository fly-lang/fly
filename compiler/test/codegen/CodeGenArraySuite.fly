namespace fly.compiler.codegen.test.array

import fly.test.util.*
import fly.str
import fly.mem
import fly.assert

// Array codegen — the `%array = { ptr, i64 }` fat pointer. A literal mallocs the
// data buffer, stores each element by GEP, and assembles the {data,len} struct
// via insertvalue; an empty literal is a zeroinitialised struct; `for x in arr`
// lowers to an index loop over the data buffer. Driven through cgIR (which runs
// Parser → Sema → CodeGen and returns the emitted LLVM IR text); never drive
// codegen from a suite method directly (SIGSEGV) — cgIR is a free function.

// cgaDq — a real double-quote character. The self-host lexer keeps `\"` raw, so a
// Fly source that must CONTAIN a string literal is assembled at runtime. Same
// trick as ParserArraySuite.dq().
string cgaDq() {
    pointer buf = fly.mem.alloc(1)
    byte q = 34
    fly.llvm.strPoke(buf, 0, q)
    string s = ""
    fly.llvm.strMake(buf, 1, s)
    out = s
}

suite CodeGenArraySuite {

    void literalTest() {
        case "int[] literal: malloc + gep + store + insertvalue": {
            string ir = cgIR("void f() { int[] a = {1, 2, 3} }")
            assert.assertTrue(fly.str.contains(ir, "@malloc"), 11)
            assert.assertTrue(fly.str.contains(ir, "getelementptr"), 12)
            assert.assertTrue(fly.str.contains(ir, "store i32"), 13)
            assert.assertTrue(fly.str.contains(ir, "insertvalue"), 14)
        }
        case "%array named struct is defined": {
            string ir = cgIR("void f() { int[] a = {1, 2, 3} }")
            assert.assertTrue(fly.str.contains(ir, "%array"), 15)
        }
    }

    void emptyTest() {
        case "empty int[] a = {} → alloca %array": {
            string ir = cgIR("void f() { int[] a = {} }")
            assert.assertTrue(fly.str.contains(ir, "alloca %array"), 21)
        }
    }

    void forInTest() {
        case "for x in a → index-loop blocks over the data buffer": {
            string ir = cgIR("void f() { int[] a = {1, 2, 3}  for x in a { } }")
            assert.assertTrue(fly.str.contains(ir, "forin.cond"), 31)
            assert.assertTrue(fly.str.contains(ir, "forin.body"), 32)
            assert.assertTrue(fly.str.contains(ir, "getelementptr"), 33)
        }
        // The loop reaches its array through CodeGenArray.slotOf, so the receiver
        // may be ANY expression, not just a variable. genAddr on a call or a
        // literal hands back the %array VALUE, and the loop then used it as a
        // pointer: `getelementptr %array, %array` — the module failed verification
        // (cgIR asserts verifyModule, so these cases go red at the first regression).
        case "for x in <call result> materialises a slot": {
            string ir = cgIR("int[] g() { int[] a = {1, 2}  out = a } void f() { for x in g() { } }")
            assert.assertTrue(fly.str.contains(ir, "arr.tmp"), 41)
            assert.assertTrue(fly.str.contains(ir, "forin.cond"), 42)
        }
        case "for x in <literal> materialises a slot": {
            string ir = cgIR("void f() { for x in {1, 2, 3} { } }")
            assert.assertTrue(fly.str.contains(ir, "arr.tmp"), 43)
            assert.assertTrue(fly.str.contains(ir, "forin.body"), 44)
        }
        // …and a variable receiver must NOT gain a temporary: it already has storage.
        case "for x in <variable> uses the variable's own slot": {
            string ir = cgIR("void f() { int[] a = {1, 2}  for x in a { } }")
            assert.assertFalse(fly.str.contains(ir, "arr.tmp"), 45)
        }
    }

    // ── subscript ─────────────────────────────────────────────────────────────
    void subscriptTest() {
        case "read k[1] emits the bounds check and a load": {
            string ir = cgIR("void f() { int[] k = {5, 6}  int x = k[1] }")
            assert.assertTrue(fly.str.contains(ir, "arr.oob"), 51)
            assert.assertTrue(fly.str.contains(ir, "arr.elem"), 52)
            assert.assertTrue(fly.str.contains(ir, "arr.ld"), 53)
        }
        // The check is TWO-SIDED: only the upper bound would let a negative index
        // read BEFORE the buffer, which is the quieter of the two failures.
        //
        // The index must be a RUNTIME value here. With a literal, `icmp slt i64 1, 0`
        // has two constant operands and the IRBuilder folds it away before it is
        // ever emitted — the lower-bound instruction simply does not appear, and an
        // assertion on its name fails while the compiler is perfectly correct. The
        // upper bound survives either way, because the length is a load.
        case "the bounds check tests both ends": {
            string ir = cgIR("void f() { int[] k = {5, 6}  int i = 1  int x = k[i] }")
            assert.assertTrue(fly.str.contains(ir, "arr.low"), 54)
            assert.assertTrue(fly.str.contains(ir, "arr.high"), 55)
        }
        // A write is range-checked exactly like a read — same helper, same blocks.
        case "write k[0] = 9 is bounds-checked too": {
            string ir = cgIR("void f() { int[] k = {5, 6}  k[0] = 9 }")
            assert.assertTrue(fly.str.contains(ir, "arr.oob"), 56)
            assert.assertTrue(fly.str.contains(ir, "store i32 9"), 57)
        }
        // A nested ROW yields its ADDRESS, never a loaded %array: loading it by
        // value handed the outer subscript a struct where a pointer was required,
        // and `m[1][2]` then read the low half of the row's own len field.
        case "chained m[0][0] verifies and re-indexes the row": {
            string ir = cgIR("void f() { int[][] m = {{1, 2}}  int x = m[0][0] }")
            assert.assertTrue(fly.str.contains(ir, "arr.elem"), 58)
            assert.assertTrue(fly.str.contains(ir, "arr.ld"), 59)
        }
        // An out-of-range access fails with the dedicated code 2989 (0x0BAD).
        case "the failure carries the dedicated code": {
            string ir = cgIR("void f() { int[] k = {5}  int x = k[9] }")
            assert.assertTrue(fly.str.contains(ir, "2989"), 60)
        }
    }

    // A STRUCT element sits INLINE in the buffer, like a struct field in an
    // object — not as a pointer. The generic lowerType sends every class-shaped
    // type to an opaque pointer, which made `Pt[2] ps` a buffer of pointers to
    // nothing while `%Holder = { ptr, %Pt }` laid the same struct inline.
    void structElementTest() {
        // The discriminating fact is the STRIDE of the element GEP: `getelementptr
        // %.Pt` walks the buffer by the struct, whereas pointer storage would walk
        // it by `ptr`. (The type is named `<namespace>.<Class>`, and cgIR's module
        // has no namespace — hence the leading dot.)
        case "a struct array strides by the struct, not by a pointer": {
            string ir = cgIR("struct Pt { int x  int y } void f() { Pt[2] ps  Pt a = ps[0] }")
            assert.assertTrue(fly.str.contains(ir, "getelementptr %.Pt"), 71)
        }
        case "writing through a struct element verifies": {
            // (kept next to the read case: both go through elementLlvmType)
            // Reading one used to hand the copy path an aggregate where a pointer
            // was due; cgIR asserts verifyModule, so a relapse is a red case.
            string ir = cgIR("struct Pt { int x  int y } void f() { Pt[2] ps  Pt a = ps[1]  a.x = 3 }")
            assert.assertTrue(fly.str.contains(ir, "arr.elem"), 72)
        }
    }

    // ── reference counting ────────────────────────────────────────────────────
    // The buffer carries an `[i64 refcount | data]` header and the fat pointer
    // keeps pointing at the DATA, so every reader is unchanged.
    void refcountTest() {
        case "a buffer is allocated with a refcount header set to 1": {
            // `rcbuf.total` is NOT asserted here: with a literal the byte count is
            // constant, so `add i64 8, 8` is folded by the IRBuilder and the named
            // instruction never appears. The data GEP and the count store survive.
            string ir = cgIR("void f() { int[] k = {1, 2} }")
            assert.assertTrue(fly.str.contains(ir, "rcbuf.data"), 81)
            assert.assertTrue(fly.str.contains(ir, "store i64 1"), 82)
        }
        case "a runtime-sized array computes size + header": {
            string ir = cgIR("void f() { int n = 4  int[n] k }")
            assert.assertTrue(fly.str.contains(ir, "rcbuf.total"), 83)
        }
        case "an owned local is released at scope exit": {
            string ir = cgIR("void f() { int[] k = {1, 2} }")
            assert.assertTrue(fly.str.contains(ir, "arel.live"), 84)
            assert.assertTrue(fly.str.contains(ir, "arel.free"), 85)
            // The null guard is mandatory: an empty array has no buffer, and the
            // cleanup walks every registered local.
            assert.assertTrue(fly.str.contains(ir, "arel.null"), 86)
        }
        case "binding another array RETAINS": {
            string ir = cgIR("void f() { int[] k = {1, 2}  int[] j = k }")
            assert.assertTrue(fly.str.contains(ir, "aret.live"), 87)
            assert.assertTrue(fly.str.contains(ir, "aret.rc1"), 88)
        }
        // A literal is born at 1, so binding one must NOT retain — that would
        // strand the buffer at a count nothing ever brings down.
        case "a literal initializer does not retain": {
            string ir = cgIR("void f() { int[] k = {1, 2} }")
            assert.assertFalse(fly.str.contains(ir, "aret.live"), 89)
        }
        // Nor does a CALL result: the callee already retained on the caller's
        // behalf when it ran `out = xs`.
        //
        // The callee here returns a LITERAL rather than a local, on purpose. With
        // `int[] a = {1}  out = a` the callee's own `out = a` retains an lvalue, so
        // `aret.live` appears in the module for THAT reason and the assertion below
        // could never distinguish the two — cgIR returns the whole module, not one
        // function. Returning `{1}` directly leaves the callee retain-free, so any
        // retain in the module would have to come from `int[] r = g()`.
        case "a call result does not retain": {
            string ir = cgIR("int[] g() { out = {1} } void f() { int[] r = g() }")
            assert.assertFalse(fly.str.contains(ir, "aret.live"), 90)
        }
        // NESTED: one buffer and one count per level. The release walks the
        // elements BEFORE freeing the buffer that holds them, and only once the
        // outer count has reached zero — releasing on every scope exit would let a
        // second owner free the inner buffers twice.
        case "a nested array releases every level": {
            string ir = cgIR("void f() { int[][] m = {{1, 2}, {3}} }")
            assert.assertTrue(fly.str.contains(ir, "arel.inner.cond"), 91)
            assert.assertTrue(fly.str.contains(ir, "arel.elem"), 92)
        }
        case "a flat array needs no inner walk": {
            string ir = cgIR("void f() { int[] k = {1, 2} }")
            assert.assertFalse(fly.str.contains(ir, "arel.inner.cond"), 93)
        }
        // A sized array of CLASSES is born full: one instance per index.
        case "a class array preallocates its elements": {
            string ir = cgIR("class C { int v  public C() { this.v = 1 } } void f() { C[3] cs }")
            assert.assertTrue(fly.str.contains(ir, "anew.cond"), 94)
            assert.assertTrue(fly.str.contains(ir, "anew.obj"), 95)
            assert.assertTrue(fly.str.contains(ir, "anew.slot"), 96)
        }
    }

    // A STRING element is a BORROW — the array frees nothing per element — so
    // reading one into an owned slot must CLONE it. Taking it as-is would make the
    // local free a buffer the array still points at. This is already guaranteed by
    // the existing clone-on-store (a SemaArrayAccess never sets ownedStrTemp); the
    // case exists so a future "optimisation" cannot quietly remove it.
    void borrowedElementTest() {
        case "reading a string element clones it": {
            // The source is assembled at runtime: the lexer keeps `\"` RAW, so a
            // quote inside a Fly string literal has to be built (same reason
            // ParserArraySuite has its dq() helper).
            string Q = cgaDq()
            string lit = fly.str.concat(Q, fly.str.concat("ab", Q))
            string src = fly.str.concat("void f() { string[] xs = {", lit)
            src = fly.str.concat(src, "}  string s = xs[0] }")
            string ir = cgIR(src)
            assert.assertTrue(fly.str.contains(ir, "clone."), 97)
        }
        // Writing one does NOT clone: the array must not own the element's buffer,
        // or nothing would ever free it.
        case "writing a string element goes through the element address": {
            string Q = cgaDq()
            string lit = fly.str.concat(Q, fly.str.concat("ab", Q))
            string lit2 = fly.str.concat(Q, fly.str.concat("cd", Q))
            string src = fly.str.concat("void f() { string[] xs = {", lit)
            src = fly.str.concat(src, "}  string s = ")
            src = fly.str.concat(src, lit2)
            src = fly.str.concat(src, "  xs[0] = s }")
            string ir = cgIR(src)
            assert.assertTrue(fly.str.contains(ir, "arr.elem"), 98)
        }
    }
}
