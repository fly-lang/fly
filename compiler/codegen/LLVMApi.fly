        // LLVMBuildStructGEP2(B, Ty, Pointer, Idx, Name) = (ptr, ptr, ptr, int, string)
        Ptr3IntStrArgs a = new Ptr3IntStrArgs()
        a.a = b
        a.b = ty
        a.c = ptr
        a.n = idx
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildStructGEP2", a, v)
    }

    // buildMemCpy — full 6-arg LLVMBuildMemCpy(B, Dst, DstAlign, Src, SrcAlign,
    // Size). (An earlier 3-arg wrapper dropped the aligns + size and was removed;
    // this one marshals every argument.)
    public void buildMemCpy(const pointer b, const pointer dst, const pointer src, const pointer size, pointer v) {
        MemCpyArgs a = new MemCpyArgs()
        a.b = b
        a.dst = dst
        a.dstAlign = 1
        a.src = src
        a.srcAlign = 1
        a.size = size
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildMemCpy", a, v)
    }

