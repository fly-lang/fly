    // NOTE: addIncoming was removed — it silently dropped `count` (LLVMAddIncoming
    // is a 4-arg call; the wrapper passed 3, leaving Count as garbage). Phi is not
    // emitted anywhere (ternary lowers via an alloca slot); re-add with a
    // Ptr3IntArgs-style struct if phi nodes become necessary.

    // ── Build — call ──────────────────────────────────────────────────────────

    public void buildCall2(const pointer b, const pointer fnTy, const pointer fn, const pointer args, const int numArgs, const string name, pointer v) {
        // LLVMBuildCall2(B, FnTy, Fn, Args, NumArgs, Name) — must pass NumArgs and
        // Name (the old Ptr4Args dropped them → garbage arg-count + name).
        Ptr4IntStrArgs a = new Ptr4IntStrArgs()
        a.a = b
        a.b = fnTy
        a.c = fn
        a.d = args
        a.n = numArgs
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildCall2", a, v)
    }

    public void buildUnreachable(const pointer b, pointer v) {
        Ptr1Args a = new Ptr1Args()
        a.a = b
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildUnreachable", a, v)
    }

    // ── Constants ─────────────────────────────────────────────────────────────

    public void constInt(const pointer intTy, const long val, const bool signExtend, pointer v) {
        // LLVMConstInt(IntTy, N, SignExtend) = (ptr, long, int)
        PtrLongIntArgs a = new PtrLongIntArgs()
        a.a = intTy
        a.n = val
        a.p = 0
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstInt", a, v)
    }

    public void constReal(const pointer realTy, const double val, pointer v) {
        // LLVMConstReal(RealTy, N) = (ptr, double)
        PtrDoubleArgs a = new PtrDoubleArgs()
        a.a = realTy
        a.d = val
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstReal", a, v)
    }

    public void constNull(const pointer ty, pointer v) {
        Ptr1Args a = new Ptr1Args()
        a.a = ty
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstNull", a, v)
    }

    public void constPointerNull(const pointer ty, pointer v) {
        Ptr1Args a = new Ptr1Args()
        a.a = ty
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstPointerNull", a, v)
    }

    public void constStringInContext(const pointer ctx, const string str, const int length, const bool nullTerminated, pointer v) {
        // LLVMConstStringInContext(Ctx, Str, Length, DontNullTerminate). Length is
        // explicit (Fly strings aren't null-terminated C strings); DontNull=0 ADDS a
        // terminator. The old 1-int variant dropped Length → empty [0 x i8].
        PtrStrIntIntArgs a = new PtrStrIntIntArgs()
        a.a = ctx
        a.s = str
        a.n = length
        if nullTerminated { a.m = 0 } else { a.m = 1 }
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstStringInContext", a, v)
    }

    public void constStructInContext(const pointer ctx, const pointer vals, const int numVals, const bool packed, pointer v) {
        PtrPtrIntArgs a = new PtrPtrIntArgs()
        a.a = ctx
        a.b = vals
        a.n = numVals
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstStructInContext", a, v)
    }

    public void constArray(const pointer elemTy, const pointer vals, const int numVals, pointer v) {
        PtrPtrIntArgs a = new PtrPtrIntArgs()
        a.a = elemTy
        a.b = vals
        a.n = numVals
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstArray", a, v)
    }

    // constNamedStruct — LLVMConstNamedStruct(StructTy, ConstantVals, Count): a
    // constant of a NAMED struct type (unlike LLVMConstStruct which makes an
    // anonymous literal-struct constant that wouldn't match a %name alloca).
    public void constNamedStruct(const pointer structTy, const pointer vals, const int numVals, pointer v) {
        PtrPtrIntArgs a = new PtrPtrIntArgs()
        a.a = structTy
        a.b = vals
        a.n = numVals
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMConstNamedStruct", a, v)
    }

    // ── Global variables ──────────────────────────────────────────────────────

    public void addGlobal(const pointer mod, const pointer ty, const string name, pointer v) {
        // LLVMAddGlobal(M, Ty, Name) = (ptr, ptr, string)
        Ptr2StrArgs a = new Ptr2StrArgs()
        a.a = mod
        a.b = ty
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMAddGlobal", a, v)
    }

    public void getNamedGlobal(const pointer mod, const string name, pointer v) {
        PtrStrArgs a = new PtrStrArgs()
        a.a = mod
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMGetNamedGlobal", a, v)
    }

    public void setInitializer(const pointer global, const pointer val) {
        Ptr2Args a = new Ptr2Args()
        a.a = global
        a.b = val
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMSetInitializer", a)
    }

    public void setGlobalConstant(const pointer global, const bool isConst) {
        PtrIntArgs a = new PtrIntArgs()
        a.a = global
        if isConst { a.n = 1 } else { a.n = 0 }
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMSetGlobalConstant", a)
    }

    // ── Target machine ────────────────────────────────────────────────────────

    public void getDefaultTargetTriple(pointer triple) {
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMGetDefaultTargetTriple", new NoArgs(), triple)
    }

    // getTargetFromTriple — look up the LLVMTargetRef for `triple`. The C function
    // writes the target through a `LLVMTargetRef*` out-pointer and returns a status
    // (0 = success). We give it an 8-byte buffer (via the Ptr-buffer idiom) for the
    // out-pointer, then copy the written value into `target`. `ok` carries the
    // raw LLVMBool return (true = FAILURE); callers should test `target != 0`.
    public void getTargetFromTriple(const string triple, pointer target, bool ok) {
        pointer buf = fly.mem.alloc(8)
        fly.mem.writePtr(buf, 0, 0)
        Ptr3Args a = new Ptr3Args()
        a.a = cbuf(triple)   // const char* Triple (NUL-terminated)
        a.b = buf            // LLVMTargetRef* T  (out-pointer buffer)
        // a.c stays null → char** Err = NULL
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMGetTargetFromTriple", a, ok)
        target = fly.mem.readPtr(buf, 0)
        fly.mem.free(buf, 8)
    }

    // createTargetMachine — full 7-argument marshalling (the old stub dropped all
    // but `target`). The TM pointer is the C return value, captured into `tm`.
    public void createTargetMachine(const pointer target, const string triple, const string cpu, const string features, const int optLevel, const int reloc, const int codeModel, pointer tm) {
        CreateTMArgs a = new CreateTMArgs()
        a.target = target
        a.triple = cbuf(triple)
        a.cpu = cbuf(cpu)
        a.features = cbuf(features)
        a.level = optLevel
        a.reloc = reloc
        a.codeModel = codeModel
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMCreateTargetMachine", a, tm)
    }

    public void disposeTargetMachine(const pointer tm) {
        Ptr1Args a = new Ptr1Args()
        a.a = tm
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMDisposeTargetMachine", a)
    }

    public void createTargetDataLayout(const pointer tm, pointer dl) {
        Ptr1Args a = new Ptr1Args()
        a.a = tm
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMCreateTargetDataLayout", a, dl)
    }

    public void setModuleDataLayout(const pointer mod, const pointer dl) {
        Ptr2Args a = new Ptr2Args()
        a.a = mod
        a.b = dl
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMSetModuleDataLayout", a)
    }

    // targetMachineEmitToFile — emit `mod` to `filename` (emitType 0=assembly,
    // 1=object). The old stub dropped `filename`; this passes all four args plus a
    // null `char** ErrorMessage`. `ok` is the raw LLVMBool return (true = FAILURE).
    public void targetMachineEmitToFile(const pointer tm, const pointer mod, const string filename, const int emitType, bool ok) {
        EmitFileArgs a = new EmitFileArgs()
        a.tm = tm
        a.mod = mod
        a.filename = cbuf(filename)
        a.emitType = emitType
        a.err = 0
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMTargetMachineEmitToFile", a, ok)
    }

