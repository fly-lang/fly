    // ── Functions ─────────────────────────────────────────────────────────────

    public void addFunction(const pointer mod, const string name, const pointer fnTy, pointer fn) {
        PtrStrPtrArgs a = new PtrStrPtrArgs()
        a.a = mod
        a.s = name
        a.b = fnTy
