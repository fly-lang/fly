    // ── Module ────────────────────────────────────────────────────────────────

    public void moduleCreateWithNameInContext(const string name, const pointer ctx, pointer mod) {
        StrPtrArgs a = new StrPtrArgs()
        a.s = name
        a.a = ctx
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMModuleCreateWithNameInContext", a, mod)
    }

    public void disposeModule(const pointer mod) {
        Ptr1Args a = new Ptr1Args()
        a.a = mod
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMDisposeModule", a)
    }

    public void setDataLayout(const pointer mod, const string layout) {
        Ptr2Args a = new Ptr2Args()
        a.a = mod
        a.b = cbuf(layout)
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMSetDataLayout", a)
    }

    public void setTarget(const pointer mod, const string triple) {
        Ptr2Args a = new Ptr2Args()
        a.a = mod
        a.b = cbuf(triple)
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMSetTarget", a)
    }

    public void printModuleToFile(const pointer mod, const string filename) {
        // LLVMPrintModuleToFile(M, Filename, char **ErrorMessage). Filename must be a
        // NUL-terminated C string (cbuf), and ErrorMessage must be a real pointer —
        // pass NULL. Omitting it leaves a garbage register that LLVM writes through on
        // the error path → SIGSEGV. Mirrors verifyModule's null-out-param pattern.
        Ptr3Args a = new Ptr3Args()
        a.a = mod
        a.b = cbuf(filename)
        a.c = 0
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMPrintModuleToFile", a)
    }

    // printModuleToFileChecked — like printModuleToFile, but surfaces the LLVMBool
    // result (true = FAILURE → ok=false). ErrorMessage gets a REAL char** buffer:
    // LLVM writes through it on the error path, so NULL would segfault exactly
    // when we want to report the failure.
    public void printModuleToFileChecked(const pointer mod, const string filename, bool ok) {
        pointer buf = fly.mem.alloc(8)
        fly.mem.writePtr(buf, 0, 0)
        Ptr3Args a = new Ptr3Args()
        a.a = mod
        a.b = cbuf(filename)
        a.c = buf
        CLang lib = new CLang("libLLVM-20.so")
        bool failed = false
        lib.call("LLVMPrintModuleToFile", a, failed)
        pointer mp = fly.mem.readPtr(buf, 0)
        if mp != 0 { this.disposeMessage(mp) }
        fly.mem.free(buf, 8)
        if failed { ok = false } else { ok = true }
    }

    public void writeBitcodeToFile(const pointer mod, const string path) {
        PtrStrArgs a = new PtrStrArgs()
        a.a = mod
        a.s = path
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMWriteBitcodeToFile", a)
    }

    public void verifyModule(const pointer mod, bool ok) {
        // LLVMVerifyModule(M, LLVMReturnStatusAction=2, NULL) returns 1=broken, 0=valid.
        // Negate to get the "is valid" semantics expected by callers.
        PtrIntPtrArgs vargs = new PtrIntPtrArgs()
        vargs.a = mod
        vargs.n = 2
        vargs.b = 0
        CLang lib = new CLang("libLLVM-20.so")
        bool broken = false
        lib.call("LLVMVerifyModule", vargs, broken)
        if broken == false { ok = true } else { ok = false }
    }

    // verifyModuleMsg — like verifyModule, but also RETURNS LLVM's failure reason
    // ("" when the module is valid). Passes a real char** out-buffer (Ptr-buffer
    // idiom, like getTargetFromTriple), reads the heap C string back to the NUL
    // and disposes it. The reason travels via the return value, not a string
    // out-param (param writes skip the clone-on-store path → double free).
    public string verifyModuleMsg(const pointer mod, bool ok) {
        pointer buf = fly.mem.alloc(8)
        fly.mem.writePtr(buf, 0, 0)
        PtrIntPtrArgs vargs = new PtrIntPtrArgs()
        vargs.a = mod
        vargs.n = 2
        vargs.b = buf
        CLang lib = new CLang("libLLVM-20.so")
        bool broken = false
        lib.call("LLVMVerifyModule", vargs, broken)
        pointer mp = fly.mem.readPtr(buf, 0)
        fly.mem.free(buf, 8)
        if broken == false { ok = true } else { ok = false }
        out = ""
        if mp != 0 {
            byte zero = 0
            int len = 0
            byte c = fly.mem.readByte(mp, len)
            while c != zero {
                len = len + 1
                c = fly.mem.readByte(mp, len)
            }
            string s = ""
            fly.str.fromBytes(mp, len, s)
            this.disposeMessage(mp)
            out = s
        }
    }

