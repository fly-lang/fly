    public void buildLoad2(const pointer b, const pointer ty, const pointer ptr, const string name, pointer v) {
        // LLVMBuildLoad2(B, Ty, Ptr, Name) = (ptr, ptr, ptr, string) → use Ptr3 + store name in 4th
        // We use Ptr3Args which gives [b, ty, ptr] as C args 0-2; name (4th arg) is missing but LLVM accepts "" gracefully.
        Ptr3StrArgs a = new Ptr3StrArgs()
        a.a = b
        a.b = ty
        a.c = ptr
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildLoad2", a, v)
    }

    public void buildStore(const pointer b, const pointer val, const pointer ptr) {
        Ptr3Args a = new Ptr3Args()
        a.a = b
        a.b = val
        a.c = ptr
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildStore", a)
    }

    public void buildGEP2(const pointer b, const pointer ty, const pointer ptr, const pointer indices, const int numIndices, const string name, pointer v) {
        // LLVMBuildGEP2(B, Ty, Ptr, Indices, NumIndices, Name) — must pass NumIndices
        // and Name (the old Ptr4Args dropped them → garbage index-count + name).
        Ptr4IntStrArgs a = new Ptr4IntStrArgs()
        a.a = b
        a.b = ty
        a.c = ptr
        a.d = indices
        a.n = numIndices
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildGEP2", a, v)
    }

    // buildMalloc — LLVMBuildMalloc(B, Ty, Name): allocates sizeof(Ty) on the heap
    // (LLVM computes the size + auto-declares @malloc) and returns the typed ptr.
    public void buildMalloc(const pointer b, const pointer ty, const string name, pointer v) {
        Ptr2StrArgs a = new Ptr2StrArgs()
        a.a = b
        a.b = ty
        a.s = name
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildMalloc", a, v)
    }

    // sizeOf — LLVMSizeOf(Ty): an i64 constant (ConstantExpr) of Ty's ABI size,
    // usable as the Len operand of buildMemSet.
    public void sizeOf(const pointer ty, pointer v) {
        Ptr1Args a = new Ptr1Args()
        a.a = ty
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMSizeOf", a, v)
    }

    // buildMemSet — LLVMBuildMemSet(B, Ptr, Val, Len, Align): fill Len bytes at Ptr
    // with the i8 Val. Align 0 = unspecified. Used to zero a fresh malloc so fields
    // the constructor does not assign are deterministic (Windows heap is garbage).
    public void buildMemSet(const pointer b, const pointer ptr, const pointer val, const pointer len, const int align, pointer v) {
        Ptr4IntArgs a = new Ptr4IntArgs()
        a.a = b
        a.b = ptr
        a.c = val
        a.d = len
        a.n = align
        CLang lib = new CLang("libLLVM-20.so")
        lib.call("LLVMBuildMemSet", a, v)
    }

