namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.ast.*
import fly.compiler.codegen.CodeGenModule
import fly.compiler.codegen.CodeGenLLVM
import fly.compiler.codegen.CodeGenType
import fly.compiler.codegen.CodeGenExprOps
import fly.compiler.codegen.CodeGenStmt
import fly.compiler.codegen.CodeGenCall
import fly.compiler.codegen.CodeGenClass
import fly.compiler.codegen.CodeGenError
import llvm.api.*
import fly.mem
import fly.data.List
import fly.str

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenExpr — the SemaVisitor that lowers a function body. It implements the
// whole SemaVisitor (statements + expressions); Stage 2 fills in expressions and
// the minimal statement scaffolding (block / expr-stmt / return) needed to observe
// them, leaving control-flow statements stubbed for Stage 3.
//
// Each expr visit stores its LLVM value on the node (SemaExpr.llvmValue); gen()
// reads it back. addrMode flips a variable visit between LOAD (rvalue) and its
// storage address (lvalue, for an assignment LHS). It holds the CodeGenModule
// one-directionally (no stored back-reference from CodeGenModule → no cycle).
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenExpr : SemaVisitor {

    CodeGenModule cgm
    LLVM llvm
    pointer builder
    bool addrMode
    bool terminated            // current block already has a terminator?
    pointer breakTarget    // innermost loop/switch exit block
    pointer continueTarget // innermost loop post block
    pointer errPtr         // current function's error-handler pointer (LLVM param 0)
    string lastStrLit      // text of the last string LITERAL gen'd (bridge symbol capture)

    public CodeGenExpr(const CodeGenModule cgm) {
        this.cgm = cgm
        CodeGenLLVM c = cgm.getCg()
        this.llvm = c.getLLVM()
        this.builder = cgm.getBuilder()
        this.addrMode = false
        this.terminated = false
        this.breakTarget = 0
        this.continueTarget = 0
        this.errPtr = 0
        this.lastStrLit = ""
    }
    // getLastStrLit — the compile-time text of the most recently gen'd string
    // literal: lets the CLang bridge read `call("strlen", …)`'s symbol without a
    // SemaStringValue downcast (none exists) or a new base virtual (vtable-shift).
    public string getLastStrLit() { out = this.lastStrLit }
    public pointer getErrPtr() { out = this.errPtr }
    public void setErrPtr(const pointer p) { this.errPtr = p }

    public CodeGenModule getCgm() { out = this.cgm }
    public LLVM getLLVM() { out = this.llvm }
    public pointer getBuilder() { out = this.builder }
    public bool isAddrMode() { out = this.addrMode }

    // ── basic-block / control-flow helpers ────────────────────────────────────
    public bool isTerminated() { out = this.terminated }
    public void setTerminated(const bool t) { this.terminated = t }
    public pointer getBreakTarget() { out = this.breakTarget }
    public void setBreakTarget(const pointer b) { this.breakTarget = b }
    public pointer getContinueTarget() { out = this.continueTarget }
    public void setContinueTarget(const pointer b) { this.continueTarget = b }

    // position the builder at the end of a block and clear the terminated flag.
    public void position(const pointer bb) {
        this.llvm.positionBuilderAtEnd(this.builder, bb)
        this.terminated = false
    }

    // newBlock — append a fresh basic block to the current function.
    public pointer newBlock(const string name) {
        pointer cur
        this.llvm.getInsertBlock(this.builder, cur)
        pointer fn
        this.llvm.getBasicBlockParent(cur, fn)
        pointer bb
        this.llvm.appendBasicBlockInContext(this.cgm.getCtx(), fn, name, bb)
        out = bb
    }

    // br — branch to dest if the current block isn't already terminated.
    public void br(const pointer dest) {
        if this.terminated == false {
            pointer v
            this.llvm.buildBr(this.builder, dest, v)
            this.terminated = true
        }
    }

    // type helpers (avoid chaining cgm.getTypes().lowerType(...) on a call result)
    public pointer lowerType(const SemaType t) {
        CodeGenType ct = this.cgm.getTypes()
        out = ct.lowerType(t)
    }
    public pointer ptrType() {
        CodeGenType ct = this.cgm.getTypes()
        out = ct.ptrType()
    }

    // ── numeric coercion (shared by decl/assign/arith/compare/args/ternary) ────
    // The resolver computes promoted RESULT types but never inserts operand casts,
    // so every consumer of a gen'd value must bring it to the expected numeric
    // type itself. These three helpers centralise that (mirrors the reference's
    // CodeGenExpr::ConvertNumber).

    // numWidth — lowered bit width for a numeric rank. Ranks encode width AND
    // signedness (odd = signed of the next even width: short 15→i16, int 31→i32,
    // long 63→i64), so rank comparison alone would emit same-width sext/trunc.
    public int numWidth(const SemaType t) {
        int w = t.getRank()
        if w % 2 == 1 { w = w + 1 }
        out = w
    }

    // isUnsignedInt — integer with an even rank (byte/ushort/uint/ulong/pointer).
    public bool isUnsignedInt(const SemaType t) {
        bool r = false
        if t != null {
            if t.isInteger() {
                if t.getRank() % 2 == 0 { r = true }
            }
        }
        out = r
    }

    // coerce — bring `val` (typed `from`) to numeric type `to`: zext/sext/trunc
    // for integer width changes (extension follows the SOURCE signedness),
    // si/uitofp for int→float, fpext/fptrunc for float widths, fptosi for
    // float→int. Anything non-numeric (or already the right width) is unchanged.
    public pointer coerce(const pointer val, const SemaType from, const SemaType to) {
        pointer r = val
        if val == 0 { out = r  return }
        if from == null { out = r  return }
        if to == null { out = r  return }
        if from.isNumber() == false { out = r  return }
        if to.isNumber() == false { out = r  return }
        bool ff = from.isFloat()
        bool tf = to.isFloat()
        pointer destTy = this.lowerType(to)
        if ff {
            if tf {
                if to.getRank() > from.getRank() {
                    this.llvm.buildFPExt(this.builder, val, destTy, "cofpx", r)
                } elsif to.getRank() < from.getRank() {
                    this.llvm.buildFPTrunc(this.builder, val, destTy, "cofpt", r)
                }
            } else {
                this.llvm.buildFPToSI(this.builder, val, destTy, "cofsi", r)
            }
        } else {
            if tf {
                if this.isUnsignedInt(from) {
                    this.llvm.buildUIToFP(this.builder, val, destTy, "couif", r)
                } else {
                    this.llvm.buildSIToFP(this.builder, val, destTy, "cosif", r)
                }
            } else {
                int fw = this.numWidth(from)
                int tw = this.numWidth(to)
                if tw > fw {
                    if this.isUnsignedInt(from) {
                        this.llvm.buildZExt(this.builder, val, destTy, "cozx", r)
                    } else {
                        this.llvm.buildSExt(this.builder, val, destTy, "cosx", r)
                    }
                } elsif tw < fw {
                    this.llvm.buildTrunc(this.builder, val, destTy, "cotr", r)
                }
            }
        }
        out = r
    }

    // gen — codegen an expression as an rvalue, returning its LLVM value.
    public pointer gen(const SemaExpr e) {
        this.addrMode = false
        e.accept(this)
        out = e.getLlvmValue()
    }

    // genAddr — codegen an expression as an lvalue, returning its storage address.
    public pointer genAddr(const SemaExpr e) {
        this.addrMode = true
        e.accept(this)
        this.addrMode = false
        out = e.getLlvmValue()
    }

    // ── statements (minimal for Stage 2) ──────────────────────────────────────
    public void visit(const SemaBlockStmt node) {
        List<SemaStmt> content = node.getContent()
        int i = 0
        while i < content.size() {
            SemaStmt s = content.get(i)
            s.accept(this)
            i = i + 1
        }
        // Stage 7: on fall-through, free this scope's owned heap class handles. (A
        // terminating return inside the block skips this — early-return cleanup is a
        // follow-up; the milestone programs fall through.)
        if this.terminated == false {
            List<SemaLocalVar> allocs = node.getAllocs()
            int j = 0
            while j < allocs.size() {
                SemaLocalVar v = allocs.get(j)
                pointer alloca = v.getLlvmAlloca()
                pointer ty = this.lowerType(v.getType())
                pointer objPtr
                this.llvm.buildLoad2(this.builder, ty, alloca, "freeld", objPtr)
                this.cgm.freeHandle(objPtr)
                j = j + 1
            }
        }
    }
    public void visit(const SemaExprStmt node) {
        SemaExpr e = node.getExpr()
        if e != null { e.accept(this) }
    }
    public void visit(const SemaReturnStmt node) { CodeGenStmt.ret(this, node) }
    public void visit(const SemaDeclStmt node) { CodeGenStmt.decl(this, node) }
    public void visit(const SemaIfStmt node) { CodeGenStmt.ifStmt(this, node) }
    public void visit(const SemaLoopStmt node) { CodeGenStmt.loopStmt(this, node) }
    public void visit(const SemaSwitchStmt node) { CodeGenStmt.switchStmt(this, node) }
    public void visit(const SemaBreakStmt node) { CodeGenStmt.breakStmt(this, node) }
    public void visit(const SemaContinueStmt node) { CodeGenStmt.continueStmt(this, node) }

    // ── value expressions ─────────────────────────────────────────────────────
    public void visit(const SemaIntValue node) {
        pointer ty = this.lowerType(node.getType())
        long v = parseLong(node.getValue())
        pointer c
        this.llvm.constInt(ty, v, true, c)
        node.setLlvmValue(c)
    }
    public void visit(const SemaBoolValue node) {
        pointer ty = this.lowerType(node.getType())
        long v = 0
        if node.getValue() { v = 1 }
        pointer c
        this.llvm.constInt(ty, v, false, c)
        node.setLlvmValue(c)
    }
    public void visit(const SemaFloatValue node) {
        pointer ty = this.lowerType(node.getType())
        double d = parseDouble(node.getValue())
        pointer c
        this.llvm.constReal(ty, d, c)
        node.setLlvmValue(c)
    }
    public void visit(const SemaNullValue node) {
        pointer ty = this.ptrType()
        pointer c
        this.llvm.constPointerNull(ty, c)
        node.setLlvmValue(c)
    }

    // ── variable references (load rvalue, or address in addrMode) ──────────────
    public void visit(const SemaParam node) { this.genVarAccess(node) }
    public void visit(const SemaLocalVar node) { this.genVarAccess(node) }
    public void visit(const SemaClassInstance node) { this.genVarAccess(node) }
    public void visit(const SemaClassAttribute node) { this.genVarAccess(node) }
    public void visit(const SemaError node) { this.genVarAccess(node) }

    public void genVarAccess(const SemaVar v) {
        pointer addr = v.getLlvmAlloca()
        if this.addrMode {
            v.setLlvmValue(addr)
        } else {
            pointer ty = this.lowerType(v.getType())
            pointer loaded
            this.llvm.buildLoad2(this.builder, ty, addr, "ld", loaded)
            v.setLlvmValue(loaded)
        }
    }

    // ── binary ────────────────────────────────────────────────────────────────
    public void visit(const SemaBinary node) {
        ASTBinary ba = node.getAST()
        ASTBinaryKind k = ba.getBinaryKind()
        if k == ASTBinaryKind.OP_BINARY_ASSIGN {
            CodeGenExprOps.assign(this, node)
        } elsif ba.isArith() {
            CodeGenExprOps.arith(this, node, k)
        } else {
            CodeGenExprOps.compare(this, node, k)
        }
    }

    public void visit(const SemaUnary node) { CodeGenExprOps.unary(this, node) }
    public void visit(const SemaCast node) { CodeGenExprOps.cast(this, node) }
    public void visit(const SemaTernary node) { CodeGenExprOps.ternary(this, node) }

    // ── calls + member access ─────────────────────────────────────────────────
    public void visit(const SemaCall node) {
        if node.isNew() {
            CodeGenClass.genNew(this, node)
        } elsif node.getParent() != null {
            CodeGenClass.methodCall(this, node)
        } else {
            CodeGenCall.call(this, node)
        }
    }
    public void visit(const SemaMember node) { CodeGenClass.member(this, node) }

    // ── enums (each entry is its integer index, lowered to i32) ───────────────
    public void visit(const SemaEnumEntry node) {
        pointer ty = this.lowerType(node.getType())
        long idx = node.getIndex()
        pointer c
        this.llvm.constInt(ty, idx, true, c)
        node.setLlvmValue(c)
    }
    // enum property access — mirrors the reference's GenExpr(SemaEnumAccessor):
    //   .value on a literal entry  → constant i32 index
    //   .value on a variable/chain → the receiver's loaded i32 (the enum IS its value)
    //   .name  on a literal entry  → constant %string
    //   .name  on a variable/chain → load from the enum's names table by value
    public void visit(const SemaEnumAccessor node) {
        SemaEnumEntry e = node.getEntry()
        CodeGenLLVM cg = this.cgm.getCg()

        if node.isName() == false {
            if e != null {
                pointer ty = this.lowerType(node.getType())
                pointer c
                this.llvm.constInt(ty, e.getIndex(), true, c)
                node.setLlvmValue(c)
            } else {
                pointer rv = this.gen(node.getParent())
                node.setLlvmValue(rv)
            }
            return
        }

        pointer strTy = this.cgm.getStringTy()
        pointer i32n
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32n)
        if e != null {
            string nm = e.getName()
            pointer g = cg.globalString(this.cgm.getModule(), this.cgm.getCtx(), nm)
            pointer lenC
            this.llvm.constInt(i32n, fly.str.len(nm), false, lenC)
            List<pointer> fields = new List<pointer>()
            fields.add(g)
            fields.add(lenC)
            pointer sv
            cg.constNamedStructN(strTy, fields, sv)
            node.setLlvmValue(sv)
            return
        }

        // runtime name: GEP into the per-enum names table by the loaded value
        pointer idx = this.gen(node.getParent())
        SemaEnumType en = node.getEnumType()
        pointer table = this.cgm.enumNamesTable(en)
        List<SemaNode> ens = en.getNodes()
        int n = (int)ens.size()
        pointer arrTy
        this.llvm.arrayType(strTy, n + 1, arrTy)
        pointer i32t
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32t)
        pointer zero
        this.llvm.constInt(i32t, 0, false, zero)
        List<pointer> idxs = new List<pointer>()
        idxs.add(zero)
        idxs.add(idx)
        pointer slot
        cg.buildGEP2N(this.builder, arrTy, table, idxs, "enname", slot)
        pointer loaded
        this.llvm.buildLoad2(this.builder, strTy, slot, "ennm", loaded)
        node.setLlvmValue(loaded)
    }

    // ── error handling ────────────────────────────────────────────────────────
    public void visit(const SemaFailStmt node) { CodeGenError.emitFail(this, node) }
    public void visit(const SemaHandleStmt node) { CodeGenError.emitHandle(this, node) }

    // ── stubbed (later stages) ────────────────────────────────────────────────
    public void visit(const SemaEnumList node) { }

    // string literal → a private `[N x i8]` global + a constant %string { ptr, len }.
    public void visit(const SemaStringValue node) {
        string val = node.getValue()
        this.lastStrLit = val
        int len = fly.str.len(val)
        CodeGenLLVM cg = this.cgm.getCg()
        pointer g = cg.globalString(this.cgm.getModule(), this.cgm.getCtx(), val)
        pointer i32len
        this.llvm.int32TypeInContext(this.cgm.getCtx(), i32len)
        pointer lenC
        this.llvm.constInt(i32len, len, false, lenC)
        List<pointer> fields = new List<pointer>()
        fields.add(g)
        fields.add(lenC)
        pointer strTy = this.cgm.getStringTy()
        pointer sv
        cg.constNamedStructN(strTy, fields, sv)
        node.setLlvmValue(sv)
    }
    public void visit(const SemaComplexValue node) { }
    public void visit(const SemaArrayValue node) { }
    public void visit(const SemaStructValue node) { }
    // unset — lower to a typed zero. The empty visit left llvmValue = 0, and a
    // null handle reaching buildStore/buildRet crashes inside libLLVM.
    public void visit(const SemaUnsetValue node) {
        SemaType t = node.getType()
        pointer c = 0
        if t != null {
            if t.isFloat() {
                pointer fty = this.lowerType(t)
                this.llvm.constReal(fty, 0.0, c)
            } elsif t.isNumber() || t.isBool() || t.isEnum() {
                pointer ity = this.lowerType(t)
                this.llvm.constInt(ity, 0, false, c)
            } else {
                pointer pty = this.ptrType()
                this.llvm.constPointerNull(pty, c)
            }
        } else {
            pointer pty2 = this.ptrType()
            this.llvm.constPointerNull(pty2, c)
        }
        node.setLlvmValue(c)
    }
    public void visit(const SemaLoopInStmt node) { }
    public void visit(const SemaDeleteStmt node) { }
    public void visit(const SemaCaseStmt node) { }
    public void visit(const SemaTestStmt node) { }
}

// ── literal parsing helpers (free functions; intrinsic byte access) ─────────────
public long parseLong(const string s) {
    long r = 0
    int n = fly.str.len(s)
    int i = 0
    bool neg = false
    if n > 0 {
        byte b0 = 0
        fly.str.byteAt(s, 0, b0)
        if b0 == 45 { neg = true  i = 1 }   // '-'
    }
    while i < n {
        byte b = 0
        fly.str.byteAt(s, i, b)
        int bi = b
        if bi >= 48 {
            if bi <= 57 {
                long d = bi - 48
                r = r * 10 + d
            }
        }
        i = i + 1
    }
    if neg { r = 0 - r }
    out = r
}

public double parseDouble(const string s) {
    // integer + fractional parts split on '.'; minimal (no exponent) for Stage 2.
    int dot = fly.str.indexOf(s, ".")
    double result = 0.0
    if dot < 0 {
        result = parseLong(s)
    } else {
        string ip = fly.str.substring(s, 0, dot)
        int n = fly.str.len(s)
        string fp = fly.str.substring(s, dot + 1, n)
        double whole = parseLong(ip)
        double frac = 0.0
        double scale = 1.0
        int fn = fly.str.len(fp)
        int i = 0
        while i < fn {
            byte b = 0
            fly.str.byteAt(fp, i, b)
            int bi = b
            double d = bi - 48
            scale = scale * 10.0
            frac = frac + d / scale
            i = i + 1
        }
        result = whole + frac
    }
    out = result
}
