namespace fly.compiler.codegen

import fly.compiler.sema.*
import fly.compiler.codegen.CodeGenExpr
import fly.compiler.codegen.CodeGenModule
import llvm.api.*
import fly.data.List
import fly.str
import fly.os.io

// ─────────────────────────────────────────────────────────────────────────────
// CodeGenIntrinsics — `fly.llvm.*` calls in USER programs lower to inline IR
// (audit V4 fase 2; the reference does this in CodeGenStdLibLLVM). These
// functions have NO archive symbols — without interception the call would
// resolve in sema and then fail at link. Convention: no error param, results
// travel through the trailing non-const OUT parameter (its storage address).
// Subset: the string/pointer accessors the std tests exercise; anything else
// reports an honest per-name error instead of a cryptic undefined symbol.
// ─────────────────────────────────────────────────────────────────────────────

public class CodeGenIntrinsics {

    public CodeGenIntrinsics() { }

    // genLLVM — lower one fly.llvm call; the node's value stays unset (they are
    // statement-style, void calls writing through their out param).
    public static void genLLVM(const CodeGenExpr cge, const SemaCall node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        SemaFunctionBase fn = node.getFunction()
        string bn = fn.getName()
        List<SemaExpr> args = node.getArgs()

        if fly.str.equals(bn, "strSize") {
            pointer sv = cge.gen(args.get(0))
            pointer ev
            llvm.buildExtractValue(b, sv, 1, "ssz", ev)
            CodeGenIntrinsics.storeIntOut(cge, ev, 32, args.get(1))
            return
        }
        if fly.str.equals(bn, "strGetPtr") {
            pointer sv = cge.gen(args.get(0))
            pointer pv
            llvm.buildExtractValue(b, sv, 0, "sptr", pv)
            pointer i64t
            llvm.int64TypeInContext(cge.getCgm().getCtx(), i64t)
            pointer iv
            llvm.buildPtrToInt(b, pv, i64t, "p2i", iv)
            CodeGenIntrinsics.storeIntOut(cge, iv, 64, args.get(1))
            return
        }
        if fly.str.equals(bn, "strByteAt") {
            pointer sv = cge.gen(args.get(0))
            pointer sp
            llvm.buildExtractValue(b, sv, 0, "sptr", sp)
            SemaExpr idxE = args.get(1)
            pointer idx = cge.gen(idxE)
            pointer widx = CodeGenIntrinsics.extendToI64(cge, idx, idxE.getType())
            pointer i8t
            llvm.int8TypeInContext(cge.getCgm().getCtx(), i8t)
            List<pointer> gidx = new List<pointer>()
            gidx.add(widx)
            CodeGenModule cgm = cge.getCgm()
            CodeGenLLVM cg = cgm.getCg()
            pointer bp
            cg.buildGEP2N(b, i8t, sp, gidx, "bptr", bp)
            pointer bv
            llvm.buildLoad2(b, i8t, bp, "bval", bv)
            CodeGenIntrinsics.storeIntOut(cge, bv, 8, args.get(2))
            return
        }
        if fly.str.equals(bn, "strMake") {
            // build a %string {ptr, i32} from (pointer, size) and store it whole
            // (the size arg is already int/i32 — the field width, reference ABI)
            CodeGenModule cgm2 = cge.getCgm()
            pointer pval = cge.gen(args.get(0))
            pointer ptrTy = cge.ptrType()
            pointer rp
            llvm.buildIntToPtr(b, pval, ptrTy, "i2p", rp)
            pointer szv = cge.gen(args.get(1))
            pointer strTy = cgm2.getStringTy()
            pointer slot
            llvm.buildAlloca(b, strTy, "smk", slot)
            pointer f0
            llvm.buildStructGEP2(b, strTy, slot, 0, "smp", f0)
            llvm.buildStore(b, rp, f0)
            pointer f1
            llvm.buildStructGEP2(b, strTy, slot, 1, "sms", f1)
            llvm.buildStore(b, szv, f1)
            pointer sval
            llvm.buildLoad2(b, strTy, slot, "smv", sval)
            SemaExpr outE = args.get(2)
            pointer addr = cge.genAddr(outE)
            llvm.buildStore(b, sval, addr)
            return
        }

        if fly.str.equals(bn, "memset") {
            // memset(const pointer dst, const byte val, const ulong n) — value
            // and length MUST be coerced to the param types (a literal 0 arrives
            // as i32 and llvm.memset wants i8 val + i64 len)
            List<SemaParam> msp = fn.getParams()
            pointer dRaw = cge.gen(args.get(0))
            pointer pty0 = cge.ptrType()
            pointer dPtr
            llvm.buildIntToPtr(b, dRaw, pty0, "msd", dPtr)
            SemaExpr ve0 = args.get(1)
            pointer vVal = cge.gen(ve0)
            SemaParam mp1 = msp.get(1)
            vVal = cge.coerce(vVal, ve0.getType(), mp1.getType())
            SemaExpr ne0 = args.get(2)
            pointer nVal = cge.gen(ne0)
            SemaParam mp2 = msp.get(2)
            nVal = cge.coerce(nVal, ne0.getType(), mp2.getType())
            pointer msr
            llvm.buildMemSet(b, dPtr, vVal, nVal, 1, msr)
            return
        }
        if fly.str.equals(bn, "memcpy") || fly.str.equals(bn, "memmove") {
            // both lower to a memcpy intrinsic (element ranges in the containers
            // never overlap in the shift patterns used); dst/src are raw addresses
            List<SemaParam> mcp = fn.getParams()
            pointer dR = cge.gen(args.get(0))
            pointer sR = cge.gen(args.get(1))
            pointer pty1 = cge.ptrType()
            pointer dP
            llvm.buildIntToPtr(b, dR, pty1, "mcd", dP)
            pointer sP
            llvm.buildIntToPtr(b, sR, pty1, "mcs", sP)
            SemaExpr nce = args.get(2)
            pointer nV = cge.gen(nce)
            SemaParam mcp2 = mcp.get(2)
            nV = cge.coerce(nV, nce.getType(), mcp2.getType())
            pointer mcr
            llvm.buildMemCpy(b, dP, sP, nV, mcr)
            return
        }
        if fly.str.equals(bn, "longToInt") {
            pointer lv = cge.gen(args.get(0))
            pointer i32t
            llvm.int32TypeInContext(cge.getCgm().getCtx(), i32t)
            pointer tv
            llvm.buildTrunc(b, lv, i32t, "l2i", tv)
            SemaExpr o1 = args.get(1)
            pointer a1 = cge.genAddr(o1)
            llvm.buildStore(b, tv, a1)
            return
        }
        if fly.str.equals(bn, "ulongToLong") {
            pointer uv = cge.gen(args.get(0))
            SemaExpr o2 = args.get(1)
            pointer a2 = cge.genAddr(o2)
            llvm.buildStore(b, uv, a2)
            return
        }

        // ptr*/strPoke — raw byte-address load/store accessors: addr =
        // intToPtr(ptr)+i (byte offset), value typed by the accessor name.
        bool isPtrRead = false
        if fly.str.equals(bn, "ptrByteAt") { isPtrRead = true }
        if fly.str.startsWith(bn, "ptrRead") { isPtrRead = true }
        if isPtrRead {
            pointer ra = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
            SemaExpr roe = args.get(2)
            pointer rty = cge.lowerType(roe.getType())
            pointer rlv
            llvm.buildLoad2(b, rty, ra, "prd", rlv)
            pointer raddr = cge.genAddr(roe)
            llvm.buildStore(b, rlv, raddr)
            return
        }
        bool isPtrPoke = false
        if fly.str.startsWith(bn, "ptrPoke") { isPtrPoke = true }
        if fly.str.equals(bn, "strPoke") { isPtrPoke = true }
        if isPtrPoke {
            pointer pa = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
            SemaExpr pve = args.get(2)
            pointer pvv = cge.gen(pve)
            SemaFunctionBase pfn = node.getFunction()
            List<SemaParam> pps = pfn.getParams()
            if pps.size() > 2 {
                SemaParam pp2 = pps.get(2)
                pvv = cge.coerce(pvv, pve.getType(), pp2.getType())
            }
            llvm.buildStore(b, pvv, pa)
            return
        }

        // slot*T — the generic raw-buffer element intrinsics behind fly.data
        // containers. Calls arrive as monomorphized SPECIALIZATIONS, so the arg
        // and out types are concrete. Owned values (string) are deep-cloned on
        // poke/read and freed on slotFreeT (mirrors CodeGenStdLibLLVM).
        if fly.str.equals(bn, "slotSizeT") {
            SemaExpr sample = args.get(0)
            pointer ety = cge.lowerType(sample.getType())
            pointer szv
            llvm.sizeOf(ety, szv)
            pointer i32t2
            llvm.int32TypeInContext(cge.getCgm().getCtx(), i32t2)
            pointer tsz
            llvm.buildTrunc(b, szv, i32t2, "tsz", tsz)
            SemaExpr o3 = args.get(1)
            pointer a3 = cge.genAddr(o3)
            llvm.buildStore(b, tsz, a3)
            return
        }
        if fly.str.equals(bn, "slotPokeT") {
            pointer bp = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
            SemaExpr ve = args.get(2)
            pointer vv = cge.gen(ve)
            pointer cv = CodeGenIntrinsics.cloneIfString(cge, vv, ve.getType())
            llvm.buildStore(b, cv, bp)
            return
        }
        if fly.str.equals(bn, "slotReadT") {
            pointer bp2 = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
            SemaExpr oe = args.get(2)
            pointer ety2 = cge.lowerType(oe.getType())
            pointer lv2
            llvm.buildLoad2(b, ety2, bp2, "slrd", lv2)
            pointer cv2 = CodeGenIntrinsics.cloneIfString(cge, lv2, oe.getType())
            pointer ao = cge.genAddr(oe)
            llvm.buildStore(b, cv2, ao)
            return
        }
        if fly.str.equals(bn, "slotHashT") {
            // slotHashT(const T key, int out): FNV-1a for strings, value for ints
            SemaExpr ke = args.get(0)
            pointer kv = cge.gen(ke)
            pointer hv = CodeGenIntrinsics.hashValue(cge, kv, ke.getType())
            SemaExpr ho = args.get(1)
            pointer ha = cge.genAddr(ho)
            llvm.buildStore(b, hv, ha)
            return
        }
        if fly.str.equals(bn, "slotHashAtT") {
            // slotHashAtT(const pointer buf, const int off, const T sample, int out)
            pointer hp = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
            SemaExpr hse = args.get(2)
            pointer hty = cge.lowerType(hse.getType())
            pointer hlv
            llvm.buildLoad2(b, hty, hp, "shl", hlv)
            pointer hv2 = CodeGenIntrinsics.hashValue(cge, hlv, hse.getType())
            SemaExpr ho2 = args.get(3)
            pointer ha2 = cge.genAddr(ho2)
            llvm.buildStore(b, hv2, ha2)
            return
        }
        if fly.str.equals(bn, "slotCmpT") {
            // slotCmpT(const pointer buf, const int off, const T key, int out):
            // 3-WAY compare of the stored element vs key, 0 = EQUAL (memcmp-style
            // — map.fly/tree.fly probe with `if c == 0`). Strings lexicographic
            // (memcmp + length tiebreak), other types signed -1/0/1. Reference ABI.
            pointer cp = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
            SemaExpr cke = args.get(2)
            pointer ckty = cge.lowerType(cke.getType())
            pointer clv
            llvm.buildLoad2(b, ckty, cp, "scl", clv)
            pointer ckv = cge.gen(cke)
            pointer cmpv = CodeGenIntrinsics.valueCmp(cge, clv, ckv, cke.getType())
            SemaExpr co = args.get(3)
            pointer ca = cge.genAddr(co)
            llvm.buildStore(b, cmpv, ca)
            return
        }
        if fly.str.equals(bn, "slotFreeT") {
            SemaExpr se = args.get(2)
            SemaType st = se.getType()
            bool owned = false
            if st != null { owned = st.isString() }
            if owned {
                pointer bp3 = CodeGenIntrinsics.slotAddr(cge, args.get(0), args.get(1))
                CodeGenModule cgm3 = cge.getCgm()
                pointer strTy3 = cgm3.getStringTy()
                pointer sv3
                llvm.buildLoad2(b, strTy3, bp3, "slfr", sv3)
                pointer sp3
                llvm.buildExtractValue(b, sv3, 0, "slfp", sp3)
                cgm3.freeHandle(sp3)
            }
            return
        }

        fly.os.io.printErrLn(fly.str.concat(fly.str.concat("error: fly.llvm.", bn), " is not yet supported by the self-host compiler"))
    }

    // genRuntime — `fly.runtime.X(args…)` lowers to a DIRECT C call `@X` with the
    // M1 convention (CodeGenStdLibRuntime): const params by VALUE, the FIRST
    // non-const param receives the C return value, no error param. The archive
    // fly_runtime_lib.a defines these as unmangled C symbols.
    public static void genRuntime(const CodeGenExpr cge, const SemaCall node) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        CodeGenLLVM cg = cgm.getCg()
        SemaFunctionBase fn = node.getFunction()
        List<SemaParam> params = fn.getParams()
        List<SemaExpr> args = node.getArgs()

        // C signature: const params by value; first non-const → return type
        pointer retTy
        llvm.voidTypeInContext(cgm.getCtx(), retTy)
        int outIdx = 0 - 1
        List<pointer> cptys = new List<pointer>()
        int i = 0
        while i < params.size() {
            SemaParam p = params.get(i)
            if p.isConstant() {
                pointer pt = cge.lowerType(p.getType())
                cptys.add(pt)
            } else {
                if outIdx < 0 {
                    outIdx = i
                    retTy = cge.lowerType(p.getType())
                }
            }
            i = i + 1
        }
        pointer cty
        cg.functionTypeN(retTy, cptys, false, cty)
        string cname = fn.getName()
        pointer cfn
        llvm.getNamedFunction(cgm.getModule(), cname, cfn)
        if cfn == 0 { llvm.addFunction(cgm.getModule(), cname, cty, cfn) }

        // const args by value (coerced to the param type)
        List<pointer> cargs = new List<pointer>()
        int j = 0
        while j < params.size() {
            SemaParam pj = params.get(j)
            if pj.isConstant() {
                if j < args.size() {
                    SemaExpr ae = args.get(j)
                    pointer av = cge.gen(ae)
                    pointer cv = cge.coerce(av, ae.getType(), pj.getType())
                    cargs.add(cv)
                }
            }
            j = j + 1
        }
        pointer rv
        cg.buildCallN(b, cty, cfn, cargs, "", rv)

        // C return → stored through the first non-const ARG's address
        if outIdx >= 0 {
            if outIdx < args.size() {
                SemaExpr oe = args.get(outIdx)
                pointer oa = cge.genAddr(oe)
                llvm.buildStore(b, rv, oa)
            }
        }
    }

    // extendToI64 — widen an integer value to i64 by its Fly type: already-64-bit
    // (pointer/ulong/long) passes through, narrower unsigned zext, signed sext.
    // Byte offsets are `pointer` (Rust usize model) but legacy int callers remain.
    public static pointer extendToI64(const CodeGenExpr cge, const pointer val, const SemaType t) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        int w = 64
        if t != null { w = cge.numWidth(t) }
        if w >= 64 { out = val  return }
        pointer i64t
        llvm.int64TypeInContext(cge.getCgm().getCtx(), i64t)
        pointer r
        if cge.isUnsignedInt(t) {
            llvm.buildZExt(b, val, i64t, "soffz", r)
        } else {
            llvm.buildSExt(b, val, i64t, "soffs", r)
        }
        out = r
    }

    // slotAddr — `intToPtr(buf) + byteOff` as an i8 GEP: the element address
    // shared by the slot*T intrinsics. The offset is widened to i64 by its own
    // declared type (pointer offsets arrive already 64-bit).
    public static pointer slotAddr(const CodeGenExpr cge, const SemaExpr bufE, const SemaExpr offE) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer bufV = cge.gen(bufE)
        pointer ptrTy = cge.ptrType()
        pointer rp
        llvm.buildIntToPtr(b, bufV, ptrTy, "sbuf", rp)
        pointer offV = cge.gen(offE)
        pointer wof = CodeGenIntrinsics.extendToI64(cge, offV, offE.getType())
        pointer i8t
        llvm.int8TypeInContext(cgm.getCtx(), i8t)
        List<pointer> gidx = new List<pointer>()
        gidx.add(wof)
        CodeGenLLVM cg = cgm.getCg()
        pointer addr
        cg.buildGEP2N(b, i8t, rp, gidx, "slot", addr)
        out = addr
    }

    // hashValue — i32 hash of a value: FNV-1a over the bytes for strings (alloca
    // + loop blocks — the self-host emits no phi), the truncated value otherwise.
    public static pointer hashValue(const CodeGenExpr cge, const pointer val, const SemaType t) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer i32t
        llvm.int32TypeInContext(cgm.getCtx(), i32t)

        bool isStr = false
        if t != null { isStr = t.isString() }
        if isStr == false {
            // integers/pointers/enums: the value itself, sized to i32
            pointer r = val
            if t != null {
                if t.isInteger() {
                    int w = cge.numWidth(t)
                    if w > 32 { llvm.buildTrunc(b, val, i32t, "hshT", r) }
                    elsif w < 32 { llvm.buildZExt(b, val, i32t, "hshZ", r) }
                }
            }
            out = r
            return
        }

        // FNV-1a over the string bytes
        pointer sp
        llvm.buildExtractValue(b, val, 0, "hsp", sp)
        pointer sz32
        llvm.buildExtractValue(b, val, 1, "hsz", sz32)
        pointer i64t
        llvm.int64TypeInContext(cgm.getCtx(), i64t)
        pointer szl
        llvm.buildZExt(b, sz32, i64t, "hszw", szl)
        pointer i8t
        llvm.int8TypeInContext(cgm.getCtx(), i8t)

        pointer hSlot
        llvm.buildAlloca(b, i32t, "hacc", hSlot)
        pointer init
        llvm.constInt(i32t, 2166136261, false, init)
        llvm.buildStore(b, init, hSlot)
        pointer iSlot
        llvm.buildAlloca(b, i64t, "hidx", iSlot)
        pointer zero64
        llvm.constInt(i64t, 0, false, zero64)
        llvm.buildStore(b, zero64, iSlot)

        pointer condBB = cge.newBlock("hash.cond")
        pointer bodyBB = cge.newBlock("hash.body")
        pointer exitBB = cge.newBlock("hash.exit")
        cge.br(condBB)

        cge.position(condBB)
        pointer iv
        llvm.buildLoad2(b, i64t, iSlot, "hi", iv)
        pointer cmp
        llvm.buildICmp(b, 36, iv, szl, "hlt", cmp)   // ULT
        pointer cbr
        llvm.buildCondBr(b, cmp, bodyBB, exitBB, cbr)
        cge.setTerminated(true)

        cge.position(bodyBB)
        pointer iv2
        llvm.buildLoad2(b, i64t, iSlot, "hi2", iv2)
        List<pointer> gi = new List<pointer>()
        gi.add(iv2)
        CodeGenLLVM cg = cgm.getCg()
        pointer bp
        cg.buildGEP2N(b, i8t, sp, gi, "hbp", bp)
        pointer bv
        llvm.buildLoad2(b, i8t, bp, "hbv", bv)
        pointer bz
        llvm.buildZExt(b, bv, i32t, "hbz", bz)
        pointer h0
        llvm.buildLoad2(b, i32t, hSlot, "hh", h0)
        pointer hx
        llvm.buildXor(b, h0, bz, "hxr", hx)
        pointer prime
        llvm.constInt(i32t, 16777619, false, prime)
        pointer hm
        llvm.buildMul(b, hx, prime, "hml", hm)
        llvm.buildStore(b, hm, hSlot)
        pointer one64
        llvm.constInt(i64t, 1, false, one64)
        pointer inx
        llvm.buildAdd(b, iv2, one64, "hin", inx)
        llvm.buildStore(b, inx, iSlot)
        cge.br(condBB)

        cge.position(exitBB)
        pointer hres
        llvm.buildLoad2(b, i32t, hSlot, "hrs", hres)
        out = hres
    }

    // valueCmp — i32 3-way compare (-1/0/+1, 0 = equal) of stored vs key, the
    // slotCmpT contract (mirrors the reference CodeGenStdLibLLVM): strings are
    // lexicographic via memcmp on the shared prefix with a length tiebreak;
    // everything else signed select. `stored` and `key` are both of type `t`.
    public static pointer valueCmp(const CodeGenExpr cge, const pointer stored, const pointer key, const SemaType t) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer i32t
        llvm.int32TypeInContext(cgm.getCtx(), i32t)
        pointer zero
        llvm.constInt(i32t, 0, false, zero)
        pointer one
        llvm.constInt(i32t, 1, false, one)
        pointer negOne
        llvm.constInt(i32t, 4294967295, true, negOne)

        bool isStr = false
        if t != null { isStr = t.isString() }
        if isStr {
            // memcmp(sp, kp, min(ss, ks)); tie on the shared prefix → ss - ks
            pointer sp
            llvm.buildExtractValue(b, stored, 0, "csp", sp)
            pointer ss
            llvm.buildExtractValue(b, stored, 1, "css", ss)
            pointer kp
            llvm.buildExtractValue(b, key, 0, "ckp", kp)
            pointer ks
            llvm.buildExtractValue(b, key, 1, "cks", ks)
            pointer sLt
            llvm.buildICmp(b, 40, ss, ks, "cmn", sLt)          // SLT
            pointer minS
            llvm.buildSelect(b, sLt, ss, ks, "cms", minS)
            pointer i64t
            llvm.int64TypeInContext(cgm.getCtx(), i64t)
            pointer minW
            llvm.buildZExt(b, minS, i64t, "cmw", minW)
            pointer mc = CodeGenIntrinsics.emitMemcmp(cge, sp, kp, minW)
            pointer lenDiff
            llvm.buildSub(b, ss, ks, "cld", lenDiff)
            pointer cNe
            llvm.buildICmp(b, 33, mc, zero, "cne", cNe)        // NE
            pointer r
            llvm.buildSelect(b, cNe, mc, lenDiff, "c3w", r)
            out = r
            return
        }

        // integers / pointer-sized / enums: signed -1/0/1
        pointer lt
        llvm.buildICmp(b, 40, stored, key, "clt", lt)          // SLT
        pointer gt
        llvm.buildICmp(b, 38, stored, key, "cgt", gt)          // SGT
        pointer inner
        llvm.buildSelect(b, gt, one, zero, "cgi", inner)
        pointer r2
        llvm.buildSelect(b, lt, negOne, inner, "c3i", r2)
        out = r2
    }

    // emitMemcmp — `call i32 @memcmp(ptr, ptr, i64)` (libc), declared on first use.
    public static pointer emitMemcmp(const CodeGenExpr cge, const pointer a, const pointer b2, const pointer len) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer fn
        llvm.getNamedFunction(cgm.getModule(), "memcmp", fn)
        pointer i32t
        llvm.int32TypeInContext(cgm.getCtx(), i32t)
        pointer i64t
        llvm.int64TypeInContext(cgm.getCtx(), i64t)
        pointer pty = cge.ptrType()
        List<pointer> ps = new List<pointer>()
        ps.add(pty)
        ps.add(pty)
        ps.add(i64t)
        CodeGenLLVM cg = cgm.getCg()
        pointer fty
        cg.functionTypeN(i32t, ps, false, fty)
        if fn == 0 {
            llvm.addFunction(cgm.getModule(), "memcmp", fty, fn)
        }
        List<pointer> as2 = new List<pointer>()
        as2.add(a)
        as2.add(b2)
        as2.add(len)
        pointer cv
        cg.buildCallN(b, fty, fn, as2, "cmc", cv)
        out = cv
    }

    // valueEq — i1 equality of two values of type `t`: strings by size + bytes
    // (loop, alloca-based), everything else by icmp eq.
    public static pointer valueEq(const CodeGenExpr cge, const pointer a, const pointer b2, const SemaType t) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer i1res

        bool isStr = false
        if t != null { isStr = t.isString() }
        if isStr == false {
            llvm.buildICmp(b, 32, a, b2, "veq", i1res)   // EQ
            out = i1res
            return
        }

        pointer i64t
        llvm.int64TypeInContext(cgm.getCtx(), i64t)
        pointer i8t
        llvm.int8TypeInContext(cgm.getCtx(), i8t)
        pointer i1t
        llvm.int1TypeInContext(cgm.getCtx(), i1t)
        CodeGenLLVM cg = cgm.getCg()

        pointer ap
        llvm.buildExtractValue(b, a, 0, "vap", ap)
        pointer asz
        llvm.buildExtractValue(b, a, 1, "vas", asz)
        pointer bp
        llvm.buildExtractValue(b, b2, 0, "vbp", bp)
        pointer bsz
        llvm.buildExtractValue(b, b2, 1, "vbs", bsz)
        pointer aszW
        llvm.buildZExt(b, asz, i64t, "vasw", aszW)

        pointer resSlot
        llvm.buildAlloca(b, i1t, "veqs", resSlot)
        pointer szEq
        llvm.buildICmp(b, 32, asz, bsz, "vsz", szEq)
        llvm.buildStore(b, szEq, resSlot)
        pointer iSlot
        llvm.buildAlloca(b, i64t, "vidx", iSlot)
        pointer z64
        llvm.constInt(i64t, 0, false, z64)
        llvm.buildStore(b, z64, iSlot)

        pointer condBB = cge.newBlock("veq.cond")
        pointer bodyBB = cge.newBlock("veq.body")
        pointer exitBB = cge.newBlock("veq.exit")
        cge.br(condBB)

        // continue while: result still true AND i < size
        cge.position(condBB)
        pointer r0
        llvm.buildLoad2(b, i1t, resSlot, "vr0", r0)
        pointer iv
        llvm.buildLoad2(b, i64t, iSlot, "vi", iv)
        pointer ltv
        llvm.buildICmp(b, 36, iv, aszW, "vlt", ltv)   // ULT
        pointer go
        llvm.buildAnd(b, r0, ltv, "vgo", go)
        pointer cbr
        llvm.buildCondBr(b, go, bodyBB, exitBB, cbr)
        cge.setTerminated(true)

        cge.position(bodyBB)
        pointer iv2
        llvm.buildLoad2(b, i64t, iSlot, "vi2", iv2)
        List<pointer> ga = new List<pointer>()
        ga.add(iv2)
        pointer pa
        cg.buildGEP2N(b, i8t, ap, ga, "vpa", pa)
        pointer va
        llvm.buildLoad2(b, i8t, pa, "vva", va)
        List<pointer> gb = new List<pointer>()
        gb.add(iv2)
        pointer pb
        cg.buildGEP2N(b, i8t, bp, gb, "vpb", pb)
        pointer vb
        llvm.buildLoad2(b, i8t, pb, "vvb", vb)
        pointer beq
        llvm.buildICmp(b, 32, va, vb, "vbe", beq)
        llvm.buildStore(b, beq, resSlot)
        pointer one
        llvm.constInt(i64t, 1, false, one)
        pointer nx
        llvm.buildAdd(b, iv2, one, "vnx", nx)
        llvm.buildStore(b, nx, iSlot)
        cge.br(condBB)

        cge.position(exitBB)
        pointer rf
        llvm.buildLoad2(b, i1t, resSlot, "vrf", rf)
        out = rf
    }

    // cloneIfString — deep-clone a %string value into a fresh malloc'd buffer so
    // each owner frees independently (no aliasing). No-op for other types.
    public static pointer cloneIfString(const CodeGenExpr cge, const pointer val, const SemaType t) {
        if t == null { out = val  return }
        if t.isString() == false { out = val  return }
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        CodeGenModule cgm = cge.getCgm()
        pointer srcP
        llvm.buildExtractValue(b, val, 0, "csp", srcP)
        pointer szV
        llvm.buildExtractValue(b, val, 1, "css", szV)
        pointer i64c
        llvm.int64TypeInContext(cgm.getCtx(), i64c)
        pointer szW
        llvm.buildZExt(b, szV, i64c, "csw", szW)
        pointer heapP = cgm.emitMalloc(szW)
        pointer msv
        llvm.buildMemCpy(b, heapP, srcP, szW, msv)
        pointer strTy = cgm.getStringTy()
        pointer slot
        llvm.buildAlloca(b, strTy, "cslt", slot)
        pointer f0
        llvm.buildStructGEP2(b, strTy, slot, 0, "cf0", f0)
        llvm.buildStore(b, heapP, f0)
        pointer f1
        llvm.buildStructGEP2(b, strTy, slot, 1, "cf1", f1)
        llvm.buildStore(b, szV, f1)
        pointer res
        llvm.buildLoad2(b, strTy, slot, "cres", res)
        out = res
    }

    // storeIntOut — store an integer value through an out-param expr's address,
    // resized from srcW (the produced value's bit width) to the destination width:
    // trunc when narrower, zext when wider, raw when equal.
    public static void storeIntOut(const CodeGenExpr cge, const pointer val, const int srcW, const SemaExpr outE) {
        LLVM llvm = cge.getLLVM()
        pointer b = cge.getBuilder()
        pointer v2 = val
        SemaType ot = outE.getType()
        if ot != null {
            if ot.isInteger() {
                int w = cge.numWidth(ot)
                pointer dt = cge.lowerType(ot)
                if w < srcW {
                    llvm.buildTrunc(b, val, dt, "otr", v2)
                } elsif w > srcW {
                    llvm.buildZExt(b, val, dt, "ozx", v2)
                }
            }
        }
        pointer addr = cge.genAddr(outE)
        llvm.buildStore(b, v2, addr)
    }
}
